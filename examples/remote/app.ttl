@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix src: <https://semblance.dev/ns/source#> .
@prefix ex: <https://example.org/remote#> .

# The page. The todos themselves are not here: they live in the store (todos.ttl, on the
# server), and reach the page as changes. The list reads them as it reads anything else.

# What lives in the store: every todo, and the list's links to them. The page's changes to them go
# back. Where the store is, the host says (main.ts), not the graph.
ex:store a src:Source ;
    src:pattern [ src:class ex:Todo ] , [ src:subject ex:todos ; src:predicate c:item ] ;
    src:writable true .
ex:todos src:awaits ex:store .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:intro ex:status ex:entry ex:todos ex:clear ) .
ex:title a c:Heading ; c:level 1 ; c:label "A shared todo list" .
ex:intro a c:Text ; c:label "The todos live in a store on the server. Open this page twice: what one page changes, the other shows. A label longer than 40 characters is refused by the store, and the page puts back what the store holds." .
ex:status a c:Badge ; c:label "Connecting" .
ex:entry a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ex:newTodo ex:add ) .
ex:newTodo a c:TextField ; c:label "New todo" ; c:placeholder "What needs doing?" .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .
ex:todos a c:List ; c:label "Todos" ; c:sortBy ex:created ; c:itemLabel rdfs:label ; c:itemChecked ex:done .
ex:clear a c:Button ; c:label "Clear done" .

# A click on Add mints a todo from the field's value. Its IRI and its place come from the
# moment of the click, so two pages adding at once do not collide.
ex:AddTodo a beh:Reaction ; beh:when beh:Click ; beh:source ex:add ;
    beh:deletes """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:newTodo c:value ?v } WHERE { ex:newTodo c:value ?v }""" ;
    beh:inserts """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ?item a ex:Todo ; rdfs:label ?v ; ex:done false ; ex:created ?at . ex:todos c:item ?item . }
WHERE {
  ex:newTodo c:value ?v FILTER(REGEX(STR(?v), "[^ ]"))
  $event beh:at ?at
  BIND(IRI(CONCAT(STR(ex:), "t-", REPLACE(STR(?at), "[^0-9]", ""))) AS ?item)
}""" .

# Clear done: every done todo goes, with its place in the list.
ex:ClearDone a beh:Reaction ; beh:when beh:Click ; beh:source ex:clear ;
    beh:deletes """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ?t ?p ?o . ex:todos c:item ?t } WHERE { ex:todos c:item ?t . ?t ex:done true ; ?p ?o }""" .

# What the store's connection is doing, said by the badge: the effect reports it as events.
ex:ShowLive a beh:Reaction ; beh:when src:WentLive ; beh:source ex:store ;
    beh:deletes """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label ?l ; sty:tone ?t } WHERE { ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label "Live" ; sty:tone sty:Success } WHERE {}""" .
ex:ShowLost a beh:Reaction ; beh:when src:Lost ; beh:source ex:store ;
    beh:deletes """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label ?l ; sty:tone ?t } WHERE { ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label "Reconnecting" ; sty:tone sty:Warning } WHERE {}""" .
# A refused write: the list already shows what the store holds; the badge says why.
ex:ShowRefused a beh:Reaction ; beh:when src:WriteRefused ; beh:source ex:store ;
    beh:deletes """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label ?l ; sty:tone ?t } WHERE { ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/remote#>
CONSTRUCT { ex:status c:label ?label ; sty:tone sty:Danger }
WHERE { $event src:reason ?reason BIND(IF(?reason = "stale", "Changed elsewhere: shown as it is now", ?reason) AS ?label) }""" .
