@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix ex: <https://example.org/todo#> .
@prefix ui: <https://example.org/react#> .

# Around the todo app (src/examples/todo.ts, unchanged): its theme, color scheme and language, chosen
# with Semblance's own c:Choice. The shell is a c:Stack, so the design system draws it too, and the
# choices, which it does not draw, are Semblance's elements inside it.

ui:shell a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    sty:theme sty:Semblance ; sty:colorScheme sty:System ; l10n:language l10n:English ;
    c:children ( ui:settings ex:page ) .
ui:settings a c:Stack ; pos:direction pos:Row ; c:children ( ui:themeChoice ui:schemeChoice ui:languageChoice ) .
ui:themeChoice a c:Choice ; c:controls ui:shell ; c:property sty:theme .
ui:schemeChoice a c:Choice ; c:controls ui:shell ; c:property sty:colorScheme .
ui:languageChoice a c:Choice ; c:controls ui:shell ; c:property l10n:language .
