@prefix c: <https://semblance.dev/ns/component#> .
@prefix ext: <https://semblance.dev/ns/foreign#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Which of Semblance's component classes the example's design system (design-system.tsx) draws, and
# with which props. The todo app's graph (src/examples/todo.ts) is not changed: its components are
# projected as everywhere else, and these components draw what is projected (docs/HOSTED.md).

c:Stack rdfs:subClassOf ext:Hosted ; ext:component "Stack" ;
    ext:input [ ext:name "direction" ; ext:from pos:direction ] ,
              [ ext:name "density" ; ext:from sty:density ] .
c:Heading rdfs:subClassOf ext:Hosted ; ext:component "Heading" ;
    ext:input [ ext:name "level" ; ext:from c:level ] .
c:Button rdfs:subClassOf ext:Hosted ; ext:component "Button" ;
    ext:input [ ext:name "intent" ; ext:from sty:intent ] .
c:TextField rdfs:subClassOf ext:Hosted ; ext:component "Field" ;
    ext:input [ ext:name "invalid" ; ext:from c:error ] .
c:List rdfs:subClassOf ext:Hosted ; ext:component "List" .
