# c:DataGridWindow-sparql as it was before the grid window became views
# (git show c734148^:ontology/components/grid.ttl): the phase 5 measure, test/view-measure.test.ts.
CONSTRUCT {
  ?row a c:GridRow ; c:of ?m ; c:inGrid $this ; c:columnsFrom ?cols ; sem:orderKey ?orderKey ; c:isSelected ?isSelected ; c:tabStop ?tabStop .
  ?dragRow a dnd:Draggable ; dnd:carries ?m .
  ?el a ?tag ; rdfhtml:class ?cls ; rdfhtml:type ?type ; rdfhtml:disabled ?disabled ; rdfhtml:colSpan ?colSpan ; sem:orderKey ?elKey ;
      c:windowTo ?windowTo ; c:followsLatest ?followsLatest .
  ?parent rdfhtml:hasChild ?el .
  ?owner rdfhtml:attribute ?attr . ?attr a rdfhtml:Attribute ; rdfhtml:attributeName ?name ; rdfhtml:attributeValue ?value .
  ?txtParent rdfhtml:hasChild ?txt . ?txt a rdfhtml:Text ; rdfhtml:data ?data .
  ?body rdfhtml:hasChild ?row ; rdfhtml:style ?scaleStyle .
  ?scale c:start ?lo ; c:end ?hi .
  ?window c:shownEnd ?shownEnd .
}
WHERE {
  BIND(STR($this) AS ?g)
  BIND(IRI(CONCAT(?g, "/~body")) AS ?bodyNode)
  OPTIONAL { $this c:pageSize ?pageRaw }
  BIND(COALESCE(xsd:integer(ROUND(xsd:double(STR(?pageRaw)))), 50) AS ?p0)
  BIND(IF(?p0 < 1, 1, ?p0) AS ?P)
  OPTIONAL { $this c:selectedRow ?sel0 }
  BIND(COALESCE(?sel0, c:none) AS ?sel)
  # How many members match, and how many of them a pinned window reaches.
  {
    SELECT (COUNT(?m) AS ?total) (SUM(IF(?pinned && ?sn <= ?pinAt, 1, 0)) AS ?upTo) (MAX(IF(?pinned, 1, 0)) AS ?pinFlag) WHERE {
      $this c:collection ?coll .
      OPTIONAL { $this c:memberProperty ?mp } BIND(COALESCE(?mp, tree:member) AS ?via)
      OPTIONAL { $this c:sequenceProperty ?sp1 } OPTIONAL { ?coll ldes:sequencePath ?sp2 } BIND(COALESCE(?sp1, ?sp2, c:none) AS ?seqP)
      ?coll ?via ?m . FILTER(isIRI(?m))
      ?m ?seqP ?seqV . FILTER(isNumeric(?seqV)) BIND(xsd:double(?seqV) AS ?sn)
      FILTER(NOT EXISTS { $this c:memberClass ?anyClass } || EXISTS { $this c:memberClass ?mc . ?m a/rdfs:subClassOf* ?mc })
      FILTER NOT EXISTS { $this c:filteredBy ?tf . ?tf a c:TextFilter ; c:filterText ?text . FILTER(STRLEN(STR(?text)) > 0)
                          FILTER NOT EXISTS { ?tf c:searches ?sp . ?m ?sp ?sv FILTER(CONTAINS(LCASE(STR(?sv)), LCASE(STR(?text)))) } }
      FILTER NOT EXISTS { $this c:filteredBy ?vf . ?vf a c:ValueFilter ; c:filterProperty ?vp ; c:filterValue ?vv . FILTER(?vv != c:AnyValue) FILTER NOT EXISTS { ?m ?vp ?vv } }
      FILTER NOT EXISTS { $this c:filteredBy ?ff . ?ff a c:FlagFilter ; c:filterProperty ?fp ; c:filterValue ?fv ; c:included false . ?m ?fp ?fv }
      OPTIONAL { $this c:windowEnd ?pinRaw }
      BIND(EXISTS { $this c:followTail false } && isNumeric(?pinRaw) AS ?pinned0)
      BIND(COALESCE(?pinned0, false) AS ?pinned)
      BIND(IF(?pinned, xsd:double(?pinRaw), 0) AS ?pinAt)
    }
  }
  OPTIONAL { $this c:windowEnd ?pinRaw2 }
  BIND(COALESCE(EXISTS { $this c:followTail false } && isNumeric(?pinRaw2), false) AS ?pinned)
  BIND(IF(?pinned, IF(?upTo = 0, IF(?total < ?P, ?total, ?P), ?upTo), ?total) AS ?E)
  BIND(IF(?E - ?P + 1 < 1, 1, ?E - ?P + 1) AS ?first)
  # Positions in capture order: the window's bounds, whether the selection is in it, its scale.
  LATERAL {
    OPTIONAL {
      SELECT ?E ?first ?P ?sel
             (MAX(IF(?pos <= ?E, ?sn, -1e300)) AS ?shownEnd) (MAX(IF(?pos < ?first, ?sn, -1e300)) AS ?olderEnd)
             (MAX(IF(?pos <= ?E + ?P, ?sn, -1e300)) AS ?newerEnd)
             (MAX(IF(?pos >= ?first && ?pos <= ?E && ?m = ?sel, 1, 0)) AS ?selShown)
             (MIN(IF(?pos >= ?first && ?pos <= ?E && BOUND(?ba), ?ba, 1e300)) AS ?lo0)
             (MAX(IF(?pos >= ?first && ?pos <= ?E && BOUND(?ba), COALESCE(?bb, ?ba), -1e300)) AS ?hi0)
      WHERE {
        {
          SELECT ?m ?sn ?ba ?bb (COUNT(?n) AS ?pos) WHERE {
            {
              SELECT ?m ?sn ?ba ?bb WHERE {
                $this c:collection ?coll .
                OPTIONAL { $this c:memberProperty ?mp } BIND(COALESCE(?mp, tree:member) AS ?via)
                OPTIONAL { $this c:sequenceProperty ?sp1 } OPTIONAL { ?coll ldes:sequencePath ?sp2 } BIND(COALESCE(?sp1, ?sp2, c:none) AS ?seqP)
                ?coll ?via ?m . FILTER(isIRI(?m))
                ?m ?seqP ?seqV . FILTER(isNumeric(?seqV)) BIND(xsd:double(?seqV) AS ?sn)
                FILTER(NOT EXISTS { $this c:memberClass ?anyClass } || EXISTS { $this c:memberClass ?mc . ?m a/rdfs:subClassOf* ?mc })
                FILTER NOT EXISTS { $this c:filteredBy ?tf . ?tf a c:TextFilter ; c:filterText ?text . FILTER(STRLEN(STR(?text)) > 0)
                                    FILTER NOT EXISTS { ?tf c:searches ?sp . ?m ?sp ?sv FILTER(CONTAINS(LCASE(STR(?sv)), LCASE(STR(?text)))) } }
                FILTER NOT EXISTS { $this c:filteredBy ?vf . ?vf a c:ValueFilter ; c:filterProperty ?vp ; c:filterValue ?vv . FILTER(?vv != c:AnyValue) FILTER NOT EXISTS { ?m ?vp ?vv } }
                FILTER NOT EXISTS { $this c:filteredBy ?ff . ?ff a c:FlagFilter ; c:filterProperty ?fp ; c:filterValue ?fv ; c:included false . ?m ?fp ?fv }
                OPTIONAL { { SELECT ?bars WHERE { { SELECT ?bars (COUNT(?before) AS ?bpos) WHERE {
                    $this c:gridColumns ?bl . ?bl rdf:rest* ?bcell . ?bcell rdf:first ?bars . ?bars c:cellAs c:TimeBarCell . ?bl rdf:rest* ?before . ?before rdf:rest* ?bcell
                  } GROUP BY ?bars } } ORDER BY ?bpos LIMIT 1 } }
                BIND(COALESCE(?bars, c:none) AS ?bc)
                OPTIONAL { ?bc c:via ?bv0 } BIND(COALESCE(?bv0, c:none) AS ?bvia)
                OPTIONAL { ?bc c:startProperty ?bs0 } BIND(COALESCE(?bs0, c:none) AS ?bsp)
                OPTIONAL { ?bc c:endProperty ?be0 } BIND(COALESCE(?be0, c:none) AS ?bep)
                LATERAL { OPTIONAL { ?m ?bvia ?bhop } }
                BIND(COALESCE(IF(?bvia = c:none, ?m, ?bhop), c:none) AS ?bsubj)
                LATERAL { OPTIONAL { ?bsubj ?bsp ?ba0 FILTER(isNumeric(?ba0)) } }
                LATERAL { OPTIONAL { ?bsubj ?bep ?bb0 FILTER(isNumeric(?bb0)) } }
                BIND(xsd:double(?ba0) AS ?ba) BIND(xsd:double(?bb0) AS ?bb)
              }
            }
            {
              SELECT (?m AS ?n) (?sn AS ?nsn) WHERE {
                $this c:collection ?coll .
                OPTIONAL { $this c:memberProperty ?mp } BIND(COALESCE(?mp, tree:member) AS ?via)
                OPTIONAL { $this c:sequenceProperty ?sp1 } OPTIONAL { ?coll ldes:sequencePath ?sp2 } BIND(COALESCE(?sp1, ?sp2, c:none) AS ?seqP)
                ?coll ?via ?m . FILTER(isIRI(?m))
                ?m ?seqP ?seqV . FILTER(isNumeric(?seqV)) BIND(xsd:double(?seqV) AS ?sn)
                FILTER(NOT EXISTS { $this c:memberClass ?anyClass } || EXISTS { $this c:memberClass ?mc . ?m a/rdfs:subClassOf* ?mc })
                FILTER NOT EXISTS { $this c:filteredBy ?tf . ?tf a c:TextFilter ; c:filterText ?text . FILTER(STRLEN(STR(?text)) > 0)
                                    FILTER NOT EXISTS { ?tf c:searches ?sp . ?m ?sp ?sv FILTER(CONTAINS(LCASE(STR(?sv)), LCASE(STR(?text)))) } }
                FILTER NOT EXISTS { $this c:filteredBy ?vf . ?vf a c:ValueFilter ; c:filterProperty ?vp ; c:filterValue ?vv . FILTER(?vv != c:AnyValue) FILTER NOT EXISTS { ?m ?vp ?vv } }
                FILTER NOT EXISTS { $this c:filteredBy ?ff . ?ff a c:FlagFilter ; c:filterProperty ?fp ; c:filterValue ?fv ; c:included false . ?m ?fp ?fv }
              }
            }
            FILTER(?nsn < ?sn || (?nsn = ?sn && STR(?n) <= STR(?m)))
          } GROUP BY ?m ?sn ?ba ?bb
        }
      } GROUP BY ?E ?first ?P ?sel
    }
  }
  BIND(?total > 0 AS ?any)
  BIND(IF(?first > 1, ?olderEnd, -1e300) AS ?low)
  BIND(COALESCE(?selShown = 1, false) AS ?selectionShown)
  LATERAL {
    {
      # The rows: the matching members in the window, ranked by the sort (pairs within the window).
      FILTER(?any)
      {
        SELECT ?low ?shownEnd ?m (COUNT(?n) AS ?rank) WHERE {
          {
            SELECT ?m ?sn ?hv ?isNum ?vn ?vs ?desc WHERE {
              $this c:collection ?coll .
              OPTIONAL { $this c:memberProperty ?mp } BIND(COALESCE(?mp, tree:member) AS ?via)
              OPTIONAL { $this c:sequenceProperty ?sp1 } OPTIONAL { ?coll ldes:sequencePath ?sp2 } BIND(COALESCE(?sp1, ?sp2, c:none) AS ?seqP)
              ?coll ?via ?m . FILTER(isIRI(?m))
              ?m ?seqP ?seqV . FILTER(isNumeric(?seqV)) BIND(xsd:double(?seqV) AS ?sn)
              FILTER(NOT EXISTS { $this c:memberClass ?anyClass } || EXISTS { $this c:memberClass ?mc . ?m a/rdfs:subClassOf* ?mc })
              FILTER NOT EXISTS { $this c:filteredBy ?tf . ?tf a c:TextFilter ; c:filterText ?text . FILTER(STRLEN(STR(?text)) > 0)
                                  FILTER NOT EXISTS { ?tf c:searches ?sp . ?m ?sp ?sv FILTER(CONTAINS(LCASE(STR(?sv)), LCASE(STR(?text)))) } }
              FILTER NOT EXISTS { $this c:filteredBy ?vf . ?vf a c:ValueFilter ; c:filterProperty ?vp ; c:filterValue ?vv . FILTER(?vv != c:AnyValue) FILTER NOT EXISTS { ?m ?vp ?vv } }
              FILTER NOT EXISTS { $this c:filteredBy ?ff . ?ff a c:FlagFilter ; c:filterProperty ?fp ; c:filterValue ?fv ; c:included false . ?m ?fp ?fv }
              OPTIONAL { $this c:sortColumn ?sc0 } BIND(COALESCE(?sc0, c:none) AS ?sc) BIND(EXISTS { $this c:sortDescending true } AS ?desc)
              OPTIONAL { ?sc c:cellAs ?sk0 } BIND(COALESCE(?sk0, c:TextCell) AS ?sk)
              OPTIONAL { ?sc c:via ?sv0 } BIND(COALESCE(?sv0, c:none) AS ?svia)
              OPTIONAL { ?sc c:cellProperty ?scp0 } BIND(COALESCE(?scp0, c:none) AS ?scp)
              OPTIONAL { ?sc c:startProperty ?sst0 } BIND(COALESCE(?sst0, c:none) AS ?sst)
              OPTIONAL { ?sc c:endProperty ?sen0 } BIND(COALESCE(?sen0, c:none) AS ?sen)
              LATERAL { OPTIONAL { ?m ?svia ?shop } }
              BIND(COALESCE(IF(?svia = c:none, ?m, ?shop), c:none) AS ?ss)
              LATERAL { OPTIONAL { ?ss ?scp ?sval0 } }
              LATERAL { OPTIONAL { ?ss ?sst ?sa FILTER(isNumeric(?sa)) } }
              LATERAL { OPTIONAL { ?ss ?sen ?sb FILTER(isNumeric(?sb)) } }
              BIND(COALESCE(?sval0, c:none) AS ?sval)
              LATERAL { OPTIONAL { ?sval sem:order ?sord FILTER(isNumeric(?sord)) } }
              LATERAL {
                OPTIONAL { ?sval c:label ?svl0 FILTER(lang(?svl0) = "") } OPTIONAL { ?sval c:label ?svl1 FILTER(langMatches(lang(?svl1), "en")) }
                OPTIONAL { ?sval rdfs:label ?svl2 FILTER(lang(?svl2) = "") } OPTIONAL { ?sval rdfs:label ?svl3 FILTER(langMatches(lang(?svl3), "en")) }
              }
              BIND(IF(?sc = c:none, ?unset, IF(?sk = c:TimeBarCell, xsd:double(?sa), IF(?sk = c:DurationCell, xsd:double(?sb) - xsd:double(?sa),
                   IF(?sval = c:none, ?unset, IF(isIRI(?sval), xsd:double(?sord), IF(isNumeric(?sval), xsd:double(?sval), ?unset)))))) AS ?vnum)
              BIND(IF(?sc = c:none || ?sk IN (c:TimeBarCell, c:DurationCell) || ?sval = c:none, ?unset,
                   IF(isIRI(?sval), IF(BOUND(?sord), ?unset, STR(COALESCE(?svl0, ?svl1, ?svl2, ?svl3, REPLACE(STR(?sval), "^.*[#/]", "")))),
                   IF(isNumeric(?sval), ?unset, STR(?sval)))) AS ?vstr)
              BIND(BOUND(?vnum) AS ?isNum) BIND(?isNum || BOUND(?vstr) AS ?hv)
              BIND(COALESCE(?vnum, 0) AS ?vn) BIND(COALESCE(?vstr, STR(?vnum), "") AS ?vs)
            }
          }
          FILTER(?sn > ?low && ?sn <= ?shownEnd)
          {
            SELECT (?m AS ?n) (?sn AS ?nsn) (?hv AS ?nhv) (?isNum AS ?nIsNum) (?vn AS ?nvn) (?vs AS ?nvs) WHERE {
              $this c:collection ?coll .
              OPTIONAL { $this c:memberProperty ?mp } BIND(COALESCE(?mp, tree:member) AS ?via)
              OPTIONAL { $this c:sequenceProperty ?sp1 } OPTIONAL { ?coll ldes:sequencePath ?sp2 } BIND(COALESCE(?sp1, ?sp2, c:none) AS ?seqP)
              ?coll ?via ?m . FILTER(isIRI(?m))
              ?m ?seqP ?seqV . FILTER(isNumeric(?seqV)) BIND(xsd:double(?seqV) AS ?sn)
              FILTER(NOT EXISTS { $this c:memberClass ?anyClass } || EXISTS { $this c:memberClass ?mc . ?m a/rdfs:subClassOf* ?mc })
              FILTER NOT EXISTS { $this c:filteredBy ?tf . ?tf a c:TextFilter ; c:filterText ?text . FILTER(STRLEN(STR(?text)) > 0)
                                  FILTER NOT EXISTS { ?tf c:searches ?sp . ?m ?sp ?sv FILTER(CONTAINS(LCASE(STR(?sv)), LCASE(STR(?text)))) } }
              FILTER NOT EXISTS { $this c:filteredBy ?vf . ?vf a c:ValueFilter ; c:filterProperty ?vp ; c:filterValue ?vv . FILTER(?vv != c:AnyValue) FILTER NOT EXISTS { ?m ?vp ?vv } }
              FILTER NOT EXISTS { $this c:filteredBy ?ff . ?ff a c:FlagFilter ; c:filterProperty ?fp ; c:filterValue ?fv ; c:included false . ?m ?fp ?fv }
              OPTIONAL { $this c:sortColumn ?sc0 } BIND(COALESCE(?sc0, c:none) AS ?sc) BIND(EXISTS { $this c:sortDescending true } AS ?desc)
              OPTIONAL { ?sc c:cellAs ?sk0 } BIND(COALESCE(?sk0, c:TextCell) AS ?sk)
              OPTIONAL { ?sc c:via ?sv0 } BIND(COALESCE(?sv0, c:none) AS ?svia)
              OPTIONAL { ?sc c:cellProperty ?scp0 } BIND(COALESCE(?scp0, c:none) AS ?scp)
              OPTIONAL { ?sc c:startProperty ?sst0 } BIND(COALESCE(?sst0, c:none) AS ?sst)
              OPTIONAL { ?sc c:endProperty ?sen0 } BIND(COALESCE(?sen0, c:none) AS ?sen)
              LATERAL { OPTIONAL { ?m ?svia ?shop } }
              BIND(COALESCE(IF(?svia = c:none, ?m, ?shop), c:none) AS ?ss)
              LATERAL { OPTIONAL { ?ss ?scp ?sval0 } }
              LATERAL { OPTIONAL { ?ss ?sst ?sa FILTER(isNumeric(?sa)) } }
              LATERAL { OPTIONAL { ?ss ?sen ?sb FILTER(isNumeric(?sb)) } }
              BIND(COALESCE(?sval0, c:none) AS ?sval)
              LATERAL { OPTIONAL { ?sval sem:order ?sord FILTER(isNumeric(?sord)) } }
              LATERAL {
                OPTIONAL { ?sval c:label ?svl0 FILTER(lang(?svl0) = "") } OPTIONAL { ?sval c:label ?svl1 FILTER(langMatches(lang(?svl1), "en")) }
                OPTIONAL { ?sval rdfs:label ?svl2 FILTER(lang(?svl2) = "") } OPTIONAL { ?sval rdfs:label ?svl3 FILTER(langMatches(lang(?svl3), "en")) }
              }
              BIND(IF(?sc = c:none, ?unset, IF(?sk = c:TimeBarCell, xsd:double(?sa), IF(?sk = c:DurationCell, xsd:double(?sb) - xsd:double(?sa),
                   IF(?sval = c:none, ?unset, IF(isIRI(?sval), xsd:double(?sord), IF(isNumeric(?sval), xsd:double(?sval), ?unset)))))) AS ?vnum)
              BIND(IF(?sc = c:none || ?sk IN (c:TimeBarCell, c:DurationCell) || ?sval = c:none, ?unset,
                   IF(isIRI(?sval), IF(BOUND(?sord), ?unset, STR(COALESCE(?svl0, ?svl1, ?svl2, ?svl3, REPLACE(STR(?sval), "^.*[#/]", "")))),
                   IF(isNumeric(?sval), ?unset, STR(?sval)))) AS ?vstr)
              BIND(BOUND(?vnum) AS ?isNum) BIND(?isNum || BOUND(?vstr) AS ?hv)
              BIND(COALESCE(?vnum, 0) AS ?vn) BIND(COALESCE(?vstr, STR(?vnum), "") AS ?vs)
            }
          }
          FILTER(?nsn > ?low && ?nsn <= ?shownEnd)
          FILTER(?n = ?m || IF(?nhv && ?hv,
             IF(?nIsNum && ?isNum, IF(?nvn = ?vn, ?nsn < ?sn, IF(?desc, ?nvn > ?vn, ?nvn < ?vn)),
                                   IF(?nvs = ?vs, ?nsn < ?sn, IF(?desc, ?nvs > ?vs, ?nvs < ?vs))),
             IF(?nhv != ?hv, ?nhv, ?nsn < ?sn)))
        } GROUP BY ?low ?shownEnd ?m
      }
      BIND(IRI(CONCAT(?g, "/~r-", SUBSTR(MD5(STR(?m)), 1, 8))) AS ?row)
      BIND(IRI(CONCAT(?g, "/~cols")) AS ?cols)
      BIND(?bodyNode AS ?body)
      BIND(STR(?rank) AS ?orderKey)
      BIND(IF(?m = ?sel, true, ?unset) AS ?isSelected)
      BIND(IF(IF(?selectionShown, ?m = ?sel, ?rank = 1), true, ?unset) AS ?tabStop)
      # A grid that is a drag source: each row can be picked up, carrying its member.
      BIND(IF(EXISTS { $this a/rdfs:subClassOf* dnd:DragSource }, ?row, ?unset) AS ?dragRow)
    } UNION {
      # No matching member: a row saying so, across the shown columns.
      FILTER(!?any)
      { SELECT (COUNT(?col) AS ?shownColumns) WHERE {
          $this c:gridColumns ?cl . ?cl rdf:rest*/rdf:first ?col . FILTER(isIRI(?col))
          FILTER(NOT EXISTS { $this c:shows ?anyShown } || EXISTS { $this c:shows ?col })
      } }
      OPTIONAL { $this c:emptyText ?rawEmpty FILTER(lang(?rawEmpty) = "") }
      VALUES (?local ?tag ?parentLocal) { ("empty-row" rdfhtml:Tr "body") ("empty-cell" rdfhtml:Td "empty-row") }
      BIND(IRI(CONCAT(?g, "/~", ?local)) AS ?el)
      BIND(IRI(CONCAT(?g, "/~", ?parentLocal)) AS ?parent)
      BIND(IF(?local = "empty-cell", "sem-empty", ?unset) AS ?cls)
      BIND(IF(?local = "empty-cell", STR(IF(?shownColumns < 1, 1, ?shownColumns)), ?unset) AS ?colSpan)
      BIND(IF(?local = "empty-cell", ?el, ?unset) AS ?txtParent)
      BIND(IF(?local = "empty-cell", IRI(CONCAT(?g, "/~empty-text")), ?unset) AS ?txt)
      BIND(STR(COALESCE(?rawEmpty, "No rows.")) AS ?data)
    } UNION {
      # The waterfall's scale: from the earliest start to the latest end of the rows shown.
      FILTER(?any && ?lo0 < 1e300)
      BIND(?lo0 AS ?lo)
      BIND(IF(?hi0 < ?lo0 + 1, ?lo0 + 1, ?hi0) AS ?hi)
      BIND(IRI(CONCAT(?g, "/~scale")) AS ?scale)
      BIND(?bodyNode AS ?body)
      BIND(CONCAT("--scale-start: ", STR(?lo), "; --scale-end: ", STR(?hi)) AS ?scaleStyle)
    } UNION {
      FILTER(?any)
      BIND(IRI(CONCAT(?g, "/~window")) AS ?window)
    } UNION {
      # The footer: what matches and what is shown; follow, jump to the latest, older, newer.
      BIND(?any && ?first > 1 AS ?hasOlder)
      BIND(?E < ?total AS ?hasNewer)
      VALUES (?local ?key) { ("status" 1) ("follow" 2) ("jump" 3) ("older" 4) ("newer" 5) }
      FILTER(?local != "jump" || ?pinned)
      BIND(IRI(CONCAT(?g, "/~", ?local)) AS ?el)
      BIND(IRI(CONCAT(?g, "/~footer")) AS ?parent)
      BIND(STR(IF(!?pinned && ?key > 3, ?key - 1, ?key)) AS ?elKey)
      BIND(IF(?local = "status", rdfhtml:Span, rdfhtml:Button) AS ?tag)
      BIND(IF(?local = "status", ?unset, "button") AS ?type)
      BIND(IF(?local = "status", "sem-status", IF(?local = "follow", "sem-follow", IF(?local = "jump", "sem-jump", "sem-page"))) AS ?cls)
      BIND(IF((?local = "older" && !?hasOlder) || (?local = "newer" && !?hasNewer), "", ?unset) AS ?disabled)
      BIND(IF((?local = "follow" && ?pinned) || ?local = "jump" || (?local = "newer" && ?hasNewer && ?E + ?P >= ?total), true, ?unset) AS ?followsLatest)
      BIND(IF(?local = "follow" && !?pinned && ?any, ?shownEnd, IF(?local = "older" && ?hasOlder, ?olderEnd,
           IF(?local = "newer" && ?hasNewer && ?E + ?P < ?total, ?newerEnd, ?unset))) AS ?windowTo)
      BIND(?el AS ?txtParent)
      BIND(IRI(CONCAT(?g, "/~", ?local, "-text")) AS ?txt)
      BIND(IF(?local = "status", CONCAT(STR(?total), " matching · ", IF(?any, CONCAT("showing ", STR(?first), "–", STR(?E)), "none shown")),
           IF(?local = "follow", "Follow latest", IF(?local = "jump", CONCAT(STR(?total - ?E), " new · Jump to latest"),
           IF(?local = "older", "Older", "Newer")))) AS ?data)
    } UNION {
      BIND(IRI(CONCAT(?g, "/~follow")) AS ?owner)
      BIND(IRI(CONCAT(?g, "/~follow-aria-pressed")) AS ?attr)
      BIND("aria-pressed" AS ?name)
      BIND(STR(!?pinned) AS ?value)
    }
  }
}
