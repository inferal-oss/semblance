exports[`SERVICE: WAT and Rust give the same results and send the same requests > a hostile literal is escaped 1`] = `
{
  "results": {
    "requests": undefined,
    "rows": [
      ""x\\"y"@en",
    ],
  },
  "rust": [
    "POST https://one.example/sparql
SELECT * WHERE { ?s <http://p> ?o }
VALUES (?o) {
  ("x\\"y"@en)
  ("a\\") } ; DROP ALL #")
}",
  ],
  "wat": [
    "POST https://one.example/sparql
SELECT * WHERE { ?s <http://p> ?o }
VALUES (?o) {
  ("x\\"y"@en)
  ("a\\") } ; DROP ALL #")
}",
  ],
}
`;

