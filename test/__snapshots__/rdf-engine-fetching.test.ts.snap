exports[`SERVICE: WAT and Rust give the same results and send the same requests > nested SERVICE 1`] = `
{
  "results": {
    "requests": undefined,
    "rows": [
      "http://a "1" "two"",
      "http://a "x\\"y"@en "two"",
    ],
  },
  "rust": [
    "POST https://one.example/sparql
PREFIX e: <http://>
SELECT * WHERE { ?s e:p ?o SERVICE <https://two.example/sparql> { ?s e:q ?z } }",
    "POST https://two.example/sparql
PREFIX e: <http://>
SELECT * WHERE { ?s e:q ?z }
VALUES (?s) {
  (<http://a>)
  (<http://b>)
}",
  ],
  "wat": [
    "POST https://one.example/sparql
PREFIX e: <http://>
SELECT * WHERE { ?s e:p ?o SERVICE <https://two.example/sparql> { ?s e:q ?z } }",
    "POST https://two.example/sparql
PREFIX e: <http://>
SELECT * WHERE { ?s e:q ?z }
VALUES (?s) {
  (<http://a>)
  (<http://b>)
}",
  ],
}
`;

