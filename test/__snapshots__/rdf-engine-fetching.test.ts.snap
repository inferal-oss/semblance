// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LOAD > INTO GRAPH 1`] = `
{
  "quads": [
    "http://a http://alias http://a b> } # ",
    "http://a http://r https://two.example/sparql ",
    "http://b http://alias http://a ",
    "http://b http://r "not an IRI" ",
    "http://c http://r _ ",
    "http://e http://p "z" http://g",
  ],
}
`;

exports[`LOAD > Jelly: its default graph only 1`] = `
{
  "quads": [
    "http://a http://alias http://a b> } # ",
    "http://a http://r https://two.example/sparql ",
    "http://b http://alias http://a ",
    "http://b http://r "not an IRI" ",
    "http://c http://r _ ",
    "http://j http://p "jelly"@en http://g",
    "http://j http://p _ http://g",
  ],
}
`;

exports[`LOAD > a failed LOAD undoes the update 1`] = `
{
  "error": "LOAD <https://data.example/dumps/missing.ttl>: could not be reached",
}
`;

exports[`LOAD > a type it does not read 1`] = `
{
  "error": "LOAD <https://data.example/dumps/d.json>: unexpected content type application/ld+json",
}
`;

exports[`LOAD > in order with the other operations 1`] = `
{
  "quads": [
    "http://a http://alias http://a b> } # ",
    "http://a http://r https://two.example/sparql ",
    "http://b http://alias http://a ",
    "http://b http://r "not an IRI" ",
    "http://c http://r _ ",
    "http://e http://p "z" ",
    "http://e http://seen "true" ",
  ],
}
`;

exports[`LOAD > into the default graph 1`] = `
{
  "quads": [
    "_ http://p "y"@en ",
    "http://a http://alias http://a b> } # ",
    "http://a http://r https://two.example/sparql ",
    "http://b http://alias http://a ",
    "http://b http://r "not an IRI" ",
    "http://c http://r _ ",
    "http://d http://p _ ",
  ],
}
`;

exports[`LOAD > unlisted 1`] = `
{
  "error": "LOAD <https://evil.example/x.ttl>: not a document this page may load",
}
`;

exports[`LOAD > unlisted, SILENT: nothing 1`] = `
{
  "quads": [
    "http://a http://alias http://a b> } # ",
    "http://a http://r https://two.example/sparql ",
    "http://b http://alias http://a ",
    "http://b http://r "not an IRI" ",
    "http://c http://r _ ",
    "http://k http://k http://k ",
  ],
}
`;

exports[`SERVICE: WAT and Rust give the same results and send the same requests > MINUS and UNION around SERVICE 1`] = `
{
  "results": {
    "requests": undefined,
    "rows": [
      "http://b",
      "http://b",
      "http://c",
    ],
  },
  "rust": [
    "POST https://one.example/sparql
SELECT * WHERE { ?s <http://p> 2 }",
    "POST https://two.example/sparql
SELECT * WHERE { ?s <http://q> "two" }",
  ],
  "wat": [
    "POST https://one.example/sparql
SELECT * WHERE { ?s <http://p> 2 }",
    "POST https://two.example/sparql
SELECT * WHERE { ?s <http://q> "two" }",
  ],
}
`;

exports[`SERVICE: WAT and Rust give the same results and send the same requests > OPTIONAL SERVICE 1`] = `
{
  "results": {
    "requests": undefined,
    "rows": [
      "http://a https://two.example/sparql "two"",
      "http://b "not an IRI" -",
      "http://c _ -",
    ],
  },
  "rust": [
    "POST https://two.example/sparql
SELECT * WHERE { ?s <http://q> ?x }
VALUES (?s) {
  (<http://a>)
  (<http://b>)
  (<http://c>)
}",
  ],
  "wat": [
    "POST https://two.example/sparql
SELECT * WHERE { ?s <http://q> ?x }",
  ],
}
`;

exports[`SERVICE: WAT and Rust give the same results and send the same requests > a blank node is not sent 1`] = `
{
  "results": {
    "requests": undefined,
    "rows": [],
  },
  "rust": [
    "POST https://two.example/sparql
SELECT * WHERE { ?b <http://q> ?x }
VALUES (?b) {
  (<https://two.example/sparql>)
  ("not an IRI")
}",
    "POST https://two.example/sparql
SELECT * WHERE { ?b <http://q> ?x }",
  ],
  "wat": [
    "POST https://two.example/sparql
SELECT * WHERE { ?b <http://q> ?x }",
  ],
}
`;

