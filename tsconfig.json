{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@inferal-oss/semblance": ["./src/index.ts"],
      "@inferal-oss/semblance/*": ["./src/*/index.ts"],
      "@inferal-oss/semblance-react": ["./packages/react/src/index.ts"],
      "@inferal-oss/semblance-react/server": ["./packages/react/src/server.ts"]
    }
  },
  "include": ["src", "test", "bench", "demo", "scripts", "rdf-engine", "examples", "packages"]
}
