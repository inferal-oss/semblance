@prefix c: <https://semblance.dev/ns/component#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

c:DesktopShape a sh:NodeShape ; sh:targetClass c:Desktop ;
    sh:property [ sh:path c:tileLayout ; sh:maxCount 1 ; sh:class c:DesktopLayout ;
                  sh:message "A desktop has at most one layout mode." ] ,
                [ sh:path c:tileColumns ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 12 ;
                  sh:message "A grid desktop has 1 to 12 columns." ] .
