@prefix c: <https://semblance.dev/ns/component#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A desktop that tiles takes c:Grid's parameters (c:columns, c:minWidth; see c:tileLayout).
c:DesktopShape a sh:NodeShape ; sh:targetClass c:Desktop ;
    sh:property [ sh:path c:tileLayout ; sh:maxCount 1 ; sh:class c:DesktopLayout ;
                  sh:message "A desktop has at most one layout." ] ,
                [ sh:path c:columns ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 1 ; sh:maxInclusive 24 ;
                  sh:message "A tiling desktop has 1 to 24 columns at most." ] ,
                [ sh:path c:minWidth ; sh:maxCount 1 ; sh:pattern "^[0-9]+([.][0-9]+)?(px|rem|em|ch|vw|%)$" ;
                  sh:message "A tile's least width is a CSS length (\"320px\", \"20rem\")." ] .

# What a docked frame's free edge may size it to (c:DockResizable).
c:DockResizableShape a sh:NodeShape ; sh:targetClass c:DockResizable ;
    sh:property [ sh:path c:minSize ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:lessThanOrEquals c:maxSize ;
                  sh:message "A docked size's least (c:minSize) is a whole number of px, no more than its most (c:maxSize)." ] ,
                [ sh:path c:maxSize ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
                  sh:message "A docked size's most (c:maxSize) is a whole number of px." ] .
