@prefix c: <https://semblance.dev/ns/component#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

c:GanttChartShape a sh:NodeShape ; sh:targetClass c:GanttChart ;
    sh:property [ sh:path c:view ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A Gantt chart needs one named SELECT view (c:view)." ] ,
                [ sh:path c:dataset ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
                [ sh:path c:taskVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:labelVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:startVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:endVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:baselineStartVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:baselineEndVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:uncertaintyVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:dependencyVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:milestoneVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:toneVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ,
                [ sh:path c:hrefVariable ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] .
