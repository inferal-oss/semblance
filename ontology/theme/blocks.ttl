@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix blk: <https://semblance.dev/ns/block#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Default theme for block documents (ontology/components/blocks.ttl): reading type, quiet structure.
# Spacing between blocks is the block's own top margin, so the first block of anything sits flush.

# --- the editor and the document ---
[] a sty:StyleRule ; sty:appliesTo c:BlockEditor ;
    sty:declares [ sty:property "display" ; sty:raw "block" ] ,
                 [ sty:property "inline-size" ; sty:raw "100%" ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] ,
                 [ sty:property "font-size" ; sty:token tok:text-md ] ,
                 [ sty:property "line-height" ; sty:token tok:leading-normal ] ,
                 [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:BlockEditor ; sty:part "> .sem-body" ;
    sty:declares [ sty:property "max-inline-size" ; sty:raw "72ch" ] ,
                 [ sty:property "overflow-wrap" ; sty:raw "break-word" ] ,
                 [ sty:property "outline" ; sty:raw "none" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Block ;
    sty:declares [ sty:property "margin-block" ; sty:raw "var(--sem-space-2) 0" ] ,
                 [ sty:property "margin-inline" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Block ; sty:state ":first-child" ;
    sty:declares [ sty:property "margin-block-start" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Document ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TextBlock ; sty:part ".sem-text" ;
    sty:declares [ sty:property "white-space" ; sty:raw "pre-wrap" ] .

# --- marks ---
[] a sty:StyleRule ; sty:appliesTo blk:TextBlock ; sty:part ".sem-text code" ;
    sty:declares [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "font-size" ; sty:raw "0.88em" ] ,
                 [ sty:property "padding" ; sty:raw "0.1em 0.3em" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "background" ; sty:token tok:surface-sunken ] ,
                 [ sty:property "box-decoration-break" ; sty:raw "clone" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TextBlock ; sty:part ".sem-text a[data-sem-mark]" ;
    sty:declares [ sty:property "color" ; sty:token tok:accent-11 ] ,
                 [ sty:property "text-decoration" ; sty:raw "underline" ] ,
                 [ sty:property "text-underline-offset" ; sty:raw "0.18em" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TextBlock ; sty:part ".sem-text a[data-sem-mark=mention]" ;
    sty:declares [ sty:property "text-decoration" ; sty:raw "none" ] ,
                 [ sty:property "padding" ; sty:raw "0 0.25em" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "background" ; sty:token tok:accent-3 ] .

# --- headings ---
[] a sty:StyleRule ; sty:appliesTo blk:Heading ;
    sty:declares [ sty:property "font-family" ; sty:token tok:font ] ,
                 [ sty:property "line-height" ; sty:token tok:leading-tight ] ,
                 [ sty:property "margin-block" ; sty:raw "var(--sem-space-5) 0" ] ,
                 [ sty:property "text-wrap" ; sty:raw "balance" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Heading1 ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-2xl ] , [ sty:property "font-weight" ; sty:raw "700" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Heading2 ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-xl ] , [ sty:property "font-weight" ; sty:raw "650" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Heading3 ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-lg ] , [ sty:property "font-weight" ; sty:raw "600" ] .

# --- lists ---
[] a sty:StyleRule ; sty:appliesTo blk:List ;
    sty:declares [ sty:property "padding-inline-start" ; sty:raw "1.5em" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Item ;
    sty:declares [ sty:property "margin-block" ; sty:raw "var(--sem-space-1) 0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Item ; sty:part "> .sem-children > *" ;
    sty:declares [ sty:property "margin-block-start" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo blk:TodoList ;
    sty:declares [ sty:property "list-style" ; sty:raw "none" ] ,
                 [ sty:property "padding-inline-start" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TodoItem ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-template-columns" ; sty:raw "auto 1fr" ] ,
                 [ sty:property "column-gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "align-items" ; sty:raw "baseline" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TodoItem ; sty:part "> .sem-check" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "inline-size" ; sty:raw "1em" ] ,
                 [ sty:property "block-size" ; sty:raw "1em" ] ,
                 [ sty:property "accent-color" ; sty:token tok:accent-9 ] .
[] a sty:StyleRule ; sty:appliesTo blk:TodoItem ; sty:part "> .sem-children" ;
    sty:declares [ sty:property "grid-column" ; sty:raw "2" ] .
[] a sty:StyleRule ; sty:appliesTo blk:TodoItem ; sty:state "[data-sem-done=true]" ; sty:part "> .sem-text" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "text-decoration" ; sty:raw "line-through" ] .

# --- toggle ---
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-template-columns" ; sty:raw "1.5em 1fr" ] ,
                 [ sty:property "align-items" ; sty:raw "baseline" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:part "> .sem-twisty" ;
    sty:declares [ sty:property "all" ; sty:raw "unset" ] ,
                 [ sty:property "cursor" ; sty:raw "pointer" ] ,
                 [ sty:property "inline-size" ; sty:raw "1.25em" ] ,
                 [ sty:property "block-size" ; sty:raw "1.25em" ] ,
                 [ sty:property "display" ; sty:raw "inline-grid" ] ,
                 [ sty:property "place-items" ; sty:raw "center" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "transition" ; sty:raw "rotate var(--sem-duration-fast) var(--sem-ease)" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:part "> .sem-twisty::before" ;
    sty:declares [ sty:property "content" ; sty:raw "'▸'" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:part "> .sem-twisty:hover" ;
    sty:declares [ sty:property "background" ; sty:token tok:surface-sunken ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:part "> .sem-twisty:focus-visible" ;
    sty:declares [ sty:property "outline" ; sty:raw "2px solid var(--sem-ring)" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:state "[data-expanded=true]" ; sty:part "> .sem-twisty" ;
    sty:declares [ sty:property "rotate" ; sty:raw "90deg" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:state ":dir(rtl)" ; sty:part "> .sem-twisty::before" ;
    sty:declares [ sty:property "content" ; sty:raw "'◂'" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:state ":dir(rtl)[data-expanded=true]" ; sty:part "> .sem-twisty" ;
    sty:declares [ sty:property "rotate" ; sty:raw "-90deg" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Toggle ; sty:part "> .sem-children" ;
    sty:declares [ sty:property "grid-column" ; sty:raw "2" ] .

# --- quote, callout ---
[] a sty:StyleRule ; sty:appliesTo blk:Quote ;
    sty:declares [ sty:property "padding-inline-start" ; sty:token tok:space-4 ] ,
                 [ sty:property "border-inline-start" ; sty:raw "3px solid var(--sem-border-strong)" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo blk:Callout ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-3) var(--sem-space-4)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] ,
                 [ sty:property "background" ; sty:raw "var(--tone-soft, var(--sem-surface-sunken))" ] ,
                 [ sty:property "color" ; sty:raw "var(--tone-text, var(--sem-text))" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Callout ; sty:part "> .sem-body" ;
    sty:declares [ sty:property "flex" ; sty:raw "1" ] , [ sty:property "min-inline-size" ; sty:raw "0" ] .

# --- divider, code, math ---
[] a sty:StyleRule ; sty:appliesTo blk:Divider ;
    sty:declares [ sty:property "border" ; sty:raw "0" ] ,
                 [ sty:property "border-block-start" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "margin-block" ; sty:raw "var(--sem-space-4)" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Code ;
    sty:declares [ sty:property "position" ; sty:raw "relative" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] ,
                 [ sty:property "background" ; sty:token tok:surface-sunken ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-3) var(--sem-space-4)" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Code ; sty:part "> pre" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "overflow-x" ; sty:raw "auto" ] ,
                 [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "font-size" ; sty:token tok:text-sm ] ,
                 [ sty:property "direction" ; sty:raw "ltr" ] ,
                 [ sty:property "text-align" ; sty:raw "start" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Code ; sty:part "> .sem-language" ;
    sty:declares [ sty:property "display" ; sty:raw "block" ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "margin-block-end" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo blk:Math ;
    sty:declares [ sty:property "text-align" ; sty:raw "center" ] ,
                 [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "padding" ; sty:token tok:space-2 ] ,
                 [ sty:property "direction" ; sty:raw "ltr" ] .

# --- table ---
[] a sty:StyleRule ; sty:appliesTo blk:Table ;
    sty:declares [ sty:property "border-collapse" ; sty:raw "collapse" ] ,
                 [ sty:property "display" ; sty:raw "block" ] ,
                 [ sty:property "max-inline-size" ; sty:raw "100%" ] ,
                 [ sty:property "overflow-x" ; sty:raw "auto" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Cell ;
    sty:declares [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-1) var(--sem-space-2)" ] ,
                 [ sty:property "text-align" ; sty:raw "start" ] ,
                 [ sty:property "vertical-align" ; sty:raw "top" ] ,
                 [ sty:property "margin" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Cell ; sty:state ":is(th)" ;
    sty:declares [ sty:property "font-weight" ; sty:raw "600" ] ,
                 [ sty:property "background" ; sty:token tok:surface-sunken ] .

# --- columns: side by side, one under the other on a phone ---
[] a sty:StyleRule ; sty:appliesTo blk:Columns ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-auto-flow" ; sty:raw "column" ] ,
                 [ sty:property "grid-auto-columns" ; sty:raw "minmax(0, 1fr)" ] ,
                 [ sty:property "gap" ; sty:token tok:space-5 ] .
[] a sty:StyleRule ; sty:appliesTo blk:Columns ; sty:atWidth sty:CompactWidth ;
    sty:declares [ sty:property "grid-auto-flow" ; sty:raw "row" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Column ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] , [ sty:property "min-inline-size" ; sty:raw "0" ] .

# --- media and links ---
[] a sty:StyleRule ; sty:appliesTo blk:Image ;
    sty:declares [ sty:property "margin-inline" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Image ; sty:part "> img" ;
    sty:declares [ sty:property "display" ; sty:raw "block" ] ,
                 [ sty:property "max-inline-size" ; sty:raw "100%" ] ,
                 [ sty:property "block-size" ; sty:raw "auto" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] .
[] a sty:StyleRule ; sty:appliesTo blk:Image ; sty:part "> figcaption" ;
    sty:declares [ sty:property "margin-block-start" ; sty:token tok:space-1 ] ,
                 [ sty:property "font-size" ; sty:token tok:text-sm ] ,
                 [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo blk:Embed ;
    sty:declares [ sty:property "margin-inline" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Embed ; sty:part "> iframe" ;
    sty:declares [ sty:property "display" ; sty:raw "block" ] ,
                 [ sty:property "inline-size" ; sty:raw "100%" ] ,
                 [ sty:property "aspect-ratio" ; sty:raw "16 / 9" ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] .
[] a sty:StyleRule ; sty:appliesTo blk:Linked ; sty:part "> a" ;
    sty:declares [ sty:property "display" ; sty:raw "inline-flex" ] ,
                 [ sty:property "align-items" ; sty:raw "baseline" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "color" ; sty:token tok:text ] ,
                 [ sty:property "text-decoration" ; sty:raw "none" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-1) var(--sem-space-2)" ] ,
                 [ sty:property "margin-inline" ; sty:raw "calc(-1 * var(--sem-space-2))" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Linked ; sty:part "> a:hover" ;
    sty:declares [ sty:property "background" ; sty:token tok:surface-sunken ] .
[] a sty:StyleRule ; sty:appliesTo blk:Linked ; sty:part "> a:focus-visible" ;
    sty:declares [ sty:property "outline" ; sty:raw "2px solid var(--sem-ring)" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Linked ; sty:part ".sem-name" ;
    sty:declares [ sty:property "text-decoration" ; sty:raw "underline" ] ,
                 [ sty:property "text-decoration-color" ; sty:token tok:border-strong ] ,
                 [ sty:property "text-underline-offset" ; sty:raw "0.18em" ] .
[] a sty:StyleRule ; sty:appliesTo blk:File ; sty:part ".sem-size" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-sm ] , [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo blk:Bookmark ; sty:part "> a" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] ,
                 [ sty:property "margin-inline" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-3) var(--sem-space-4)" ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-md ] .
[] a sty:StyleRule ; sty:appliesTo blk:Bookmark ; sty:part ".sem-title" ;
    sty:declares [ sty:property "font-weight" ; sty:raw "600" ] .
[] a sty:StyleRule ; sty:appliesTo blk:Bookmark ; sty:part ".sem-summary" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-sm ] , [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo blk:Bookmark ; sty:part ".sem-address" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "color" ; sty:token tok:faint ] ,
                 [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

# --- table of contents ---
[] a sty:StyleRule ; sty:appliesTo blk:Contents ; sty:part "> ol" ;
    sty:declares [ sty:property "list-style" ; sty:raw "none" ] ,
                 [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "0" ] ,
                 [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo blk:Contents ; sty:part "a" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "text-decoration" ; sty:raw "underline" ] ,
                 [ sty:property "text-decoration-color" ; sty:token tok:border ] .
[] a sty:StyleRule ; sty:appliesTo blk:Contents ; sty:part ".sem-level-2" ;
    sty:declares [ sty:property "padding-inline-start" ; sty:token tok:space-4 ] .
[] a sty:StyleRule ; sty:appliesTo blk:Contents ; sty:part ".sem-level-3" ;
    sty:declares [ sty:property "padding-inline-start" ; sty:token tok:space-6 ] .
