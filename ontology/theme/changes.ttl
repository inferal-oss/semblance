@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .

# Default theme for changes as a page (ontology/components/changes.ttl). What they show is the
# framework's own components (headings, cards, badges, alerts, code, diffs), styled by each theme;
# these rules only lay them out: one below the other, the facts and the affected terms in wrapping
# rows, a release's cards in columns that wrap, and a migration's renames as a table.

[] a sty:StyleRule ; sty:appliesTo c:ChangeLog ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-6 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeLog ; sty:part ".sem-release" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeLog ; sty:part ".sem-change-cards" ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-template-columns" ; sty:raw "repeat(auto-fill, minmax(min(100%, 22rem), 1fr))" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] .

[] a sty:StyleRule ; sty:appliesTo c:ChangeSummary ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeSummary ; sty:part ".sem-summary" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeSummary ; sty:part ".sem-tags" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeSummary ; sty:part ".sem-meta" ;
    sty:declares [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] .

[] a sty:StyleRule ; sty:appliesTo c:ChangeEntry ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-4 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeEntry ; sty:part ".sem-change-facts" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeEntry ; sty:part ".sem-change-affects" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] .
[] a sty:StyleRule ; sty:appliesTo c:ChangeEntry ; sty:part ".sem-date" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-size" ; sty:token tok:text-sm ] .

[] a sty:StyleRule ; sty:appliesTo c:MigrationView ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
[] a sty:StyleRule ; sty:appliesTo c:MigrationView ; sty:part ".sem-renames" ;
    sty:declares [ sty:property "border-collapse" ; sty:raw "collapse" ] ,
                 [ sty:property "inline-size" ; sty:raw "100%" ] ,
                 [ sty:property "font-size" ; sty:token tok:text-sm ] .
[] a sty:StyleRule ; sty:appliesTo c:MigrationView ; sty:part ".sem-renames th" ;
    sty:declares [ sty:property "text-align" ; sty:raw "start" ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-2) var(--sem-space-3)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo c:MigrationView ; sty:part ".sem-renames td" ;
    sty:declares [ sty:property "text-align" ; sty:raw "start" ] ,
                 [ sty:property "padding" ; sty:raw "var(--sem-space-2) var(--sem-space-3)" ] ,
                 [ sty:property "border-bottom" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo c:MigrationView ; sty:part ".sem-renames th" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] .
[] a sty:StyleRule ; sty:appliesTo c:MigrationView ; sty:part ".sem-renames code" ;
    sty:declares [ sty:property "font-family" ; sty:token tok:font-mono ] ,
                 [ sty:property "direction" ; sty:raw "ltr" ] ,
                 [ sty:property "unicode-bidi" ; sty:raw "isolate" ] .

[] a sty:StyleRule ; sty:appliesTo c:ComponentHistory ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] ,
                 [ sty:property "min-width" ; sty:raw "0" ] .
