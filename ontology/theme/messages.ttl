@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Default theme for the message components: a thread of bubbles, one's own at the end.

[] a sty:StyleRule ; sty:appliesTo c:MessageList ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] ,
                 [ sty:property "gap" ; sty:token tok:space-3 ] ,
                 [ sty:property "margin" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:raw "0" ] ,
                 [ sty:property "list-style" ; sty:raw "none" ] ,
                 [ sty:property "font-family" ; sty:token tok:font ] .

[] a sty:StyleRule ; sty:appliesTo c:Message ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "align-items" ; sty:raw "flex-end" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "max-width" ; sty:raw "min(36rem, 92%)" ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:part ".sem-message-main" ;
    sty:declares [ sty:property "min-width" ; sty:raw "0" ] ,
                 [ sty:property "padding" ; sty:tokens ( tok:space-2 tok:space-3 ) ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-lg ] ,
                 [ sty:property "border-end-start-radius" ; sty:token tok:radius-sm ] ,
                 [ sty:property "background" ; sty:token tok:surface-sunken ] ,
                 [ sty:property "border" ; sty:raw "1px solid var(--sem-border)" ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:part ".sem-message-meta" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-wrap" ; sty:raw "wrap" ] ,
                 [ sty:property "align-items" ; sty:raw "baseline" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] ,
                 [ sty:property "font-size" ; sty:token tok:text-xs ] ,
                 [ sty:property "color" ; sty:token tok:muted ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:part ".sem-author" ;
    sty:declares [ sty:property "font-weight" ; sty:raw "650" ] ,
                 [ sty:property "color" ; sty:token tok:text ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:part "time" ;
    sty:declares [ sty:property "font-variant-numeric" ; sty:raw "tabular-nums" ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:part ".sem-message-body" ;
    sty:declares [ sty:property "margin" ; sty:raw "2px 0 0" ] ,
                 [ sty:property "font-size" ; sty:token tok:text-sm ] ,
                 [ sty:property "line-height" ; sty:token tok:leading-normal ] ,
                 [ sty:property "color" ; sty:token tok:text ] ,
                 [ sty:property "white-space" ; sty:raw "pre-wrap" ] ,
                 [ sty:property "overflow-wrap" ; sty:raw "anywhere" ] .

# One's own messages (c:viewer): at the end, the bubble in the accent's soft fill.
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:state ".sem-mine" ;
    sty:declares [ sty:property "flex-direction" ; sty:raw "row-reverse" ] ,
                 [ sty:property "align-self" ; sty:raw "flex-end" ] .
[] a sty:StyleRule ; sty:appliesTo c:Message ; sty:state ".sem-mine" ; sty:part ".sem-message-main" ;
    sty:declares [ sty:property "background" ; sty:token tok:accent-soft ] ,
                 [ sty:property "border-color" ; sty:raw "transparent" ] ,
                 [ sty:property "border-end-start-radius" ; sty:token tok:radius-lg ] ,
                 [ sty:property "border-end-end-radius" ; sty:token tok:radius-sm ] .
