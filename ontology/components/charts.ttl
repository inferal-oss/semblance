    BIND(CONCAT(SUBSTR(?lyP, 1, STRLEN(?lyP) - 1), ".", SUBSTR(?lyP, STRLEN(?lyP))) AS ?ly)
    VALUES ?part { "reference" "reference-label" }
    BIND(IRI(CONCAT(?me, "/~", ?part)) AS ?el) BIND(IF(?part = "reference", svg:Line, svg:Text) AS ?tag) BIND(IRI(CONCAT(?me, "/~plot")) AS ?parent)
