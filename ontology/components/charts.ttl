    { SELECT (MIN(?x) AS ?x0) (MAX(?x) AS ?xN) (COUNT(DISTINCT ?x) AS ?nx) (MIN(?y) AS ?ymin) (MAX(?y) AS ?ymax) WHERE {
      $this c:view ?view . ?view rs:solution ?r .
      OPTIONAL { ?r rs:index ?idx }
