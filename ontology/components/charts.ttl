        OPTIONAL { ?slabelAt0 l10n:of $this ; l10n:label ?slabel0 }
    OPTIONAL { FILTER(!BOUND(?slabel0)) $this c:label ?slabel1 FILTER(isLiteral(?slabel1)) }
    OPTIONAL { ?slabelAt2 l10n:of $this ; l10n:name ?slabel2 }
