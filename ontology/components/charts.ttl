            $this c:view ?view . ?view rs:solution ?r .
      OPTIONAL { ?r rs:index ?idx }
      OPTIONAL { $this c:categoryVariable ?cv } OPTIONAL { $this c:valueVariable ?vv } OPTIONAL { $this c:seriesVariable ?sv } OPTIONAL { $this c:facetVariable ?fv }
      BIND(STR(?r) AS ?rs)
      BIND(COALESCE(?idx, ?rs) AS ?pos)
      # A binding is <row>-<variable> (view.ttl); "~" is in no variable's name.
      BIND(IRI(CONCAT(?rs, "-", COALESCE(STR(?cv), "category"))) AS ?cb)
      BIND(IRI(CONCAT(?rs, "-", COALESCE(STR(?vv), "value"))) AS ?vb)
      BIND(IRI(CONCAT(?rs, "-", COALESCE(STR(?sv), "~"))) AS ?sb)
      BIND(IRI(CONCAT(?rs, "-", COALESCE(STR(?fv), "~"))) AS ?fb)
      LATERAL { OPTIONAL { ?cb rs:value ?c0 } } LATERAL { OPTIONAL { ?vb rs:value ?v0 } }
      LATERAL { OPTIONAL { ?sb rs:value ?s0 } } LATERAL { OPTIONAL { ?fb rs:value ?f0 } }
      BIND(COALESCE(STR(?f0), "") AS ?fac) BIND(COALESCE(STR(?c0), "") AS ?cat) BIND(IF(BOUND(?sv), COALESCE(STR(?s0), ""), "") AS ?ser)
            FILTER(BOUND(?s0)) BIND(STR(?s0) AS ?skey)
          } GROUP BY ?skey }
          OPTIONAL {
            $this c:view ?view2 ; c:seriesVariable ?sv2 . ?view2 rs:solution ?r2 . ?r2 rs:binding ?b2 . ?b2 rs:variable ?svs2 ; rs:value ?s2 .
