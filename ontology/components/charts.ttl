    BIND(STR(xsd:integer(ROUND((260 - ((sx:log10(?end) - ?yLo) / ?ySpan) * 244) * 10) + 0.5)) AS ?ry2D)
    BIND(IF(STRLEN(?ry2D) <= 1, CONCAT("0", ?ry2D), ?ry2D) AS ?ry2P)
