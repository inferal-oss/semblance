    OPTIONAL { $this c:logScale ?log0 } BIND(COALESCE(STR(?log0) = "true", false) AS ?log)
    BIND(FLOOR(sx:log10(?ymin)) AS ?yLo) BIND(CEIL(sx:log10(?ymax)) AS ?yHi)
    BIND(IF(?log, sx:log10(?x0), ?x0) AS ?tx0) BIND(IF(?log, sx:log10(?xN), ?xN) AS ?txN)
    BIND(IF(?txN - ?tx0 = 0, 1, ?txN - ?tx0) AS ?xSpan) BIND(IF(?yHi - ?yLo = 0, 1, ?yHi - ?yLo) AS ?ySpan)
    { SELECT ?skey ?si ?slabel WHERE {
      {
        # A declared legend (c:legend): its series in order, by c:key (else the node).
        $this c:legend ?list . ?list rdf:rest* ?cell . ?cell rdf:first ?sn .
        { SELECT ?cell (COUNT(?before) AS ?si) WHERE { $this c:legend ?l2 . ?l2 rdf:rest* ?cell . ?cell rdf:first ?any . OPTIONAL { ?l2 rdf:rest* ?before . ?before rdf:rest/rdf:rest* ?cell } } GROUP BY ?cell }
        OPTIONAL { ?sn c:key ?k0 } BIND(COALESCE(STR(?k0), STR(?sn)) AS ?skey)
        OPTIONAL { ?slabelAt0 l10n:of ?sn ; l10n:label ?slabel0 }
