      FILTER(?ser = ?skey)
      { SELECT ?pos (?y AS ?y0) WHERE { $this c:view ?view . ?view rs:solution ?r .
      OPTIONAL { ?r rs:index ?idx }
      OPTIONAL { $this c:categoryVariable ?cv } OPTIONAL { $this c:valueVariable ?vv } OPTIONAL { $this c:seriesVariable ?sv } OPTIONAL { $this c:facetVariable ?fv }
