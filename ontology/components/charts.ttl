    BIND(IRI(CONCAT(?me, "/~xlab", STR(?i))) AS ?el) BIND(svg:Text AS ?tag) BIND(IRI(CONCAT(?me, "/~plot")) AS ?parent)
    BIND(CONCAT("\\u0001n1\\u0001n", STR(?i)) AS ?key)
