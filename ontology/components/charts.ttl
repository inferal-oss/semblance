    BIND(IF(?part = "reference", ?unset, ?lx) AS ?a_x) BIND(IF(?part = "reference", ?unset, ?ly) AS ?a_y) BIND(IF(?part = "reference", ?unset, "end") AS ?a_text_anchor)
    BIND(IF(?part = "reference", "proportional (linear) growth from the slowest configuration", ?unset) AS ?tip)
    BIND(IF(?part = "reference", ?unset, IRI(CONCAT(?me, "/~reference-label-t"))) AS ?textNode) BIND(IF(?part = "reference", ?unset, "linear") AS ?data)
  } UNION {
    # A line per series of the legend that has points: through them by size (ties in row order).
    FILTER(!BOUND(?message))
    { SELECT (MIN(?x) AS ?x0) (MAX(?x) AS ?xN) (COUNT(DISTINCT ?x) AS ?nx) (MIN(?y) AS ?ymin) (MAX(?y) AS ?ymax) WHERE {
      $this c:view ?view . ?view rs:solution ?r .
      OPTIONAL { ?r rs:index ?idx }
