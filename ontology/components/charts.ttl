    BIND(IF(STRLEN(?rx1D) <= 1, CONCAT("0", ?rx1D), ?rx1D) AS ?rx1P)
    BIND(CONCAT(SUBSTR(?rx1P, 1, STRLEN(?rx1P) - 1), ".", SUBSTR(?rx1P, STRLEN(?rx1P))) AS ?rx1)
    BIND(STR(xsd:integer(ROUND((260 - ((sx:log10(?start) - ?yLo) / ?ySpan) * 244) * 10) + 0.5)) AS ?ry1D)
    BIND(IF(STRLEN(?ry1D) <= 1, CONCAT("0", ?ry1D), ?ry1D) AS ?ry1P)
    BIND(CONCAT(SUBSTR(?ry1P, 1, STRLEN(?ry1P) - 1), ".", SUBSTR(?ry1P, STRLEN(?ry1P))) AS ?ry1)
    BIND(STR(xsd:integer(ROUND((62 + ((IF(?log, sx:log10(?xN), ?xN) - ?tx0) / ?xSpan) * 478) * 10) + 0.5)) AS ?rx2D)
    BIND(IF(STRLEN(?rx2D) <= 1, CONCAT("0", ?rx2D), ?rx2D) AS ?rx2P)
