@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix dnd: <https://semblance.dev/ns/dragdrop#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# RDF editor: an RDF document as structure, not text (#170). A tree of resources, their
# predicates and their objects, with what nests nested: blank nodes (and skolem IRIs), lists, the
# reifiers of a statement (RDF 1.2: what is said about it), and, on its twisty, any IRI that has
# statements of its own. One component; with c:editable false (the default) it is a viewer.
#
# The document is the resources the editor lists (c:entry): the graph is one, shared with the UI,
# so a document is the set of its resources and what nests under them. An object that is a resource
# of the document is a link that jumps to it (c:current; a nav:Dimension over it gives Back and
# Forward); a class or a property is a link to the Reference (nav:goTo; nav:showsTerms resolves it).
#
# Rows are components the rows above them mint, as a c:JsonTree's nodes are, so each level costs
# what it shows: the editor mints a c:RdfTerm per resource (member-wise: sem:forEach c:entry), a term
# that is open mints a c:RdfProperty per predicate of its term (plus its list members and its
# reifiers), and a property mints a c:RdfTerm per object. A row's IRI is its parent's and a key
# (<parent>/~p-…, <parent>/~t-…), so a changed statement re-renders the rows of its subject, not
# the document; a closed row mints nothing. Whether a row is open is state on the row itself
# (c:expanded), so a twisty re-renders that row alone. The markup is a tree's (role=tree,
# treeitems with .sem-row, .sem-twisty, .sem-label), so the arrow keys move through it
# (key:TreeNavigation) and the tree styles apply.
#
# Arrows (c:arrows): a c:Connector from each object that is a resource of the document to that
# resource's row: off (the default), for every statement of the resources shown, or only for the
# statements from and to the current resource (c:current).

# --- vocabulary ------------------------------------------------------------------------------------

# c:expandDepth (payload.ttl) on an RDF editor: 0 starts its resources closed - for a large document,
# whose rows then cost one each until opened; off-screen rows are skipped by the browser
# (content-visibility), so a document of thousands of resources stays as fast to edit as a small one.
c:RdfEditor a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:label "RDF editor"@en , "Редактор RDF"@uk , "RDF-Editor"@de , "محرر RDF"@ar ;
    rdfs:comment """An RDF document as a tree (role=tree): each resource it lists (c:entry), its predicates, and
their objects, with blank nodes, lists and the reifiers of a statement nested under where they are used, and
any other IRI that has statements of its own opened in place on its twisty. Literals show with their datatype
or language. An object that is a resource of the document jumps to it (c:current); a class or a property links
to the Reference. c:arrows draws arrows from links to their resources: off, on (c:ArrowsOn) or for the current
resource only (c:ArrowsCurrent). c:editable true makes it an editor. c:label names it."""@en ;
    sem:slug "rdf-editor" ;
    key:navigation key:TreeNavigation .
c:editable a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "Editable"@en , "Можна редагувати"@uk , "Bearbeitbar"@de , "قابل للتحرير"@ar ;
    rdfs:comment "true: the component edits what it shows (default false: it is a viewer)."@en .
c:arrows a owl:ObjectProperty ; rdfs:domain c:RdfEditor ; rdfs:range c:ArrowsMode ;
    rdfs:label "Arrows"@en , "Стрілки"@uk , "Pfeile"@de , "الأسهم"@ar ;
    rdfs:comment "Which links an RDF editor draws as arrows to their resources (default c:ArrowsOff)."@en .
c:ArrowsMode a owl:Class ; rdfs:comment "Which links an RDF editor draws as arrows."@en .
c:ArrowsOff a c:ArrowsMode ; sem:slug "off" ; sem:order 1 ;
    rdfs:label "None"@en , "Немає"@uk , "Keine"@de , "بلا"@ar ;
    rdfs:comment "No arrows."@en .
c:ArrowsOn a c:ArrowsMode ; sem:slug "on" ; sem:order 2 ;
    rdfs:label "Every link"@en , "Усі зв'язки"@uk , "Alle Verweise"@de , "كل الروابط"@ar ;
    rdfs:comment "An arrow for every link of the resources shown."@en .
c:ArrowsCurrent a c:ArrowsMode ; sem:slug "current" ; sem:order 3 ;
    rdfs:label "From this resource"@en , "Від цього ресурсу"@uk , "Von dieser Ressource"@de , "من هذا المورد"@ar ;
    rdfs:comment "Arrows for the links from and to the current resource (c:current) only."@en .
# c:entry (calendar.ttl) lists the document's resources; c:current is the current one.

c:RdfRow a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:comment "Internal: a row of a c:RdfEditor (c:inEditor) at c:depth (0 for a resource of the document). c:expanded true or false, on the row, opens or closes it."@en .
c:RdfTerm a owl:Class ;
    rdfs:subClassOf c:RdfRow ;
    rdfs:comment """Internal: one term (c:term) at a place in an RDF editor: a resource of the document (depth 0), the
object of a statement (c:subjectTerm, c:predicateTerm), a member of a list (c:listCell, c:listIndex), or a
reifier of the statement of the row it is under (c:reifierOf)."""@en ;
    sem:slug "rdf-term" .
c:RdfProperty a owl:Class ;
    rdfs:subClassOf c:RdfRow ;
    rdfs:comment "Internal: one predicate (c:predicateTerm) of a resource (c:subjectTerm) in an RDF editor, with a c:RdfTerm per object."@en ;
    sem:slug "rdf-property" .
c:RdfDraggableRow a owl:Class ; rdfs:subClassOf dnd:Draggable ;
    rdfs:comment "Minted on a value's row of an editable RDF editor: dragging it (pointer, or Space and the arrows) carries its statement."@en .
# The tree keeps its roving tab stop: the drag layer gives a row none of its own.
c:RdfDraggableRow dnd:keepsFocus true .
c:RdfDropRow a owl:Class ; rdfs:subClassOf dnd:DropTarget ;
    rdfs:comment "Minted on a predicate's or a resource's row of an editable RDF editor: a statement dropped on it moves there; and on a list member's row: a member of the same list dropped on it takes its place."@en .
c:inEditor a owl:ObjectProperty ; rdfs:domain c:RdfRow ; rdfs:range c:RdfEditor .
c:diff a owl:DatatypeProperty ; rdfs:domain c:RdfEditor ; rdfs:range xsd:boolean ;
    rdfs:label "Diff"@en , "Різниця"@uk , "Unterschied"@de , "الفرق"@ar ;
    rdfs:comment """True: the editor shows what has changed, from what the change log records (beh:asserted,
beh:retracted; undone changes left out). A statement whose earliest recorded change added it, and that
is there, is marked added; one whose earliest recorded change removed it, and that is gone, is still
shown where it was, marked removed. Beside an editor of the same document it shows what the edits
there did; copied to its rows."""@en .
c:RdfAddedPhrase a c:Phrase ; rdfs:label "added"@en , "додано"@uk , "hinzugefügt"@de , "مضاف"@ar .
c:RdfRemovedPhrase a c:Phrase ; rdfs:label "removed"@en , "вилучено"@uk , "entfernt"@de , "محذوف"@ar .
c:startsClosed a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "Derived on a resource's row of an RDF editor whose c:expandDepth is 0: it is closed until opened."@en .
c:depth a owl:DatatypeProperty ; rdfs:domain c:RdfRow ; rdfs:range xsd:integer ;
    rdfs:comment "How deep a row is: 0 for a resource of the document, one more per row it is under."@en .
c:subjectTerm a owl:ObjectProperty ; rdfs:domain c:RdfRow ; rdfs:comment "The subject of the statement (or the resource of the predicate) a row shows."@en .
c:predicateTerm a owl:ObjectProperty ; rdfs:domain c:RdfRow ; rdfs:comment "The predicate of the statement a row shows."@en .
c:listCell a owl:ObjectProperty ; rdfs:domain c:RdfTerm ; rdfs:comment "The list cell (rdf:first) whose member a row shows."@en .
c:listIndex a owl:DatatypeProperty ; rdfs:domain c:RdfTerm ; rdfs:range xsd:integer ; rdfs:comment "A list member's place in its list, from 1."@en .
c:reifierOf a owl:ObjectProperty ; rdfs:domain c:RdfTerm ; rdfs:range c:RdfTerm ;
    rdfs:comment "On a row showing a reifier: the row of the statement it reifies (rdf:reifies)."@en .
c:jumpsTo a owl:ObjectProperty ; rdfs:comment "On a rendered label of an RDF editor: the resource of the document that activating it shows (c:current)."@en .
c:goesTo a owl:ObjectProperty ; rdfs:comment "On a rendered label of an RDF editor: the term that activating it goes to (nav:goTo: the Reference)."@en .
c:expandsTo a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "On a rendered twisty: what activating it sets its row's c:expanded to."@en .
c:focused a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "State on a row of an RDF editor: the row the focus goes to after the next change (a jump's resource)."@en .

c:RdfEditorKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "enter" ;
    rdfs:comment "Enter on a row of an RDF editor: follows its link (a viewer), or edits it (an editor); in a row's field, commits it."@en .
c:RdfEditorAddKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "shift+enter" ;
    rdfs:comment "Shift+Enter on a row of an RDF editor: adds an object beside an object, a statement beside a predicate or in a resource."@en .
c:RdfEditorEscapeKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "escape" ;
    rdfs:comment "Escape in a row's field of an RDF editor: leaves it unchanged."@en .
c:RdfEditorDeleteKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "delete" , "backspace" ;
    rdfs:comment "Delete or Backspace on a row of an RDF editor: removes its statement, its predicate's statements, a list member or a resource."@en .
c:RdfEditorNestKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "tab" ;
    rdfs:comment "Tab on a value of an RDF editor: wraps it into a new nested resource, as its rdf:value."@en .
c:RdfEditorOutdentKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "shift+tab" ;
    rdfs:comment "Shift+Tab on a statement of a nested resource: moves it up to the resource the nested one belongs to."@en .
c:RdfEditorMoveKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "alt+arrowup" , "alt+arrowdown" ;
    rdfs:comment "Alt+Up or Alt+Down on a list member of an RDF editor: moves it one place up or down its list."@en .
c:editing a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "State on a row of an RDF editor: its term is being edited, in a field in its place."@en .
c:adding a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:comment "State on a row of an RDF editor: a field under it takes a new object (a predicate's row) or a new statement (a resource's)."@en .
c:editing beh:viewState true . c:adding beh:viewState true . c:focused beh:viewState true .
c:draft a owl:DatatypeProperty ; beh:viewState true ; rdfs:comment "State on a row of an RDF editor: the text typed in its adding field so far (it filters the suggestions)."@en .
c:activeOption a owl:ObjectProperty ; beh:viewState true ;
    rdfs:comment "State on a row of an RDF editor: the suggestion highlighted under its adding field (Down and Up move it, Enter takes it)."@en .
c:RdfEditorTypeKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ;
    rdfs:comment "Any key on a row of an RDF editor: one that types a character (beh:text) starts editing the row with it."@en .
c:RdfEditorMenuKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "shift+f10" , "contextmenu" ;
    rdfs:comment "Shift+F10 or the Menu key on a row of an RDF editor: opens its menu."@en .
c:RdfEditorContextMenu a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "contextmenu" ;
    rdfs:comment "A right click (or a long press) on a row of an RDF editor: opens its menu instead of the browser's."@en .
c:RdfMenuEscapeKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "escape" ;
    rdfs:comment "Escape in a row menu of an RDF editor: closes it."@en .
c:cursor a owl:ObjectProperty ; beh:viewState true ; rdfs:comment "View state on an RDF editor: the row the focus is on (its status line says where)."@en .
c:cursorMode a owl:DatatypeProperty ; beh:viewState true ; rdfs:comment "View state on an RDF editor: viewing, editing or adding, by where the focus is."@en .
c:menuOpen a owl:DatatypeProperty ; rdfs:range xsd:boolean ; beh:viewState true ;
    rdfs:comment "State on a row of an RDF editor: its menu is open."@en .
c:rowOf a owl:ObjectProperty ; rdfs:comment "On a rendered label of an RDF editor: the row it is the label of."@en .
c:does a owl:ObjectProperty ; rdfs:range beh:Reaction ; rdfs:comment "On a rendered menu item: the reaction choosing it performs (it answers a click on the item)."@en .
c:actsOn a owl:ObjectProperty ; rdfs:comment "On a rendered menu item: the row it acts on."@en .
c:asKey a owl:DatatypeProperty ; rdfs:comment "On a rendered menu item: the key combination it stands for, where its reaction asks which (Alt+Up, Alt+Down)."@en .
c:RdfEditorChooseKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "arrowdown" , "arrowup" ;
    rdfs:comment "Down or Up in an adding field of an RDF editor: highlights the next or previous suggestion."@en .
c:suggestsFor a owl:ObjectProperty ; rdfs:comment "On a rendered suggestion of an RDF editor: the row whose adding field it completes."@en .
c:suggestsPredicate a owl:ObjectProperty ; rdfs:comment "On a rendered suggestion: the predicate it adds (with its c:suggestsValue, the whole statement)."@en .
c:suggestsValue a owl:ObjectProperty ; rdfs:comment "On a rendered suggestion: the value it adds."@en .
c:fillsWith a owl:DatatypeProperty ; rdfs:comment "On a rendered suggestion of a predicate alone: the text it puts in the field, for the value to follow."@en .
c:editsRow a owl:ObjectProperty ; rdfs:comment "On a rendered label of an editable RDF editor: the row that Enter, a double click, Shift+Enter and Delete act on."@en .
c:commits a owl:ObjectProperty ; rdfs:comment "On a rendered field of an RDF editor: the row whose term it edits."@en .
c:adds a owl:ObjectProperty ; rdfs:comment "On a rendered field of an RDF editor: the row it adds an object (a predicate's) or a statement (a resource's) to."@en .

c:RdfNestedPhrase a c:Phrase ; rdfs:label "nested resource"@en , "вкладений ресурс"@uk , "verschachtelte Ressource"@de , "مورد متداخل"@ar .
c:RdfListPhrase a c:Phrase ; rdfs:label "list of {n}"@en , "список із {n}"@uk , "Liste mit {n}"@de , "قائمة من {n}"@ar .
c:RdfEditPhrase a c:Phrase ; rdfs:label "Edit"@en , "Редагувати"@uk , "Bearbeiten"@de , "تحرير"@ar .
c:RdfNewObjectPhrase a c:Phrase ; rdfs:label "New value"@en , "Нове значення"@uk , "Neuer Wert"@de , "قيمة جديدة"@ar .
c:RdfNewStatementPhrase a c:Phrase ; rdfs:label "predicate value"@en , "предикат значення"@uk , "Prädikat Wert"@de , "خاصية قيمة"@ar .
c:RdfNewMemberPhrase a c:Phrase ; rdfs:label "New member"@en , "Новий елемент"@uk , "Neues Element"@de , "عنصر جديد"@ar .
c:RdfSuggestionsPhrase a c:Phrase ; rdfs:label "Expected here"@en , "Очікується тут"@uk , "Hier erwartet"@de , "المتوقع هنا"@ar .
c:RdfModeViewingPhrase a c:Phrase ; rdfs:label "Viewing"@en , "Перегляд"@uk , "Ansicht"@de , "عرض"@ar .
c:RdfModeEditingPhrase a c:Phrase ; rdfs:label "Editing"@en , "Редагування"@uk , "Bearbeiten"@de , "تحرير"@ar .
c:RdfModeAddingPhrase a c:Phrase ; rdfs:label "Adding"@en , "Додавання"@uk , "Hinzufügen"@de , "إضافة"@ar .
c:RdfKeyEditPhrase a c:Phrase ; rdfs:label "edit"@en , "редагувати"@uk , "bearbeiten"@de , "تحرير"@ar .
c:RdfKeyAddPhrase a c:Phrase ; rdfs:label "add"@en , "додати"@uk , "hinzufügen"@de , "إضافة"@ar .
c:RdfKeyDeletePhrase a c:Phrase ; rdfs:label "delete"@en , "видалити"@uk , "löschen"@de , "حذف"@ar .
c:RdfKeyNestPhrase a c:Phrase ; rdfs:label "nest"@en , "вкласти"@uk , "verschachteln"@de , "تضمين"@ar .
c:RdfKeyMovePhrase a c:Phrase ; rdfs:label "move"@en , "перемістити"@uk , "verschieben"@de , "نقل"@ar .
c:RdfKeyMenuPhrase a c:Phrase ; rdfs:label "menu"@en , "меню"@uk , "Menü"@de , "قائمة"@ar .
c:RdfKeyFollowPhrase a c:Phrase ; rdfs:label "follow"@en , "перейти"@uk , "folgen"@de , "انتقال"@ar .
c:RdfKeyOpenPhrase a c:Phrase ; rdfs:label "open, close"@en , "розгорнути, згорнути"@uk , "öffnen, schließen"@de , "فتح، إغلاق"@ar .
c:RdfKeySavePhrase a c:Phrase ; rdfs:label "save"@en , "зберегти"@uk , "speichern"@de , "حفظ"@ar .
c:RdfKeyCancelPhrase a c:Phrase ; rdfs:label "cancel"@en , "скасувати"@uk , "abbrechen"@de , "إلغاء"@ar .
c:RdfKeyChoosePhrase a c:Phrase ; rdfs:label "choose"@en , "вибрати"@uk , "wählen"@de , "اختيار"@ar .
c:RdfKeyClosePhrase a c:Phrase ; rdfs:label "close"@en , "закрити"@uk , "schließen"@de , "إغلاق"@ar .
c:RdfMenuEditPhrase a c:Phrase ; rdfs:label "Edit"@en , "Редагувати"@uk , "Bearbeiten"@de , "تحرير"@ar .
c:RdfMenuAddPhrase a c:Phrase ; rdfs:label "Add a statement"@en , "Додати твердження"@uk , "Aussage hinzufügen"@de , "إضافة عبارة"@ar .
c:RdfMenuNestPhrase a c:Phrase ; rdfs:label "Nest in a resource"@en , "Вкласти в ресурс"@uk , "In Ressource verschachteln"@de , "تضمين في مورد"@ar .
c:RdfMenuOutdentPhrase a c:Phrase ; rdfs:label "Move out"@en , "Винести рівнем вище"@uk , "Eine Ebene höher"@de , "نقل للخارج"@ar .
c:RdfMenuUpPhrase a c:Phrase ; rdfs:label "Move up"@en , "Вище"@uk , "Nach oben"@de , "تحريك لأعلى"@ar .
c:RdfMenuDownPhrase a c:Phrase ; rdfs:label "Move down"@en , "Нижче"@uk , "Nach unten"@de , "تحريك لأسفل"@ar .
c:RdfMenuGoPhrase a c:Phrase ; rdfs:label "Go to the resource"@en , "Перейти до ресурсу"@uk , "Zur Ressource"@de , "الانتقال إلى المورد"@ar .
c:RdfMenuReferencePhrase a c:Phrase ; rdfs:label "Open in the Reference"@en , "Відкрити в довіднику"@uk , "In der Referenz öffnen"@de , "فتح في المرجع"@ar .
c:RdfMenuDeletePhrase a c:Phrase ; rdfs:label "Delete"@en , "Видалити"@uk , "Löschen"@de , "حذف"@ar .
c:RdfRequiredPhrase a c:Phrase ; rdfs:label "required"@en , "обов'язково"@uk , "erforderlich"@de , "مطلوب"@ar .
c:RdfAboutPhrase a c:Phrase ; rdfs:label "about"@en , "про"@uk , "über"@de , "عن"@ar .
c:RdfReifierPhrase a c:Phrase ; rdfs:label "said about this statement"@en , "сказане про це твердження"@uk , "über diese Aussage gesagt"@de , "ما قيل عن هذه العبارة"@ar .

# --- the editor: the tree, and a resource row per entry ---------------------------------------------
# The root holds the tree (role=tree) and the arrows. The rows are placed member-wise: one evaluation
# per entry, so adding a resource adds its row and nothing else. A row passes the editor's
# c:editable down (the rows below copy it from theirs): a mode, not per-row state.

c:RdfEditorRendering a sem:Rendering ;
    sem:targets c:RdfEditor ;
    sem:stratum 0 ;
    sem:watches rdf:type , c:label , l10n:label .
c:RdfEditorRendering-fn a sem:Rule ; sem:implements c:RdfEditorRendering ; sem:function "rdf-editor" .
c:RdfEditorRendering-sparql-screen a sem:Rule ;
    sem:implements c:RdfEditorRendering ;
    sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?tree , ?arrows .
  ?tree a rdfhtml:Ul ; rdfhtml:class "sem-tree" ; rdfhtml:attribute ?role , ?name ; ord:immediatelyPrecedes ?arrows .
  ?role a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "tree" .
  ?name a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?label .
  ?arrows a rdfhtml:Div ; rdfhtml:class "sem-arrows" .
}
WHERE {
  $this a/rdfs:subClassOf* c:RdfEditor .
  OPTIONAL { $this l10n:label ?localLabel }
  OPTIONAL { $this c:label ?ownLabel FILTER(lang(?ownLabel) = "") }
  OPTIONAL { $this c:label ?anyLabel }
  BIND(STR(COALESCE(?localLabel, ?ownLabel, ?anyLabel)) AS ?label)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~tree")) AS ?tree)
  BIND(IRI(CONCAT(STR($this), "/~tree-role")) AS ?role)
  BIND(IF(BOUND(?label), IRI(CONCAT(STR($this), "/~tree-aria-label")), ?none) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~arrows")) AS ?arrows)
}""" .
c:RdfEditorRendering-sparql-text a sem:Rule ;
    sem:implements c:RdfEditorRendering ;
    sem:modality mod:Text ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?tree .
  ?tree a rdfhtml:Div .
}
WHERE {
  $this a/rdfs:subClassOf* c:RdfEditor .
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~tree")) AS ?tree)
}""" .

c:RdfEditorEntries a sem:Rendering ;
    sem:targets c:RdfEditor ;
    sem:stratum 0 ;
    sem:forEach c:entry ;
    sem:watches rdf:type , c:editable , c:validated , c:diff , c:expandDepth , c:current .
c:RdfEditorEntries-fn a sem:Rule ; sem:implements c:RdfEditorEntries ; sem:function "rdf-editor:entry" .
c:RdfEditorEntries-sparql a sem:Rule ;
    sem:implements c:RdfEditorEntries ;
    sem:construct """
CONSTRUCT {
  ?tree rdfhtml:hasChild ?row .
  ?row a c:RdfTerm , ?dropType ; c:term $member ; c:inEditor $this ; c:depth 0 ; c:startsClosed ?closed ; c:isCurrent ?isCurrent ; c:editable ?editable ; c:validated ?validated ; c:diff ?diffOn ; sem:orderKey ?key .
}
WHERE {
  $this a/rdfs:subClassOf* c:RdfEditor .
  $this c:entry $member . FILTER(isIRI($member))
  BIND(STR($member) AS ?key)
  BIND(EXISTS { $this c:editable true } AS ?editable)
  BIND(EXISTS { $this c:validated true } AS ?validated)
  BIND(IF(EXISTS { $this c:diff true }, true, ?none) AS ?diffOn)
  BIND(IF(?editable, c:RdfDropRow, ?none) AS ?dropType)
  BIND(IF(EXISTS { $this c:current $member }, true, ?none) AS ?isCurrent)
  # A large document starts closed (c:expandDepth 0): a row per resource until one is opened.
  BIND(IF(EXISTS { $this c:expandDepth ?d0 FILTER(xsd:integer(STR(?d0)) < 1) }, true, ?none) AS ?closed)
  BIND(IRI(CONCAT(STR($this), "/~tree")) AS ?tree)
  BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(?key), 1, 12))) AS ?row)
}""" .

# What the editor lists (c:lists): its resources, for a typeahead that jumps among them
# (c:optionsFrom the editor, controlling its c:current).
c:RdfEditorListing a sem:Rendering ; sem:targets c:RdfEditor ; sem:stratum -25 ; sem:watches rdf:type , c:entry .
c:RdfEditorListing-fn a sem:Rule ; sem:implements c:RdfEditorListing ; sem:function "rdf-editor:listing" .
c:RdfEditorListing-sparql a sem:Rule ;
    sem:implements c:RdfEditorListing ;
    sem:construct """CONSTRUCT { $this c:lists ?entry } WHERE { $this a/rdfs:subClassOf* c:RdfEditor ; c:entry ?entry FILTER(isIRI(?entry)) }""" .

# The arrows: from the row of each object that is a resource of the document (a statement of a
# resource shown, at the top level) to that resource's row. Rows are named by their keys, so the
# rule finds them without reading what the rows minted.
c:RdfEditorArrows a sem:Rendering ;
    sem:targets c:RdfEditor ;
    sem:modality mod:Screen ;
    sem:stratum 0 ;
    sem:requires c:arrows ;
    sem:follows c:entry .
c:RdfEditorArrows-fn a sem:Rule ; sem:implements c:RdfEditorArrows ; sem:function "rdf-editor:arrows" .
c:RdfEditorArrows-sparql a sem:Rule ;
    sem:implements c:RdfEditorArrows ;
    sem:construct """
CONSTRUCT {
  ?arrows rdfhtml:hasChild ?arrow .
  ?arrow a c:Connector ; c:from ?fromLabel ; c:to ?toLabel ; c:route c:Arc ; sty:tone sty:Accent ; sty:emphasis ?emphasis ; sem:orderKey ?key .
}
WHERE {
  $this a/rdfs:subClassOf* c:RdfEditor ; c:arrows ?mode .
  FILTER(?mode IN (c:ArrowsOn, c:ArrowsCurrent))
  OPTIONAL { $this c:current ?current }
  $this c:entry ?s . FILTER(isIRI(?s))
  ?s ?p ?o . FILTER(isIRI(?o) && !sameTerm(?o, ?s))
  $this c:entry ?o .
  FILTER(?mode = c:ArrowsOn || (BOUND(?current) && (sameTerm(?s, ?current) || sameTerm(?o, ?current))))
  BIND(IF(BOUND(?current) && (sameTerm(?s, ?current) || sameTerm(?o, ?current)), sty:Solid, ?none) AS ?emphasis)
  BIND(IRI(CONCAT(STR($this), "/~arrows")) AS ?arrows)
  BIND(CONCAT(STR($this), "/~t-", SUBSTR(MD5(STR(?s)), 1, 12)) AS ?sRow)
  BIND(IRI(CONCAT(?sRow, "/~p-", SUBSTR(MD5(STR(?p)), 1, 12), "/~t-", SUBSTR(MD5(STR(?o)), 1, 12), "/~label")) AS ?fromLabel)
  BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(STR(?o)), 1, 12), "/~label")) AS ?toLabel)
  BIND(CONCAT(STR(?s), " ", STR(?p), " ", STR(?o)) AS ?key)
  BIND(IRI(CONCAT(STR($this), "/~arrow-", SUBSTR(MD5(?key), 1, 12))) AS ?arrow)
}""" .

# --- a term at a place ----------------------------------------------------------------------------
# The row: a twisty when it can open (a resource of the document, a blank node, a list, a reifier, an
# IRI with statements of its own; or anything a reifier speaks about), the term (a prefixed name; a
# literal quoted, with its language or datatype; [ ] for a nested resource, ( n ) for a list, "~" before
# a reifier), and the term's label when it has one. Its group, when open: its list members, its
# predicates, and the reifiers of its statement.

c:RdfTermRendering a sem:Rendering ;
    sem:targets c:RdfTerm ;
    sem:stratum 0 ;
    sem:bulk false ;
    sem:follows c:term , ( c:term [ sem:zeroOrMore rdf:rest ] ) , ( c:term [ sem:inverse rdf:subject ] ) , ( c:subjectTerm [ sem:inverse rdf:subject ] ) .
c:RdfTermRendering-fn a sem:Rule ; sem:implements c:RdfTermRendering ; sem:function "rdf-editor:term" .
c:RdfTermRendering-sparql-screen a sem:Rule ;
    sem:implements c:RdfTermRendering ;
    sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Li ; sem:renders $this ; rdfhtml:class ?rootClass ; rdfhtml:attribute ?roleAttr , ?levelAttr , ?expandedAttr , ?currentAttr , ?changeAttr , ?changeSaid ; rdfhtml:hasChild ?row , ?group .
  ?changeAttr a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-change" ; rdfhtml:attributeValue ?change .
  ?changeSaid a rdfhtml:Attribute ; rdfhtml:attributeName "aria-description" ; rdfhtml:attributeValue ?changePhrase .
  ?currentAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-current" ; rdfhtml:attributeValue "true" .
  ?roleAttr a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "treeitem" .
  ?levelAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-level" ; rdfhtml:attributeValue ?level .
  ?expandedAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-expanded" ; rdfhtml:attributeValue ?openText .
  ?row a rdfhtml:Div ; rdfhtml:class "sem-row" ; rdfhtml:hasChild ?lead , ?label , ?edit , ?badge , ?note ; ord:precedes ?group .
  ?row c:rowOf $this ; rdfhtml:hasChild ?menu . ?lead ord:precedes ?menu . ?label ord:precedes ?menu . ?edit ord:precedes ?menu . ?badge ord:precedes ?menu . ?note ord:precedes ?menu .
  ?root rdfhtml:hasChild ?problems . ?row ord:immediatelyPrecedes ?problems . ?problems ord:precedes ?group .
  ?problems a rdfhtml:Div ; rdfhtml:class "sem-problems" ; rdfhtml:id ?problemsId ; rdfhtml:hasChild ?problem .
  ?problem a rdfhtml:Span ; rdfhtml:class "sem-problem" ; sem:orderKey ?problemText ; rdfhtml:hasChild ?problemData .
  ?problemData a rdfhtml:Text ; rdfhtml:data ?problemText .
  ?invalidAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-invalid" ; rdfhtml:attributeValue "true" .
  ?describedAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-describedby" ; rdfhtml:attributeValue ?problemsId .
  ?lead a ?leadTag ; rdfhtml:type ?leadType ; rdfhtml:class ?leadClass ; rdfhtml:tabIndex ?leadTabindex ; c:expands ?expands ; c:expandsTo ?expandsTo ; rdfhtml:attribute ?leadAttr ;
        rdfhtml:hasChild ?icon ; ord:immediatelyPrecedes ?label , ?edit .
  ?leadAttr a rdfhtml:Attribute ; rdfhtml:attributeName ?leadAttrName ; rdfhtml:attributeValue ?leadAttrValue .
  ?icon a rdfhtml:Span ; rdfhtml:attribute ?iconHidden ; rdfhtml:hasChild ?iconText .
  ?iconHidden a rdfhtml:Attribute ; rdfhtml:attributeName "aria-hidden" ; rdfhtml:attributeValue "true" .
  ?iconText a rdfhtml:Text ; rdfhtml:data "▸" .
  ?label a rdfhtml:Span ; rdfhtml:class ?labelClass ; rdfhtml:tabIndex ?tabindex ; c:jumpsTo ?jumpsTo ; c:goesTo ?goesTo ; c:editsRow ?editsRow ; rdfhtml:attribute ?linkAttr , ?focusAttr , ?descAttr , ?invalidAttr , ?describedAttr ;
         rdfhtml:hasChild ?labelText ; ord:precedes ?badge , ?note .
  ?linkAttr a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-link" ; rdfhtml:attributeValue ?link .
  ?focusAttr a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?descAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-description" ; rdfhtml:attributeValue ?description .
  ?labelText a rdfhtml:Text ; rdfhtml:data ?shown .
  ?edit a rdfhtml:Input ; rdfhtml:type "text" ; rdfhtml:class "sem-label sem-edit" ; rdfhtml:value ?editText ; c:commits $this ; rdfhtml:attribute ?editName , ?editFocus ;
        ord:precedes ?badge , ?note .
  ?editName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?editPhrase .
  ?editFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?badge a rdfhtml:Span ; rdfhtml:class "sem-datatype" ; rdfhtml:hasChild ?badgeText ; ord:precedes ?note .
  ?badgeText a rdfhtml:Text ; rdfhtml:data ?badgeData .
  ?note a rdfhtml:Span ; rdfhtml:class "sem-note" ; rdfhtml:hasChild ?noteText .
  ?noteText a rdfhtml:Text ; rdfhtml:data ?noteData .
  ?group a rdfhtml:Ul ; rdfhtml:attribute ?groupRole ; rdfhtml:hasChild ?child , ?addItem .
  ?groupRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "group" .
  ?addItem a rdfhtml:Li ; rdfhtml:class "sem-adding" ; sem:orderKey "\\u0001n9" ; rdfhtml:hasChild ?add .
  ?add a rdfhtml:Input ; rdfhtml:type "text" ; rdfhtml:class "sem-edit" ; rdfhtml:placeholder ?addPhrase ; c:adds $this ; rdfhtml:attribute ?addName , ?addFocus , ?comboRole , ?comboList , ?comboExpanded , ?comboControls , ?comboActive .
  ?comboRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "combobox" .
  ?comboList a rdfhtml:Attribute ; rdfhtml:attributeName "aria-autocomplete" ; rdfhtml:attributeValue "list" .
  ?comboExpanded a rdfhtml:Attribute ; rdfhtml:attributeName "aria-expanded" ; rdfhtml:attributeValue ?comboOpen .
  ?comboControls a rdfhtml:Attribute ; rdfhtml:attributeName "aria-controls" ; rdfhtml:attributeValue ?suggestionsId .
  ?comboActive a rdfhtml:Attribute ; rdfhtml:attributeName "aria-activedescendant" ; rdfhtml:attributeValue ?activeId .
  ?addName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?addPhrase .
  ?addFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?addItem rdfhtml:hasChild ?suggestions . ?add ord:immediatelyPrecedes ?suggestions ; rdfhtml:value ?draft .
  ?suggestions a rdfhtml:Div ; rdfhtml:class "sem-suggestions" ; rdfhtml:id ?suggestionsId ; rdfhtml:attribute ?sugRole , ?sugName ; rdfhtml:hasChild ?option .
  ?sugRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "listbox" .
  ?sugName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?sugPhrase .
  ?option a rdfhtml:Button ; rdfhtml:type "button" ; rdfhtml:class ?optionClass ; rdfhtml:id ?optionId ; rdfhtml:tabIndex "-1" ; rdfhtml:attribute ?optionRole , ?optionSelected ;
          sem:orderKey ?optionKey ; c:suggestsFor $this ;
          c:suggestsPredicate ?optP ; c:suggestsValue ?optV ; c:fillsWith ?fill ; rdfhtml:hasChild ?optionText , ?optionDetail .
  ?optionText ord:immediatelyPrecedes ?optionDetail .
  ?optionDetail a rdfhtml:Span ; rdfhtml:class "sem-detail" ; rdfhtml:hasChild ?optionDetailText .
  ?optionDetailText a rdfhtml:Text ; rdfhtml:data ?requiredPhrase .
  ?optionText a rdfhtml:Text ; rdfhtml:data ?optionLabel .
  ?optionRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "option" .
  ?optionSelected a rdfhtml:Attribute ; rdfhtml:attributeName "aria-selected" ; rdfhtml:attributeValue ?selected .
  ?menu a rdfhtml:Div ; rdfhtml:class "sem-menu" ; rdfhtml:attribute ?menuRole , ?menuItems , ?menuOrient , ?menuWrap ; rdfhtml:hasChild ?item .
  ?menuRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "menu" .
  ?menuItems a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-items" ; rdfhtml:attributeValue "[role=menuitem]" .
  ?menuOrient a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-orientation" ; rdfhtml:attributeValue "vertical" .
  ?menuWrap a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-wrap" ; rdfhtml:attributeValue "" .
  ?item a rdfhtml:Button ; rdfhtml:type "button" ; rdfhtml:class ?itemClass ; rdfhtml:tabIndex "-1" ; sem:orderKey ?itemN ;
        c:actsOn $this ; c:does ?itemDoes ; c:asKey ?itemAsKey ; c:jumpsTo ?itemJump ; c:goesTo ?itemGo ;
        rdfhtml:attribute ?itemRole , ?itemFocus , ?itemShortcut ; rdfhtml:hasChild ?itemText , ?itemKbd .
  ?itemRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "menuitem" .
  ?itemFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?itemShortcut a rdfhtml:Attribute ; rdfhtml:attributeName "aria-keyshortcuts" ; rdfhtml:attributeValue ?itemKeys .
  ?itemText a rdfhtml:Text ; rdfhtml:data ?itemLabel ; ord:immediatelyPrecedes ?itemKbd .
  ?itemKbd a rdfhtml:Kbd ; rdfhtml:attribute ?itemKbdHidden ; rdfhtml:hasChild ?itemKbdText .
  ?itemKbdHidden a rdfhtml:Attribute ; rdfhtml:attributeName "aria-hidden" ; rdfhtml:attributeValue "true" .
  ?itemKbdText a rdfhtml:Text ; rdfhtml:data ?itemKbdShown .
  ?child a ?childClass , ?childDrop , ?childDrag ; c:term ?childTerm ; c:subjectTerm ?childSubject ; c:predicateTerm ?childPredicate ; c:listCell ?childCell ; c:listIndex ?childIndex ;
         c:reifierOf ?childOf ; c:inEditor ?editor ; c:depth ?childDepth ; c:editable ?editable ; c:validated ?validated ; c:diff ?diffOn ; sem:orderKey ?childKey .
}
WHERE {
  $this a c:RdfTerm ; c:term ?t ; c:inEditor ?editor .
  OPTIONAL { $this c:depth ?depth0 }
  BIND(COALESCE(xsd:integer(STR(?depth0)), 0) AS ?depth)
  OPTIONAL { $this c:editable ?editable0 }
  BIND(COALESCE(?editable0, false) AS ?editable)
  OPTIONAL { $this c:validated ?validated0 }
  BIND(COALESCE(?validated0, false) AS ?validated)
  BIND(EXISTS { $this c:diff true } AS ?diff)
  BIND(IF(?diff, true, ?none) AS ?diffOn)
  OPTIONAL { $this c:subjectTerm ?s ; c:predicateTerm ?p }
  BIND(EXISTS { $this c:reifierOf ?of } AS ?reifier)
  # What the term is.
  BIND(isLiteral(?t) AS ?lit)
  BIND(IF(?lit, DATATYPE(?t), ?none) AS ?dt)
  BIND(IF(?lit, LANG(?t), "") AS ?lang)
  BIND(?lit && ?dt IN (xsd:integer, xsd:decimal, xsd:double, xsd:boolean) AS ?bare)
  BIND(sameTerm(?t, rdf:nil) || (!?lit && EXISTS { ?t rdf:first ?anyFirst }) AS ?list)
  BIND(isBlank(?t) || (isIRI(?t) && CONTAINS(STR(?t), "/.well-known/genid/")) AS ?blank)
  BIND(isIRI(?t) || isBlank(?t) AS ?resource)
  BIND(?resource && (EXISTS { ?t ?anyP ?anyO } || (EXISTS { $this c:diff true . ?gsth rdf:subject ?t ; rdf:predicate ?hp ; rdf:object ?ho . ?gevh beh:retracted ?gsth ; beh:sequence ?gseqh .
      FILTER NOT EXISTS { ?t ?hp ?ho } FILTER NOT EXISTS { ?gundoh beh:undone ?gevh }
      FILTER NOT EXISTS { ?gxsth rdf:subject ?t ; rdf:predicate ?hp ; rdf:object ?ho . ?gxevh beh:asserted|beh:retracted ?gxsth ; beh:sequence ?gxseqh . FILTER(?gxseqh < ?gseqh) FILTER NOT EXISTS { ?gxundoh beh:undone ?gxevh } } })) AS ?hasStatements)
  BIND(BOUND(?s) && EXISTS { ?anyR rdf:reifies <<( ?s ?p ?t )>> } AS ?reified)
  # A class or a property is a link to the Reference, not a resource to open in place (unless it is one of the document's).
  BIND(isIRI(?t) && !?blank && EXISTS { ?t a ?kind . VALUES ?kind { rdfs:Class owl:Class rdf:Property owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty } } AS ?vocab)
  BIND((?hasStatements && (?depth = 0 || !?vocab)) || ?reified AS ?expandable)
  OPTIONAL { $this c:expanded ?own }
  BIND((?depth = 0 && NOT EXISTS { $this c:startsClosed true }) || ?blank || ?list || ?reifier || ?reified AS ?openByDefault)
  BIND(?expandable && COALESCE(?own, ?openByDefault) AS ?open)
  # Open, it shows its reifiers; and its statements when it nests by nature, or was opened on purpose.
  BIND(?open && ?hasStatements && (?depth = 0 || ?blank || ?list || ?reifier || COALESCE(?own, false)) AS ?nest)
  # A link: to a resource of the document (jump), else to a class or a property (the Reference).
  BIND(?depth > 0 && isIRI(?t) && !?blank && EXISTS { ?editor c:entry ?t } AS ?jumps)
  BIND(!?jumps && ?vocab AS ?goes)
  BIND(IF(?jumps, ?t, ?none) AS ?jumpsTo)
  BIND(IF(?goes, ?t, ?none) AS ?goesTo)
  BIND(IF(?jumps, "resource", IF(?goes, "term", ?none)) AS ?link)
  # A prefixed name for an IRI (or a literal's datatype).
  BIND(IF(isIRI(?t) && !?blank, ?t, IF(?lit && !?bare && ?lang = "" && ?dt != xsd:string, ?dt, ?none)) AS ?named)
  BIND(COALESCE(REPLACE(STR(?named), "[^#/]*$", ""), "-~") AS ?ns)
  BIND(REPLACE(STR(?named), "^.*[#/]", "") AS ?local)
  OPTIONAL { { SELECT ?ns (MIN(?prefix0) AS ?prefix) WHERE { ?decl sh:prefix ?prefix0 ; sh:namespace ?ns0 BIND(STR(?ns0) AS ?ns) } GROUP BY ?ns } }
  BIND(IF(BOUND(?prefix) && REGEX(?local, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?prefix, ":", ?local), CONCAT("<", STR(?named), ">")) AS ?compact)
  OPTIONAL { { SELECT (COUNT(?cell0) AS ?count) WHERE { $this c:term ?h0 . ?h0 rdf:rest* ?cell0 . ?cell0 rdf:first ?m0 } } }
  BIND(IF(?lit, IF(?bare, STR(?t), CONCAT("\\"", STR(?t), "\\"")),
       IF(?list, CONCAT("( ", STR(COALESCE(?count, 0)), " )"),
       IF(?blank, "[ ]", IF(isIRI(?t), ?compact, "<<( … )>>")))) AS ?term)
  BIND(?term AS ?shown)
  OPTIONAL { FILTER(?reifier) ?aboutAt l10n:of c:RdfAboutPhrase ; l10n:name ?about0 }
  OPTIONAL { FILTER(?reifier) c:RdfAboutPhrase rdfs:label ?about0 FILTER(langMatches(lang(?about0), "en")) }
  BIND(IF(?reifier, STR(?about0), IF(?lit && ?lang != "", CONCAT("@", ?lang), IF(BOUND(?named) && ?lit, ?compact, ?none))) AS ?badgeData)
  # The term's label, when it has one (in the viewer's language).
  OPTIONAL { FILTER(isIRI(?t)) ?pickedAt l10n:of ?t ; l10n:name ?picked }
  OPTIONAL { FILTER(isIRI(?t) && !BOUND(?picked)) ?t rdfs:label ?onlyLabel }
  # Only when it says more than the name does.
  BIND(STR(COALESCE(?picked, ?onlyLabel)) AS ?label0)
  BIND(IF(isIRI(?t) && !?blank && LCASE(REPLACE(?label0, "[ _-]", "")) != LCASE(REPLACE(?local, "[ _-]", "")), ?label0, ?none) AS ?noteData)
  # What a nested resource, a list and a reifier are, for screen readers.
  OPTIONAL { ?nestedAt l10n:of c:RdfNestedPhrase ; l10n:name ?nested0 }
  OPTIONAL { c:RdfNestedPhrase rdfs:label ?nested0 FILTER(langMatches(lang(?nested0), "en")) }
  OPTIONAL { ?listAt l10n:of c:RdfListPhrase ; l10n:name ?list0 }
  OPTIONAL { c:RdfListPhrase rdfs:label ?list0 FILTER(langMatches(lang(?list0), "en")) }
  OPTIONAL { ?reifierAt l10n:of c:RdfReifierPhrase ; l10n:name ?reifier0 }
  OPTIONAL { c:RdfReifierPhrase rdfs:label ?reifier0 FILTER(langMatches(lang(?reifier0), "en")) }
  BIND(IF(?reifier, STR(?reifier0), IF(?list, REPLACE(STR(?list0), "\\\\{n\\\\}", STR(COALESCE(?count, 0))), IF(?blank, STR(?nested0), ?none))) AS ?description)
  # What does not conform (c:validated): a value's own problems on its row; a resource's (its node
  # shape's, and a required predicate it lacks) on the resource's row. The editor holds the results.
  BIND(?validated && IF(BOUND(?s), EXISTS { ?editor val:violation ?vr . ?vr sh:focusNode ?s ; sh:resultPath ?p ; sh:value ?t },
       ?depth = 0 && EXISTS { ?editor val:violation ?vr . ?vr sh:focusNode ?t . FILTER NOT EXISTS { ?vr sh:resultPath ?vp . ?t ?vp ?vany } }) AS ?invalid)
  BIND(IF(?invalid, IRI(CONCAT(STR($this), "/~problems")), ?none) AS ?problems)
  BIND(STR(?problems) AS ?problemsId)
  # The markup.
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(CONCAT("sem-term", IF(?depth = 0, " sem-resource", ""), IF(?invalid, " sem-invalid", "")) AS ?rootClass)
  BIND(IRI(CONCAT(STR($this), "/~root-role")) AS ?roleAttr)
  BIND(IRI(CONCAT(STR($this), "/~root-aria-level")) AS ?levelAttr)
  BIND(STR(?depth + 1) AS ?level)
  BIND(IF(?expandable, IRI(CONCAT(STR($this), "/~root-aria-expanded")), ?none) AS ?expandedAttr)
  # The current resource (c:current) is marked: the editor says which, on its row.
  BIND(IF(EXISTS { $this c:isCurrent true }, IRI(CONCAT(STR($this), "/~root-aria-current")), ?none) AS ?currentAttr)
  # In a diff (c:diff): what the change log says happened to its statement.
  LATERAL { OPTIONAL { $this c:diff true ; c:subjectTerm ?s ; c:predicateTerm ?p . ?stc rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?t . ?evc ?kindc ?stc ; beh:sequence ?seqc . VALUES ?kindc { beh:asserted beh:retracted }
    FILTER NOT EXISTS { ?undoc beh:undone ?evc }
    FILTER NOT EXISTS { ?xstc rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?t . ?xevc beh:asserted|beh:retracted ?xstc ; beh:sequence ?xseqc . FILTER(?xseqc < ?seqc) FILTER NOT EXISTS { ?xundoc beh:undone ?xevc } } } }
  BIND(IF(sameTerm(?kindc, beh:asserted) && EXISTS { ?s ?p ?t }, "added", IF(sameTerm(?kindc, beh:retracted) && NOT EXISTS { ?s ?p ?t }, "removed", ?none)) AS ?change)
  BIND(IF(BOUND(?change), IRI(CONCAT(STR($this), "/~root-data-sem-change")), ?none) AS ?changeAttr)
  BIND(IF(BOUND(?change), IRI(CONCAT(STR($this), "/~root-aria-description")), ?none) AS ?changeSaid)
  BIND(IF(?change = "added", c:RdfAddedPhrase, IF(?change = "removed", c:RdfRemovedPhrase, ?none)) AS ?changeKind)
  OPTIONAL { FILTER(BOUND(?changeKind)) ?changeAt l10n:of ?changeKind ; l10n:name ?change0 }
  OPTIONAL { FILTER(BOUND(?changeKind) && !BOUND(?change0)) ?changeKind rdfs:label ?change1 FILTER(langMatches(lang(?change1), "en")) }
  BIND(STR(COALESCE(?change0, ?change1)) AS ?changePhrase)
  BIND(IF(?open, "true", "false") AS ?openText)
  BIND(IRI(CONCAT(STR($this), "/~row")) AS ?row)
  BIND(IRI(CONCAT(STR($this), IF(?expandable, "/~twisty", "/~leaf"))) AS ?lead)
  BIND(IF(?expandable, rdfhtml:Button, rdfhtml:Span) AS ?leadTag)
  BIND(IF(?expandable, "button", ?none) AS ?leadType)
  # One label of the tree is in the tab order (the arrow keys move among them; the twisties are not stops).
  BIND(IF(?expandable, "-1", ?none) AS ?leadTabindex)
  BIND(IF(?depth = 0, "0", "-1") AS ?tabindex)
  BIND(IF(?expandable, "sem-twisty", "sem-leaf") AS ?leadClass)
  BIND(IF(?expandable, $this, ?none) AS ?expands)
  # Open on its reifiers alone, the twisty opens its statements too; otherwise it opens or closes.
  BIND(IF(?expandable, IF(?open && !?nest && ?hasStatements, true, !?open), ?none) AS ?expandsTo)
  BIND(IRI(CONCAT(STR(?lead), IF(?expandable, "-aria-label", "-aria-hidden"))) AS ?leadAttr)
  BIND(IF(?expandable, "aria-label", "aria-hidden") AS ?leadAttrName)
  BIND(IF(?expandable, CONCAT(IF(?open, "Collapse ", "Expand "), ?term), "true") AS ?leadAttrValue)
  BIND(IF(?expandable, IRI(CONCAT(STR($this), "/~twisty-icon")), ?none) AS ?icon)
  BIND(IF(?expandable, IRI(CONCAT(STR($this), "/~twisty-icon-aria-hidden")), ?none) AS ?iconHidden)
  BIND(IF(?expandable, IRI(CONCAT(STR($this), "/~twisty-text")), ?none) AS ?iconText)
  # Editing: the term in a field in its place (a literal's text; a name as written), or a field for a new statement.
  BIND(?editable && (?lit || (isIRI(?t) && !?blank)) && EXISTS { $this c:editing true } AS ?editing)
  BIND(?editable && (?nest && !?list || ?list) && EXISTS { $this c:adding true } AS ?adding)
  BIND(IF(?editable && !?editing, $this, ?none) AS ?editsRow)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit")), ?none) AS ?edit)
  # Started by typing, the field holds what was typed (c:draft) instead of the term.
  OPTIONAL { FILTER(?editing) $this c:draft ?typed0 }
  BIND(IF(?editing, COALESCE(STR(?typed0), IF(?lit, STR(?t), ?compact)), ?none) AS ?editText)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit-aria-label")), ?none) AS ?editName)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit-data-sem-takes-focus")), ?none) AS ?editFocus)
  OPTIONAL { FILTER(?editing) ?editAt l10n:of c:RdfEditPhrase ; l10n:name ?edit0 }
  OPTIONAL { FILTER(?editing) c:RdfEditPhrase rdfs:label ?edit0 FILTER(langMatches(lang(?edit0), "en")) }
  BIND(STR(?edit0) AS ?editPhrase)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-item")), ?none) AS ?addItem)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add")), ?none) AS ?add)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-label")), ?none) AS ?addName)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-data-sem-takes-focus")), ?none) AS ?addFocus)
  BIND(IF(?list, c:RdfNewMemberPhrase, c:RdfNewStatementPhrase) AS ?addWords)
  OPTIONAL { FILTER(?adding) ?addAt l10n:of ?addWords ; l10n:name ?add0 }
  OPTIONAL { FILTER(?adding) ?addWords rdfs:label ?add0 FILTER(langMatches(lang(?add0), "en")) }
  BIND(STR(?add0) AS ?addPhrase)
  # What the shapes expect, as buttons under the field (filtered by what is typed, c:draft).
  OPTIONAL { FILTER(?adding) $this c:draft ?draft0 }
  BIND(IF(?adding, STR(?draft0), ?none) AS ?draft)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions")), ?none) AS ?suggestions)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions-role")), ?none) AS ?sugRole)
  BIND(STR(?suggestions) AS ?suggestionsId)
  # The field is a combobox over them: the highlighted one (c:activeOption) is its active descendant.
  OPTIONAL { FILTER(?adding) $this c:activeOption ?active0 }
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-role")), ?none) AS ?comboRole)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-autocomplete")), ?none) AS ?comboList)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-expanded")), ?none) AS ?comboExpanded)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-controls")), ?none) AS ?comboControls)
  BIND(IF(BOUND(?active0), IRI(CONCAT(STR($this), "/~add-aria-activedescendant")), ?none) AS ?comboActive)
  BIND(STR(?active0) AS ?activeId)
  BIND("true" AS ?comboOpen)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions-aria-label")), ?none) AS ?sugName)
  OPTIONAL { FILTER(?adding) ?sugAt l10n:of c:RdfSuggestionsPhrase ; l10n:name ?sug0 }
  OPTIONAL { FILTER(?adding) c:RdfSuggestionsPhrase rdfs:label ?sug0 FILTER(langMatches(lang(?sug0), "en")) }
  BIND(STR(?sug0) AS ?sugPhrase)
  BIND(IF(?editing, ?none, IRI(CONCAT(STR($this), "/~label"))) AS ?label)
  BIND(CONCAT("sem-label sem-", IF(?lit, "literal", IF(?list, "list", IF(?blank, "blank", IF(isIRI(?t), "iri", "triple"))))) AS ?labelClass)
  BIND(IF(BOUND(?label) && BOUND(?link), IRI(CONCAT(STR($this), "/~label-data-sem-link")), ?none) AS ?linkAttr)
  BIND(IF(BOUND(?label) && EXISTS { $this c:focused true }, IRI(CONCAT(STR($this), "/~label-data-sem-takes-focus")), ?none) AS ?focusAttr)
  BIND(IF(BOUND(?label) && BOUND(?description), IRI(CONCAT(STR($this), "/~label-aria-description")), ?none) AS ?descAttr)
  BIND(IF(BOUND(?label), IRI(CONCAT(STR($this), "/~label-text")), ?none) AS ?labelText)
  BIND(IF(BOUND(?badgeData), IRI(CONCAT(STR($this), "/~badge")), ?none) AS ?badge)
  BIND(IF(BOUND(?badgeData), IRI(CONCAT(STR($this), "/~badge-text")), ?none) AS ?badgeText)
  BIND(IF(BOUND(?noteData), IRI(CONCAT(STR($this), "/~note")), ?none) AS ?note)
  BIND(IF(BOUND(?noteData), IRI(CONCAT(STR($this), "/~note-text")), ?none) AS ?noteText)
  BIND(IF(?open || ?adding, IRI(CONCAT(STR($this), "/~group")), ?none) AS ?group)
  BIND(IF(?open || ?adding, IRI(CONCAT(STR($this), "/~group-role")), ?none) AS ?groupRole)
  BIND(IF(?invalid && BOUND(?label), IRI(CONCAT(STR($this), "/~label-aria-invalid")), ?none) AS ?invalidAttr)
  BIND(IF(?invalid && BOUND(?label), IRI(CONCAT(STR($this), "/~label-aria-describedby")), ?none) AS ?describedAttr)
  BIND(IF(?editable, c:RdfDropRow, ?none) AS ?dropType)
  # The row's menu (c:menuOpen), at the end of the row.
  BIND(EXISTS { $this c:menuOpen true } AS ?menuOpen)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu")), ?none) AS ?menu)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-role")), ?none) AS ?menuRole)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-items")), ?none) AS ?menuItems)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-orientation")), ?none) AS ?menuOrient)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-wrap")), ?none) AS ?menuWrap)
  BIND(?depth + 1 AS ?childDepth)
  # The rows under it, when it is open.
  LATERAL { {} UNION {
    # Its list's members, in order.
    FILTER(?nest && ?list)
    ?t rdf:rest* ?childCell . ?childCell rdf:first ?childTerm .
    { SELECT ?childCell (COUNT(?mid) AS ?childIndex) WHERE { $this c:term ?h1 . ?h1 rdf:rest* ?mid . ?mid rdf:rest* ?childCell . ?childCell rdf:first ?m1 } GROUP BY ?childCell }
    BIND(c:RdfTerm AS ?childClass)
    # In an editor a member is dragged to another member's place (c:RdfReorderMember).
    BIND(?dropType AS ?childDrop)
    BIND(IF(?editable, c:RdfDraggableRow, ?none) AS ?childDrag)
    BIND(CONCAT("\\u0001n0\\u0001n", STR(?childIndex)) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~i-", STR(?childIndex))) AS ?child)
  } UNION {
    # Its predicates (a reifier's rdf:reifies is the row it is under).
    FILTER(?nest && !?list)
    { SELECT DISTINCT ?childPredicate WHERE { { $this c:term ?t2 . ?t2 ?childPredicate ?o2 } UNION { $this c:term ?t2 ; c:diff true . ?gstp rdf:subject ?t2 ; rdf:predicate ?childPredicate ; rdf:object ?o2 . ?gevp beh:retracted ?gstp ; beh:sequence ?gseqp .
      FILTER NOT EXISTS { ?t2 ?childPredicate ?o2 } FILTER NOT EXISTS { ?gundop beh:undone ?gevp }
      FILTER NOT EXISTS { ?gxstp rdf:subject ?t2 ; rdf:predicate ?childPredicate ; rdf:object ?o2 . ?gxevp beh:asserted|beh:retracted ?gxstp ; beh:sequence ?gxseqp . FILTER(?gxseqp < ?gseqp) FILTER NOT EXISTS { ?gxundop beh:undone ?gxevp } } }
        FILTER(!sameTerm(?childPredicate, rdf:reifies) || NOT EXISTS { $this c:reifierOf ?of2 }) } }
    BIND(?t AS ?childSubject)
    BIND(c:RdfProperty AS ?childClass)
    BIND(?dropType AS ?childDrop)
    BIND(REPLACE(STR(?childPredicate), "[^#/]*$", "") AS ?pns)
    BIND(REPLACE(STR(?childPredicate), "^.*[#/]", "") AS ?plocal)
    OPTIONAL { { SELECT ?pns (MIN(?pprefix0) AS ?pprefix) WHERE { ?pdecl sh:prefix ?pprefix0 ; sh:namespace ?pns0 BIND(STR(?pns0) AS ?pns) } GROUP BY ?pns } }
    BIND(IF(BOUND(?pprefix) && REGEX(?plocal, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?pprefix, ":", ?plocal), CONCAT("<", STR(?childPredicate), ">")) AS ?pcompact)
    BIND(CONCAT("\\u0001n1\\u0001n", IF(sameTerm(?childPredicate, rdf:type), "0", "1"), "\\u0001s", ?pcompact) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~p-", SUBSTR(MD5(STR(?childPredicate)), 1, 12))) AS ?child)
  } UNION {
    # The reifiers of its statement.
    FILTER(?open && ?reified)
    ?childTerm rdf:reifies <<( ?s ?p ?t )>> .
    OPTIONAL { { SELECT ?childTerm (MIN(?rpair) AS ?rmin) (MAX(?rpair) AS ?rmax) WHERE {
        $this c:subjectTerm ?s3 ; c:predicateTerm ?p3 ; c:term ?t3 . ?childTerm rdf:reifies <<( ?s3 ?p3 ?t3 )>> . FILTER(isBlank(?childTerm)) ?childTerm ?rp ?ro
        BIND(CONCAT(IF(isLiteral(?ro) || isIRI(?ro), "", "~"), STR(?rp), " ", COALESCE(STR(?ro), "_")) AS ?rpair) } GROUP BY ?childTerm } }
    BIND(IF(isIRI(?childTerm), STR(?childTerm), CONCAT("_:", COALESCE(?rmin, ""), "|", COALESCE(?rmax, ""))) AS ?rkey)
    BIND($this AS ?childOf)
    BIND(c:RdfTerm AS ?childClass)
    BIND(CONCAT("\\u0001n2\\u0001s", ?rkey) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~r-", SUBSTR(MD5(?rkey), 1, 12))) AS ?child)
  } UNION {
    # The shapes' predicates (and values they fix: one pick, the whole statement), a missing required
    # one first; for a resource with no class yet, the classes shapes target that the document uses.
    FILTER(?adding && !?list)
    { SELECT ?optP ?optV (MAX(?req) AS ?reqN) WHERE {
      { $this c:term ?t5 . ?t5 a ?ty5 . ?ty5 rdfs:subClassOf* ?c5 . ?sh5 sh:targetClass ?c5 ; sh:property ?ps5 . ?ps5 sh:path ?optP . FILTER(isIRI(?optP))
        OPTIONAL { ?ps5 sh:maxCount ?max5 }
        FILTER(!(BOUND(?max5) && xsd:integer(STR(?max5)) <= 1 && EXISTS { ?t5 ?optP ?e5 }))
        BIND(IF(EXISTS { ?ps5 sh:minCount ?min5 FILTER(xsd:integer(STR(?min5)) >= 1) } && NOT EXISTS { ?t5 ?optP ?e6 }, 1, 0) AS ?req)
        { BIND(?nothing AS ?optV) } UNION { ?ps5 sh:hasValue|sh:defaultValue ?optV } UNION { ?ps5 sh:in/rdf:rest*/rdf:first ?optV }
        FILTER(!BOUND(?optV) || NOT EXISTS { ?t5 ?optP ?optV }) }
      UNION { $this c:term ?t7 ; c:inEditor ?e7 . FILTER NOT EXISTS { ?t7 a ?anyType7 }
              ?sh7 sh:targetClass ?optV . FILTER(isIRI(?optV) && EXISTS { ?e7 c:entry ?o7 . ?o7 a ?optV }) BIND(rdf:type AS ?optP) BIND(0 AS ?req) }
    } GROUP BY ?optP ?optV }
    BIND(REPLACE(STR(?optP), "[^#/]*$", "") AS ?opns)
    BIND(REPLACE(STR(?optP), "^.*[#/]", "") AS ?oploc)
    OPTIONAL { { SELECT ?opns (MIN(?opx0) AS ?opx) WHERE { ?opxd sh:prefix ?opx0 ; sh:namespace ?opxn BIND(STR(?opxn) AS ?opns) } GROUP BY ?opns } }
    BIND(IF(BOUND(?opx) && REGEX(?oploc, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?opx, ":", ?oploc), CONCAT("<", STR(?optP), ">")) AS ?pCompact)
    BIND(REPLACE(STR(?optV), "[^#/]*$", "") AS ?ovns)
    BIND(REPLACE(STR(?optV), "^.*[#/]", "") AS ?ovloc)
    OPTIONAL { { SELECT ?ovns (MIN(?ovx0) AS ?ovx) WHERE { ?ovxd sh:prefix ?ovx0 ; sh:namespace ?ovxn BIND(STR(?ovxn) AS ?ovns) } GROUP BY ?ovns } }
    BIND(IF(BOUND(?ovx) && REGEX(?ovloc, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?ovx, ":", ?ovloc), CONCAT("<", STR(?optV), ">")) AS ?vCompact)
    BIND(IF(!BOUND(?optV), ?none, IF(isIRI(?optV), ?vCompact, IF(isLiteral(?optV) && DATATYPE(?optV) IN (xsd:integer, xsd:decimal, xsd:double, xsd:boolean), STR(?optV), CONCAT("\\"", STR(?optV), "\\"")))) AS ?vText)
    BIND(IF(sameTerm(?optP, rdf:type), "a", ?pCompact) AS ?pText)
    BIND(IF(BOUND(?optV), CONCAT(?pText, " ", ?vText), ?pText) AS ?optionLabel)
    BIND(IF(BOUND(?optV), ?none, CONCAT(?pText, " ")) AS ?fill)
    BIND(IF(?reqN = 1, "sem-option sem-required", "sem-option") AS ?optionClass)
    OPTIONAL { FILTER(?reqN = 1) ?requiredAt l10n:of c:RdfRequiredPhrase ; l10n:name ?required0 }
    OPTIONAL { FILTER(?reqN = 1) c:RdfRequiredPhrase rdfs:label ?required0 FILTER(langMatches(lang(?required0), "en")) }
    BIND(STR(?required0) AS ?requiredPhrase)
    BIND(IF(?reqN = 1, IRI(CONCAT(STR($this), "/~opt-", SUBSTR(MD5(?optionLabel), 1, 12), "-detail")), ?none) AS ?optionDetail)
    BIND(IF(?reqN = 1, IRI(CONCAT(STR($this), "/~opt-", SUBSTR(MD5(?optionLabel), 1, 12), "-detail-text")), ?none) AS ?optionDetailText)
    FILTER(!BOUND(?draft) || ?draft = "" || CONTAINS(LCASE(?optionLabel), LCASE(?draft)))
    BIND(CONCAT("\\u0001n", IF(?reqN = 1, "0", "1"), "\\u0001s", ?optionLabel) AS ?optionKey)
    BIND(IRI(CONCAT(STR($this), "/~opt-", SUBSTR(MD5(?optionLabel), 1, 12))) AS ?option)
    BIND(IRI(CONCAT(STR(?option), "-text")) AS ?optionText)
    BIND(STR(?option) AS ?optionId)
    BIND(IRI(CONCAT(STR(?option), "-role")) AS ?optionRole)
    BIND(IRI(CONCAT(STR(?option), "-aria-selected")) AS ?optionSelected)
    BIND(IF(BOUND(?active0) && sameTerm(?active0, ?option), "true", "false") AS ?selected)
  } UNION {
    # Its menu's items: what can be done here, each with its key.
    FILTER(?menuOpen)
    VALUES (?itemN ?itemPhrase ?itemDoes ?itemKeys ?itemKbdShown ?itemKind ?itemAsKey) {
      (1 c:RdfMenuEditPhrase c:RdfStartEdit "Enter" "↵" "edit" UNDEF)
      (2 c:RdfMenuAddPhrase c:RdfStartAdd "Shift+Enter" "⇧↵" "add" UNDEF)
      (3 c:RdfMenuNestPhrase c:RdfNest "Tab" "⇥" "nest" UNDEF)
      (4 c:RdfMenuOutdentPhrase c:RdfOutdent "Shift+Tab" "⇧⇥" "outdent" UNDEF)
      (5 c:RdfMenuUpPhrase c:RdfMoveMember "Alt+ArrowUp" "⌥↑" "up" "alt+arrowup")
      (6 c:RdfMenuDownPhrase c:RdfMoveMember "Alt+ArrowDown" "⌥↓" "down" "alt+arrowdown")
      (7 c:RdfMenuGoPhrase UNDEF "Enter" "↵" "jump" UNDEF)
      (8 c:RdfMenuReferencePhrase UNDEF "Enter" "↵" "go" UNDEF)
      (9 c:RdfMenuDeletePhrase c:RdfDelete "Delete" "⌫" "delete" UNDEF)
    }
    FILTER(IF(?itemKind = "edit", ?editable && (?lit || (isIRI(?t) && !?blank)) && (BOUND(?s) || EXISTS { $this c:listCell ?mc1 }),
           IF(?itemKind = "add", ?editable,
           IF(?itemKind = "nest", ?editable && BOUND(?s),
           IF(?itemKind = "outdent", ?editable && BOUND(?s) && EXISTS { ?upRow c:subjectTerm ?ug ; c:term ?s . FILTER(sameTerm(?upRow, IRI(REPLACE(STR($this), "/~p-[0-9a-f]{12}/~t-[0-9a-f]{12}$", "")))) },
           IF(?itemKind = "up", ?editable && EXISTS { $this c:listIndex ?mi . FILTER(?mi > 1) },
           IF(?itemKind = "down", ?editable && EXISTS { $this c:listCell ?mc2 . ?mc2 rdf:rest ?mn . ?mn rdf:first ?mf },
           IF(?itemKind = "jump", ?jumps,
           IF(?itemKind = "go", ?goes,
              ?editable && (BOUND(?s) || ?depth = 0 || EXISTS { $this c:listCell ?mc3 }))))))))))
    OPTIONAL { ?itemAt l10n:of ?itemPhrase ; l10n:name ?item0 }
    OPTIONAL { ?itemPhrase rdfs:label ?item0 FILTER(langMatches(lang(?item0), "en")) }
    BIND(STR(?item0) AS ?itemLabel)
    BIND(IF(?itemKind = "delete", "sem-menuitem sem-danger", "sem-menuitem") AS ?itemClass)
    BIND(IF(?itemKind = "jump", ?t, ?none) AS ?itemJump)
    BIND(IF(?itemKind = "go", ?t, ?none) AS ?itemGo)
    BIND(CONCAT(STR($this), "/~menu-", STR(?itemN)) AS ?itemLocal)
    BIND(IRI(?itemLocal) AS ?item)
    BIND(IRI(CONCAT(?itemLocal, "-role")) AS ?itemRole)
    BIND(IRI(CONCAT(?itemLocal, "-data-sem-takes-focus")) AS ?itemFocus)
    BIND(IRI(CONCAT(?itemLocal, "-aria-keyshortcuts")) AS ?itemShortcut)
    BIND(IRI(CONCAT(?itemLocal, "-text")) AS ?itemText)
    BIND(IRI(CONCAT(?itemLocal, "-kbd")) AS ?itemKbd)
    BIND(IRI(CONCAT(?itemLocal, "-kbd-aria-hidden")) AS ?itemKbdHidden)
    BIND(IRI(CONCAT(?itemLocal, "-kbd-text")) AS ?itemKbdText)
  } UNION {
    # Its problems, one each.
    FILTER(?invalid)
    ?editor val:violation ?vr2 .
    { FILTER(BOUND(?s)) ?vr2 sh:focusNode ?s ; sh:resultPath ?p ; sh:value ?t }
    UNION { FILTER(!BOUND(?s)) ?vr2 sh:focusNode ?t . FILTER NOT EXISTS { ?vr2 sh:resultPath ?vp2 . ?t ?vp2 ?vany2 } }
    ?vr2 sh:resultMessage ?message0
    BIND(STR(?message0) AS ?problemText)
    BIND(IRI(CONCAT(STR($this), "/~problem-", SUBSTR(MD5(?problemText), 1, 12))) AS ?problem)
    BIND(IRI(CONCAT(STR(?problem), "-text")) AS ?problemData)
  } }
}""" .
c:RdfTermRendering-sparql-text a sem:Rule ;
    sem:implements c:RdfTermRendering ;
    sem:modality mod:Text ;
    sem:construct """
CONSTRUCT {
  ?root a ?rootTag ; sem:renders $this ; rdfhtml:hasChild ?line , ?group , ?close .
  ?line a ?lineTag ; rdfhtml:hasChild ?lineText ; ord:immediatelyPrecedes ?group .
  ?lineText a rdfhtml:Text ; rdfhtml:data ?data .
  ?group a ?groupTag ; rdfhtml:hasChild ?child ; ord:immediatelyPrecedes ?close .
  ?close a ?groupTag ; rdfhtml:hasChild ?closeText .
  ?closeText a rdfhtml:Text ; rdfhtml:data ?closeData .
  ?child a ?childClass ; c:term ?childTerm ; c:subjectTerm ?childSubject ; c:predicateTerm ?childPredicate ; c:listCell ?childCell ; c:listIndex ?childIndex ;
         c:reifierOf ?childOf ; c:inEditor ?editor ; c:depth ?childDepth ; c:editable ?editable ; c:validated ?validated ; sem:orderKey ?childKey .
}
WHERE {
  $this a c:RdfTerm ; c:term ?t ; c:inEditor ?editor .
  OPTIONAL { $this c:depth ?depth0 }
  BIND(COALESCE(xsd:integer(STR(?depth0)), 0) AS ?depth)
  OPTIONAL { $this c:editable ?editable0 }
  BIND(COALESCE(?editable0, false) AS ?editable)
  OPTIONAL { $this c:validated ?validated0 }
  BIND(COALESCE(?validated0, false) AS ?validated)
  OPTIONAL { $this c:subjectTerm ?s ; c:predicateTerm ?p }
  BIND(EXISTS { $this c:reifierOf ?of } AS ?reifier)
  BIND(isLiteral(?t) AS ?lit)
  BIND(IF(?lit, DATATYPE(?t), ?none) AS ?dt)
  BIND(IF(?lit, LANG(?t), "") AS ?lang)
  BIND(?lit && ?dt IN (xsd:integer, xsd:decimal, xsd:double, xsd:boolean) AS ?bare)
  BIND(sameTerm(?t, rdf:nil) || (!?lit && EXISTS { ?t rdf:first ?anyFirst }) AS ?list)
  BIND(isBlank(?t) || (isIRI(?t) && CONTAINS(STR(?t), "/.well-known/genid/")) AS ?blank)
  BIND(isIRI(?t) || isBlank(?t) AS ?resource)
  BIND(?resource && EXISTS { ?t ?anyP ?anyO } AS ?hasStatements)
  BIND(BOUND(?s) && EXISTS { ?anyR rdf:reifies <<( ?s ?p ?t )>> } AS ?reified)
  # A class or a property is a link to the Reference, not a resource to open in place (unless it is one of the document's).
  BIND(isIRI(?t) && !?blank && EXISTS { ?t a ?kind . VALUES ?kind { rdfs:Class owl:Class rdf:Property owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty } } AS ?vocab)
  BIND((?hasStatements && (?depth = 0 || !?vocab)) || ?reified AS ?expandable)
  OPTIONAL { $this c:expanded ?own }
  BIND((?depth = 0 && NOT EXISTS { $this c:startsClosed true }) || ?blank || ?list || ?reifier || ?reified AS ?openByDefault)
  BIND(?expandable && COALESCE(?own, ?openByDefault) AS ?open)
  # Open, it shows its reifiers; and its statements when it nests by nature, or was opened on purpose.
  BIND(?open && ?hasStatements && (?depth = 0 || ?blank || ?list || ?reifier || COALESCE(?own, false)) AS ?nest)
  BIND(IF(isIRI(?t) && !?blank, ?t, IF(?lit && !?bare && ?lang = "" && ?dt != xsd:string, ?dt, ?none)) AS ?named)
  BIND(COALESCE(REPLACE(STR(?named), "[^#/]*$", ""), "-~") AS ?ns)
  BIND(REPLACE(STR(?named), "^.*[#/]", "") AS ?local)
  OPTIONAL { { SELECT ?ns (MIN(?prefix0) AS ?prefix) WHERE { ?decl sh:prefix ?prefix0 ; sh:namespace ?ns0 BIND(STR(?ns0) AS ?ns) } GROUP BY ?ns } }
  BIND(IF(BOUND(?prefix) && REGEX(?local, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?prefix, ":", ?local), CONCAT("<", STR(?named), ">")) AS ?compact)
  # A literal as Turtle writes it: quoted, then its language or datatype (none for numbers and booleans).
  BIND(IF(?lit, IF(?bare, STR(?t), CONCAT("\\"", STR(?t), "\\"", IF(?lang != "", CONCAT("@", ?lang), IF(BOUND(?named), CONCAT("^^", ?compact), "")))),
       IF(isIRI(?t) && !?blank, ?compact, IF(?list, "(", IF(?blank, "[", "<<( … )>>")))) AS ?term)
  # A nested resource closes on a line of its own, indented as its predicate; a list stays on its line.
  BIND(IF(?list || !?nest, rdfhtml:Span, rdfhtml:Div) AS ?groupTag)
  BIND(SUBSTR("                                                                                                                                ", 1, IF(?reifier, ?depth - 1, ?depth)) AS ?closeIndent)
  BIND(IF(?depth = 0, rdfhtml:Div, rdfhtml:Span) AS ?rootTag)
  BIND(IF(?depth = 0, rdfhtml:Div, rdfhtml:Span) AS ?lineTag)
  BIND(IF(?reifier, CONCAT("~ ", ?term, " {|"), IF(?open || !?expandable || ?depth = 0 || !(?blank || ?list), ?term, CONCAT(?term, " … ", IF(?list, ")", "]")))) AS ?data)
  BIND(?open && (?reifier || ?depth > 0 && (?blank || ?list)) AS ?closes)
  BIND(IF(?closes, CONCAT(IF(?list && !?reifier, "", ?closeIndent), IF(?reifier, "|}", IF(?list, ")", "]"))), ?none) AS ?closeData)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~line")) AS ?line)
  BIND(IRI(CONCAT(STR($this), "/~line-text")) AS ?lineText)
  BIND(IF(?open, IRI(CONCAT(STR($this), "/~group")), ?none) AS ?group)
  BIND(IF(BOUND(?closeData), IRI(CONCAT(STR($this), "/~close")), ?none) AS ?close)
  BIND(IF(BOUND(?closeData), IRI(CONCAT(STR($this), "/~close-text")), ?none) AS ?closeText)
  BIND(?depth + 1 AS ?childDepth)
  LATERAL { {} UNION {
    FILTER(?nest && ?list)
    ?t rdf:rest* ?childCell . ?childCell rdf:first ?childTerm .
    { SELECT ?childCell (COUNT(?mid) AS ?childIndex) WHERE { $this c:term ?h1 . ?h1 rdf:rest* ?mid . ?mid rdf:rest* ?childCell . ?childCell rdf:first ?m1 } GROUP BY ?childCell }
    BIND(c:RdfTerm AS ?childClass)
    BIND(CONCAT("\\u0001n0\\u0001n", STR(?childIndex)) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~i-", STR(?childIndex))) AS ?child)
  } UNION {
    FILTER(?nest && !?list)
    { SELECT DISTINCT ?childPredicate WHERE { $this c:term ?t2 . ?t2 ?childPredicate ?o2 .
        FILTER(!sameTerm(?childPredicate, rdf:reifies) || NOT EXISTS { $this c:reifierOf ?of2 }) } }
    BIND(?t AS ?childSubject)
    BIND(c:RdfProperty AS ?childClass)
    BIND(REPLACE(STR(?childPredicate), "[^#/]*$", "") AS ?pns)
    BIND(REPLACE(STR(?childPredicate), "^.*[#/]", "") AS ?plocal)
    OPTIONAL { { SELECT ?pns (MIN(?pprefix0) AS ?pprefix) WHERE { ?pdecl sh:prefix ?pprefix0 ; sh:namespace ?pns0 BIND(STR(?pns0) AS ?pns) } GROUP BY ?pns } }
    BIND(IF(BOUND(?pprefix) && REGEX(?plocal, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?pprefix, ":", ?plocal), CONCAT("<", STR(?childPredicate), ">")) AS ?pcompact)
    BIND(CONCAT("\\u0001n1\\u0001n", IF(sameTerm(?childPredicate, rdf:type), "0", "1"), "\\u0001s", ?pcompact) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~p-", SUBSTR(MD5(STR(?childPredicate)), 1, 12))) AS ?child)
  } UNION {
    FILTER(?open && ?reified)
    ?childTerm rdf:reifies <<( ?s ?p ?t )>> .
    OPTIONAL { { SELECT ?childTerm (MIN(?rpair) AS ?rmin) (MAX(?rpair) AS ?rmax) WHERE {
        $this c:subjectTerm ?s3 ; c:predicateTerm ?p3 ; c:term ?t3 . ?childTerm rdf:reifies <<( ?s3 ?p3 ?t3 )>> . FILTER(isBlank(?childTerm)) ?childTerm ?rp ?ro
        BIND(CONCAT(IF(isLiteral(?ro) || isIRI(?ro), "", "~"), STR(?rp), " ", COALESCE(STR(?ro), "_")) AS ?rpair) } GROUP BY ?childTerm } }
    BIND(IF(isIRI(?childTerm), STR(?childTerm), CONCAT("_:", COALESCE(?rmin, ""), "|", COALESCE(?rmax, ""))) AS ?rkey)
    BIND($this AS ?childOf)
    BIND(c:RdfTerm AS ?childClass)
    BIND(CONCAT("\\u0001n2\\u0001s", ?rkey) AS ?childKey)
    BIND(IRI(CONCAT(STR($this), "/~r-", SUBSTR(MD5(?rkey), 1, 12))) AS ?child)
  } }
}""" .

# --- a predicate of a resource ----------------------------------------------------------------------
# The predicate ("a" for rdf:type, a link to the Reference when it is a declared property), and a
# c:RdfTerm per object, ordered by value. Open unless closed on its twisty.

c:RdfPropertyRendering a sem:Rendering ;
    sem:targets c:RdfProperty ;
    sem:stratum 0 ;
    sem:bulk false ;
    sem:follows c:subjectTerm , ( c:subjectTerm [ sem:inverse rdf:subject ] ) .
c:RdfPropertyRendering-fn a sem:Rule ; sem:implements c:RdfPropertyRendering ; sem:function "rdf-editor:property" .
c:RdfPropertyRendering-sparql-screen a sem:Rule ;
    sem:implements c:RdfPropertyRendering ;
    sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Li ; sem:renders $this ; rdfhtml:class ?rootClass ; rdfhtml:attribute ?roleAttr , ?levelAttr , ?expandedAttr ; rdfhtml:hasChild ?row , ?group .
  ?roleAttr a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "treeitem" .
  ?levelAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-level" ; rdfhtml:attributeValue ?level .
  ?expandedAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-expanded" ; rdfhtml:attributeValue ?openText .
  ?row a rdfhtml:Div ; rdfhtml:class "sem-row" ; rdfhtml:hasChild ?lead , ?label , ?edit , ?note ; ord:precedes ?group .
  ?row c:rowOf $this ; rdfhtml:hasChild ?menu . ?lead ord:precedes ?menu . ?label ord:precedes ?menu . ?edit ord:precedes ?menu . ?note ord:precedes ?menu .
  ?root rdfhtml:hasChild ?problems . ?row ord:immediatelyPrecedes ?problems . ?problems ord:precedes ?group .
  ?problems a rdfhtml:Div ; rdfhtml:class "sem-problems" ; rdfhtml:id ?problemsId ; rdfhtml:hasChild ?problem .
  ?problem a rdfhtml:Span ; rdfhtml:class "sem-problem" ; sem:orderKey ?problemText ; rdfhtml:hasChild ?problemData .
  ?problemData a rdfhtml:Text ; rdfhtml:data ?problemText .
  ?invalidAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-invalid" ; rdfhtml:attributeValue "true" .
  ?describedAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-describedby" ; rdfhtml:attributeValue ?problemsId .
  ?lead a rdfhtml:Button ; rdfhtml:type "button" ; rdfhtml:class "sem-twisty" ; rdfhtml:tabIndex "-1" ; c:expands $this ; c:expandsTo ?expandsTo ; rdfhtml:attribute ?leadAttr ;
        rdfhtml:hasChild ?icon ; ord:immediatelyPrecedes ?label , ?edit .
  ?leadAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?leadLabel .
  ?icon a rdfhtml:Span ; rdfhtml:attribute ?iconHidden ; rdfhtml:hasChild ?iconText .
  ?iconHidden a rdfhtml:Attribute ; rdfhtml:attributeName "aria-hidden" ; rdfhtml:attributeValue "true" .
  ?iconText a rdfhtml:Text ; rdfhtml:data "▸" .
  ?label a rdfhtml:Span ; rdfhtml:class "sem-label sem-predicate" ; rdfhtml:tabIndex "-1" ; c:goesTo ?goesTo ; c:editsRow ?editsRow ; rdfhtml:attribute ?linkAttr , ?invalidAttr , ?describedAttr ; rdfhtml:hasChild ?labelText ; ord:immediatelyPrecedes ?note .
  ?edit a rdfhtml:Input ; rdfhtml:type "text" ; rdfhtml:class "sem-label sem-edit" ; rdfhtml:value ?editText ; c:commits $this ; rdfhtml:attribute ?editName , ?editFocus ; ord:immediatelyPrecedes ?note .
  ?editName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?editPhrase .
  ?editFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?linkAttr a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-link" ; rdfhtml:attributeValue "term" .
  ?labelText a rdfhtml:Text ; rdfhtml:data ?shown .
  ?note a rdfhtml:Span ; rdfhtml:class "sem-note" ; rdfhtml:hasChild ?noteText .
  ?noteText a rdfhtml:Text ; rdfhtml:data ?noteData .
  ?group a rdfhtml:Ul ; rdfhtml:attribute ?groupRole ; rdfhtml:hasChild ?child , ?addItem .
  ?groupRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "group" .
  ?addItem a rdfhtml:Li ; rdfhtml:class "sem-adding" ; sem:orderKey "\uffff" ; rdfhtml:hasChild ?add .
  ?add a rdfhtml:Input ; rdfhtml:type "text" ; rdfhtml:class "sem-edit" ; rdfhtml:placeholder ?addPhrase ; c:adds $this ; rdfhtml:attribute ?addName , ?addFocus , ?comboRole , ?comboList , ?comboExpanded , ?comboControls , ?comboActive .
  ?comboRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "combobox" .
  ?comboList a rdfhtml:Attribute ; rdfhtml:attributeName "aria-autocomplete" ; rdfhtml:attributeValue "list" .
  ?comboExpanded a rdfhtml:Attribute ; rdfhtml:attributeName "aria-expanded" ; rdfhtml:attributeValue ?comboOpen .
  ?comboControls a rdfhtml:Attribute ; rdfhtml:attributeName "aria-controls" ; rdfhtml:attributeValue ?suggestionsId .
  ?comboActive a rdfhtml:Attribute ; rdfhtml:attributeName "aria-activedescendant" ; rdfhtml:attributeValue ?activeId .
  ?addName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?addPhrase .
  ?addFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?addItem rdfhtml:hasChild ?suggestions . ?add ord:immediatelyPrecedes ?suggestions ; rdfhtml:value ?draft .
  ?suggestions a rdfhtml:Div ; rdfhtml:class "sem-suggestions" ; rdfhtml:id ?suggestionsId ; rdfhtml:attribute ?sugRole , ?sugName ; rdfhtml:hasChild ?option .
  ?sugRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "listbox" .
  ?sugName a rdfhtml:Attribute ; rdfhtml:attributeName "aria-label" ; rdfhtml:attributeValue ?sugPhrase .
  ?option a rdfhtml:Button ; rdfhtml:type "button" ; rdfhtml:class ?optionClass ; rdfhtml:id ?optionId ; rdfhtml:tabIndex "-1" ; rdfhtml:attribute ?optionRole , ?optionSelected ;
          sem:orderKey ?optionKey ; c:suggestsFor $this ;
          c:suggestsPredicate ?optP ; c:suggestsValue ?optV ; c:fillsWith ?fill ; rdfhtml:hasChild ?optionText , ?optionDetail .
  ?optionText ord:immediatelyPrecedes ?optionDetail .
  ?optionDetail a rdfhtml:Span ; rdfhtml:class "sem-detail" ; rdfhtml:hasChild ?optionDetailText .
  ?optionDetailText a rdfhtml:Text ; rdfhtml:data ?requiredPhrase .
  ?optionText a rdfhtml:Text ; rdfhtml:data ?optionLabel .
  ?optionRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "option" .
  ?optionSelected a rdfhtml:Attribute ; rdfhtml:attributeName "aria-selected" ; rdfhtml:attributeValue ?selected .
  ?menu a rdfhtml:Div ; rdfhtml:class "sem-menu" ; rdfhtml:attribute ?menuRole , ?menuItems , ?menuOrient , ?menuWrap ; rdfhtml:hasChild ?item .
  ?menuRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "menu" .
  ?menuItems a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-items" ; rdfhtml:attributeValue "[role=menuitem]" .
  ?menuOrient a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-orientation" ; rdfhtml:attributeValue "vertical" .
  ?menuWrap a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-nav-wrap" ; rdfhtml:attributeValue "" .
  ?item a rdfhtml:Button ; rdfhtml:type "button" ; rdfhtml:class ?itemClass ; rdfhtml:tabIndex "-1" ; sem:orderKey ?itemN ;
        c:actsOn $this ; c:does ?itemDoes ; c:asKey ?itemAsKey ; c:jumpsTo ?itemJump ; c:goesTo ?itemGo ;
        rdfhtml:attribute ?itemRole , ?itemFocus , ?itemShortcut ; rdfhtml:hasChild ?itemText , ?itemKbd .
  ?itemRole a rdfhtml:Attribute ; rdfhtml:attributeName "role" ; rdfhtml:attributeValue "menuitem" .
  ?itemFocus a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-takes-focus" ; rdfhtml:attributeValue "" .
  ?itemShortcut a rdfhtml:Attribute ; rdfhtml:attributeName "aria-keyshortcuts" ; rdfhtml:attributeValue ?itemKeys .
  ?itemText a rdfhtml:Text ; rdfhtml:data ?itemLabel ; ord:immediatelyPrecedes ?itemKbd .
  ?itemKbd a rdfhtml:Kbd ; rdfhtml:attribute ?itemKbdHidden ; rdfhtml:hasChild ?itemKbdText .
  ?itemKbdHidden a rdfhtml:Attribute ; rdfhtml:attributeName "aria-hidden" ; rdfhtml:attributeValue "true" .
  ?itemKbdText a rdfhtml:Text ; rdfhtml:data ?itemKbdShown .
  ?child a c:RdfTerm , ?dragType ; c:term ?o ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:inEditor ?editor ; c:depth ?childDepth ; c:editable ?editable ; c:validated ?validated ; c:diff ?diffOn ; sem:orderKey ?okey .
}
WHERE {
  $this a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:inEditor ?editor .
  OPTIONAL { $this c:depth ?depth0 }
  BIND(COALESCE(xsd:integer(STR(?depth0)), 1) AS ?depth)
  OPTIONAL { $this c:editable ?editable0 }
  BIND(COALESCE(?editable0, false) AS ?editable)
  OPTIONAL { $this c:validated ?validated0 }
  BIND(COALESCE(?validated0, false) AS ?validated)
  BIND(EXISTS { $this c:diff true } AS ?diff)
  BIND(IF(?diff, true, ?none) AS ?diffOn)
  OPTIONAL { $this c:expanded ?own }
  BIND(COALESCE(?own, true) AS ?open)
  BIND(REPLACE(STR(?p), "[^#/]*$", "") AS ?ns)
  BIND(REPLACE(STR(?p), "^.*[#/]", "") AS ?local)
  OPTIONAL { { SELECT ?ns (MIN(?prefix0) AS ?prefix) WHERE { ?decl sh:prefix ?prefix0 ; sh:namespace ?ns0 BIND(STR(?ns0) AS ?ns) } GROUP BY ?ns } }
  BIND(IF(BOUND(?prefix) && REGEX(?local, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?prefix, ":", ?local), CONCAT("<", STR(?p), ">")) AS ?compact)
  BIND(IF(sameTerm(?p, rdf:type), "a", ?compact) AS ?shown)
  BIND(EXISTS { ?p a ?kind . VALUES ?kind { rdf:Property owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty } } AS ?goes)
  BIND(IF(?goes, ?p, ?none) AS ?goesTo)
  OPTIONAL { FILTER(!sameTerm(?p, rdf:type)) ?pickedAt l10n:of ?p ; l10n:name ?picked }
  OPTIONAL { FILTER(!sameTerm(?p, rdf:type) && !BOUND(?picked)) ?p rdfs:label ?onlyLabel }
  BIND(STR(COALESCE(?picked, ?onlyLabel)) AS ?label0)
  BIND(IF(LCASE(REPLACE(?label0, "[ _-]", "")) != LCASE(REPLACE(?local, "[ _-]", "")), ?label0, ?none) AS ?noteData)
  # Its count problems (c:validated): too few or too many values.
  BIND(?validated && EXISTS { ?editor val:violation ?vr . ?vr sh:focusNode ?s ; sh:resultPath ?p . FILTER NOT EXISTS { ?vr sh:value ?vv } } AS ?invalid)
  BIND(IF(?invalid, IRI(CONCAT(STR($this), "/~problems")), ?none) AS ?problems)
  BIND(STR(?problems) AS ?problemsId)
  BIND(CONCAT("sem-property", IF(?invalid, " sem-invalid", "")) AS ?rootClass)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~root-role")) AS ?roleAttr)
  BIND(IRI(CONCAT(STR($this), "/~root-aria-level")) AS ?levelAttr)
  BIND(STR(?depth + 1) AS ?level)
  BIND(IRI(CONCAT(STR($this), "/~root-aria-expanded")) AS ?expandedAttr)
  BIND(IF(?open, "true", "false") AS ?openText)
  BIND(IRI(CONCAT(STR($this), "/~row")) AS ?row)
  BIND(IRI(CONCAT(STR($this), "/~twisty")) AS ?lead)
  BIND(!?open AS ?expandsTo)
  BIND(IRI(CONCAT(STR($this), "/~twisty-aria-label")) AS ?leadAttr)
  BIND(CONCAT(IF(?open, "Collapse ", "Expand "), ?shown) AS ?leadLabel)
  BIND(IRI(CONCAT(STR($this), "/~twisty-icon")) AS ?icon)
  BIND(IRI(CONCAT(STR($this), "/~twisty-icon-aria-hidden")) AS ?iconHidden)
  BIND(IRI(CONCAT(STR($this), "/~twisty-text")) AS ?iconText)
  # Editing: the predicate in a field in its place, or a field for a new object.
  BIND(?editable && EXISTS { $this c:editing true } AS ?editing)
  BIND(?editable && ?open && EXISTS { $this c:adding true } AS ?adding)
  BIND(IF(?editable && !?editing, $this, ?none) AS ?editsRow)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit")), ?none) AS ?edit)
  OPTIONAL { FILTER(?editing) $this c:draft ?typed0 }
  BIND(IF(?editing, COALESCE(STR(?typed0), ?shown), ?none) AS ?editText)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit-aria-label")), ?none) AS ?editName)
  BIND(IF(?editing, IRI(CONCAT(STR($this), "/~edit-data-sem-takes-focus")), ?none) AS ?editFocus)
  OPTIONAL { FILTER(?editing) ?editAt l10n:of c:RdfEditPhrase ; l10n:name ?edit0 }
  OPTIONAL { FILTER(?editing) c:RdfEditPhrase rdfs:label ?edit0 FILTER(langMatches(lang(?edit0), "en")) }
  BIND(STR(?edit0) AS ?editPhrase)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-item")), ?none) AS ?addItem)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add")), ?none) AS ?add)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-label")), ?none) AS ?addName)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-data-sem-takes-focus")), ?none) AS ?addFocus)
  OPTIONAL { FILTER(?adding) ?addAt l10n:of c:RdfNewObjectPhrase ; l10n:name ?add0 }
  OPTIONAL { FILTER(?adding) c:RdfNewObjectPhrase rdfs:label ?add0 FILTER(langMatches(lang(?add0), "en")) }
  BIND(STR(?add0) AS ?addPhrase)
  # What the shapes expect, as buttons under the field (filtered by what is typed, c:draft).
  OPTIONAL { FILTER(?adding) $this c:draft ?draft0 }
  BIND(IF(?adding, STR(?draft0), ?none) AS ?draft)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions")), ?none) AS ?suggestions)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions-role")), ?none) AS ?sugRole)
  BIND(STR(?suggestions) AS ?suggestionsId)
  # The field is a combobox over them: the highlighted one (c:activeOption) is its active descendant.
  OPTIONAL { FILTER(?adding) $this c:activeOption ?active0 }
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-role")), ?none) AS ?comboRole)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-autocomplete")), ?none) AS ?comboList)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-expanded")), ?none) AS ?comboExpanded)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~add-aria-controls")), ?none) AS ?comboControls)
  BIND(IF(BOUND(?active0), IRI(CONCAT(STR($this), "/~add-aria-activedescendant")), ?none) AS ?comboActive)
  BIND(STR(?active0) AS ?activeId)
  BIND("true" AS ?comboOpen)
  BIND(IF(?adding, IRI(CONCAT(STR($this), "/~suggestions-aria-label")), ?none) AS ?sugName)
  OPTIONAL { FILTER(?adding) ?sugAt l10n:of c:RdfSuggestionsPhrase ; l10n:name ?sug0 }
  OPTIONAL { FILTER(?adding) c:RdfSuggestionsPhrase rdfs:label ?sug0 FILTER(langMatches(lang(?sug0), "en")) }
  BIND(STR(?sug0) AS ?sugPhrase)
  BIND(IF(?editing, ?none, IRI(CONCAT(STR($this), "/~label"))) AS ?label)
  BIND(IF(BOUND(?label) && ?goes, IRI(CONCAT(STR($this), "/~label-data-sem-link")), ?none) AS ?linkAttr)
  BIND(IF(BOUND(?label), IRI(CONCAT(STR($this), "/~label-text")), ?none) AS ?labelText)
  BIND(IF(BOUND(?noteData), IRI(CONCAT(STR($this), "/~note")), ?none) AS ?note)
  BIND(IF(BOUND(?noteData), IRI(CONCAT(STR($this), "/~note-text")), ?none) AS ?noteText)
  BIND(IF(?open, IRI(CONCAT(STR($this), "/~group")), ?none) AS ?group)
  BIND(IF(?open, IRI(CONCAT(STR($this), "/~group-role")), ?none) AS ?groupRole)
  BIND(IF(?invalid && BOUND(?label), IRI(CONCAT(STR($this), "/~label-aria-invalid")), ?none) AS ?invalidAttr)
  BIND(IF(?invalid && BOUND(?label), IRI(CONCAT(STR($this), "/~label-aria-describedby")), ?none) AS ?describedAttr)
  BIND(IF(?editable, c:RdfDraggableRow, ?none) AS ?dragType)
  # The row's menu (c:menuOpen), at the end of the row.
  BIND(EXISTS { $this c:menuOpen true } AS ?menuOpen)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu")), ?none) AS ?menu)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-role")), ?none) AS ?menuRole)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-items")), ?none) AS ?menuItems)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-orientation")), ?none) AS ?menuOrient)
  BIND(IF(?menuOpen, IRI(CONCAT(STR($this), "/~menu-data-sem-nav-wrap")), ?none) AS ?menuWrap)
  BIND(?p AS ?t)
  BIND(?depth + 1 AS ?childDepth)
  LATERAL { {} UNION {
    FILTER(?open)
    { ?s ?p ?o } UNION { $this c:diff true . ?gsto rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?o . ?gevo beh:retracted ?gsto ; beh:sequence ?gseqo .
      FILTER NOT EXISTS { ?s ?p ?o } FILTER NOT EXISTS { ?gundoo beh:undone ?gevo }
      FILTER NOT EXISTS { ?gxsto rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?o . ?gxevo beh:asserted|beh:retracted ?gxsto ; beh:sequence ?gxseqo . FILTER(?gxseqo < ?gseqo) FILTER NOT EXISTS { ?gxundoo beh:undone ?gxevo } } }
    OPTIONAL { { SELECT ?o (MIN(?bpair) AS ?bmin) (MAX(?bpair) AS ?bmax) WHERE {
        $this c:subjectTerm ?s1 ; c:predicateTerm ?p1 . ?s1 ?p1 ?o . FILTER(isBlank(?o)) ?o ?bp ?bo
        BIND(CONCAT(IF(isLiteral(?bo) || isIRI(?bo), "", "~"), STR(?bp), " ", COALESCE(STR(?bo), "_")) AS ?bpair) } GROUP BY ?o } }
    BIND(IF(isLiteral(?o), CONCAT("\\"", STR(?o), "\\"", IF(LANG(?o) != "", CONCAT("@", LANG(?o)), CONCAT("^^", STR(DATATYPE(?o))))),
         IF(isIRI(?o), STR(?o), IF(isBlank(?o), CONCAT("_:", COALESCE(?bmin, ""), "|", COALESCE(?bmax, "")),
         CONCAT("<<", STR(SUBJECT(?o)), " ", STR(PREDICATE(?o)), " ", COALESCE(STR(OBJECT(?o)), "_"), ">>")))) AS ?okey)
    BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(?okey), 1, 12))) AS ?child)
  } UNION {
    # Values its shapes expect: fixed ones, the allowed ones, instances of its class (the first 20).
    FILTER(?adding)
    { SELECT ?optV WHERE {
      $this c:subjectTerm ?s5 ; c:predicateTerm ?p5 .
      ?s5 a ?ty5 . ?ty5 rdfs:subClassOf* ?c5 . ?sh5 sh:targetClass ?c5 ; sh:property ?ps5 . ?ps5 sh:path ?p5 .
      { ?ps5 sh:hasValue|sh:defaultValue ?optV } UNION { ?ps5 sh:in/rdf:rest*/rdf:first ?optV } UNION { ?ps5 sh:class ?cl5 . ?optV a/rdfs:subClassOf* ?cl5 . FILTER(isIRI(?optV)) }
      FILTER NOT EXISTS { ?s5 ?p5 ?optV }
    } GROUP BY ?optV ORDER BY STR(?optV) LIMIT 20 }
    BIND(REPLACE(STR(?optV), "[^#/]*$", "") AS ?ovns)
    BIND(REPLACE(STR(?optV), "^.*[#/]", "") AS ?ovloc)
    OPTIONAL { { SELECT ?ovns (MIN(?ovx0) AS ?ovx) WHERE { ?ovxd sh:prefix ?ovx0 ; sh:namespace ?ovxn BIND(STR(?ovxn) AS ?ovns) } GROUP BY ?ovns } }
    BIND(IF(BOUND(?ovx) && REGEX(?ovloc, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?ovx, ":", ?ovloc), CONCAT("<", STR(?optV), ">")) AS ?vCompact)
    BIND(IF(!BOUND(?optV), ?none, IF(isIRI(?optV), ?vCompact, IF(isLiteral(?optV) && DATATYPE(?optV) IN (xsd:integer, xsd:decimal, xsd:double, xsd:boolean), STR(?optV), CONCAT("\\"", STR(?optV), "\\"")))) AS ?vText)
    BIND(?vText AS ?optionLabel)
    BIND("sem-option" AS ?optionClass)
    FILTER(!BOUND(?draft) || ?draft = "" || CONTAINS(LCASE(?optionLabel), LCASE(?draft)))
    BIND(?optionLabel AS ?optionKey)
    BIND(IRI(CONCAT(STR($this), "/~opt-", SUBSTR(MD5(?optionLabel), 1, 12))) AS ?option)
    BIND(IRI(CONCAT(STR(?option), "-text")) AS ?optionText)
    BIND(STR(?option) AS ?optionId)
    BIND(IRI(CONCAT(STR(?option), "-role")) AS ?optionRole)
    BIND(IRI(CONCAT(STR(?option), "-aria-selected")) AS ?optionSelected)
    BIND(IF(BOUND(?active0) && sameTerm(?active0, ?option), "true", "false") AS ?selected)
  } UNION {
    # Its menu's items: what can be done here, each with its key.
    FILTER(?menuOpen)
    VALUES (?itemN ?itemPhrase ?itemDoes ?itemKeys ?itemKbdShown ?itemKind ?itemAsKey) {
      (1 c:RdfMenuEditPhrase c:RdfStartEdit "Enter" "↵" "edit" UNDEF)
      (2 c:RdfMenuAddPhrase c:RdfStartAdd "Shift+Enter" "⇧↵" "add" UNDEF)
      (3 c:RdfMenuNestPhrase c:RdfNest "Tab" "⇥" "nest" UNDEF)
      (4 c:RdfMenuOutdentPhrase c:RdfOutdent "Shift+Tab" "⇧⇥" "outdent" UNDEF)
      (5 c:RdfMenuUpPhrase c:RdfMoveMember "Alt+ArrowUp" "⌥↑" "up" "alt+arrowup")
      (6 c:RdfMenuDownPhrase c:RdfMoveMember "Alt+ArrowDown" "⌥↓" "down" "alt+arrowdown")
      (7 c:RdfMenuGoPhrase UNDEF "Enter" "↵" "jump" UNDEF)
      (8 c:RdfMenuReferencePhrase UNDEF "Enter" "↵" "go" UNDEF)
      (9 c:RdfMenuDeletePhrase c:RdfDelete "Delete" "⌫" "delete" UNDEF)
    }
    FILTER(?itemKind IN ("edit", "add", "delete", "go") && IF(?itemKind = "go", ?goes, ?editable))
    OPTIONAL { ?itemAt l10n:of ?itemPhrase ; l10n:name ?item0 }
    OPTIONAL { ?itemPhrase rdfs:label ?item0 FILTER(langMatches(lang(?item0), "en")) }
    BIND(STR(?item0) AS ?itemLabel)
    BIND(IF(?itemKind = "delete", "sem-menuitem sem-danger", "sem-menuitem") AS ?itemClass)
    BIND(IF(?itemKind = "jump", ?t, ?none) AS ?itemJump)
    BIND(IF(?itemKind = "go", ?t, ?none) AS ?itemGo)
    BIND(CONCAT(STR($this), "/~menu-", STR(?itemN)) AS ?itemLocal)
    BIND(IRI(?itemLocal) AS ?item)
    BIND(IRI(CONCAT(?itemLocal, "-role")) AS ?itemRole)
    BIND(IRI(CONCAT(?itemLocal, "-data-sem-takes-focus")) AS ?itemFocus)
    BIND(IRI(CONCAT(?itemLocal, "-aria-keyshortcuts")) AS ?itemShortcut)
    BIND(IRI(CONCAT(?itemLocal, "-text")) AS ?itemText)
    BIND(IRI(CONCAT(?itemLocal, "-kbd")) AS ?itemKbd)
    BIND(IRI(CONCAT(?itemLocal, "-kbd-aria-hidden")) AS ?itemKbdHidden)
    BIND(IRI(CONCAT(?itemLocal, "-kbd-text")) AS ?itemKbdText)
  } UNION {
    FILTER(?invalid)
    ?editor val:violation ?vr2 . ?vr2 sh:focusNode ?s ; sh:resultPath ?p ; sh:resultMessage ?message0 . FILTER NOT EXISTS { ?vr2 sh:value ?vv2 }
    BIND(STR(?message0) AS ?problemText)
    BIND(IRI(CONCAT(STR($this), "/~problem-", SUBSTR(MD5(?problemText), 1, 12))) AS ?problem)
    BIND(IRI(CONCAT(STR(?problem), "-text")) AS ?problemData)
  } }
}""" .
c:RdfPropertyRendering-sparql-text a sem:Rule ;
    sem:implements c:RdfPropertyRendering ;
    sem:modality mod:Text ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?label , ?group .
  ?label a rdfhtml:Span ; rdfhtml:hasChild ?labelText ; ord:immediatelyPrecedes ?group .
  ?labelText a rdfhtml:Text ; rdfhtml:data ?data .
  ?group a rdfhtml:Span ; rdfhtml:hasChild ?child .
  ?child a c:RdfTerm ; c:term ?o ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:inEditor ?editor ; c:depth ?childDepth ; c:editable ?editable ; c:validated ?validated ; sem:orderKey ?okey .
}
WHERE {
  $this a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:inEditor ?editor .
  OPTIONAL { $this c:depth ?depth0 }
  BIND(COALESCE(xsd:integer(STR(?depth0)), 1) AS ?depth)
  OPTIONAL { $this c:editable ?editable0 }
  BIND(COALESCE(?editable0, false) AS ?editable)
  OPTIONAL { $this c:validated ?validated0 }
  BIND(COALESCE(?validated0, false) AS ?validated)
  OPTIONAL { $this c:expanded ?own }
  BIND(COALESCE(?own, true) AS ?open)
  BIND(REPLACE(STR(?p), "[^#/]*$", "") AS ?ns)
  BIND(REPLACE(STR(?p), "^.*[#/]", "") AS ?local)
  OPTIONAL { { SELECT ?ns (MIN(?prefix0) AS ?prefix) WHERE { ?decl sh:prefix ?prefix0 ; sh:namespace ?ns0 BIND(STR(?ns0) AS ?ns) } GROUP BY ?ns } }
  BIND(IF(BOUND(?prefix) && REGEX(?local, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?prefix, ":", ?local), CONCAT("<", STR(?p), ">")) AS ?compact)
  BIND(SUBSTR("                                                                                                                                ", 1, ?depth + 1) AS ?indent)
  BIND(CONCAT(?indent, IF(sameTerm(?p, rdf:type), "a", ?compact), IF(?open, "", " …")) AS ?data)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~label")) AS ?label)
  BIND(IRI(CONCAT(STR($this), "/~label-text")) AS ?labelText)
  BIND(IF(?open, IRI(CONCAT(STR($this), "/~group")), ?none) AS ?group)
  BIND(?depth + 1 AS ?childDepth)
  LATERAL { {} UNION {
    FILTER(?open)
    ?s ?p ?o .
    OPTIONAL { { SELECT ?o (MIN(?bpair) AS ?bmin) (MAX(?bpair) AS ?bmax) WHERE {
        $this c:subjectTerm ?s1 ; c:predicateTerm ?p1 . ?s1 ?p1 ?o . FILTER(isBlank(?o)) ?o ?bp ?bo
        BIND(CONCAT(IF(isLiteral(?bo) || isIRI(?bo), "", "~"), STR(?bp), " ", COALESCE(STR(?bo), "_")) AS ?bpair) } GROUP BY ?o } }
    BIND(IF(isLiteral(?o), CONCAT("\\"", STR(?o), "\\"", IF(LANG(?o) != "", CONCAT("@", LANG(?o)), CONCAT("^^", STR(DATATYPE(?o))))),
         IF(isIRI(?o), STR(?o), IF(isBlank(?o), CONCAT("_:", COALESCE(?bmin, ""), "|", COALESCE(?bmax, "")),
         CONCAT("<<", STR(SUBJECT(?o)), " ", STR(PREDICATE(?o)), " ", COALESCE(STR(OBJECT(?o)), "_"), ">>")))) AS ?okey)
    BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(?okey), 1, 12))) AS ?child)
  } }
}""" .

# --- reactions: opening and following ---------------------------------------------------------------
# The editor handles its rows' events, so what a jump focuses can be any row of it.

# A twisty sets its row's c:expanded to what it says (c:expandsTo): the row alone renders again.
# Like every reaction of the editor, it spends the focus mark a jump left (c:focused), so the focus
# stays where the person put it.
c:RdfRowToggle a beh:Reaction ;
    rdfs:label "Open or close a row"@en ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row c:expanded ?old . ?marked c:focused ?f }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:expands ?row . ?row c:inEditor $this .
  { ?row c:expanded ?old } UNION { ?marked c:focused ?f FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
}""" ;
    beh:inserts """CONSTRUCT { ?row c:expanded ?to }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:expands ?row ; c:expandsTo ?to . ?row c:inEditor $this }""" ;
    sem:function "rdf-editor:toggle" .

# Activating a link (a click, or Enter on its row): a resource of the document becomes the current
# one and its row takes the focus; a term is gone to (the Reference). A click follows a link in an
# editor too (a double click, Enter or typing edits); Enter follows it only in a viewer.
c:RdfFollowLink a beh:Reaction ;
    rdfs:label "Follow a link"@en ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { $this c:current ?was . ?row c:focused ?f }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:jumpsTo ?to .
  { $this c:current ?was } UNION { ?row c:focused ?f FILTER(STRSTARTS(STR(?row), CONCAT(STR($this), "/~"))) }
}""" ;
    beh:inserts """CONSTRUCT { $this c:current ?to ; nav:goTo ?term . ?row c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit .
  { ?n c:jumpsTo ?to . BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(STR(?to)), 1, 12))) AS ?row) } UNION { ?n c:goesTo ?term }
}""" ;
    sem:function "rdf-editor:follow" .
c:RdfFollowLinkByKey a beh:Reaction ;
    rdfs:label "Follow a link"@en ;
    beh:when c:RdfEditorKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { $this c:current ?was . ?row c:focused ?f }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:jumpsTo ?to .
  FILTER NOT EXISTS { ?n c:editsRow ?editing }
  { $this c:current ?was } UNION { ?row c:focused ?f FILTER(STRSTARTS(STR(?row), CONCAT(STR($this), "/~"))) }
}""" ;
    beh:inserts """CONSTRUCT { $this c:current ?to ; nav:goTo ?term . ?row c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit .
  FILTER NOT EXISTS { ?n c:editsRow ?editing }
  { ?n c:jumpsTo ?to . BIND(IRI(CONCAT(STR($this), "/~t-", SUBSTR(MD5(STR(?to)), 1, 12))) AS ?row) } UNION { ?n c:goesTo ?term }
}""" ;
    sem:function "rdf-editor:follow-key" .

# --- reactions: editing (c:editable true) -------------------------------------------------------------
# Every edit is one reaction over the document, undoable through the change log (beh:undoable); the
# fields are state on the rows (c:editing, c:adding), so opening one renders that row alone. A field
# takes what Turtle writes: "text"@lang, "text"^^datatype, a number or a boolean, <iri>, prefix:local
# (a declared prefix); text without quotes keeps the literal's datatype and language, so a date stays a
# date and a title keeps its language. Enter commits (the focus goes to the row it made), Escape leaves
# it, Shift+Enter adds, Delete removes.

c:RdfStartEdit a beh:Reaction ;
    rdfs:label "Edit a row"@en ;
    beh:when c:RdfEditorKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfStartEdit } . ?row c:inEditor $this . ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }""" ;
    beh:inserts """CONSTRUCT { ?row c:editing true } WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfStartEdit } . ?row c:inEditor $this . }""" ;
    sem:function "rdf-editor:start-edit" .

c:RdfStartEditByDoubleClick a beh:Reaction ;
    rdfs:label "Edit a row"@en ;
    beh:when beh:DoubleClick ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:editsRow ?row . ?row c:inEditor $this . ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }""" ;
    beh:inserts """CONSTRUCT { ?row c:editing true } WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:editsRow ?row . ?row c:inEditor $this . }""" ;
    sem:function "rdf-editor:start-edit" .

# Shift+Enter: beside an object, a new object of its predicate; on a predicate, a new statement of its
# resource; on a resource (or a nested one), a new statement in it; on a list or a member of it, a new
# member at its end.
c:RdfStartAdd a beh:Reaction ;
    rdfs:label "Add a statement"@en ;
    beh:when c:RdfEditorAddKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfStartAdd } . ?row c:inEditor $this . ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }""" ;
    beh:inserts """CONSTRUCT { ?to c:adding true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfStartAdd } . ?row c:inEditor $this .
  BIND(EXISTS { ?row a c:RdfTerm ; c:subjectTerm ?anyS } AS ?object)
  BIND(EXISTS { ?row a c:RdfProperty } AS ?predicate)
  BIND(EXISTS { ?row c:listCell ?anyCell } AS ?member)
  BIND(IF(?member, IRI(REPLACE(STR(?row), "/~i-[0-9]+$", "")), IF(?object || ?predicate, IRI(REPLACE(STR(?row), "/~[tp]-[0-9a-f]{12}$", "")), ?row)) AS ?to)
}""" ;
    sem:function "rdf-editor:start-add" .

# Enter in a row's field: the statement (or every statement of a predicate) with the new term instead.
c:RdfCommitEdit a beh:Reaction ;
    rdfs:label "Change a term"@en ;
    beh:when c:RdfEditorKey ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?s ?p ?o . ?cell rdf:first ?old . ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit ; beh:value ?raw . ?n rdfhtml:hasChild* ?hit . ?n c:commits ?row . ?row c:inEditor $this .
  LATERAL {
    { ?row a c:RdfTerm ; c:term ?old .
      OPTIONAL { ?row c:subjectTerm ?s0 ; c:predicateTerm ?p0 } OPTIONAL { ?row c:listCell ?cell0 }
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?newText)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?newLang)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?newTyped)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"$") AS ?newQuoted)
    BIND(REPLACE(?newText, "^\\"([^\\"]*)\\".*$", "$1") AS ?newInner)
    BIND(IF(?newTyped, STRAFTER(?newText, "\\"^^"), ?newText) AS ?newName)
    BIND(REGEX(?newName, "^<[^<>\\" ]+>$") AS ?newIri)
    BIND(!?newIri && REGEX(?newName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?newPname)
    BIND(STRBEFORE(?newName, ":") AS ?newPfx)
    OPTIONAL { FILTER(?newPname) ?newDecl sh:prefix ?newP0 ; sh:namespace ?newNs0 FILTER(STR(?newP0) = ?newPfx) BIND(STR(?newNs0) AS ?newNs) }
    BIND(IF(?newIri, IRI(SUBSTR(?newName, 2, STRLEN(?newName) - 2)), IF(?newPname && BOUND(?newNs), IRI(CONCAT(?newNs, STRAFTER(?newName, ":"))), ?none)) AS ?newNamed)
    # What the property expects: its shapes' sh:datatype, else an XSD rdfs:range.
    BIND(COALESCE(?s0, rdf:nil) AS ?xs) BIND(COALESCE(?p0, rdf:nil) AS ?xp)
    OPTIONAL { ?xs a/rdfs:subClassOf* ?xc . ?xsh sh:targetClass ?xc ; sh:property ?xps . ?xps sh:path ?xp ; sh:datatype ?shapeDt FILTER(?shapeDt != rdf:langString) }
    OPTIONAL { ?xp rdfs:range ?rangeDt FILTER(STRSTARTS(STR(?rangeDt), STR(xsd:))) }
    BIND(COALESCE(?shapeDt, ?rangeDt) AS ?newExpected)
    BIND(IF(?newLang, STRLANG(?newInner, STRAFTER(?newText, "\\"@")),
         IF(?newTyped && BOUND(?newNamed), STRDT(?newInner, ?newNamed),
         IF(?newQuoted, ?newInner,
         IF(!?newTyped && BOUND(?newNamed), ?newNamed,
         IF(BOUND(?newExpected), STRDT(?newText, ?newExpected),
         IF(BOUND(?old) && isLiteral(?old) && LANG(?old) != "", STRLANG(?newText, LANG(?old)),
         IF(REGEX(?newText, "^[+-]?[0-9]+$"), STRDT(?newText, xsd:integer),
         IF(REGEX(?newText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?newText, xsd:decimal),
         IF(REGEX(?newText, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[eE][+-]?[0-9]+$"), STRDT(?newText, xsd:double),
         IF(?newText IN ("true", "false"), STRDT(?newText, xsd:boolean),
         IF(BOUND(?old) && isLiteral(?old), STRDT(?newText, DATATYPE(?old)), ?newText))))))))))) AS ?new)
    FILTER(?newText != "")
      FILTER(!sameTerm(?new, ?old))
      BIND(?s0 AS ?s) BIND(?p0 AS ?p) BIND(IF(BOUND(?s0), ?old, ?none) AS ?o) BIND(?cell0 AS ?cell) }
    UNION { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p .
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?npText)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?npLang)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?npTyped)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"$") AS ?npQuoted)
    BIND(REPLACE(?npText, "^\\"([^\\"]*)\\".*$", "$1") AS ?npInner)
    BIND(IF(?npTyped, STRAFTER(?npText, "\\"^^"), ?npText) AS ?npName)
    BIND(REGEX(?npName, "^<[^<>\\" ]+>$") AS ?npIri)
    BIND(!?npIri && REGEX(?npName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?npPname)
    BIND(STRBEFORE(?npName, ":") AS ?npPfx)
    OPTIONAL { FILTER(?npPname) ?npDecl sh:prefix ?npP0 ; sh:namespace ?npNs0 FILTER(STR(?npP0) = ?npPfx) BIND(STR(?npNs0) AS ?npNs) }
    BIND(IF(?npIri, IRI(SUBSTR(?npName, 2, STRLEN(?npName) - 2)), IF(?npPname && BOUND(?npNs), IRI(CONCAT(?npNs, STRAFTER(?npName, ":"))), ?none)) AS ?npNamed)
    BIND(IF(?npLang, STRLANG(?npInner, STRAFTER(?npText, "\\"@")),
         IF(?npTyped && BOUND(?npNamed), STRDT(?npInner, ?npNamed),
         IF(?npQuoted, ?npInner,
         IF(!?npTyped && BOUND(?npNamed), ?npNamed,
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]+$"), STRDT(?npText, xsd:integer),
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?npText, xsd:decimal),
         IF(!(false) && ?npText IN ("true", "false"), STRDT(?npText, xsd:boolean),
         IF(false && LANG(?x) != "", STRLANG(?npText, LANG(?x)),
         IF(false, STRDT(?npText, DATATYPE(?x)), ?npText))))))))) AS ?np)
    FILTER(?npText != "")
      FILTER((isIRI(?np) || ?npText = "a") && !sameTerm(IF(?npText = "a", rdf:type, ?np), ?p))
      ?s ?p ?o }
    UNION { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
  }
}""" ;
    beh:inserts """CONSTRUCT { ?s ?p ?new . ?cell rdf:first ?new . ?s ?newP ?o . ?focus c:focused true }
WHERE {
  $event beh:node ?hit ; beh:value ?raw . ?n rdfhtml:hasChild* ?hit . ?n c:commits ?row . ?row c:inEditor $this .
  LATERAL {
    { ?row a c:RdfTerm ; c:term ?old .
      OPTIONAL { ?row c:subjectTerm ?s0 ; c:predicateTerm ?p0 } OPTIONAL { ?row c:listCell ?cell0 }
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?newText)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?newLang)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?newTyped)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"$") AS ?newQuoted)
    BIND(REPLACE(?newText, "^\\"([^\\"]*)\\".*$", "$1") AS ?newInner)
    BIND(IF(?newTyped, STRAFTER(?newText, "\\"^^"), ?newText) AS ?newName)
    BIND(REGEX(?newName, "^<[^<>\\" ]+>$") AS ?newIri)
    BIND(!?newIri && REGEX(?newName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?newPname)
    BIND(STRBEFORE(?newName, ":") AS ?newPfx)
    OPTIONAL { FILTER(?newPname) ?newDecl sh:prefix ?newP0 ; sh:namespace ?newNs0 FILTER(STR(?newP0) = ?newPfx) BIND(STR(?newNs0) AS ?newNs) }
    BIND(IF(?newIri, IRI(SUBSTR(?newName, 2, STRLEN(?newName) - 2)), IF(?newPname && BOUND(?newNs), IRI(CONCAT(?newNs, STRAFTER(?newName, ":"))), ?none)) AS ?newNamed)
    # What the property expects: its shapes' sh:datatype, else an XSD rdfs:range.
    BIND(COALESCE(?s0, rdf:nil) AS ?xs) BIND(COALESCE(?p0, rdf:nil) AS ?xp)
    OPTIONAL { ?xs a/rdfs:subClassOf* ?xc . ?xsh sh:targetClass ?xc ; sh:property ?xps . ?xps sh:path ?xp ; sh:datatype ?shapeDt FILTER(?shapeDt != rdf:langString) }
    OPTIONAL { ?xp rdfs:range ?rangeDt FILTER(STRSTARTS(STR(?rangeDt), STR(xsd:))) }
    BIND(COALESCE(?shapeDt, ?rangeDt) AS ?newExpected)
    BIND(IF(?newLang, STRLANG(?newInner, STRAFTER(?newText, "\\"@")),
         IF(?newTyped && BOUND(?newNamed), STRDT(?newInner, ?newNamed),
         IF(?newQuoted, ?newInner,
         IF(!?newTyped && BOUND(?newNamed), ?newNamed,
         IF(BOUND(?newExpected), STRDT(?newText, ?newExpected),
         IF(BOUND(?old) && isLiteral(?old) && LANG(?old) != "", STRLANG(?newText, LANG(?old)),
         IF(REGEX(?newText, "^[+-]?[0-9]+$"), STRDT(?newText, xsd:integer),
         IF(REGEX(?newText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?newText, xsd:decimal),
         IF(REGEX(?newText, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[eE][+-]?[0-9]+$"), STRDT(?newText, xsd:double),
         IF(?newText IN ("true", "false"), STRDT(?newText, xsd:boolean),
         IF(BOUND(?old) && isLiteral(?old), STRDT(?newText, DATATYPE(?old)), ?newText))))))))))) AS ?new)
    FILTER(?newText != "")
      BIND(?s0 AS ?s) BIND(?p0 AS ?p) BIND(?cell0 AS ?cell)
      BIND(IF(BOUND(?s0), IRI(CONCAT(REPLACE(STR(?row), "/~t-[0-9a-f]{12}$", ""), "/~t-", SUBSTR(MD5(IF(isLiteral(?new), CONCAT("\\"", STR(?new), "\\"", IF(LANG(?new) != "", CONCAT("@", LANG(?new)), CONCAT("^^", STR(DATATYPE(?new))))), STR(?new))), 1, 12))), ?row) AS ?focus) }
    UNION { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p0 .
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?npText)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?npLang)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?npTyped)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"$") AS ?npQuoted)
    BIND(REPLACE(?npText, "^\\"([^\\"]*)\\".*$", "$1") AS ?npInner)
    BIND(IF(?npTyped, STRAFTER(?npText, "\\"^^"), ?npText) AS ?npName)
    BIND(REGEX(?npName, "^<[^<>\\" ]+>$") AS ?npIri)
    BIND(!?npIri && REGEX(?npName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?npPname)
    BIND(STRBEFORE(?npName, ":") AS ?npPfx)
    OPTIONAL { FILTER(?npPname) ?npDecl sh:prefix ?npP0 ; sh:namespace ?npNs0 FILTER(STR(?npP0) = ?npPfx) BIND(STR(?npNs0) AS ?npNs) }
    BIND(IF(?npIri, IRI(SUBSTR(?npName, 2, STRLEN(?npName) - 2)), IF(?npPname && BOUND(?npNs), IRI(CONCAT(?npNs, STRAFTER(?npName, ":"))), ?none)) AS ?npNamed)
    BIND(IF(?npLang, STRLANG(?npInner, STRAFTER(?npText, "\\"@")),
         IF(?npTyped && BOUND(?npNamed), STRDT(?npInner, ?npNamed),
         IF(?npQuoted, ?npInner,
         IF(!?npTyped && BOUND(?npNamed), ?npNamed,
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]+$"), STRDT(?npText, xsd:integer),
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?npText, xsd:decimal),
         IF(!(false) && ?npText IN ("true", "false"), STRDT(?npText, xsd:boolean),
         IF(false && LANG(?x) != "", STRLANG(?npText, LANG(?x)),
         IF(false, STRDT(?npText, DATATYPE(?x)), ?npText))))))))) AS ?np)
    FILTER(?npText != "")
      FILTER(isIRI(?np) || ?npText = "a")
      BIND(IF(?npText = "a", rdf:type, ?np) AS ?newP)
      ?s ?p0 ?o
      BIND(IRI(CONCAT(REPLACE(STR(?row), "/~p-[0-9a-f]{12}$", ""), "/~p-", SUBSTR(MD5(STR(?newP)), 1, 12))) AS ?focus) }
  }
}""" ;
    sem:function "rdf-editor:commit-edit" .

# Enter in an adding field: a new object of the predicate, or a new statement ("predicate value") of the resource.
c:RdfCommitAdd a beh:Reaction ;
    rdfs:label "Add a statement"@en ;
    beh:when c:RdfEditorKey ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark . ?last rdf:rest rdf:nil . ?ls ?lp rdf:nil }
WHERE {
  $event beh:node ?hit ; beh:value ?raw . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this . FILTER NOT EXISTS { ?row c:activeOption ?highlighted }
  LATERAL {
    { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
    UNION { ?row a c:RdfTerm ; c:term ?head . FILTER(REGEX(STR(?raw), "[^ ]"))
      { ?head rdf:rest* ?last . ?last rdf:rest rdf:nil . ?head rdf:first ?anyFirst } UNION { FILTER(sameTerm(?head, rdf:nil)) ?row c:subjectTerm ?ls ; c:predicateTerm ?lp } }
  }
}""" ;
    beh:inserts """CONSTRUCT { ?s ?p ?new . ?focus c:focused true . ?last rdf:rest ?cell . ?cell rdf:first ?new ; rdf:rest rdf:nil . ?ls ?lp ?cell }
WHERE {
  $event beh:node ?hit ; beh:value ?raw . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this . FILTER NOT EXISTS { ?row c:activeOption ?highlighted }
  LATERAL {
    { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p .
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?newText)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?newLang)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?newTyped)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"$") AS ?newQuoted)
    BIND(REPLACE(?newText, "^\\"([^\\"]*)\\".*$", "$1") AS ?newInner)
    BIND(IF(?newTyped, STRAFTER(?newText, "\\"^^"), ?newText) AS ?newName)
    BIND(REGEX(?newName, "^<[^<>\\" ]+>$") AS ?newIri)
    BIND(!?newIri && REGEX(?newName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?newPname)
    BIND(STRBEFORE(?newName, ":") AS ?newPfx)
    OPTIONAL { FILTER(?newPname) ?newDecl sh:prefix ?newP0 ; sh:namespace ?newNs0 FILTER(STR(?newP0) = ?newPfx) BIND(STR(?newNs0) AS ?newNs) }
    BIND(IF(?newIri, IRI(SUBSTR(?newName, 2, STRLEN(?newName) - 2)), IF(?newPname && BOUND(?newNs), IRI(CONCAT(?newNs, STRAFTER(?newName, ":"))), ?none)) AS ?newNamed)
    # What the property expects: its shapes' sh:datatype, else an XSD rdfs:range.
    OPTIONAL { ?s a/rdfs:subClassOf* ?xc . ?xsh sh:targetClass ?xc ; sh:property ?xps . ?xps sh:path ?p ; sh:datatype ?shapeDt FILTER(?shapeDt != rdf:langString) }
    OPTIONAL { ?p rdfs:range ?rangeDt FILTER(STRSTARTS(STR(?rangeDt), STR(xsd:))) }
    BIND(COALESCE(?shapeDt, ?rangeDt) AS ?newExpected)
    BIND(IF(?newLang, STRLANG(?newInner, STRAFTER(?newText, "\\"@")),
         IF(?newTyped && BOUND(?newNamed), STRDT(?newInner, ?newNamed),
         IF(?newQuoted, ?newInner,
         IF(!?newTyped && BOUND(?newNamed), ?newNamed,
         IF(BOUND(?newExpected), STRDT(?newText, ?newExpected),
         IF(REGEX(?newText, "^[+-]?[0-9]+$"), STRDT(?newText, xsd:integer),
         IF(REGEX(?newText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?newText, xsd:decimal),
         IF(REGEX(?newText, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[eE][+-]?[0-9]+$"), STRDT(?newText, xsd:double),
         IF(?newText IN ("true", "false"), STRDT(?newText, xsd:boolean),
         ?newText))))))))) AS ?new)
    FILTER(?newText != "")
      BIND(IRI(CONCAT(STR(?row), "/~t-", SUBSTR(MD5(IF(isLiteral(?new), CONCAT("\\"", STR(?new), "\\"", IF(LANG(?new) != "", CONCAT("@", LANG(?new)), CONCAT("^^", STR(DATATYPE(?new))))), STR(?new))), 1, 12))) AS ?focus) }
    UNION { ?row a c:RdfTerm ; c:term ?head .
      FILTER(sameTerm(?head, rdf:nil) || EXISTS { ?head rdf:first ?anyFirst })
    BIND(REPLACE(STR(?raw), "^\\\\s+|\\\\s+$", "") AS ?newText)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?newLang)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?newTyped)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"$") AS ?newQuoted)
    BIND(REPLACE(?newText, "^\\"([^\\"]*)\\".*$", "$1") AS ?newInner)
    BIND(IF(?newTyped, STRAFTER(?newText, "\\"^^"), ?newText) AS ?newName)
    BIND(REGEX(?newName, "^<[^<>\\" ]+>$") AS ?newIri)
    BIND(!?newIri && REGEX(?newName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?newPname)
    BIND(STRBEFORE(?newName, ":") AS ?newPfx)
    OPTIONAL { FILTER(?newPname) ?newDecl sh:prefix ?newP0 ; sh:namespace ?newNs0 FILTER(STR(?newP0) = ?newPfx) BIND(STR(?newNs0) AS ?newNs) }
    BIND(IF(?newIri, IRI(SUBSTR(?newName, 2, STRLEN(?newName) - 2)), IF(?newPname && BOUND(?newNs), IRI(CONCAT(?newNs, STRAFTER(?newName, ":"))), ?none)) AS ?newNamed)
    BIND(IF(?newLang, STRLANG(?newInner, STRAFTER(?newText, "\\"@")),
         IF(?newTyped && BOUND(?newNamed), STRDT(?newInner, ?newNamed),
         IF(?newQuoted, ?newInner,
         IF(!?newTyped && BOUND(?newNamed), ?newNamed,
         IF(BOUND(?newExpected), STRDT(?newText, ?newExpected),
         IF(REGEX(?newText, "^[+-]?[0-9]+$"), STRDT(?newText, xsd:integer),
         IF(REGEX(?newText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?newText, xsd:decimal),
         IF(REGEX(?newText, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[eE][+-]?[0-9]+$"), STRDT(?newText, xsd:double),
         IF(?newText IN ("true", "false"), STRDT(?newText, xsd:boolean),
         ?newText))))))))) AS ?new)
    FILTER(?newText != "")
      BIND(IRI(CONCAT(STR($this), "/.well-known/genid/", SUBSTR(MD5(CONCAT(STR(?row), " ", STR(?new), " ", COALESCE(STR(DATATYPE(?new)), ""), COALESCE(LANG(?new), ""))), 1, 16))) AS ?cell)
      OPTIONAL { FILTER(!sameTerm(?head, rdf:nil)) ?head rdf:rest* ?last . ?last rdf:rest rdf:nil }
      OPTIONAL { FILTER(sameTerm(?head, rdf:nil)) ?row c:subjectTerm ?ls ; c:predicateTerm ?lp }
      OPTIONAL { { SELECT (COUNT(?mc) AS ?members) WHERE { $event beh:node ?hit2 . ?n2 rdfhtml:hasChild* ?hit2 . ?n2 c:adds ?row2 . ?row2 c:term ?h2 . ?h2 rdf:rest* ?mc . ?mc rdf:first ?mx } } }
      BIND(IF(sameTerm(?head, rdf:nil), IRI(REPLACE(STR(?row), "/~t-[0-9a-f]{12}$", "")), IRI(CONCAT(STR(?row), "/~i-", STR(COALESCE(?members, 0) + 1)))) AS ?focus) }
    UNION { ?row a c:RdfTerm ; c:term ?s .
      FILTER(!sameTerm(?s, rdf:nil) && NOT EXISTS { ?s rdf:first ?anyFirst2 })
      BIND(REPLACE(STR(?raw), "^\\\\s+", "") AS ?trimmed)
      BIND(STRBEFORE(CONCAT(?trimmed, " "), " ") AS ?predText)
      BIND(STRAFTER(?trimmed, " ") AS ?objText)
    BIND(REPLACE(STR(?predText), "^\\\\s+|\\\\s+$", "") AS ?npText)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?npLang)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?npTyped)
    BIND(REGEX(?npText, "^\\"[^\\"]*\\"$") AS ?npQuoted)
    BIND(REPLACE(?npText, "^\\"([^\\"]*)\\".*$", "$1") AS ?npInner)
    BIND(IF(?npTyped, STRAFTER(?npText, "\\"^^"), ?npText) AS ?npName)
    BIND(REGEX(?npName, "^<[^<>\\" ]+>$") AS ?npIri)
    BIND(!?npIri && REGEX(?npName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?npPname)
    BIND(STRBEFORE(?npName, ":") AS ?npPfx)
    OPTIONAL { FILTER(?npPname) ?npDecl sh:prefix ?npP0 ; sh:namespace ?npNs0 FILTER(STR(?npP0) = ?npPfx) BIND(STR(?npNs0) AS ?npNs) }
    BIND(IF(?npIri, IRI(SUBSTR(?npName, 2, STRLEN(?npName) - 2)), IF(?npPname && BOUND(?npNs), IRI(CONCAT(?npNs, STRAFTER(?npName, ":"))), ?none)) AS ?npNamed)
    BIND(IF(?npLang, STRLANG(?npInner, STRAFTER(?npText, "\\"@")),
         IF(?npTyped && BOUND(?npNamed), STRDT(?npInner, ?npNamed),
         IF(?npQuoted, ?npInner,
         IF(!?npTyped && BOUND(?npNamed), ?npNamed,
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]+$"), STRDT(?npText, xsd:integer),
         IF(!(false) && REGEX(?npText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?npText, xsd:decimal),
         IF(!(false) && ?npText IN ("true", "false"), STRDT(?npText, xsd:boolean),
         IF(false && LANG(?x) != "", STRLANG(?npText, LANG(?x)),
         IF(false, STRDT(?npText, DATATYPE(?x)), ?npText))))))))) AS ?np)
    FILTER(?npText != "")
      FILTER(isIRI(?np) || ?npText = "a")
      BIND(IF(?npText = "a", rdf:type, ?np) AS ?p)
    BIND(REPLACE(STR(?objText), "^\\\\s+|\\\\s+$", "") AS ?newText)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"@[A-Za-z]+(-[A-Za-z0-9]+)*$") AS ?newLang)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"\\\\^\\\\^[^ ]+$") AS ?newTyped)
    BIND(REGEX(?newText, "^\\"[^\\"]*\\"$") AS ?newQuoted)
    BIND(REPLACE(?newText, "^\\"([^\\"]*)\\".*$", "$1") AS ?newInner)
    BIND(IF(?newTyped, STRAFTER(?newText, "\\"^^"), ?newText) AS ?newName)
    BIND(REGEX(?newName, "^<[^<>\\" ]+>$") AS ?newIri)
    BIND(!?newIri && REGEX(?newName, "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.-]*$") AS ?newPname)
    BIND(STRBEFORE(?newName, ":") AS ?newPfx)
    OPTIONAL { FILTER(?newPname) ?newDecl sh:prefix ?newP0 ; sh:namespace ?newNs0 FILTER(STR(?newP0) = ?newPfx) BIND(STR(?newNs0) AS ?newNs) }
    BIND(IF(?newIri, IRI(SUBSTR(?newName, 2, STRLEN(?newName) - 2)), IF(?newPname && BOUND(?newNs), IRI(CONCAT(?newNs, STRAFTER(?newName, ":"))), ?none)) AS ?newNamed)
    # What the property expects: its shapes' sh:datatype, else an XSD rdfs:range.
    OPTIONAL { ?s a/rdfs:subClassOf* ?xc . ?xsh sh:targetClass ?xc ; sh:property ?xps . ?xps sh:path ?p ; sh:datatype ?shapeDt FILTER(?shapeDt != rdf:langString) }
    OPTIONAL { ?p rdfs:range ?rangeDt FILTER(STRSTARTS(STR(?rangeDt), STR(xsd:))) }
    BIND(COALESCE(?shapeDt, ?rangeDt) AS ?newExpected)
    BIND(IF(?newLang, STRLANG(?newInner, STRAFTER(?newText, "\\"@")),
         IF(?newTyped && BOUND(?newNamed), STRDT(?newInner, ?newNamed),
         IF(?newQuoted, ?newInner,
         IF(!?newTyped && BOUND(?newNamed), ?newNamed,
         IF(BOUND(?newExpected), STRDT(?newText, ?newExpected),
         IF(REGEX(?newText, "^[+-]?[0-9]+$"), STRDT(?newText, xsd:integer),
         IF(REGEX(?newText, "^[+-]?[0-9]*\\\\.[0-9]+$"), STRDT(?newText, xsd:decimal),
         IF(REGEX(?newText, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)[eE][+-]?[0-9]+$"), STRDT(?newText, xsd:double),
         IF(?newText IN ("true", "false"), STRDT(?newText, xsd:boolean),
         ?newText))))))))) AS ?new)
    FILTER(?newText != "")
      BIND(IRI(CONCAT(STR(?row), "/~p-", SUBSTR(MD5(STR(?p)), 1, 12))) AS ?focus) }
  }
}""" ;
    sem:function "rdf-editor:commit-add" .

# Escape in a field: nothing changes; the focus goes back to its row.
c:RdfCancelEdit a beh:Reaction ;
    rdfs:label "Leave a field"@en ;
    beh:when c:RdfEditorEscapeKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row ?state ?v }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:commits|c:adds ?row . ?row c:inEditor $this ; ?state ?v . VALUES ?state { c:editing c:adding c:draft c:activeOption c:menuOpen } }""" ;
    beh:inserts """CONSTRUCT { ?row c:focused true }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:commits|c:adds ?row . ?row c:inEditor $this }""" ;
    sem:function "rdf-editor:cancel" .

# Delete on a row: its statement; a predicate's statements; a list member (the list closes up); a
# resource of the document, with all it says. The focus goes to the row it was in.
c:RdfDelete a beh:Reaction ;
    rdfs:label "Delete"@en ;
    beh:when c:RdfEditorDeleteKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?s ?p ?o . ?prev rdf:rest ?cell . ?cell rdf:first ?m ; rdf:rest ?next . ?holder ?hp ?cell . $this c:entry ?entry . ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfDelete } . ?row c:inEditor $this .
  LATERAL {
    { ?row a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o }
    UNION { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p . ?s ?p ?o }
    UNION { ?row a c:RdfTerm ; c:depth 0 ; c:term ?s . ?s ?p ?o }
    UNION { ?row a c:RdfTerm ; c:depth 0 ; c:term ?entry }
    UNION { ?row c:listCell ?cell . ?cell rdf:first ?m ; rdf:rest ?next .
      OPTIONAL { ?prev rdf:rest ?cell } OPTIONAL { FILTER(!BOUND(?prev)) ?holder ?hp ?cell } }
    UNION { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
  }
}""" ;
    beh:inserts """CONSTRUCT { ?prev rdf:rest ?next . ?holder ?hp ?next . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfDelete } . ?row c:inEditor $this .
  BIND(IRI(REPLACE(STR(?row), "/~[tpir]-[^/]*$", "")) AS ?up)
  BIND(IF(STRSTARTS(STR(?up), CONCAT(STR($this), "/~")), ?up, ?none) AS ?focus)
  OPTIONAL { ?row c:listCell ?cell . ?cell rdf:first ?m ; rdf:rest ?next .
    OPTIONAL { ?prev rdf:rest ?cell } OPTIONAL { FILTER(!BOUND(?prev)) ?holder ?hp ?cell } }
}""" ;
    sem:function "rdf-editor:delete" .

# --- reactions: what the shapes expect -------------------------------------------------------------------
# Typing in an adding field narrows the suggestions (c:draft, view state). A suggestion of a predicate
# alone puts it in the field, for the value to follow; one with its value (fixed or allowed by the
# shape, or an instance of its class) adds the whole statement at once: one undoable change.

c:RdfDraft a beh:Reaction ;
    rdfs:label "Narrow the suggestions"@en ;
    beh:when beh:Input ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row ?state ?old }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; ?state ?old . VALUES ?state { c:draft c:activeOption c:menuOpen } }""" ;
    beh:inserts """CONSTRUCT { ?row c:draft ?text }
WHERE { $event beh:node ?hit ; beh:value ?v . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this . BIND(STR(?v) AS ?text) }""" ;
    sem:function "rdf-editor:draft" .

c:RdfFillSuggestion a beh:Reaction ;
    rdfs:label "Take a suggested predicate"@en ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row c:draft ?old }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:fillsWith ?fill ; c:suggestsFor ?row . ?row c:inEditor $this ; c:draft ?old }""" ;
    beh:inserts """CONSTRUCT { ?row c:draft ?fill }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:fillsWith ?fill ; c:suggestsFor ?row . ?row c:inEditor $this }""" ;
    sem:function "rdf-editor:fill" .

c:RdfPickSuggestion a beh:Reaction ;
    rdfs:label "Add a suggested statement"@en ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:suggestsValue ?v ; c:suggestsFor ?row . ?row c:inEditor $this .
  ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~")))
}""" ;
    beh:inserts """CONSTRUCT { ?s ?p ?v . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:suggestsValue ?v ; c:suggestsFor ?row . ?row c:inEditor $this .
  LATERAL {
    { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p . BIND(?row AS ?focus) }
    UNION { ?row a c:RdfTerm ; c:term ?s . ?n c:suggestsPredicate ?p . BIND(IRI(CONCAT(STR(?row), "/~p-", SUBSTR(MD5(STR(?p)), 1, 12))) AS ?focus) }
  }
}""" ;
    sem:function "rdf-editor:pick" .

# --- reactions: structure (nest, outdent, move) ----------------------------------------------------------
# Tab wraps a value into a new nested resource as its rdf:value (a structured value: then say its
# unit, its source); Shift+Tab moves a statement of a nested resource up to the resource it belongs to
# (an rdf:value unwraps), and a nested resource left with nothing to say goes. Alt+Up and Alt+Down move
# a list member along its list. New nested resources are skolem IRIs under the editor
# (/.well-known/genid/), shown as [ ] like a blank node. Each is one undoable change; the focus
# follows the moved value.

c:RdfNest a beh:Reaction ;
    rdfs:label "Nest a value"@en ;
    beh:when c:RdfEditorNestKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?s ?p ?o . ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfNest } . ?row c:inEditor $this .
  LATERAL {
    { ?row a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o }
    UNION { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
  }
}""" ;
    beh:inserts """CONSTRUCT { ?s ?p ?nested . ?nested rdf:value ?o . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfNest } . ?row c:inEditor $this .
  ?row a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
  BIND(IF(isLiteral(?o), CONCAT("\\"", STR(?o), "\\"", IF(LANG(?o) != "", CONCAT("@", LANG(?o)), CONCAT("^^", STR(DATATYPE(?o))))), STR(?o)) AS ?okey)
  BIND(IRI(CONCAT(STR($this), "/.well-known/genid/", SUBSTR(MD5(CONCAT(STR(?s), " ", STR(?p), " ", ?okey)), 1, 16))) AS ?nested)
  BIND(IRI(CONCAT(REPLACE(STR(?row), "/~t-[0-9a-f]{12}$", ""), "/~t-", SUBSTR(MD5(STR(?nested)), 1, 12), "/~p-", SUBSTR(MD5(STR(rdf:value)), 1, 12), "/~t-", SUBSTR(MD5(?okey), 1, 12))) AS ?focus)
}""" ;
    sem:function "rdf-editor:nest" .

c:RdfOutdent a beh:Reaction ;
    rdfs:label "Outdent a statement"@en ;
    beh:when c:RdfEditorOutdentKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?s ?p ?o . ?gs ?gp ?gone . ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfOutdent } . ?row c:inEditor $this .
  ?row a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
  BIND(IRI(REPLACE(STR(?row), "/~p-[0-9a-f]{12}/~t-[0-9a-f]{12}$", "")) AS ?up)
  ?up c:subjectTerm ?gs ; c:predicateTerm ?gp ; c:term ?s .
  LATERAL {
    {}
    UNION { FILTER NOT EXISTS { ?s ?q ?x FILTER(!(sameTerm(?q, ?p) && sameTerm(?x, ?o))) } BIND(?s AS ?gone) }
    UNION { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
  }
}""" ;
    beh:inserts """CONSTRUCT { ?gs ?np ?o . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfOutdent } . ?row c:inEditor $this .
  ?row a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
  BIND(IRI(REPLACE(STR(?row), "/~p-[0-9a-f]{12}/~t-[0-9a-f]{12}$", "")) AS ?up)
  ?up c:subjectTerm ?gs ; c:predicateTerm ?gp ; c:term ?s .
  BIND(IF(sameTerm(?p, rdf:value), ?gp, ?p) AS ?np)
  # An rdf:value takes its resource's place (the resource stays while it says more).
  BIND(IF(isLiteral(?o), CONCAT("\\"", STR(?o), "\\"", IF(LANG(?o) != "", CONCAT("@", LANG(?o)), CONCAT("^^", STR(DATATYPE(?o))))), STR(?o)) AS ?okey)
  BIND(IRI(CONCAT(REPLACE(STR(?up), "/~p-[0-9a-f]{12}/~t-[0-9a-f]{12}$", ""), "/~p-", SUBSTR(MD5(STR(?np)), 1, 12), "/~t-", SUBSTR(MD5(?okey), 1, 12))) AS ?focus)
}""" ;
    sem:function "rdf-editor:outdent" .

c:RdfMoveMember a beh:Reaction ;
    rdfs:label "Move a list member"@en ;
    beh:when c:RdfEditorMoveKey ;
    beh:when beh:Click ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?cell rdf:first ?m . ?other rdf:first ?om . ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfMoveMember } . ?row c:inEditor $this .
  OPTIONAL { $event beh:key ?k0 } OPTIONAL { ?n c:asKey ?k1 } BIND(COALESCE(?k1, ?k0) AS ?key)
  ?row c:listCell ?cell . ?cell rdf:first ?m .
  OPTIONAL { ?prev rdf:rest ?cell . ?prev rdf:first ?pm }
  OPTIONAL { ?cell rdf:rest ?next . ?next rdf:first ?nm }
  BIND(IF(?key = "alt+arrowup", ?prev, ?next) AS ?other)
  BIND(IF(?key = "alt+arrowup", ?pm, ?nm) AS ?om)
  FILTER(BOUND(?other) && BOUND(?om))
  OPTIONAL { ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~"))) }
}""" ;
    beh:inserts """CONSTRUCT { ?cell rdf:first ?om . ?other rdf:first ?m . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . { ?n c:editsRow ?row FILTER NOT EXISTS { $event a beh:Click } } UNION { $event a beh:Click . ?n c:actsOn ?row ; c:does c:RdfMoveMember } . ?row c:inEditor $this .
  OPTIONAL { $event beh:key ?k0 } OPTIONAL { ?n c:asKey ?k1 } BIND(COALESCE(?k1, ?k0) AS ?key)
  ?row c:listCell ?cell ; c:listIndex ?i . ?cell rdf:first ?m .
  OPTIONAL { ?prev rdf:rest ?cell . ?prev rdf:first ?pm }
  OPTIONAL { ?cell rdf:rest ?next . ?next rdf:first ?nm }
  BIND(IF(?key = "alt+arrowup", ?prev, ?next) AS ?other)
  BIND(IF(?key = "alt+arrowup", ?pm, ?nm) AS ?om)
  FILTER(BOUND(?other) && BOUND(?om))
  BIND(IRI(CONCAT(REPLACE(STR(?row), "/~i-[0-9]+$", ""), "/~i-", STR(IF(?key = "alt+arrowup", ?i - 1, ?i + 1)))) AS ?focus)
}""" ;
    sem:function "rdf-editor:move-member" .

# A statement dropped on a predicate's row moves to that resource and predicate; dropped on a
# resource's row, to that resource, with its own predicate. One undoable change.
c:RdfDropStatement a beh:Reaction ;
    rdfs:label "Move a statement"@en ;
    beh:when dnd:Drop ;
    beh:sourceClass c:RdfDropRow ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?s ?p ?o }
WHERE {
  $event dnd:into $this ; dnd:carrying ?dragged .
  ?dragged a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
  { $this a c:RdfProperty ; c:subjectTerm ?ts ; c:predicateTerm ?np } UNION { $this a c:RdfTerm ; c:term ?ts . FILTER(!isLiteral(?ts)) ?dragged c:predicateTerm ?np }
  FILTER(!(sameTerm(?ts, ?s) && sameTerm(?np, ?p)))
}""" ;
    beh:inserts """CONSTRUCT { ?ts ?np ?o }
WHERE {
  $event dnd:into $this ; dnd:carrying ?dragged .
  ?dragged a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
  { $this a c:RdfProperty ; c:subjectTerm ?ts ; c:predicateTerm ?np } UNION { $this a c:RdfTerm ; c:term ?ts . FILTER(!isLiteral(?ts)) ?dragged c:predicateTerm ?np }
  FILTER(!(sameTerm(?ts, ?s) && sameTerm(?np, ?p)))
}""" ;
    sem:function "rdf-editor:drop" .

# A list member dropped on another member of its list takes that member's place; the members between
# move up or down one. One undoable change, the cells kept (only their rdf:first change).
c:RdfReorderMember a beh:Reaction ;
    rdfs:label "Reorder a list"@en ;
    beh:when dnd:Drop ;
    beh:sourceClass c:RdfDropRow ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?cell rdf:first ?v }
WHERE {
  $event dnd:into $this ; dnd:carrying ?dragged .
  ?dragged c:listCell ?from . $this c:listCell ?to .
  FILTER(!sameTerm(?from, ?to) && REPLACE(STR(?dragged), "/~i-[0-9]+$", "") = REPLACE(STR($this), "/~i-[0-9]+$", ""))
  LATERAL { { ?from rdf:rest+ ?to . ?from rdf:rest* ?cell . ?cell rdf:rest* ?to } UNION { ?to rdf:rest+ ?from . ?to rdf:rest* ?cell . ?cell rdf:rest* ?from } }
  ?cell rdf:first ?v .
}""" ;
    beh:inserts """CONSTRUCT { ?cell rdf:first ?nv . $this c:focused true }
WHERE {
  $event dnd:into $this ; dnd:carrying ?dragged .
  ?dragged c:listCell ?from . $this c:listCell ?to .
  FILTER(!sameTerm(?from, ?to) && REPLACE(STR(?dragged), "/~i-[0-9]+$", "") = REPLACE(STR($this), "/~i-[0-9]+$", ""))
  ?from rdf:first ?a .
  LATERAL {
    # Dragged down: each cell from it takes the next one's member; dragged up, the previous one's.
    { ?from rdf:rest+ ?to . ?from rdf:rest* ?cell . ?cell rdf:rest* ?to .
      OPTIONAL { FILTER(!sameTerm(?cell, ?to)) ?cell rdf:rest ?nx . ?nx rdf:first ?near } }
    UNION
    { ?to rdf:rest+ ?from . ?to rdf:rest* ?cell . ?cell rdf:rest* ?from .
      OPTIONAL { FILTER(!sameTerm(?cell, ?to)) ?pv rdf:rest ?cell . ?pv rdf:first ?near } }
  }
  BIND(IF(sameTerm(?cell, ?to), ?a, ?near) AS ?nv)
}""" ;
    sem:function "rdf-editor:reorder" .

# Down and Up in an adding field move the highlight through the suggestions (in their order; Up from
# the first leaves none); Enter takes the highlighted one, as a click would.
c:RdfMoveHighlight a beh:Reaction ;
    rdfs:label "Highlight a suggestion"@en ;
    beh:when c:RdfEditorChooseKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row c:activeOption ?old }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; c:activeOption ?old }""" ;
    beh:inserts """CONSTRUCT { ?row c:activeOption ?next }
WHERE {
  $event beh:node ?hit ; beh:key ?key . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this .
  OPTIONAL { ?row c:activeOption ?current . ?current sem:orderKey ?currentKey0 }
  BIND(STR(?currentKey0) AS ?currentKey)
  LATERAL { OPTIONAL { SELECT ?row (MIN(STR(?k1)) AS ?after) WHERE { ?o1 c:suggestsFor ?row ; sem:orderKey ?k1 . OPTIONAL { ?row c:activeOption ?c1 . ?c1 sem:orderKey ?ck1 } FILTER(!BOUND(?ck1) || STR(?k1) > STR(?ck1)) } GROUP BY ?row } }
  LATERAL { OPTIONAL { SELECT ?row (MAX(STR(?k2)) AS ?before) WHERE { ?o2 c:suggestsFor ?row ; sem:orderKey ?k2 . ?row c:activeOption ?c2 . ?c2 sem:orderKey ?ck2 FILTER(STR(?k2) < STR(?ck2)) } GROUP BY ?row } }
  BIND(IF(?key = "arrowdown", COALESCE(?after, ?currentKey), ?before) AS ?target)
  ?next c:suggestsFor ?row ; sem:orderKey ?nk . FILTER(STR(?nk) = ?target)
}""" ;
    sem:function "rdf-editor:highlight" .

c:RdfTakeHighlighted a beh:Reaction ;
    rdfs:label "Add the highlighted statement"@en ;
    beh:when c:RdfEditorKey ;
    beh:sourceClass c:RdfEditor ;
    beh:undoable true ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; c:activeOption ?option . ?option c:suggestsValue ?v .
  ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~")))
}""" ;
    beh:inserts """CONSTRUCT { ?s ?p ?v . ?focus c:focused true }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; c:activeOption ?option . ?option c:suggestsValue ?v .
  LATERAL {
    { ?row a c:RdfProperty ; c:subjectTerm ?s ; c:predicateTerm ?p . BIND(?row AS ?focus) }
    UNION { ?row a c:RdfTerm ; c:term ?s . ?option c:suggestsPredicate ?p . BIND(IRI(CONCAT(STR(?row), "/~p-", SUBSTR(MD5(STR(?p)), 1, 12))) AS ?focus) }
  }
}""" ;
    sem:function "rdf-editor:take" .

c:RdfTakeHighlightedPredicate a beh:Reaction ;
    rdfs:label "Take the highlighted predicate"@en ;
    beh:when c:RdfEditorKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row ?state ?old }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; c:activeOption ?option . ?option c:fillsWith ?fill . ?row ?state ?old . VALUES ?state { c:draft c:activeOption c:menuOpen } }""" ;
    beh:inserts """CONSTRUCT { ?row c:draft ?fill }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:adds ?row . ?row c:inEditor $this ; c:activeOption ?option . ?option c:fillsWith ?fill }""" ;
    sem:function "rdf-editor:take-predicate" .

# Typing a character on a row starts editing it with that character, as a spreadsheet does: a value
# or a predicate is replaced by what is typed; on a resource (or a nested one), a new statement starts.
# (Space is the drag layer's: it lifts the row.)
c:RdfTypeToEdit a beh:Reaction ;
    rdfs:label "Start editing by typing"@en ;
    beh:when c:RdfEditorTypeKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit ; beh:text ?ch . FILTER(?ch != " ") ?n rdfhtml:hasChild* ?hit . ?n c:editsRow ?row . ?row c:inEditor $this .
  ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~")))
}""" ;
    beh:inserts """CONSTRUCT { ?row ?state true ; c:draft ?ch }
WHERE {
  $event beh:node ?hit ; beh:text ?ch . FILTER(?ch != " ") ?n rdfhtml:hasChild* ?hit . ?n c:editsRow ?row . ?row c:inEditor $this .
  BIND(EXISTS { ?row a c:RdfProperty } || EXISTS { ?row c:subjectTerm ?anyS } || EXISTS { ?row c:listCell ?anyCell } AS ?value)
  BIND(IF(?value, c:editing, c:adding) AS ?state)
}""" ;
    sem:function "rdf-editor:type" .

# --- hard validation: a drop that would not conform is refused --------------------------------------------------
# While a statement is dragged, each row it is offered to (dnd:offered) objects (dnd:Objection) when
# the value would break a constraint of the shapes of the target resource on the target predicate:
# its datatype, class, node kind, allowed values, maximum count, pattern or length. The drag layer
# then refuses it there, with the shape's message (or a plain reason), and says so.
c:RdfDropObjections a sem:Rendering ;
    sem:targets c:RdfDropRow ;
    sem:modality mod:Screen ;
    sem:stratum 5 ;
    sem:requires dnd:offered ;
    sem:follows dnd:offered ;
    sem:watches dnd:offered , dnd:carrying .
c:RdfDropObjections-fn a sem:Rule ; sem:implements c:RdfDropObjections ; sem:function "rdf-editor:objections" .
c:RdfDropObjections-sparql a sem:Rule ;
    sem:implements c:RdfDropObjections ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT { ?objection a dnd:Objection ; dnd:receptacle $this ; dnd:against ?drag ; dnd:reason ?reason . }
WHERE {
  { SELECT ?drag (MIN(?why) AS ?reason) WHERE { {
    $this dnd:offered ?drag . ?drag dnd:carrying ?dragged .
    ?dragged a c:RdfTerm ; c:subjectTerm ?s ; c:predicateTerm ?p ; c:term ?o .
    { $this a c:RdfProperty ; c:subjectTerm ?ts ; c:predicateTerm ?np } UNION { $this a c:RdfTerm ; c:term ?ts . FILTER(!isLiteral(?ts)) ?dragged c:predicateTerm ?np }
    FILTER(!(sameTerm(?ts, ?s) && sameTerm(?np, ?p)) && NOT EXISTS { $this c:listCell ?anyCell })
    ?ts a ?ty . ?ty rdfs:subClassOf* ?cl . ?shape sh:targetClass ?cl ; sh:property ?ps . ?ps sh:path ?np ; ?constraint ?param .
    FILTER(?constraint IN (sh:datatype, sh:class, sh:nodeKind, sh:in, sh:maxCount, sh:pattern, sh:minLength, sh:maxLength))
    LATERAL { OPTIONAL { SELECT ?ts ?np (COUNT(?held) AS ?count) WHERE { ?ts ?np ?held } GROUP BY ?ts ?np } }
    FILTER(IF(?constraint = sh:datatype, !(isLiteral(?o) && sameTerm(DATATYPE(?o), ?param)),
           IF(?constraint = sh:class, NOT EXISTS { ?o a/rdfs:subClassOf* ?param },
           IF(?constraint = sh:nodeKind, (sameTerm(?param, sh:IRI) && !isIRI(?o)) || (sameTerm(?param, sh:Literal) && !isLiteral(?o)),
           IF(?constraint = sh:in, NOT EXISTS { ?param rdf:rest*/rdf:first ?o },
           IF(?constraint = sh:maxCount, NOT EXISTS { ?ts ?np ?o } && COALESCE(?count, 0) + 1 > xsd:integer(STR(?param)),
           IF(?constraint = sh:pattern, !REGEX(STR(?o), STR(?param)),
           IF(?constraint = sh:minLength, STRLEN(STR(?o)) < xsd:integer(STR(?param)),
              STRLEN(STR(?o)) > xsd:integer(STR(?param))))))))))
    OPTIONAL { ?ps sh:message ?said FILTER(lang(?said) = "") }
    OPTIONAL { ?ps sh:message ?saidEn FILTER(langMatches(lang(?saidEn), "en")) }
    BIND(REPLACE(STR(?np), "^.*[#/]", "") AS ?name)
    BIND(IF(?constraint = sh:datatype, CONCAT("expected ", REPLACE(STR(?param), "^.*[#/]", "")),
         IF(?constraint = sh:class, CONCAT("expected a ", REPLACE(STR(?param), "^.*[#/]", "")),
         IF(?constraint = sh:nodeKind, IF(sameTerm(?param, sh:IRI), "expected an IRI", "expected a literal"),
         IF(?constraint = sh:in, "not an allowed value",
         IF(?constraint = sh:maxCount, CONCAT("at most ", STR(?param), " values"),
         IF(?constraint = sh:pattern, "does not match the expected format",
         IF(?constraint = sh:minLength, CONCAT("at least ", STR(?param), " characters"), CONCAT("at most ", STR(?param), " characters")))))))) AS ?fallback)
    BIND(STR(COALESCE(?said, ?saidEn, CONCAT(?name, ": ", ?fallback))) AS ?why)
  } UNION {
    # A list member goes only to another member's place in the same list, and only a member goes there.
    $this dnd:offered ?drag . ?drag dnd:carrying ?dragged . ?dragged a c:RdfTerm .
    OPTIONAL { $this c:listCell ?tc } OPTIONAL { ?dragged c:listCell ?dc }
    FILTER((BOUND(?tc) || BOUND(?dc)) && !(BOUND(?tc) && BOUND(?dc) && REPLACE(STR(?dragged), "/~i-[0-9]+$", "") = REPLACE(STR($this), "/~i-[0-9]+$", "")))
    BIND(IF(BOUND(?dc), "a list member moves within its list", "only this list's members go here") AS ?why)
  } } GROUP BY ?drag }
  BIND(IRI(CONCAT(STR($this), "/~objection")) AS ?objection)
}""" .

# --- the row menu ------------------------------------------------------------------------------------------
# A right click, Shift+F10 or the Menu key opens a row's menu (c:menuOpen, view state): what can be done
# there, each with its key. Its items do the editor's own reactions (c:does, answering the click)
# on the row (c:actsOn); following a link is the link's own. Escape or a click elsewhere closes it, and
# choosing an item closes it too.
c:RdfOpenMenu a beh:Reaction ;
    rdfs:label "Open a row's menu"@en ;
    beh:when c:RdfEditorContextMenu , c:RdfEditorMenuKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?marked ?markP ?mark }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:rowOf ?row . ?row c:inEditor $this .
  ?marked ?markP ?mark . VALUES ?markP { c:editing c:adding c:focused c:draft c:activeOption c:menuOpen } FILTER(STRSTARTS(STR(?marked), CONCAT(STR($this), "/~")))
}""" ;
    beh:inserts """CONSTRUCT { ?row c:menuOpen true }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:rowOf ?row . ?row c:inEditor $this }""" ;
    sem:function "rdf-editor:open-menu" .
c:RdfCloseMenu a beh:Reaction ;
    rdfs:label "Close a row's menu"@en ;
    beh:when beh:Click , c:RdfMenuEscapeKey ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { ?row c:menuOpen ?open }
WHERE { ?row c:menuOpen ?open ; c:inEditor $this }""" ;
    beh:inserts """CONSTRUCT { ?row c:focused true }
WHERE { $event a c:RdfMenuEscapeKey . ?row c:menuOpen ?open ; c:inEditor $this }""" ;
    sem:function "rdf-editor:close-menu" .

# The status line under the tree: the mode (viewing, editing, adding), where the focus is (its
# resource, predicate and value), and the keys that apply now. The focus is the editor's view state
# (c:cursor, c:cursorMode), kept by a reaction on focus: moving with the arrow keys changes the
# line and nothing else.
c:RdfEditorStatus a sem:Rendering ;
    sem:targets c:RdfEditor ;
    sem:modality mod:Screen ;
    sem:stratum 0 ;
    sem:follows c:cursor ;
    sem:watches rdf:type , c:cursor , c:cursorMode , c:editable , c:subjectTerm , c:predicateTerm , c:term .
c:RdfEditorStatus-fn a sem:Rule ; sem:implements c:RdfEditorStatus ; sem:function "rdf-editor:status" .
c:RdfEditorStatus-sparql a sem:Rule ;
    sem:implements c:RdfEditorStatus ;
    sem:construct """
CONSTRUCT {
  ?root rdfhtml:hasChild ?status . ?arrows ord:immediatelyPrecedes ?status .
  ?status a rdfhtml:Div ; rdfhtml:class "sem-status" ; rdfhtml:hasChild ?mode , ?where , ?keys .
  ?mode a rdfhtml:Span ; rdfhtml:class ?modeClass ; rdfhtml:hasChild ?modeText ; ord:immediatelyPrecedes ?beside .
  ?modeText a rdfhtml:Text ; rdfhtml:data ?modeLabel .
  ?where a rdfhtml:Span ; rdfhtml:class "sem-where" ; rdfhtml:hasChild ?whereText ; ord:immediatelyPrecedes ?keys .
  ?whereText a rdfhtml:Text ; rdfhtml:data ?path .
  ?keys a rdfhtml:Span ; rdfhtml:class "sem-keys" ; rdfhtml:hasChild ?key .
  ?key a rdfhtml:Span ; rdfhtml:class "sem-key" ; sem:orderKey ?keyN ; rdfhtml:hasChild ?kbd , ?keyText .
  ?kbd a rdfhtml:Kbd ; rdfhtml:hasChild ?kbdText ; ord:immediatelyPrecedes ?keyText .
  ?kbdText a rdfhtml:Text ; rdfhtml:data ?keySym .
  ?keyText a rdfhtml:Text ; rdfhtml:data ?keyLabel .
}
WHERE {
  $this a/rdfs:subClassOf* c:RdfEditor .
  OPTIONAL { $this c:cursorMode ?mode0 }
  BIND(COALESCE(STR(?mode0), "viewing") AS ?modeName)
  BIND(EXISTS { $this c:editable true } AS ?editable)
  BIND(IF(?modeName = "editing", c:RdfModeEditingPhrase, IF(?modeName = "adding", c:RdfModeAddingPhrase, c:RdfModeViewingPhrase)) AS ?modePhrase)
  OPTIONAL { ?modeAt l10n:of ?modePhrase ; l10n:name ?mode1 }
  OPTIONAL { ?modePhrase rdfs:label ?mode1 FILTER(langMatches(lang(?mode1), "en")) }
  BIND(STR(?mode1) AS ?modeLabel)
  BIND(CONCAT("sem-mode sem-mode-", ?modeName) AS ?modeClass)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~arrows")) AS ?arrows)
  BIND(IRI(CONCAT(STR($this), "/~status")) AS ?status)
  BIND(IRI(CONCAT(STR($this), "/~status-mode")) AS ?mode)
  BIND(IRI(CONCAT(STR($this), "/~status-mode-text")) AS ?modeText)
  BIND(IRI(CONCAT(STR($this), "/~status-keys")) AS ?keys)
  # Where the focus is: the row's resource, predicate and value.
  OPTIONAL { $this c:cursor ?cur . OPTIONAL { ?cur c:subjectTerm ?ws } OPTIONAL { ?cur c:predicateTerm ?wp } OPTIONAL { ?cur c:term ?wt } }
  BIND(COALESCE(REPLACE(STR(?ws), "[^#/]*$", ""), "-~") AS ?wsNs)
  BIND(REPLACE(STR(?ws), "^.*[#/]", "") AS ?wsLocal)
  OPTIONAL { { SELECT ?wsNs (MIN(?wsP0) AS ?wsPfx) WHERE { ?wsD sh:prefix ?wsP0 ; sh:namespace ?wsN0 BIND(STR(?wsN0) AS ?wsNs) } GROUP BY ?wsNs } }
  BIND(IF(!BOUND(?ws), ?none, IF(isBlank(?ws) || (isIRI(?ws) && CONTAINS(STR(?ws), "/.well-known/genid/")), "[ ]",
       IF(isLiteral(?ws), CONCAT("\\"", IF(STRLEN(STR(?ws)) > 32, CONCAT(SUBSTR(STR(?ws), 1, 31), "…"), STR(?ws)), "\\""),
       IF(BOUND(?wsPfx) && REGEX(?wsLocal, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?wsPfx, ":", ?wsLocal), CONCAT("<", STR(?ws), ">"))))) AS ?wsShort)
  BIND(COALESCE(REPLACE(STR(?wp), "[^#/]*$", ""), "-~") AS ?wpNs)
  BIND(REPLACE(STR(?wp), "^.*[#/]", "") AS ?wpLocal)
  OPTIONAL { { SELECT ?wpNs (MIN(?wpP0) AS ?wpPfx) WHERE { ?wpD sh:prefix ?wpP0 ; sh:namespace ?wpN0 BIND(STR(?wpN0) AS ?wpNs) } GROUP BY ?wpNs } }
  BIND(IF(!BOUND(?wp), ?none, IF(isBlank(?wp) || (isIRI(?wp) && CONTAINS(STR(?wp), "/.well-known/genid/")), "[ ]",
       IF(isLiteral(?wp), CONCAT("\\"", IF(STRLEN(STR(?wp)) > 32, CONCAT(SUBSTR(STR(?wp), 1, 31), "…"), STR(?wp)), "\\""),
       IF(BOUND(?wpPfx) && REGEX(?wpLocal, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?wpPfx, ":", ?wpLocal), CONCAT("<", STR(?wp), ">"))))) AS ?wpShort)
  BIND(COALESCE(REPLACE(STR(?wt), "[^#/]*$", ""), "-~") AS ?wtNs)
  BIND(REPLACE(STR(?wt), "^.*[#/]", "") AS ?wtLocal)
  OPTIONAL { { SELECT ?wtNs (MIN(?wtP0) AS ?wtPfx) WHERE { ?wtD sh:prefix ?wtP0 ; sh:namespace ?wtN0 BIND(STR(?wtN0) AS ?wtNs) } GROUP BY ?wtNs } }
  BIND(IF(!BOUND(?wt), ?none, IF(isBlank(?wt) || (isIRI(?wt) && CONTAINS(STR(?wt), "/.well-known/genid/")), "[ ]",
       IF(isLiteral(?wt), CONCAT("\\"", IF(STRLEN(STR(?wt)) > 32, CONCAT(SUBSTR(STR(?wt), 1, 31), "…"), STR(?wt)), "\\""),
       IF(BOUND(?wtPfx) && REGEX(?wtLocal, "^[A-Za-z_][A-Za-z0-9_-]*$"), CONCAT(?wtPfx, ":", ?wtLocal), CONCAT("<", STR(?wt), ">"))))) AS ?wtShort)
  BIND(IF(BOUND(?wp) && sameTerm(?wp, rdf:type), "a", ?wpShort) AS ?wpText)
  BIND(IF(!BOUND(?cur), ?none, IF(BOUND(?ws), CONCAT(?wsShort, " › ", ?wpText, IF(BOUND(?wt), CONCAT(" › ", ?wtShort), "")), ?wtShort)) AS ?path)
  BIND(IF(BOUND(?path), IRI(CONCAT(STR($this), "/~status-where")), ?none) AS ?where)
  BIND(COALESCE(?where, ?keys) AS ?beside)
  BIND(IF(BOUND(?path), IRI(CONCAT(STR($this), "/~status-where-text")), ?none) AS ?whereText)
  # The keys that apply now.
  LATERAL { {} UNION {
    VALUES (?keyMode ?keyN ?keySym ?keyPhrase) {
      ("edit" 1 "↵" c:RdfKeyEditPhrase) ("edit" 2 "⇧↵" c:RdfKeyAddPhrase) ("edit" 3 "⌫" c:RdfKeyDeletePhrase) ("edit" 4 "⇥" c:RdfKeyNestPhrase)
      ("edit" 5 "⌥↑↓" c:RdfKeyMovePhrase) ("edit" 6 "⇧F10" c:RdfKeyMenuPhrase)
      ("view" 1 "↵" c:RdfKeyFollowPhrase) ("view" 2 "← →" c:RdfKeyOpenPhrase) ("view" 3 "⇧F10" c:RdfKeyMenuPhrase)
      ("editing" 1 "↵" c:RdfKeySavePhrase) ("editing" 2 "Esc" c:RdfKeyCancelPhrase)
      ("adding" 1 "↑↓" c:RdfKeyChoosePhrase) ("adding" 2 "↵" c:RdfKeyAddPhrase) ("adding" 3 "Esc" c:RdfKeyClosePhrase)
    }
    FILTER(?keyMode = IF(?modeName = "viewing", IF(?editable, "edit", "view"), ?modeName))
    OPTIONAL { ?keyAt l10n:of ?keyPhrase ; l10n:name ?key0 }
    OPTIONAL { ?keyPhrase rdfs:label ?key0 FILTER(langMatches(lang(?key0), "en")) }
    BIND(STR(?key0) AS ?keyLabel)
    BIND(CONCAT(STR($this), "/~status-key-", STR(?keyN)) AS ?keyLocal)
    BIND(IRI(?keyLocal) AS ?key)
    BIND(IRI(CONCAT(?keyLocal, "-kbd")) AS ?kbd)
    BIND(IRI(CONCAT(?keyLocal, "-kbd-text")) AS ?kbdText)
    BIND(IRI(CONCAT(?keyLocal, "-text")) AS ?keyText)
  } }
}""" .

c:RdfTrackCursor a beh:Reaction ;
    rdfs:label "Keep where the focus is"@en ;
    beh:when beh:Focus ;
    beh:sourceClass c:RdfEditor ;
    beh:deletes """CONSTRUCT { $this ?state ?old }
WHERE {
  $this ?state ?old . VALUES ?state { c:cursor c:cursorMode }
  FILTER EXISTS { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:commits|c:adds|c:rowOf ?row . ?row c:inEditor $this }
}""" ;
    beh:inserts """CONSTRUCT { $this c:cursor ?row ; c:cursorMode ?mode }
WHERE {
  $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit .
  LATERAL {
    { ?n c:commits ?row . BIND("editing" AS ?mode) }
    UNION { ?n c:adds ?row . BIND("adding" AS ?mode) }
    UNION { ?n c:rowOf ?row . FILTER NOT EXISTS { ?hit c:commits|c:adds ?field } BIND("viewing" AS ?mode) }
  }
}""" ;
    sem:function "rdf-editor:cursor" .
