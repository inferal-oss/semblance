@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix rdfhtml: <https://ia2.dev/spec/rdf-html#> .
@prefix ord: <https://ontology.inferal.com/modules/ordering/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

c:LinkCard a owl:Class ; rdfs:subClassOf sem:Component ; sem:slug "link-card" ;
  rdfs:label "Link card"@en, "Картка-посилання"@uk, "Linkkarte"@de, "بطاقة رابط"@ar ;
  rdfs:comment "A whole-card link with a title, optional note, and optional badge."@en,
    "Посилання на всю картку із заголовком, необов’язковою приміткою та позначкою."@uk,
    "Ein Link für die gesamte Karte mit Titel, optionaler Notiz und optionalem Abzeichen."@de,
    "رابط يشمل البطاقة كلها مع عنوان وملاحظة وشارة اختياريتين."@ar .
c:currentPage a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
  rdfs:label "Current page"@en, "Поточна сторінка"@uk, "Aktuelle Seite"@de, "الصفحة الحالية"@ar ;
  rdfs:comment "Whether a navigation card represents the current page."@en .
c:LinkCardRendering a sem:Rendering ; sem:targets c:LinkCard ; sem:stratum 0 .
c:LinkCardTexts a sem:Rendering ; sem:targets c:LinkCard ; sem:modality mod:Screen ;
  sem:stratum -20 ; sem:inputOnly true ;
  sem:functionOnly "The viewer's language is a projection setting, so the hint needs an input rule." .
c:LinkCardTexts-fn a sem:Rule ; sem:implements c:LinkCardTexts ; sem:function "l10n:link-hint" .

c:LinkCardScreen a sem:Rule ; sem:implements c:LinkCardRendering ; sem:modality mod:Screen ;
  sem:readsMinted true ;
  sem:construct """
CONSTRUCT {
  ?root a rdfhtml:A ; sem:renders $this ; rdfhtml:href ?href ; rdfhtml:attribute ?currentAttr ;
    rdfhtml:target ?target ; rdfhtml:rel ?rel ;
    rdfhtml:hasChild ?title, ?note, ?badge, ?hint .
  ?title a rdfhtml:Strong ; rdfhtml:hasChild ?titleText ; ord:precedes ?note, ?badge, ?hint .
  ?titleText a rdfhtml:Text ; rdfhtml:data ?label .
  ?note a rdfhtml:Span ; rdfhtml:class "sem-link-card-note" ;
    rdfhtml:hasChild ?noteText ; ord:precedes ?badge, ?hint .
  ?noteText a rdfhtml:Text ; rdfhtml:data ?noteValue .
  ?badge a rdfhtml:Span ; rdfhtml:class "sem-link-card-badge" ;
    rdfhtml:hasChild ?badgeText ; ord:precedes ?hint .
  ?badgeText a rdfhtml:Text ; rdfhtml:data ?badgeValue .
  ?hint a rdfhtml:Span ; rdfhtml:class "sem-link-card-sr" ; rdfhtml:hasChild ?hintText .
  ?hintText a rdfhtml:Text ; rdfhtml:data ?hintData .
  ?currentAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-current" ; rdfhtml:attributeValue "page" .
}
WHERE {
  $this a c:LinkCard ; c:href ?href .
  FILTER(REGEX(STR(?href), "^(https?://|mailto:|tel:|[/#?]|[A-Za-z0-9._~%-]+([/?#]|$))", "i"))
  OPTIONAL { $this l10n:label ?localLabel }
  OPTIONAL { $this c:label ?label0_u FILTER(isLiteral(?label0_u) && lang(?label0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?label0_u)) $this c:label ?label0_en FILTER(langMatches(lang(?label0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?label0_u) && !BOUND(?label0_en)) $this c:label ?label0_any FILTER(isLiteral(?label0_any)) }
  BIND(STR(COALESCE(?localLabel, ?label0_u, ?label0_en, ?label0_any)) AS ?label)
  OPTIONAL { $this c:note ?note0_u FILTER(isLiteral(?note0_u) && lang(?note0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?note0_u)) $this c:note ?note0_en FILTER(langMatches(lang(?note0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?note0_u) && !BOUND(?note0_en)) $this c:note ?note0_any FILTER(isLiteral(?note0_any)) }
  BIND(STR(COALESCE(?note0_u, ?note0_en, ?note0_any)) AS ?noteValue)
  OPTIONAL { $this c:badge ?badge0_u FILTER(isLiteral(?badge0_u) && lang(?badge0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?badge0_u)) $this c:badge ?badge0_en FILTER(langMatches(lang(?badge0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?badge0_u) && !BOUND(?badge0_en)) $this c:badge ?badge0_any FILTER(isLiteral(?badge0_any)) }
  BIND(STR(COALESCE(?badge0_u, ?badge0_en, ?badge0_any)) AS ?badgeValue)
  OPTIONAL { $this c:external ?explicitExternal }
  OPTIONAL { $this c:currentPage ?isCurrent }
  BIND(IF(BOUND(?explicitExternal), STR(?explicitExternal) = "true", REGEX(STR(?href), "^(https?://|//)", "i")) AS ?external)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IF(BOUND(?isCurrent) && STR(?isCurrent) = "true", IRI(CONCAT(STR($this), "/~aria-current")), ?none) AS ?currentAttr)
  BIND(IRI(CONCAT(STR($this), "/~title")) AS ?title)
  BIND(IRI(CONCAT(STR($this), "/~title-text")) AS ?titleText)
  BIND(IF(BOUND(?noteValue), IRI(CONCAT(STR($this), "/~note")), ?none) AS ?note)
  BIND(IF(BOUND(?noteValue), IRI(CONCAT(STR($this), "/~note-text")), ?none) AS ?noteText)
  BIND(IF(BOUND(?badgeValue), IRI(CONCAT(STR($this), "/~badge")), ?none) AS ?badge)
  BIND(IF(BOUND(?badgeValue), IRI(CONCAT(STR($this), "/~badge-text")), ?none) AS ?badgeText)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~hint")), ?none) AS ?hint)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~hint-text")), ?none) AS ?hintText)
  BIND(IF(?external, "_blank", ?none) AS ?target)
  BIND(IF(?external, "noopener noreferrer", ?none) AS ?rel)
  BIND(IRI(CONCAT(STR($this), "/~l10n-hint")) AS ?hintNode)
  LATERAL { OPTIONAL { ?hintNode l10n:label ?localHint } }
  BIND(COALESCE(?localHint, "opens in a new tab") AS ?hintData)
}""" .

c:LinkCardText a sem:Rule ; sem:implements c:LinkCardRendering ; sem:modality mod:Text ;
  sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?text .
  ?text a rdfhtml:Text ; rdfhtml:data ?line .
}
WHERE {
  $this a c:LinkCard ; c:href ?href .
  FILTER(REGEX(STR(?href), "^(https?://|mailto:|tel:|[/#?]|[A-Za-z0-9._~%-]+([/?#]|$))", "i"))
  OPTIONAL { $this c:label ?label0_u FILTER(isLiteral(?label0_u) && lang(?label0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?label0_u)) $this c:label ?label0_en FILTER(langMatches(lang(?label0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?label0_u) && !BOUND(?label0_en)) $this c:label ?label0_any FILTER(isLiteral(?label0_any)) }
  BIND(STR(COALESCE(?label0_u, ?label0_en, ?label0_any)) AS ?label)
  OPTIONAL { $this c:note ?note0_u FILTER(isLiteral(?note0_u) && lang(?note0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?note0_u)) $this c:note ?note0_en FILTER(langMatches(lang(?note0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?note0_u) && !BOUND(?note0_en)) $this c:note ?note0_any FILTER(isLiteral(?note0_any)) }
  BIND(STR(COALESCE(?note0_u, ?note0_en, ?note0_any)) AS ?note)
  OPTIONAL { $this c:badge ?badge0_u FILTER(isLiteral(?badge0_u) && lang(?badge0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?badge0_u)) $this c:badge ?badge0_en FILTER(langMatches(lang(?badge0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?badge0_u) && !BOUND(?badge0_en)) $this c:badge ?badge0_any FILTER(isLiteral(?badge0_any)) }
  BIND(STR(COALESCE(?badge0_u, ?badge0_en, ?badge0_any)) AS ?badge)
  BIND(CONCAT(STR(?label), IF(BOUND(?badge), CONCAT(" [", STR(?badge), "]"), ""),
    IF(BOUND(?note), CONCAT(" — ", STR(?note)), ""), " (", STR(?href), ")") AS ?line)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~text")) AS ?text)
}""" .
