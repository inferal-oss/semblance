@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

c:LinkCard a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:label "Link card"@en ;
    rdfs:comment "A whole-card link with a title (c:label), optional description (c:note), and optional short badge (c:badge). It follows c:href and can mark the current page with c:currentPage."@en ;
    sem:slug "link-card" .

c:currentPage a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "Current page"@en ;
    rdfs:comment "Marks a navigation link as the current page for assistive technology and visual styling."@en .

c:LinkCardRendering a sem:Rendering ; sem:targets c:LinkCard ; sem:stratum 0 .
c:LinkCardRendering-fn a sem:Rule ; sem:implements c:LinkCardRendering ; sem:function "link-card" .
c:LinkCardRendering-sparql-screen a sem:Rule ;
    sem:implements c:LinkCardRendering ; sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:A ; sem:renders $this ; rdfhtml:href ?href ; rdfhtml:target ?target ; rdfhtml:rel ?rel ;
        rdfhtml:hasChild ?copy, ?badge ; rdfhtml:attribute ?currentAttr .
  ?copy a rdfhtml:Span ; rdfhtml:class "sem-link-card-copy" ; rdfhtml:hasChild ?title, ?note ;
        ord:immediatelyPrecedes ?badge .
  ?title a rdfhtml:Strong ; rdfhtml:hasChild ?titleText, ?externalMark, ?externalHint ; ord:immediatelyPrecedes ?note .
  ?titleText a rdfhtml:Text ; rdfhtml:data ?label ; ord:immediatelyPrecedes ?externalMark .
  ?externalMark a rdfhtml:Span ; rdfhtml:class "sem-link-card-external" ; rdfhtml:hasChild ?externalMarkText ;
                rdfhtml:attribute ?markHidden ; ord:immediatelyPrecedes ?externalHint .
  ?externalMarkText a rdfhtml:Text ; rdfhtml:data "↗" .
  ?markHidden a rdfhtml:Attribute ; rdfhtml:attributeName "aria-hidden" ; rdfhtml:attributeValue "true" .
  ?externalHint a rdfhtml:Span ; rdfhtml:class "sem-sr" ; rdfhtml:hasChild ?externalHintText .
  ?externalHintText a rdfhtml:Text ; rdfhtml:data ?hintData .
  ?note a rdfhtml:Span ; rdfhtml:class "sem-link-card-note" ; rdfhtml:hasChild ?noteText .
  ?noteText a rdfhtml:Text ; rdfhtml:data ?noteValue .
  ?badge a rdfhtml:Span ; rdfhtml:class "sem-link-card-badge" ; rdfhtml:hasChild ?badgeText .
  ?badgeText a rdfhtml:Text ; rdfhtml:data ?badgeValue .
  ?currentAttr a rdfhtml:Attribute ; rdfhtml:attributeName "aria-current" ; rdfhtml:attributeValue "page" .
}
WHERE {
  $this a c:LinkCard ; c:href ?href0 ; c:label ?rawLabel .
  BIND(STR(?href0) AS ?href)
  OPTIONAL { $this l10n:label ?localLabel }
  BIND(STR(COALESCE(?localLabel, ?rawLabel)) AS ?label)
  OPTIONAL { $this c:note ?rawNote }
  OPTIONAL { $this c:badge ?rawBadge }
  OPTIONAL { $this c:external ?external0 }
  BIND(IF(BOUND(?external0), STR(?external0) = "true", REGEX(?href, "^https?://", "i")) AS ?external)
  BIND(IF(?external, "_blank", ?none) AS ?target)
  BIND(IF(?external, "noopener noreferrer", ?none) AS ?rel)
  OPTIONAL { c:Link c:externalHint ?hint0_u FILTER(isLiteral(?hint0_u) && lang(?hint0_u) = "") }
  OPTIONAL { FILTER(!BOUND(?hint0_u)) c:Link c:externalHint ?hint0_en FILTER(langMatches(lang(?hint0_en), "en")) }
  OPTIONAL { FILTER(!BOUND(?hint0_u) && !BOUND(?hint0_en)) c:Link c:externalHint ?hint0_any FILTER(isLiteral(?hint0_any)) }
  BIND(STR(COALESCE(?hint0_u, ?hint0_en, ?hint0_any)) AS ?hint0)
  BIND(IRI(CONCAT(STR($this), "/~external-hint")) AS ?hintNode)
  LATERAL { OPTIONAL { ?hintNode l10n:label ?localHint } }
  BIND(CONCAT(" (", COALESCE(?localHint, ?hint0, "opens in a new tab"), ")") AS ?hintData)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~copy")) AS ?copy)
  BIND(IRI(CONCAT(STR($this), "/~title")) AS ?title)
  BIND(IRI(CONCAT(STR($this), "/~title-text")) AS ?titleText)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~external-mark")), ?none) AS ?externalMark)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~external-mark-text")), ?none) AS ?externalMarkText)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~external-mark-hidden")), ?none) AS ?markHidden)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~external-hint")), ?none) AS ?externalHint)
  BIND(IF(?external, IRI(CONCAT(STR($this), "/~external-hint-text")), ?none) AS ?externalHintText)
  BIND(IF(BOUND(?rawNote), IRI(CONCAT(STR($this), "/~note")), ?none) AS ?note)
  BIND(IF(BOUND(?rawNote), IRI(CONCAT(STR($this), "/~note-text")), ?none) AS ?noteText)
  BIND(STR(?rawNote) AS ?noteValue)
  BIND(IF(BOUND(?rawBadge), IRI(CONCAT(STR($this), "/~badge")), ?none) AS ?badge)
  BIND(IF(BOUND(?rawBadge), IRI(CONCAT(STR($this), "/~badge-text")), ?none) AS ?badgeText)
  BIND(STR(?rawBadge) AS ?badgeValue)
  BIND(IF(EXISTS { $this c:currentPage true }, IRI(CONCAT(STR($this), "/~current")), ?none) AS ?currentAttr)
}""" .

c:LinkCardRendering-sparql-text a sem:Rule ;
    sem:implements c:LinkCardRendering ; sem:modality mod:Text ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?text .
  ?text a rdfhtml:Text ; rdfhtml:data ?line .
}
WHERE {
  $this a c:LinkCard ; c:href ?href ; c:label ?label .
  OPTIONAL { $this c:note ?note }
  OPTIONAL { $this c:badge ?badge }
  BIND(CONCAT(STR(?label), IF(BOUND(?note), CONCAT(" — ", STR(?note)), ""),
              IF(BOUND(?badge), CONCAT(" [", STR(?badge), "]"), ""), " <", STR(?href), ">") AS ?line)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~text")) AS ?text)
}""" .
