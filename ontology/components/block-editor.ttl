# --- a block's handle and its menu --------------------------------------------------------------------------
# A click on a block's handle, or Enter on it, opens its menu (c:handleMenuBlock), or closes it; Escape closes it
# and the focus goes back to the handle (c:handleMenuReturn); the caret moving closes it. Its items turn the block
# into another type (raising the conversion), duplicate it (also Mod+D, on the caret's block) or delete it.

c:BlockHandleKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "enter" ;
    rdfs:comment "Enter on a block's handle: opens its menu."@en .
c:BlockHandleMenuKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "escape" ;
    rdfs:comment "Escape while a block's handle menu is open: closes it."@en .
c:BlockDuplicateKey a owl:Class ; rdfs:subClassOf beh:Event ; beh:domEvent "keydown" ; beh:key "mod+d" ;
    rdfs:comment "Mod+D in a block editor: duplicates the caret's block."@en .

c:OpenHandleMenu a beh:Reaction ;
    rdfs:label "Open a block's menu"@en ;
    rdfs:comment """A click on a block's handle, or Enter on it: its menu opens (or, open, closes, the focus staying on the handle)."""@en ;
    beh:when beh:Click , c:BlockHandleKey ;
    beh:sourceClass c:BlockEditor ;
    beh:deletes """CONSTRUCT { $this c:handleMenuBlock ?open ; c:handleMenuReturn ?ret . $this c:menuBlock ?sb ; c:menuFrom ?sf ; c:activeOption ?sa . }
WHERE {
  $event beh:node ?hit . ?hroot rdfhtml:hasChild* ?hit . ?hroot sem:renders ?handle . ?handle a blk:BlockHandle ; dnd:carries ?b .
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER(EXISTS { $event a beh:Click } || EXISTS { $event a c:BlockHandleKey })
  OPTIONAL { $this c:handleMenuBlock ?open } OPTIONAL { $this c:handleMenuReturn ?ret }
  OPTIONAL { $this c:menuBlock ?sb } OPTIONAL { $this c:menuFrom ?sf } OPTIONAL { $this c:activeOption ?sa }
}""" ;
    beh:inserts """CONSTRUCT { $this c:handleMenuBlock ?opening ; c:handleMenuReturn ?closing . }
WHERE {
  $event beh:node ?hit . ?hroot rdfhtml:hasChild* ?hit . ?hroot sem:renders ?handle . ?handle a blk:BlockHandle ; dnd:carries ?b .
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER(EXISTS { $event a beh:Click } || EXISTS { $event a c:BlockHandleKey })
  OPTIONAL { $this c:handleMenuBlock ?open }
  BIND(IF(BOUND(?open) && ?open = ?b, ?none, ?b) AS ?opening)
  BIND(IF(BOUND(?open) && ?open = ?b, ?b, ?none) AS ?closing)
}""" .

c:CloseHandleMenu a beh:Reaction ;
    rdfs:label "Close a block's menu"@en ;
    rdfs:comment """Escape closes an open handle menu, the focus going back to its handle; the caret moving closes it too (and the
handle no longer takes the focus back)."""@en ;
    beh:when c:BlockHandleMenuKey , c:BlockSelect ;
    beh:sourceClass c:BlockEditor ;
    beh:deletes """CONSTRUCT { $this c:handleMenuBlock ?open ; c:handleMenuReturn ?ret . }
WHERE { { $this c:handleMenuBlock ?anyOpen } UNION { $this c:handleMenuReturn ?anyReturn } OPTIONAL { $this c:handleMenuBlock ?open } OPTIONAL { $this c:handleMenuReturn ?ret } }""" ;
    beh:inserts """CONSTRUCT { $this c:handleMenuReturn ?open . }
WHERE { $event a c:BlockHandleMenuKey . $this c:handleMenuBlock ?open . }""" .

c:HandleMenuConvert a beh:Reaction ;
    rdfs:label "Turn a block into another type"@en ;
    rdfs:comment """An item of a handle's menu that turns the block into another type: the conversion is raised on the block, the menu
closes and the focus goes back to the handle."""@en ;
    beh:when beh:Click ;
    beh:sourceClass c:BlockEditor ;
    beh:deletes """CONSTRUCT { $this c:handleMenuBlock ?open ; c:handleMenuReturn ?ret . }
WHERE { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit .
  $this c:editable true ; c:handleMenuBlock ?b . ?btn c:converts ?conv . OPTIONAL { $this c:handleMenuBlock ?open } OPTIONAL { $this c:handleMenuReturn ?ret } }""" ;
    beh:inserts """CONSTRUCT { ?b beh:raise ?conv . $this c:handleMenuReturn ?b . }
WHERE { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit .
  $this c:editable true ; c:handleMenuBlock ?b . ?btn c:converts ?conv . }""" .

c:DuplicateBlock a beh:Reaction ;
    rdfs:label "Duplicate a block"@en ;
    rdfs:comment """Duplicate, from a block's handle menu, or Mod+D on the caret's block: a copy of the block and of what it holds (and
their marks), every node minted from its original and the event, right after it."""@en ;
    beh:when beh:Click , c:BlockDuplicateKey ;
    beh:sourceClass c:BlockEditor ;
    beh:undoable true ;
    ann:announces "Block duplicated"@en , "Блок продубльовано"@uk , "Block dupliziert"@de , "تم تكرار الكتلة"@ar ;
    beh:deletes """CONSTRUCT { ?b co:nextItem ?next . $this c:handleMenuBlock ?open ; c:handleMenuReturn ?ret . }
WHERE {
  { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "duplicate")
  OPTIONAL { ?b co:nextItem ?next }
  OPTIONAL { $this c:handleMenuBlock ?open } OPTIONAL { $this c:handleMenuReturn ?ret }
}""" ;
    beh:inserts """CONSTRUCT { ?copy ?p ?copied . ?parent po:contains ?rootCopy . ?b co:nextItem ?rootCopy . ?rootCopy co:nextItem ?next . $this c:handleMenuReturn ?returnTo . }
WHERE {
  { { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "duplicate")
    ?b po:contains* ?n . ?n ?p ?o . FILTER(!STRSTARTS(STR(?p), STR(dnd:)) && !STRSTARTS(STR(?p), STR(ord:)) && !STRSTARTS(STR(?p), STR(rdfhtml:)) && !STRSTARTS(STR(?p), STR(sem:)) && ?p != blk:linePrefix) }
  UNION { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "duplicate")
    ?b po:contains* ?holder . ?holder blk:mark ?n . ?n ?p ?o . FILTER(!STRSTARTS(STR(?p), STR(dnd:)) && !STRSTARTS(STR(?p), STR(ord:)) && !STRSTARTS(STR(?p), STR(rdfhtml:)) && !STRSTARTS(STR(?p), STR(sem:)) && ?p != blk:linePrefix) }
    BIND(STRAFTER(STR($event), "event:") AS ?ev)
    FILTER(?n != ?b || ?p != co:nextItem)
    BIND(IRI(CONCAT(STR(?n), "-", ?ev)) AS ?copy)
    BIND(IF(isIRI(?o) && (EXISTS { ?b po:contains* ?o } || EXISTS { ?b po:contains*/blk:mark ?o }), IRI(CONCAT(STR(?o), "-", ?ev)), ?o) AS ?copied) }
  UNION { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "duplicate")
    BIND(STRAFTER(STR($event), "event:") AS ?ev2)
    ?parent po:contains ?b . OPTIONAL { ?b co:nextItem ?next }
    BIND(IRI(CONCAT(STR(?b), "-", ?ev2)) AS ?rootCopy)
    BIND(IF(EXISTS { $event a beh:Click }, ?b, ?none) AS ?returnTo) }
}""" .

c:DeleteBlock a beh:Reaction ;
    rdfs:label "Delete a block"@en ;
    rdfs:comment """Delete, from a block's handle menu: the block and what it holds (and their marks) go, its neighbours join; the
caret, when it was in it, goes to the block after it (else before it). The document's only block leaves an empty
paragraph."""@en ;
    beh:when beh:Click ;
    beh:sourceClass c:BlockEditor ;
    beh:undoable true ;
    ann:announces "Block deleted"@en , "Блок видалено"@uk , "Block gelöscht"@de , "تم حذف الكتلة"@ar ;
    beh:deletes """CONSTRUCT { ?n ?p ?o . ?parent po:contains ?b . ?prev co:nextItem ?b . $this c:handleMenuBlock ?open ; c:handleMenuReturn ?ret . $this c:anchorBlock ?xab ; c:anchorOffset ?xao ; c:focusBlock ?xfb ; c:focusOffset ?xfo ; c:pendingMark ?xpm . }
WHERE {
  { { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "delete")
    ?b po:contains* ?n . ?n ?p ?o . FILTER(!STRSTARTS(STR(?p), STR(dnd:)) && !STRSTARTS(STR(?p), STR(ord:)) && !STRSTARTS(STR(?p), STR(rdfhtml:)) && !STRSTARTS(STR(?p), STR(sem:)) && ?p != blk:linePrefix) }
  UNION { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "delete")
    ?b po:contains* ?holder . ?holder blk:mark ?n . ?n ?p ?o . FILTER(!STRSTARTS(STR(?p), STR(dnd:)) && !STRSTARTS(STR(?p), STR(ord:)) && !STRSTARTS(STR(?p), STR(rdfhtml:)) && !STRSTARTS(STR(?p), STR(sem:)) && ?p != blk:linePrefix) } }
  UNION { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "delete") ?parent po:contains ?b . OPTIONAL { ?prev co:nextItem ?b } OPTIONAL { $this c:handleMenuBlock ?open } OPTIONAL { $this c:handleMenuReturn ?ret } }
  UNION { { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "delete") $this c:focusBlock ?inside . ?b po:contains* ?inside . OPTIONAL { $this c:anchorBlock ?xab } OPTIONAL { $this c:anchorOffset ?xao } OPTIONAL { $this c:focusBlock ?xfb } OPTIONAL { $this c:focusOffset ?xfo }
  OPTIONAL { $this c:pendingMark ?xpm } }
}""" ;
    beh:inserts """CONSTRUCT { ?prev co:nextItem ?next . ?parent po:contains ?fresh . ?fresh a blk:Paragraph ; rdf:value "" . $this c:anchorBlock ?caretBlock ; c:anchorOffset ?caretAt ; c:focusBlock ?caretBlock ; c:focusOffset ?caretAt . }
WHERE {
  { $event a beh:Click ; beh:node ?hit . ?btn rdfhtml:hasChild* ?hit . ?btn blk:handleAction ?action . $this c:handleMenuBlock ?b }
  UNION { $event a c:BlockDuplicateKey . $this c:focusBlock ?b . BIND("duplicate" AS ?action) FILTER NOT EXISTS { $this c:menuOpen true } }
  $this c:editable true ; c:of ?doc . ?doc po:contains+ ?b .
  FILTER NOT EXISTS { ?b a/rdfs:subClassOf* ?fixed . VALUES ?fixed { blk:Row blk:Cell blk:Column } }
  FILTER(?action = "delete")
  ?parent po:contains ?b .
  OPTIONAL { ?prev co:nextItem ?b } OPTIONAL { ?b co:nextItem ?next }
  # The document's only block: an empty paragraph takes its place.
  BIND(IF(!BOUND(?prev) && !BOUND(?next) && ?parent = ?doc, IRI(CONCAT(STR(?doc), "/~b-", STRAFTER(STR($event), "event:"))), ?none) AS ?fresh)
  # The caret was in it: it goes to the start of the block after it, else before it.
  BIND(EXISTS { $this c:focusBlock ?inside . ?b po:contains* ?inside } AS ?moves)
  BIND(IF(?moves, COALESCE(?fresh, ?next, ?prev), ?none) AS ?caretBlock)
  BIND(IF(?moves, 0, ?none) AS ?caretAt)
}""" .
