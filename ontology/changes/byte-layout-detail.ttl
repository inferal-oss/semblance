@prefix chg: <https://semblance.dev/ns/change#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix change: <https://semblance.dev/change/> .
@prefix c: <https://semblance.dev/ns/component#> .

change:byte-layout-detail a chg:Change ;
    rdfs:label "Nest a byte layout inside a field"@en ;
    chg:issue <https://github.com/inferal-oss/semblance/issues/568> ;
    chg:motivation "A field can stand for another record, such as an LDLS directory entry." ;
    chg:substance "A field of a wrapping schematic can use c:byteDetail to place another wrapping ByteLayout inside it. The field takes a row and grows with the nested diagram. Each detail retains its own offsets and appearance. The browser moves later rows and brackets as details reflow." ;
    chg:forwardGuide "Set c:byteWrap true on both diagrams and point the field's c:byteDetail at the child layout." ;
    chg:backwardGuide "Remove c:byteDetail and display the child ByteLayout separately." ;
    chg:affects c:ByteLayout, c:ByteCell .
