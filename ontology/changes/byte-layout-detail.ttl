@prefix chg: <https://semblance.dev/ns/change#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix change: <https://semblance.dev/change/> .
@prefix c: <https://semblance.dev/ns/component#> .

change:byte-layout-detail a chg:Change ;
    rdfs:label "Nest a byte layout inside a field"@en ;
    chg:issue <https://github.com/inferal-oss/semblance/issues/568> ;
    chg:motivation "A field can stand for another record, such as an LDLS directory entry, whose own layout belongs inside it." ;
    chg:substance "A field of a wrapping schematic (c:byteWrap true, no c:byteExtent) can name another ByteLayout with c:byteDetail. The field then takes a row of its own and contains the nested layout, which keeps its own offsets and appearance and wraps or not as it says. The field grows with it, and the rows after it move down. A detail that leads back to its own layout is not drawn. In Text, a field with a detail is its line followed by the nested layout's lines. In a strip, c:byteDetail is not shown." ;
    chg:forwardGuide "Set c:byteWrap true on the outer schematic and point the field's c:byteDetail at the nested layout. Leave the nested layout out of any other container: its field is where it is shown." ;
    chg:backwardGuide "Remove c:byteDetail and show the nested ByteLayout on its own." ;
    chg:affects c:ByteLayout, c:ByteCell .
