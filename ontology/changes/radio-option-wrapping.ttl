@prefix chg: <https://semblance.dev/ns/change#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix change: <https://semblance.dev/change/> .
@prefix c: <https://semblance.dev/ns/component#> .

# What changed for whoever has to move with it: AGENTS.md, "When a component changes".

change:radio-option-wrapping a chg:Change ;
    rdfs:label "Radio option labels and notes wrap inside their padding"@en ;
    chg:motivation """Long strings such as email addresses could spill into a radio option's padding or outside its border.""" ;
    chg:substance """Radio option text now uses overflow-wrap: anywhere. Labels and notes wrap at normal break
points first and can break a long string when the available space requires it.""" ;
    chg:forwardGuide """Keep the existing radio group and regenerate the stylesheet. Remove any local rule
added solely to wrap its option text.""" ;
    chg:backwardGuide """Use the previous stylesheet or add overflow-wrap: anywhere to the radio option
text in the host stylesheet to retain wrapping.""" ;
    chg:affects c:RadioGroup .
