@prefix chg: <https://semblance.dev/ns/change#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix change: <https://semblance.dev/change/> .
@prefix c: <https://semblance.dev/ns/component#> .

change:rdf-editor-entry-pages a chg:Change ;
    rdfs:label "Page the RDF editor's top-level resources"@en ;
    chg:motivation "Large RDF documents can ask the editor to build thousands of rows before the reader can open a single resource." ;
    chg:substance "An RDF editor with c:entryPageSize renders a window of its named resources in IRI order. c:page is one-based and defaults to 1. Page changes reuse the document graph and replace only the visible rows. Resources outside the current page can still be expanded in place when reached as objects." ;
    chg:forwardGuide "Existing documents need no changes. Set c:entryPageSize on the editor to opt in and update c:page when the application changes pages." ;
    chg:backwardGuide "Remove c:entryPageSize and c:page. The editor again shows all resources listed in c:entry." ;
    chg:affects c:RdfEditor, c:RdfTerm .
