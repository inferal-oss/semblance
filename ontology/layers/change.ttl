@prefix chg: <https://semblance.dev/ns/change#> .
@prefix mig: <https://semblance.dev/ns/migration#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Changes: what happened to the framework's components, and why, for the people and agents who
# have to move with it. A change holds the migrations (ontology/layers/migration.ttl) that carry it
# out, applied together or not at all; a change of meaning or behaviour alone holds none. The text
# is for understanding and judgement; the tools decide whether a move is done. Each change is a
# file of its own in ontology/changes/ (`npm run change -- new <slug>`), read by the tooling and not
# loaded with the framework's ontology.

<https://semblance.dev/ns/change> a owl:Ontology ;
    rdfs:label "Semblance changes"@en .

chg:Change a owl:Class ;
    rdfs:comment "Something a consumer of a component would notice: a term that moved or went, a rendering's output or a term's meaning that changed."@en .

chg:issue a owl:ObjectProperty ; rdfs:domain chg:Change ;
    rdfs:comment "The issue or pull request the change belongs to."@en .
chg:motivation a owl:DatatypeProperty ; rdfs:domain chg:Change ;
    rdfs:comment "Why it changed."@en .
chg:substance a owl:DatatypeProperty ; rdfs:domain chg:Change ;
    rdfs:comment "What changed, in full, for a person or an agent who has only this."@en .
chg:forwardGuide a owl:DatatypeProperty ; rdfs:domain chg:Change ;
    rdfs:comment "How to move to the new form, and how to settle by hand what the tool reports."@en .
chg:backwardGuide a owl:DatatypeProperty ; rdfs:domain chg:Change ;
    rdfs:comment "How to move back, and what does not return."@en .
chg:affects a owl:ObjectProperty ; rdfs:domain chg:Change ;
    rdfs:comment "A component whose definition this change moves: its version step (sem:changedBy) names this change."@en .
chg:retires a rdf:Property ; rdfs:domain chg:Change ;
    rdfs:comment "A term this change removes (a mig:renames retires its old term without saying so). A retired term is never defined again."@en .
chg:after a owl:ObjectProperty ; rdfs:domain chg:Change ; rdfs:range chg:Change ;
    rdfs:comment "A change this one is applied after, when they touch the same terms."@en .
chg:release a owl:DatatypeProperty ; rdfs:domain chg:Change ;
    rdfs:comment "The release the change shipped in, stated when it is released. Absent while unreleased."@en .
chg:applied a owl:ObjectProperty ; rdfs:range chg:Change ;
    rdfs:comment "An unreleased change a project has already moved across (semblance.lock.ttl)."@en .
chg:migrations a owl:ObjectProperty ; rdfs:domain chg:Change ;
    rdfs:comment "The change's migrations, an RDF list in the order they apply (backward: the reverse order). Absent for a change of meaning or behaviour alone."@en .

# What a change must say. Read by the tooling (src/migrate/versions.ts); a change that leaves one
# out fails `npm run versions -- --check`.
chg:ChangeShape a sh:NodeShape ;
    sh:targetClass chg:Change ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ,
                [ sh:path chg:motivation ; sh:minCount 1 ] ,
                [ sh:path chg:substance ; sh:minCount 1 ] ,
                [ sh:path chg:forwardGuide ; sh:minCount 1 ] ,
                [ sh:path chg:backwardGuide ; sh:minCount 1 ] ,
                [ sh:path chg:affects ; sh:minCount 1 ] .

# --- the record: what the repository says about each change, derived when the site is built ----------
# A change file says what changed. When and where it shipped is in git: the commit that added the
# file, the release tags (v<version>) whose history holds it, and the history of ontology/versions.ttl
# (every version step of every component). src/changes/records.ts reads them into a change log (a
# chg:Log) for the site to show (c:ChangeLog, ontology/components/changes.ttl); nothing here is
# written by hand.

chg:Log a owl:Class ;
    rdfs:comment "A change log: the releases of a set of components (chg:log on each), the unreleased one first, and their changes (chg:releasedIn)."@en .
chg:Release a owl:Class ;
    rdfs:comment "A release of the packages (a v<version> tag), or the changes not released yet (chg:unreleased true). sem:order places it in its log: 0 for the unreleased, then from the latest release to the earliest."@en .
chg:log a owl:ObjectProperty ; rdfs:domain chg:Release ; rdfs:range chg:Log ;
    rdfs:comment "The log a release is in."@en .
chg:version a owl:DatatypeProperty ; rdfs:domain chg:Release ;
    rdfs:comment "The release's version (0.3.0)."@en .
chg:tag a owl:DatatypeProperty ; rdfs:domain chg:Release ;
    rdfs:comment "The git tag it was released from (v0.3.0)."@en .
chg:date a owl:DatatypeProperty ; rdfs:domain chg:Release ; rdfs:range xsd:date ;
    rdfs:comment "When it was released: the tag's date."@en .
chg:unreleased a owl:DatatypeProperty ; rdfs:domain chg:Release ; rdfs:range xsd:boolean ;
    rdfs:comment "True on the release that stands for what is not released yet."@en .
chg:previous a owl:ObjectProperty ; rdfs:domain chg:Release ; rdfs:range chg:Release ;
    rdfs:comment "The release before this one: what a project is written against when it moves across this one's changes."@en .
chg:releasedIn a owl:ObjectProperty ; rdfs:range chg:Release ;
    rdfs:comment "On a change or a version step: the release it shipped in (the change's chg:release when it states one, else the earliest tag whose history holds the commit that recorded it), or the unreleased one."@en .
chg:recorded a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "On a change or a version step: when it was recorded (the date of the commit that added it)."@en .
chg:commit a owl:ObjectProperty ;
    rdfs:comment "On a change, a version step or a release: the commit that recorded it."@en .

chg:Step a owl:Class ;
    rdfs:comment "One version step of a component (chg:of): its sem:version, what accounts for it (sem:changedBy a change, or sem:internal and why), and when it was recorded and released."@en .
chg:of a owl:ObjectProperty ; rdfs:domain chg:Step ;
    rdfs:comment "The component a version step is of."@en .

