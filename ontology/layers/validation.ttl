@prefix sem: <https://semblance.dev/ns/core#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Validation layer. A field says which SHACL property shape its value must
# conform to (val:validates); the layer checks the field's c:value (or
# c:checked) against the shape's constraints and derives c:error with the
# shape's sh:message, which every field already renders (and the a11y layer
# turns into aria-invalid + an announced message). Errors appear once the
# field has a value; a required field without one is invalid but quiet.
#
# A button with val:requires (fields) is disabled while any of them is
# invalid. The layer runs before the components (stratum -10), so they render
# its conclusions like any other input. Supported: sh:minCount (required),
# sh:minLength, sh:maxLength, sh:pattern (+ sh:flags), sh:minInclusive,
# sh:maxInclusive, sh:datatype (xsd:integer / xsd:decimal), sh:in.
#
# A field that edits a property of another node (c:controls, c:property: a
# combobox, a tag input) is checked by the values that node has: sh:minCount
# (quietly), sh:maxCount (with the message, past it; and val:full at it, so the
# field adds no more). The text typed into one that creates values
# (c:allowsCustom) is a candidate value: it is checked against the value
# constraints, and val:invalidEntry (the message) keeps it from being committed. A field may
# validate against several shapes; the first violated one speaks.
#
# A dated field (one the localization layer gives a date pattern: a date field, a time field) over
# a date or time property (sh:datatype, else the property's rdfs:range) also has its typed text
# checked: it must read as a date or time in the locale's format, or the field says how to write
# one (c:InvalidDatePhrase, with the locale's pattern). Its values are checked against
# sh:minInclusive / sh:maxInclusive as ISO text, and against sh:lessThanOrEquals (a range's start
# shape names the end property); a shape speaks for the property its sh:path names.

<https://semblance.dev/ns/validation> a owl:Ontology ;
    rdfs:label "Semblance validation layer"@en .

val:Layer a sem:Layer ; rdfs:label "validation"@en .

val:validates a owl:ObjectProperty ; rdfs:range sh:PropertyShape ;
    rdfs:comment "The shape a field's value must conform to."@en .
val:requires a owl:ObjectProperty ; rdfs:range rdf:List ;
    rdfs:comment "On a button: the fields that must all be valid for it to be enabled."@en .
val:invalid a owl:DatatypeProperty ;
    rdfs:comment "Derived: the field's value violates its shape (or a required field is empty)."@en .
val:invalidEntry a owl:DatatypeProperty ;
    rdfs:comment "Derived: the text typed into a field that creates values breaks its shape's value constraints, so it cannot be committed. The value is the shape's sh:message."@en .
val:full a owl:DatatypeProperty ;
    rdfs:comment "Derived: the property a field edits holds as many values as its shape's sh:maxCount allows. The value is the shape's sh:message."@en .

val:Check a sem:Rendering ;
    sem:requires val:validates , val:requires , l10n:datePattern ;
    rdfs:comment "Checks fields against their shapes and gates buttons on them."@en ;
    sem:targets sem:Component ;
    sem:layer val:Layer ;
    sem:stratum -10 ;
    sem:inputOnly true ;
    sem:follows c:controls .
val:Check-fn a sem:Rule ;
    sem:implements val:Check ;
    sem:function "validation:check" .
# SPARQL twin of "validation:check": each field's first violated shape (in IRI order), its
# message in the viewer's language; a field over another node's property counts that node's
# values; a button is disabled while a field it requires (through its list) is invalid.
val:Check-sparql a sem:Rule ;
    sem:implements val:Check ;
    sem:follows c:controls , ( val:requires [ sem:zeroOrMore rdf:rest ] rdf:first ) ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT {
  $this val:invalid ?invalid ; c:error ?error ; val:full ?full ; val:invalidEntry ?entry ; c:disabled ?disabled .
}
WHERE {
  { $this val:validates ?anyShape } UNION { $this val:requires ?anyList }
  # A plain field: its own value against its shapes. Pristine (no value), it is invalid but says nothing.
  OPTIONAL { SELECT ?plainProblem WHERE {
    $this val:validates ?shape . FILTER NOT EXISTS { $this c:controls ?ct ; c:property ?cp }
    OPTIONAL { $this c:value ?ownValue }
    OPTIONAL { $this c:checked ?ownChecked }
    BIND(IF(BOUND(?ownValue), STR(?ownValue), IF(BOUND(?ownChecked), IF(STR(?ownChecked) = "true", "true", ""), ?none)) AS ?value)
    OPTIONAL { ?shape sh:minCount ?minCountp }
    OPTIONAL { ?shape sh:minLength ?minLengthp }
    OPTIONAL { ?shape sh:maxLength ?maxLengthp }
    OPTIONAL { ?shape sh:pattern ?patternp }
    OPTIONAL { ?shape sh:flags ?flagsp }
    OPTIONAL { ?shape sh:datatype ?datatypep }
    OPTIONAL { ?shape sh:minInclusive ?minp }
    OPTIONAL { ?shape sh:maxInclusive ?maxp }
    LATERAL { OPTIONAL { SELECT ?shape ?messagep WHERE {
  
  OPTIONAL {
    ?shape sh:message ?pickmsgp . FILTER(isLiteral(?pickmsgp))
    ?viewermsgp l10n:prefers ?prefmsgp . ?prefmsgp l10n:code ?codemsgp ; sem:order ?rankmsgp .
    BIND(LCASE(LANG(?pickmsgp)) AS ?tagmsgp)
    FILTER(?tagmsgp = ?codemsgp || STRSTARTS(?tagmsgp, CONCAT(?codemsgp, "-")))
    FILTER NOT EXISTS {
      ?viewermsgp l10n:prefers ?bettermsgp . ?bettermsgp l10n:code ?code2msgp ; sem:order ?rank2msgp .
      ?shape sh:message ?othermsgp . FILTER(isLiteral(?othermsgp))
      BIND(LCASE(LANG(?othermsgp)) AS ?tag2msgp)
      FILTER(?tag2msgp = ?code2msgp || STRSTARTS(?tag2msgp, CONCAT(?code2msgp, "-")))
      FILTER(?rank2msgp < ?rankmsgp || (?rank2msgp = ?rankmsgp && ?tag2msgp = ?code2msgp && ?tagmsgp != ?codemsgp))
    }
  }
  OPTIONAL { FILTER(!BOUND(?pickmsgp)) ?shape sh:message ?plainmsgp FILTER(isLiteral(?plainmsgp) && LANG(?plainmsgp) = "") }
  OPTIONAL { FILTER(!BOUND(?pickmsgp) && !BOUND(?plainmsgp)) ?shape sh:message ?enmsgp FILTER(LCASE(LANG(?enmsgp)) = "en") }
  OPTIONAL { FILTER(!BOUND(?pickmsgp) && !BOUND(?plainmsgp) && !BOUND(?enmsgp)) ?shape sh:message ?enxmsgp FILTER(STRSTARTS(LCASE(LANG(?enxmsgp)), "en-")) }
  OPTIONAL { FILTER(!BOUND(?pickmsgp) && !BOUND(?plainmsgp) && !BOUND(?enmsgp) && !BOUND(?enxmsgp)) ?shape sh:message ?anymsgp FILTER(isLiteral(?anymsgp)) }
  BIND(STR(COALESCE(?pickmsgp, ?plainmsgp, ?enmsgp, ?enxmsgp, ?anymsgp)) AS ?messagep)
  } } }
    BIND(xsd:double(REPLACE(?value, "^\\\\s+|\\\\s+$", "")) AS ?xp)
    BIND(?datatypep = xsd:integer || ?datatypep = xsd:decimal AS ?numericp)
    BIND(IF(!BOUND(?value) || ?value = "",
           IF(COALESCE(xsd:double(?minCountp), 0) > 0, COALESCE(?messagep, "Required."), ?none),
         IF(BOUND(?minLengthp) && STRLEN(?value) < xsd:double(?minLengthp), COALESCE(?messagep, CONCAT("At least ", STR(?minLengthp), " characters.")),
         IF(BOUND(?maxLengthp) && STRLEN(?value) > xsd:double(?maxLengthp), COALESCE(?messagep, CONCAT("At most ", STR(?maxLengthp), " characters.")),
         IF(BOUND(?patternp) && !REGEX(?value, STR(?patternp), COALESCE(STR(?flagsp), "")), COALESCE(?messagep, "Does not match the expected format."),
         IF(COALESCE(?numericp, false) && (REPLACE(?value, "^\\\\s+|\\\\s+$", "") = "" || !BOUND(?xp) || (?datatypep = xsd:integer && ?xp != FLOOR(?xp))),
            COALESCE(?messagep, IF(?datatypep = xsd:integer, "A whole number.", "A number.")),
         IF(BOUND(?minp) && !COALESCE(?xp >= xsd:double(?minp), false), COALESCE(?messagep, CONCAT("At least ", STR(?minp), ".")),
         IF(BOUND(?maxp) && !COALESCE(?xp <= xsd:double(?maxp), false), COALESCE(?messagep, CONCAT("At most ", STR(?maxp), ".")),
         IF(EXISTS { ?shape sh:in ?listp } && NOT EXISTS { ?shape sh:in/rdf:rest*/rdf:first ?allowedp FILTER(STR(?allowedp) = ?value) },
            COALESCE(?messagep, "Not one of the allowed values."), ?none)))))))) AS ?plainProblem)
    FILTER(BOUND(?plainProblem))
  } ORDER BY STR(?shape) LIMIT 1 }
  OPTIONAL { $this c:value ?shownValue }
  OPTIONAL { $this c:checked ?shownChecked }
  BIND(BOUND(?shownValue) || BOUND(?shownChecked) AS ?touched)
  # A field over another node's property: that node's values against sh:minCount / sh:maxCount,
  # and the typed text, when it creates values (c:allowsCustom), against the value constraints.
  OPTIONAL { FILTER EXISTS { $this c:controls ?ct ; c:property ?cp } { SELECT (COUNT(?held) AS ?count) WHERE { OPTIONAL { $this c:controls ?target ; c:property ?property . FILTER(isIRI(?target)) ?target ?property ?held } } } }
  BIND(EXISTS { FILTER EXISTS { $this c:controls ?ct ; c:property ?cp } $this val:validates ?s1 .
    { ?s1 sh:minCount ?lo FILTER(?count < xsd:double(?lo)) } UNION { ?s1 sh:maxCount ?hi FILTER(?count > xsd:double(?hi)) } } AS ?outOfBounds)
  OPTIONAL { SELECT ?tooMany WHERE {
    $this val:validates ?shape . FILTER EXISTS { $this c:controls ?ct ; c:property ?cp } { SELECT (COUNT(?held) AS ?count) WHERE { OPTIONAL { $this c:controls ?target ; c:property ?property . FILTER(isIRI(?target)) ?target ?property ?held } } } ?shape sh:maxCount ?over . FILTER(?count > xsd:double(?over))
    LATERAL { OPTIONAL { SELECT ?shape ?overMessage WHERE {
  
  OPTIONAL {
    ?shape sh:message ?pickom . FILTER(isLiteral(?pickom))
    ?viewerom l10n:prefers ?prefom . ?prefom l10n:code ?codeom ; sem:order ?rankom .
    BIND(LCASE(LANG(?pickom)) AS ?tagom)
    FILTER(?tagom = ?codeom || STRSTARTS(?tagom, CONCAT(?codeom, "-")))
    FILTER NOT EXISTS {
      ?viewerom l10n:prefers ?betterom . ?betterom l10n:code ?code2om ; sem:order ?rank2om .
      ?shape sh:message ?otherom . FILTER(isLiteral(?otherom))
      BIND(LCASE(LANG(?otherom)) AS ?tag2om)
      FILTER(?tag2om = ?code2om || STRSTARTS(?tag2om, CONCAT(?code2om, "-")))
      FILTER(?rank2om < ?rankom || (?rank2om = ?rankom && ?tag2om = ?code2om && ?tagom != ?codeom))
    }
  }
  OPTIONAL { FILTER(!BOUND(?pickom)) ?shape sh:message ?plainom FILTER(isLiteral(?plainom) && LANG(?plainom) = "") }
  OPTIONAL { FILTER(!BOUND(?pickom) && !BOUND(?plainom)) ?shape sh:message ?enom FILTER(LCASE(LANG(?enom)) = "en") }
  OPTIONAL { FILTER(!BOUND(?pickom) && !BOUND(?plainom) && !BOUND(?enom)) ?shape sh:message ?enxom FILTER(STRSTARTS(LCASE(LANG(?enxom)), "en-")) }
  OPTIONAL { FILTER(!BOUND(?pickom) && !BOUND(?plainom) && !BOUND(?enom) && !BOUND(?enxom)) ?shape sh:message ?anyom FILTER(isLiteral(?anyom)) }
  BIND(STR(COALESCE(?pickom, ?plainom, ?enom, ?enxom, ?anyom)) AS ?overMessage)
  } } }
    BIND(COALESCE(?overMessage, CONCAT("At most ", STR(?over), ".")) AS ?tooMany)
    FILTER(BOUND(?tooMany))
  } ORDER BY STR(?shape) LIMIT 1 }
  OPTIONAL { SELECT ?atCapacity WHERE {
    $this val:validates ?shape . FILTER EXISTS { $this c:controls ?ct ; c:property ?cp } { SELECT (COUNT(?held) AS ?count) WHERE { OPTIONAL { $this c:controls ?target ; c:property ?property . FILTER(isIRI(?target)) ?target ?property ?held } } } ?shape sh:maxCount ?cap . FILTER(?count >= xsd:double(?cap))
    LATERAL { OPTIONAL { SELECT ?shape ?capMessage WHERE {
  
  OPTIONAL {
    ?shape sh:message ?pickcm . FILTER(isLiteral(?pickcm))
    ?viewercm l10n:prefers ?prefcm . ?prefcm l10n:code ?codecm ; sem:order ?rankcm .
    BIND(LCASE(LANG(?pickcm)) AS ?tagcm)
    FILTER(?tagcm = ?codecm || STRSTARTS(?tagcm, CONCAT(?codecm, "-")))
    FILTER NOT EXISTS {
      ?viewercm l10n:prefers ?bettercm . ?bettercm l10n:code ?code2cm ; sem:order ?rank2cm .
      ?shape sh:message ?othercm . FILTER(isLiteral(?othercm))
      BIND(LCASE(LANG(?othercm)) AS ?tag2cm)
      FILTER(?tag2cm = ?code2cm || STRSTARTS(?tag2cm, CONCAT(?code2cm, "-")))
      FILTER(?rank2cm < ?rankcm || (?rank2cm = ?rankcm && ?tag2cm = ?code2cm && ?tagcm != ?codecm))
    }
  }
  OPTIONAL { FILTER(!BOUND(?pickcm)) ?shape sh:message ?plaincm FILTER(isLiteral(?plaincm) && LANG(?plaincm) = "") }
  OPTIONAL { FILTER(!BOUND(?pickcm) && !BOUND(?plaincm)) ?shape sh:message ?encm FILTER(LCASE(LANG(?encm)) = "en") }
  OPTIONAL { FILTER(!BOUND(?pickcm) && !BOUND(?plaincm) && !BOUND(?encm)) ?shape sh:message ?enxcm FILTER(STRSTARTS(LCASE(LANG(?enxcm)), "en-")) }
  OPTIONAL { FILTER(!BOUND(?pickcm) && !BOUND(?plaincm) && !BOUND(?encm) && !BOUND(?enxcm)) ?shape sh:message ?anycm FILTER(isLiteral(?anycm)) }
  BIND(STR(COALESCE(?pickcm, ?plaincm, ?encm, ?enxcm, ?anycm)) AS ?capMessage)
  } } }
    BIND(COALESCE(?capMessage, CONCAT("At most ", STR(?cap), ".")) AS ?atCapacity)
    FILTER(BOUND(?atCapacity))
  } ORDER BY STR(?shape) LIMIT 1 }
  OPTIONAL { SELECT ?entryProblem WHERE {
    $this val:validates ?shape . FILTER EXISTS { $this c:controls ?ct ; c:property ?cp } $this c:allowsCustom ?creates . FILTER(STR(?creates) = "true")
    $this c:value ?typedRaw . BIND(REPLACE(STR(?typedRaw), "^\\\\s+|\\\\s+$", "") AS ?typed) FILTER(?typed != "")
    OPTIONAL { ?shape sh:minCount ?minCounte }
    OPTIONAL { ?shape sh:minLength ?minLengthe }
    OPTIONAL { ?shape sh:maxLength ?maxLengthe }
    OPTIONAL { ?shape sh:pattern ?patterne }
    OPTIONAL { ?shape sh:flags ?flagse }
    OPTIONAL { ?shape sh:datatype ?datatypee }
    OPTIONAL { ?shape sh:minInclusive ?mine }
    OPTIONAL { ?shape sh:maxInclusive ?maxe }
    LATERAL { OPTIONAL { SELECT ?shape ?messagee WHERE {
  
  OPTIONAL {
    ?shape sh:message ?pickmsge . FILTER(isLiteral(?pickmsge))
    ?viewermsge l10n:prefers ?prefmsge . ?prefmsge l10n:code ?codemsge ; sem:order ?rankmsge .
    BIND(LCASE(LANG(?pickmsge)) AS ?tagmsge)
    FILTER(?tagmsge = ?codemsge || STRSTARTS(?tagmsge, CONCAT(?codemsge, "-")))
    FILTER NOT EXISTS {
      ?viewermsge l10n:prefers ?bettermsge . ?bettermsge l10n:code ?code2msge ; sem:order ?rank2msge .
      ?shape sh:message ?othermsge . FILTER(isLiteral(?othermsge))
      BIND(LCASE(LANG(?othermsge)) AS ?tag2msge)
      FILTER(?tag2msge = ?code2msge || STRSTARTS(?tag2msge, CONCAT(?code2msge, "-")))
      FILTER(?rank2msge < ?rankmsge || (?rank2msge = ?rankmsge && ?tag2msge = ?code2msge && ?tagmsge != ?codemsge))
    }
  }
  OPTIONAL { FILTER(!BOUND(?pickmsge)) ?shape sh:message ?plainmsge FILTER(isLiteral(?plainmsge) && LANG(?plainmsge) = "") }
  OPTIONAL { FILTER(!BOUND(?pickmsge) && !BOUND(?plainmsge)) ?shape sh:message ?enmsge FILTER(LCASE(LANG(?enmsge)) = "en") }
  OPTIONAL { FILTER(!BOUND(?pickmsge) && !BOUND(?plainmsge) && !BOUND(?enmsge)) ?shape sh:message ?enxmsge FILTER(STRSTARTS(LCASE(LANG(?enxmsge)), "en-")) }
  OPTIONAL { FILTER(!BOUND(?pickmsge) && !BOUND(?plainmsge) && !BOUND(?enmsge) && !BOUND(?enxmsge)) ?shape sh:message ?anymsge FILTER(isLiteral(?anymsge)) }
  BIND(STR(COALESCE(?pickmsge, ?plainmsge, ?enmsge, ?enxmsge, ?anymsge)) AS ?messagee)
  } } }
    BIND(xsd:double(REPLACE(?typed, "^\\\\s+|\\\\s+$", "")) AS ?xe)
    BIND(?datatypee = xsd:integer || ?datatypee = xsd:decimal AS ?numerice)
    BIND(IF(!BOUND(?typed) || ?typed = "",
           IF(COALESCE(xsd:double(?minCounte), 0) > 0, COALESCE(?messagee, "Required."), ?none),
         IF(BOUND(?minLengthe) && STRLEN(?typed) < xsd:double(?minLengthe), COALESCE(?messagee, CONCAT("At least ", STR(?minLengthe), " characters.")),
         IF(BOUND(?maxLengthe) && STRLEN(?typed) > xsd:double(?maxLengthe), COALESCE(?messagee, CONCAT("At most ", STR(?maxLengthe), " characters.")),
         IF(BOUND(?patterne) && !REGEX(?typed, STR(?patterne), COALESCE(STR(?flagse), "")), COALESCE(?messagee, "Does not match the expected format."),
         IF(COALESCE(?numerice, false) && (REPLACE(?typed, "^\\\\s+|\\\\s+$", "") = "" || !BOUND(?xe) || (?datatypee = xsd:integer && ?xe != FLOOR(?xe))),
            COALESCE(?messagee, IF(?datatypee = xsd:integer, "A whole number.", "A number.")),
         IF(BOUND(?mine) && !COALESCE(?xe >= xsd:double(?mine), false), COALESCE(?messagee, CONCAT("At least ", STR(?mine), ".")),
         IF(BOUND(?maxe) && !COALESCE(?xe <= xsd:double(?maxe), false), COALESCE(?messagee, CONCAT("At most ", STR(?maxe), ".")),
         IF(EXISTS { ?shape sh:in ?liste } && NOT EXISTS { ?shape sh:in/rdf:rest*/rdf:first ?allowede FILTER(STR(?allowede) = ?typed) },
            COALESCE(?messagee, "Not one of the allowed values."), ?none)))))))) AS ?entryProblem)
    FILTER(BOUND(?entryProblem))
  } ORDER BY STR(?shape) LIMIT 1 }
  BIND(IF(BOUND(?plainProblem) || ?outOfBounds, true, ?none) AS ?invalid)
  BIND(IF(BOUND(?plainProblem) && ?touched, ?plainProblem, ?tooMany) AS ?error)
  BIND(?atCapacity AS ?full)
  BIND(?entryProblem AS ?entry)
  # A button: disabled while a field it requires is invalid.
  BIND(IF(EXISTS { $this val:requires/rdf:rest*/rdf:first ?field . ?field val:invalid ?flag FILTER(STR(?flag) = "true") }, true, ?none) AS ?disabled)
}""" .
