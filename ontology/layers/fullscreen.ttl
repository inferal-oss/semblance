@prefix sem: <https://semblance.dev/ns/core#> .
@prefix fs: <https://semblance.dev/ns/fullscreen#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Full screen, as a fact. `<component> fs:fullscreen true` shows the component over everything,
# filling the screen; retracting the fact (or making it false) puts it back. Anything that can
# assert a fact can do it: a c:Toggle over fs:fullscreen (`c:controls ui:chart ; c:property
# fs:fullscreen`), a reaction, a key:Command, the command palette, a rule, a test.
#
#   1. The fact is graph state. This layer marks the element it shows (the component's root, or
#      the part its class names with fs:part: a walkthrough shows its diagram) data-sem-fullscreen,
#      and the theme styles it: one rule for the browser's :fullscreen and for the fallback below.
#   2. The fullscreen effect (src/fullscreen.ts) sees the fact appear and asks the host to show that
#      element full screen (Element.requestFullscreen), in the same task as the change - the click's
#      or the key press's, while the page still has the person's activation, which browsers require.
#      Where it cannot (no activation: a timer's reaction; a sandboxed frame without allowfullscreen;
#      the browser refuses), it shows the element over the page instead: in the top layer, filling
#      the viewport (fs:Maximized). Either way it reports how as an fs:Entered event, and a reaction
#      records it (fs:presentation): the attribute says it, so the theme can tell them apart.
#   3. When the fact goes, the effect leaves full screen (document.exitFullscreen). When the host
#      leaves on its own - Esc, the browser's own control, another element going full screen - or
#      Esc is pressed over the fallback, the effect reports fs:Exited, and a reaction retracts the
#      fact. So the graph never claims a state the page is not in.
#
# A component class that is fs:Fullscreenable draws its own toggle (<component>/~fullscreen-toggle,
# a button marked fs:toggles the component; aria-pressed says whether it is full screen): a source
# view in its header, a walkthrough on its diagram, a live example in its bar. Any other component
# can be shown full screen all the same; a c:Toggle over fs:fullscreen, anywhere, is its affordance
# (with a key:shortcut, its key). Entering and leaving are announced (ann:announces).

<https://semblance.dev/ns/fullscreen> a owl:Ontology ;
    rdfs:label "Semblance full screen layer"@en .

fs:Layer a sem:Layer ;
    rdfs:label "full screen"@en , "повний екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar ;
    rdfs:comment "Marks what is shown full screen, for the theme and the fullscreen effect."@en .

fs:fullscreen a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "Full screen"@en , "На весь екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar ;
    rdfs:comment """The component is shown full screen (or, where the host cannot, over the page, filling it). Asserted
by anything; retracted to leave, and by the reaction to the host leaving on its own."""@en .

fs:Fullscreenable a owl:Class ;
    rdfs:label "Full-screenable"@en , "Розгортається на весь екран"@uk , "Vollbildfähig"@de , "قابل لملء الشاشة"@ar ;
    rdfs:comment """Mixin: the component draws its own toggle for fs:fullscreen (<component>/~fullscreen-toggle, a
button marked fs:toggles it), which flips the fact when activated."""@en .
fs:toggles a owl:ObjectProperty ; rdfs:range fs:Fullscreenable ;
    rdfs:comment "On a rendered element: the component that activating it shows full screen, or back in its place."@en .
fs:part a owl:DatatypeProperty ;
    rdfs:comment """On a component class (or an instance): the local name of the part it shows full screen
(<component>/~<part>) instead of its root. A walkthrough shows its diagram."""@en .

fs:presentation a owl:ObjectProperty ; rdfs:range fs:Presentation ;
    rdfs:comment "How the host shows a full-screen component (recorded from its fs:Entered event; gone when it leaves)."@en .
fs:Presentation a owl:Class .
fs:Native a fs:Presentation ; sem:slug "native" ;
    rdfs:label "Full screen"@en , "Повний екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar ;
    rdfs:comment "The host's own full screen (Element.requestFullscreen)."@en .
fs:Maximized a fs:Presentation ; sem:slug "maximized" ;
    rdfs:label "Over the page"@en , "Поверх сторінки"@uk , "Über der Seite"@de , "فوق الصفحة"@ar ;
    rdfs:comment "Where the host cannot: in the page's top layer, filling the viewport."@en .

fs:Entered a owl:Class ; rdfs:subClassOf beh:Event ;
    rdfs:label "Entered full screen"@en , "Увімкнено повний екран"@uk , "Vollbild aktiviert"@de , "تم الدخول في ملء الشاشة"@ar ;
    rdfs:comment "The host shows the component full screen, as the event's fs:presentation says (addressed to the component)."@en .
fs:Exited a owl:Class ; rdfs:subClassOf beh:Event ;
    rdfs:label "Left full screen"@en , "Вимкнено повний екран"@uk , "Vollbild beendet"@de , "تم الخروج من ملء الشاشة"@ar ;
    rdfs:comment "The host no longer shows the component full screen: the fact went, or the host (Esc, the browser) left on its own."@en .

fs:ToggleCommand a c:Phrase ;
    rdfs:label "Full screen"@en , "На весь екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar .

# --- marks --------------------------------------------------------------------------------------
# After the components (like the privacy layer's marks): the shown element says it is full screen,
# and how, once the host has said (data-sem-fullscreen="native" or "maximized"; "" until then).
fs:Marks a sem:Rendering ;
    sem:requires fs:fullscreen ;
    sem:targets sem:Component ;
    sem:modality mod:Screen ;
    sem:layer fs:Layer ;
    sem:stratum 12 ;
    sem:watches fs:fullscreen , fs:presentation , fs:part .
fs:Marks-fn a sem:Rule ; sem:implements fs:Marks ; sem:function "fullscreen:marks" .
fs:Marks-sparql a sem:Rule ;
    sem:implements fs:Marks ;
    sem:construct """
CONSTRUCT { ?shown rdfhtml:attribute ?a . ?a a rdfhtml:Attribute ; rdfhtml:attributeName "data-sem-fullscreen" ; rdfhtml:attributeValue ?how }
WHERE {
  $this fs:fullscreen ?on FILTER(STR(?on) = "true")
  OPTIONAL { $this fs:part ?own }
  OPTIONAL { FILTER(!BOUND(?own)) $this a/rdfs:subClassOf* ?cls . ?cls fs:part ?inherited }
  BIND(COALESCE(?own, ?inherited, "root") AS ?part)
  OPTIONAL { $this fs:presentation ?presentation . ?presentation sem:slug ?slug }
  BIND(COALESCE(STR(?slug), "") AS ?how)
  BIND(IRI(CONCAT(STR($this), "/~", STR(?part))) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~", STR(?part), "-fullscreen")) AS ?a)
}""" .

# A full-screenable component's own toggle says whether it is pressed.
fs:Pressed a sem:Rendering ;
    sem:targets fs:Fullscreenable ;
    sem:modality mod:Screen ;
    sem:layer fs:Layer ;
    sem:stratum 12 ;
    sem:watches rdf:type , fs:fullscreen .
fs:Pressed-fn a sem:Rule ; sem:implements fs:Pressed ; sem:function "fullscreen:pressed" .
fs:Pressed-sparql a sem:Rule ;
    sem:implements fs:Pressed ;
    sem:construct """
CONSTRUCT { ?toggle rdfhtml:attribute ?a . ?a a rdfhtml:Attribute ; rdfhtml:attributeName "aria-pressed" ; rdfhtml:attributeValue ?pressed }
WHERE {
  $this a/rdfs:subClassOf* fs:Fullscreenable .
  BIND(IF(EXISTS { $this fs:fullscreen ?on FILTER(STR(?on) = "true") }, "true", "false") AS ?pressed)
  BIND(IRI(CONCAT(STR($this), "/~fullscreen-toggle")) AS ?toggle)
  BIND(IRI(CONCAT(STR($this), "/~fullscreen-toggle-aria-pressed")) AS ?a)
}""" .

# --- reactions -------------------------------------------------------------------------------------

# Activating a full-screenable component's own toggle flips the fact (as a c:Toggle over it does).
fs:Flip a beh:Reaction ;
    rdfs:label "Full screen, or back"@en ;
    beh:when beh:Click ;
    beh:sourceClass fs:Fullscreenable ;
    beh:deletes """
CONSTRUCT { $this fs:fullscreen ?old }
WHERE { $event beh:node ?hit . ?toggle rdfhtml:hasChild* ?hit . ?toggle fs:toggles $this . $this fs:fullscreen ?old }""" ;
    beh:inserts """
CONSTRUCT { $this fs:fullscreen ?new }
WHERE {
  $event beh:node ?hit . ?toggle rdfhtml:hasChild* ?hit . ?toggle fs:toggles $this .
  BIND(!EXISTS { $this fs:fullscreen ?on FILTER(STR(?on) = "true") } AS ?new)
}""" ;
    sem:function "fullscreen:flip" .

# The host shows it: how is recorded, and said.
fs:EnterNative a beh:Reaction ;
    rdfs:label "Shown full screen"@en ;
    beh:when fs:Entered ;
    beh:sourceClass sem:Component ;
    ann:announces "Full screen. Esc leaves it"@en , "Повний екран. Esc — вийти"@uk , "Vollbild. Esc beendet es"@de , "ملء الشاشة. اضغط Esc للخروج"@ar ;
    beh:deletes """CONSTRUCT { $this fs:presentation ?old } WHERE { $event fs:presentation fs:Native . $this fs:presentation ?old FILTER(?old != fs:Native) }""" ;
    beh:inserts """CONSTRUCT { $this fs:presentation fs:Native } WHERE { $event fs:presentation fs:Native . $this fs:fullscreen ?on FILTER(STR(?on) = "true") FILTER NOT EXISTS { $this fs:presentation fs:Native } }""" ;
    sem:function "fullscreen:enter-native" .
fs:EnterMaximized a beh:Reaction ;
    rdfs:label "Shown over the page"@en ;
    beh:when fs:Entered ;
    beh:sourceClass sem:Component ;
    ann:announces "Shown over the page: full screen is not available here. Esc leaves it"@en ,
        "Показано поверх сторінки: повний екран тут недоступний. Esc — вийти"@uk ,
        "Über der Seite gezeigt: Vollbild ist hier nicht verfügbar. Esc beendet es"@de ,
        "معروض فوق الصفحة: ملء الشاشة غير متاح هنا. اضغط Esc للخروج"@ar ;
    beh:deletes """CONSTRUCT { $this fs:presentation ?old } WHERE { $event fs:presentation fs:Maximized . $this fs:presentation ?old FILTER(?old != fs:Maximized) }""" ;
    beh:inserts """CONSTRUCT { $this fs:presentation fs:Maximized } WHERE { $event fs:presentation fs:Maximized . $this fs:fullscreen ?on FILTER(STR(?on) = "true") FILTER NOT EXISTS { $this fs:presentation fs:Maximized } }""" ;
    sem:function "fullscreen:enter-maximized" .

# The host no longer shows it: the fact goes (if it is still there), and so does how.
fs:Exit a beh:Reaction ;
    rdfs:label "Left full screen"@en ;
    beh:when fs:Exited ;
    beh:sourceClass sem:Component ;
    ann:announces "Left full screen"@en , "Вийшли з повного екрана"@uk , "Vollbild beendet"@de , "تم الخروج من ملء الشاشة"@ar ;
    beh:deletes """CONSTRUCT { $this ?p ?o } WHERE { VALUES ?p { fs:fullscreen fs:presentation } $this ?p ?o }""" ;
    sem:function "fullscreen:exit" .
