@prefix sem: <https://semblance.dev/ns/core#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Navigation: "where we are" is graph data. A location (nav:Location) is the set of
# coordinates (nav:Dimension) of one mounted app: which page, which section, which
# example. Each coordinate is a property of a node in the input graph, says where it is
# carried (the URL's fragment or query, this tab's or this device's storage), whether
# changing it makes history (a step Back returns to), and when it applies at all (a docs
# section only while the page is the docs). A host effect (src/navigation.ts) reads the
# carriers into the graph before the first projection, writes the graph back to them
# after input changes, and turns Back, Forward and typed URLs into nav:Navigate events.

<https://semblance.dev/ns/navigation> a owl:Ontology ;
    rdfs:label "Semblance navigation"@en .

# --- locations and their dimensions ---------------------------------------------------------------

nav:Location a owl:Class ;
    rdfs:label "Location"@en , "Розташування"@uk , "Ort"@de , "الموقع"@ar ;
    rdfs:comment """Where we are in one app: its dimensions (nav:dimensions, in the order the URL spells
them) and the component it belongs to (nav:root, the mount root of its projection). Two apps on
one page each have their own location; only one may carry the URL's fragment."""@en .
nav:root a owl:ObjectProperty ; rdfs:domain nav:Location ;
    rdfs:comment "The component whose projection this location belongs to (its mount root)."@en .
nav:dimensions a owl:ObjectProperty ; rdfs:domain nav:Location ; rdfs:range rdf:List ;
    rdfs:comment "The location's dimensions, in the order a path-style fragment spells them."@en .

nav:Dimension a owl:Class ;
    rdfs:label "Dimension"@en , "Вимір"@uk , "Dimension"@de , "بُعد"@ar ;
    rdfs:comment """One coordinate of a location: the value of nav:property on nav:subject. It is carried
where nav:carriedBy says, spelled by nav:keyProperty, and applies only while its nav:parent
has one of the nav:when values (if it has a parent)."""@en .
nav:subject a owl:ObjectProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "The node whose property holds the dimension's value (e.g. the app)."@en .
nav:property a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range rdf:Property ;
    rdfs:comment "The property holding the dimension's value (one value)."@en .
nav:key a owl:DatatypeProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "The dimension's name where a carrier names it: a query parameter (default: the property's local name)."@en .
nav:keyProperty a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range rdf:Property ;
    rdfs:comment """How a value is spelled: the literal value of this property on it (default sem:slug).
Values without one are spelled as prefixed names (c:Window), literals by their lexical form."""@en .
nav:spelling a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Spelling ;
    rdfs:comment "How values are spelled: by key (nav:ByKey, the default) or as prefixed names (nav:PrefixedName, for terms of any vocabulary)."@en .
nav:Spelling a owl:Class .
nav:ByKey a nav:Spelling ; rdfs:comment "By nav:keyProperty, then sem:slug, then as a prefixed name."@en .
nav:PrefixedName a nav:Spelling ; rdfs:comment "As a prefixed name (c:Window, ui:page): any term, unambiguously."@en .
nav:parent a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Dimension ;
    rdfs:comment """Scope of applicability: the dimension applies only while this one has one of the
nav:when values. Out of scope, it is left out of the URL and not read from it; in a path-style
fragment it follows its parent."""@en .
nav:when a owl:ObjectProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "A value of nav:parent under which the dimension applies (one or more)."@en .

# What to bring into view: any resource the location shows (a specimen, a section), spelled by
# its nav:anchor or its local name, in the fragment's last segment. It applies while the
# location shows it; following it also writes the dimension values that show it.
nav:TargetDimension a owl:Class ; rdfs:subClassOf nav:Dimension ;
    rdfs:label "Target"@en , "Ціль"@uk , "Ziel"@de , "الهدف"@ar ;
    rdfs:comment """A dimension whose value is a resource shown under the location, brought into view
(scrolled to, and focused if it can be) once it is rendered."""@en .
nav:target a owl:ObjectProperty ;
    rdfs:label "Target"@en , "Ціль"@uk , "Ziel"@de , "الهدف"@ar ;
    rdfs:comment "A conventional property for a target dimension: what a followed link brings into view."@en .
nav:anchor a owl:DatatypeProperty ;
    rdfs:comment "On any resource: how a URL spells it as a target (default: its IRI's local name)."@en .

# --- carriers: where a location lives ------------------------------------------------------------

nav:Carrier a owl:Class ;
    rdfs:comment """Where a dimension's value is kept between moments: a part of the URL, or a storage
scope. On load, the carrier with the lowest nav:rank that has a value wins; then the graph's
own value (the default)."""@en .
nav:carriedBy a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Carrier ;
    rdfs:comment "Where the dimension's value is carried (any number of carriers; none: only in the graph)."@en .
nav:rank a owl:DatatypeProperty ; rdfs:domain nav:Carrier ; rdfs:range xsd:integer ;
    rdfs:comment "Precedence on load: lower wins."@en .

nav:Fragment a nav:Carrier ; nav:rank 1 ; sem:order 1 ;
    rdfs:label "The address (#)"@en , "Адреса (#)"@uk , "Die Adresse (#)"@de , "العنوان (#)"@ar ;
    rdfs:comment "The URL's fragment, path style: #docs/rules, #components/inputs/inp-codes-spec."@en .
nav:Query a nav:Carrier ; nav:rank 2 ; sem:order 2 ;
    rdfs:label "The address (?)"@en , "Адреса (?)"@uk , "Die Adresse (?)"@de , "العنوان (?)"@ar ;
    rdfs:comment "The URL's query: ?key=value, one parameter per dimension (nav:key)."@en .
# Storage carriers are the persistence scopes: a dimension carried by one is remembered by the
# persistence effect, like a per:Policy over its subject and property (one writer of storage).
per:Session a nav:Carrier ; nav:rank 3 .
per:Device a nav:Carrier ; nav:rank 4 .
per:Database a nav:Carrier ; nav:rank 5 .

# --- history ------------------------------------------------------------------------------------

nav:History a owl:Class ;
    rdfs:comment "Whether changing a dimension makes a step that Back returns to. Each carrier realizes it its own way."@en .
nav:history a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:History ;
    rdfs:comment "Default nav:MakesHistory. A change of several dimensions makes history if any of them does."@en .
nav:MakesHistory a nav:History ;
    rdfs:label "Makes history"@en , "Створює історію"@uk , "Erzeugt Verlauf"@de , "ينشئ سجلًا"@ar ;
    rdfs:comment "A change is a step you can go back to (the URL carriers add a history entry)."@en .
nav:NoHistory a nav:History ;
    rdfs:label "No history"@en , "Без історії"@uk , "Kein Verlauf"@de , "بلا سجل"@ar ;
    rdfs:comment "A change updates where we are in place (the URL carriers replace the current entry). Storage carriers never keep history: only the current value."@en .

# --- following the URL: an event like any other -----------------------------------------------

nav:Navigate a owl:Class ; rdfs:subClassOf beh:Event ;
    rdfs:label "Navigate"@en , "Перехід"@uk , "Navigieren"@de , "انتقال"@ar ;
    rdfs:comment """The location changed outside the graph: Back, Forward, a typed or followed URL. Addressed
to the nav:Location, with the URL's query and fragment as beh:value; recorded in the change log."""@en .
nav:Follow a beh:Reaction ; beh:when nav:Navigate ; beh:sourceClass nav:Location ;
    rdfs:comment "Writes the dimensions the URL carries (and the target's) into the graph."@en ;
    sem:function "navigation:follow" .

# What the effect reports (in the navigation graph, urn:semblance:navigation).
nav:address a owl:DatatypeProperty ; rdfs:domain nav:Location ;
    rdfs:comment "The location as the URL carriers last spelled it (its query and fragment)."@en .

# --- where a resource is shown: links to things, not addresses -------------------------------------

# A link's c:to is a resource; the framework finds the location that shows it by walking up the
# component tree through these properties (lists are walked through their members), and at
# each c:Switch case collects the value of the dimension the switch follows (c:controls and
# c:property equal to the dimension's nav:subject and nav:property, c:when its value).
nav:ContainmentProperty a owl:Class ;
    rdfs:comment "A property that places components inside the component that has it (directly or as a list)."@en .
c:children a nav:ContainmentProperty . c:content a nav:ContainmentProperty . c:front a nav:ContainmentProperty .
c:back a nav:ContainmentProperty . c:body a nav:ContainmentProperty . c:cases a nav:ContainmentProperty .
c:tabs a nav:ContainmentProperty . c:actions a nav:ContainmentProperty . c:items a nav:ContainmentProperty .
c:primary a nav:ContainmentProperty . c:secondary a nav:ContainmentProperty . c:toolbar a nav:ContainmentProperty .
c:footer a nav:ContainmentProperty . c:hosts a nav:ContainmentProperty .

nav:href a owl:DatatypeProperty ;
    rdfs:comment "Derived, on a c:Link with c:to: the URL fragment of the location that shows its target."@en .
# In the components' stratum, so links that other components mint (a reference's facets) get it too.
c:LinkDestination a sem:Rendering ; sem:targets c:Link ; sem:stratum 0 ; sem:requires c:to ;
    sem:functionOnly "It walks the component tree up to any depth through containment properties named in the data, and spells the location as URL text exactly as the navigation effect parses it (key order, escaping, prefixed names); SPARQL 1.1 paths cannot have variable predicates." .
c:LinkDestination-fn a sem:Rule ; sem:implements c:LinkDestination ; sem:function "navigation:link-destination" .
