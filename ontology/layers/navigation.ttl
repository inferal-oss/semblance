@prefix sx: <https://semblance.dev/ns/sparql#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Navigation: "where we are" is graph data. A location (nav:Location) is the set of
# coordinates (nav:Dimension) of one mounted app: which page, which section, which
# example. Each coordinate is a property of a node in the input graph, says where it is
# carried (the URL's fragment or query, this tab's or this device's storage), whether
# changing it makes history (a step Back returns to), and when it applies at all (a docs
# section only while the page is the docs). A host effect (src/navigation.ts) reads the
# carriers into the graph before the first projection, writes the graph back to them
# after input changes, and turns Back, Forward and typed URLs into nav:Navigate events.

<https://semblance.dev/ns/navigation> a owl:Ontology ;
    rdfs:label "Semblance navigation"@en .

# --- locations and their dimensions ---------------------------------------------------------------

nav:Location a owl:Class ;
    rdfs:label "Location"@en , "Розташування"@uk , "Ort"@de , "الموقع"@ar ;
    rdfs:comment """Where we are in one app: its dimensions (nav:dimensions, in the order the URL spells
them) and the component it belongs to (nav:root, the mount root of its projection). Two apps on
one page each have their own location; only one may carry the URL's fragment."""@en .
nav:root a owl:ObjectProperty ; rdfs:domain nav:Location ;
    rdfs:comment "The component whose projection this location belongs to (its mount root)."@en .
nav:base a owl:DatatypeProperty ; rdfs:domain nav:Location ; rdfs:range xsd:string ;
    rdfs:comment "Where the location's paths start (nav:Path): \"/\" (the default) for an app at its origin's root, \"/docs/app/\" for one under a path. Ends with a slash."@en .
nav:dimensions a owl:ObjectProperty ; rdfs:domain nav:Location ; rdfs:range rdf:List ;
    rdfs:comment "The location's dimensions, in the order a path-style fragment spells them."@en .

nav:Dimension a owl:Class ;
    rdfs:label "Dimension"@en , "Вимір"@uk , "Dimension"@de , "بُعد"@ar ;
    rdfs:comment """One coordinate of a location: the value of nav:property on nav:subject. It is carried
where nav:carriedBy says, spelled by nav:keyProperty, and applies only while its nav:parent
has one of the nav:when values (if it has a parent)."""@en .
nav:subject a owl:ObjectProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "The node whose property holds the dimension's value (e.g. the app)."@en .
nav:property a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range rdf:Property ;
    rdfs:comment "The property holding the dimension's value (one value)."@en .
nav:key a owl:DatatypeProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "The dimension's name where a carrier names it: a query parameter (default: the property's local name)."@en .
nav:keyProperty a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range rdf:Property ;
    rdfs:comment """How a value is spelled: the literal value of this property on it (default sem:slug).
Values without one are spelled as prefixed names (c:Window), literals by their lexical form."""@en .
nav:spelling a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Spelling ;
    rdfs:comment "How values are spelled: by key (nav:ByKey, the default) or as prefixed names (nav:PrefixedName, for terms of any vocabulary)."@en .
nav:showsTerms a owl:DatatypeProperty ; rdfs:domain nav:Dimension ; rdfs:range xsd:boolean ;
    rdfs:comment """Whether the dimension's values are terms of the vocabularies a view shows (the Reference's
selected term): a link to a term that no component shows (c:to a class or a property) goes to it,
with its parents' nav:when values."""@en .
nav:Spelling a owl:Class .
nav:ByKey a nav:Spelling ; rdfs:comment "By nav:keyProperty, then sem:slug, then as a prefixed name."@en .
nav:PrefixedName a nav:Spelling ; rdfs:comment "As a prefixed name (c:Window, ui:page): any term, unambiguously."@en .
nav:parent a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Dimension ;
    rdfs:comment """Scope of applicability: the dimension applies only while this one has one of the
nav:when values. Out of scope, it is left out of the URL and not read from it; in a path-style
fragment it follows its parent."""@en .
nav:when a owl:ObjectProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "A value of nav:parent under which the dimension applies (one or more)."@en .

# What to bring into view: any resource the location shows (a specimen, a section), spelled by
# its nav:anchor or its local name, in the fragment's last segment. It applies while the
# location shows it; following it also writes the dimension values that show it.
nav:TargetDimension a owl:Class ; rdfs:subClassOf nav:Dimension ;
    rdfs:label "Target"@en , "Ціль"@uk , "Ziel"@de , "الهدف"@ar ;
    rdfs:comment """A dimension whose value is a resource shown under the location, brought into view
(scrolled to, and focused if it can be) once it is rendered."""@en .
nav:target a owl:ObjectProperty ;
    rdfs:label "Target"@en , "Ціль"@uk , "Ziel"@de , "الهدف"@ar ;
    rdfs:comment "A conventional property for a target dimension: what a followed link brings into view."@en .
nav:anchor a owl:DatatypeProperty ;
    rdfs:comment "On any resource: how a URL spells it as a target (default: its IRI's local name)."@en .

# --- carriers: where a location lives ------------------------------------------------------------

nav:Carrier a owl:Class ;
    rdfs:comment """Where a dimension's value is kept between moments: a part of the URL, or a storage
scope. On load, the carrier with the lowest nav:rank that has a value wins; then the graph's
own value (the default)."""@en .
nav:carriedBy a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:Carrier ;
    rdfs:comment "Where the dimension's value is carried (any number of carriers; none: only in the graph)."@en .
nav:rank a owl:DatatypeProperty ; rdfs:domain nav:Carrier ; rdfs:range xsd:integer ;
    rdfs:comment "Precedence on load: lower wins."@en .

nav:implicit a owl:ObjectProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "A value the address leaves unspelled: the place is the same with or without it (the language a site is in by default: /components/, not /en/components/)."@en .

nav:rendersInPlace a owl:DatatypeProperty ; rdfs:domain nav:Dimension ; rdfs:range xsd:boolean ;
    rdfs:comment "The dimension's values are shown one at a time in one place that re-renders in place (a reference's term): a static build renders the pages that differ only in it one after another in one runtime, rather than each from a fresh store. Its pages are the same either way (test/ssr.test.ts checks the site's)."@en .

nav:keeps a owl:ObjectProperty ;
    rdfs:comment "Derived, on a link: a dimension whose current value its address keeps (the language; the page, for what is on every page). A change of that dimension's value re-runs the link's destination, and only then (sem:readsLocation)."@en .
nav:TopDimensions a owl:NamedIndividual ;
    rdfs:comment "As the object of sem:readsLocation: the rendering reads only the top-level dimensions (no nav:parent: the language, the page), as a link keeps them."@en .

nav:Path a nav:Carrier ; nav:rank 0 ; sem:order 0 ;
    rdfs:label "The address (/)"@en , "Адреса (/)"@uk , "Die Adresse (/)"@de , "العنوان (/)"@ar ;
    rdfs:comment """The URL's path after the location's nav:base, one segment per dimension and a slash after
each: /docs/rules/, /components/inputs/. A path is a page of its own, which a server (or a static
build) renders before any script runs, and which a link reaches without scripts. Followed links
under the base are taken over by the navigation effect (no page load). A fragment that spells a
dimension the path carries (a link from before) is read too, and the address rewritten as a path.
The target (nav:TargetDimension) stays in the fragment. A link spells what shows its resource,
and keeps where we are for the rest: the current value of each top-level path dimension nothing
on the way to the resource decides (the language; the page, for what is on every page)."""@en .
nav:Fragment a nav:Carrier ; nav:rank 1 ; sem:order 1 ;
    rdfs:label "The address (#)"@en , "Адреса (#)"@uk , "Die Adresse (#)"@de , "العنوان (#)"@ar ;
    rdfs:comment "The URL's fragment, path style: #docs/rules, #components/inputs/inp-codes-spec."@en .
nav:Query a nav:Carrier ; nav:rank 2 ; sem:order 2 ;
    rdfs:label "The address (?)"@en , "Адреса (?)"@uk , "Die Adresse (?)"@de , "العنوان (?)"@ar ;
    rdfs:comment "The URL's query: ?key=value, one parameter per dimension (nav:key)."@en .
# Storage carriers are the persistence scopes: a dimension carried by one is remembered by the
# persistence effect, like a per:Policy over its subject and property (one writer of storage).
per:Session a nav:Carrier ; nav:rank 3 .
per:Device a nav:Carrier ; nav:rank 4 .
per:Database a nav:Carrier ; nav:rank 5 .

# --- history ------------------------------------------------------------------------------------

nav:History a owl:Class ;
    rdfs:comment "Whether changing a dimension makes a step that Back returns to. Each carrier realizes it its own way."@en .
nav:history a owl:ObjectProperty ; rdfs:domain nav:Dimension ; rdfs:range nav:History ;
    rdfs:comment "Default nav:MakesHistory. A change of several dimensions makes history if any of them does."@en .
nav:MakesHistory a nav:History ;
    rdfs:label "Makes history"@en , "Створює історію"@uk , "Erzeugt Verlauf"@de , "ينشئ سجلًا"@ar ;
    rdfs:comment "A change is a step you can go back to (the URL carriers add a history entry)."@en .
nav:NoHistory a nav:History ;
    rdfs:label "No history"@en , "Без історії"@uk , "Kein Verlauf"@de , "بلا سجل"@ar ;
    rdfs:comment "A change updates where we are in place (the URL carriers replace the current entry). Storage carriers never keep history: only the current value."@en .

# --- following the URL: an event like any other -----------------------------------------------

nav:Navigate a owl:Class ; rdfs:subClassOf beh:Event ;
    rdfs:label "Navigate"@en , "Перехід"@uk , "Navigieren"@de , "انتقال"@ar ;
    rdfs:comment """The location changed outside the graph: Back, Forward, a typed or followed URL. Addressed
to the nav:Location, with the URL's query and fragment as beh:value; recorded in the change log."""@en .
# Reading the address (nav:Follow): the path's segments, then the fragment's, each read by the first
# dimension (in the part's order: parents before their children) that knows its text, is not read by
# an earlier segment, and is opened by earlier ones (each parent on its way up is known by one of them
# as a value its child applies under). The first segment of a part nothing reads ends the part; in the
# fragment it may name the target, with the values that show it. A fragment whose first segment a
# top-level path dimension knows is an address from before paths (#docs/rules): read whole, the path
# not. Then what the address leaves out (nav:implicit), and the query's parameters. A value whose
# dimension does not apply under what was read (and where we are for the rest) is dropped. A
# dimension knows text as: a value of its XML Schema range; the subject keyed by its nav:keyProperty,
# then sem:slug (of its range; the least IRI); a prefixed name (of its range); the text itself, for a
# literal-valued one. A target: by nav:anchor, then a name in the vocabularies (one shown first, the
# longest namespace, the least IRI). The query below passes its tables between steps as text (one line
# per row), which sx:matches reads back as rows. Its function twin is readAddress (src/navigation.ts).
nav:Follow a beh:Reaction ; beh:when nav:Navigate ; beh:sourceClass nav:Location ;
    rdfs:comment "Writes the dimensions the URL carries (and the target's) into the graph, and opens what hides the target."@en ;
    sem:needsExtension sx:Text , sx:Matches ;
    beh:deletes """CONSTRUCT { ?subject ?property ?now . ?container ?sets ?was }
WHERE {
  { SELECT ?N WHERE { { SELECT (GROUP_CONCAT(COALESCE(?nline, ""); separator="") AS ?N) WHERE {
    { SELECT ?K ?read WHERE { { SELECT ?K (GROUP_CONCAT(DISTINCT COALESCE(?rline, ""); separator="") AS ?read) WHERE {
      { SELECT ?K ?R WHERE { { SELECT ?K (GROUP_CONCAT(COALESCE(?line, ""); separator="") AS ?R) WHERE {
    { SELECT ?K WHERE { { SELECT (GROUP_CONCAT(CONCAT(?k, "\\t", STR(?d), "\\t", STRAFTER(?best, " "), "\\t", ?ord, "\\t", ?flags, "\\n"); separator="") AS ?K) WHERE {
    { SELECT ?k ?d ?ord ?flags (MIN(?cand) AS ?best) WHERE {
      $event beh:value ?address0 . BIND(STR(?address0) AS ?address)
      BIND(IF(CONTAINS(?address, "#"), STRAFTER(?address, "#"), "") AS ?fragment)
      BIND(IF(CONTAINS(?address, "#"), STRBEFORE(?address, "#"), ?address) AS ?beforeFragment)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRAFTER(?beforeFragment, "?"), "") AS ?search)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRBEFORE(?beforeFragment, "?"), ?beforeFragment) AS ?path0)
      BIND(REPLACE(IF(STRSTARTS(?path0, "/"), ?path0, CONCAT("/", ?path0)), "/index\\\\.html?$", "/") AS ?pathname)
      OPTIONAL { $this nav:base ?base0 }
      BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
      BIND(IF(STRSTARTS(?pathname, ?base), SUBSTR(?pathname, STRLEN(?base) + 1), "") AS ?under)
      # The path's segments (0), the fragment's (1) and the query's parameters (2), keyed in order.
      VALUES ?part { 0 1 2 }
      BIND(IF(?part = 0, ?under, IF(?part = 1, ?fragment, ?search)) AS ?src)
      BIND(IF(?part = 2, "[^&]+", "[^/]+") AS ?pattern)
      (?src ?pattern) sx:matches (?raw ?start)
      BIND(CONCAT(STR(?part), SUBSTR("000000", STRLEN(STR(?start))), STR(?start)) AS ?k)
      BIND(IF(?part = 2, IF(CONTAINS(?raw, "="), STRBEFORE(?raw, "="), ?raw), "") AS ?name0)
      BIND(REPLACE(IF(?part = 2, IF(CONTAINS(?raw, "="), STRAFTER(?raw, "="), ""), ?raw), IF(?part = 2, "[+]", "^$"), " ") AS ?raw2)
      BIND(COALESCE(sx:decodeURI(?raw2), ?raw2) AS ?text)
      BIND(REPLACE(?name0, "[+]", " ") AS ?name1)
      BIND(COALESCE(sx:decodeURI(?name1), ?name1) AS ?name)
      # The dimensions that may read it: the path's; the fragment's (and the path's, for an address from before paths); the query's by key, its first parameter.
      $this nav:dimensions/rdf:rest*/rdf:first ?d .
      ?d nav:property ?prop .
      BIND(EXISTS { ?d a nav:TargetDimension } AS ?isTarget)
      BIND(!?isTarget && EXISTS { ?d nav:carriedBy nav:Path } AS ?inPath)
      BIND(EXISTS { ?d nav:carriedBy nav:Fragment } && (?isTarget || !?inPath) AS ?inFragment)
      OPTIONAL { ?d nav:key ?key0 }
      BIND(COALESCE(STR(?key0), REPLACE(STR(?prop), "^.*[#/]", "")) AS ?key)
      FILTER(IF(?part = 0, ?inPath, IF(?part = 1, ?inPath || ?inFragment,
             !?isTarget && ?name = ?key && EXISTS { ?d nav:carriedBy nav:Query }
             && NOT EXISTS { (?search "[^&]+") sx:matches (?raw3 ?start3) FILTER(?start3 < ?start)
               BIND(REPLACE(IF(CONTAINS(?raw3, "="), STRBEFORE(?raw3, "="), ?raw3), "[+]", " ") AS ?name3) FILTER(COALESCE(sx:decodeURI(?name3), ?name3) = ?key) })))
      BIND(CONCAT(IF(?inFragment, "1", "0"), IF(?isTarget, "1", "0")) AS ?flags)
      # Which reads first: the path's dimensions, parents before their children, in the location's order.
      { SELECT ?d (COUNT(DISTINCT ?before) AS ?at) WHERE { $this nav:dimensions ?h0 . ?h0 rdf:rest* ?before . ?before rdf:rest* ?c0 . ?c0 rdf:first ?d } GROUP BY ?d }
      OPTIONAL { ?d nav:parent ?p1 . { SELECT ?p1 (COUNT(DISTINCT ?before1) AS ?at1) WHERE { $this nav:dimensions ?h1 . ?h1 rdf:rest* ?before1 . ?before1 rdf:rest* ?c1 . ?c1 rdf:first ?p1 } GROUP BY ?p1 } }
      BIND(SUBSTR(CONCAT("000", STR(?at)), STRLEN(STR(?at)) + 1) AS ?own)
      BIND(CONCAT(IF(?inPath, "0", "1"), IF(!BOUND(?p1), CONCAT("0", ?own, "000"),
           IF(IF(?inPath, EXISTS { ?p1 nav:carriedBy nav:Path }, EXISTS { ?p1 nav:carriedBy nav:Fragment } && NOT EXISTS { ?p1 nav:carriedBy nav:Path }),
              CONCAT("0", SUBSTR(CONCAT("000", STR(?at1)), STRLEN(STR(?at1)) + 1), ?own), CONCAT("1", ?own, "000")))) AS ?ord)
      # The value it reads the text as, the first of: a value of an XML Schema range; the subject keyed by
      # nav:keyProperty, then sem:slug (of the range); a prefixed name (of the range); the text, for a literal.
      # A target: by nav:anchor, then a name in the vocabularies (one shown first, the longest namespace, the least IRI).
      OPTIONAL { ?prop rdfs:range ?range }
      BIND(BOUND(?range) && STRSTARTS(STR(?range), "http://www.w3.org/2001/XMLSchema#") AS ?xsdRange)
      BIND(!?isTarget && !?xsdRange && NOT EXISTS { ?d nav:spelling nav:PrefixedName } AS ?keyed)
      LATERAL {
        { FILTER(!?isTarget && ?xsdRange)
          BIND(IF(?range = xsd:boolean, IF(?text IN ("true", "false"), STRDT(?text, xsd:boolean), ?none),
               IF(?range = xsd:integer, IF(REGEX(?text, "^-?[0-9]+$"), STRDT(?text, xsd:integer), ?none), STRDT(?text, ?range))) AS ?typed)
          BIND(CONCAT("0 ", IF(isIRI(?typed), CONCAT("I", STR(?typed)), CONCAT("L", STR(DATATYPE(?typed)), " ", ENCODE_FOR_URI(STR(?typed))))) AS ?cand) }
        UNION { FILTER(?keyed) OPTIONAL { ?d nav:keyProperty ?kp0 } BIND(COALESCE(?kp0, sem:slug) AS ?kp)
          ?hit ?kp ?text . FILTER(isIRI(?hit) && (!BOUND(?range) || EXISTS { ?hit a ?range })) BIND(CONCAT("1 I", STR(?hit)) AS ?cand) }
        UNION { FILTER(?keyed) ?hit sem:slug ?text . FILTER(isIRI(?hit) && (!BOUND(?range) || EXISTS { ?hit a ?range })) BIND(CONCAT("2 I", STR(?hit)) AS ?cand) }
        UNION { FILTER(!?xsdRange && REGEX(?text, "^[a-zA-Z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$"))
          BIND(STRBEFORE(?text, ":") AS ?pfx)
          OPTIONAL { ?pn sem:prefixName ?pfx ; sem:namespace ?pns }
          OPTIONAL { ?shn sh:prefix ?shp ; sh:namespace ?shns FILTER(STR(?shp) = ?pfx) }
          BIND(IRI(CONCAT(STR(COALESCE(?pns, ?shns)), STRAFTER(?text, ":"))) AS ?named)
          FILTER(BOUND(?named) && EXISTS { ?named ?anyP ?anyO })
          FILTER(?isTarget || !BOUND(?range) || EXISTS { ?named a ?range })
          BIND(IF(?isTarget, CONCAT("4", IF(EXISTS { $this nav:root ?root0 . ?named (^nav:from/nav:to)* ?root0 } || NOT EXISTS { $this nav:root ?anyRoot0 }, "0", "1"), "9999 I", STR(?named)),
               CONCAT("3 I", STR(?named))) AS ?cand) }
        UNION { FILTER(!?isTarget && !?xsdRange) ?d nav:subject ?sub . ?sub ?prop ?cur . FILTER(isLiteral(?cur)) BIND(CONCAT("5 ", IF(isIRI(?text), CONCAT("I", STR(?text)), CONCAT("L", STR(DATATYPE(?text)), " ", ENCODE_FOR_URI(STR(?text))))) AS ?cand) }
        UNION { FILTER(?isTarget) ?anchored nav:anchor ?text . FILTER(isIRI(?anchored)) BIND(CONCAT("3 I", STR(?anchored)) AS ?cand) }
        UNION { FILTER(?isTarget && !CONTAINS(?text, ":") && REGEX(?text, "^[A-Za-z0-9_.~-]+$"))
          { ?pn2 sem:prefixName ?pp2 ; sem:namespace ?ns2 } UNION { ?pn2 sh:prefix ?pp2 ; sh:namespace ?ns2 }
          BIND(IRI(CONCAT(STR(?ns2), ?text)) AS ?named2)
          FILTER EXISTS { ?named2 ?anyP2 ?anyO2 }
          BIND(STR(9999 - STRLEN(STR(?ns2))) AS ?len2)
          BIND(CONCAT("4", IF(EXISTS { $this nav:root ?root2 . ?named2 (^nav:from/nav:to)* ?root2 } || NOT EXISTS { $this nav:root ?anyRoot2 }, "0", "1"),
               SUBSTR("0000", STRLEN(?len2) + 1), ?len2, " I", STR(?named2)) AS ?cand) }
      }
    } GROUP BY ?k ?d ?ord ?flags }
    FILTER(BOUND(?best))
  } } } }
  # The segments of the path and the fragment, in order.
  { SELECT (GROUP_CONCAT(DISTINCT CONCAT(?k, "\\n"); separator="") AS ?S) WHERE {
      $event beh:value ?address0 . BIND(STR(?address0) AS ?address)
      BIND(IF(CONTAINS(?address, "#"), STRAFTER(?address, "#"), "") AS ?fragment)
      BIND(IF(CONTAINS(?address, "#"), STRBEFORE(?address, "#"), ?address) AS ?beforeFragment)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRAFTER(?beforeFragment, "?"), "") AS ?search)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRBEFORE(?beforeFragment, "?"), ?beforeFragment) AS ?path0)
      BIND(REPLACE(IF(STRSTARTS(?path0, "/"), ?path0, CONCAT("/", ?path0)), "/index\\\\.html?$", "/") AS ?pathname)
      OPTIONAL { $this nav:base ?base0 }
      BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
      BIND(IF(STRSTARTS(?pathname, ?base), SUBSTR(?pathname, STRLEN(?base) + 1), "") AS ?under)
      # The path's segments (0), the fragment's (1) and the query's parameters (2), keyed in order.
      VALUES ?part { 0 1 2 }
      BIND(IF(?part = 0, ?under, IF(?part = 1, ?fragment, ?search)) AS ?src)
      BIND(IF(?part = 2, "[^&]+", "[^/]+") AS ?pattern)
      (?src ?pattern) sx:matches (?raw ?start)
      FILTER(?part < 2)
      BIND(CONCAT(STR(?part), SUBSTR("000000", STRLEN(STR(?start))), STR(?start)) AS ?k)
  } }
    # An address from before paths: its fragment's first segment is a top-level path dimension's (#docs/rules).
    BIND(EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kml ?ksl ?kl ?dsl ?el ?ol ?fll) FILTER(STRSTARTS(?kl, "1") && STRENDS(?fll, "0") && EXISTS { ?dl0 nav:carriedBy nav:Path FILTER(STR(?dl0) = ?dsl) FILTER NOT EXISTS { ?dl0 nav:parent ?pl0 } }
        && NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?slm ?sls ?slk) FILTER(STRSTARTS(?slk, "1") && ?slk < ?kl) }) } AS ?legacy)
    LATERAL { OPTIONAL {
      { # A segment read by the first dimension (in order) that knows it, opened by earlier segments and not read before;
         # every earlier segment of its part read.
        (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?km ?ks ?k ?ds ?e ?o ?fl) FILTER(IF(?legacy, STRSTARTS(?k, "1"), STRSTARTS(?k, "0") || (STRSTARTS(?k, "1") && STRSTARTS(?fl, "1"))) && STRENDS(?fl, "0")) BIND(IRI(?ds) AS ?d)
        FILTER NOT EXISTS { ?d nav:parent* ?xa . ?xa nav:parent ?ya .
        FILTER NOT EXISTS { ?xa nav:when ?wa . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmoa ?ksoa ?koa ?dsoa ?eoa ?ooa ?floa) FILTER(?koa < ?k && ?dsoa = STR(?ya) && IF(?legacy, STRSTARTS(?koa, "1"), STRSTARTS(?koa, "0") || (STRSTARTS(?koa, "1") && STRSTARTS(?floa, "1"))) && STRENDS(?floa, "0") && ?eoa = IF(isIRI(?wa), CONCAT("I", STR(?wa)), CONCAT("L", STR(DATATYPE(?wa)), " ", ENCODE_FOR_URI(STR(?wa))))) } }
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfa ?ksfa ?kfa ?dsfa ?efa ?ofa ?flfa) FILTER(?kfa < ?k && ?dsfa = ?ds && IF(?legacy, STRSTARTS(?kfa, "1"), STRSTARTS(?kfa, "0") || (STRSTARTS(?kfa, "1") && STRSTARTS(?flfa, "1"))) && STRENDS(?flfa, "0")) }
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmb ?ksb ?kb ?dsb ?eb ?ob ?flb) FILTER(?kb = ?k && ?dsb != ?ds && ?ob < ?o && IF(?legacy, STRSTARTS(?kb, "1"), STRSTARTS(?kb, "0") || (STRSTARTS(?kb, "1") && STRSTARTS(?flb, "1"))) && STRENDS(?flb, "0")) BIND(IRI(?dsb) AS ?db)
          FILTER NOT EXISTS { ?db nav:parent* ?xb . ?xb nav:parent ?yb .
        FILTER NOT EXISTS { ?xb nav:when ?wb . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmob ?ksob ?kob ?dsob ?eob ?oob ?flob) FILTER(?kob < ?k && ?dsob = STR(?yb) && IF(?legacy, STRSTARTS(?kob, "1"), STRSTARTS(?kob, "0") || (STRSTARTS(?kob, "1") && STRSTARTS(?flob, "1"))) && STRENDS(?flob, "0") && ?eob = IF(isIRI(?wb), CONCAT("I", STR(?wb)), CONCAT("L", STR(DATATYPE(?wb)), " ", ENCODE_FOR_URI(STR(?wb))))) } }
          FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfb ?ksfb ?kfb ?dsfb ?efb ?ofb ?flfb) FILTER(?kfb < ?k && ?dsfb = ?dsb && IF(?legacy, STRSTARTS(?kfb, "1"), STRSTARTS(?kfb, "0") || (STRSTARTS(?kfb, "1") && STRSTARTS(?flfb, "1"))) && STRENDS(?flfb, "0")) } }
        FILTER NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?sma ?ssa ?ja) FILTER(SUBSTR(?ja, 1, 1) = SUBSTR(?k, 1, 1) && ?ja < ?k)
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrua ?ksrua ?ja ?dsrua ?erua ?orua ?flrua) FILTER(IF(?legacy, STRSTARTS(?ja, "1"), STRSTARTS(?ja, "0") || (STRSTARTS(?ja, "1") && STRSTARTS(?flrua, "1"))) && STRENDS(?flrua, "0")) BIND(IRI(?dsrua) AS ?drua)
      FILTER NOT EXISTS { ?drua nav:parent* ?xrua . ?xrua nav:parent ?yrua .
        FILTER NOT EXISTS { ?xrua nav:when ?wrua . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmorua ?ksorua ?korua ?dsorua ?eorua ?oorua ?florua) FILTER(?korua < ?ja && ?dsorua = STR(?yrua) && IF(?legacy, STRSTARTS(?korua, "1"), STRSTARTS(?korua, "0") || (STRSTARTS(?korua, "1") && STRSTARTS(?florua, "1"))) && STRENDS(?florua, "0") && ?eorua = IF(isIRI(?wrua), CONCAT("I", STR(?wrua)), CONCAT("L", STR(DATATYPE(?wrua)), " ", ENCODE_FOR_URI(STR(?wrua))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrua ?ksfrua ?kfrua ?dsfrua ?efrua ?ofrua ?flfrua) FILTER(?kfrua < ?ja && ?dsfrua = ?dsrua && IF(?legacy, STRSTARTS(?kfrua, "1"), STRSTARTS(?kfrua, "0") || (STRSTARTS(?kfrua, "1") && STRSTARTS(?flfrua, "1"))) && STRENDS(?flfrua, "0")) } } }
        BIND(CONCAT("1\\t", ?ds, "\\t", ?e, "\\n") AS ?line)
      } UNION {
        # The first segment of the fragment nothing reads may name the target, and the values that show it.
        (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmt ?kst ?kt ?dst ?et ?ot ?flt) FILTER(IF(?legacy, STRSTARTS(?kt, "1"), STRSTARTS(?kt, "0") || (STRSTARTS(?kt, "1") && STRSTARTS(?flt, "1"))) && STRENDS(?flt, "1"))
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrt ?ksrt ?kt ?dsrt ?ert ?ort ?flrt) FILTER(IF(?legacy, STRSTARTS(?kt, "1"), STRSTARTS(?kt, "0") || (STRSTARTS(?kt, "1") && STRSTARTS(?flrt, "1"))) && STRENDS(?flrt, "0")) BIND(IRI(?dsrt) AS ?drt)
      FILTER NOT EXISTS { ?drt nav:parent* ?xrt . ?xrt nav:parent ?yrt .
        FILTER NOT EXISTS { ?xrt nav:when ?wrt . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmort ?ksort ?kort ?dsort ?eort ?oort ?flort) FILTER(?kort < ?kt && ?dsort = STR(?yrt) && IF(?legacy, STRSTARTS(?kort, "1"), STRSTARTS(?kort, "0") || (STRSTARTS(?kort, "1") && STRSTARTS(?flort, "1"))) && STRENDS(?flort, "0") && ?eort = IF(isIRI(?wrt), CONCAT("I", STR(?wrt)), CONCAT("L", STR(DATATYPE(?wrt)), " ", ENCODE_FOR_URI(STR(?wrt))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrt ?ksfrt ?kfrt ?dsfrt ?efrt ?ofrt ?flfrt) FILTER(?kfrt < ?kt && ?dsfrt = ?dsrt && IF(?legacy, STRSTARTS(?kfrt, "1"), STRSTARTS(?kfrt, "0") || (STRSTARTS(?kfrt, "1") && STRSTARTS(?flfrt, "1"))) && STRENDS(?flfrt, "0")) } }
        FILTER NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?smt ?sst ?jt) FILTER(SUBSTR(?jt, 1, 1) = SUBSTR(?kt, 1, 1) && ?jt < ?kt)
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrut ?ksrut ?jt ?dsrut ?erut ?orut ?flrut) FILTER(IF(?legacy, STRSTARTS(?jt, "1"), STRSTARTS(?jt, "0") || (STRSTARTS(?jt, "1") && STRSTARTS(?flrut, "1"))) && STRENDS(?flrut, "0")) BIND(IRI(?dsrut) AS ?drut)
      FILTER NOT EXISTS { ?drut nav:parent* ?xrut . ?xrut nav:parent ?yrut .
        FILTER NOT EXISTS { ?xrut nav:when ?wrut . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmorut ?ksorut ?korut ?dsorut ?eorut ?oorut ?florut) FILTER(?korut < ?jt && ?dsorut = STR(?yrut) && IF(?legacy, STRSTARTS(?korut, "1"), STRSTARTS(?korut, "0") || (STRSTARTS(?korut, "1") && STRSTARTS(?florut, "1"))) && STRENDS(?florut, "0") && ?eorut = IF(isIRI(?wrut), CONCAT("I", STR(?wrut)), CONCAT("L", STR(DATATYPE(?wrut)), " ", ENCODE_FOR_URI(STR(?wrut))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrut ?ksfrut ?kfrut ?dsfrut ?efrut ?ofrut ?flfrut) FILTER(?kfrut < ?jt && ?dsfrut = ?dsrut && IF(?legacy, STRSTARTS(?kfrut, "1"), STRSTARTS(?kfrut, "0") || (STRSTARTS(?kfrut, "1") && STRSTARTS(?flfrut, "1"))) && STRENDS(?flfrut, "0")) } } }
        LATERAL { { BIND(CONCAT("0\\t", ?dst, "\\t", ?et, "\\n") AS ?line) }
        UNION
        { BIND(IRI(SUBSTR(?et, 2)) AS ?target) $this nav:root ?root .
          ?target (^nav:from/nav:to)* ?child . ?edge nav:from ?child ; nav:to ?parent . ?parent (^nav:from/nav:to)* ?root .
          ?child c:when ?when . ?parent c:cases ?anyCases ; c:controls ?controls ; c:property ?controlled .
          $this nav:dimensions/rdf:rest*/rdf:first ?shown . ?shown nav:subject ?controls ; nav:property ?controlled . FILTER NOT EXISTS { ?shown a nav:TargetDimension }
          BIND(CONCAT("0\\t", STR(?shown), "\\t", IF(isIRI(?when), CONCAT("I", STR(?when)), CONCAT("L", STR(DATATYPE(?when)), " ", ENCODE_FOR_URI(STR(?when)))), "\\n") AS ?line) } }
      }
    } }
  } GROUP BY ?K } } }
      # One value per dimension: the first priority, then the least.
      LATERAL { OPTIONAL { (?R "([0-9])\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?rm ?rs ?rp ?rd ?re)
        FILTER NOT EXISTS { (?R "([0-9])\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?rm2 ?rs2 ?rp2 ?rd ?re2) FILTER(?rp2 < ?rp || (?rp2 = ?rp && ?re2 < ?re)) }
        BIND(CONCAT(?rd, "\\t", ?re, "\\n") AS ?rline) } }
    } GROUP BY ?K } } }
    LATERAL { OPTIONAL {
      $this nav:dimensions/rdf:rest*/rdf:first ?d .
      OPTIONAL { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?vm ?vs ?vd ?ve) FILTER(?vd = STR(?d)) }
      # Left out (nav:implicit), on the path or in the fragment: each parent on the way up has, read or left out, a value it applies under.
      OPTIONAL { FILTER(!BOUND(?ve)) ?d nav:implicit ?implicit .
        FILTER NOT EXISTS { ?d a nav:TargetDimension } FILTER EXISTS { ?d nav:carriedBy ?ic FILTER(?ic IN (nav:Path, nav:Fragment)) }
        FILTER NOT EXISTS { ?d nav:parent* ?ix . ?ix nav:parent ?iy .
          FILTER NOT EXISTS { $this nav:dimensions/rdf:rest*/rdf:first ?iy . ?ix nav:when ?iw .
            FILTER(EXISTS { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?im ?is ?iyd ?iye) FILTER(?iyd = STR(?iy) && ?iye = IF(isIRI(?iw), CONCAT("I", STR(?iw)), CONCAT("L", STR(DATATYPE(?iw)), " ", ENCODE_FOR_URI(STR(?iw))))) }
                || (NOT EXISTS { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?im2 ?is2 ?iyd2 ?iye2) FILTER(?iyd2 = STR(?iy)) } && EXISTS { ?iy nav:implicit ?iw })) } } }
      # In the query.
      OPTIONAL { FILTER(!BOUND(?ve) && !BOUND(?implicit)) (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmq ?ksq ?kq ?dsq ?eq ?oq ?flq) FILTER(STRSTARTS(?kq, "2") && ?dsq = STR(?d)) }
      BIND(COALESCE(?ve, IF(BOUND(?implicit), IF(isIRI(?implicit), CONCAT("I", STR(?implicit)), CONCAT("L", STR(DATATYPE(?implicit)), " ", ENCODE_FOR_URI(STR(?implicit)))), ?eq)) AS ?next)
      FILTER(BOUND(?next))
      BIND(CONCAT(STR(?d), "\\t", ?next, "\\n") AS ?nline)
    } }
  } } } }
  $this nav:dimensions/rdf:rest*/rdf:first ?d .
  ?d nav:subject ?subject ; nav:property ?property .
  FILTER EXISTS { ?d nav:carriedBy ?carrier FILTER(?carrier IN (nav:Path, nav:Fragment, nav:Query)) }
  BIND(EXISTS { ?d a nav:TargetDimension } AS ?isTarget)
  LATERAL { OPTIONAL { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm ?ns ?nd ?next0) FILTER(?nd = STR(?d))
    # It applies under what was read and where we are for the rest: each parent's value (read, else now) is one its child applies under.
    FILTER(?isTarget || NOT EXISTS { ?d nav:parent* ?x . ?x nav:parent ?y .
      FILTER NOT EXISTS { $this nav:dimensions/rdf:rest*/rdf:first ?y . ?x nav:when ?w .
        FILTER(EXISTS { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm2 ?ns2 ?yd ?ye) FILTER(?yd = STR(?y) && ?ye = IF(isIRI(?w), CONCAT("I", STR(?w)), CONCAT("L", STR(DATATYPE(?w)), " ", ENCODE_FOR_URI(STR(?w))))) }
            || (NOT EXISTS { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm3 ?ns3 ?yd3 ?ye3) FILTER(?yd3 = STR(?y)) } && EXISTS { ?y nav:subject ?ys ; nav:property ?yp . ?ys ?yp ?w })) } })
  } }
  BIND(IF(STRSTARTS(?next0, "I"), IRI(SUBSTR(?next0, 2)), STRDT(sx:decodeURI(STRAFTER(?next0, " ")), IRI(STRBEFORE(SUBSTR(?next0, 2), " ")))) AS ?next)
  # Always bound (a LATERAL group would bind an unbound ?next itself).
  BIND(COALESCE(?next, <urn:semblance:none>) AS ?given)
  # Unchanged when it is the one value now.
  BIND(BOUND(?next) && EXISTS { ?subject ?property ?next } && NOT EXISTS { ?subject ?property ?other FILTER(!sameTerm(?other, ?next)) } AS ?same)
  LATERAL { { FILTER((BOUND(?next) && !?same) || (!BOUND(?next) && ?isTarget)) ?subject ?property ?now }
  UNION
  { $this nav:dimensions/rdf:rest*/rdf:first ?td . ?td a nav:TargetDimension .
  FILTER(?d = ?td && !sameTerm(?given, <urn:semblance:none>))
  $this nav:root ?root .
  ?given (^nav:from/nav:to)* ?part . ?edge nav:from ?part ; nav:to ?container . ?container (^nav:from/nav:to)* ?root .
  ?class nav:reveal ?reveal . ?reveal nav:via ?via ; nav:sets ?sets .
  FILTER(STRSTARTS(STR(?edge), CONCAT(STR(?via), "/~up-")))
  ?container a/rdfs:subClassOf* ?class .
  OPTIONAL { ?reveal nav:value ?value0 }
  BIND(COALESCE(?value0, ?part) AS ?value)
  FILTER(!(EXISTS { ?container ?sets ?value } && NOT EXISTS { ?container ?sets ?otherValue FILTER(!sameTerm(?otherValue, ?value)) }))
    ?container ?sets ?was } }
}""" ;
    beh:inserts """CONSTRUCT { ?subject ?property ?next . ?container ?sets ?value }
WHERE {
  { SELECT ?N WHERE { { SELECT (GROUP_CONCAT(COALESCE(?nline, ""); separator="") AS ?N) WHERE {
    { SELECT ?K ?read WHERE { { SELECT ?K (GROUP_CONCAT(DISTINCT COALESCE(?rline, ""); separator="") AS ?read) WHERE {
      { SELECT ?K ?R WHERE { { SELECT ?K (GROUP_CONCAT(COALESCE(?line, ""); separator="") AS ?R) WHERE {
    { SELECT ?K WHERE { { SELECT (GROUP_CONCAT(CONCAT(?k, "\\t", STR(?d), "\\t", STRAFTER(?best, " "), "\\t", ?ord, "\\t", ?flags, "\\n"); separator="") AS ?K) WHERE {
    { SELECT ?k ?d ?ord ?flags (MIN(?cand) AS ?best) WHERE {
      $event beh:value ?address0 . BIND(STR(?address0) AS ?address)
      BIND(IF(CONTAINS(?address, "#"), STRAFTER(?address, "#"), "") AS ?fragment)
      BIND(IF(CONTAINS(?address, "#"), STRBEFORE(?address, "#"), ?address) AS ?beforeFragment)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRAFTER(?beforeFragment, "?"), "") AS ?search)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRBEFORE(?beforeFragment, "?"), ?beforeFragment) AS ?path0)
      BIND(REPLACE(IF(STRSTARTS(?path0, "/"), ?path0, CONCAT("/", ?path0)), "/index\\\\.html?$", "/") AS ?pathname)
      OPTIONAL { $this nav:base ?base0 }
      BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
      BIND(IF(STRSTARTS(?pathname, ?base), SUBSTR(?pathname, STRLEN(?base) + 1), "") AS ?under)
      # The path's segments (0), the fragment's (1) and the query's parameters (2), keyed in order.
      VALUES ?part { 0 1 2 }
      BIND(IF(?part = 0, ?under, IF(?part = 1, ?fragment, ?search)) AS ?src)
      BIND(IF(?part = 2, "[^&]+", "[^/]+") AS ?pattern)
      (?src ?pattern) sx:matches (?raw ?start)
      BIND(CONCAT(STR(?part), SUBSTR("000000", STRLEN(STR(?start))), STR(?start)) AS ?k)
      BIND(IF(?part = 2, IF(CONTAINS(?raw, "="), STRBEFORE(?raw, "="), ?raw), "") AS ?name0)
      BIND(REPLACE(IF(?part = 2, IF(CONTAINS(?raw, "="), STRAFTER(?raw, "="), ""), ?raw), IF(?part = 2, "[+]", "^$"), " ") AS ?raw2)
      BIND(COALESCE(sx:decodeURI(?raw2), ?raw2) AS ?text)
      BIND(REPLACE(?name0, "[+]", " ") AS ?name1)
      BIND(COALESCE(sx:decodeURI(?name1), ?name1) AS ?name)
      # The dimensions that may read it: the path's; the fragment's (and the path's, for an address from before paths); the query's by key, its first parameter.
      $this nav:dimensions/rdf:rest*/rdf:first ?d .
      ?d nav:property ?prop .
      BIND(EXISTS { ?d a nav:TargetDimension } AS ?isTarget)
      BIND(!?isTarget && EXISTS { ?d nav:carriedBy nav:Path } AS ?inPath)
      BIND(EXISTS { ?d nav:carriedBy nav:Fragment } && (?isTarget || !?inPath) AS ?inFragment)
      OPTIONAL { ?d nav:key ?key0 }
      BIND(COALESCE(STR(?key0), REPLACE(STR(?prop), "^.*[#/]", "")) AS ?key)
      FILTER(IF(?part = 0, ?inPath, IF(?part = 1, ?inPath || ?inFragment,
             !?isTarget && ?name = ?key && EXISTS { ?d nav:carriedBy nav:Query }
             && NOT EXISTS { (?search "[^&]+") sx:matches (?raw3 ?start3) FILTER(?start3 < ?start)
               BIND(REPLACE(IF(CONTAINS(?raw3, "="), STRBEFORE(?raw3, "="), ?raw3), "[+]", " ") AS ?name3) FILTER(COALESCE(sx:decodeURI(?name3), ?name3) = ?key) })))
      BIND(CONCAT(IF(?inFragment, "1", "0"), IF(?isTarget, "1", "0")) AS ?flags)
      # Which reads first: the path's dimensions, parents before their children, in the location's order.
      { SELECT ?d (COUNT(DISTINCT ?before) AS ?at) WHERE { $this nav:dimensions ?h0 . ?h0 rdf:rest* ?before . ?before rdf:rest* ?c0 . ?c0 rdf:first ?d } GROUP BY ?d }
      OPTIONAL { ?d nav:parent ?p1 . { SELECT ?p1 (COUNT(DISTINCT ?before1) AS ?at1) WHERE { $this nav:dimensions ?h1 . ?h1 rdf:rest* ?before1 . ?before1 rdf:rest* ?c1 . ?c1 rdf:first ?p1 } GROUP BY ?p1 } }
      BIND(SUBSTR(CONCAT("000", STR(?at)), STRLEN(STR(?at)) + 1) AS ?own)
      BIND(CONCAT(IF(?inPath, "0", "1"), IF(!BOUND(?p1), CONCAT("0", ?own, "000"),
           IF(IF(?inPath, EXISTS { ?p1 nav:carriedBy nav:Path }, EXISTS { ?p1 nav:carriedBy nav:Fragment } && NOT EXISTS { ?p1 nav:carriedBy nav:Path }),
              CONCAT("0", SUBSTR(CONCAT("000", STR(?at1)), STRLEN(STR(?at1)) + 1), ?own), CONCAT("1", ?own, "000")))) AS ?ord)
      # The value it reads the text as, the first of: a value of an XML Schema range; the subject keyed by
      # nav:keyProperty, then sem:slug (of the range); a prefixed name (of the range); the text, for a literal.
      # A target: by nav:anchor, then a name in the vocabularies (one shown first, the longest namespace, the least IRI).
      OPTIONAL { ?prop rdfs:range ?range }
      BIND(BOUND(?range) && STRSTARTS(STR(?range), "http://www.w3.org/2001/XMLSchema#") AS ?xsdRange)
      BIND(!?isTarget && !?xsdRange && NOT EXISTS { ?d nav:spelling nav:PrefixedName } AS ?keyed)
      LATERAL {
        { FILTER(!?isTarget && ?xsdRange)
          BIND(IF(?range = xsd:boolean, IF(?text IN ("true", "false"), STRDT(?text, xsd:boolean), ?none),
               IF(?range = xsd:integer, IF(REGEX(?text, "^-?[0-9]+$"), STRDT(?text, xsd:integer), ?none), STRDT(?text, ?range))) AS ?typed)
          BIND(CONCAT("0 ", IF(isIRI(?typed), CONCAT("I", STR(?typed)), CONCAT("L", STR(DATATYPE(?typed)), " ", ENCODE_FOR_URI(STR(?typed))))) AS ?cand) }
        UNION { FILTER(?keyed) OPTIONAL { ?d nav:keyProperty ?kp0 } BIND(COALESCE(?kp0, sem:slug) AS ?kp)
          ?hit ?kp ?text . FILTER(isIRI(?hit) && (!BOUND(?range) || EXISTS { ?hit a ?range })) BIND(CONCAT("1 I", STR(?hit)) AS ?cand) }
        UNION { FILTER(?keyed) ?hit sem:slug ?text . FILTER(isIRI(?hit) && (!BOUND(?range) || EXISTS { ?hit a ?range })) BIND(CONCAT("2 I", STR(?hit)) AS ?cand) }
        UNION { FILTER(!?xsdRange && REGEX(?text, "^[a-zA-Z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$"))
          BIND(STRBEFORE(?text, ":") AS ?pfx)
          OPTIONAL { ?pn sem:prefixName ?pfx ; sem:namespace ?pns }
          OPTIONAL { ?shn sh:prefix ?shp ; sh:namespace ?shns FILTER(STR(?shp) = ?pfx) }
          BIND(IRI(CONCAT(STR(COALESCE(?pns, ?shns)), STRAFTER(?text, ":"))) AS ?named)
          FILTER(BOUND(?named) && EXISTS { ?named ?anyP ?anyO })
          FILTER(?isTarget || !BOUND(?range) || EXISTS { ?named a ?range })
          BIND(IF(?isTarget, CONCAT("4", IF(EXISTS { $this nav:root ?root0 . ?named (^nav:from/nav:to)* ?root0 } || NOT EXISTS { $this nav:root ?anyRoot0 }, "0", "1"), "9999 I", STR(?named)),
               CONCAT("3 I", STR(?named))) AS ?cand) }
        UNION { FILTER(!?isTarget && !?xsdRange) ?d nav:subject ?sub . ?sub ?prop ?cur . FILTER(isLiteral(?cur)) BIND(CONCAT("5 ", IF(isIRI(?text), CONCAT("I", STR(?text)), CONCAT("L", STR(DATATYPE(?text)), " ", ENCODE_FOR_URI(STR(?text))))) AS ?cand) }
        UNION { FILTER(?isTarget) ?anchored nav:anchor ?text . FILTER(isIRI(?anchored)) BIND(CONCAT("3 I", STR(?anchored)) AS ?cand) }
        UNION { FILTER(?isTarget && !CONTAINS(?text, ":") && REGEX(?text, "^[A-Za-z0-9_.~-]+$"))
          { ?pn2 sem:prefixName ?pp2 ; sem:namespace ?ns2 } UNION { ?pn2 sh:prefix ?pp2 ; sh:namespace ?ns2 }
          BIND(IRI(CONCAT(STR(?ns2), ?text)) AS ?named2)
          FILTER EXISTS { ?named2 ?anyP2 ?anyO2 }
          BIND(STR(9999 - STRLEN(STR(?ns2))) AS ?len2)
          BIND(CONCAT("4", IF(EXISTS { $this nav:root ?root2 . ?named2 (^nav:from/nav:to)* ?root2 } || NOT EXISTS { $this nav:root ?anyRoot2 }, "0", "1"),
               SUBSTR("0000", STRLEN(?len2) + 1), ?len2, " I", STR(?named2)) AS ?cand) }
      }
    } GROUP BY ?k ?d ?ord ?flags }
    FILTER(BOUND(?best))
  } } } }
  # The segments of the path and the fragment, in order.
  { SELECT (GROUP_CONCAT(DISTINCT CONCAT(?k, "\\n"); separator="") AS ?S) WHERE {
      $event beh:value ?address0 . BIND(STR(?address0) AS ?address)
      BIND(IF(CONTAINS(?address, "#"), STRAFTER(?address, "#"), "") AS ?fragment)
      BIND(IF(CONTAINS(?address, "#"), STRBEFORE(?address, "#"), ?address) AS ?beforeFragment)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRAFTER(?beforeFragment, "?"), "") AS ?search)
      BIND(IF(CONTAINS(?beforeFragment, "?"), STRBEFORE(?beforeFragment, "?"), ?beforeFragment) AS ?path0)
      BIND(REPLACE(IF(STRSTARTS(?path0, "/"), ?path0, CONCAT("/", ?path0)), "/index\\\\.html?$", "/") AS ?pathname)
      OPTIONAL { $this nav:base ?base0 }
      BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
      BIND(IF(STRSTARTS(?pathname, ?base), SUBSTR(?pathname, STRLEN(?base) + 1), "") AS ?under)
      # The path's segments (0), the fragment's (1) and the query's parameters (2), keyed in order.
      VALUES ?part { 0 1 2 }
      BIND(IF(?part = 0, ?under, IF(?part = 1, ?fragment, ?search)) AS ?src)
      BIND(IF(?part = 2, "[^&]+", "[^/]+") AS ?pattern)
      (?src ?pattern) sx:matches (?raw ?start)
      FILTER(?part < 2)
      BIND(CONCAT(STR(?part), SUBSTR("000000", STRLEN(STR(?start))), STR(?start)) AS ?k)
  } }
    # An address from before paths: its fragment's first segment is a top-level path dimension's (#docs/rules).
    BIND(EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kml ?ksl ?kl ?dsl ?el ?ol ?fll) FILTER(STRSTARTS(?kl, "1") && STRENDS(?fll, "0") && EXISTS { ?dl0 nav:carriedBy nav:Path FILTER(STR(?dl0) = ?dsl) FILTER NOT EXISTS { ?dl0 nav:parent ?pl0 } }
        && NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?slm ?sls ?slk) FILTER(STRSTARTS(?slk, "1") && ?slk < ?kl) }) } AS ?legacy)
    LATERAL { OPTIONAL {
      { # A segment read by the first dimension (in order) that knows it, opened by earlier segments and not read before;
         # every earlier segment of its part read.
        (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?km ?ks ?k ?ds ?e ?o ?fl) FILTER(IF(?legacy, STRSTARTS(?k, "1"), STRSTARTS(?k, "0") || (STRSTARTS(?k, "1") && STRSTARTS(?fl, "1"))) && STRENDS(?fl, "0")) BIND(IRI(?ds) AS ?d)
        FILTER NOT EXISTS { ?d nav:parent* ?xa . ?xa nav:parent ?ya .
        FILTER NOT EXISTS { ?xa nav:when ?wa . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmoa ?ksoa ?koa ?dsoa ?eoa ?ooa ?floa) FILTER(?koa < ?k && ?dsoa = STR(?ya) && IF(?legacy, STRSTARTS(?koa, "1"), STRSTARTS(?koa, "0") || (STRSTARTS(?koa, "1") && STRSTARTS(?floa, "1"))) && STRENDS(?floa, "0") && ?eoa = IF(isIRI(?wa), CONCAT("I", STR(?wa)), CONCAT("L", STR(DATATYPE(?wa)), " ", ENCODE_FOR_URI(STR(?wa))))) } }
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfa ?ksfa ?kfa ?dsfa ?efa ?ofa ?flfa) FILTER(?kfa < ?k && ?dsfa = ?ds && IF(?legacy, STRSTARTS(?kfa, "1"), STRSTARTS(?kfa, "0") || (STRSTARTS(?kfa, "1") && STRSTARTS(?flfa, "1"))) && STRENDS(?flfa, "0")) }
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmb ?ksb ?kb ?dsb ?eb ?ob ?flb) FILTER(?kb = ?k && ?dsb != ?ds && ?ob < ?o && IF(?legacy, STRSTARTS(?kb, "1"), STRSTARTS(?kb, "0") || (STRSTARTS(?kb, "1") && STRSTARTS(?flb, "1"))) && STRENDS(?flb, "0")) BIND(IRI(?dsb) AS ?db)
          FILTER NOT EXISTS { ?db nav:parent* ?xb . ?xb nav:parent ?yb .
        FILTER NOT EXISTS { ?xb nav:when ?wb . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmob ?ksob ?kob ?dsob ?eob ?oob ?flob) FILTER(?kob < ?k && ?dsob = STR(?yb) && IF(?legacy, STRSTARTS(?kob, "1"), STRSTARTS(?kob, "0") || (STRSTARTS(?kob, "1") && STRSTARTS(?flob, "1"))) && STRENDS(?flob, "0") && ?eob = IF(isIRI(?wb), CONCAT("I", STR(?wb)), CONCAT("L", STR(DATATYPE(?wb)), " ", ENCODE_FOR_URI(STR(?wb))))) } }
          FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfb ?ksfb ?kfb ?dsfb ?efb ?ofb ?flfb) FILTER(?kfb < ?k && ?dsfb = ?dsb && IF(?legacy, STRSTARTS(?kfb, "1"), STRSTARTS(?kfb, "0") || (STRSTARTS(?kfb, "1") && STRSTARTS(?flfb, "1"))) && STRENDS(?flfb, "0")) } }
        FILTER NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?sma ?ssa ?ja) FILTER(SUBSTR(?ja, 1, 1) = SUBSTR(?k, 1, 1) && ?ja < ?k)
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrua ?ksrua ?ja ?dsrua ?erua ?orua ?flrua) FILTER(IF(?legacy, STRSTARTS(?ja, "1"), STRSTARTS(?ja, "0") || (STRSTARTS(?ja, "1") && STRSTARTS(?flrua, "1"))) && STRENDS(?flrua, "0")) BIND(IRI(?dsrua) AS ?drua)
      FILTER NOT EXISTS { ?drua nav:parent* ?xrua . ?xrua nav:parent ?yrua .
        FILTER NOT EXISTS { ?xrua nav:when ?wrua . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmorua ?ksorua ?korua ?dsorua ?eorua ?oorua ?florua) FILTER(?korua < ?ja && ?dsorua = STR(?yrua) && IF(?legacy, STRSTARTS(?korua, "1"), STRSTARTS(?korua, "0") || (STRSTARTS(?korua, "1") && STRSTARTS(?florua, "1"))) && STRENDS(?florua, "0") && ?eorua = IF(isIRI(?wrua), CONCAT("I", STR(?wrua)), CONCAT("L", STR(DATATYPE(?wrua)), " ", ENCODE_FOR_URI(STR(?wrua))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrua ?ksfrua ?kfrua ?dsfrua ?efrua ?ofrua ?flfrua) FILTER(?kfrua < ?ja && ?dsfrua = ?dsrua && IF(?legacy, STRSTARTS(?kfrua, "1"), STRSTARTS(?kfrua, "0") || (STRSTARTS(?kfrua, "1") && STRSTARTS(?flfrua, "1"))) && STRENDS(?flfrua, "0")) } } }
        BIND(CONCAT("1\\t", ?ds, "\\t", ?e, "\\n") AS ?line)
      } UNION {
        # The first segment of the fragment nothing reads may name the target, and the values that show it.
        (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmt ?kst ?kt ?dst ?et ?ot ?flt) FILTER(IF(?legacy, STRSTARTS(?kt, "1"), STRSTARTS(?kt, "0") || (STRSTARTS(?kt, "1") && STRSTARTS(?flt, "1"))) && STRENDS(?flt, "1"))
        FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrt ?ksrt ?kt ?dsrt ?ert ?ort ?flrt) FILTER(IF(?legacy, STRSTARTS(?kt, "1"), STRSTARTS(?kt, "0") || (STRSTARTS(?kt, "1") && STRSTARTS(?flrt, "1"))) && STRENDS(?flrt, "0")) BIND(IRI(?dsrt) AS ?drt)
      FILTER NOT EXISTS { ?drt nav:parent* ?xrt . ?xrt nav:parent ?yrt .
        FILTER NOT EXISTS { ?xrt nav:when ?wrt . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmort ?ksort ?kort ?dsort ?eort ?oort ?flort) FILTER(?kort < ?kt && ?dsort = STR(?yrt) && IF(?legacy, STRSTARTS(?kort, "1"), STRSTARTS(?kort, "0") || (STRSTARTS(?kort, "1") && STRSTARTS(?flort, "1"))) && STRENDS(?flort, "0") && ?eort = IF(isIRI(?wrt), CONCAT("I", STR(?wrt)), CONCAT("L", STR(DATATYPE(?wrt)), " ", ENCODE_FOR_URI(STR(?wrt))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrt ?ksfrt ?kfrt ?dsfrt ?efrt ?ofrt ?flfrt) FILTER(?kfrt < ?kt && ?dsfrt = ?dsrt && IF(?legacy, STRSTARTS(?kfrt, "1"), STRSTARTS(?kfrt, "0") || (STRSTARTS(?kfrt, "1") && STRSTARTS(?flfrt, "1"))) && STRENDS(?flfrt, "0")) } }
        FILTER NOT EXISTS { (?S "([^\\\\n]+)\\\\n") sx:matches (?smt ?sst ?jt) FILTER(SUBSTR(?jt, 1, 1) = SUBSTR(?kt, 1, 1) && ?jt < ?kt)
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmrut ?ksrut ?jt ?dsrut ?erut ?orut ?flrut) FILTER(IF(?legacy, STRSTARTS(?jt, "1"), STRSTARTS(?jt, "0") || (STRSTARTS(?jt, "1") && STRSTARTS(?flrut, "1"))) && STRENDS(?flrut, "0")) BIND(IRI(?dsrut) AS ?drut)
      FILTER NOT EXISTS { ?drut nav:parent* ?xrut . ?xrut nav:parent ?yrut .
        FILTER NOT EXISTS { ?xrut nav:when ?wrut . (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmorut ?ksorut ?korut ?dsorut ?eorut ?oorut ?florut) FILTER(?korut < ?jt && ?dsorut = STR(?yrut) && IF(?legacy, STRSTARTS(?korut, "1"), STRSTARTS(?korut, "0") || (STRSTARTS(?korut, "1") && STRSTARTS(?florut, "1"))) && STRENDS(?florut, "0") && ?eorut = IF(isIRI(?wrut), CONCAT("I", STR(?wrut)), CONCAT("L", STR(DATATYPE(?wrut)), " ", ENCODE_FOR_URI(STR(?wrut))))) } }
      FILTER NOT EXISTS { (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmfrut ?ksfrut ?kfrut ?dsfrut ?efrut ?ofrut ?flfrut) FILTER(?kfrut < ?jt && ?dsfrut = ?dsrut && IF(?legacy, STRSTARTS(?kfrut, "1"), STRSTARTS(?kfrut, "0") || (STRSTARTS(?kfrut, "1") && STRSTARTS(?flfrut, "1"))) && STRENDS(?flfrut, "0")) } } }
        LATERAL { { BIND(CONCAT("0\\t", ?dst, "\\t", ?et, "\\n") AS ?line) }
        UNION
        { BIND(IRI(SUBSTR(?et, 2)) AS ?target) $this nav:root ?root .
          ?target (^nav:from/nav:to)* ?child . ?edge nav:from ?child ; nav:to ?parent . ?parent (^nav:from/nav:to)* ?root .
          ?child c:when ?when . ?parent c:cases ?anyCases ; c:controls ?controls ; c:property ?controlled .
          $this nav:dimensions/rdf:rest*/rdf:first ?shown . ?shown nav:subject ?controls ; nav:property ?controlled . FILTER NOT EXISTS { ?shown a nav:TargetDimension }
          BIND(CONCAT("0\\t", STR(?shown), "\\t", IF(isIRI(?when), CONCAT("I", STR(?when)), CONCAT("L", STR(DATATYPE(?when)), " ", ENCODE_FOR_URI(STR(?when)))), "\\n") AS ?line) } }
      }
    } }
  } GROUP BY ?K } } }
      # One value per dimension: the first priority, then the least.
      LATERAL { OPTIONAL { (?R "([0-9])\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?rm ?rs ?rp ?rd ?re)
        FILTER NOT EXISTS { (?R "([0-9])\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?rm2 ?rs2 ?rp2 ?rd ?re2) FILTER(?rp2 < ?rp || (?rp2 = ?rp && ?re2 < ?re)) }
        BIND(CONCAT(?rd, "\\t", ?re, "\\n") AS ?rline) } }
    } GROUP BY ?K } } }
    LATERAL { OPTIONAL {
      $this nav:dimensions/rdf:rest*/rdf:first ?d .
      OPTIONAL { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?vm ?vs ?vd ?ve) FILTER(?vd = STR(?d)) }
      # Left out (nav:implicit), on the path or in the fragment: each parent on the way up has, read or left out, a value it applies under.
      OPTIONAL { FILTER(!BOUND(?ve)) ?d nav:implicit ?implicit .
        FILTER NOT EXISTS { ?d a nav:TargetDimension } FILTER EXISTS { ?d nav:carriedBy ?ic FILTER(?ic IN (nav:Path, nav:Fragment)) }
        FILTER NOT EXISTS { ?d nav:parent* ?ix . ?ix nav:parent ?iy .
          FILTER NOT EXISTS { $this nav:dimensions/rdf:rest*/rdf:first ?iy . ?ix nav:when ?iw .
            FILTER(EXISTS { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?im ?is ?iyd ?iye) FILTER(?iyd = STR(?iy) && ?iye = IF(isIRI(?iw), CONCAT("I", STR(?iw)), CONCAT("L", STR(DATATYPE(?iw)), " ", ENCODE_FOR_URI(STR(?iw))))) }
                || (NOT EXISTS { (?read "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?im2 ?is2 ?iyd2 ?iye2) FILTER(?iyd2 = STR(?iy)) } && EXISTS { ?iy nav:implicit ?iw })) } } }
      # In the query.
      OPTIONAL { FILTER(!BOUND(?ve) && !BOUND(?implicit)) (?K "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?kmq ?ksq ?kq ?dsq ?eq ?oq ?flq) FILTER(STRSTARTS(?kq, "2") && ?dsq = STR(?d)) }
      BIND(COALESCE(?ve, IF(BOUND(?implicit), IF(isIRI(?implicit), CONCAT("I", STR(?implicit)), CONCAT("L", STR(DATATYPE(?implicit)), " ", ENCODE_FOR_URI(STR(?implicit)))), ?eq)) AS ?next)
      FILTER(BOUND(?next))
      BIND(CONCAT(STR(?d), "\\t", ?next, "\\n") AS ?nline)
    } }
  } } } }
  $this nav:dimensions/rdf:rest*/rdf:first ?d .
  ?d nav:subject ?subject ; nav:property ?property .
  FILTER EXISTS { ?d nav:carriedBy ?carrier FILTER(?carrier IN (nav:Path, nav:Fragment, nav:Query)) }
  BIND(EXISTS { ?d a nav:TargetDimension } AS ?isTarget)
  LATERAL { OPTIONAL { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm ?ns ?nd ?next0) FILTER(?nd = STR(?d))
    # It applies under what was read and where we are for the rest: each parent's value (read, else now) is one its child applies under.
    FILTER(?isTarget || NOT EXISTS { ?d nav:parent* ?x . ?x nav:parent ?y .
      FILTER NOT EXISTS { $this nav:dimensions/rdf:rest*/rdf:first ?y . ?x nav:when ?w .
        FILTER(EXISTS { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm2 ?ns2 ?yd ?ye) FILTER(?yd = STR(?y) && ?ye = IF(isIRI(?w), CONCAT("I", STR(?w)), CONCAT("L", STR(DATATYPE(?w)), " ", ENCODE_FOR_URI(STR(?w))))) }
            || (NOT EXISTS { (?N "([^\\\\t\\\\n]*)\\\\t([^\\\\t\\\\n]*)\\\\n") sx:matches (?nm3 ?ns3 ?yd3 ?ye3) FILTER(?yd3 = STR(?y)) } && EXISTS { ?y nav:subject ?ys ; nav:property ?yp . ?ys ?yp ?w })) } })
  } }
  BIND(IF(STRSTARTS(?next0, "I"), IRI(SUBSTR(?next0, 2)), STRDT(sx:decodeURI(STRAFTER(?next0, " ")), IRI(STRBEFORE(SUBSTR(?next0, 2), " ")))) AS ?next)
  # Always bound (a LATERAL group would bind an unbound ?next itself).
  BIND(COALESCE(?next, <urn:semblance:none>) AS ?given)
  # Unchanged when it is the one value now.
  BIND(BOUND(?next) && EXISTS { ?subject ?property ?next } && NOT EXISTS { ?subject ?property ?other FILTER(!sameTerm(?other, ?next)) } AS ?same)
  LATERAL { { FILTER(BOUND(?next) && !?same) }
  UNION
  { $this nav:dimensions/rdf:rest*/rdf:first ?td . ?td a nav:TargetDimension .
  FILTER(?d = ?td && !sameTerm(?given, <urn:semblance:none>))
  $this nav:root ?root .
  ?given (^nav:from/nav:to)* ?part . ?edge nav:from ?part ; nav:to ?container . ?container (^nav:from/nav:to)* ?root .
  ?class nav:reveal ?reveal . ?reveal nav:via ?via ; nav:sets ?sets .
  FILTER(STRSTARTS(STR(?edge), CONCAT(STR(?via), "/~up-")))
  ?container a/rdfs:subClassOf* ?class .
  OPTIONAL { ?reveal nav:value ?value0 }
  BIND(COALESCE(?value0, ?part) AS ?value)
  FILTER(!(EXISTS { ?container ?sets ?value } && NOT EXISTS { ?container ?sets ?otherValue FILTER(!sameTerm(?otherValue, ?value)) })) } }
}""" ;
    sem:function "navigation:follow" .

# What the effect reports (in the navigation graph, urn:semblance:navigation).
nav:address a owl:DatatypeProperty ; rdfs:domain nav:Location ;
    rdfs:label "Address"@en , "Адреса"@uk , "Adresse"@de , "العنوان"@ar ;
    rdfs:comment "The location as the URL carriers last spelled it (its query and fragment)."@en .
nav:revision a owl:DatatypeProperty ; rdfs:domain nav:Location ; rdfs:range xsd:integer ;
    rdfs:comment "How many times the effect reported the location; views of the reports follow it."@en .
nav:applies a owl:DatatypeProperty ; rdfs:domain nav:Dimension ; rdfs:range xsd:boolean ;
    rdfs:comment "Reported: whether the dimension is in scope now."@en .
nav:spelled a owl:DatatypeProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "Reported: how the address spells the dimension's value now (while it applies)."@en .

# --- where a resource is shown: links to things, not addresses -------------------------------------

# A link's c:to is a resource; the framework finds the location that shows it by walking up the
# component tree through these properties (lists are walked through their members), and at
# each c:Switch case collects the value of the dimension the switch follows (c:controls and
# c:property equal to the dimension's nav:subject and nav:property, c:when its value).
nav:ContainmentProperty a owl:Class ;
    rdfs:comment "A property that places components inside the component that has it (directly or as a list)."@en .
c:children a nav:ContainmentProperty . c:content a nav:ContainmentProperty . c:front a nav:ContainmentProperty .
c:back a nav:ContainmentProperty . c:body a nav:ContainmentProperty . c:cases a nav:ContainmentProperty .
c:tabs a nav:ContainmentProperty . c:actions a nav:ContainmentProperty . c:items a nav:ContainmentProperty .
c:primary a nav:ContainmentProperty . c:secondary a nav:ContainmentProperty . c:toolbar a nav:ContainmentProperty .
c:footer a nav:ContainmentProperty . c:hosts a nav:ContainmentProperty .

# Containers that hide what they hold until told: following a link to something inside one
# tells it (as part of the same step), whatever dimensions the location has.
nav:reveal a owl:ObjectProperty ; rdfs:range nav:Reveal ;
    rdfs:comment "On a component class: how an instance is made to show what it holds through nav:via."@en .
nav:Reveal a owl:Class ;
    rdfs:comment "Set nav:sets on the container to nav:value (default: the part on the way to the target)."@en .
nav:via a owl:ObjectProperty ; rdfs:domain nav:Reveal ; rdfs:range nav:ContainmentProperty .
nav:sets a owl:ObjectProperty ; rdfs:domain nav:Reveal ; rdfs:range rdf:Property .
nav:value a rdf:Property ;
    rdfs:comment "On a nav:Reveal: the value to set. Reported on a dimension: its value now."@en .
c:Tabs nav:reveal [ a nav:Reveal ; nav:via c:tabs ; nav:sets c:selected ] .
c:AccordionItem nav:reveal [ a nav:Reveal ; nav:via c:content ; nav:sets c:expanded ; nav:value true ] .
c:Flippable nav:reveal [ a nav:Reveal ; nav:via c:back ; nav:sets c:flipped ; nav:value true ] .
c:Window nav:reveal [ a nav:Reveal ; nav:via c:body ; nav:sets c:open ; nav:value true ] .

# Going somewhere from a reaction, as following a link to it would: the reaction inserts
# `?anything nav:goTo ?resource`, and the navigation effect (src/navigation.ts) takes the request
# out of the graph, spells the address of the location that shows the resource (as for a link's
# c:to), makes it a step Back returns to, and follows it (a nav:Navigate event; the resource is
# brought into view). A command palette's places are run this way.
nav:goTo a owl:ObjectProperty ;
    rdfs:label "Go to"@en , "Перейти до"@uk , "Gehe zu"@de , "انتقل إلى"@ar ;
    rdfs:comment "A request (in a reaction's inserts): go to the location that shows this resource, as a link to it (c:to) would. The navigation effect performs and removes it."@en .

nav:href a owl:DatatypeProperty ;
    rdfs:comment "Derived, on a c:Link with c:to: the URL fragment of the location that shows its target."@en .
# In the components' stratum, so links that other components mint (a reference's facets) get it too.
# --- the component tree, as edges (a building block for the destinations' SPARQL) -------------
# Each containment property (nav:ContainmentProperty) links a container to what it holds: directly,
# or through an RDF list of them. nav:Containment states each such link as an edge of its own
# (minted under the property: nav:from the part, nav:to the container), so a fixed property path
# (^nav:from/nav:to)* walks up the tree. Evaluated whether shown or not (sem:always): the tree is
# what the page is built from, read when the page loads.
nav:Containment a sem:BuildingBlock ;
    sem:targets nav:ContainmentProperty ;
    sem:stratum -30 ;
    sem:always true ;
    sem:watchesStatements true .
nav:Containment-fn a sem:Rule ; sem:implements nav:Containment ; sem:function "navigation:containment" .
nav:Containment-sparql a sem:Rule ;
    sem:implements nav:Containment ;
    sem:construct """
CONSTRUCT { ?edge nav:from ?child ; nav:to ?parent }
WHERE {
  $this a nav:ContainmentProperty .
  { ?parent $this ?child . FILTER(isIRI(?parent) && isIRI(?child)) }
  UNION
  { ?parent $this ?list . FILTER(isIRI(?parent) && !isIRI(?list)) ?list rdf:rest*/rdf:first ?child . FILTER(isIRI(?child)) }
  BIND(IRI(CONCAT(STR($this), "/~up-", MD5(CONCAT(STR(?parent), " ", STR(?child))))) AS ?edge)
}""" .
nav:from a owl:ObjectProperty ; rdfs:comment "A containment edge's part."@en .
nav:to a owl:ObjectProperty ; rdfs:comment "A containment edge's container."@en .

c:LinkDestination a sem:Rendering ; sem:targets c:Link ; sem:stratum 0 ; sem:requires c:to ; sem:readsLocation nav:TopDimensions .
c:LinkDestination-fn a sem:Rule ; sem:implements c:LinkDestination ; sem:function "navigation:link-destination" .
c:LinkDestination-sparql a sem:Rule ;
    sem:implements c:LinkDestination ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT { $this nav:href ?href . $this nav:keeps ?keptDim }
WHERE {
  $this c:to ?to . FILTER(isIRI(?to))
  ?loc a nav:Location ; nav:root ?root .
  BIND(EXISTS { ?to (^nav:from/nav:to)* ?root } AS ?shown)
  # A term no component shows: a class, a property, or named in an owl:Ontology's namespace.
  BIND(REPLACE(STR(?to), "[^#/]*$", "") AS ?ns)
  BIND(!?shown && (EXISTS { ?anyOf a ?to } || EXISTS { ?anyS ?to ?anyO }
       || EXISTS { ?onto a owl:Ontology FILTER(STR(?onto) = ?ns || STR(?onto) = SUBSTR(?ns, 1, STRLEN(?ns) - 1)) }) AS ?term)
  FILTER(?shown || ?term)
  # Path segments end with '/'; fragment ones start with '#' (only the first stays: the rest become '/').
  # Each dimension once: what shows the resource decides it (rank 0); the rest of where we are is
  # kept (rank 1: the top-level dimensions, nav:keeps). An implicit value is kept without a part.
  OPTIONAL { SELECT ?to ?loc (GROUP_CONCAT(IF(?part = "", "", IF(?inPath, CONCAT(?part, "/"), CONCAT("#", ?part))); separator="") AS ?parts)
                             (GROUP_CONCAT(IF(?kept, STR(?d), ""); separator=" ") AS ?keptList) (MAX(IF(?inPath, 1, 0)) AS ?pathRows) WHERE {
   { SELECT ?to ?loc ?d ?part ?kept ?inPath ?order WHERE {
    { SELECT ?to ?loc ?d (MIN(CONCAT(?prio, ?part0)) AS ?best) (SAMPLE(?inPath0) AS ?inPath) (SAMPLE(?order0) AS ?order) WHERE {
    { SELECT DISTINCT ?to ?loc ?d ?prio (?part AS ?part0) (?inPath AS ?inPath0) (?order AS ?order0) WHERE {
      { SELECT ?to ?loc ?d ?v ?prio WHERE {
        $this c:to ?to . ?loc a nav:Location ; nav:root ?root .
        {
          # Shown: the cases of the switches on the way down, and the target - unless it is a whole case.
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          ?to (^nav:from/nav:to)* ?root .
          ?to (^nav:from/nav:to)* ?casea .
      LATERAL { ?casea c:when ?v . ?edgea nav:from ?casea ; nav:to ?switcha .
        ?switcha c:cases ?casesa ; c:controls ?controlsa ; c:property ?propertya .
        ?d nav:subject ?controlsa ; nav:property ?propertya . FILTER NOT EXISTS { ?d a nav:TargetDimension } }
          # It applies: its parent dimension's value, from a case further up, is one it is shown under.
          OPTIONAL { ?d nav:parent ?pa }
          FILTER(!BOUND(?pa) || EXISTS { ?d nav:when ?pw . ?to (^nav:from/nav:to)* ?casec .
      LATERAL { ?casec c:when ?pw . ?edgec nav:from ?casec ; nav:to ?switchc .
        ?switchc c:cases ?casesc ; c:controls ?controlsc ; c:property ?propertyc .
        ?pa nav:subject ?controlsc ; nav:property ?propertyc . FILTER NOT EXISTS { ?pa a nav:TargetDimension } } })
        } UNION {
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          ?to (^nav:from/nav:to)* ?root .
          ?d a nav:TargetDimension ; nav:carriedBy nav:Fragment .
          FILTER NOT EXISTS { ?wholeEdge nav:from ?to ; nav:to ?wholeCase . ?wholeCase c:when ?w }
          BIND(?to AS ?v)
        } UNION {
          # Where we are, kept for what nothing on the way to it decides (ranked below what does):
          # the path's top-level dimensions (the language; the page, for what is on every page).
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("1" AS ?prio)
          ?loc nav:dimensions ?kh . ?kh rdf:rest* ?kc . ?kc rdf:first ?d .
          ?d nav:carriedBy nav:Path ; nav:subject ?ks ; nav:property ?kp .
          FILTER NOT EXISTS { ?d nav:parent ?kpar }
          FILTER NOT EXISTS { ?d a nav:TargetDimension }
          ?ks ?kp ?v .
        } UNION {
          # A term: the dimension whose values are terms, and what its parents need for it to apply.
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          FILTER NOT EXISTS { ?to (^nav:from/nav:to)* ?root }
          ?loc nav:dimensions ?termHead . ?termHead rdf:rest* ?termCell . ?termCell rdf:first ?termDim .
          ?termDim nav:showsTerms true ; nav:carriedBy ?termCarrier . FILTER(?termCarrier IN (nav:Path, nav:Fragment))
          { ?termDim nav:showsTerms true . BIND(?termDim AS ?d) } UNION { ?termDim nav:showsTerms true ; nav:parent* ?x . ?x nav:parent ?d ; nav:when ?when }
          BIND(IF(?d = ?termDim, ?to, ?when) AS ?v)
        }
      } }
      # The part of the address that spells it: the path when it is carried there, else the fragment.
      ?d nav:carriedBy ?dc . FILTER(?dc IN (nav:Path, nav:Fragment))
      FILTER(IF(EXISTS { ?d a nav:TargetDimension }, ?dc = nav:Fragment, ?dc = nav:Path || NOT EXISTS { ?d nav:carriedBy nav:Path }))
      BIND(?dc = nav:Path AS ?inPath)
      OPTIONAL { ?d nav:keyProperty ?keyPropertys }
      BIND(EXISTS { ?d nav:spelling nav:PrefixedName } AS ?prefixeds)
      OPTIONAL { FILTER(!?prefixeds) ?v ?keyPropertys ?ownKeys }
      OPTIONAL { FILTER(!?prefixeds) ?v sem:slug ?slugKeys }
      OPTIONAL { ?v nav:anchor ?anchors }
      BIND(COALESCE(IF(isLiteral(?ownKeys), STR(?ownKeys), ?none), IF(isLiteral(?slugKeys), STR(?slugKeys), ?none)) AS ?keys)
      # The longest namespace an IRI starts with (and that leaves a plain local name) spells it.
      LATERAL { OPTIONAL { SELECT ?v (MAX(CONCAT(SUBSTR("0000", STRLEN(STR(STRLEN(?pnss)))), STR(STRLEN(?pnss)), " ", ?pps, ":", STRAFTER(STR(?v), ?pnss))) AS ?bests) WHERE {
        { ?pnodes sem:prefixName ?pp0s ; sem:namespace ?pns0s } UNION { ?pnodes sh:prefix ?pp0s ; sh:namespace ?pns0s }
        BIND(STR(?pp0s) AS ?pps) BIND(STR(?pns0s) AS ?pnss)
        FILTER(isIRI(?v) && STRSTARTS(STR(?v), ?pnss) && REGEX(STRAFTER(STR(?v), ?pnss), "^[A-Za-z0-9_-]+$"))
      } GROUP BY ?v } }
      BIND(IF(isLiteral(?v), STR(?v),
           IF(EXISTS { ?d a nav:TargetDimension }, COALESCE(STR(?anchors), REPLACE(STR(?v), "^.*[#/]", "")),
           COALESCE(?keys, STRAFTER(?bests, " "), STR(?v)))) AS ?texts)
      # As encodeURIComponent writes it, with ':' and '@' kept readable.
      # The value the address leaves unspelled (nav:implicit) has no part.
      BIND(IF(EXISTS { ?d nav:implicit ?v }, "", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ENCODE_FOR_URI(?texts),
           "%3A", ":"), "%40", "@"), "%21", "!"), "%27", "'"), "%28", "("), "%29", ")"), "%2A", "*")) AS ?part)
      # Parents before their children, in the location's order; a parent not carried here after; the target last.
      # (From the location's list head forward: Oxigraph walks a list path from its far end slowly.)
      {{ SELECT ?d (COUNT(DISTINCT ?before) AS ?at) WHERE {{ ?l0 a nav:Location ; nav:dimensions ?h0 . ?h0 rdf:rest* ?before . ?before rdf:rest* ?c0 . ?c0 rdf:first ?d }} GROUP BY ?d }}
      OPTIONAL {{ ?d nav:parent ?p1 . {{ SELECT ?p1 (COUNT(DISTINCT ?before1) AS ?at1) WHERE {{ ?l1 a nav:Location ; nav:dimensions ?h1 . ?h1 rdf:rest* ?before1 . ?before1 rdf:rest* ?c1 . ?c1 rdf:first ?p1 }} GROUP BY ?p1 }} }}
      BIND(SUBSTR(CONCAT("000", STR(?at)), STRLEN(STR(?at)) + 1) AS ?own)
      # The path's dimensions first; a parent counts when the same part spells it.
      BIND(CONCAT(IF(?inPath, "0", "1"), IF(EXISTS {{ ?d a nav:TargetDimension }}, CONCAT("2", ?own),
           IF(!BOUND(?p1), CONCAT("0", ?own, "000"),
           IF(IF(?inPath, EXISTS {{ ?p1 nav:carriedBy nav:Path }}, EXISTS {{ ?p1 nav:carriedBy nav:Fragment }} && NOT EXISTS {{ ?p1 nav:carriedBy nav:Path }}), CONCAT("0", SUBSTR(CONCAT("000", STR(?at1)), STRLEN(STR(?at1)) + 1), ?own), CONCAT("1", ?own))))) AS ?order)
    } }
    } GROUP BY ?to ?loc ?d }
    BIND(SUBSTR(?best, 2) AS ?part)
    BIND(STRSTARTS(?best, "1") AS ?kept)
   } ORDER BY ?order }
  } GROUP BY ?to ?loc }
  BIND(COALESCE(?parts, "") AS ?all)
  BIND(IF(CONTAINS(?all, "#"), STRBEFORE(?all, "#"), ?all) AS ?pathParts)
  BIND(REPLACE(STRAFTER(?all, "#"), "#", "/") AS ?fragmentParts)
  # The location has paths when a dimension the path spells is among what the address is made of
  # (the language is, wherever where we are is kept). Read from the rows, not the location's list.
  BIND(COALESCE(?pathRows, 0) = 1 AS ?paths)
  OPTIONAL { ?loc nav:base ?base0 }
  BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
  BIND(IF(?paths, CONCAT(?base, ?pathParts, IF(CONTAINS(?all, "#"), CONCAT("#", ?fragmentParts), "")), CONCAT("#", ?fragmentParts)) AS ?href)
  # The dimensions it keeps (nav:keeps), whatever their value: a change of one re-runs it (sem:readsLocation).
  OPTIONAL { ?loc nav:dimensions ?kh2 . ?kh2 rdf:rest* ?kc2 . ?kc2 rdf:first ?keptDim .
    FILTER(CONTAINS(CONCAT(" ", ?keptList, " "), CONCAT(" ", STR(?keptDim), " "))) }
}""" .
# How each path dimension's current value is spelled (nav:currentPart), once per change of where
# we are, for the choosers' destinations below to join instead of spelling every value again.
nav:currentPart a owl:DatatypeProperty ; rdfs:domain nav:Dimension ;
    rdfs:comment "Derived: the path segment the dimension's current value is spelled as (absent when it is nav:implicit or has none)."@en .
nav:LocationSpelling a sem:Rendering ; sem:targets nav:Location ; sem:stratum 4 ; sem:always true ; sem:readsLocation true .
nav:LocationSpelling-fn a sem:Rule ; sem:implements nav:LocationSpelling ; sem:function "navigation:location-spelling" .
nav:LocationSpelling-sparql a sem:Rule ;
    sem:implements nav:LocationSpelling ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT { ?d nav:currentPart ?part }
WHERE {
  $this a nav:Location ; nav:dimensions ?h . ?h rdf:rest* ?c . ?c rdf:first ?d .
  ?d nav:carriedBy nav:Path ; nav:subject ?s ; nav:property ?p . FILTER NOT EXISTS { ?d a nav:TargetDimension }
  ?s ?p ?v .
  FILTER NOT EXISTS { ?d nav:implicit ?v }
  OPTIONAL { ?d nav:keyProperty ?keyPropertys }
  BIND(EXISTS { ?d nav:spelling nav:PrefixedName } AS ?prefixeds)
  OPTIONAL { FILTER(!?prefixeds) ?v ?keyPropertys ?ownKeys }
  OPTIONAL { FILTER(!?prefixeds) ?v sem:slug ?slugKeys }
  BIND(COALESCE(IF(isLiteral(?ownKeys), STR(?ownKeys), ?none), IF(isLiteral(?slugKeys), STR(?slugKeys), ?none)) AS ?keys)
  LATERAL { OPTIONAL { SELECT ?v (MAX(CONCAT(SUBSTR("0000", STRLEN(STR(STRLEN(?pnss)))), STR(STRLEN(?pnss)), " ", ?pps, ":", STRAFTER(STR(?v), ?pnss))) AS ?bests) WHERE {
    { ?pnodes sem:prefixName ?pp0s ; sem:namespace ?pns0s } UNION { ?pnodes sh:prefix ?pp0s ; sh:namespace ?pns0s }
    BIND(STR(?pp0s) AS ?pps) BIND(STR(?pns0s) AS ?pnss)
    FILTER(isIRI(?v) && STRSTARTS(STR(?v), ?pnss) && REGEX(STRAFTER(STR(?v), ?pnss), "^[A-Za-z0-9_-]+$"))
  } GROUP BY ?v } }
  BIND(IF(isLiteral(?v), STR(?v), COALESCE(?keys, STRAFTER(?bests, " "), STR(?v))) AS ?texts)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ENCODE_FOR_URI(?texts),
       "%3A", ":"), "%40", "@"), "%21", "!"), "%27", "'"), "%28", "("), "%29", ")"), "%2A", "*") AS ?part)
}""" .

# A chooser of a place the path carries (a c:Segmented or c:NavList over a site's pages, its docs
# sections): each option submits to the address it sets, the rest of where we are kept (the
# language, the sections the page remembers). The chooser renders a form of submit buttons over
# such a dimension (c:SegmentedRendering), so the options go there before and without scripts.
# One level of nav:parent is followed for what applies (a section under the page it sets). Above
# the chooser's rendering (0) and the location's spelling (4). An option is spelled by its key
# (nav:keyProperty, else sem:slug).
c:SegmentedDestination a sem:Rendering ; sem:targets c:Segmented ; sem:stratum 5 ; sem:requires c:controls ; sem:readsLocation true ;
    sem:watches c:controls , c:property , c:selects ; sem:readsMinted true .
c:SegmentedDestination-fn a sem:Rule ; sem:implements c:SegmentedDestination ; sem:function "navigation:segmented-destination" .
c:SegmentedDestination-sparql a sem:Rule ;
    sem:implements c:SegmentedDestination ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT { ?button rdfhtml:attribute ?attr . ?attr a rdfhtml:Attribute ; rdfhtml:attributeName "formaction" ; rdfhtml:attributeValue ?href }
WHERE {
  $this c:controls ?target ; c:property ?property .
  ?loc a nav:Location ; nav:dimensions ?h . ?h rdf:rest* ?hc . ?hc rdf:first ?d .
  ?d nav:subject ?target ; nav:property ?property ; nav:carriedBy nav:Path . FILTER NOT EXISTS { ?d a nav:TargetDimension }
  # The options as the chooser's rendering finds them, and the button it mints for each (looked up, not scanned).
  { $this c:options/rdf:rest*/rdf:first ?opt } UNION { FILTER NOT EXISTS { $this c:options ?explicit } ?property rdfs:range ?range . ?opt a ?range }
  BIND(IRI(CONCAT(STR($this), "/~opt-", ENCODE_FOR_URI(STR(?opt)))) AS ?button)
  ?button c:selects ?opt .
  OPTIONAL { SELECT ?button (GROUP_CONCAT(?part; separator="") AS ?parts) WHERE {
    { SELECT DISTINCT ?button ?d2 ?part ?at WHERE {
      $this c:controls ?target ; c:property ?property .
      ?loc a nav:Location ; nav:dimensions ?h . ?h rdf:rest* ?hc . ?hc rdf:first ?d .
      ?d nav:subject ?target ; nav:property ?property ; nav:carriedBy nav:Path . FILTER NOT EXISTS { ?d a nav:TargetDimension }
      { $this c:options/rdf:rest*/rdf:first ?opt } UNION { FILTER NOT EXISTS { $this c:options ?explicit } ?property rdfs:range ?range . ?opt a ?range }
      BIND(IRI(CONCAT(STR($this), "/~opt-", ENCODE_FOR_URI(STR(?opt)))) AS ?button)
      ?button c:selects ?opt .
      # Each path dimension: the option, spelled by its key, for its own; its current part for the others.
      ?loc nav:dimensions ?h2 . ?h2 rdf:rest* ?c2 . ?c2 rdf:first ?d2 .
      ?d2 nav:carriedBy nav:Path . FILTER NOT EXISTS { ?d2 a nav:TargetDimension }
      OPTIONAL { ?d2 nav:currentPart ?curPart }
      OPTIONAL { ?d nav:keyProperty ?optKeyProperty }
      OPTIONAL { ?opt ?optKeyProperty ?optKey0 FILTER(isLiteral(?optKey0)) }
      OPTIONAL { ?opt sem:slug ?optSlug FILTER(isLiteral(?optSlug)) }
      BIND(IF(EXISTS { ?d nav:implicit ?opt }, ?none, REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ENCODE_FOR_URI(STR(COALESCE(?optKey0, ?optSlug, ?opt))),
           "%3A", ":"), "%40", "@"), "%21", "!"), "%27", "'"), "%28", "("), "%29", ")"), "%2A", "*")) AS ?optPart)
      BIND(IF(?d2 = ?d, ?optPart, ?curPart) AS ?part0)
      FILTER(BOUND(?part0))
      # It applies: no parent, or its parent's value (the option, or the parent's current one) is one it applies under.
      OPTIONAL { ?d2 nav:parent ?par }
      OPTIONAL { ?d2 nav:parent ?par . ?par nav:subject ?ps ; nav:property ?pp . ?ps ?pp ?parCur }
      BIND(IF(BOUND(?par), IF(?par = ?d, ?opt, ?parCur), ?none) AS ?parV)
      FILTER(!BOUND(?par) || EXISTS { ?d2 nav:when ?parV })
      BIND(CONCAT(?part0, "/") AS ?part)
      {{ SELECT ?d2 (COUNT(DISTINCT ?before) AS ?at) WHERE {{ ?l0 a nav:Location ; nav:dimensions ?h0 . ?h0 rdf:rest* ?before . ?before rdf:rest* ?c0 . ?c0 rdf:first ?d2 }} GROUP BY ?d2 }}
    } ORDER BY ?at }
  } GROUP BY ?button }
  OPTIONAL { ?loc nav:base ?base0 }
  BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
  BIND(CONCAT(?base, COALESCE(?parts, "")) AS ?href)
  BIND(IRI(CONCAT(STR(?button), "-formaction")) AS ?attr)
}""" .

# The current page: a link that goes to the address the location shows now (nav:address, as the
# navigation effect reports it; its fragment, which is what links spell) is nav:current, and its
# rendering marks it aria-current=page as if it said c:currentPage (unless it says c:currentPage
# false). The rule is focused on the location: a step costs the links to the old and the new
# address, found by their address, not every link.
nav:current a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "Derived, on a c:Link: it goes to the address the location shows now."@en .
c:LinkCurrent a sem:Rendering ; sem:targets nav:Location ; sem:stratum 0 ; sem:always true .
c:LinkCurrent-fn a sem:Rule ; sem:implements c:LinkCurrent ; sem:function "navigation:link-current" .
c:LinkCurrent-sparql a sem:Rule ; sem:implements c:LinkCurrent ;
    sem:construct """
CONSTRUCT { ?link nav:current true }
WHERE {
  $this a nav:Location ; nav:address ?address .
  # Links spell a path and its fragment, or the fragment alone: the address without its query.
  BIND(REPLACE(?address, "[?][^#]*", "") AS ?bare)
  BIND(IF(STRSTARTS(?bare, "/"), ?bare, IF(CONTAINS(?bare, "#"), CONCAT("#", STRAFTER(?bare, "#")), "#")) AS ?fragment)
  { ?link nav:href ?fragment } UNION { ?link c:href ?fragment FILTER NOT EXISTS { ?link nav:href ?any } }
  ?link a/rdfs:subClassOf* c:Link .
}""" .
# An app bar's c:to (its home) is resolved the same way, for the link its logo and name make.
c:AppBarDestination a sem:Rendering ; sem:targets c:AppBar ; sem:stratum 0 ; sem:requires c:to ; sem:readsLocation nav:TopDimensions .
c:AppBarDestination-fn a sem:Rule ; sem:implements c:AppBarDestination ; sem:function "navigation:link-destination" .
c:AppBarDestination-sparql a sem:Rule ;
    sem:implements c:AppBarDestination ;
    sem:bulk false ;
    sem:construct """
CONSTRUCT { $this nav:href ?href . $this nav:keeps ?keptDim }
WHERE {
  $this c:to ?to . FILTER(isIRI(?to))
  ?loc a nav:Location ; nav:root ?root .
  BIND(EXISTS { ?to (^nav:from/nav:to)* ?root } AS ?shown)
  # A term no component shows: a class, a property, or named in an owl:Ontology's namespace.
  BIND(REPLACE(STR(?to), "[^#/]*$", "") AS ?ns)
  BIND(!?shown && (EXISTS { ?anyOf a ?to } || EXISTS { ?anyS ?to ?anyO }
       || EXISTS { ?onto a owl:Ontology FILTER(STR(?onto) = ?ns || STR(?onto) = SUBSTR(?ns, 1, STRLEN(?ns) - 1)) }) AS ?term)
  FILTER(?shown || ?term)
  # Path segments end with '/'; fragment ones start with '#' (only the first stays: the rest become '/').
  # Each dimension once: what shows the resource decides it (rank 0); the rest of where we are is
  # kept (rank 1: the top-level dimensions, nav:keeps). An implicit value is kept without a part.
  OPTIONAL { SELECT ?to ?loc (GROUP_CONCAT(IF(?part = "", "", IF(?inPath, CONCAT(?part, "/"), CONCAT("#", ?part))); separator="") AS ?parts)
                             (GROUP_CONCAT(IF(?kept, STR(?d), ""); separator=" ") AS ?keptList) (MAX(IF(?inPath, 1, 0)) AS ?pathRows) WHERE {
   { SELECT ?to ?loc ?d ?part ?kept ?inPath ?order WHERE {
    { SELECT ?to ?loc ?d (MIN(CONCAT(?prio, ?part0)) AS ?best) (SAMPLE(?inPath0) AS ?inPath) (SAMPLE(?order0) AS ?order) WHERE {
    { SELECT DISTINCT ?to ?loc ?d ?prio (?part AS ?part0) (?inPath AS ?inPath0) (?order AS ?order0) WHERE {
      { SELECT ?to ?loc ?d ?v ?prio WHERE {
        $this c:to ?to . ?loc a nav:Location ; nav:root ?root .
        {
          # Shown: the cases of the switches on the way down, and the target - unless it is a whole case.
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          ?to (^nav:from/nav:to)* ?root .
          ?to (^nav:from/nav:to)* ?casea .
      LATERAL { ?casea c:when ?v . ?edgea nav:from ?casea ; nav:to ?switcha .
        ?switcha c:cases ?casesa ; c:controls ?controlsa ; c:property ?propertya .
        ?d nav:subject ?controlsa ; nav:property ?propertya . FILTER NOT EXISTS { ?d a nav:TargetDimension } }
          # It applies: its parent dimension's value, from a case further up, is one it is shown under.
          OPTIONAL { ?d nav:parent ?pa }
          FILTER(!BOUND(?pa) || EXISTS { ?d nav:when ?pw . ?to (^nav:from/nav:to)* ?casec .
      LATERAL { ?casec c:when ?pw . ?edgec nav:from ?casec ; nav:to ?switchc .
        ?switchc c:cases ?casesc ; c:controls ?controlsc ; c:property ?propertyc .
        ?pa nav:subject ?controlsc ; nav:property ?propertyc . FILTER NOT EXISTS { ?pa a nav:TargetDimension } } })
        } UNION {
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          ?to (^nav:from/nav:to)* ?root .
          ?d a nav:TargetDimension ; nav:carriedBy nav:Fragment .
          FILTER NOT EXISTS { ?wholeEdge nav:from ?to ; nav:to ?wholeCase . ?wholeCase c:when ?w }
          BIND(?to AS ?v)
        } UNION {
          # Where we are, kept for what nothing on the way to it decides (ranked below what does):
          # the path's top-level dimensions (the language; the page, for what is on every page).
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("1" AS ?prio)
          ?loc nav:dimensions ?kh . ?kh rdf:rest* ?kc . ?kc rdf:first ?d .
          ?d nav:carriedBy nav:Path ; nav:subject ?ks ; nav:property ?kp .
          FILTER NOT EXISTS { ?d nav:parent ?kpar }
          FILTER NOT EXISTS { ?d a nav:TargetDimension }
          ?ks ?kp ?v .
        } UNION {
          # A term: the dimension whose values are terms, and what its parents need for it to apply.
          $this c:to ?to . ?loc a nav:Location ; nav:root ?root . BIND("0" AS ?prio)
          FILTER NOT EXISTS { ?to (^nav:from/nav:to)* ?root }
          ?loc nav:dimensions ?termHead . ?termHead rdf:rest* ?termCell . ?termCell rdf:first ?termDim .
          ?termDim nav:showsTerms true ; nav:carriedBy ?termCarrier . FILTER(?termCarrier IN (nav:Path, nav:Fragment))
          { ?termDim nav:showsTerms true . BIND(?termDim AS ?d) } UNION { ?termDim nav:showsTerms true ; nav:parent* ?x . ?x nav:parent ?d ; nav:when ?when }
          BIND(IF(?d = ?termDim, ?to, ?when) AS ?v)
        }
      } }
      # The part of the address that spells it: the path when it is carried there, else the fragment.
      ?d nav:carriedBy ?dc . FILTER(?dc IN (nav:Path, nav:Fragment))
      FILTER(IF(EXISTS { ?d a nav:TargetDimension }, ?dc = nav:Fragment, ?dc = nav:Path || NOT EXISTS { ?d nav:carriedBy nav:Path }))
      BIND(?dc = nav:Path AS ?inPath)
      OPTIONAL { ?d nav:keyProperty ?keyPropertys }
      BIND(EXISTS { ?d nav:spelling nav:PrefixedName } AS ?prefixeds)
      OPTIONAL { FILTER(!?prefixeds) ?v ?keyPropertys ?ownKeys }
      OPTIONAL { FILTER(!?prefixeds) ?v sem:slug ?slugKeys }
      OPTIONAL { ?v nav:anchor ?anchors }
      BIND(COALESCE(IF(isLiteral(?ownKeys), STR(?ownKeys), ?none), IF(isLiteral(?slugKeys), STR(?slugKeys), ?none)) AS ?keys)
      # The longest namespace an IRI starts with (and that leaves a plain local name) spells it.
      LATERAL { OPTIONAL { SELECT ?v (MAX(CONCAT(SUBSTR("0000", STRLEN(STR(STRLEN(?pnss)))), STR(STRLEN(?pnss)), " ", ?pps, ":", STRAFTER(STR(?v), ?pnss))) AS ?bests) WHERE {
        { ?pnodes sem:prefixName ?pp0s ; sem:namespace ?pns0s } UNION { ?pnodes sh:prefix ?pp0s ; sh:namespace ?pns0s }
        BIND(STR(?pp0s) AS ?pps) BIND(STR(?pns0s) AS ?pnss)
        FILTER(isIRI(?v) && STRSTARTS(STR(?v), ?pnss) && REGEX(STRAFTER(STR(?v), ?pnss), "^[A-Za-z0-9_-]+$"))
      } GROUP BY ?v } }
      BIND(IF(isLiteral(?v), STR(?v),
           IF(EXISTS { ?d a nav:TargetDimension }, COALESCE(STR(?anchors), REPLACE(STR(?v), "^.*[#/]", "")),
           COALESCE(?keys, STRAFTER(?bests, " "), STR(?v)))) AS ?texts)
      # As encodeURIComponent writes it, with ':' and '@' kept readable.
      # The value the address leaves unspelled (nav:implicit) has no part.
      BIND(IF(EXISTS { ?d nav:implicit ?v }, "", REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ENCODE_FOR_URI(?texts),
           "%3A", ":"), "%40", "@"), "%21", "!"), "%27", "'"), "%28", "("), "%29", ")"), "%2A", "*")) AS ?part)
      # Parents before their children, in the location's order; a parent not carried here after; the target last.
      # (From the location's list head forward: Oxigraph walks a list path from its far end slowly.)
      {{ SELECT ?d (COUNT(DISTINCT ?before) AS ?at) WHERE {{ ?l0 a nav:Location ; nav:dimensions ?h0 . ?h0 rdf:rest* ?before . ?before rdf:rest* ?c0 . ?c0 rdf:first ?d }} GROUP BY ?d }}
      OPTIONAL {{ ?d nav:parent ?p1 . {{ SELECT ?p1 (COUNT(DISTINCT ?before1) AS ?at1) WHERE {{ ?l1 a nav:Location ; nav:dimensions ?h1 . ?h1 rdf:rest* ?before1 . ?before1 rdf:rest* ?c1 . ?c1 rdf:first ?p1 }} GROUP BY ?p1 }} }}
      BIND(SUBSTR(CONCAT("000", STR(?at)), STRLEN(STR(?at)) + 1) AS ?own)
      # The path's dimensions first; a parent counts when the same part spells it.
      BIND(CONCAT(IF(?inPath, "0", "1"), IF(EXISTS {{ ?d a nav:TargetDimension }}, CONCAT("2", ?own),
           IF(!BOUND(?p1), CONCAT("0", ?own, "000"),
           IF(IF(?inPath, EXISTS {{ ?p1 nav:carriedBy nav:Path }}, EXISTS {{ ?p1 nav:carriedBy nav:Fragment }} && NOT EXISTS {{ ?p1 nav:carriedBy nav:Path }}), CONCAT("0", SUBSTR(CONCAT("000", STR(?at1)), STRLEN(STR(?at1)) + 1), ?own), CONCAT("1", ?own))))) AS ?order)
    } }
    } GROUP BY ?to ?loc ?d }
    BIND(SUBSTR(?best, 2) AS ?part)
    BIND(STRSTARTS(?best, "1") AS ?kept)
   } ORDER BY ?order }
  } GROUP BY ?to ?loc }
  BIND(COALESCE(?parts, "") AS ?all)
  BIND(IF(CONTAINS(?all, "#"), STRBEFORE(?all, "#"), ?all) AS ?pathParts)
  BIND(REPLACE(STRAFTER(?all, "#"), "#", "/") AS ?fragmentParts)
  # The location has paths when a dimension the path spells is among what the address is made of
  # (the language is, wherever where we are is kept). Read from the rows, not the location's list.
  BIND(COALESCE(?pathRows, 0) = 1 AS ?paths)
  OPTIONAL { ?loc nav:base ?base0 }
  BIND(IF(STRENDS(STR(COALESCE(?base0, "/")), "/"), STR(COALESCE(?base0, "/")), CONCAT(STR(?base0), "/")) AS ?base)
  BIND(IF(?paths, CONCAT(?base, ?pathParts, IF(CONTAINS(?all, "#"), CONCAT("#", ?fragmentParts), "")), CONCAT("#", ?fragmentParts)) AS ?href)
  # The dimensions it keeps (nav:keeps), whatever their value: a change of one re-runs it (sem:readsLocation).
  OPTIONAL { ?loc nav:dimensions ?kh2 . ?kh2 rdf:rest* ?kc2 . ?kc2 rdf:first ?keptDim .
    FILTER(CONTAINS(CONCAT(" ", ?keptList, " "), CONCAT(" ", STR(?keptDim), " "))) }
}""" .
