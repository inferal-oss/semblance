@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix net: <https://semblance.dev/ns/network#> .
@prefix http: <http://www.w3.org/2011/http#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .

# Inspection gallery: the toolbar pieces. A filter bar is a c:Toolbar of controls bound to one
# node's properties (here ui:in-tb-filter; a data grid's filters are such nodes), a legend draws
# categories in their colors, a live indicator shows and flips a boolean, and a count badge
# counts a collection's members.

ui:in-toolbar a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:in-tb-toolbar ui:in-tb-legend ui:in-tb-live ui:in-tb-count ) .

# --- toolbar: search, a choice, a switch and buttons, all bound to one node -------------------------

ui:in-tb-text a owl:DatatypeProperty ; rdfs:label "search text"@en .
ui:in-tb-kind a owl:ObjectProperty ; rdfs:label "Activity"@en .
ui:in-tb-older a owl:DatatypeProperty ; rdfs:label "Previous page loads"@en .
ui:in-tb-filter ui:in-tb-kind ui:in-tb-all ; ui:in-tb-older true .
ui:in-tb-all rdfs:label "All activity"@en .

ui:in-tb-search a c:SearchField ; c:label "Filter entries" ; c:placeholder "Filter URL, event or correlation…" ;
    c:controls ui:in-tb-filter ; c:property ui:in-tb-text .
ui:in-tb-choice a c:Choice ; c:controls ui:in-tb-filter ; c:property ui:in-tb-kind ;
    c:options ( ui:in-tb-all net:HttpKind net:SocketKind net:FrameKind net:EventKind ) .
ui:in-tb-switch a c:ToggleSwitch ; c:label "Previous page loads" ; sty:size sty:Small ;
    c:controls ui:in-tb-filter ; c:property ui:in-tb-older .
ui:in-tb-spacer a c:Spacer .
ui:in-tb-clear a c:Button ; c:label "Clear" ; sty:size sty:Small ; sty:intent sty:Secondary .
ui:in-tb-bar a c:Toolbar ; c:label "Filters" ;
    c:children ( ui:in-tb-search ui:in-tb-choice ui:in-tb-switch ui:in-tb-spacer ui:in-tb-clear ) .
ui:in-tb-state a c:Metrics ; c:of ui:in-tb-filter ; c:fields ( ui:in-tb-text ui:in-tb-kind ui:in-tb-older ) .
ui:in-tb-toolbar a c:Flippable ; c:front ui:in-tb-toolbar-spec .
ui:in-tb-toolbar-spec a c:Specimen ; c:label "Toolbar and search field" ;
    c:help "A filter bar: a c:Toolbar (role=toolbar) of controls that each edit one property of the same node. The search field writes what is typed (and removes it when emptied, with ✕ or Escape); the chips below read the node back." ;
    c:children ( ui:in-tb-bar ui:in-tb-state ) .

# --- legend: categories drawn in their colors ----------------------------------------------------------

ui:in-tb-kinds a c:Legend ; c:label "Activity kinds" ; c:of net:Kind .
ui:in-tb-statuses a c:Legend ; c:label "Statuses" ; c:items ( net:Pending net:Complete net:Failed net:Open net:Closed ) .
ui:in-tb-legend a c:Flippable ; c:front ui:in-tb-legend-spec .
ui:in-tb-legend-spec a c:Specimen ; c:label "Legend" ;
    c:help "Swatches and labels for categories: the instances of a class by sem:order (network activity kinds, each drawn in its c:swatch series color), or an explicit list (statuses, which are states and so carry a sty:tone instead)." ;
    c:children ( ui:in-tb-kinds ui:in-tb-statuses ) .

# --- live indicator: a boolean, shown and flipped -------------------------------------------------------

ui:in-tb-recorder ui:in-tb-recording true .
ui:in-tb-recording a owl:DatatypeProperty ; rdfs:label "recording"@en .
ui:in-tb-live-capture a c:LiveIndicator ; c:controls ui:in-tb-recorder ; c:property ui:in-tb-recording .
ui:in-tb-live-own a c:LiveIndicator ; c:label "Live" ; c:pausedLabel "Frozen" .
ui:in-tb-live-state a c:Metrics ; c:of ui:in-tb-recorder ; c:fields ( ui:in-tb-recording ) .
ui:in-tb-live a c:Flippable ; c:front ui:in-tb-live-spec .
ui:in-tb-live-spec a c:Specimen ; c:label "Live indicator" ;
    c:help "Whether something is live: a boolean on a node (absent counts as live), shown as a breathing dot and a word. It is a toggle button: pressing it flips the boolean. The second keeps its state on itself (c:checked) and names both states." ;
    c:children ( ui:in-tb-live-capture ui:in-tb-live-own ui:in-tb-live-state ) .

# --- count badge: members of a collection -----------------------------------------------------------

ui:in-tb-stream tree:member ui:in-tb-e1 , ui:in-tb-e2 , ui:in-tb-e3 .
ui:in-tb-e1 a net:Exchange . ui:in-tb-e2 a net:Exchange . ui:in-tb-e3 a net:Event .
ui:in-tb-count-all a c:CountBadge ; c:label "entries" ; c:collection ui:in-tb-stream .
ui:in-tb-count-http a c:CountBadge ; c:label "exchanges" ; c:collection ui:in-tb-stream ; c:memberClass net:Exchange ; sty:tone sty:Info .
ui:in-tb-count-capture a c:CountBadge ; c:label "captured" ; c:collection net:Capture ; sty:tone sty:Accent .
ui:in-tb-add a c:Button ; c:label "Add an event" ; sty:size sty:Small .
ui:InTbAdd a beh:Reaction ; beh:when beh:Click ; beh:source ui:in-tb-add ;
    beh:inserts """CONSTRUCT { ui:in-tb-stream tree:member ?new . ?new a net:Event }
WHERE { { SELECT (COUNT(?m) AS ?n) WHERE { ui:in-tb-stream tree:member ?m } } BIND(IRI(CONCAT(STR(ui:in-tb-e), STR(?n + 1))) AS ?new) }""" .
ui:in-tb-counts a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:Center ;
    c:children ( ui:in-tb-count-all ui:in-tb-count-http ui:in-tb-count-capture ui:in-tb-add ) .
ui:in-tb-count a c:Flippable ; c:front ui:in-tb-count-spec .
ui:in-tb-count-spec a c:Specimen ; c:label "Count badge" ;
    c:help "The number of members of a collection (tree:member by default), or only those of a class; the last counts what the network capture holds (net:Capture). Adding a member updates the count." ;
    c:children ( ui:in-tb-counts ) .
