# --- contrast composes with every theme -----------------------------------------------------

ui:th-contrast a c:Flippable ; c:front ui:th-contrast-spec .
ui:th-contrast-spec a c:Specimen ;
    c:label "Contrast composes" , "Контраст поєднується з темою"@uk , "Kontrast lässt sich kombinieren"@de , "التباين يتكامل مع السمة"@ar ;
    c:help "With the interface at standard contrast, the right-hand tiles add sty:contrast sty:HighContrast (set High above and every tile gets it). Under a theme it is restated in terms of that theme's own ramps - text pushed toward black or white, borders at step 10, the accent at steps 11-12 - so high contrast keeps each theme's hue instead of falling back to the default's violet. The structural themes also draw their focus outline heavier (3px, black or white) and outside the control. Where both meet on one element, sty:contrast sty:overrides sty:theme orders them." ;
    c:children ( ui:th-contrast-grid ) .
ui:th-paper-standard a c:Surface ; sty:theme sty:Paper ; sty:contrast sty:StandardContrast ; pos:direction pos:Column ; pos:gap tok:space-2 ; pos:inset tok:space-4 ;
    c:children ( ui:th-paper-standard-name ui:th-paper-standard-text ui:th-paper-standard-muted ui:th-paper-standard-row ) .
