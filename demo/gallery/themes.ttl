ui:th-frames a c:Flippable ; c:front ui:th-frames-spec .
ui:th-frames-spec a c:Specimen ;
    c:label "Frames and menus" , "Рамки й меню"@uk , "Rahmen und Menüs"@de , "الإطارات والقوائم"@ar ;
    c:help "A c:Window holding a dialog's parts, a c:Palette and a c:Menu (open it), laid out in place (a frame outside a c:Desktop is shown where it stands, by a rule of this page) under each theme. The title bar is the same rendering everywhere - a title and the controls of the frame's capabilities, in a fixed order - and each theme rebuilds it: traffic lights on the left with the title centred, a yellow tab as wide as its title with a close box and a zoom box, a navy caption with square buttons on the right, a ruled-off heading with doodled circles. Drag, maximize and minimize them; the button brings them all back." ;
    c:children ( ui:thf-reopen ui:th-frames-grid ) .
ui:thf-reopen a c:Button ; c:label "Bring the frames back" , "Повернути рамки"@uk , "Rahmen zurückholen"@de , "إعادة الإطارات"@ar ; c:icon "↺" ; sty:emphasis sty:Outline ; sty:size sty:Small ;
    c:opens ui:thf-semblance-window , ui:thf-semblance-palette , ui:thf-cupertino-window , ui:thf-cupertino-palette , ui:thf-tracker-window , ui:thf-tracker-palette , ui:thf-classic-window , ui:thf-classic-palette , ui:thf-doodle-window , ui:thf-doodle-palette .
ui:th-frames-grid a c:Grid ; c:minWidth "300px" ; pos:gap tok:space-4 ;
    c:children ( ui:thf-semblance ui:thf-cupertino ui:thf-tracker ui:thf-classic ui:thf-doodle ) .

ui:thf-semblance a c:Surface ; sty:theme sty:Semblance ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-4 ;
    c:children ( ui:thf-semblance-name ui:thf-semblance-window ui:thf-semblance-palette ui:thf-semblance-menu ) .
ui:thf-semblance-name a c:Text ; sty:textStyle sty:Overline ; c:label "Semblance" .
ui:thf-semblance-window a c:Window ; c:title "Rename graph" , "Перейменувати граф"@uk , "Graph umbenennen"@de , "إعادة تسمية الرسم البياني"@ar ; c:open true ;
    c:x 0 ; c:y 0 ; c:width 300 ; c:height 258 ; c:windowState c:Normal ; c:attachedTo c:NoEdge ;
    c:body ui:thf-semblance-dialog .
ui:thf-semblance-dialog a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:thf-semblance-desc ui:thf-semblance-field ui:thf-semblance-buttons ) .
ui:thf-semblance-desc a c:Text ; sty:textStyle sty:Caption ; c:label "The new name is written to the graph when you save." .
ui:thf-semblance-field a c:TextField ; c:label "Name" ; c:value "Todo graph" .
ui:thf-semblance-buttons a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:thf-semblance-cancel ui:thf-semblance-save ) .
ui:thf-semblance-cancel a c:Button ; c:label "Cancel" ; sty:emphasis sty:Outline ; c:closes ui:thf-semblance-window .
ui:thf-semblance-save a c:Button ; c:label "Save" ; sty:intent sty:Primary ; c:closes ui:thf-semblance-window .
ui:thf-semblance-palette a c:Palette ; c:title "Plan" , "План"@uk , "Tarif"@de , "الخطة"@ar ; c:open true ; c:x 0 ; c:y 0 ; c:width 260 ;
    c:body ui:thf-semblance-palette-body .
ui:thf-semblance-palette-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:thf-semblance-palette-plan ui:thf-semblance-palette-notify ui:thf-semblance-palette-progress ) .
