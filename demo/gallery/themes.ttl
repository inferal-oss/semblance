ui:thf-doodle-cancel a c:Button ; c:label "Cancel" ; sty:emphasis sty:Outline ; c:closes ui:thf-doodle-window .
ui:thf-doodle-save a c:Button ; c:label "Save" ; sty:intent sty:Primary ; c:closes ui:thf-doodle-window .
ui:thf-doodle-palette a c:Palette ; c:title "Plan" , "План"@uk , "Tarif"@de , "الخطة"@ar ; c:open true ; c:x 0 ; c:y 0 ; c:width 260 ;
    c:body ui:thf-doodle-palette-body .
ui:thf-doodle-palette-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:thf-doodle-palette-plan ui:thf-doodle-palette-notify ui:thf-doodle-palette-progress ) .
ui:thf-doodle-palette-progress a c:Progress ; c:label "Uploading 64%" ; c:value 64 ; c:max 100 ; c:active true .
ui:thf-doodle-menu a c:Menu ; c:label "More" ; c:open false ; c:items ( ui:thf-doodle-mi-copy ui:thf-doodle-mi-pin ui:thf-doodle-mi-delete ) .
ui:thf-doodle-mi-copy a c:MenuItem ; c:label "Duplicate" ; c:icon "⧉" .
ui:thf-doodle-mi-pin a c:MenuItem ; c:label "Pin" ; c:icon "★" .
ui:thf-doodle-mi-delete a c:MenuItem ; c:label "Delete" ; c:icon "✕" ; sty:tone sty:Danger .
ui:thf-doodle-palette-plan a c:Segmented ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:thf-doodle-palette-notify a c:ToggleSwitch ; c:label "Notify me" ; c:controls ui:inputsDemo ; c:property ui:inp-notify .

# Frames are fixed to the viewport, for a desktop. On this page they stand in the flow of their tile.
[] a sty:StyleRule ; sty:appliesTo c:Frame ; sty:state ":not([data-sem-c=desktop] *)" ;
    sty:declares [ sty:property "position" ; sty:raw "relative" ] ,
                 [ sty:property "z-index" ; sty:raw "auto" ] ,
                 [ sty:property "max-width" ; sty:raw "100%" ] .

ui:th-how a c:Flippable ; c:front ui:th-how-spec .
ui:th-how-spec a c:Specimen ;
    c:label "How structure is themed" , "Як тематизується будова"@uk , "Wie der Aufbau gestaltet wird"@de , "كيف تُنسَّق البنية"@ar ;
    c:help "A theme is set on an ancestor (the shell or a surface), so a rule for what is inside it has no sty:appliesTo: its sty:part begins with the component, and sty:when names the theme. The compiler prefixes the theme's hook, [data-sem-theme=…], and puts the rule in the variants layer, after every component's own rules. The part ends with a guard - not inside, nor itself, another theme below this one - so a Paper card on a Classic desktop stays Paper. Values come from the theme's tokens or from custom properties the theme sets on its own element (here --bv-title, the caption gradient of Classic's bevel kit). Rules that must beat an intent (the default button) name the class and the intent and scope themselves with a state instead." ;
    c:children ( ui:th-how-code ) .
ui:th-how-code a c:Code ; c:block true ; c:language "turtle" ; c:label """# ontology/theme/themes-structural.ttl
sty:Classic a sty:Theme ; sem:slug "classic" ;
    sty:declares [ sty:property "--sem-surface" ; sty:raw "light-dark(#c0c0c0, #3c3c44)" ] , … .

[] a sty:StyleRule ; sty:when sty:Classic ;              # on the themed element itself
    sty:declares [ sty:property "--bv-title" ;
                   sty:raw "linear-gradient(90deg, light-dark(#000080, #1c1c64), …)" ] , … .

[] a sty:StyleRule ; sty:when sty:Classic ;              # inside it
    sty:part "[data-sem-c=window] .sem-window-bar:not(:where(…guard…))" ;
    sty:declares [ sty:property "background" ; sty:raw "var(--bv-title)" ] , … .

# compiles to, in @layer sem.variants:
#   [data-sem-theme=\"classic\"] [data-sem-c=window] .sem-window-bar:not(:where(…)) { background: var(--bv-title); … }""" .

