# --- contrast composes with every theme -----------------------------------------------------

ui:th-contrast a c:Flippable ; c:front ui:th-contrast-spec .
ui:th-contrast-spec a c:Specimen ;
    c:label "Contrast composes" , "Контраст поєднується з темою"@uk , "Kontrast lässt sich kombinieren"@de , "التباين يتكامل مع السمة"@ar ;
    c:help "With the interface at standard contrast, the right-hand tiles add sty:contrast sty:HighContrast (set High above and every tile gets it). Under a theme it is restated in terms of that theme's own ramps - text pushed toward black or white, borders at step 10, the accent at steps 11-12 - so high contrast keeps each theme's hue instead of falling back to the default's violet. Where both meet on one element, sty:contrast sty:overrides sty:theme orders them." ;
    c:children ( ui:th-contrast-grid ) .
ui:th-paper-standard a c:Surface ; sty:theme sty:Paper ; sty:contrast sty:StandardContrast ; pos:direction pos:Column ; pos:gap tok:space-2 ; pos:inset tok:space-4 ;
    c:children ( ui:th-paper-standard-name ui:th-paper-standard-text ui:th-paper-standard-muted ui:th-paper-standard-row ) .
ui:th-paper-standard-name a c:Text ; sty:textStyle sty:Overline ; c:label "Paper · Standard" .
ui:th-paper-standard-text a c:Text ; c:label "Body text on the theme's surface." .
ui:th-paper-standard-muted a c:Text ; sty:textStyle sty:Caption ; c:label "Muted caption, borders below." .
ui:th-paper-standard-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:th-paper-standard-btn ui:th-paper-standard-tag ) .
ui:th-paper-standard-btn a c:Button ; c:label "Outline" ; sty:emphasis sty:Outline ; sty:size sty:Small .
ui:th-paper-standard-tag a c:Badge ; c:label "Accent" ; sty:tone sty:Accent ; sty:emphasis sty:Outline .
ui:th-paper-high a c:Surface ; sty:theme sty:Paper ; sty:contrast sty:HighContrast ; pos:direction pos:Column ; pos:gap tok:space-2 ; pos:inset tok:space-4 ;
    c:children ( ui:th-paper-high-name ui:th-paper-high-text ui:th-paper-high-muted ui:th-paper-high-row ) .
