@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .

# Gallery page: Themes. A theme (sty:theme, ontology/theme/themes.ttl) is a value of a
# hookable axis whose declarations re-value the tokens of a subtree. On the shell it
# re-themes the interface; on any component, only that subtree. The structural themes
# (ontology/theme/themes-structural.ttl) add style rules narrowed to themselves.

ui:gallery-themes a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-themes-intro ui:th-switch ui:th-side ui:th-structure ui:th-frames ui:th-how ui:th-schemes ui:th-contrast ui:th-ramps ) .
ui:gallery-themes-intro a c:Heading ; c:label "Themes" .

# --- switching the whole interface ---------------------------------------------------------

ui:th-switch a c:Flippable ; c:front ui:th-switch-spec .
ui:th-switch-spec a c:Specimen ;
    c:label "Switch the whole interface" , "Перемкнути весь інтерфейс"@uk , "Die ganze Oberfläche umschalten"@de , "تبديل الواجهة بأكملها"@ar ;
    c:help "The shell carries sty:theme as it carries sty:contrast and mot:preference. Picking a theme writes one triple, ui:shell sty:theme …; the style layer exposes it as data-sem-theme and the theme's declarations re-value every token below it. The options are the sty:Theme individuals, ordered by sem:order: five that re-colour (Semblance to Sunset) and four that rebuild (Cupertino, Tracker, Classic, Doodle: title bars, bevels, tabs, strokes). Theme, scheme and contrast are independent axes: every theme has a day and a night side, and high contrast strengthens any of them." ;
    c:children ( ui:th-switch-col ) .
ui:th-switch-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:th-switch-theme-row ui:th-switch-scheme-row ui:th-switch-contrast-row ) .
ui:th-switch-theme-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:th-switch-theme-l ui:themeSwitch ) .
ui:th-switch-theme-l a c:Text ; sty:textStyle sty:Overline ; c:label "Theme" , "Тема"@uk , "Design"@de , "السمة"@ar .
ui:themeSwitch a c:Segmented ; c:controls ui:shell ; c:property sty:theme .
ui:th-switch-scheme-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:th-switch-scheme-l ui:th-schemeSwitch ) .
ui:th-switch-scheme-l a c:Text ; sty:textStyle sty:Overline ; c:label "Scheme" , "Схема"@uk , "Schema"@de , "المخطط"@ar .
ui:th-schemeSwitch a c:Segmented ; c:controls ui:app ; c:property sty:colorScheme .
ui:th-switch-contrast-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:th-switch-contrast-l ui:th-contrastSwitch ) .
ui:th-switch-contrast-l a c:Text ; sty:textStyle sty:Overline ; c:label "Contrast" , "Контраст"@uk , "Kontrast"@de , "التباين"@ar .
ui:th-contrastSwitch a c:Segmented ; c:controls ui:shell ; c:property sty:contrast .

# --- the same composition under each theme -------------------------------------------------

ui:th-side a c:Flippable ; c:front ui:th-side-spec .
ui:th-side-spec a c:Specimen ;
    c:label "One composition, five colour themes" , "Одна композиція, п’ять колірних тем"@uk , "Eine Komposition, fünf Farbdesigns"@de , "تكوين واحد، خمس سمات لونية"@ar ;
    c:help "Five c:Surface instances with the same children, each with a different sty:theme. A theme is a sty:Theme individual whose sty:declares restate the ramps, the role colors, type, radii, shadows and easing, and a few theme-level tokens: the heading's font, case and mark, the progress fill, the backdrop. No component names a theme; components read tokens, custom properties inherit, so the nearest theme wins - even inside another theme." ;
    c:children ( ui:th-side-grid ) .

ui:th-semblance a c:Surface ; sty:theme sty:Semblance ; sty:elevation sty:Raised ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:th-semblance-name ui:th-semblance-title ui:th-semblance-body ui:th-semblance-tags ui:th-semblance-field ui:th-semblance-progress ui:th-semblance-checks ui:th-semblance-actions ) .
ui:th-semblance-name a c:Text ; sty:textStyle sty:Overline ; c:label "Semblance" .
ui:th-semblance-title a c:Heading ; c:level 3 ; c:label "Field notes" , "Польові нотатки"@uk , "Feldnotizen"@de , "ملاحظات ميدانية"@ar .
ui:th-semblance-body a c:Text ; sty:textStyle sty:Caption ; c:label "Ramps, type, corners, depth and motion, from one triple on this surface." .
ui:th-semblance-tags a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:th-semblance-draft ui:th-semblance-synced ui:th-semblance-notes ui:th-semblance-late ) .
ui:th-semblance-draft a c:Badge ; c:label "Draft" ; sty:tone sty:Accent ; sty:emphasis sty:Soft .
ui:th-semblance-synced a c:Badge ; c:label "Synced" ; sty:tone sty:Success ; sty:emphasis sty:Solid .
ui:th-semblance-notes a c:Badge ; c:label "3 notes" ; sty:tone sty:Warning ; sty:emphasis sty:Outline .
ui:th-semblance-late a c:Badge ; c:label "Late" ; sty:tone sty:Danger ; sty:emphasis sty:Soft .
ui:th-semblance-field a c:TextField ; c:label "Title" ; c:value "Notes from the field" .
ui:th-semblance-progress a c:Progress ; c:label "Uploading 64%" ; c:value 64 ; c:max 100 ; c:active true .
ui:th-semblance-checks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ; c:children ( ui:th-semblance-autosave ui:th-semblance-spell ) .
ui:th-semblance-autosave a c:ToggleSwitch ; c:label "Auto-save" ; c:checked true .
ui:th-semblance-spell a c:Checkbox ; c:label "Spelling" ; c:checked true .
ui:th-semblance-actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:th-semblance-publish ui:th-semblance-accent ui:th-semblance-preview ) .
ui:th-semblance-publish a c:Button ; c:label "Publish" ; sty:intent sty:Primary .
ui:th-semblance-accent a c:Button ; c:label "Share" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ui:th-semblance-preview a c:Button ; c:label "Preview" ; sty:emphasis sty:Outline .

