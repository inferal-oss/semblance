# --- each theme's ramps -----------------------------------------------------------------

ui:th-ramps a c:Flippable ; c:front ui:th-ramps-spec .
ui:th-ramps-spec a c:Specimen ;
    c:label "Ramps per theme" , "Шкали кожної теми"@uk , "Farbskalen je Design"@de , "تدرجات كل سمة"@ar ;
    c:help "The same c:Swatches (the sty:Ramp tokens, read through var(--sem-…)) inside each themed surface show that theme's values. The ramps are generated in OKLCH, twelve steps per hue on one lightness curve per scheme, and checked: text and muted text reach 4.5:1 on every surface, and so does text on every solid." ;
    c:children ( ui:th-ramps-grid ) .
ui:th-semblance-ramps a c:Surface ; sty:theme sty:Semblance ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-semblance-ramps-name ui:th-semblance-ramps-gray ui:th-semblance-ramps-accent ) .
ui:th-semblance-ramps-name a c:Text ; sty:textStyle sty:Overline ; c:label "Semblance" .
ui:th-semblance-ramps-gray a c:Swatches ; c:label "gray" ; c:of sty:Ramp ; c:prefix "gray-" .
ui:th-semblance-ramps-accent a c:Swatches ; c:label "accent" ; c:of sty:Ramp ; c:prefix "accent-" .
ui:th-paper-ramps a c:Surface ; sty:theme sty:Paper ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-paper-ramps-name ui:th-paper-ramps-gray ui:th-paper-ramps-accent ) .
ui:th-paper-ramps-name a c:Text ; sty:textStyle sty:Overline ; c:label "Paper" .
ui:th-paper-ramps-gray a c:Swatches ; c:label "gray" ; c:of sty:Ramp ; c:prefix "gray-" .
ui:th-paper-ramps-accent a c:Swatches ; c:label "accent" ; c:of sty:Ramp ; c:prefix "accent-" .
ui:th-terminal-ramps a c:Surface ; sty:theme sty:Terminal ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-terminal-ramps-name ui:th-terminal-ramps-gray ui:th-terminal-ramps-accent ) .
ui:th-terminal-ramps-name a c:Text ; sty:textStyle sty:Overline ; c:label "Terminal" .
ui:th-terminal-ramps-gray a c:Swatches ; c:label "gray" ; c:of sty:Ramp ; c:prefix "gray-" .
ui:th-terminal-ramps-accent a c:Swatches ; c:label "accent" ; c:of sty:Ramp ; c:prefix "accent-" .
ui:th-blueprint-ramps a c:Surface ; sty:theme sty:Blueprint ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-blueprint-ramps-name ui:th-blueprint-ramps-gray ui:th-blueprint-ramps-accent ) .
ui:th-blueprint-ramps-name a c:Text ; sty:textStyle sty:Overline ; c:label "Blueprint" .
ui:th-blueprint-ramps-gray a c:Swatches ; c:label "gray" ; c:of sty:Ramp ; c:prefix "gray-" .
ui:th-blueprint-ramps-accent a c:Swatches ; c:label "accent" ; c:of sty:Ramp ; c:prefix "accent-" .
ui:th-sunset-ramps a c:Surface ; sty:theme sty:Sunset ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-sunset-ramps-name ui:th-sunset-ramps-gray ui:th-sunset-ramps-accent ) .
ui:th-sunset-ramps-name a c:Text ; sty:textStyle sty:Overline ; c:label "Sunset" .
ui:th-sunset-ramps-gray a c:Swatches ; c:label "gray" ; c:of sty:Ramp ; c:prefix "gray-" .
ui:th-sunset-ramps-accent a c:Swatches ; c:label "accent" ; c:of sty:Ramp ; c:prefix "accent-" .
ui:th-ramps-grid a c:Grid ; c:minWidth "520px" ; pos:gap tok:space-3 ; c:children ( ui:th-semblance-ramps ui:th-paper-ramps ui:th-terminal-ramps ui:th-blueprint-ramps ui:th-sunset-ramps ui:th-cupertino-ramps ui:th-tracker-ramps ui:th-classic-ramps ui:th-doodle-ramps ) .

# --- structure, not just colour ---------------------------------------------------------------
# The four structural themes (ontology/theme/themes-structural.ttl) next to the default, with the same
# children: controls in one specimen, frames in the next. The segmented controls and radios all edit
# one triple (ui:inputsDemo ui:inp-plan, from the Inputs page), so choosing in one theme moves all.

ui:th-structure a c:Flippable ; c:front ui:th-structure-spec .
ui:th-structure-spec a c:Specimen ;
    c:label "Structure, not just colour" , "Будова, а не лише колір"@uk , "Aufbau, nicht nur Farbe"@de , "البنية، لا اللون فقط"@ar ;
    c:help "The same controls under the default and the four structural themes. Cupertino, Tracker, Classic and Doodle restate the tokens as every theme does, then add sty:StyleRules narrowed by sty:when to themselves: bevels instead of borders, a recessed track under segmented keys, folder tabs, list boxes, inked strokes on wobbly corners. Nothing here names a theme; each tile only carries sty:theme." ;
    c:children ( ui:th-structure-grid ) .
ui:th-structure-grid a c:Grid ; c:minWidth "300px" ; pos:gap tok:space-4 ;
    c:children ( ui:ths-semblance ui:ths-cupertino ui:ths-tracker ui:ths-classic ui:ths-doodle ) .

ui:ths-semblance a c:Surface ; sty:theme sty:Semblance ; sty:elevation sty:Raised ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-4 ;
    c:children ( ui:ths-semblance-name ui:ths-semblance-title ui:ths-semblance-tabs ui:ths-semblance-plan ui:ths-semblance-field ui:ths-semblance-checks ui:ths-semblance-volume ui:ths-semblance-actions ) .
ui:ths-semblance-name a c:Text ; sty:textStyle sty:Overline ; c:label "Semblance" .
ui:ths-semblance-title a c:Heading ; c:level 3 ; c:label "Field notes" , "Польові нотатки"@uk , "Feldnotizen"@de , "ملاحظات ميدانية"@ar .
ui:ths-semblance-tabs a c:Tabs ; c:label "Notes" ; c:tabs ( ui:ths-semblance-tab-today ui:ths-semblance-tab-later ) ; c:selected ui:ths-semblance-tab-today .
ui:ths-semblance-tab-today a c:Tab ; c:label "Today" , "Сьогодні"@uk , "Heute"@de , "اليوم"@ar ; c:content ui:ths-semblance-tab-today-text .
ui:ths-semblance-tab-later a c:Tab ; c:label "Later" , "Пізніше"@uk , "Später"@de , "لاحقًا"@ar ; c:content ui:ths-semblance-tab-later-text .
ui:ths-semblance-tab-today-text a c:Text ; sty:textStyle sty:Caption ; c:label "Bevels, tracks, tabs and strokes, from one triple on this surface." .
ui:ths-semblance-tab-later-text a c:Text ; sty:textStyle sty:Caption ; c:label "A tab panel is the tab's sheet: raised, boxed, or inked." .
ui:ths-semblance-plan a c:Segmented ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:ths-semblance-field a c:TextField ; c:label "Title" ; c:value "Notes from the field" .
ui:ths-semblance-checks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ; c:children ( ui:ths-semblance-autosave ui:ths-semblance-spell ) .
ui:ths-semblance-autosave a c:ToggleSwitch ; c:label "Auto-save" ; c:checked true .
ui:ths-semblance-spell a c:Checkbox ; c:label "Spelling" ; c:checked true .
ui:ths-semblance-volume a c:Slider ; c:label "Volume" ; c:value 60 ; c:unit "%" .
ui:ths-semblance-actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:ths-semblance-publish ui:ths-semblance-share ui:ths-semblance-later ) .
ui:ths-semblance-publish a c:Button ; c:label "Publish" ; sty:intent sty:Primary .
ui:ths-semblance-share a c:Button ; c:label "Share" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ui:ths-semblance-later a c:Button ; c:label "Later" ; sty:emphasis sty:Ghost .

ui:ths-cupertino a c:Surface ; sty:theme sty:Cupertino ; sty:elevation sty:Raised ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-4 ;
    c:children ( ui:ths-cupertino-name ui:ths-cupertino-title ui:ths-cupertino-tabs ui:ths-cupertino-plan ui:ths-cupertino-field ui:ths-cupertino-checks ui:ths-cupertino-volume ui:ths-cupertino-actions ) .
ui:ths-cupertino-name a c:Text ; sty:textStyle sty:Overline ; c:label "Cupertino" .
ui:ths-cupertino-title a c:Heading ; c:level 3 ; c:label "Field notes" , "Польові нотатки"@uk , "Feldnotizen"@de , "ملاحظات ميدانية"@ar .
ui:ths-cupertino-tabs a c:Tabs ; c:label "Notes" ; c:tabs ( ui:ths-cupertino-tab-today ui:ths-cupertino-tab-later ) ; c:selected ui:ths-cupertino-tab-today .
ui:ths-cupertino-tab-today a c:Tab ; c:label "Today" , "Сьогодні"@uk , "Heute"@de , "اليوم"@ar ; c:content ui:ths-cupertino-tab-today-text .
ui:ths-cupertino-tab-later a c:Tab ; c:label "Later" , "Пізніше"@uk , "Später"@de , "لاحقًا"@ar ; c:content ui:ths-cupertino-tab-later-text .
ui:ths-cupertino-tab-today-text a c:Text ; sty:textStyle sty:Caption ; c:label "Bevels, tracks, tabs and strokes, from one triple on this surface." .
ui:ths-cupertino-tab-later-text a c:Text ; sty:textStyle sty:Caption ; c:label "A tab panel is the tab's sheet: raised, boxed, or inked." .
ui:ths-cupertino-plan a c:Segmented ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:ths-cupertino-field a c:TextField ; c:label "Title" ; c:value "Notes from the field" .
ui:ths-cupertino-checks a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ; c:children ( ui:ths-cupertino-autosave ui:ths-cupertino-spell ) .
ui:ths-cupertino-autosave a c:ToggleSwitch ; c:label "Auto-save" ; c:checked true .
