# --- both schemes of every theme ------------------------------------------------------------

ui:th-schemes a c:Flippable ; c:front ui:th-schemes-spec .
ui:th-schemes-spec a c:Specimen ;
    c:label "Day and night, at once" , "День і ніч водночас"@uk , "Tag und Nacht zugleich"@de , "النهار والليل معًا"@ar ;
    c:help "sty:colorScheme on each tile forces Day or Night under its theme. Every theme color is a light-dark() pair, so the color scheme stays an axis of its own: nine themes, two schemes, from one set of declarations per theme. The platform-flavoured themes have a night side too (a dark glass desktop, charcoal panels under yellow tabs, a slate desktop) and Doodle turns from ruled paper to a blackboard." ;
    c:children ( ui:th-schemes-grid ) .
ui:th-semblance-light a c:Surface ; sty:theme sty:Semblance ; sty:colorScheme sty:Light ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:th-semblance-light-name ui:th-semblance-light-text ui:th-semblance-light-row ) .
ui:th-semblance-light-name a c:Text ; sty:textStyle sty:Overline ; c:label "Semblance · Day" .
ui:th-semblance-light-text a c:Text ; sty:textStyle sty:Title ; c:label "Aa 0123" .
ui:th-semblance-light-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:th-semblance-light-save ui:th-semblance-light-new ui:th-semblance-light-info ) .
