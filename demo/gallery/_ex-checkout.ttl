ui:co-m-onemore a c:Mention ; c:label "co:OneMore" ; c:mentions co:OneMore .
ui:co-m-remove a c:Mention ; c:label "co:RemoveLine" ; c:mentions co:RemoveLine .
ui:co-m-removed a c:Mention ; c:label "co:Removed" ; c:mentions co:Removed .
ui:co-m-mugswitch a c:Mention ; c:label "ui:co-mug" ; c:mentions ui:co-mug .
ui:co-m-columns a c:Mention ; c:label "co:CartColumns" ; c:mentions co:CartColumns .
ui:co-m-postal a c:Mention ; c:label "the postal code" ; c:mentions ui:co-postal .
ui:co-m-postalshape a c:Mention ; c:label "co:ZipShape" ; c:mentions co:ZipShape .
ui:co-m-postal2 a c:Mention ; c:label "the postal code" ; c:mentions ui:co-postal .
ui:co-m-postalfield a c:Mention ; c:label "co:postalField" ; c:mentions co:postalField .
ui:co-m-us a c:Mention ; c:label "co:US" ; c:mentions co:US .
ui:co-m-gb a c:Mention ; c:label "co:GB" ; c:mentions co:GB .
ui:co-m-region a c:Mention ; c:label "the region choice" ; c:mentions ui:co-region .
ui:co-m-facets a c:Mention ; c:label "dep:Facets" ; c:mentions dep:Facets ; c:to dep:Facets .
ui:co-m-defaults a c:Mention ; c:label "dep:defaults" ; c:mentions dep:defaults ; c:to dep:defaults .
ui:co-m-currency a c:Mention ; c:label "the currency" ; c:mentions ui:co-currency .
ui:co-m-toreviewbutton a c:Mention ; c:label "Continue" ; c:mentions ui:co-to-review .
ui:co-m-toreview a c:Mention ; c:label "co:ToReview" ; c:mentions co:ToReview .
ui:co-m-place a c:Mention ; c:label "co:PlaceOrder" ; c:mentions co:PlaceOrder .
ui:co-m-neworder a c:Mention ; c:label "co:NewOrder" ; c:mentions co:NewOrder .
