@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ph: <https://semblance.dev/demo/photos#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# A photo post: write a headline, pick how the photos are laid out, and see the post as readers
# will, with a viewer that opens any photo at full size.
#
# The photos are data (c:Picture: a URL, what it shows, a caption, a size). The preview is a
# c:Gallery of them, and the layout is one triple on it: the radio cards are a c:RadioGroup over
# that property, whose options - the layouts, each with a description - come from the ontology.
# The viewer is a c:Lightbox of the gallery; two switches set its options.
# =================================================================================================

ui:ex-photos-prefixes sh:declare [ sh:prefix "ph" ; sh:namespace "https://semblance.dev/demo/photos#"^^xsd:anyURI ] .

# --- the photos ----------------------------------------------------------------------------------

ph:harbour a c:Picture ; c:image "photos/harbour.jpg" ; c:width 1200 ; c:height 800 ; c:caption "The harbour at dusk" ;
    c:alt "A pier with lamps runs into a calm harbour at dusk, sailboats in silhouette" .
ph:lighthouse a c:Picture ; c:image "photos/lighthouse.jpg" ; c:width 800 ; c:height 1200 ; c:caption "The lighthouse on the point" ;
    c:alt "A red and white lighthouse on dark rocks above breaking waves" .
ph:dunes a c:Picture ; c:image "photos/dunes.webp" ; c:width 1200 ; c:height 675 ; c:caption "Walking the dunes" ;
    c:alt "Rolling sand dunes in warm afternoon light, three walkers on a crest" .
ph:forest a c:Picture ; c:image "photos/forest.jpg" ; c:width 1200 ; c:height 1200 ; c:caption "Back through the forest" ;
    c:alt "A sandy path leads into layers of pine forest in morning haze" .

# --- the composer --------------------------------------------------------------------------------

ui:ex-photos a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-photos-intro ui:ex-photos-layout ) .
ui:ex-photos-intro a c:Text ;
    c:label "A post with four photos. Write its headline, pick a layout - the preview changes as you do - and open any photo: arrow keys, a swipe or the thumbnails move through them, Esc closes." .
ui:ex-photos-layout a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-4 ;
    c:children ( ui:ex-photos-compose ui:ex-photos-preview ) .

ui:ex-photos-compose a c:Card ; c:label "Your post" ; c:content ui:ex-photos-form .
ui:ex-photos-form a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ph-headline ui:ph-layout ui:ph-thumbs ui:ph-loop ) .
ui:ph-headline a c:TextField ; c:label "Headline" ; c:value "A weekend by the sea" ; c:placeholder "Your headline" .
# The radio cards: the gallery's layout, offered as the ontology describes the layouts.
ui:ph-layout a c:RadioGroup ; c:label "Image layout" ; c:controls ui:ph-gallery ; c:property c:galleryLayout ; pos:direction pos:Row .
ui:ph-thumbs a c:ToggleSwitch ; c:label "Thumbnails in the viewer" ; c:controls ui:ph-viewer ; c:property c:thumbnails ; sty:size sty:Small .
ui:ph-loop a c:ToggleSwitch ; c:label "Loop around in the viewer" ; c:controls ui:ph-viewer ; c:property c:loops ; sty:size sty:Small .

# --- the preview ---------------------------------------------------------------------------------

ui:ex-photos-preview a c:Card ; c:label "Live preview" ; c:content ui:ph-post .
ui:ph-post a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:ph-title ui:ph-gallery ) .
ui:ph-title a c:Heading ; c:label "A weekend by the sea" ; c:level 3 .
ui:ph-gallery a c:Gallery ; c:label "A weekend by the sea" ; c:galleryLayout c:CarouselLayout ; c:lightbox ui:ph-viewer ;
    c:images ( ph:harbour ph:lighthouse ph:dunes ph:forest ) .
# The viewer is fixed to the viewport: it lives on the desktop, like a dialog.
ui:desktop c:hosts ui:ph-viewer .
ui:ph-viewer a c:Lightbox ; c:of ui:ph-gallery ; c:thumbnails true ; c:offersOriginal true .

# Typing the headline titles the post: its heading, and the gallery (whose name the viewer shows).
ph:Retitle a beh:Reaction ; beh:when beh:Input ; beh:source ui:ph-headline ;
    beh:deletes """CONSTRUCT { ui:ph-title c:label ?t . ui:ph-gallery c:label ?g } WHERE { { ui:ph-title c:label ?t } UNION { ui:ph-gallery c:label ?g } }""" ;
    beh:inserts """CONSTRUCT { ui:ph-title c:label ?v . ui:ph-gallery c:label ?v } WHERE { $event beh:value ?v FILTER(STRLEN(?v) > 0) }""" .

# --- how it works -----------------------------------------------------------------------------------

ui:ex-photos-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-photos-w1 ui:ex-photos-w2 ui:ex-photos-w3 ui:ex-photos-w4 ui:ex-photos-w5 ) .

ui:ex-photos-w1 a c:WalkthroughStep ; rdfs:label "Photos are data" ;
    c:children ( "Each photo, such as " ui:ex-photos-m-harbour ", is a " ui:ex-photos-m-Picture ": a URL, its size, a caption and what it shows in words (c:alt). The words are the image's alt text and the name of every button that opens it, so the post reads the same to someone who cannot see it." ) .
ui:ex-photos-w2 a c:WalkthroughStep ; rdfs:label "A gallery in a layout" ;
    c:children ( ui:ex-photos-m-gallery " is a " ui:ex-photos-m-Gallery " of the photos, laid out by one triple, c:galleryLayout: a carousel, a grid or a pile. Which photo is shown is another, c:current. Moving through them is a reaction that looks the next one up by its place, so it costs the same in a gallery of four or of four hundred." ) .
ui:ex-photos-w3 a c:WalkthroughStep ; rdfs:label "Radio cards from the ontology" ;
    c:children ( ui:ex-photos-m-layout " is a " ui:ex-photos-m-RadioGroup " over that property. Its options are not listed here: they are the individuals of the property's range, " ui:ex-photos-m-GalleryLayout ", each with a label and a description - the cards' title and line. Picking one writes the triple, and the preview follows." ) .
ui:ex-photos-w4 a c:WalkthroughStep ; rdfs:label "A viewer of the same graph" ;
    c:children ( ui:ex-photos-m-viewer " is a " ui:ex-photos-m-Lightbox " of the gallery: activating a photo makes it current and opens the viewer, a modal dialog that shows the current photo and its neighbours. Its arrows carry their keys, mirrored in a right-to-left page; a swipe comes to rest on a photo and makes it current. " ui:ex-photos-m-thumbs " and " ui:ex-photos-m-loop " switch its options, c:thumbnails and c:loops." ) .
ui:ex-photos-w5 a c:WalkthroughStep ; rdfs:label "The headline" ;
    c:children ( "Typing in " ui:ex-photos-m-headline " runs " ui:ex-photos-m-retitle ": the heading and the gallery take the new title, so the viewer's title follows too. Everything else on the page stays as it was." ) .

ui:ex-photos-m-harbour a c:Mention ; c:label "ph:harbour" ; c:mentions ph:harbour .
ui:ex-photos-m-Picture a c:Mention ; c:label "c:Picture" ; c:mentions c:Picture ; c:to c:Picture .
ui:ex-photos-m-gallery a c:Mention ; c:label "The preview" ; c:mentions ui:ph-gallery .
ui:ex-photos-m-Gallery a c:Mention ; c:label "c:Gallery" ; c:mentions c:Gallery ; c:to c:Gallery .
ui:ex-photos-m-layout a c:Mention ; c:label "The layout picker" ; c:mentions ui:ph-layout .
ui:ex-photos-m-RadioGroup a c:Mention ; c:label "c:RadioGroup" ; c:mentions c:RadioGroup ; c:to c:RadioGroup .
ui:ex-photos-m-GalleryLayout a c:Mention ; c:label "c:GalleryLayout" ; c:mentions c:GalleryLayout ; c:to c:GalleryLayout .
ui:ex-photos-m-viewer a c:Mention ; c:label "The viewer" ; c:mentions ui:ph-viewer .
ui:ex-photos-m-Lightbox a c:Mention ; c:label "c:Lightbox" ; c:mentions c:Lightbox ; c:to c:Lightbox .
ui:ex-photos-m-thumbs a c:Mention ; c:label "Two switches" ; c:mentions ui:ph-thumbs .
ui:ex-photos-m-loop a c:Mention ; c:label "the loop" ; c:mentions ui:ph-loop .
ui:ex-photos-m-headline a c:Mention ; c:label "the headline" ; c:mentions ui:ph-headline .
ui:ex-photos-m-retitle a c:Mention ; c:label "ph:Retitle" ; c:mentions ph:Retitle .
