@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dnd: <https://semblance.dev/ns/dragdrop#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ph: <https://semblance.dev/demo/photos#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# A photo post: write a headline, pick how the photos are laid out, and see the post as readers
# will, with a viewer that opens any photo at full size.
#
# The photos are data (c:Picture: a URL, what it shows, a caption, a size). The preview is a
# c:Gallery of them, and the layout is one triple on it: the picker is a c:Segmented over that
# property, whose options - the layouts - come from the ontology.
# The viewer is a c:Lightbox of the gallery; two switches set its options. The order of the
# photos is a sortable list (drag a photo, or Space and the arrow keys): its drop ranks them, and
# rewrites the gallery's list in that order.
# =================================================================================================

ui:ex-photos-prefixes sh:declare [ sh:prefix "ph" ; sh:namespace "https://semblance.dev/demo/photos#"^^xsd:anyURI ] .

# --- the photos ----------------------------------------------------------------------------------

ph:harbour a c:Picture ; ph:rank 1 ; c:image "photos/harbour.jpg" ; c:width 1200 ; c:height 800 ; c:caption "The harbour at dusk" ;
    c:alt "A pier with lamps runs into a calm harbour at dusk, sailboats in silhouette" .
ph:lighthouse a c:Picture ; ph:rank 2 ; c:image "photos/lighthouse.jpg" ; c:width 800 ; c:height 1200 ; c:caption "The lighthouse on the point" ;
    c:alt "A red and white lighthouse on dark rocks above breaking waves" .
ph:dunes a c:Picture ; ph:rank 3 ; c:image "photos/dunes.webp" ; c:width 1200 ; c:height 675 ; c:caption "Walking the dunes" ;
    c:alt "Rolling sand dunes in warm afternoon light, three walkers on a crest" .
ph:forest a c:Picture ; ph:rank 4 ; c:image "photos/forest.jpg" ; c:width 1200 ; c:height 1200 ; c:caption "Back through the forest" ;
    c:alt "A sandy path leads into layers of pine forest in morning haze" .

# --- the composer --------------------------------------------------------------------------------

ui:ex-photos a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-photos-intro ui:ex-photos-layout ) .
ui:ex-photos-intro a c:Text ;
    c:label "A post with four photos. Write its headline, switch the layout, drag the photos into another order - the preview changes as you do - and open any photo: arrow keys, a swipe or the thumbnails move through them, a pinch or a double-click zooms, Esc closes." .
ui:ex-photos-layout a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-4 ;
    c:children ( ui:ex-photos-compose ui:ex-photos-preview ) .

ui:ex-photos-compose a c:Card ; c:label "Your post" ; c:content ui:ex-photos-form .
ui:ex-photos-form a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ph-headline ui:ph-order-title ui:ph-order ui:ph-loop ui:ph-viewer-title ui:ph-thumbs ) .
ui:ph-headline a c:TextField ; c:label "Headline" ; c:value "A weekend by the sea" ; c:placeholder "Your headline" .
# The gallery's layout, offered as the ontology lists the layouts.
ui:ph-layout a c:Segmented ; c:controls ui:ph-gallery ; c:property c:galleryLayout .
# The order: the photos by rank, which a drag (or Space and the arrow keys) changes.
ui:ph-order-title a c:Text ; c:label "Order: drag a photo" ; sty:textStyle sty:Overline .
ui:ph-order a c:List , dnd:Sortable ; c:label "Order" ; c:itemLabel c:caption ; c:itemImage c:image ; c:sortBy ph:rank ;
    dnd:members c:item ; dnd:orderBy ph:rank ;
    c:item ph:harbour , ph:lighthouse , ph:dunes , ph:forest .
# How the photos are moved through: around the ends (the carousel's arrows, and the viewer's).
ui:ph-loop a c:ToggleSwitch ; c:label "Loop around the ends" ; c:controls ui:ph-gallery ; c:property c:loops ; sty:size sty:Small .
# The viewer's own option: it shows once a photo is open.
ui:ph-viewer-title a c:Text ; c:label "When a photo is open" ; sty:textStyle sty:Overline .
ui:ph-thumbs a c:ToggleSwitch ; c:label "Thumbnails under it" ; c:controls ui:ph-viewer ; c:property c:thumbnails ; sty:size sty:Small .

# --- the preview ---------------------------------------------------------------------------------

# The layout switch sits in the preview's header: it changes how the preview lays the photos out.
ui:ex-photos-preview a c:Card ; c:label "Live preview" ; c:actions ( ui:ph-layout ) ; c:content ui:ph-post .
ui:ph-post a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:ph-title ui:ph-gallery ) .
ui:ph-title a c:Heading ; c:label "A weekend by the sea" ; c:level 3 .
ui:ph-gallery a c:Gallery ; c:label "A weekend by the sea" ; c:galleryLayout c:CarouselLayout ; c:lightbox ui:ph-viewer ;
    c:images ph:cell-1 .
# The gallery's list, in rank order (a reordering replaces it).
ph:cell-1 rdf:first ph:harbour ; rdf:rest ph:cell-2 .
ph:cell-2 rdf:first ph:lighthouse ; rdf:rest ph:cell-3 .
ph:cell-3 rdf:first ph:dunes ; rdf:rest ph:cell-4 .
ph:cell-4 rdf:first ph:forest ; rdf:rest rdf:nil .
# The viewer is fixed to the viewport: it lives on the desktop, like a dialog.
ui:desktop c:hosts ui:ph-viewer .
ui:ph-viewer a c:Lightbox ; c:of ui:ph-gallery ; c:thumbnails true ; c:offersOriginal true .

# Typing the headline titles the post: its heading, and the gallery (whose name the viewer shows).
ph:Retitle a beh:Reaction ; beh:when beh:Input ; beh:source ui:ph-headline ;
    beh:deletes """CONSTRUCT { ui:ph-title c:label ?t . ui:ph-gallery c:label ?g } WHERE { { ui:ph-title c:label ?t } UNION { ui:ph-gallery c:label ?g } }""" ;
    beh:inserts """CONSTRUCT { ui:ph-title c:label ?v . ui:ph-gallery c:label ?v } WHERE { $event beh:value ?v FILTER(STRLEN(?v) > 0) }""" .

# A photo dropped in the order list takes its new rank, and the gallery gets a new list in rank
# order: each photo in the cell of its place (how many photos rank before it, plus one). The cells
# are new (named after the drop), so the gallery's c:images changes and its rules see the new order.
ph:Reorder a beh:Reaction ; beh:when dnd:Drop ; beh:source ui:ph-order ;
    beh:deletes """
CONSTRUCT { ?carried ph:rank ?old . ui:ph-gallery c:images ?head . ?cell ?lp ?lo }
WHERE {
  $event dnd:carrying ?carried ; dnd:rank ?rank .
  { ?carried ph:rank ?old }
  UNION { ui:ph-gallery c:images ?head }
  UNION { ui:ph-gallery c:images/rdf:rest* ?cell . VALUES ?lp { rdf:first rdf:rest } ?cell ?lp ?lo }
}""" ;
    beh:inserts """
CONSTRUCT { ?carried ph:rank ?rank . ui:ph-gallery c:images ?head . ?cell rdf:first ?m ; rdf:rest ?next }
WHERE {
  $event dnd:carrying ?carried ; dnd:rank ?rank .
  { SELECT (COUNT(?any) AS ?n) WHERE { ui:ph-order c:item ?any } }
  ui:ph-order c:item ?m .
  OPTIONAL { ?m ph:rank ?mr0 }
  BIND(IF(?m = ?carried, ?rank, ?mr0) AS ?mr)
  LATERAL {
    OPTIONAL {
      SELECT ?m ?mr ?carried ?rank (COUNT(?o) AS ?k) WHERE {
        ui:ph-order c:item ?o . OPTIONAL { ?o ph:rank ?or0 }
        BIND(IF(?o = ?carried, ?rank, ?or0) AS ?or)
        FILTER(?or < ?mr || (?or = ?mr && STR(?o) < STR(?m)))
      } GROUP BY ?m ?mr ?carried ?rank
    }
  }
  BIND(COALESCE(?k, 0) + 1 AS ?pos)
  BIND(IRI(CONCAT(STR($event), "-cell-", STR(?pos))) AS ?cell)
  BIND(IF(?pos < ?n, IRI(CONCAT(STR($event), "-cell-", STR(?pos + 1))), rdf:nil) AS ?next)
  BIND(IRI(CONCAT(STR($event), "-cell-1")) AS ?head)
}""" ;
    ann:announces "Photo moved" , "Фото переміщено"@uk , "Foto verschoben"@de , "تم نقل الصورة"@ar .

# --- how it works -----------------------------------------------------------------------------------

ui:ex-photos-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-photos-w1 ui:ex-photos-w2 ui:ex-photos-w3 ui:ex-photos-w6 ui:ex-photos-w4 ui:ex-photos-w5 ) .

ui:ex-photos-w1 a c:WalkthroughStep ; rdfs:label "Photos are data" ;
    c:children ( "Each photo, such as " ui:ex-photos-m-harbour ", is a " ui:ex-photos-m-Picture ": a URL, its size, a caption and what it shows in words (c:alt). The words are the image's alt text and the name of every button that opens it, so the post reads the same to someone who cannot see it." ) .
ui:ex-photos-w2 a c:WalkthroughStep ; rdfs:label "A gallery in a layout" ;
    c:children ( ui:ex-photos-m-gallery " is a " ui:ex-photos-m-Gallery " of the photos, laid out by one triple, c:galleryLayout: a carousel, a grid or a pile. Which photo is shown is another, c:current. Moving through them is a reaction that looks the next one up by its place, so it costs the same in a gallery of four or of four hundred." ) .
ui:ex-photos-w3 a c:WalkthroughStep ; rdfs:label "A picker from the ontology" ;
    c:children ( ui:ex-photos-m-layout " is a " ui:ex-photos-m-Segmented " over that property. Its options are not listed here: they are the individuals of the property's range, " ui:ex-photos-m-GalleryLayout ". Picking one writes the triple, and the preview follows." ) .
ui:ex-photos-w6 a c:WalkthroughStep ; rdfs:label "Reordering by drag" ;
    c:children ( ui:ex-photos-m-order " is a " ui:ex-photos-m-List " of the photos by their rank, and a " ui:ex-photos-m-Sortable ": drag a photo, or lift it with Space and carry it with the arrow keys. The drop says the rank it takes, half way between its new neighbours; " ui:ex-photos-m-reorder " writes it and gives the gallery a new list in rank order. The gallery numbers its images again, once, and the preview follows." ) .
ui:ex-photos-w4 a c:WalkthroughStep ; rdfs:label "A viewer of the same graph" ;
    c:children ( ui:ex-photos-m-viewer " is a " ui:ex-photos-m-Lightbox " of the gallery: activating a photo makes it current and opens the viewer, a modal dialog that grows from the photo and shrinks back to it, showing the current photo and its neighbours. Its arrows carry their keys, mirrored in a right-to-left page; a swipe comes to rest on a photo and makes it current; a double-click zooms where it points, and a drag pans. All of it moves as the motion preference says. " ui:ex-photos-m-thumbs " switches its strip of thumbnails (c:thumbnails); " ui:ex-photos-m-loop " makes the gallery loop around its ends (c:loops), the carousel's arrows and the viewer's alike." ) .
ui:ex-photos-w5 a c:WalkthroughStep ; rdfs:label "The headline" ;
    c:children ( "Typing in " ui:ex-photos-m-headline " runs " ui:ex-photos-m-retitle ": the heading and the gallery take the new title, so the viewer's title follows too. Everything else on the page stays as it was." ) .

ui:ex-photos-m-harbour a c:Mention ; c:label "ph:harbour" ; c:mentions ph:harbour .
ui:ex-photos-m-Picture a c:Mention ; c:label "c:Picture" ; c:mentions c:Picture ; c:to c:Picture .
ui:ex-photos-m-gallery a c:Mention ; c:label "The preview" ; c:mentions ui:ph-gallery .
ui:ex-photos-m-Gallery a c:Mention ; c:label "c:Gallery" ; c:mentions c:Gallery ; c:to c:Gallery .
ui:ex-photos-m-layout a c:Mention ; c:label "The layout picker" ; c:mentions ui:ph-layout .
ui:ex-photos-m-Segmented a c:Mention ; c:label "c:Segmented" ; c:mentions c:Segmented ; c:to c:Segmented .
ui:ex-photos-m-GalleryLayout a c:Mention ; c:label "c:GalleryLayout" ; c:mentions c:GalleryLayout ; c:to c:GalleryLayout .
ui:ex-photos-m-order a c:Mention ; c:label "The order list" ; c:mentions ui:ph-order .
ui:ex-photos-m-List a c:Mention ; c:label "c:List" ; c:mentions c:List ; c:to c:List .
ui:ex-photos-m-Sortable a c:Mention ; c:label "dnd:Sortable" ; c:mentions dnd:Sortable ; c:to dnd:Sortable .
ui:ex-photos-m-reorder a c:Mention ; c:label "ph:Reorder" ; c:mentions ph:Reorder .
ui:ex-photos-m-viewer a c:Mention ; c:label "The viewer" ; c:mentions ui:ph-viewer .
ui:ex-photos-m-Lightbox a c:Mention ; c:label "c:Lightbox" ; c:mentions c:Lightbox ; c:to c:Lightbox .
ui:ex-photos-m-thumbs a c:Mention ; c:label "A switch" ; c:mentions ui:ph-thumbs .
ui:ex-photos-m-loop a c:Mention ; c:label "another" ; c:mentions ui:ph-loop .
ui:ex-photos-m-headline a c:Mention ; c:label "the headline" ; c:mentions ui:ph-headline .
ui:ex-photos-m-retitle a c:Mention ; c:label "ph:Retitle" ; c:mentions ph:Retitle .
