@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix ann: <https://semblance.dev/ns/announce#> .

# Gallery page: Overlays.

ui:gallery-overlays a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-overlays-intro ui:ov-dialogs ui:ov-drawers ui:ov-popovers ui:ov-lightboxes ui:ov-palettes ) .
ui:gallery-overlays-intro a c:Heading ; c:label "Overlays" .

# Dialogs and drawers are fixed to the viewport, so they live on the shell's desktop
# (outside the gallery's flippable cards, whose 3D transforms would contain them).
# The buttons on this page open them by saying so: `c:opens`.
ui:desktop c:hosts ui:ov-dialog , ui:ov-confirm , ui:ov-drawer-end , ui:ov-drawer-start , ui:ov-palette .

# --- dialogs ---
ui:ov-dialog a c:Dialog ; c:label "Rename graph" ;
    c:help "The new name is written to the graph when you save." ;
    c:content ui:ov-dialog-field ;
    c:actions ( ui:ov-dialog-cancel ui:ov-dialog-save ) .
ui:ov-dialog-field a c:TextField ; c:label "Name" ; c:value "Todo graph" ; c:placeholder "A short name" .
ui:ov-dialog-cancel a c:Button ; c:label "Cancel" ; sty:emphasis sty:Outline ; c:closes ui:ov-dialog .
ui:ov-dialog-save a c:Button ; c:label "Save" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:closes ui:ov-dialog .

ui:ov-confirm a c:Dialog ; c:label "Delete 5 todos?" ;
    c:help "Their triples are removed from the input graph. The change log keeps the event, not the data." ;
    c:actions ( ui:ov-confirm-cancel ui:ov-confirm-delete ) .
ui:ov-confirm-cancel a c:Button ; c:label "Keep them" ; sty:emphasis sty:Outline ; c:closes ui:ov-confirm .
ui:ov-confirm-delete a c:Button ; c:label "Delete" ; sty:tone sty:Danger ; sty:emphasis sty:Solid ; c:closes ui:ov-confirm .

ui:ov-open-dialog a c:Button ; c:label "Open dialog" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:opens ui:ov-dialog .
ui:ov-open-confirm a c:Button ; c:label "Delete todos…" ; sty:tone sty:Danger ; sty:emphasis sty:Soft ; c:opens ui:ov-confirm .
ui:ov-dialogs a c:Flippable ; c:front ui:ov-dialogs-spec .
ui:ov-dialogs-spec a c:Specimen ; c:demonstrates c:Dialog ; c:label "Dialog" ;
    c:help "A modal panel over a scrim (role=dialog, aria-modal, labelled by its title). Its state is one fact, c:open: buttons that c:opens or c:closes it set it, and so do its ✕ and a click on the scrim. Closed, its content is not evaluated." ;
    c:children ( ui:ov-open-dialog ui:ov-open-confirm ) .

# --- drawers ---
ui:ov-drawer-end a c:Drawer ; c:side "end" ; c:label "Filters" ;
    c:help "Show the todos that carry these tags." ;
    c:content ui:ov-filter-tags ;
    c:actions ( ui:ov-drawer-reset ui:ov-drawer-apply ) .
ui:ov-filter-tags a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ;
    c:children ( ui:ov-filter-open ui:ov-filter-done ui:ov-filter-blocked ui:ov-filter-starred ) .
ui:ov-filter-open a c:Tag ; c:label "Open" ; c:selectable true ; c:checked true ; sty:tone sty:Accent .
ui:ov-filter-done a c:Tag ; c:label "Done" ; c:selectable true ; sty:tone sty:Accent .
ui:ov-filter-blocked a c:Tag ; c:label "Blocked" ; c:selectable true ; sty:tone sty:Warning .
ui:ov-filter-starred a c:Tag ; c:label "Starred" ; c:icon "★" ; c:selectable true ; sty:tone sty:Info .
ui:ov-drawer-reset a c:Button ; c:label "Close" ; sty:emphasis sty:Outline ; c:closes ui:ov-drawer-end .
ui:ov-drawer-apply a c:Button ; c:label "Apply" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:closes ui:ov-drawer-end .

ui:ov-drawer-start a c:Drawer ; c:side "start" ; c:label "Outline" ;
    c:help "A drawer from the start edge, with nothing but a description and a close button." .

ui:ov-open-drawer-end a c:Button ; c:label "Open end drawer" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:opens ui:ov-drawer-end .
ui:ov-open-drawer-start a c:Button ; c:label "Open start drawer" ; sty:emphasis sty:Outline ; c:opens ui:ov-drawer-start .
ui:ov-drawers a c:Flippable ; c:front ui:ov-drawers-spec .
ui:ov-drawers-spec a c:Specimen ; c:demonstrates c:Drawer ; c:label "Drawer" ;
    c:help "A dialog attached to an edge (c:side start or end) that slides in on the motion tokens. Same contract as the dialog: c:open, c:opens / c:closes, ✕ and scrim." ;
    c:children ( ui:ov-open-drawer-end ui:ov-open-drawer-start ) .

# --- popovers ---
ui:ov-pop-info a c:Popover ; c:trigger "What is this?" ;
    c:help "A c:Popover: a panel anchored below its trigger. The trigger toggles c:open and reports it with aria-expanded." .
ui:ov-pop-status a c:Popover ; c:trigger "Status" ;
    c:help "Three layers decorate this panel's content." ;
    c:content ui:ov-pop-badges .
ui:ov-pop-badges a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ui:ov-pop-b1 ui:ov-pop-b2 ui:ov-pop-b3 ) .
ui:ov-pop-b1 a c:Badge ; c:label "a11y" ; sty:tone sty:Success .
ui:ov-pop-b2 a c:Badge ; c:label "style" ; sty:tone sty:Accent .
ui:ov-pop-b3 a c:Badge ; c:label "source" ; sty:tone sty:Info .
ui:ov-pop-small a c:Popover ; c:trigger "Small" ; sty:size sty:Small ; c:help "The trigger is sized by sty:size, like every control." .
ui:ov-popovers a c:Flippable ; c:front ui:ov-popovers-spec .
ui:ov-popovers-spec a c:Specimen ; c:demonstrates c:Popover ; c:label "Popover" ;
    c:help "Non-modal and anchored, so it can live inside the page (and inside this card). It shows c:help and c:content while c:open." ;
    c:children ( ui:ov-pop-info ui:ov-pop-status ui:ov-pop-small ) .

# --- lightbox ---
# A grid of the Data page's pictures whose lightbox loops, has a thumbnail strip and links to the
# original. It shows the images of a gallery on the page (whose index it reads).
ui:desktop c:hosts ui:ov-lightbox .
ui:ov-photos a c:Gallery ; c:label "Places" ; c:galleryLayout c:GridLayout ; c:lightbox ui:ov-lightbox ;
    c:images ( ui:photo-lake ui:photo-lighthouse ui:photo-city ui:photo-harbour ) .
ui:ov-lightbox a c:Lightbox ; c:of ui:ov-photos ; c:loops true ; c:thumbnails true ; c:offersOriginal true .
ui:ov-lightboxes a c:Flippable ; c:front ui:ov-lightboxes-spec .
ui:ov-lightboxes-spec a c:Specimen ; c:demonstrates c:Lightbox ; c:label "Lightbox" ;
    c:help "A modal viewer of a gallery's current image: ←/→ (mirrored right to left), a swipe, the thumbnails; Esc, ✕ or the scrim close it. Zoom with the button or a double-click. This one loops (c:loops) and links to the original (c:offersOriginal)." ;
    c:children ( ui:ov-photos ) .

# --- command palette ---
# The site has its own (⌘K / Ctrl+K anywhere; ui:palette in app.ttl): every keyboard command, every
# component with a shortcut, every page and section. This one lists the commands and what this page
# gives it (c:entries), in a section of its own: a command whose reaction changes the badge and says
# so, two buttons of this page (running one clicks it), and a specimen on another page (c:to).
ui:ov-palette a c:CommandPalette ; c:label "Gallery palette" ; c:placeholder "Run something on this page…" ;
    c:lists c:PaletteCommands ; c:recentLimit 3 ;
    c:entries ( ui:ov-pal-wave ui:ov-open-dialog ui:ov-open-drawer-end ui:ov-pal-to-combobox ) .
ui:ov-pal-section a c:PaletteSection ; sem:order 4 ;
    rdfs:label "Overlays page"@en , "Сторінка накладок"@uk , "Seite Overlays"@de , "صفحة الطبقات المنبثقة"@ar .
ui:ov-pal-wave a key:Command ; c:paletteSection ui:ov-pal-section ;
    c:keywords "greeting salutation привіт Begrüßung تحية" ;
    rdfs:label "Wave hello" , "Помахати"@uk , "Winken"@de , "التلويح بالتحية"@ar ;
    rdfs:comment "Changes the badge on the card" , "Змінює значок на картці"@uk , "Ändert das Abzeichen auf der Karte"@de , "يغيّر الشارة على البطاقة"@ar .
ui:WaveHello a beh:Reaction ; beh:when key:Press ; beh:source ui:ov-pal-wave ;
    beh:deletes """CONSTRUCT { ui:ov-pal-badge c:label ?old ; sty:tone ?tone } WHERE { { ui:ov-pal-badge c:label ?old } UNION { ui:ov-pal-badge sty:tone ?tone } }""" ;
    beh:inserts """CONSTRUCT { ui:ov-pal-badge c:label "Waved from the palette" ; sty:tone sty:Success } WHERE {}""" ;
    ann:announces "Hello from the palette" , "Привіт із палітри"@uk , "Hallo aus der Palette"@de , "مرحبًا من اللوحة"@ar ; ann:tone sty:Success .
ui:ov-open-dialog c:paletteSection ui:ov-pal-section .
ui:ov-open-drawer-end c:paletteSection ui:ov-pal-section .
ui:ov-pal-to-combobox c:paletteSection ui:ov-pal-section ; c:to ui:inp-typeahead-spec ;
    rdfs:label "The combobox specimen" , "Зразок комбобокса"@uk , "Das Kombinationsfeld-Muster"@de , "نموذج مربع التحرير والسرد"@ar ;
    rdfs:comment "On the Inputs page" , "На сторінці «Введення»"@uk , "Auf der Seite „Eingaben“"@de , "في صفحة المدخلات"@ar .

ui:ov-open-palette a c:Button ; c:label "Open the gallery palette" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:opens ui:ov-palette .
ui:ov-pal-badge a c:Badge ; c:label "Not waved yet" ; sty:tone sty:Neutral .
ui:ov-palettes a c:Flippable ; c:front ui:ov-palettes-spec .
ui:ov-palettes-spec a c:Specimen ; c:demonstrates c:CommandPalette , c:PaletteSection ; c:label "Command palette" ;
    c:help "A modal list of what one can do or go to, filtered as you type (a typeahead: the WAI-ARIA combobox over a listbox, in a dialog). It lists every key:Command, every component with a key:shortcut and every place of the app's location (c:lists), and the app's own c:entries, in sections (c:PaletteSection), the recently run first. Optional c:keywords on an entry supplies search metadata without lengthening its label: try “greeting”. ↓ ↑ move, Enter runs: a command gets its key:Press, a component its click, a place is gone to (c:to). A key:Command that c:opens it opens it - on this site ⌘K / Ctrl+K, anywhere - and the focus comes back where it was when it closes." ;
    c:children ( ui:ov-open-palette ui:ov-pal-badge ) .
