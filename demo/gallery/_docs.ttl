# --- Binary RDF (Jelly) ---
ui:doc-jelly a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-jl-h ui:doc-jl-1 ui:doc-jl-2
                 ui:doc-jl-when-h ui:doc-jl-when-1 ui:doc-jl-table ui:doc-jl-when-2 ui:doc-jl-when-list
                 ui:doc-jl-store-h ui:doc-jl-store-1 ui:doc-jl-store-code
                 ui:doc-jl-stream-h ui:doc-jl-stream-1 ui:doc-jl-stream-code ui:doc-jl-stream-2
                 ui:doc-jl-remote-h ui:doc-jl-remote-1 ui:doc-jl-remote-code ui:doc-jl-remote-2
                 ui:doc-jl-how-h ui:doc-jl-how
                 ui:doc-jl-not-h ui:doc-jl-not ) .
ui:doc-jl-h a c:Heading ; c:level 1 ; c:label "Binary RDF (Jelly)" .
ui:doc-jl-1 a c:Text ; c:label "Jelly is a binary format for RDF, built on Protocol Buffers, with a streaming protocol. A stream is a series of frames, each a batch of statements. IRIs are written once into lookup tables that last from frame to frame, so after that an IRI costs an identifier of a byte or two, and a value repeated in consecutive statements costs nothing at all. Semblance reads Jelly 1.2 and the older 1.0 and 1.1 streams, and writes 1.2. Both engines do this in WebAssembly, and a TypeScript codec does it for the stores without an engine." .
ui:doc-jl-2 a c:Text ; c:label "Text formats parse character by character and spell out every IRI they name. A Jelly reader reads lengths and identifiers. It never scans for the end of a token, and it resolves an IRI it has already seen without looking at its text. It can also stop at any frame: memory stays bounded, and each frame costs what it holds, however long the stream has run." .

ui:doc-jl-when-h a c:Heading ; c:level 2 ; c:label "When it is better" .
ui:doc-jl-when-1 a c:Text ; c:label "We measured it on Semblance's own data before using it anywhere. Jelly wins wherever data arrives as a stream of statements that name the same things again and again. It loses where a graph is mostly long strings that are shipped compressed, which is what Semblance's ontology is. Before is what Semblance used: server-sent events of JSON and N-Triples for a remote source, Turtle for the ontology." .
ui:doc-jl-table a c:Table ; c:label "Jelly against the format used before" ; c:query ui:JellyNumbers ; c:dataset ui:JellyNumbers ;
    c:tableColumns ( ui:jlc-what ui:jlc-before ui:jlc-jelly ui:jlc-verdict ) .
ui:jlc-what a c:Column ; c:variable "what" ; c:label "Measured" ; c:sortable false .
ui:jlc-before a c:Column ; c:variable "before" ; c:label "Before" ; c:align "end" ; c:sortable false .
ui:jlc-jelly a c:Column ; c:variable "jelly" ; c:label "Jelly" ; c:align "end" ; c:sortable false .
ui:jlc-verdict a c:Column ; c:variable "verdict" ; c:label "Used" ; c:sortable false .
ui:JellyNumbers a sem:View ;
    sem:select """SELECT ?what ?before ?jelly ?verdict WHERE { ?m a ui:JellyMeasurement ; rdfs:label ?what ; ui:before ?before ; ui:jelly ?jelly ; ui:verdict ?verdict ; sem:order ?o } ORDER BY ?o""" .
ui:jm-delta a ui:JellyMeasurement ; sem:order 1 ; rdfs:label "A remote delta (a todo edited)" ; ui:before "275 B" ; ui:jelly "85 B" ; ui:verdict "yes" .
ui:jm-snapshot a ui:JellyMeasurement ; sem:order 2 ; rdfs:label "A remote snapshot (900 statements)" ; ui:before "97.3 KiB" ; ui:jelly "12.1 KiB" ; ui:verdict "yes" .
ui:jm-stream a ui:JellyMeasurement ; sem:order 3 ; rdfs:label "That stream, gzipped and flushed per message" ; ui:before "55.3 KiB" ; ui:jelly "44.3 KiB" ; ui:verdict "yes" .
ui:jm-decode a ui:JellyMeasurement ; sem:order 4 ; rdfs:label "Decoding its 2,001 messages" ; ui:before "8.9 ms" ; ui:jelly "3.6 ms" ; ui:verdict "yes" .
ui:jm-load a ui:JellyMeasurement ; sem:order 5 ; rdfs:label "The ontology into the WASM engine" ; ui:before "28.5 ms" ; ui:jelly "13.5 ms" ; ui:verdict "dumps" .
ui:jm-raw a ui:JellyMeasurement ; sem:order 6 ; rdfs:label "The ontology, uncompressed" ; ui:before "4,315 KiB" ; ui:jelly "3,889 KiB" ; ui:verdict "dumps" .
ui:jm-gzip a ui:JellyMeasurement ; sem:order 7 ; rdfs:label "The ontology over the wire, gzip" ; ui:before "638 KiB" ; ui:jelly "731 KiB" ; ui:verdict "no" .
ui:jm-brotli a ui:JellyMeasurement ; sem:order 8 ; rdfs:label "The ontology over the wire, brotli" ; ui:before "440 KiB" ; ui:jelly "489 KiB" ; ui:verdict "no" .
ui:doc-jl-when-2 a c:Text ; c:label "Why the ontology is the exception: almost three quarters of its bytes are string literals (rule queries, style rules, documentation), which Jelly stores as they are. Compression then works on what is left, and Turtle's repeated prefixed names compress better than Jelly's identifiers do. A page also gets the ontology only once, while a remote source sends one message after another for as long as the page is open. The rule of thumb:" .
ui:doc-jl-when-list a c:DescriptionList ; c:of ui:doc-jl-when-items ; c:fields ( ui:jlw-stream ui:jlw-dump ui:jlw-binary ui:jlw-turtle ) .
ui:doc-jl-when-items ui:jlw-stream "Use Jelly for streams of changes: many small messages naming the same subjects and predicates, as a remote store, a log or a feed sends them." ;
    ui:jlw-dump "Use it for dumps and loads between stores and processes: a store's contents written and read back in WebAssembly, twice as fast as Turtle, without text in between." ;
    ui:jlw-binary "Use it where nothing compresses: storage, a message queue, a socket. There it is the smallest form." ;
    ui:jlw-turtle "Keep Turtle for graphs people write and read, and for literal-heavy graphs a server compresses once and serves many times, such as an app's own graphs and the ontology." .
ui:jlw-stream rdfs:label "Streams" . ui:jlw-dump rdfs:label "Dumps" . ui:jlw-binary rdfs:label "Uncompressed" . ui:jlw-turtle rdfs:label "Not here" .

ui:doc-jl-store-h a c:Heading ; c:level 2 ; c:label "In a store" .
ui:doc-jl-store-1 a c:Text ; c:label "Every store reads and writes it. The engine stores do it natively; N3.js, Oxigraph and the hybrid store go through the TypeScript codec. loadJelly is all or nothing. loadJellyStream reads a stream as it arrives, adding each frame once it is whole, so memory holds one frame at a time; if the stream breaks, the frames that arrived stay in the store. dumpJellyStream writes frames while the reader takes them." .
ui:doc-jl-store-code a c:Code ; c:block true ; c:language "typescript" ; c:label """const bytes = store.dumpJelly()            // what the store holds, as a stream of quads
const one = store.dumpJelly(graph)         // one graph
other.loadJelly(bytes)                     // returns how many statements it read
other.loadJelly(triples, graph)            // a stream of triples, into a graph

// As the bytes arrive, and as the reader takes them:
await loadJellyStream(store, (await fetch('/data.jelly')).body)
return new Response(dumpJellyStream(store), { headers: { 'content-type': 'application/x-jelly-rdf' } })""" .

ui:doc-jl-stream-h a c:Heading ; c:level 2 ; c:label "Frame by frame" .
ui:doc-jl-stream-1 a c:Text ; c:label "A stream need not arrive whole. FrameSplitter cuts the frames out of chunks as they come (a fetch body, a socket), and a reader takes one frame at a time. A writer hands back frames as they fill." .
ui:doc-jl-stream-code a c:Code ; c:block true ; c:language "typescript" ; c:label """import { FrameSplitter, JellyReader, JellyWriter, delimit } from '@inferal-oss/semblance'

const split = new FrameSplitter()
const reader = new JellyReader(DataFactory)
for await (const chunk of response.body)
  for (const frame of split.push(chunk)) reader.frame(frame, { quad: (q) => store.add(q) })

const writer = new JellyWriter({ physical: 2 })       // 2: quads
for (const q of quads) for (const frame of writer.add(q)) socket.send(delimit(frame))
socket.send(delimit(writer.flush()))""" .
ui:doc-jl-stream-2 a c:Text ; c:label "In an engine, the same goes through Engine.jellyReader() and jellyWriter(), and statements cross into WebAssembly as identifiers, never as text. A stream of RDF Messages (one change, one event) marks where each message ends, and blank nodes are scoped to their message." .

ui:doc-jl-remote-h a c:Heading ; c:level 2 ; c:label "Remote sources" .
ui:doc-jl-remote-1 a c:Text ; c:label "A page bound to a remote store asks for Jelly first. A server that offers it, as the reference SourceServer does, answers with one Jelly stream per subscription: a frame per message, with removals first. The message's kind and cursor ride in the frame's metadata, and the lookups carry over from one message to the next. A server that answers with server-sent events works as before, and writes stay JSON." .
ui:doc-jl-remote-code a c:Code ; c:block true ; c:language "typescript" ; c:label """httpTransport({ url: 'https://example.org/store/' })                 // Jelly when offered
httpTransport({ url: 'https://example.org/store/', jelly: false })   // server-sent events only""" .
ui:doc-jl-remote-2 a c:Text ; c:label "Nothing else changes for the page: the same snapshot, deltas and cursors, applied through the runtime as one change each." .

ui:doc-jl-how-h a c:Heading ; c:level 2 ; c:label "What you can rely on" .
ui:doc-jl-how a c:DescriptionList ; c:of ui:doc-jl-how-items ; c:fields ( ui:jlh-conformance ui:jlh-bytes ui:jlh-speed ui:jlh-bounded ui:jlh-limits ) .
ui:doc-jl-how-items ui:jlh-conformance "Both engines and the TypeScript codec pass the Jelly conformance suite: every test of Jelly 1.2 and of reading 1.0 and 1.1, apart from those that need generalized RDF." ;
    ui:jlh-bytes "Where the format leaves a writer free (how an IRI splits into prefix and name, which lookup entry to reuse, when a frame ends), every writer here makes the same choice, so all three write the same bytes from the same statements. A test checks it." ;
    ui:jlh-speed "The hand-written WebAssembly engine writes the whole ontology in 14 ms and reads it back in 13 ms; the Rust build takes 25 and 17." ;
    ui:jlh-bounded "A reader holds its lookups, and a writer its lookups and the frame in progress. Neither does work that grows with what came before." ;
    ui:jlh-limits "A stream that asks for more than 16,384 names, 4,096 prefixes or 256 datatypes, or a batch of more than a million rows, is refused before anything is allocated." .
ui:jlh-conformance rdfs:label "Conformance" . ui:jlh-bytes rdfs:label "The same bytes" . ui:jlh-speed rdfs:label "Speed" .
ui:jlh-bounded rdfs:label "Bounded memory" . ui:jlh-limits rdfs:label "Limits" .

ui:doc-jl-not-h a c:Heading ; c:level 2 ; c:label "Not supported" .
ui:doc-jl-not a c:Text ; c:label "Writing the older 1.0 and 1.1 streams: any reader of 1.2 reads what Semblance writes. Generalized RDF (a literal as a subject, a blank node as a predicate) is refused, as RDF 1.2 refuses it. Namespace declarations are reported by the TypeScript reader and skipped by the engines." .

# --- Overview ---
ui:doc-overview a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-ov-h ui:doc-ov-1 ui:doc-ov-2 ui:ov-live ui:doc-ov-2b ui:doc-ov-3 ui:doc-ov-pipeline ui:doc-ov-4 ) .
ui:doc-ov-h a c:Heading ; c:level 1 ; c:label "Overview" .
ui:doc-ov-1 a c:Text ; c:label "Semblance describes a user interface as an RDF graph. The framework is a set of ontologies - components, layers, styles, behaviour - and an engine that projects a graph through rules into RDF/HTML, which a renderer patches into the DOM (or serializes as HTML or text)." .
ui:doc-ov-2 a c:Text ; c:label "Your application is data: instances of component classes, wired to your own vocabulary. A button is a resource with a label; a list is a resource that names the items it shows and the properties it reads from them; a page is a switch over a property of your app." .
ui:doc-ov-2b a c:Text ; c:label "That is a whole app: edit it and it renders again as you type; tick a todo and its reaction runs. The same graph is projected twice, on screen and as text. Every example in these docs runs like this, in a sandbox of its own." .
ui:ov-live a c:LiveExample ; c:label "A page of todos" ; c:exampleRoot <https://example.org/todos#page> ; c:textPreview true ; c:sources ( ui:ov-live-app ) .
ui:ov-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/todos#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:title ex:todos ex:add ) .
ex:title a c:Heading ; c:label "Todos" .
ex:todos a c:List ; c:label "Todos" ; c:sortBy ex:created ;
    c:itemLabel rdfs:label ; c:itemChecked ex:done ;
    c:item ex:write , ex:render .
ex:write rdfs:label "Write the ontology" ; ex:created 1 ; ex:done true .
ex:render rdfs:label "Render it" ; ex:created 2 ; ex:done false .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .''' .
ui:doc-ov-3 a c:Text ; c:label "Rules turn that graph into a projection. Each rule is itself a resource - a SPARQL CONSTRUCT, or a function registered under a name - so the whole pipeline can be queried. The pipeline:" .
ui:doc-ov-pipeline a c:Code ; c:block true ; c:label """component graph  ──►  rules (SPARQL | functions), stratified  ──►  RDF/HTML projection
                                                                         ├─► DOM (keyed patching)
                                                                         ├─► HTML (server-side)
                                                                         └─► text
DOM interaction ──► RDF event ──► reactions (CONSTRUCT pairs) ──► one delta ──► change log (LDES)""" .
ui:doc-ov-4 a c:Text ; c:children ( "Everything you see on this site is built that way, including this page and the tools (" ui:doc-ov-kbd " opens them). The " ui:doc-ov-examples " show complete applications; the " ui:doc-ov-components " page shows every component on its own." ) .
ui:doc-ov-kbd a c:Kbd ; c:keys ( "⌘" "." ) .
ui:doc-ov-examples a c:Link , c:Setter ; c:label "examples" ; c:href "/examples/" ; c:controls ui:app ; c:property ui:page ; c:value ui:Examples .
ui:doc-ov-components a c:Link , c:Setter ; c:label "components" ; c:href "/components/" ; c:controls ui:app ; c:property ui:page ; c:value ui:Components .

# --- Getting started ---
# Every step that shows Turtle shows it live (c:LiveExample, ontology/components/live.ttl): the
# source in an editor beside its rendering, in a sandbox of its own. The last step's sources are
# examples/hello, less the prefixes Semblance declares (test/live-example.test.ts checks it).
ui:doc-start a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-gs-h ui:doc-gs-1 ui:doc-gs-install ui:doc-gs-2 ui:doc-gs-vite ui:doc-gs-3 ui:gs-page ui:doc-gs-3b ui:doc-gs-4 ui:doc-gs-mount ui:doc-gs-5 ui:gs-tally ui:doc-gs-5b ui:doc-gs-6 ui:gs-react ui:doc-gs-7 ) .
ui:doc-gs-h a c:Heading ; c:level 1 ; c:label "Getting started" .
ui:doc-gs-1 a c:Text ; c:label "Semblance is the npm package @inferal-oss/semblance (not published yet: until it is, use a checkout of the repository, or npm pack it). It ships TypeScript, its ontologies and its WebAssembly engines, built by your bundler - today Vite." .
ui:doc-gs-install a c:Code ; c:block true ; c:language "shell" ; c:label """npm install @inferal-oss/semblance
npm install --save-dev vite""" .
ui:doc-gs-2 a c:Text ; c:label "The package finds its ontology files and engine builds with import.meta.glob, so Vite must not pre-bundle it; its Turtle parser, N3, is CommonJS and must be pre-bundled:" .
ui:doc-gs-vite a c:Code ; c:block true ; c:language "typescript" ; c:label """// vite.config.ts
export default defineConfig({
  optimizeDeps: {
    exclude: ['@inferal-oss/semblance', 'oxigraph'],
    include: ['@inferal-oss/semblance > n3'],
  },
})""" .
ui:doc-gs-3 a c:Text ; c:label "The interface is data. A page in Turtle, beside what it renders: edit it, and the rendering follows as you type." .
ui:doc-gs-3b a c:Text ; c:label "Each example here runs in a sandbox of its own: its own graph, rules and events, so an edit that does not parse only shows where it went wrong, beside the last rendering that worked. Semblance's prefixes (c:, sty:, pos:, tok:, beh: and the rest) are declared for the examples; Copy puts them in front of the source, so what you paste is a complete file." .
ui:doc-gs-4 a c:Text ; c:label "In your app the page is a file, app.ttl, and mount shows it. mount loads a store with Semblance's ontologies and your graphs, compiles the theme, projects the root, patches it into the element and routes its events to reactions:" .
ui:doc-gs-mount a c:Code ; c:block true ; c:language "typescript" ; c:label """import { mount } from '@inferal-oss/semblance/web'
import app from './app.ttl?raw'
import tally from './tally.ttl?raw'

await mount(document.getElementById('app')!, { root: 'https://example.org/hello#page', graphs: [tally, app] })""" .
ui:doc-gs-5 a c:Text ; c:label "A component of your own is an OWL class under sem:Component, a rendering slot that targets it, and a SPARQL rule that builds RDF/HTML for each instance ($this), minting every node from it. Here ex:Tally (tally.ttl) is used by the page (app.ttl): change the rule or the style rules and the page renders with them." .
ui:doc-gs-5b a c:Text ; c:label "Its shape says what an instance must say: take the label off ex:cups and the shapes layer outlines it and says why. Building components goes further: containers, lists, text output, layers, and when (rarely) to write a rule as a function." .
ui:doc-gs-6 a c:Text ; c:label "State is triples too, and events change it through reactions: a reaction names the event and its source and says what to delete and what to insert, as CONSTRUCTs over $this and $event. Click Have another: the reaction runs in the example's graph, and only what depends on the change is rendered again." .
ui:doc-gs-7 a c:Text ; c:children ( "The complete example is examples/hello in the repository, and docs/GETTING-STARTED.md walks through it, including rendering on the server. " ui:doc-gs-recipes " has more small examples, each live." ) .
ui:doc-gs-recipes a c:Link , c:Setter ; c:label "Recipes" ; c:href "/docs/recipes/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRecipes .

ui:gs-page a c:LiveExample ; c:label "A page" ; c:exampleRoot <https://example.org/hello#page> ; c:sources ( ui:gs-page-app ) .
ui:gs-page-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .''' .

ui:gs-tally a c:LiveExample ; c:label "A component of your own" ; c:exampleRoot <https://example.org/hello#page> ;
    c:sources ( ui:gs-tally-def ui:gs-tally-app ) ; c:selectedSource ui:gs-tally-def .
ui:gs-tally-def a c:CodeEditor ; c:language "turtle" ; c:label "tally.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# A component of our own: a figure with its label and unit. One class, one rendering slot, one
# SPARQL rule for it, a shape for what an instance must say, and how it looks.

ex:Tally a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:comment "A figure (c:value) with its label (c:label) and an optional unit (ex:unit)."@en ;
    sem:slug "ex-tally" .
ex:unit a owl:DatatypeProperty ; rdfs:domain ex:Tally .

ex:TallyRendering a sem:Rendering ; sem:targets ex:Tally ; sem:stratum 0 .
ex:TallyRendering-sparql a sem:Rule ;
    sem:implements ex:TallyRendering ;
    sem:construct """
PREFIX ex: <https://example.org/hello#>
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?figure .
  ?name a rdfhtml:Span ; rdfhtml:class "ex-tally-label" ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?figure .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?figure a rdfhtml:Strong ; rdfhtml:hasChild ?figureText .
  ?figureText a rdfhtml:Text ; rdfhtml:data ?shown .
}
WHERE {
  $this a ex:Tally ; c:label ?label .
  OPTIONAL { $this c:value ?value }
  OPTIONAL { $this ex:unit ?unit }
  BIND(CONCAT(STR(COALESCE(?value, 0)), IF(BOUND(?unit), CONCAT(" ", ?unit), "")) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~figure")) AS ?figure)
  BIND(IRI(CONCAT(STR($this), "/~figure-text")) AS ?figureText)
}""" .

ex:TallyShape a sh:NodeShape ; sh:targetClass ex:Tally ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A tally needs a label (c:label): say what the figure is." ] ,
                [ sh:path c:value ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

[] a sty:StyleRule ; sty:appliesTo ex:Tally ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part "> strong" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-2xl ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part ".ex-tally-label" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] .''' .
ui:gs-tally-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:cups ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:cups a ex:Tally ; c:label "Coffee today" ; c:value 0 ; ex:unit "cups" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .''' .

ui:gs-react a c:LiveExample ; c:label "State and reactions" ; c:exampleRoot <https://example.org/hello#page> ;
    c:sources ( ui:gs-react-def ui:gs-react-app ) ; c:selectedSource ui:gs-react-app .
ui:gs-react-def a c:CodeEditor ; c:language "turtle" ; c:label "tally.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# A component of our own: a figure with its label and unit. One class, one rendering slot, one
# SPARQL rule for it, a shape for what an instance must say, and how it looks.

ex:Tally a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:comment "A figure (c:value) with its label (c:label) and an optional unit (ex:unit)."@en ;
    sem:slug "ex-tally" .
ex:unit a owl:DatatypeProperty ; rdfs:domain ex:Tally .

ex:TallyRendering a sem:Rendering ; sem:targets ex:Tally ; sem:stratum 0 .
ex:TallyRendering-sparql a sem:Rule ;
    sem:implements ex:TallyRendering ;
    sem:construct """
PREFIX ex: <https://example.org/hello#>
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?figure .
  ?name a rdfhtml:Span ; rdfhtml:class "ex-tally-label" ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?figure .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?figure a rdfhtml:Strong ; rdfhtml:hasChild ?figureText .
  ?figureText a rdfhtml:Text ; rdfhtml:data ?shown .
}
WHERE {
  $this a ex:Tally ; c:label ?label .
  OPTIONAL { $this c:value ?value }
  OPTIONAL { $this ex:unit ?unit }
  BIND(CONCAT(STR(COALESCE(?value, 0)), IF(BOUND(?unit), CONCAT(" ", ?unit), "")) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~figure")) AS ?figure)
  BIND(IRI(CONCAT(STR($this), "/~figure-text")) AS ?figureText)
}""" .

ex:TallyShape a sh:NodeShape ; sh:targetClass ex:Tally ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A tally needs a label (c:label): say what the figure is." ] ,
                [ sh:path c:value ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

[] a sty:StyleRule ; sty:appliesTo ex:Tally ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part "> strong" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-2xl ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part ".ex-tally-label" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] .''' .
ui:gs-react-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# The app: built-in components and ours, in one graph.

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:cups ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:cups a ex:Tally ; c:label "Coffee today" ; c:value 0 ; ex:unit "cups" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .

# What a click on the button means: one more cup. Delete the old value, insert the new one.
ex:Drink a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:drink ;
    beh:deletes """PREFIX ex: <https://example.org/hello#>
CONSTRUCT { ex:cups c:value ?n } WHERE { ex:cups c:value ?n }""" ;
    beh:inserts """PREFIX ex: <https://example.org/hello#>
CONSTRUCT { ex:cups c:value ?next } WHERE { ex:cups c:value ?n BIND(?n + 1 AS ?next) }""" .''' .

# --- Recipes ---
# Small examples, each live (c:LiveExample) and each a sentence or two. Their queries name the
# example's own prefix through sh:declare (sh:prefix, sh:namespace), which every rule and reaction
# of the graph then knows.
ui:doc-recipes a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-rc-h ui:doc-rc-1
                 ui:doc-rc-mirror-h ui:doc-rc-mirror ui:rc-mirror
                 ui:doc-rc-valid-h ui:doc-rc-valid ui:rc-valid
                 ui:doc-rc-list-h ui:doc-rc-list ui:rc-list
                 ui:doc-rc-theme-h ui:doc-rc-theme ui:rc-theme
                 ui:doc-rc-text-h ui:doc-rc-text ui:rc-text
                 ui:doc-rc-l10n-h ui:doc-rc-l10n ui:doc-rc-language ui:rc-l10n ) .
ui:doc-rc-h a c:Heading ; c:level 1 ; c:label "Recipes" .
ui:doc-rc-1 a c:Text ; c:label "Small things, each a few lines of Turtle you can edit beside what they render. Their queries use the example's own prefix, declared once for every rule and reaction in the graph the SHACL way (sh:declare, with sh:prefix and sh:namespace); Semblance's own are known already." .

ui:doc-rc-mirror-h a c:Heading ; c:level 2 ; c:label "A field mirrored into a heading" .
ui:doc-rc-mirror a c:Text ; c:label "Typing is an event too (beh:Input), and $event beh:value is what the field holds now. Beside the field's own reaction, which keeps its c:value, ours rewrites the heading's label." .
ui:rc-mirror a c:LiveExample ; c:label "A field mirrored into a heading" ; c:exampleRoot <https://example.org/mirror#page> ; c:sources ( ui:rc-mirror-app ) .
ui:rc-mirror-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/mirror#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/mirror#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:greeting ex:name ) .
ex:greeting a c:Heading ; c:level 2 ; c:label "Hello, stranger" .
ex:name a c:TextField ; c:label "Your name" ; c:placeholder "Ada" .

ex:Mirror a beh:Reaction ;
    beh:when beh:Input ; beh:source ex:name ;
    beh:deletes """CONSTRUCT { ex:greeting c:label ?old } WHERE { ex:greeting c:label ?old }""" ;
    beh:inserts """CONSTRUCT { ex:greeting c:label ?greeting } WHERE {
  $event beh:value ?typed .
  BIND(CONCAT("Hello, ", IF(STRLEN(?typed) > 0, ?typed, "stranger")) AS ?greeting)
}""" .''' .

ui:doc-rc-valid-h a c:Heading ; c:level 2 ; c:label "Save only what is valid" .
ui:doc-rc-valid a c:Text ; c:label "A field points at a SHACL property shape (val:validates); the validation layer derives its error from the shape and its message. A button that val:requires the field stays disabled until it conforms, so the Save reaction only ever sees a valid address." .
ui:rc-valid a c:LiveExample ; c:label "Save only what is valid" ; c:exampleRoot <https://example.org/signup#page> ; c:sources ( ui:rc-valid-app ) .
ui:rc-valid-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/signup#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/signup#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:email ex:save ex:saved ) .
ex:email a c:TextField ; c:label "Email" ; c:placeholder "you@example.org" ;
    val:validates ex:EmailShape .
ex:save a c:Button ; c:label "Save" ; sty:intent sty:Primary ; val:requires ( ex:email ) .
ex:saved a c:Text ; c:label "Nothing saved yet." .

ex:EmailShape a sh:PropertyShape ; sh:path c:value ; sh:minCount 1 ;
    sh:pattern "^[^@ ]+@[^@ ]+[.][^@ ]+$" ;
    sh:message "Enter an address like you@example.org." .

ex:Save a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:save ;
    beh:deletes """CONSTRUCT { ex:saved c:label ?old } WHERE { ex:saved c:label ?old }""" ;
    beh:inserts """CONSTRUCT { ex:saved c:label ?done } WHERE {
  ex:email c:value ?email BIND(CONCAT("Saved ", ?email, ".") AS ?done)
}""" .''' .

ui:doc-rc-list-h a c:Heading ; c:level 2 ; c:label "A list bound to data" .
ui:doc-rc-list a c:Text ; c:label "A c:List shows data items (c:item), sorted by one of their properties, with a checkbox for another. Adding mints a new item from the event, so each is its own resource; removing deletes the items and their triples. Each item renders on its own, so a change touches only it." .
ui:rc-list a c:LiveExample ; c:label "A list bound to data" ; c:exampleRoot <https://example.org/groceries#page> ; c:sources ( ui:rc-list-app ) .
ui:rc-list-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/groceries#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/groceries#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:list ex:new ex:actions ) .
ex:list a c:List ; c:label "Groceries" ; c:sortBy ex:added ;
    c:itemLabel rdfs:label ; c:itemChecked ex:got ;
    c:item ex:bread , ex:milk .
ex:bread rdfs:label "Bread" ; ex:added 1 ; ex:got false .
ex:milk rdfs:label "Milk" ; ex:added 2 ; ex:got true .
ex:new a c:TextField ; c:label "Something else" ; c:placeholder "Apples" .
ex:actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ex:add ex:clear ) .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .
ex:clear a c:Button ; c:label "Remove what we got" .

ex:Add a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:add ;
    beh:deletes """CONSTRUCT { ex:new c:value ?v } WHERE { ex:new c:value ?v }""" ;
    beh:inserts """CONSTRUCT { ex:list c:item ?item . ?item rdfs:label ?v ; ex:added ?next ; ex:got false }
WHERE {
  ex:new c:value ?v FILTER(REGEX(?v, "[^ ]"))
  BIND(IRI(CONCAT(STR(ex:), "item-", STRAFTER(STR($event), "urn:semblance:event:"))) AS ?item)
  { SELECT (COALESCE(MAX(?n), 0) + 1 AS ?next) WHERE { ?any ex:added ?n } }
}""" .
ex:Clear a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:clear ;
    beh:deletes """CONSTRUCT { ex:list c:item ?item . ?item ?p ?o }
WHERE { ex:list c:item ?item . ?item ex:got true ; ?p ?o }""" .''' .

ui:doc-rc-theme-h a c:Heading ; c:level 2 ; c:label "A theme for part of a page" .
ui:doc-rc-theme a c:Text ; c:label "sty:theme on any component re-values every token under it, so the nearest theme wins, even inside another. The segmented control writes that one triple; tones (sty:tone) keep their meaning in every theme. Doodle and Classic rebuild the controls, not only their colours." .
ui:rc-theme a c:LiveExample ; c:label "A theme for part of a page" ; c:exampleRoot <https://example.org/themes#page> ; c:sources ( ui:rc-theme-app ) .
ui:rc-theme-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/themes#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:pick ex:card ) .
ex:pick a c:Segmented ; c:label "Theme" ; c:controls ex:card ; c:property sty:theme ;
    c:options ( sty:Semblance sty:Terminal sty:Doodle sty:Classic ) .
ex:card a c:Surface ; sty:theme sty:Terminal ; sty:elevation sty:Raised ;
    pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ex:title ex:state ex:go ) .
ex:title a c:Heading ; c:level 3 ; c:label "Release 1.4" .
ex:state a c:Badge ; c:label "Checks passed" ; sty:tone sty:Success .
ex:go a c:Button ; c:label "Ship it" ; sty:intent sty:Primary .''' .

ui:doc-rc-text-h a c:Heading ; c:level 2 ; c:label "A component that renders as text too" .
ui:doc-rc-text a c:Text ; c:label "A projection has a modality. A rule that applies to one says so (sem:modality); write one per modality the component makes sense in. This meter is a bar on screen and a row of blocks in the Text modality, shown under the screen here: the same graph, the same click, two renderings." .
ui:rc-text a c:LiveExample ; c:label "A component that renders as text too" ; c:exampleRoot <https://example.org/meter#page> ; c:textPreview true ;
    c:sources ( ui:rc-text-def ui:rc-text-app ) ; c:selectedSource ui:rc-text-def .
ui:rc-text-def a c:CodeEditor ; c:language "turtle" ; c:label "meter.ttl" ; c:original '''@prefix ex: <https://example.org/meter#> .

ex:Meter a owl:Class ; rdfs:subClassOf sem:Component ; sem:slug "ex-meter" .
ex:MeterRendering a sem:Rendering ; sem:targets ex:Meter ; sem:stratum 0 .

# On screen: the label, and a bar as long as the value (out of 10).
ex:MeterRendering-screen a sem:Rule ; sem:implements ex:MeterRendering ; sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?bar .
  ?name a rdfhtml:Span ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?bar .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?bar a rdfhtml:Span ; rdfhtml:class "ex-meter-bar" ; rdfhtml:style ?width .
}
WHERE {
  $this a ex:Meter ; c:label ?label ; c:value ?n .
  BIND(CONCAT("--level: ", STR(?n * 10), "%") AS ?width)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~bar")) AS ?bar)
}""" .

# In text: one line of blocks.
ex:MeterRendering-text a sem:Rule ; sem:implements ex:MeterRendering ; sem:modality mod:Text ;
    sem:construct """
CONSTRUCT { ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?line . ?line a rdfhtml:Text ; rdfhtml:data ?shown . }
WHERE {
  $this a ex:Meter ; c:label ?label ; c:value ?n .
  BIND(CONCAT(?label, "  ", SUBSTR("##########", 1, ?n), SUBSTR("..........", 1, 10 - ?n), "  ", STR(?n), "/10") AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~line")) AS ?line)
}""" .

[] a sty:StyleRule ; sty:appliesTo ex:Meter ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] , [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Meter ; sty:part ".ex-meter-bar" ;
    sty:declares [ sty:property "height" ; sty:raw "8px" ] ,
                 [ sty:property "width" ; sty:raw "var(--level)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-full ] ,
                 [ sty:property "background" ; sty:token tok:accent ] ,
                 [ sty:property "transition" ; sty:raw "width var(--sem-duration) var(--sem-ease)" ] .''' .
ui:rc-text-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/meter#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/meter#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:volume ex:louder ) .
ex:volume a ex:Meter ; c:label "Volume" ; c:value 3 .
ex:louder a c:Button ; c:label "Louder" .

ex:Louder a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:louder ;
    beh:deletes """CONSTRUCT { ex:volume c:value ?n } WHERE { ex:volume c:value ?n }""" ;
    beh:inserts """CONSTRUCT { ex:volume c:value ?next } WHERE { ex:volume c:value ?n BIND((?n + 1) - 11 * FLOOR((?n + 1) / 11) AS ?next) }""" .''' .

ui:doc-rc-l10n-h a c:Heading ; c:level 2 ; c:label "Labels in the viewer's language" .
ui:doc-rc-l10n a c:Text ; c:label "A label is the untagged source text plus its translations, as language-tagged literals; the localization layer picks the one in the viewer's language, else the source. The examples render in this site's language: choose another here (it is the site's own setting, also among the display settings of the Components page) and the labels follow; Arabic turns the page right to left." .
ui:doc-rc-language a c:Segmented ; c:label "Language" ; c:controls ui:app ; c:property l10n:language .
ui:rc-l10n a c:LiveExample ; c:label "Labels in the viewer's language" ; c:exampleRoot <https://example.org/greeting#page> ; c:sources ( ui:rc-l10n-app ) .
ui:rc-l10n-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/greeting#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:title ex:name ex:save ) .
ex:title a c:Heading ; c:level 2 ;
    c:label "Good morning" , "Доброго ранку"@uk , "Guten Morgen"@de , "صباح الخير"@ar .
ex:name a c:TextField ;
    c:label "Name" , "Ім’я"@uk , "Name"@de , "الاسم"@ar ;
    c:placeholder "Ada" , "Олена"@uk , "Erika"@de , "ليلى"@ar .
ex:save a c:Button ; sty:intent sty:Primary ;
    c:label "Save" , "Зберегти"@uk , "Speichern"@de , "حفظ"@ar .''' .

# Edits of the examples are remembered for this tab, with the source each shows.
ui:rememberLiveExamples a per:Policy ; per:scope per:Session ;
    rdfs:label "The live examples' edits" , "Зміни в живих прикладах"@uk , "Änderungen an den Live-Beispielen"@de , "تعديلات الأمثلة الحية"@ar ;
    per:construct """
CONSTRUCT { ?editor c:value ?text . ?example c:selectedSource ?shown }
WHERE {
  ?example a c:LiveExample .
  { ?example c:sources/rdf:rest*/rdf:first ?editor . ?editor c:value ?text }
  UNION { ?example c:selectedSource ?shown }
}""" .

# --- Building components ---
ui:doc-components a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-cp-h ui:doc-cp-1 ui:doc-cp-2 ui:cp-live ui:doc-cp-2b ui:doc-cp-3 ui:doc-cp-rules ui:doc-cp-4 ui:doc-cp-5 ui:doc-cp-fn ui:doc-cp-6 ) .
ui:doc-cp-h a c:Heading ; c:level 1 ; c:label "Building components" .
ui:doc-cp-1 a c:Text ; c:label "A component is an OWL class under sem:Component, a rendering slot that targets it (sem:Rendering), and rules that implement the slot. A SHACL shape says what an instance must say; style rules say how it looks in every theme. All of it is Turtle in the same graph as the app that uses it." .
ui:doc-cp-2 a c:Text ; c:label "Write the rule in SPARQL. A SPARQL CONSTRUCT is the implementation: it is data, so it can be inspected (turn a component over, or open the Inspector), queried and run on any store. It builds RDF/HTML for $this, minting every node from it (never blank nodes), so nodes keep their identity and DOM elements are reused:" .
ui:doc-cp-2b a c:Text ; c:label "The vocabulary file declares its prefix for queries once (sh:declare), so the rule can say ex:Avatar. Its style rules use tokens, so the avatar follows the theme, the colour scheme and the density like everything else. Change the rule - another element, other initials - and the people re-render with it." .
ui:cp-live a c:LiveExample ; c:label "A component of your own" ; c:exampleRoot <https://example.org/people#page> ;
    c:sources ( ui:cp-live-def ui:cp-live-app ) ; c:selectedSource ui:cp-live-def .
ui:cp-live-def a c:CodeEditor ; c:language "turtle" ; c:label "avatar.ttl" ; c:original '''@prefix ex: <https://example.org/people#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/people#"^^xsd:anyURI ] .

# A person's initials in a circle, and their name beside it.
ex:Avatar a owl:Class ; rdfs:subClassOf sem:Component ; sem:slug "ex-avatar" .
ex:AvatarRendering a sem:Rendering ; sem:targets ex:Avatar ; sem:stratum 0 .
ex:AvatarRendering-sparql a sem:Rule ; sem:implements ex:AvatarRendering ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?mark, ?name .
  ?mark a rdfhtml:Span ; rdfhtml:class "ex-avatar-mark" ; rdfhtml:hasChild ?markText ;
        ord:immediatelyPrecedes ?name .
  ?markText a rdfhtml:Text ; rdfhtml:data ?initials .
  ?name a rdfhtml:Span ; rdfhtml:hasChild ?nameText .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
}
WHERE {
  $this a ex:Avatar ; c:label ?label .
  BIND(UCASE(CONCAT(SUBSTR(?label, 1, 1), SUBSTR(STRAFTER(?label, " "), 1, 1))) AS ?initials)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~mark")) AS ?mark)
  BIND(IRI(CONCAT(STR($this), "/~mark-text")) AS ?markText)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
}""" .

ex:AvatarShape a sh:NodeShape ; sh:targetClass ex:Avatar ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "An avatar needs a name (c:label)." ] .

[] a sty:StyleRule ; sty:appliesTo ex:Avatar ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] ,
                 [ sty:property "gap" ; sty:token tok:space-2 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Avatar ; sty:part ".ex-avatar-mark" ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "place-items" ; sty:raw "center" ] ,
                 [ sty:property "inline-size" ; sty:raw "2.25em" ] ,
                 [ sty:property "block-size" ; sty:raw "2.25em" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-full ] ,
                 [ sty:property "background" ; sty:token tok:accent-soft ] ,
                 [ sty:property "color" ; sty:token tok:accent-strong ] ,
                 [ sty:property "font-weight" ; sty:raw "600" ] .''' .
ui:cp-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/people#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:ada ex:alan ) .
ex:ada a ex:Avatar ; c:label "Ada Lovelace" .
ex:alan a ex:Avatar ; c:label "Alan Turing" .''' .
ui:doc-cp-3 a c:Text ; c:label "What makes a rule run again is declared too:" .
ui:doc-cp-rules a c:DescriptionList ; c:of ui:doc-cp-rule-items ; c:fields ( ui:rr-self ui:rr-follows ui:rr-watches ui:rr-requires ui:rr-foreach ui:rr-modality ) .
ui:doc-cp-rule-items ui:rr-self "A change to the component's own triples marks it dirty; the engine diffs the output and patches only what changed." ;
    ui:rr-follows "sem:follows c:of - so do changes to the node it points at." ;
    ui:rr-watches "sem:watches c:value - only these predicates make it dirty." ;
    ui:rr-requires "sem:requires c:icon - skipped for instances without the property." ;
    ui:rr-foreach "sem:forEach c:item - member-wise: once per member, so one item changes alone." ;
    ui:rr-modality "sem:modality mod:Text - a rule for one modality; write one per modality the component renders in." .
ui:rr-self rdfs:label "Its triples" . ui:rr-follows rdfs:label "Follows" . ui:rr-watches rdfs:label "Watches" .
ui:rr-requires rdfs:label "Requires" . ui:rr-foreach rdfs:label "For each" . ui:rr-modality rdfs:label "Modality" .
ui:doc-cp-4 a c:Text ; c:label "What an instance must say is a SHACL shape on the class (ex:AvatarShape above). The shapes layer validates every component as it renders, outlines the ones that do not conform and lists them; here the problems list under the rendering says which and why. Take the label off ex:alan to see it." .
ui:doc-cp-5 a c:Text ; c:label "A rule can also be a function registered under a name (sem:function). Functions are an escape hatch for the rare step SPARQL cannot express - and first look for a building block that puts the missing input in the graph - and an oracle: a function twin renders the identical HTML, faster, and the tests compare the two after every step. A component without a SPARQL rule is incomplete." .
ui:doc-cp-fn a c:Code ; c:block true ; c:language "typescript" ; c:label """// A function twin: same nodes, same IRIs, same HTML (the parity tests check it).
const tally: FnRule = (ctx, focus) => {
  const o = ctx.out(focus)
  const label = text(ctx, focus, C.label)
  if (label === undefined) return []
  const shown = String(Number(ctx.object(focus, C.value)?.value ?? 0)) + ...
  o.renders(o.el('root', 'Div', {}, [o.el('name', 'Span', {}, [o.text('name-text', label)]), o.el('figure', 'Strong', {}, [o.text('figure-text', shown)])]))
  return o.quads
}""" .
ui:doc-cp-6 a c:Text ; c:label "Components come in groups - layout, type, actions, inputs, feedback, data, navigation, overlays, disclosure, windows, inspection - each one file of vocabulary, one of styles, one of function twins and one gallery page. A class says its group (sem:group), and so do its parts; a specimen says which classes it demonstrates (c:demonstrates), and is shown on their group's page. docs/COMPONENTS.md in the repository has the details." .

# --- Integrating ---
ui:doc-integrate a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-in-h ui:doc-in-1 ui:doc-in-code ui:doc-in-list ui:doc-in-remote ui:doc-in-stall-h ui:doc-in-stall-1 ui:doc-in-stall-code ui:doc-in-stall-list ) .
ui:doc-in-h a c:Heading ; c:level 1 ; c:label "Integrating" .
ui:doc-in-1 a c:Text ; c:label "mount is the short way. The pieces it wires, for when you need them yourself:" .
ui:doc-in-code a c:Code ; c:block true ; c:language "typescript" ; c:label """await initWeb('wat')
const store = loadStore('wat', components, app)    // Semblance's ontology + yours
const runtime = new Runtime(store)                   // one graph, many projections
const screen = runtime.project({ modality: MOD.Screen, layers, roots: [root] })
const renderer = new DomRenderer(screen.index, element, root)
renderer.flush()
new EventBus(runtime, screen).attach(renderer, () => renderer.flush())""" .
ui:doc-in-list a c:DescriptionList ; c:of ui:doc-in-items ; c:fields ( ui:in-data ui:in-proj ui:in-embed ui:in-ssr ui:in-per ui:in-nav ui:in-safe ui:in-jelly ) .
ui:doc-in-items ui:in-data "Change the graph with runtime.apply({ add, remove }) or runtime.transaction(…), then flush; read it with store.match or SPARQL. Keep your data in your own vocabulary and point components at it." ;
    ui:in-proj "runtime.project again for another root or the Text modality; every change reaches all projections once." ;
    ui:in-embed "Mount several roots into an existing page, or place an unstyled c:HostSlot inside a layout and mount existing content into renderer.slot(name)." ;
    ui:in-ssr "In Node, loadStore from @inferal-oss/semblance/node, project, and toHTML or toText." ;
    ui:in-per "per:Policy nodes say what to remember; attach Persistence before the first projection." ;
    ui:in-nav "nav:Location says which state lives in the address; attach Navigation, and links can point at resources (c:to)." ;
    ui:in-safe "A graph from a visitor or a model goes in mount's authored, not graphs: it renders under the safe:Authored policy (no script, no embedded documents, no styles or images loaded from elsewhere on its own), and what is refused is reported to onRefused. The live examples here run that way; Safe authoring, in these docs, has how it works, extending the policy and a Content Security Policy to go with it." ;
    ui:in-jelly "Jelly is a binary RDF format with a streaming protocol. store.loadJelly(bytes) takes a stream, and store.dumpJelly() gives what the store holds as one. The engines read and write it natively, and N3.js and Oxigraph go through the same codec. A remote source's stream travels as Jelly whenever the server offers it. Binary RDF (Jelly), in these docs, has when it pays and when Turtle is better." .
ui:in-data rdfs:label "Your data" . ui:in-proj rdfs:label "Projections" . ui:in-embed rdfs:label "Embedding" .
ui:in-ssr rdfs:label "Server" . ui:in-per rdfs:label "Remembering" . ui:in-nav rdfs:label "The address" .
ui:in-safe rdfs:label "Untrusted graphs" . ui:in-jelly rdfs:label "Binary RDF (Jelly)" .
ui:doc-in-remote a c:Text ; c:children ( "Data that lives in a triple store behind a server is bound, not loaded: a src:Source says which part, mount's sources says where, and the page follows the store's changes and writes its own back. " ui:doc-in-to-remote " has how." ) .
ui:doc-in-to-remote a c:Link , c:Setter ; c:label "Remote data" ; c:href "/docs/remote/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRemote .
ui:doc-in-stall-h a c:Heading ; c:level 2 ; c:label "When the page is busy" .
ui:doc-in-stall-1 a c:Text ;
    c:children ( "A turn - an event, its reactions, the maintained views and every projection's rules - has a budget. The engine checks it between evaluations; over it, the turn is suspended at a consistent point and what is left is held, not lost. The stall effect records a " ui:doc-in-m-Stall ", raises an event on your " ui:doc-in-m-Watchdog " and its reaction opens your dialog, a " ui:doc-in-m-Report " in an ordinary c:Dialog. Hangs nothing could interrupt are noticed by a heartbeat worker and the browser's long-task observers, and logged to " ui:doc-in-m-Log " (Tools › Engine)." ) .
ui:doc-in-m-Stall a c:Link ; c:label "sem:Stall" ; c:to sem:Stall ; c:href "/reference/sem:Stall/" .
ui:doc-in-m-Watchdog a c:Link ; c:label "sem:Watchdog" ; c:to sem:Watchdog ; c:href "/reference/sem:Watchdog/" .
ui:doc-in-m-Report a c:Link ; c:label "c:StallReport" ; c:to c:StallReport ; c:href "/reference/c:StallReport/" .
ui:doc-in-m-Log a c:Link ; c:label "sem:StallLog" ; c:to sem:StallLog ; c:href "/reference/sem:StallLog/" .
ui:doc-in-stall-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ui:watchdog a sem:Watchdog ; sem:budget "PT1.5S"^^xsd:duration ; sem:stallDialog ui:busy .
ui:busy a c:Dialog ; c:label "The page is busy" ; c:content ui:busyReport ; c:actions ( ui:stop ui:continue ) .
ui:busyReport a c:StallReport ; c:of ui:watchdog .
ui:continue a c:Button ; c:label "Continue" ; sem:decides ui:watchdog ; sem:stallChoice sem:Continue .
ui:stop a c:Button ; c:label "Stop" ; sem:decides ui:watchdog ; sem:stallChoice sem:Stop .

// the host: new StallMonitor(runtime, { watchdog: ui + 'watchdog', bus, flush }).attach()""" .
ui:doc-in-stall-list a c:DescriptionList ; c:of ui:doc-in-stall-items ; c:fields ( ui:in-continue ui:in-stop ui:in-query ui:in-hang ui:in-sandbox ) .
ui:doc-in-stall-items ui:in-continue "The held work runs in slices (sem:slice) with a yield between them, so the page answers and shows progress. Continued to the end, the result is the same as a turn that was never suspended. Closing the dialog continues too." ;
    ui:in-stop "The held work is dropped. Renderings whose component is gone are retracted; the others keep what they showed before and are counted out of date (sem:outOfDate) until their input changes or sem:Retry runs them. The input, the views and the change log are not rolled back." ;
    ui:in-query "A single query cannot be interrupted from outside. Semblance's WASM engines take a deadline (the end of the budget) and stop a query at it, which is a stall like any other; Oxigraph has no such hook, and its long query runs to the end." ;
    ui:in-hang "What the engine could not interrupt - a long query, DOM patching, layout - is noticed when the page answers again, blamed on the work it overlapped, logged, and announced when it lasted longer than sem:hangAfter." ;
    ui:in-sandbox "Live examples have a budget of their own: a sandbox over it stops itself and shows the problem inline, and the site never waits on it." .
ui:in-continue rdfs:label "Continue" . ui:in-stop rdfs:label "Stop" . ui:in-query rdfs:label "One long query" .
ui:in-hang rdfs:label "Hangs" . ui:in-sandbox rdfs:label "Sandboxes" .

# --- Safe authoring --- (docs/SAFETY.md says the same, at more length)
ui:doc-safety a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-sa-h ui:doc-sa-1 ui:doc-sa-2
                 ui:doc-sa-trust-h ui:doc-sa-trust-1 ui:doc-sa-trust-code ui:doc-sa-trust-2 ui:doc-sa-trust-3
                 ui:doc-sa-try-h ui:doc-sa-try-1 ui:sa-live ui:doc-sa-try-2
                 ui:doc-sa-may-h ui:doc-sa-may ui:doc-sa-not-h ui:doc-sa-not ui:doc-sa-not-2
                 ui:doc-sa-box-h ui:doc-sa-box-1 ui:doc-sa-box ui:doc-sa-box-2 ui:doc-sa-shadow ui:doc-sa-shadow-code ui:doc-sa-shadow-2
                 ui:doc-sa-how-h ui:doc-sa-how-1 ui:doc-sa-how-code ui:doc-sa-how-2 ui:doc-sa-how-list ui:doc-sa-how-3
                 ui:doc-sa-budget-h ui:doc-sa-budget-1 ui:doc-sa-budget ui:doc-sa-budget-2
                 ui:doc-sa-ref-h ui:doc-sa-ref ui:doc-sa-rep-1 ui:doc-sa-rep
                 ui:doc-sa-ext-h ui:doc-sa-ext-1 ui:doc-sa-ext-code ui:doc-sa-ext-2 ui:doc-sa-ext-ts ui:doc-sa-ext-3 ui:doc-sa-ext-own ui:doc-sa-ext-4
                 ui:doc-sa-csp-h ui:doc-sa-csp-1 ui:doc-sa-csp-ts ui:doc-sa-csp-code ui:doc-sa-csp-list ui:doc-sa-csp-2 ui:doc-sa-tt-1 ui:doc-sa-tt-code ui:doc-sa-tt-2 ui:doc-sa-csp-3
                 ui:doc-sa-depth-h ui:doc-sa-depth ui:doc-sa-depth-remote
                 ui:doc-sa-not-cov-h ui:doc-sa-not-cov
                 ui:doc-sa-ex-h ui:doc-sa-ex-1 ui:doc-sa-ex ui:doc-sa-more ) .
ui:doc-sa-h a c:Heading ; c:level 1 ; c:label "Safe authoring" .
ui:doc-sa-1 a c:Text ; c:label "A Semblance interface is a graph, and a graph can come from someone you do not trust: a person typing in a live example, a page, a model. Authored content is rendered under a policy, so that Turtle and SPARQL describe an interface without running code or reaching outside what it renders." .
ui:doc-sa-2 a c:Text ; c:children ( "The policy is vocabulary, " ui:doc-sa-m-Authored " (a " ui:doc-sa-m-Policy ", ontology/layers/safety.ttl), applied in one place every output reads from. What it refuses is left out and reported, never dropped silently." ) .
ui:doc-sa-m-Authored a c:Mention ; c:label "safe:Authored" ; c:mentions safe:Authored ; c:to safe:Authored .
ui:doc-sa-m-Policy a c:Mention ; c:label "safe:Policy" ; c:mentions safe:Policy ; c:to safe:Policy .

ui:doc-sa-trust-h a c:Heading ; c:level 2 ; c:label "Trusted and authored" .
ui:doc-sa-trust-1 a c:Text ; c:label "Trust is the host's decision, never the graph's: no triple makes a graph trusted. The framework's ontology, the themes and your app's own Turtle (mount's graphs, a site's graphs) are trusted and render as written. Everything else you render is authored: pass it as authored, and it is loaded after graphs." .
ui:doc-sa-trust-code a c:Code ; c:block true ; c:language "typescript" ; c:label """await mount(element, { root, graphs: [appTtl], authored: [fromTheModel], onRefused: (e) => report(e.message) })

// or give a projection the policy yourself, read from a store you trust
runtime.project({ …, policy: authoredPolicy(trusted) })
renderToString({ …, policy })
compileStyles(store, { policy, onRefused })""" .
ui:doc-sa-trust-2 a c:Text ; c:label "The policy is read from a trusted store: one with the ontology and your own graphs, not the author's, which could add to its lists. mount reads it from a store of graphs alone, kept apart from the one authored is loaded into; the live examples read it from the ontology alone." .
ui:doc-sa-trust-3 a c:Text ; c:label "Authored is a property of a projection, not of triples. A projection with a policy checks everything it renders, your own components included. In mount({ authored }) your graphs and the author's are one store, so the author's triples can also describe your resources and its reactions can change any state of the store. The host's effects are not part of that: they read their configuration from the trusted graphs alone (app.trusted). When the rest matters, give the author a store of its own, as the live examples do." .

ui:doc-sa-try-h a c:Heading ; c:level 2 ; c:label "Try it" .
ui:doc-sa-try-1 a c:Text ; c:label "This example is authored, like every live example here. It links to a web address and to a script address, and brings a component of its own whose SPARQL rendering asks for a script element and whose style loads an image from elsewhere. Edit it and watch the warnings under the editor." .
ui:sa-live a c:LiveExample ; c:label "What the policy refuses" ; c:exampleRoot <https://example.org/safe#page> ; c:textPreview true ; c:sources ( ui:sa-live-app ) .
ui:sa-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/safe#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:web ex:script ex:sneaky ) .
ex:web a c:Link ; c:label "A web address: kept" ; c:href "https://semblance.dev/" .
ex:script a c:Link ; c:label "A script address: left out" ; c:href "javascript:alert(1)" .

# A component of the author's own: its rendering asks for a script element.
ex:Sneaky a owl:Class ; rdfs:subClassOf sem:Component ; sem:slug "ex-sneaky" .
ex:SneakyRendering a sem:Rendering ; sem:targets ex:Sneaky ; sem:stratum 0 .
ex:SneakyRendering-sparql a sem:Rule ; sem:implements ex:SneakyRendering ; sem:construct """
PREFIX ex: <https://example.org/safe#>
CONSTRUCT { ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?s .
            ?s a rdfhtml:Script ; rdfhtml:hasChild ?t . ?t a rdfhtml:Text ; rdfhtml:data "alert(1)" }
WHERE { $this a ex:Sneaky .
        BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root) BIND(IRI(CONCAT(STR($this), "/~s")) AS ?s)
        BIND(IRI(CONCAT(STR($this), "/~t")) AS ?t) }""" .
ex:sneaky a ex:Sneaky .

# Its style: the outline is kept, the image from elsewhere is not.
[] a sty:StyleRule ; sty:appliesTo ex:Sneaky ;
    sty:declares [ sty:property "outline" ; sty:raw "1px dashed currentColor" ] ,
                 [ sty:property "min-block-size" ; sty:raw "1.5rem" ] ,
                 [ sty:property "background" ; sty:raw "url(https://tracker.example/pixel.png)" ] .''' .
ui:doc-sa-try-2 a c:Text ; c:label "The script link renders without its address; the component's script is an empty sem-refused element inside its outlined div; the background is left out of the stylesheet. The link's shape flags the javascript: address too, but a shape only describes: the policy is what keeps it out." .

ui:doc-sa-may-h a c:Heading ; c:level 2 ; c:label "What an authored graph may do" .
ui:doc-sa-may a c:DescriptionList ; c:of ui:doc-sa-may-items ; c:fields ( ui:sa-elements ui:sa-attributes ui:sa-ids ui:sa-urls ui:sa-remote ui:sa-styles ui:sa-rules ui:sa-hosted ui:sa-islands ui:sa-inputs ) .
ui:doc-sa-may-items ui:sa-elements "Any element of the framework's components and of your own, built from the elements safe:Authored lists (safe:element): text, headings, lists, tables, forms and their controls, details, dialog, images, audio and video, the SVG extension's elements." ;
    ui:sa-attributes "Attributes from safe:attribute, and any data-… or aria-… one but the framework's own hooks." ;
    ui:sa-ids "References to its own elements by id: for, form, list, commandfor, popovertarget, headers, itemref, the ARIA relationships (aria-labelledby, aria-controls, …) and a link to #id must name ids that elements of the same rendering have (safe:idReferenceAttribute, safe:idReferenceListAttribute, safe:fragmentAttribute). The framework's components mint their ids from their IRIs, so their ARIA relationships hold." ;
    ui:sa-urls "Links and sources that are relative, a fragment, or http:, https:, mailto: or tel:; an image, audio or video source (src, srcset, poster) may also be data:image/… or blob:." ;
    ui:sa-remote "The one rule for remote resources: an http(s) address appears only in an attribute, a link followed when a person follows it or an image, audio or video source loaded as it renders, as in any page. The policy limits their schemes, a CSP their origins. CSS loads nothing from an address: a style rule reaches beyond the element it is written for, and loads on states (a hover) that render nothing to check." ;
    ui:sa-styles "sty:StyleRules, tokens, keyframes and style attributes whose values pass the CSS check; url() of a fragment (url(#gradient)) or of a data:image/… loads nothing from elsewhere and is allowed." ;
    ui:sa-rules "Classes, renderings, SPARQL rules, reactions and shapes: they only produce triples, and what they produce is checked." ;
    ui:sa-hosted "A component drawn by a host component library only by a host component (safe:hostComponent) or custom element (safe:customElement) the policy lists, none by default; any other renders as its projected element." ;
    ui:sa-islands "A foreign component (ext:Island) only by what the policy lists, none by default: its custom element (safe:customElement), widget (safe:widget), module (safe:module) and, beyond the built-in custom element and widget adapters, its adapter (safe:adapter). Any other is not mounted: its slot stays its projected element, empty, and it is reported, in the DOM, in the HTML a server writes and on take-over." ;
    ui:sa-inputs "Inputs to an island or a custom element (ext:input): an attribute input passes the attribute check; a property input names only a property in safe:property, none by default. A property that takes markup (innerHTML, outerHTML, srcdoc, dangerouslySetInnerHTML), an event handler, React's own props (ref, key, children) and prototype names are never set, listed or not." .

ui:doc-sa-not-h a c:Heading ; c:level 2 ; c:label "What it may not do" .
ui:doc-sa-not a c:DescriptionList ; c:of ui:doc-sa-not-items ; c:fields ( ui:sa-elements ui:sa-attributes ui:sa-ids ui:sa-hooks ui:sa-opener ui:sa-schemes ui:sa-styles ui:sa-tokens ui:sa-box ui:sa-uploads ui:sa-stores ui:sa-effects ) .
ui:doc-sa-not-items ui:sa-elements "No element that runs or embeds: script, iframe, object, embed, base, link, meta, style, noscript, template, slot, nor html, head, body or title." ;
    ui:sa-attributes "No attribute outside the list: no event handler (on…), srcdoc, is, nonce, ping, http-equiv, sandbox, allow, integrity, shadowrootmode, referrerpolicy (the page's own policy decides what an address is told)." ;
    ui:sa-ids "No reach into the host's page by id: authored content renders in the host's document, so an id reference to an id the rendering does not have (the host's login form, its theme picker) is left out." ;
    ui:sa-hooks "No framework hooks the host sets: data-sem-… is refused (safe:refusedAttributePrefix), but for the hooks the framework's components render, which safe:Authored lists; data-sem-sandbox, data-sem-ssr and the other hooks the host sets are not among them. data-sem-anchor and data-sem-origin name ids, and are held as id references." ;
    ui:sa-opener "A link's rel may not hold opener (safe:refusedLinkType), so a page it opens does not get the host's window." ;
    ui:sa-schemes "No javascript:, vbscript:, data: (but an image's) or file:, however it is spelled: case, spaces, tabs and newlines are read as a browser reads them." ;
    ui:sa-styles "No url() to an address, image-set(), image(), cross-fade(), element(), src(), paint() or expression(); no {, }, @, < or ; that would start another rule or at-rule (@import); no escape outside a string; quotes and brackets that balance; no behavior or -moz-binding. The same holds for every string the style compiler writes from the graph: properties, values, slugs, parts, states, media conditions, keyframe names and steps." ;
    ui:sa-tokens "CSS is read as the browser tokenizes it (css-syntax-3), in one pass, linear in its length: strings end where the browser ends them, an unquoted url( is one url token up to its ), a name after a number or a # calls no function. What the check could read otherwise than the browser is refused: a comment, a string a newline ends, and a bad url." ;
    ui:sa-box "A part, state or media condition may not name & or :scope: authored styles stay in the authored box (below)." ;
    ui:sa-uploads "file:uploadTo posts only to the page's own origin, or to an origin the host lists (files: { uploadOrigins }), whether or not the graph is authored: the graph says where, the host says where may be." ;
    ui:sa-stores "A remote source (src:Source) names no endpoint in the graph: the host maps each source's IRI to its URL and credentials, and one it does not map stays src:Unbound." ;
    ui:sa-effects "Under mount({ authored }) the effects read their configuration from the trusted graphs alone (app.trusted, a store of the ontology and graphs): remote sources, the location and whether there is one, where and by what a drop uploads, which module an island loads, and, when persistence is attached with { trusted: app.trusted }, its policies and storage keys. An authored graph changes state, the values the effects carry, as the interface does; it cannot reconfigure them." .
ui:doc-sa-not-2 a c:Text ; c:label "Authored rules read the whole store: your graphs as well as the author's. What an author must not see (a token, someone else's data) does not belong in the store they render from." .
ui:sa-elements rdfs:label "Elements" . ui:sa-attributes rdfs:label "Attributes" . ui:sa-urls rdfs:label "URLs" . ui:sa-schemes rdfs:label "URL schemes" .
ui:sa-styles rdfs:label "Styles" . ui:sa-rules rdfs:label "Rules" . ui:sa-hosted rdfs:label "Host components" .
ui:sa-uploads rdfs:label "Uploads" . ui:sa-stores rdfs:label "Remote stores" . ui:sa-ids rdfs:label "Id references" .
ui:sa-remote rdfs:label "Remote resources" . ui:sa-inputs rdfs:label "Island inputs" . ui:sa-hooks rdfs:label "Framework hooks" .
ui:sa-opener rdfs:label "Opener" . ui:sa-tokens rdfs:label "CSS tokens" . ui:sa-box rdfs:label "Scope" . ui:sa-effects rdfs:label "Host effects" .

ui:doc-sa-box-h a c:Heading ; c:level 2 ; c:label "The authored box" .
ui:doc-sa-box-1 a c:Text ; c:label "Authored content renders in an element of its own, the authored box, marked data-sem-sandbox: a live example's sandbox, the element mount({ authored }) renders into, the mount element of a page renderToString({ policy }) rendered. One scoping applies in all three (scopedCss, src/style/scope.ts):" .
ui:doc-sa-box a c:DescriptionList ; c:of ui:doc-sa-box-items ; c:fields ( ui:sa-b-rules ui:sa-b-keyframes ui:sa-b-contain ) .
ui:doc-sa-box-items ui:sa-b-rules "The trusted stylesheet (the ontology and your own graphs) is the page's. Every style rule the authored graphs add, or change, is rewritten so that each of its selectors starts at the box ([data-sem-sandbox=\"…\"] p); :root is the box itself, and a selector that starts at a sibling (~ p, + p) is left out. A rule with no sty:appliesTo, or an authored class given a framework slug, styles only what is in the box." ;
    ui:sa-b-keyframes "Keyframes the authored graphs add are renamed for the box, as are the animations of its rules that name them: a framework animation keeps its own keyframes outside." ;
    ui:sa-b-contain "The box has contain: layout paint (a rule of ontology/layers/safety.ttl): fixed and absolute positions resolve to it rather than to the page, and what is drawn outside it is clipped, beyond a margin of --sem-space-3 so a focus ring at its edge shows. The top layer (a modal dialog, a popover) is not contained by it." .
ui:sa-b-rules rdfs:label "Style rules" . ui:sa-b-keyframes rdfs:label "Keyframes" . ui:sa-b-contain rdfs:label "Containment" .
ui:doc-sa-box-2 a c:Text ; c:label "renderToString({ policy, trusted }) takes the store the policy was read from, whose stylesheet is the page's; without it the whole stylesheet is scoped to the box. Rendered.box names the box, and renderDocument marks the mount element with it, so mount takes it over in the same box." .
ui:doc-sa-shadow a c:Text ; c:label "Or let the browser keep the boundary: with isolate: 'shadow', mount renders into a box in a shadow root of the element. The author's ids, form, popovertarget and commandfor references, named elements and style rules stop at it; the whole stylesheet is the shadow root's, scoped to the box, and the page's own is not touched." .
ui:doc-sa-shadow-code a c:Code ; c:block true ; c:language "ts" ; c:label "await mount(element, { root, graphs: [app], authored: [theirs], isolate: 'shadow', onRefused })" .
ui:doc-sa-shadow-2 a c:Text ; c:label "Events, focus and keys work as in the light DOM: the event bus reads an event's own target inside the shadow root, and the element that has the focus there. Semblance's own reads of the document (adopted style sheets, getElementById, the events kept before take-over) go past elements an author names adoptedStyleSheets or __semblanceKept, in a shadow root or not." .

ui:doc-sa-how-h a c:Heading ; c:level 2 ; c:label "How it works" .
ui:doc-sa-how-1 a c:Text ; c:label "safe:Authored is triples: the element classes, attribute names and prefixes, which attributes hold URLs and which of those load a resource, the URL schemes, which attributes hold CSS, the CSS functions that fetch and the properties that bind code, and the host components and custom elements an author may name." .
ui:doc-sa-how-code a c:Code ; c:block true ; c:language "turtle" ; c:label """safe:Authored a safe:Policy ;
    safe:element rdfhtml:A , rdfhtml:Button , rdfhtml:Div , … , svg:Svg , svg:Path , … ;
    safe:attributePrefix "data-" , "aria-" ;
    safe:attribute "alt" , "class" , "href" , "src" , "style" , … ;
    safe:urlAttribute "href" , "src" , "action" , "formaction" , "poster" , "cite" , "itemid" , "itemtype" ;
    safe:urlListAttribute "srcset" ;
    safe:resourceAttribute "src" , "srcset" , "poster" ;
    safe:scheme "http:" , "https:" , "mailto:" , "tel:" ;
    safe:resourceScheme "data:image/" , "blob:" ;
    safe:styleAttribute "style" ;
    safe:cssValueAttribute "fill" , "stroke" ;
    safe:fetchingFunction "url" , "image-set" , "image" , "cross-fade" , "element" , "src" , "expression" , "paint" , … ;
    safe:refusedProperty "behavior" , "-moz-binding" .""" .
ui:doc-sa-how-2 a c:Text ; c:label "readPolicy(store, iri) reads those triples from a trusted store into a SafetyPolicy of plain sets (it throws when the IRI is not a safe:Policy there); authoredPolicy(store) does the same for safe:Authored, once per store. From then on the policy is data in the host, and nothing an author adds to a store changes it. Where it is applied:" .
ui:doc-sa-how-list a c:DescriptionList ; c:of ui:doc-sa-how-items ; c:fields ( ui:sa-index ui:sa-outputs ui:sa-compiler ui:sa-files ui:sa-hosts ui:sa-islands ui:sa-restore ) .
ui:doc-sa-how-items ui:sa-index "Every projection writes its RDF/HTML into an HtmlIndex, and runtime.project({ policy }) gives it the policy. Under it, tagName answers sem-refused for an element class the policy does not list and a custom element only if listed; attributes checks each attribute by name (a rel by its link types), then its URL, srcset or CSS, and keeps an id reference only while the projection mints that id; childrenOf is empty under a refused element; hostComponent answers a host component only if listed. The index checks a delta as it arrives, so a refusal in a hidden part of the page is reported too. A relative URL is checked as written, then resolved against the site's base." ;
    ui:sa-outputs "Everything reads the index, never the triples: the DOM patcher (creating, patching, and taking over server-rendered HTML), toHTML, toIndentedHTML and toText, renderToString and renderToStream, the live examples' prerendered HTML, and a host component adapter. A SPARQL rule and its function twin produce the same triples, checked after, so parity is unchanged." ;
    ui:sa-compiler "compileStyles(store, { policy, onRefused }) checks every string it takes from the graph: a property, a value, a selector part, a state, a media condition, a slug, a keyframe name and step. A declaration that fails is left out of its rule; a rule whose selector or condition fails is left out whole. The CSS scan reads the text as the css-syntax-3 tokenizer does, in one pass, far enough to know it stays a value. Where authored content has a box, the host then scopes what the authored graphs added to the stylesheet to it." ;
    ui:sa-files "The files effect checks uploads for every graph: an http(s) address on the page's own origin or one in uploadOrigins (\"*\" allows any). A refused upload is not sent; the file becomes file:Failed with the reason, announced." ;
    ui:sa-hosts "Host components and custom elements are asked of the index, so an authored projection draws one only if the policy lists it and the host adapter has it; the attributes it is given are the index's, already checked." ;
    ui:sa-islands "The islands effect checks each island against the policy (islandProblem, src/foreign.ts), and the index each input (inputProblem); the server and take-over ask the same. Even a listed island mounts only what the host registered by name: the graph names one, it cannot bring one." ;
    ui:sa-restore "Restoring brings back only what a persistence policy covers: its subject's listed properties, or what its query's template can produce, into its graph; a stored switch only for a policy there is. Whatever else storage holds stays there." .
ui:sa-index rdfs:label "The HTML index" . ui:sa-outputs rdfs:label "Every output" . ui:sa-compiler rdfs:label "The style compiler" .
ui:sa-files rdfs:label "Uploads" . ui:sa-hosts rdfs:label "Host components" . ui:sa-islands rdfs:label "Islands" . ui:sa-restore rdfs:label "Remembered state" .
ui:doc-sa-budget-h a c:Heading ; c:level 2 ; c:label "Work budgets" .
ui:doc-sa-budget-1 a c:Text ; c:label "An authored graph brings its own rules, and a rule can ask for more than any page can do: one that mints two nodes for every node it renders never ends. The policy bounds it, and a runtime that projects authored content takes its budgets:" .
ui:doc-sa-budget a c:DescriptionList ; c:of ui:doc-sa-budget-items ; c:fields ( ui:sa-w-time ui:sa-w-evals ui:sa-w-output ui:sa-w-length ) .
ui:doc-sa-budget-items ui:sa-w-time "PT1.5S by default: how long a turn may run (the watchdog's budget)." ;
    ui:sa-w-evals "200 000 by default: rule evaluations in a turn. Deterministic, so a server renders the same at any load." ;
    ui:sa-w-output "1 000 000 by default: the derived triples a projection holds." ;
    ui:sa-w-length "262 144 by default: the longest string the policy checks (an attribute value, an input, a piece of CSS); a longer one is refused unread." .
ui:sa-w-time rdfs:label "safe:budget" . ui:sa-w-evals rdfs:label "safe:maxEvaluations" . ui:sa-w-output rdfs:label "safe:maxDerived" . ui:sa-w-length rdfs:label "safe:maxLength" .
ui:doc-sa-budget-2 a c:Text ; c:label "A turn over any of them is suspended at a consistent point, then stopped: the page shows what was complete, the rest keeps its last rendering and is counted out of date, and onRefused gets a Refused of kind budget. On the server the HTML is what was complete and Rendered.exceeded says why; a live example shows the reason inline. This site's examples stay under 100 evaluations and 3 000 derived triples a turn." .
ui:doc-sa-how-3 a c:Text ; c:label "One check holds for trusted projections as well: an attribute node whose name is no attribute name (a space, a quote, <, >, /, =) is left out and reported, since it would break the markup it is written in. An authored projection costs one set lookup per attribute more, a scheme test for a URL and a scan for CSS." .

ui:doc-sa-ref-h a c:Heading ; c:level 2 ; c:label "What happens to what is refused" .
ui:doc-sa-ref a c:DescriptionList ; c:of ui:doc-sa-ref-items ; c:fields ( ui:sa-r-element ui:sa-r-hosted ui:sa-r-island ui:sa-r-idref ui:sa-r-attribute ui:sa-r-url ui:sa-r-style ui:sa-r-rule ui:sa-r-upload ui:sa-r-budget ) .
ui:doc-sa-ref-items ui:sa-r-element "An empty <sem-refused data-sem-refused=\"script\">, without its attributes or children, in the DOM and in HTML; nothing in text. Reported as kind element." ;
    ui:sa-r-hosted "The projected element, drawn by Semblance. Reported as kind element." ;
    ui:sa-r-island "The island's slot, its projected element, empty; an input that fails is not set. Reported as kind element, or attribute for an input." ;
    ui:sa-r-idref "An id reference to an id the projection does not mint is left out. Reported as kind attribute." ;
    ui:sa-r-attribute "Left out; the element stays. Reported as kind attribute." ;
    ui:sa-r-url "Its attribute is left out; the element stays. Reported as kind url." ;
    ui:sa-r-style "A style attribute that fails is left out; a declaration in a style rule that fails is left out of the sheet. Reported as kind style." ;
    ui:sa-r-rule "A style rule whose selector or condition fails is left out whole. Reported as kind style." ;
    ui:sa-r-upload "Not sent; the file is file:Failed with the reason." ;
    ui:sa-r-budget "What was complete is shown; the rest keeps its last rendering, counted out of date. Reported as kind budget, once per turn." .
ui:sa-r-element rdfs:label "An element" . ui:sa-r-hosted rdfs:label "A host component" . ui:sa-r-attribute rdfs:label "An attribute" .
ui:sa-r-url rdfs:label "A URL" . ui:sa-r-style rdfs:label "A CSS value" . ui:sa-r-rule rdfs:label "A style rule" . ui:sa-r-upload rdfs:label "An upload" . ui:sa-r-budget rdfs:label "A turn over budget" .
ui:sa-r-island rdfs:label "An island" . ui:sa-r-idref rdfs:label "An id reference" .
ui:doc-sa-rep-1 a c:Text ; c:label "Each is a Refused error (src/safety.ts) with at (the node's IRI, or the style rule's), kind and a message such as \"Refused on <…#it/~x>: authored content may not have a script element.\" It is reported once per node and reason. Where it goes:" .
ui:doc-sa-rep a c:DescriptionList ; c:of ui:doc-sa-rep-items ; c:fields ( ui:sa-p-mount ui:sa-p-project ui:sa-p-compile ui:sa-p-string ui:sa-p-stream ui:sa-p-live ui:sa-p-index ) .
ui:doc-sa-rep-items ui:sa-p-mount "onRefused, from both the projection and the stylesheet; by default console.warn." ;
    ui:sa-p-project "onError, like the projection's other errors; without one, console.error." ;
    ui:sa-p-compile "Its onRefused; by default console.warn." ;
    ui:sa-p-string "console.error (the projection) and console.warn (the stylesheet); rendered.projection.index.refusals has the projection's afterwards. Passing onRefused there is #404." ;
    ui:sa-p-stream "console.error. It compiles no stylesheet: compile the one it links with compileStyles(store, { policy, onRefused })." ;
    ui:sa-p-live "Warnings under its editor, the same on the server and in the browser." ;
    ui:sa-p-index "HtmlIndex.refusals: every reason by node, kept while the node exists." .
ui:sa-p-mount rdfs:label "mount" . ui:sa-p-project rdfs:label "runtime.project" . ui:sa-p-compile rdfs:label "compileStyles" .
ui:sa-p-string rdfs:label "renderToString" . ui:sa-p-stream rdfs:label "renderToStream" . ui:sa-p-live rdfs:label "A live example" . ui:sa-p-index rdfs:label "The index" .

ui:doc-sa-ext-h a c:Heading ; c:level 2 ; c:label "Extending or narrowing the policy" .
ui:doc-sa-ext-1 a c:Text ; c:label "The policy is triples, so extending it is Turtle in a trusted graph (mount's graphs, or the store you pass to authoredPolicy):" .
ui:doc-sa-ext-code a c:Code ; c:block true ; c:language "turtle" ; c:label """safe:Authored
    safe:scheme "sms:" ;                 # links to sms: addresses
    safe:hostComponent "Chart" ;         # your library's Chart may draw an authored chart
    safe:customElement "ds-badge" ;      # and ds-badge may be created for an authored badge
    safe:property "value" .              # an island's or custom element's value property may be set""" .
ui:doc-sa-ext-2 a c:Text ; c:label "An element is an RDF/HTML class or one of the SVG extension's: those are what the index can create, so your own element is a custom element (ext:tag, listed in safe:customElement) or a host component. A component you write needs nothing from the policy while it renders listed elements and attributes; prefix your own attributes with data- (not data-sem-) and they are allowed already. A stricter policy is a SafetyPolicy of your own; the quickest is the framework's with some sets replaced:" .
ui:doc-sa-ext-ts a c:Code ; c:block true ; c:language "typescript" ; c:label """const strict: SafetyPolicy = { ...authoredPolicy(trusted), schemes: new Set(['https:']), resourceSchemes: [] }
await mount(element, { root, graphs: [appTtl], authored: [fromTheModel], policy: strict })""" .
ui:doc-sa-ext-3 a c:Text ; c:label "Or a safe:Policy of its own in your Turtle, read with readPolicy(trusted, ex + 'Plain'). It lists everything it allows; nothing is inherited from safe:Authored." .
ui:doc-sa-ext-own a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:Plain a safe:Policy ;
    safe:element rdfhtml:Div , rdfhtml:Span , rdfhtml:P ;
    safe:attribute "class" , "lang" , "dir" ;
    safe:attributePrefix "data-" , "aria-" .""" .
ui:doc-sa-ext-4 a c:Text ; c:label "Why it must come from a trusted store: the policy is the only thing between the author and the page, and it is triples. Read from a store that holds the authored graph, the author could write safe:Authored safe:element rdfhtml:Script and allow itself anything. So it is read from a store without the authored graph (mount's store of graphs alone), or from the ontology alone (the live examples), and handed to the projection as data. When the framework starts to emit an element or attribute the policy does not list, it is added to safe:Authored: a test renders every live example of this site under the policy and fails on any refusal." .

ui:doc-sa-csp-h a c:Heading ; c:level 2 ; c:label "A Content Security Policy" .
ui:doc-sa-csp-1 a c:Text ; c:label "The policy limits the schemes of what is rendered, a CSP their origins and what may run at all: with it, markup that slipped past the check still could not run a script, load from an origin you did not list, or post a form elsewhere. renderDocument puts the recommended one first in the document's head, with the hash of every inline script and style element the finished document has (a site's csp does it for every page):" .
ui:doc-sa-csp-ts a c:Code ; c:block true ; c:language "ts" ; c:label "renderDocument(template, rendered, { csp: { img: ['https://images.example'], connect: ['https://api.example'] } })" .
ui:doc-sa-csp-code a c:Code ; c:block true ; c:language "http" ; c:label """default-src 'self';
script-src 'self' 'sha256-…' 'wasm-unsafe-eval';
style-src 'self';
style-src-attr 'unsafe-inline';
img-src 'self' https://images.example data: blob:;
media-src 'self' data: blob:;
connect-src 'self' https://api.example;
worker-src 'self';
object-src 'none';
base-uri 'none';
form-action 'self';
require-trusted-types-for 'script';
trusted-types semblance""" .
ui:doc-sa-csp-list a c:DescriptionList ; c:of ui:doc-sa-csp-items ; c:fields ( ui:sa-c-script ui:sa-c-wasm ui:sa-c-style ui:sa-c-attr ui:sa-c-img ui:sa-c-connect ui:sa-c-form ) .
ui:doc-sa-csp-items ui:sa-c-script "The page's own scripts, and its inline ones by hash: no 'unsafe-inline', no 'unsafe-eval'. The hashes are SHA-256 computed in plain TypeScript, so the same code runs in Node, Deno and workers." ;
    ui:sa-c-wasm "The stores are WebAssembly modules (Semblance's engines, Oxigraph) compiled in the page; without it nothing loads. It allows WebAssembly, not eval." ;
    ui:sa-c-style "The compiled stylesheet, and each live example's, are constructed stylesheets (adoptedStyleSheets), which style-src 'self' allows; a stylesheet inline in the document, and the styles a server writes into a prerendered live example, by hash." ;
    ui:sa-c-attr "The DOM patcher writes style attributes with setAttribute, which a CSP counts as inline style; under the policy each has passed the CSS check first. Writing them through the CSSOM, so this line can go, is #157." ;
    ui:sa-c-img "data: and blob: are the resource schemes the policy allows; blob: is also what picked and dropped files are previewed from. List the origins your images come from, rather than https:, if authored graphs should not load from anywhere." ;
    ui:sa-c-connect "The engines' .wasm files; add the endpoints of the remote sources the host binds and the uploadOrigins it allows." ;
    ui:sa-c-form "An authored form may name an https: action, a button a formaction; the CSP keeps them on your origin." .
ui:sa-c-script rdfs:label "script-src" . ui:sa-c-wasm rdfs:label "'wasm-unsafe-eval'" . ui:sa-c-style rdfs:label "style-src 'self'" . ui:sa-c-attr rdfs:label "style-src-attr" .
ui:sa-c-img rdfs:label "img-src, media-src" . ui:sa-c-connect rdfs:label "connect-src" . ui:sa-c-form rdfs:label "form-action" .
ui:doc-sa-csp-2 a c:Text ; c:label "contentSecurityPolicy(opts) gives the same as a header value, with frame-ancestors 'self', which a meta cannot carry. A streamed document sends its head before the root's HTML exists, so the styles of a live example prerendered into it are not among the hashes: allow them with directives, or render with renderToString." .
ui:doc-sa-tt-1 a c:Text ; c:label "Trusted Types: require-trusted-types-for 'script' makes every script sink (innerHTML, srcdoc, a script's src, new Worker) take only values a named policy made. Semblance writes no HTML and no script from a string - the renderer creates elements and sets attributes and text - so it runs under Trusted Types as it is, and an authored input that reached innerHTML would throw rather than parse. Its one policy, semblance, makes script URLs of the page's own origin, for what the host loads itself:" .
ui:doc-sa-tt-code a c:Code ; c:block true ; c:language "ts" ; c:label """import { scriptURL } from '@inferal-oss/semblance/web'
import thumbnails from './thumbnails.worker.ts?worker&url'
new Worker(scriptURL(thumbnails), { type: 'module' })""" .
ui:doc-sa-tt-2 a c:Text ; c:label "This site runs under the recommended policy. Its fonts and its foreign-component examples' CDN are listed; demo/trusted-types.ts adds a policy for the page's own HTML (the Performance view's benchmark cells run in it) and a default policy for Leaflet, flatpickr, Temml and Shoelace's icons, which write HTML themselves: what they write is parsed inertly and stripped of what runs code or loads a document." .
ui:doc-sa-csp-3 a c:Text ; c:label "With the live editors, a visitor writes the graph, so the CSP is what limits where it can reach: keep img-src, media-src and form-action to the origins you mean. A link's destination is outside any CSP: an authored https: link goes where it says when followed." .

ui:doc-sa-depth-h a c:Heading ; c:level 2 ; c:label "Defence in depth" .
ui:doc-sa-depth a c:DescriptionList ; c:of ui:doc-sa-depth-items ; c:fields ( ui:sa-d-sandbox ui:sa-d-remote ui:sa-d-model ui:sa-d-shapes ui:sa-d-cost ) .
ui:doc-sa-depth-items ui:sa-d-sandbox "Each live example runs in a sandbox of its own (src/sandbox.ts): its own store, with the ontology and its sources and never the site's graph, its own runtime and projections under the policy, its own event bus, and a turn budget (budgetMs, 1500 ms by default) past which it stops itself and reports. A source that does not parse, a rule that throws or a reaction that fails stays inside. Besides its event bus it attaches only its full screen and, for an example with a simulated store (c:storeSource), the remote-sources effect bound to that store in-process, with no network: no navigation, persistence, network capture or files effect, and no islands. It is not a separate browsing context: it shares the page's document and origin, which the policy and the CSP protect. buildSandbox, or a second mount of only the authored graph, does the same for your own app." ;
    ui:sa-d-remote "A remote source names no endpoint and no credentials in the graph. What a remote store sends is data in the page's store like any other, rendered under the projection's policy if it has one; whether a server accepts a write is the server's decision (src:WriteRefused)." ;
    ui:sa-d-model "Treat a model's or a form's output as authored: pass it as authored, or render it in a sandbox. Turtle that does not parse fails to load." ;
    ui:sa-d-shapes "A shape marks a component invalid and says why; it does not stop a trusted projection from rendering what it flags. The policy does." ;
    ui:sa-d-cost "An authored graph's work is bounded by the policy's budgets (time, rule evaluations, output, string length), in mount, on the server and in a live example: see Work budgets above." .
ui:doc-sa-depth-remote a c:Text ; c:children ( "How a source is declared and bound, and what a store may send and refuse: " ui:doc-sa-to-remote "." ) .
ui:doc-sa-to-remote a c:Link , c:Setter ; c:label "Remote data" ; c:href "/docs/remote/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRemote .
ui:sa-d-sandbox rdfs:label "Sandboxes" . ui:sa-d-remote rdfs:label "Remote sources" . ui:sa-d-model rdfs:label "From a model or a form" .
ui:sa-d-shapes rdfs:label "Shapes describe" . ui:sa-d-cost rdfs:label "Cost" .

ui:doc-sa-not-cov-h a c:Heading ; c:level 2 ; c:label "Not covered" .
ui:doc-sa-not-cov a c:DescriptionList ; c:of ui:doc-sa-not-cov-items ; c:fields ( ui:sa-n-origins ui:sa-n-dup ui:sa-n-store ui:sa-n-clobber ui:sa-n-island ui:sa-n-effects ) .
ui:doc-sa-not-cov-items ui:sa-n-origins "Where an http(s) link goes or an image comes from: use a CSP." ;
    ui:sa-n-dup "An id the rendering has that the host's page has too: the browser takes the first in the document (in a shadow root, each has its own)." ;
    ui:sa-n-island "What a foreign component the policy lists does with its inputs once mounted: it is the host's code. A live example's sandbox attaches no islands effect." ;
    ui:sa-n-store "What the author's triples say about your resources, and what its reactions change, when it shares your store: give it a store of its own to keep it out." ;
    ui:sa-n-clobber "DOM clobbering by id or name of the host's own scripts (one that reads window.someId): render authored content in a shadow root, where its names do not reach the document. Semblance's own reads go past named elements." ;
    ui:sa-n-effects "Host effects you attach yourself (navigation, persistence, network capture) act on graph state as the host configured them; give them trusted when the store holds authored graphs." .
ui:sa-n-origins rdfs:label "Origins" . ui:sa-n-store rdfs:label "A shared store" . ui:sa-n-clobber rdfs:label "Clobbering" .
ui:sa-n-effects rdfs:label "Host effects" . ui:sa-n-dup rdfs:label "Duplicate ids" . ui:sa-n-island rdfs:label "Listed islands" .

ui:doc-sa-ex-h a c:Heading ; c:level 2 ; c:label "Worked examples" .
ui:doc-sa-ex-1 a c:Text ; c:label "Each is backed by a test: test/safety.test.ts renders every vector in a live example's sandbox, in the DOM and as a server writes it; test/safety-guide.test.ts runs the examples that go through mount and renderToString." .
ui:doc-sa-ex a c:DescriptionList ; c:of ui:doc-sa-ex-items ; c:fields ( ui:sa-x-script ui:sa-x-embed ui:sa-x-onclick ui:sa-x-js ui:sa-x-srcdoc ui:sa-x-svg ui:sa-x-css ui:sa-x-smuggle ui:sa-x-hosted ui:sa-x-mount ui:sa-x-extend ui:sa-x-strict ui:sa-x-server ui:sa-x-allowed ) .
ui:doc-sa-ex-items ui:sa-x-script "<sem-refused data-sem-refused=\"script\"></sem-refused>, and nothing of it in text." ;
    ui:sa-x-embed "iframe, object, embed, base, link, meta, style, noscript, template: sem-refused, without its src or href." ;
    ui:sa-x-onclick "onclick on a button, as an attribute node: <button title=\"kept\"></button>." ;
    ui:sa-x-js "href of javascript:alert(1), also as \" JaVaScRiPt:\", \"java\\tscript:\", vbscript: or data:text/html: <a>link</a>." ;
    ui:sa-x-srcdoc "srcdoc, and an image src of data:text/html: <img alt=\"a\">." ;
    ui:sa-x-svg "An SVG path with onload and fill: url(https://…): <svg><path></path></svg>." ;
    ui:sa-x-css "url(), image-set(), \"} @import …\", an escaped url, a selector part with }, -moz-binding, a token of url(…): each left out of the sheet, while a plain colour and a data:image/svg+xml background stay." ;
    ui:sa-x-smuggle "An image inside a refused noscript: nothing of it renders." ;
    ui:sa-x-hosted "A host component and a custom element the policy does not list: the projected div, not drawn by the host." ;
    ui:sa-x-mount "mount({ graphs: [app], authored: [theirs], onRefused }) with a javascript: link in each: both links without href, two Refused of kind url; mounted trusted, both as written." ;
    ui:sa-x-extend "safe:Authored safe:scheme \"sms:\" in graphs lets an authored sms: link keep its href; the same triple in the authored graph does not, and neither does safe:element rdfhtml:Script." ;
    ui:sa-x-strict "A policy with schemes https: only keeps an https: link and refuses a mailto: one; ex:Plain read with readPolicy has three elements and no schemes." ;
    ui:sa-x-server "renderToString({ store, root, policy }): the browser's HTML, with the refusals in rendered.projection.index.refusals." ;
    ui:sa-x-allowed "https:, mailto:, tel:, relative and fragment links, a data:image/png image, data-ex-thing and style=\"color: red\": all of it, nothing refused." .
ui:sa-x-script rdfs:label "A script" . ui:sa-x-embed rdfs:label "Embedding" . ui:sa-x-onclick rdfs:label "An event handler" .
ui:sa-x-js rdfs:label "A javascript: link" . ui:sa-x-srcdoc rdfs:label "srcdoc, data:" . ui:sa-x-svg rdfs:label "SVG" .
ui:sa-x-css rdfs:label "CSS" . ui:sa-x-smuggle rdfs:label "Smuggling" . ui:sa-x-hosted rdfs:label "Host components" .
ui:sa-x-mount rdfs:label "mount" . ui:sa-x-extend rdfs:label "Extending" . ui:sa-x-strict rdfs:label "Narrowing" .
ui:sa-x-server rdfs:label "The server" . ui:sa-x-allowed rdfs:label "Still allowed" .
ui:doc-sa-more a c:Text ; c:label "docs/SAFETY.md in the repository says the same, with the file and function behind each step." .

# --- Rules and the engine ---
ui:doc-rules a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-ru-h ui:doc-ru-0 ui:doc-ru-walk ui:doc-ru-arrows ui:doc-ru-canvas ui:doc-ru-1 ui:doc-ru-2 ui:doc-ru-3 ui:doc-ru-4 ui:doc-ru-5 ) .
ui:doc-ru-h a c:Heading ; c:level 1 ; c:label "Rules and the engine" .
ui:doc-ru-0 a c:Text ; c:label "One component, a text field, from its triples to the page and back, through the framework's own graph: the diagram beside the steps is drawn from the terms they mention and the links among them." .
ui:doc-ru-walk a c:Walkthrough ; c:label "A field, from data to the page and back" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in colour points at its node. Activate one to open its page in the Reference." ;
    c:steps ( ui:doc-ru-w1 ui:doc-ru-w2 ui:doc-ru-w3 ui:doc-ru-w4 ui:doc-ru-w5 ) .
ui:doc-ru-w1 a c:WalkthroughStep ; rdfs:label "Data" ;
    c:children ( "A text field is an instance of " ui:doc-ru-m-TextField ", a class under " ui:doc-ru-m-Component ". Its label, value and help are its own triples, so changing one of them marks the field dirty and nothing else." ) .
ui:doc-ru-w2 a c:WalkthroughStep ; rdfs:label "A rendering and its rules" ;
    c:children ( ui:doc-ru-m-OnScreen " is a " ui:doc-ru-m-Rendering " that targets the class on screen. " ui:doc-ru-m-sparql " implements it with a CONSTRUCT that builds RDF/HTML for each field, minting every node from it; " ui:doc-ru-m-fn " is its function twin, which renders the same HTML (the tests compare the two after every step). A projection picks one, SPARQL by default." ) .
ui:doc-ru-w3 a c:WalkthroughStep ; rdfs:label "Layers around it" ;
    c:children ( ui:doc-ru-m-Check " runs before the components (stratum -10): it checks the field's value against the shape the field points at and derives c:error, which the field's own rule renders. Later strata decorate what the rules made - ARIA relationships, style hooks - without the field knowing." ) .
ui:doc-ru-w4 a c:WalkthroughStep ; rdfs:label "Typing is an event" ;
    c:children ( "A keystroke becomes a " ui:doc-ru-m-Input " event addressed to the field. " ui:doc-ru-m-TypeText ", the reaction of every text entry (c:TextEntry), deletes its old c:value and inserts the typed one: one change, after which only the field's pairs of rule and focus are dirty, and only their DOM is patched." ) .
ui:doc-ru-w5 a c:WalkthroughStep ; rdfs:label "Recorded" ;
    c:children ( "The event, with the size of its change, is a member of " ui:doc-ru-m-ChangeLog ", an LDES stream bounded by its retention policy - which the Change log and Activity tools read." ) .
ui:doc-ru-m-TextField a c:Mention ; c:label "c:TextField" ; c:mentions c:TextField ; c:to c:TextField .
ui:doc-ru-m-Component a c:Mention ; c:label "sem:Component" ; c:mentions sem:Component ; c:to sem:Component .
ui:doc-ru-m-OnScreen a c:Mention ; c:label "c:TextFieldOnScreen" ; c:mentions c:TextFieldOnScreen ; c:to c:TextFieldOnScreen .
ui:doc-ru-m-Rendering a c:Mention ; c:label "sem:Rendering" ; c:mentions sem:Rendering ; c:to sem:Rendering .
ui:doc-ru-m-sparql a c:Mention ; c:label "c:TextFieldOnScreen-sparql" ; c:mentions c:TextFieldOnScreen-sparql ; c:to c:TextFieldOnScreen-sparql .
ui:doc-ru-m-fn a c:Mention ; c:label "c:TextFieldOnScreen-fn" ; c:mentions c:TextFieldOnScreen-fn ; c:to c:TextFieldOnScreen-fn .
ui:doc-ru-m-Check a c:Mention ; c:label "val:Check" ; c:mentions val:Check ; c:to val:Check .
ui:doc-ru-m-Input a c:Mention ; c:label "beh:Input" ; c:mentions beh:Input ; c:to beh:Input .
ui:doc-ru-m-TypeText a c:Mention ; c:label "c:TypeText" ; c:mentions c:TypeText ; c:to c:TypeText .
ui:doc-ru-m-ChangeLog a c:Mention ; c:label "beh:ChangeLog" ; c:mentions beh:ChangeLog ; c:to beh:ChangeLog .
ui:doc-ru-arrows a c:Text ; c:label "The arrows from the phrases to the diagram are connectors (c:Connector): a rule derives one from each mention being read to its node, and the host draws it where both are, hiding it while its phrase is out of view. Any two components can be joined the same way; a sheet's dependency arrows are too. Here the walk of a field is three cards and two connectors: drag a card, or resize the canvas from its corner, and the arrows stay attached." .
ui:doc-ru-canvas a c:Canvas , c:Resizable ; c:label "A field, its rule and what it builds" ; c:height 220 ;
    c:children ( ui:doc-ru-c-field ui:doc-ru-c-rule ui:doc-ru-c-html ui:doc-ru-c-focus ui:doc-ru-c-builds ) .
ui:doc-ru-c-field a c:Card ; c:label "ex:name" ; c:note "a c:TextField" .
ui:doc-ru-c-rule a c:Card ; c:label "c:TextFieldOnScreen-sparql" ; c:note "a CONSTRUCT" .
ui:doc-ru-c-html a c:Card ; c:label "RDF/HTML" ; c:note "<label> <input>" .
ui:doc-ru-c-focus a c:Connector ; c:from ui:doc-ru-c-field ; c:to ui:doc-ru-c-rule ; c:label "is the focus of" ; sty:tone sty:Accent .
ui:doc-ru-c-builds a c:Connector ; c:from ui:doc-ru-c-rule ; c:to ui:doc-ru-c-html ; c:label "builds" ; sty:tone sty:Success ; c:line c:DashedLine .
ui:doc-ru-1 a c:Text ; c:label "Identity. Rules mint IRIs as <focus>/~<local>, never blank nodes, so a node keeps its identity across re-evaluation, its DOM element is reused, and its IRI doubles as an id that labels and descriptions point at." .
ui:doc-ru-2 a c:Text ; c:label "Incrementality. Each (rule, focus) pair owns its output. A change marks pairs dirty through the focus's own triples, sem:follows links and the triples a function read; outputs are diffed and reference-counted. Member-wise rules (sem:forEach) evaluate once per member, so adding a list item touches only that item." .
ui:doc-ru-3 a c:Text ; c:label "Demand. Only what is shown under a projection's roots is evaluated; hidden pages and tabs are parked. sem:warm says what to prepare ahead: sem:Eager in idle time, sem:OnIntent when a choice that would show it is pointed at." .
ui:doc-ru-4 a c:Text ; c:label "Bulk. A SPARQL rule pending for several foci runs once with VALUES when every triple it constructs is attributable to $this. sem:requires skips foci without a property; strata order layers after the components they decorate." .
ui:doc-ru-5 a c:Text ; c:label "Implementations. SPARQL rules are the implementation; function twins render the same HTML, faster, and the tests check that they do after every step. The Engine tool switches between them live, and the Query tool lists renderings missing either side." .

# --- Layers ---
ui:doc-layers a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-la-h ui:doc-la-1 ui:doc-la-list ui:doc-la-3 ui:la-live ui:doc-la-2 ) .
ui:doc-la-h a c:Heading ; c:level 1 ; c:label "Layers" .
ui:doc-la-1 a c:Text ; c:label "A layer is a set of rules enabled per projection (sem:enables). Layers decorate what components render without the components knowing:" .
ui:doc-la-list a c:DescriptionList ; c:of ui:doc-la-items ; c:fields ( ui:la-a11y ui:la-style ui:la-l10n ui:la-val ui:la-key ui:la-prv ui:la-per ui:la-docs ) .
ui:doc-la-items ui:la-a11y "ARIA relationships by IRI, roles and live regions." ;
    ui:la-style "Hookable properties become data-sem-* attributes the compiled theme styles." ;
    ui:la-l10n "Language-tagged labels; the viewer's language is a projection setting; RTL flips the page." ;
    ui:la-val "Fields point at SHACL property shapes; errors are derived; buttons wait for valid input." ;
    ui:la-key "Shortcuts on any component, commands that belong to none, arrow-key navigation patterns." ;
    ui:la-prv "prv:concealed masks or blurs any component; prv:sensitive ones hide in private mode (⌘⇧H)." ;
    ui:la-per "Policies say what state to remember, where and for how long." ;
    ui:la-docs "Under each gallery specimen, the ontology of the classes it uses." .
ui:la-a11y rdfs:label "Accessibility" . ui:la-style rdfs:label "Style" . ui:la-l10n rdfs:label "Localization" .
ui:la-val rdfs:label "Validation" . ui:la-key rdfs:label "Keyboard" . ui:la-prv rdfs:label "Privacy" .
ui:la-per rdfs:label "Persistence" . ui:la-docs rdfs:label "Docs" .
ui:doc-la-2 a c:Text ; c:label "Turn any of them off in the Engine tool and the same components render without them." .
ui:doc-la-3 a c:Text ; c:label "None of the components below knows about any layer. The validation layer reads the shape the field points at and gives it an error; the accessibility layer ties the error and the help to the input; the status layer marks the busy button and the theme shimmers it; the tooltip layer shows c:tip on hover and focus." .
ui:la-live a c:LiveExample ; c:label "Layers at work" ; c:exampleRoot <https://example.org/layers#page> ; c:sources ( ui:la-live-app ) .
ui:la-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/layers#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:age ex:sync ) .
ex:age a c:TextField ; c:label "Age" ; c:help "As on your passport." ;
    c:inputType "number" ; c:value "7" ; val:validates ex:AgeShape .
ex:AgeShape a sh:PropertyShape ; sh:path c:value ; sh:minCount 1 ;
    sh:datatype xsd:integer ; sh:minInclusive 13 ; sh:maxInclusive 120 ;
    sh:message "A whole number from 13 to 120." .
ex:sync a c:Button ; c:label "Syncing" ; st:busy true ;
    c:tip "st:busy: the status layer marks it aria-busy, and the theme shimmers it." .''' .

# --- Behaviour and events ---
ui:doc-behaviour a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-be-h ui:doc-be-1 ui:be-live ui:doc-be-1b ui:doc-be-2 ) .
ui:doc-be-h a c:Heading ; c:level 1 ; c:label "Behaviour and events" .
ui:doc-be-1 a c:Text ; c:label "An interaction becomes an RDF event addressed to the innermost component with a matching reaction. A reaction is a pair of CONSTRUCTs - what to delete, what to insert - over $event and $this. Every matching reaction sees the state before the event, and their union is applied as one change." .
ui:doc-be-1b a c:Text ; c:label "One reaction serves both buttons: it is for every c:Button (beh:sourceClass), $this is the one clicked, and its ex:step says by how much. The stream statistics below are the example's own change log, counted by a SPARQL rule." .
ui:be-live a c:LiveExample ; c:label "Events and reactions" ; c:exampleRoot <https://example.org/counter#page> ; c:sources ( ui:be-live-app ) .
ui:be-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/counter#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/counter#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:count ex:buttons ex:log ) .
ex:count a c:Heading ; c:level 2 ; c:label "0" ; ex:n 0 .
ex:buttons a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ex:less ex:more ) .
ex:less a c:Button ; c:label "-1" ; ex:step -1 .
ex:more a c:Button ; c:label "+1" ; ex:step 1 ; sty:intent sty:Primary .
ex:log a c:StreamStats ; c:label "Events" ; c:of beh:ChangeLog .

ex:Step a beh:Reaction ;
    beh:when beh:Click ; beh:sourceClass c:Button ;
    beh:deletes """CONSTRUCT { ex:count ex:n ?n ; c:label ?shown }
WHERE { $this ex:step ?step . ex:count ex:n ?n ; c:label ?shown }""" ;
    beh:inserts """CONSTRUCT { ex:count ex:n ?next ; c:label ?label }
WHERE { $this ex:step ?step . ex:count ex:n ?n BIND(?n + ?step AS ?next) BIND(STR(?next) AS ?label) }""" .''' .
ui:doc-be-2 a c:Text ; c:label "Each event, with the size of the change it caused, becomes an immutable member of the beh:ChangeLog, an LDES stream bounded by its retention policy and linked from its newest member back, so the latest members are read in as many steps. The Change log and Activity tools are views of it." .

# --- Styling and themes ---
ui:doc-styling a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-st-h ui:doc-st-1 ui:st-live ui:doc-st-1b ui:doc-st-2 ui:doc-st-3 ) .
ui:doc-st-h a c:Heading ; c:level 1 ; c:label "Styling and themes" .
ui:doc-st-1 a c:Text ; c:label "Styles compile from the ontology into cascade layers: tokens become custom properties, hookable properties (tone, emphasis, size, text style, layout) become data-sem-* attributes, and sty:StyleRules declare what each value looks like - once, for every component that has the axis." .
ui:doc-st-1b a c:Text ; c:label "Tone and emphasis are axes every component that has them shares: the same values, the same look. The style rule at the end is the example's own: a rule for c:Badge in your app styles every badge, but in a sandbox only that sandbox's." .
ui:st-live a c:LiveExample ; c:label "Variants and a style rule" ; c:exampleRoot <https://example.org/styles#page> ; c:sources ( ui:st-live-app ) .
ui:st-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/styles#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:badges ex:buttons ) .
ex:badges a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ;
    c:children ( ex:info ex:done ex:failed ) .
ex:info a c:Badge ; c:label "Queued" ; sty:tone sty:Info .
ex:done a c:Badge ; c:label "Passed" ; sty:tone sty:Success .
ex:failed a c:Badge ; c:label "Failed" ; sty:tone sty:Danger ; sty:emphasis sty:Solid .
ex:buttons a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ;
    c:children ( ex:solid ex:soft ex:ghost ) .
ex:solid a c:Button ; c:label "Solid" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ex:soft a c:Button ; c:label "Soft" ; sty:tone sty:Accent ; sty:emphasis sty:Soft .
ex:ghost a c:Button ; c:label "Ghost" ; sty:tone sty:Accent ; sty:emphasis sty:Ghost .

[] a sty:StyleRule ; sty:appliesTo c:Badge ;
    sty:declares [ sty:property "text-transform" ; sty:raw "uppercase" ] ,
                 [ sty:property "letter-spacing" ; sty:raw "0.06em" ] .''' .
ui:doc-st-3 a c:Text ; c:children ( "Themes for part of a page, with a picker, are a " ui:doc-st-recipe "." ) .
ui:doc-st-recipe a c:Link , c:Setter ; c:label "recipe" ; c:href "/docs/recipes/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRecipes .
ui:doc-st-2 a c:Text ; c:label "A theme (sty:theme on any subtree) re-values every token; structural themes add rules narrowed to themselves that rebuild title bars, controls and docks. Contrast, motion and density compose with every theme." .

# --- Persistence ---
ui:doc-persistence a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-pe-h ui:doc-pe-1 ui:doc-pe-code ui:doc-pe-2 ui:doc-pe-3 ) .
ui:doc-pe-h a c:Heading ; c:level 1 ; c:label "Persistence" .
ui:doc-pe-1 a c:Text ; c:label "What to remember is graph data too: a per:Policy names a subject and properties, or a CONSTRUCT, and a scope - this tab, this device, the browser database. A host effect restores policies before the first render and writes them back in idle time." .
ui:doc-pe-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ui:rememberDisplay a per:Policy ; per:scope per:Device ; per:acrossTabs true ;
    per:subject ui:shell ;
    per:properties ( mot:preference sty:contrast sty:density sty:theme ) .""" .
ui:doc-pe-2 a c:Text ; c:label "That policy is this site\u2019s own, running now: change the theme and open the page in another tab: it opens in that theme, and a tab already open follows. The edits of the live examples in these docs are remembered the same way (ui:rememberLiveExamples, a CONSTRUCT over every example\u2019s sources). Every write, restore and forget is a member of per:StateLog. On this site the display settings and the colour scheme are remembered on this device (per:acrossTabs: every open tab follows them); the tools, the language, private mode and the page you were on, for the tab; the change log only if you switch it on." .
ui:doc-pe-3 a c:Text ; c:children ( "Persistence keeps what this browser should remember. Data that several people share, kept in a store on a server, is a remote source instead: " ui:doc-pe-to-remote " says how a page binds to it." ) .
ui:doc-pe-to-remote a c:Link , c:Setter ; c:label "Remote data" ; c:href "/docs/remote/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRemote .

# --- Remote data --- (docs/REMOTE.md says the same, at more length)
ui:doc-remote a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-re-h ui:doc-re-1 ui:doc-re-2 ui:doc-re-live-1 ui:re-live ui:doc-re-live-2
                 ui:doc-re-not-h ui:doc-re-not-1 ui:doc-re-not ui:doc-re-not-2
                 ui:doc-re-decl-h ui:doc-re-decl-1 ui:doc-re-decl-ttl ui:doc-re-decl-2 ui:doc-re-decl-ts ui:doc-re-decl ui:doc-re-decl-3
                 ui:doc-re-pat-h ui:doc-re-pat-1 ui:doc-re-pat-ts ui:doc-re-pat-2
                 ui:doc-re-see-h ui:doc-re-see-1 ui:doc-re-see ui:doc-re-see-2 ui:doc-re-see-ttl ui:doc-re-see-3
                 ui:doc-re-pro-h ui:doc-re-pro-1 ui:doc-re-pro-get ui:doc-re-pro ui:doc-re-pro-2 ui:doc-re-pro-post ui:doc-re-pro-json ui:doc-re-pro-3
                 ui:doc-re-srv-h ui:doc-re-srv-1 ui:doc-re-srv-ts ui:doc-re-srv-2
                 ui:doc-re-eff-h ui:doc-re-eff-1 ui:doc-re-eff ui:doc-re-eff-2
                 ui:doc-re-con-h ui:doc-re-con
                 ui:doc-re-safe-h ui:doc-re-safe-1
                 ui:doc-re-try-h ui:doc-re-try-1 ui:doc-re-try-sh ui:doc-re-try-2 ui:doc-re-more ) .
ui:doc-re-h a c:Heading ; c:level 1 ; c:label "Remote data" .
ui:doc-re-1 a c:Text ; c:label "An app's data does not have to live in the page. A team with a triple store behind a server can keep its graph there and bind a page to the part of it the page needs. The page loads that part, then receives the store's changes to it as they happen; its own changes go back as writes. The store stays the authority." .
ui:doc-re-2 a c:Text ; c:children ( "The graph says what lives elsewhere, with a " ui:doc-re-m-Source " (ontology/layers/source.ttl, prefix src:); the host says where. The remote-sources effect (src/remote.ts) does the rest. What arrives from the store is an ordinary input change, applied with runtime.apply: rules and views take it in as they take in a click, so a change from the store costs what it changes, however large the store is." ) .
# A page following a store (c:storeSource): the store is simulated in the page, from store.ttl, and
# the example's source binds to it in its sandbox; no URL is named anywhere.
ui:doc-re-live-1 a c:Text ; c:label "Here a page follows a store. The store is simulated, in this page: store.ttl is its Turtle, and the host binds the example's source to it, with no network. The todos are in the store, not in app.ttl." .
ui:re-live a c:LiveExample ; c:label "A page following a store" ; c:exampleRoot <https://example.org/shared#page> ;
    c:sources ( ui:re-live-app ui:re-live-store ) ; c:storeSource ui:re-live-store .
ui:re-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/shared#> .

# What lives in the store: every todo, and the list's links to them.
# The page's changes to them go back. Where the store is, the host says.
ex:store a src:Source ;
    src:pattern [ src:class ex:Todo ] , [ src:subject ex:todos ; src:predicate c:item ] ;
    src:writable true .
ex:todos src:awaits ex:store .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:status ex:entry ex:todos ex:clear ) .
ex:status a c:Badge ; c:label "Connecting" .
ex:entry a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; pos:align pos:End ;
    c:children ( ex:newTodo ex:add ) .
ex:newTodo a c:TextField ; c:label "New todo" ; c:placeholder "What needs doing?" .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .
ex:todos a c:List ; c:label "Todos" ; c:sortBy ex:created ;
    c:itemLabel rdfs:label ; c:itemChecked ex:done .
ex:clear a c:Button ; c:label "Clear done" .

# Add: a todo from the field, named by the moment of the click.
ex:AddTodo a beh:Reaction ; beh:when beh:Click ; beh:source ex:add ;
    beh:deletes """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ex:newTodo c:value ?v . ex:status c:label ?l ; sty:tone ?t }
WHERE { ex:newTodo c:value ?v FILTER(REGEX(STR(?v), "[^ ]"))
        ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ?item a ex:Todo ; rdfs:label ?v ; ex:done false ; ex:created ?at .
            ex:todos c:item ?item . ex:status c:label "Live" ; sty:tone sty:Success }
WHERE {
  ex:newTodo c:value ?v FILTER(REGEX(STR(?v), "[^ ]"))
  $event beh:at ?at
  BIND(IRI(CONCAT(STR(ex:), "t-", REPLACE(STR(?at), "[^0-9]", ""))) AS ?item)
}""" .

# Clear done: every done todo goes, with its place in the list.
ex:ClearDone a beh:Reaction ; beh:when beh:Click ; beh:source ex:clear ;
    beh:deletes """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ?t ?p ?o . ex:todos c:item ?t }
WHERE { ex:todos c:item ?t . ?t ex:done true ; ?p ?o }""" .

# The store's events, said by the badge.
ex:ShowLive a beh:Reaction ; beh:when src:WentLive ; beh:source ex:store ;
    beh:deletes """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ex:status c:label ?l ; sty:tone ?t }
WHERE { ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ex:status c:label "Live" ; sty:tone sty:Success } WHERE {}""" .
ex:ShowRefused a beh:Reaction ; beh:when src:WriteRefused ; beh:source ex:store ;
    beh:deletes """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ex:status c:label ?l ; sty:tone ?t }
WHERE { ex:status c:label ?l OPTIONAL { ex:status sty:tone ?t } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/shared#>
CONSTRUCT { ex:status c:label ?reason ; sty:tone sty:Danger }
WHERE { $event src:reason ?reason }""" .''' .
ui:re-live-store a c:CodeEditor ; c:language "turtle" ; c:label "store.ttl" ; c:original '''@prefix ex: <https://example.org/shared#> .

ex:TodoShape a sh:NodeShape ;
    sh:property [
        sh:maxLength 24 ;
        sh:message "A todo is at most 24 characters." ;
        sh:path rdfs:label
    ] ;
    sh:targetClass ex:Todo .
ex:t1 a ex:Todo ;
    ex:created "2026-11-01T09:00:00Z"^^xsd:dateTime ;
    ex:done true ;
    rdfs:label "Write the ontology" .
ex:t2 a ex:Todo ;
    ex:created "2026-11-02T09:00:00Z"^^xsd:dateTime ;
    ex:done false ;
    rdfs:label "Sketch the styles" .
ex:t3 a ex:Todo ;
    ex:created "2026-11-03T09:00:00Z"^^xsd:dateTime ;
    ex:done false ;
    rdfs:label "Wire up behaviour" .
ex:todos c:item
        ex:t1,
        ex:t2,
        ex:t3 .
''' .
ui:doc-re-live-2 a c:Text ; c:label "Edit store.ttl, as another client would: the store takes the edit as one change, and only that change reaches the page; the example is not built again. Tick, add or clear a todo: the page writes it to the store, and store.ttl shows what the store holds now. The store's shape refuses a todo longer than 24 characters: add one, and the page puts back what the store holds while the badge says why." .
ui:doc-re-m-Source a c:Mention ; c:label "src:Source" ; c:mentions src:Source ; c:to src:Source .

ui:doc-re-not-h a c:Heading ; c:level 2 ; c:label "A source, SERVICE or LOAD" .
ui:doc-re-not-1 a c:Text ; c:label "SPARQL has two ways to reach data elsewhere: SERVICE, which sends part of a query to an endpoint while the query runs, and LOAD, which fetches a document into the store. The engines run both when the host asks, for a one-off question or import. A source is for something else:" .
ui:doc-re-not a c:DescriptionList ; c:of ui:doc-re-not-items ; c:fields ( ui:re-n-authority ui:re-n-deltas ui:re-n-endpoint ui:re-n-cost ) .
ui:doc-re-not-items ui:re-n-authority "The store is the authority. A SERVICE answer and a LOADed document are copies as of when they were fetched, and drift from where they came from. A source binds the page's part of the store for as long as the page is open: the page holds what the store holds, and a write the store refuses is put back to what it holds." ;
    ui:re-n-deltas "Only deltas reach the page. After one snapshot, the store sends what changed, as it changes, and nothing else. Rules and views see each change incrementally; they may not use SERVICE or LOAD, whose results are not." ;
    ui:re-n-endpoint "Nothing in the graph decides where the page connects. A source names only what it covers; the host maps its IRI to a URL and credentials, and a source it does not map stays src:Unbound. SERVICE and LOAD name an IRI in the query, but only the host's own asynchronous calls fetch, from the IRIs its policy lists, mapped the same way. An authored graph cannot point a page at a server either way." ;
    ui:re-n-cost "A change costs the change. The server tells which pages a changed statement concerns by its predicate, its subject or its subject's type, one indexed lookup; the page applies it as one input change. Neither side re-reads the store or the page's part of it." .
ui:re-n-authority rdfs:label "The authority" . ui:re-n-deltas rdfs:label "Deltas" . ui:re-n-endpoint rdfs:label "Where it connects" . ui:re-n-cost rdfs:label "Cost" .
ui:doc-re-not-2 a c:Text ; c:children ( "Bind a source for data the page should follow; ask with SERVICE, or import with LOAD, for data it needs once. " ui:doc-re-to-fetching " has how." ) .
ui:doc-re-to-fetching a c:Link , c:Setter ; c:label "SERVICE and LOAD" ; c:href "/docs/fetching/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocFetching .

ui:doc-re-decl-h a c:Heading ; c:level 2 ; c:label "Declaring a source" .
ui:doc-re-decl-1 a c:Text ; c:label "The graph says what lives elsewhere. This is the todo list of examples/remote: every todo, and the list's links to them, live in the store, and the page's changes to them go back." .
ui:doc-re-decl-ttl a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:store a src:Source ;
    src:pattern [ src:class ex:Todo ] , [ src:subject ex:todos ; src:predicate c:item ] ;
    src:writable true .
ex:todos src:awaits ex:store .""" .
ui:doc-re-decl-2 a c:Text ; c:label "The host says where, by the source's IRI. An endpoint is a URL with headers (credentials), or any SourceTransport - an object with follow and write - for a store reached some other way:" .
ui:doc-re-decl-ts a c:Code ; c:block true ; c:language "typescript" ; c:label """await mount(element, {
  root: EX + 'page',
  graphs: [app],
  sources: { endpoints: { [EX + 'store']: { url: '/store/', headers: { authorization } } } },
})

// without mount
new RemoteSources(runtime, { endpoints, bus, onChange }).attach()""" .
ui:doc-re-decl a c:DescriptionList ; c:of ui:doc-re-decl-items ; c:fields ( ui:re-d-pattern ui:re-d-graph ui:re-d-writable ui:re-d-awaits ) .
ui:doc-re-decl-items ui:re-d-pattern "What the source covers. The page binds to the union of its patterns (below)." ;
    ui:re-d-graph "Optional: the named graph its statements land in. By default they land in the default graph, where components read." ;
    ui:re-d-writable "The page's changes to the source's statements go back to the store. Without it they stay in the page." ;
    ui:re-d-awaits "On a component: it is st:busy (aria-busy, the theme's shimmer) while the source loads or reconnects." .
ui:re-d-pattern rdfs:label "src:pattern" . ui:re-d-graph rdfs:label "src:graph" . ui:re-d-writable rdfs:label "src:writable" . ui:re-d-awaits rdfs:label "src:awaits" .
ui:doc-re-decl-3 a c:Text ; c:label "Under mount({ authored }) the sources are read from the trusted graphs alone, so an authored graph cannot declare one, widen the patterns of one the host bound, or make it writable." .

ui:doc-re-pat-h a c:Heading ; c:level 2 ; c:label "What a page binds to" .
ui:doc-re-pat-1 a c:Text ; c:label "A pattern is a triple pattern - any of src:subject, src:predicate and src:object, an omitted one matching anything - or a class: src:class covers every statement whose subject is an instance of the class. On the wire they are JSON:" .
ui:doc-re-pat-ts a c:Code ; c:block true ; c:language "typescript" ; c:label """const patterns = [{ class: EX + 'Todo' }, { subject: EX + 'todos', predicate: C + 'item' }]""" .
ui:doc-re-pat-2 a c:Text ; c:label "A changed statement is matched by its predicate, its subject, or its subject's type: the server can tell which pages a change concerns in constant time, and the page which of its own changes belong to the store. Statements name things by IRI: a blank node has no identity across the wire, so a source leaves it out." .

ui:doc-re-see-h a c:Heading ; c:level 2 ; c:label "What the page can see" .
ui:doc-re-see-1 a c:Text ; c:label "What the effect knows is graph data in urn:semblance:sources:" .
ui:doc-re-see a c:DescriptionList ; c:of ui:doc-re-see-items ; c:fields ( ui:re-s-state ui:re-s-log ui:re-s-events ) .
ui:doc-re-see-items ui:re-s-state "On each source: src:state (src:Unbound, src:Loading, src:Live, src:Reconnecting), src:cursor, src:pending (writes not yet answered), src:attempts and src:lastError." ;
    ui:re-s-log "src:SyncLog, a bounded LDES (logSize, 100 by default) of what happened: src:Snapshot (with src:reset when it replaced what the page held), src:Received, src:Write (prov:wasInformedBy the change-log member of the event that made it), src:Confirmed and src:Refused (src:of the write, with src:reason)." ;
    ui:re-s-events "Events targeted at the source, for the page's reactions: src:WentLive, src:Lost (with src:lastError) and src:WriteRefused (with src:reason)." .
ui:re-s-state rdfs:label "State" . ui:re-s-log rdfs:label "The sync log" . ui:re-s-events rdfs:label "Events" .
ui:doc-re-see-2 a c:Text ; c:label "What the page does about them is up to its reactions. The example's badge says why a write was refused:" .
ui:doc-re-see-ttl a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:ShowRefused a beh:Reaction ; beh:when src:WriteRefused ; beh:source ex:store ;
    beh:deletes \"\"\"CONSTRUCT { ex:status c:label ?l ; sty:tone ?t } WHERE { … }\"\"\" ;
    beh:inserts \"\"\"CONSTRUCT { ex:status c:label ?label ; sty:tone sty:Danger }
WHERE { $event src:reason ?reason
        BIND(IF(?reason = "stale", "Changed elsewhere: shown as it is now", ?reason) AS ?label) }\"\"\" .""" .
ui:doc-re-see-3 a c:Text ; c:label "The page's change log stays the record of the page's events. Changes from the store are not page events: they are recorded in src:SyncLog, not in the change log." .

ui:doc-re-pro-h a c:Heading ; c:level 2 ; c:label "The protocol" .
ui:doc-re-pro-1 a c:Text ; c:label "Plain HTTP and JSON, with statements as N-Triples; the types are in src/source-protocol.ts, exported from the package. Reading is a stream of server-sent events, read with fetch rather than EventSource so that it can send the headers the server needs:" .
ui:doc-re-pro-get a c:Code ; c:block true ; c:language "http" ; c:label """GET /store/changes?patterns=[{"class":"…#Todo"}]&after=41
Accept: text/event-stream
Authorization: Bearer …""" .
ui:doc-re-pro a c:DescriptionList ; c:of ui:doc-re-pro-items ; c:fields ( ui:re-p-snapshot ui:re-p-delta ui:re-p-cursor ) .
ui:doc-re-pro-items ui:re-p-snapshot "{ cursor, add, reset? }: first, when there is no after, or when after is older than the server's log; then reset is true, and the snapshot replaces what the page holds of the store." ;
    ui:re-p-delta "{ cursor, add, remove, write? }: every change to the store that touches the patterns, in order; write is the id of the page's write it came from, if any." ;
    ui:re-p-cursor "{ cursor }: after a resumed backlog, and now and then while nothing concerns the page, so the cursor a page resumes from stays recent." .
ui:re-p-snapshot rdfs:label "snapshot" . ui:re-p-delta rdfs:label "delta" . ui:re-p-cursor rdfs:label "cursor" .
ui:doc-re-pro-2 a c:Text ; c:label "The cursor is a sequence number: every change to the store, from any client, is one step. Writing is one request per write:" .
ui:doc-re-pro-post a c:Code ; c:block true ; c:language "http" ; c:label """POST /store/writes
Content-Type: application/json

{ "id": "m3k2-7",
  "add": "<…#t4> <…#label> \\"Ship it\\" .",
  "remove": "<…#t4> <…#label> \\"Ship\\" ." }""" .
ui:doc-re-pro-json a c:Code ; c:block true ; c:language "json" ; c:label """{ "ok": true, "cursor": 42 }

{ "ok": false, "reason": "stale", "repair": { "add": "…", "remove": "…" } }""" .
ui:doc-re-pro-3 a c:Text ; c:label "The server applies a write atomically, answering 200 with the new cursor, or 409 when it refuses: stale when a statement the write removes is not in the store (compare-and-set: the page made it from a state someone else has changed since, which keeps a single-valued property single-valued when two pages change it at once), or the store's own validation. repair is what the store holds of the statements the write touched; applying it puts the page back in step, and keeps the change from elsewhere." .

ui:doc-re-srv-h a c:Heading ; c:level 2 ; c:label "The reference server" .
ui:doc-re-srv-1 a c:Text ; c:label "SourceServer (src/node/source-server.ts, exported from @inferal-oss/semblance/node) is an in-memory store behind an HTTP handler that speaks the protocol:" .
ui:doc-re-srv-ts a c:Code ; c:block true ; c:language "typescript" ; c:label """import { createServer } from 'node:http'
import { SourceServer } from '@inferal-oss/semblance/node'

const store = new SourceServer({
  validate: ({ add }) => (add.some(tooLong) ? 'A todo is at most 40 characters.' : undefined),
})
store.load(turtle)
const handle = store.handler('/store/')
createServer((req, res) => void (handle(req, res) || res.writeHead(404).end())).listen(3100)""" .
ui:doc-re-srv-2 a c:Text ; c:label "It keeps a bounded log of steps (logSize, 1000 by default) for pages that resume after a break, with the types of the subjects each step touched, before and after, so a subject that becomes an instance of a bound class is sent whole. It is a starting point and a test double, not a database: a deployment puts the same protocol in front of its own triple store, and checks who may read which patterns and write which statements." .

ui:doc-re-eff-h a c:Heading ; c:level 2 ; c:label "What the effect does" .
ui:doc-re-eff-1 a c:Text ; c:label "For each source the host bound - and what a host that binds a store some other way does too:" .
ui:doc-re-eff a c:DescriptionList ; c:of ui:doc-re-eff-items ; c:fields ( ui:re-e-follow ui:re-e-reconnect ui:re-e-write ) .
ui:doc-re-eff-items ui:re-e-follow "It applies the snapshot, then each delta, with runtime.apply (runtime.write for a src:graph), marked as coming from the store so they are not sent back. A snapshot replaces what the page holds of the source, matched pattern by pattern: that costs the page's part, not the page." ;
    ui:re-e-reconnect "When the stream breaks, it waits with doubling backoff (backoff, 500 ms to 10 s by default), then opens the stream again from its cursor. The server sends what was missed, or a reset snapshot when the gap is longer than its log." ;
    ui:re-e-write "runtime.onInput hears every change to the input; the effect keeps what the patterns cover, judging a removed statement by its subject's types before the change. Everything one tick changes is one write, closed early when a change from the store arrives. Writes go one at a time, in order. A local change shows at once; a refused write's repair is applied as a change from the store; a write that cannot reach the server waits, and local changes queue behind it." .
ui:re-e-follow rdfs:label "Follows" . ui:re-e-reconnect rdfs:label "Reconnects" . ui:re-e-write rdfs:label "Writes" .
ui:doc-re-eff-2 a c:Text ; c:label "test/remote.test.ts holds the rule runs, derived output, store reads and server checks of one change from the store equal for a store with 10 and with 20 000 statements the page does not bind to, and for a list of 3 and of 63 todos." .

ui:doc-re-con-h a c:Heading ; c:level 2 ; c:label "Consistency" .
ui:doc-re-con a c:DescriptionList ; c:of ui:doc-re-con-items ; c:fields ( ui:re-c-order ui:re-c-optimistic ui:re-c-window ui:re-c-offline ) .
ui:doc-re-con-items ui:re-c-order "The store's cursor orders everything: deltas are applied in cursor order, and a page resumes from the cursor it last saw." ;
    ui:re-c-optimistic "Local changes are optimistic. A write is compare-and-set on the statements it removes: one made from a stale state is refused, and the page is repaired to what the store holds. When two pages change one value at once, the first write the store takes wins, and the other page shows it." ;
    ui:re-c-window "Between a local change and its answer, a change from elsewhere can show beside it (two values of one property) until the refusal repairs it. That is the window optimism opens, and the answer closes it." ;
    ui:re-c-offline "Writes made while the store is unreachable stay applied in the page, wait in order, and meet the same check when they are sent." .
ui:re-c-order rdfs:label "Order" . ui:re-c-optimistic rdfs:label "Optimism" . ui:re-c-window rdfs:label "The window" . ui:re-c-offline rdfs:label "Offline" .

ui:doc-re-safe-h a c:Heading ; c:level 2 ; c:label "Safety" .
ui:doc-re-safe-1 a c:Text ; c:children ( "What a store sends is data in the page's store like any other, rendered under the projection's policy if it has one; whether a write is accepted is the server's decision. List the endpoints the host binds in the Content Security Policy's connect-src. " ui:doc-re-to-safety " has the rest." ) .
ui:doc-re-to-safety a c:Link , c:Setter ; c:label "Safe authoring" ; c:href "/docs/safety/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocSafety .

ui:doc-re-try-h a c:Heading ; c:level 2 ; c:label "Try it" .
ui:doc-re-try-1 a c:Text ; c:label "examples/remote is a shared todo list, served beside its store:" .
ui:doc-re-try-sh a c:Code ; c:block true ; c:language "shell" ; c:label """npx vite --config examples/remote/vite.config.ts""" .
ui:doc-re-try-2 a c:Text ; c:label "Open it in two windows: what one changes, the other shows. A label longer than 40 characters is refused by the store, and the page puts back what the store holds. The example above is the same page over a store simulated in the page itself." .
ui:doc-re-more a c:Text ; c:label "docs/REMOTE.md in the repository says the same, at more length." .

# --- SERVICE and LOAD --- (docs/FETCHING.md says the same, at more length)
ui:doc-fetching a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-fe-h ui:doc-fe-1 ui:doc-fe-when ui:doc-fe-2
                 ui:doc-fe-ask-h ui:doc-fe-ask-1 ui:doc-fe-ask-ts ui:doc-fe-ask-2 ui:doc-fe-ask-mount
                 ui:doc-fe-pol-h ui:doc-fe-pol-1 ui:doc-fe-pol ui:doc-fe-pol-2
                 ui:doc-fe-wait-h ui:doc-fe-wait-1 ui:doc-fe-wait ui:doc-fe-wait-2
                 ui:doc-fe-svc-h ui:doc-fe-svc-1 ui:doc-fe-svc
                 ui:doc-fe-load-h ui:doc-fe-load-1
                 ui:doc-fe-safe-h ui:doc-fe-safe
                 ui:doc-fe-stores-h ui:doc-fe-stores ui:doc-fe-more ) .
ui:doc-fe-h a c:Heading ; c:level 1 ; c:label "SERVICE and LOAD" .
ui:doc-fe-1 a c:Text ; c:label "SERVICE sends part of a query to another SPARQL endpoint while the query runs; LOAD fetches a document into a graph. Semblance's engines run both, but only when the host asks, through an asynchronous call, and only for endpoints and documents the host lists. Rules, views and reactions never fetch." .
ui:doc-fe-when a c:DescriptionList ; c:of ui:doc-fe-when-items ; c:fields ( ui:fe-w-source ui:fe-w-service ui:fe-w-load ) .
ui:doc-fe-when-items ui:fe-w-source "Part of a server's store the page binds to and keeps current: loaded once, then deltas both ways; rules see each change incrementally." ;
    ui:fe-w-service "A one-off question to a SPARQL endpoint the page does not hold: a lookup, a join of local rows with a public dataset, answered when asked." ;
    ui:fe-w-load "A one-off import of a document (a dataset dump, a vocabulary) into a graph of the store." .
ui:fe-w-source rdfs:label "A remote source" . ui:fe-w-service rdfs:label "SERVICE" . ui:fe-w-load rdfs:label "LOAD" .
ui:doc-fe-2 a c:Text ; c:children ( "A SERVICE answer and a LOADed document are copies as of when they were fetched; nothing keeps them in step with where they came from. When the page should follow the data, bind a source: " ui:doc-fe-to-remote "." ) .
ui:doc-fe-to-remote a c:Link , c:Setter ; c:label "Remote data" ; c:href "/docs/remote/" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRemote .

ui:doc-fe-ask-h a c:Heading ; c:level 2 ; c:label "Asking" .
ui:doc-fe-ask-1 a c:Text ; c:label "store.fetching is the asynchronous side of a store: select (SELECT rows, or an ASK's boolean), construct and update, each with a policy, one at a time per store. The wasm engine stores (wat, rust) have it; Oxigraph and N3 do not." .
ui:doc-fe-ask-ts a c:Code ; c:block true ; c:language "typescript" ; c:label """const policy: FetchPolicy = {
  endpoints: { 'urn:ex:catalog': { url: 'https://data.example.org/sparql', headers: { authorization } } },
  documents: { 'https://w3id.org/vocab/*': {} },
  deadline: Date.now() + 5000,
}

const rows = await store.fetching!.select(`
  SELECT ?item ?price WHERE {
    ?item a ex:Item ; ex:sku ?sku .
    SERVICE <urn:ex:catalog> { ?product ex:sku ?sku ; ex:price ?price }
  }`, graphs, policy)

await store.fetching!.update(`LOAD <https://w3id.org/vocab/terms.ttl> INTO GRAPH <urn:ex:vocab>`, policy)""" .
ui:doc-fe-ask-2 a c:Text ; c:label "update changes the store directly: it is for a store no runtime drives - a server, a build step, a tool, a store seeded before mount. A mounted app takes remote data in through the runtime, so rules see it as an input change:" .
ui:doc-fe-ask-mount a c:Code ; c:block true ; c:language "typescript" ; c:label """const quads = await app.store.fetching!.construct(query, graphs, policy)
app.runtime.apply({ add: quads, remove: [] })""" .

ui:doc-fe-pol-h a c:Heading ; c:level 2 ; c:label "The policy" .
ui:doc-fe-pol-1 a c:Text ; c:label "Nothing is fetched unless the host lists it. The policy is code, passed with each call: no graph can add to it, and nothing in the graph configures fetching." .
ui:doc-fe-pol a c:DescriptionList ; c:of ui:doc-fe-pol-items ; c:fields ( ui:fe-p-endpoints ui:fe-p-documents ui:fe-p-redirects ui:fe-p-limits ui:fe-p-deadline ) .
ui:doc-fe-pol-items ui:fe-p-endpoints "SERVICE: the endpoint IRI as the query names it, to how to reach it (url, headers, credentials, bindings). Matched by exact IRI, never by prefix. None listed: every SERVICE fails." ;
    ui:fe-p-documents "LOAD: a document IRI, or a prefix ending in /* (an http(s) URL whose path ends in /), to how to reach it. A candidate must normalize (case, dot segments, %2e, ports) to the same origin under that path, so allowed.example@evil.example, a longer host and ../ do not get through. None listed: every LOAD fails." ;
    ui:fe-p-redirects "A redirect fails the request, so headers never follow it to another origin; credentials are omitted unless an entry says otherwise. A user name in a URL, a scheme other than http(s), and keys such as __proto__ are refused." ;
    ui:fe-p-limits "timeoutMs (10 s by default), maxBytes (16 MiB) and maxRows (100 000) per response; maxRequests (32) per operation, concurrency (4) at once. Over a cap the request fails, and with SILENT gives the empty solution." ;
    ui:fe-p-deadline "deadline bounds the whole operation, every round and every fetch; maxRounds (8) the rounds." .
ui:fe-p-endpoints rdfs:label "endpoints" . ui:fe-p-redirects rdfs:label "Redirects, credentials" . ui:fe-p-documents rdfs:label "documents" . ui:fe-p-limits rdfs:label "timeoutMs, maxBytes" . ui:fe-p-deadline rdfs:label "deadline, maxRounds" .
ui:doc-fe-pol-2 a c:Text ; c:label "The keys are the IRIs the query names; url maps one to where it really is, as remote sources map a source's IRI to its endpoint. A query can name <urn:ex:catalog> and never see a URL or a token. The list is checked for every request, including a SERVICE ?endpoint whose endpoint comes from data." .

ui:doc-fe-wait-h a c:Heading ; c:level 2 ; c:label "How a query waits" .
ui:doc-fe-wait-1 a c:Text ; c:label "An engine has no network, and a run is synchronous; a browser cannot block its main thread on a response. So a run that needs something from elsewhere stops, says what, and is run again once the host has it:" .
ui:doc-fe-wait a c:DescriptionList ; c:of ui:doc-fe-wait-items ; c:fields ( ui:fe-r-ask ui:fe-r-fetch ui:fe-r-again ) .
ui:doc-fe-wait-items ui:fe-r-ask "The run returns waiting, with every request it could name: evaluation goes on past the first missing answer." ;
    ui:fe-r-fetch "The host fetches them in parallel, under the policy, and gives the engine each answer or failure." ;
    ui:fe-r-again "The host runs the same query again. A request that needs an earlier answer (a SERVICE ?endpoint another SERVICE binds) shows up in a later round; the rounds end when the run returns anything else." .
ui:fe-r-ask rdfs:label "1. Waiting" . ui:fe-r-fetch rdfs:label "2. Fetching" . ui:fe-r-again rdfs:label "3. Again" .
ui:doc-fe-wait-2 a c:Text ; c:label "Each round re-evaluates the local part of the query, small next to a network round trip, under the engine's own deadline and fuel. Nothing is kept mid-evaluation, and the two engines do the same (rdf-engine/ABI.md, \"Optional: fetching\")." .

ui:doc-fe-svc-h a c:Heading ; c:level 2 ; c:label "SERVICE" .
ui:doc-fe-svc-1 a c:Text ; c:label "SERVICE [SILENT] (<iri> | ?var) { P } sends the endpoint SELECT * WHERE { P } as a SPARQL Protocol POST (application/sparql-query), and reads the answer as SPARQL results JSON." .
ui:doc-fe-svc a c:DescriptionList ; c:of ui:doc-fe-svc-items ; c:fields ( ui:fe-s-values ui:fe-s-leave ui:fe-s-join ui:fe-s-var ui:fe-s-silent ui:fe-s-compile ) .
ui:doc-fe-svc-items ui:fe-s-values "The solutions joined before the SERVICE, restricted to P's variables, are sent as VALUES after the pattern, so the endpoint answers only for the rows the page has. Blank nodes and triple terms cannot be sent and are left out. The endpoint joins them after evaluating P, so a FILTER inside P does not see them, as SPARQL scopes it." ;
    ui:fe-s-leave "Binding rows are the page's data, sent only to a listed endpoint. An entry with bindings: false sends none, and the engine keeps the answer rows compatible with its own; so does a request over maxBindings rows (1000), or with a term that cannot be written exactly. Sent terms are escaped by one serializer and language tags are checked, so a literal cannot change the query." ;
    ui:fe-s-join "An answer row belongs to the binding row it agrees with, so the result equals SERVICE evaluated alone and joined. WAT and Rust give the same results; the VALUES they send may differ, since each evaluator passes bindings its own way." ;
    ui:fe-s-var "SERVICE ?endpoint needs the variable bound before it in its own group (?p ex:endpoint ?endpoint SERVICE ?endpoint { … }), or a bound parameter. Bound only outside the group, or to anything but an IRI, it gives no solutions there (SILENT: the row passes). It is checked against the list like any endpoint, whoever wrote the triple that bound it." ;
    ui:fe-s-silent "A failed request - not listed, unreachable, a bad response, over a limit - gives the one empty solution, and the row passes as it is. Without SILENT the query fails with the reason." ;
    ui:fe-s-compile "A query with SERVICE is never compiled (not compilable: SERVICE); a nested SERVICE is sent to the endpoint as written." .
ui:fe-s-values rdfs:label "Bindings go along" . ui:fe-s-var rdfs:label "A variable endpoint" . ui:fe-s-leave rdfs:label "Rows leave the page" . ui:fe-s-join rdfs:label "The same result" . ui:fe-s-silent rdfs:label "SILENT" . ui:fe-s-compile rdfs:label "Compiling" .

ui:doc-fe-load-h a c:Heading ; c:level 2 ; c:label "LOAD" .
ui:doc-fe-load-1 a c:Text ; c:label "LOAD [SILENT] <iri> [INTO GRAPH <g>] fetches the document with a GET and adds its triples to g (the default graph without INTO), in order with the update's other operations; the update applies all or nothing. Documents are read as Turtle (text/turtle), N-Triples (application/n-triples) or Jelly (application/x-jelly-rdf, its default graph); blank nodes are fresh per document. A failed LOAD fails the update; LOAD SILENT does nothing." .

ui:doc-fe-safe-h a c:Heading ; c:level 2 ; c:label "Authored content never reaches the network" .
ui:doc-fe-safe a c:DescriptionList ; c:of ui:doc-fe-safe-items ; c:fields ( ui:fe-a-host ui:fe-a-rules ui:fe-a-list ui:fe-a-load ui:fe-a-response ui:fe-a-csp ) .
ui:doc-fe-safe-items ui:fe-a-host "Only the host's own asynchronous calls fetch. Rules, views and reactions run the synchronous select and construct, where a query that needs a fetch fails (\"SERVICE and LOAD reach the network: only store.fetching runs them\"): an authored SPARQL rule with SERVICE fails like any failing rule, and nothing is fetched." ;
    ui:fe-a-rules "Rules and views may not use SERVICE or LOAD: their results come from elsewhere, on no schedule the runtime sees, and are not incremental, so a rule over them could neither be maintained nor kept within a turn." ;
    ui:fe-a-list "The allow-list is the host's, in code, and checked for every request, whatever produced the IRI: a SERVICE ?endpoint bound by triples someone else wrote is refused unless listed." ;
    ui:fe-a-load "LOAD exists only in update text the host passes to fetching.update: an author cannot issue one, or choose the graph it loads into." ;
    ui:fe-a-response "A response is read up to maxBytes and parsed by its content type only; columns not asked for are dropped, terms are checked, blank nodes are fresh, and the engine checks every id it is given. A failure names what failed and why (SERVICE <iri>: timed out, HTTP 503, not an endpoint this page may query, …), never the response body. A host operation fetches only the requests its own call made." ;
    ui:fe-a-csp "A Content Security Policy's connect-src lists the URLs the policy maps to." .
ui:fe-a-host rdfs:label "The host fetches" . ui:fe-a-rules rdfs:label "Not in rules" . ui:fe-a-list rdfs:label "The allow-list" . ui:fe-a-load rdfs:label "LOAD" . ui:fe-a-response rdfs:label "Responses" . ui:fe-a-csp rdfs:label "connect-src" .

ui:doc-fe-stores-h a c:Heading ; c:level 2 ; c:label "Stores" .
ui:doc-fe-stores a c:DescriptionList ; c:of ui:doc-fe-stores-items ; c:fields ( ui:fe-t-wasm ui:fe-t-oxigraph ui:fe-t-n3 ) .
ui:doc-fe-stores-items ui:fe-t-wasm "store.fetching runs SERVICE and LOAD; in a synchronous query they are an error. test/rdf-engine-fetching.test.ts checks the safety rules on both, and the W3C federated query tests run against an in-process endpoint." ;
    ui:fe-t-oxigraph "No store.fetching: its JS build has no HTTP client. SERVICE fails and SERVICE SILENT is the empty solution; LOAD fails and LOAD SILENT does nothing." ;
    ui:fe-t-n3 "No store.fetching, and no SPARQL." .
ui:fe-t-wasm rdfs:label "wat, rust" . ui:fe-t-oxigraph rdfs:label "Oxigraph" . ui:fe-t-n3 rdfs:label "N3" .
ui:doc-fe-more a c:Text ; c:label "docs/FETCHING.md in the repository says the same, at more length; rdf-engine/ABI.md has the engine's side." .

# --- Navigation ---
ui:doc-navigation a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-na-h ui:doc-na-1 ui:doc-na-code ui:doc-na-2 ui:doc-na-3 ui:doc-na-4 ui:doc-na-5 ) .
ui:doc-na-h a c:Heading ; c:level 1 ; c:label "Navigation" .
ui:doc-na-1 a c:Text ; c:label "Where we are is graph data. A nav:Location groups the dimensions of one app; each nav:Dimension is a property of a node (the page, the docs section), says where it is carried - the address's fragment or query, this tab's or this device's storage - whether changing it makes history (a step Back returns to) or not, and when it applies at all. This site's:" .
ui:doc-na-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ui:location a nav:Location ; nav:root ui:shell ;
    nav:dimensions ( ui:atPage ui:atDocSection ui:atExample ui:atGalleryGroup ui:atReferenceTerm ui:atTarget ) .
ui:atPage a nav:Dimension ; nav:subject ui:app ; nav:property ui:page ; nav:keyProperty ui:key ;
    nav:carriedBy nav:Fragment ; nav:history nav:MakesHistory .
ui:atDocSection a nav:Dimension ; nav:subject ui:app ; nav:property ui:docSection ; nav:keyProperty ui:key ;
    nav:parent ui:atPage ; nav:when ui:Docs ;
    nav:carriedBy nav:Fragment , per:Session ; nav:history nav:MakesHistory .
ui:atTarget a nav:TargetDimension ; nav:subject ui:app ; nav:property nav:target ;
    nav:carriedBy nav:Fragment ; nav:history nav:NoHistory .""" .
ui:doc-na-2 a c:Text ; c:label "So this page is #docs/navigation. A section applies only on its page: elsewhere it is left out of the address and not read from it. On load, the carrier with the best nav:rank that has a value wins (the address, then storage), else the graph's own value. Storage carriers are written by the persistence effect, so nothing is remembered twice. Back, Forward and typed addresses are nav:Navigate events in the change log; the URL carriers realize history as a new entry or a replaced one, storage keeps only the current value. A change of what the path or the fragment spells is another place, and the page starts at its top (nav:StartsAtTop); a dimension that shows the same place another way, like the language, says nav:scroll nav:KeepsScroll. Back, Forward and a reload return to where the page was on that entry." .
ui:doc-na-3 a c:Text ; c:label "A link can point at a resource instead of an address (c:to). The framework finds the location that shows it by walking up the component tree - children, contents, cases - to the switches that show it, and spells their dimension values, with the resource as the target: a link to the code input specimen is #components/inputs/inp-codes-spec. Following it writes those values, and opens what would still hide the target, as classes declare (nav:reveal: a tab is selected, an accordion item expanded, a card turned over, a window opened); the target is brought into view once it is rendered, without motion if you asked for less." .
ui:doc-na-4 a c:Text ; c:children ( "Try it: " ui:doc-na-to-codes " (another page), or " ui:doc-na-to-workbench " (in the tools, on its tab)." ) .
ui:doc-na-to-codes a c:Link ; c:label "the code input" ; c:to ui:inp-codes-spec .
ui:doc-na-to-workbench a c:Link ; c:label "the SPARQL workbench" ; c:to ui:workbench .
ui:doc-na-5 a c:Text ; c:label "The Engine tab of the tools shows where we are: the address, and each dimension with its value, how the address spells it, and where it is carried." .

# --- Maintained views ---
ui:doc-views a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-iv-h ui:doc-iv-1 ui:doc-iv-2
                 ui:doc-iv-decl-h ui:doc-iv-decl-1 ui:doc-iv-decl-code ui:doc-iv-decl-live-1 ui:iv-live ui:doc-iv-decl-2
                 ui:doc-iv-group-h ui:doc-iv-group-1 ui:doc-iv-group-code
                 ui:doc-iv-join-h ui:doc-iv-join-1 ui:doc-iv-join-code ui:doc-iv-join-2
                 ui:doc-iv-top-h ui:doc-iv-top-1 ui:iv-live-top ui:doc-iv-top-2
                 ui:doc-iv-param-h ui:doc-iv-param-1 ui:doc-iv-param-code
                 ui:doc-iv-time-h ui:doc-iv-time-1 ui:doc-iv-time-code ui:doc-iv-time-2
                 ui:doc-iv-delta-h ui:doc-iv-delta-1 ui:doc-iv-delta-2
                 ui:doc-iv-show-h ui:doc-iv-show-1
                 ui:doc-iv-see-h ui:doc-iv-see-1 ui:doc-iv-see-code ui:doc-iv-see-2
                 ui:doc-iv-cost-h ui:doc-iv-cost-1 ui:doc-iv-cost
                 ui:doc-iv-status-h ui:doc-iv-landed-h ui:doc-iv-landed ui:doc-iv-pending-h ui:doc-iv-pending ui:doc-iv-gaps
                 ui:doc-iv-more ) .
ui:doc-iv-h a c:Heading ; c:level 1 ; c:label "Maintained views" .
ui:doc-iv-1 a c:Text ; c:label "Rules re-run their query when what they read changes. That is cheap for a list item and expensive for a query over a collection - counting the change log on every event costs as much as the log is long. A maintained view (iv:View) is a query whose result is kept up to date from the changes themselves, in the style of DBSP: a member that arrives counts once (+1), and once more, negatively (-1), when it retires or leaves a window, so a change costs what it changes, whatever the size of what it is counted over." .
ui:doc-iv-2 a c:Text ; c:children ( "A view is ordinary SPARQL: the same text runs from scratch on any store, which is how the tests check every view after every change. The " ui:doc-iv-example " example puts it to work: stock per item, a reorder list and the last hour's best sellers, kept right as sales and deliveries happen." ) .
ui:doc-iv-example a c:Link ; c:label "Warehouse" ; c:to ui:exp-warehouse .

ui:doc-iv-decl-h a c:Heading ; c:level 2 ; c:label "Declaring a view" .
ui:doc-iv-decl-1 a c:Text ; c:label "Make a query an iv:View. Over the members of a stream (an LDES such as the change log, beh:ChangeLog), an aggregate is maintained member by member; its CONSTRUCT is written to a views graph that every projection reads, so components render the result like any other data." .
ui:doc-iv-decl-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:Whole a iv:View ;
    sem:construct \"\"\"
CONSTRUCT { vx:log vx:events ?n }
WHERE { { SELECT (COUNT(?m) AS ?n) WHERE { beh:ChangeLog tree:member ?m } } }\"\"\" .

# Any component shows it: here a stat's figure, a view of its own over vx:Whole's output (iv:reads).
vx:qEvents a sem:View , iv:View ; iv:materialize iv:Graph ; iv:reads vx:Whole ; sem:select \"\"\"SELECT ?value WHERE { vx:log vx:events ?value }\"\"\" .
ui:events a c:Stat ; c:label "In the log" ; c:unit "events" ; c:valueQuery vx:qEvents .""" .
ui:doc-iv-decl-live-1 a c:Text ; c:label "Here is one running, in a sandbox with a change log of its own: each like is an event, a member of the log, and the view adds it to what it holds - it never counts the log again. Each figure is a view of its own over that view's output (a Stat's c:valueQuery, with iv:reads), so it steps right after it." .
ui:iv-live a c:LiveExample ; c:label "A maintained view" ; c:exampleRoot <https://example.org/views#page> ; c:sources ( ui:iv-live-app ) .
ui:iv-live-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/views#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/views#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:like ex:stats ) .
ex:like a c:Button ; c:label "Like" ; sty:intent sty:Primary .
ex:post ex:likes 0 .
ex:Like a beh:Reaction ; beh:when beh:Click ; beh:source ex:like ;
    beh:deletes """CONSTRUCT { ex:post ex:likes ?n } WHERE { ex:post ex:likes ?n }""" ;
    beh:inserts """CONSTRUCT { ex:post ex:likes ?next } WHERE { ex:post ex:likes ?n BIND(?n + 1 AS ?next) }""" .

# Kept member by member, as events arrive.
ex:Totals a iv:View ;
    sem:construct """CONSTRUCT { ex:log ex:events ?n ; ex:changed ?changed }
WHERE { { SELECT (COUNT(?m) AS ?n) (SUM(?a + ?r) AS ?changed)
          WHERE { beh:ChangeLog tree:member ?m . ?m beh:added ?a ; beh:removed ?r } } }""" .

ex:stats a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ex:events ex:changed ) .
# A Stat's figure is a view too (c:valueQuery), over what ex:Totals holds (iv:reads).
ex:qEvents a sem:View , iv:View ; iv:materialize iv:Graph ; iv:reads ex:Totals ;
    sem:select """SELECT ?value WHERE { ex:log ex:events ?value }""" .
ex:qChanged a sem:View , iv:View ; iv:materialize iv:Graph ; iv:reads ex:Totals ;
    sem:select """SELECT ?value WHERE { ex:log ex:changed ?value }""" .
ex:events a c:Stat ; c:label "In the log" ; c:unit "events" ; c:valueQuery ex:qEvents ; c:dataset ex:log .
ex:changed a c:Stat ; c:label "Triples changed" ; c:valueQuery ex:qChanged ; c:dataset ex:log .''' .
ui:doc-iv-decl-2 a c:Text ; c:label "COUNT, SUM, AVG, MIN, MAX, DISTINCT, HAVING and arithmetic over aggregates are maintained, and so are joins, OPTIONAL, EXISTS, NOT EXISTS, MINUS, UNION, VALUES and ORDER BY with LIMIT (below). An aggregate subquery - the busiest per kind, then the largest of those; the best time per size, joined to the run that made it - is a view inside the view: maintained group by group, its rows joined to the rest of the query, so a change reaches only the rows its group's new value touches. So are LATERAL and correlated subqueries, property paths (closures and zero-length ones included), GRAPH over the view's graphs, GROUP_CONCAT, SAMPLE and GROUP BY an expression: the W3C test suites' queries, 484 of them, are kept equal to a from-scratch run as their data arrives triple by triple. A query of another shape (NOW(), RAND(), RDF 1.2 triple terms) still works: it is recomputed, and the view says why (iv:fallback). iv:strategy iv:Incremental makes that an error instead, which is how the tests run." .

ui:doc-iv-group-h a c:Heading ; c:level 2 ; c:label "Groups" .
ui:doc-iv-group-1 a c:Text ; c:label "With GROUP BY, only the groups an event touched change - one row of output, not all of them. Mint each group's node from a key, as rules do, so a row keeps its identity and its DOM element." .
ui:doc-iv-group-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:ByType a iv:View ;
    sem:construct \"\"\"
CONSTRUCT { vx:log vx:byType ?row . ?row vx:type ?type ; vx:count ?n }
WHERE {
  { SELECT ?type (COUNT(?m) AS ?n)
    WHERE { beh:ChangeLog tree:member ?m . ?m a ?class .
            BIND(REPLACE(STR(?class), "^.*[#/]", "") AS ?type) }
    GROUP BY ?type }
  BIND(IRI(CONCAT(STR(vx:log), "/~", ENCODE_FOR_URI(?type))) AS ?row)
}\"\"\" .""" .

ui:doc-iv-join-h a c:Heading ; c:level 2 ; c:label "Joins, negation, sets" .
ui:doc-iv-join-1 a c:Text ; c:label "A view's body is split into partitions - a stream's members, or the subjects of its triple patterns - and each partition is the query run with its key bound, so a join that leaves the member (its target's label), an OPTIONAL, a FILTER NOT EXISTS or a MINUS is the store's own SPARQL for that one partition. Which partitions a change reaches comes from the query's patterns: the changed triple is bound to the pattern it matches, and the store's indexes are probed from there to the key. A label changing re-evaluates the events that point at that component, and nothing else." .
ui:doc-iv-join-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:Busiest a sem:View , iv:View ; iv:materialize iv:Graph ;
    sem:select \"\"\"
SELECT ?component (COUNT(?m) AS ?events) WHERE {
  beh:ChangeLog tree:member ?m . ?m beh:target ?t .      # leaves the member: its target
  ?t a ?class . ?class sem:slug ?component .              # and the target's class
  FILTER NOT EXISTS { ?t c:hidden true }                  # a match appearing flips its rows
}
GROUP BY ?component ORDER BY DESC(?events) ?component LIMIT 5\"\"\" .""" .
ui:doc-iv-join-2 a c:Text ; c:label "DISTINCT keeps a count per row, so a row leaves when its last source does. UNION of subqueries adds their parts. A setting every row depends on (a filter's value) reaches every partition: the view is evaluated again once, and says so in its figures." .

ui:doc-iv-top-h a c:Heading ; c:level 2 ; c:label "Top-k and rows in the graph" .
ui:doc-iv-top-1 a c:Text ; c:label "ORDER BY with LIMIT keeps every candidate in an ordered multiset: a vote moves one drink, and the window of two rows changes only if the vote crosses its edge. With iv:materialize iv:Graph a SELECT's rows are a result set in the views graph (rs:solution, rs:binding, rs:index for its order), which charts, tables and stats read instead of running the query. Vote, and watch the table:" .
ui:iv-live-top a c:LiveExample ; c:label "A maintained top-k" ; c:exampleRoot <https://example.org/votes#page> ; c:sources ( ui:iv-live-top-app ) .
ui:iv-live-top-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/votes#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/votes#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ex:buttons ex:top ) .
ex:buttons a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ex:voteTea ex:voteCoffee ex:voteCocoa ) .
ex:voteTea a c:Button ; c:label "Tea" ; ex:for ex:tea .
ex:voteCoffee a c:Button ; c:label "Coffee" ; ex:for ex:coffee .
ex:voteCocoa a c:Button ; c:label "Cocoa" ; ex:for ex:cocoa .
ex:tea a ex:Drink ; rdfs:label "Tea" ; ex:votes 3 .
ex:coffee a ex:Drink ; rdfs:label "Coffee" ; ex:votes 2 .
ex:cocoa a ex:Drink ; rdfs:label "Cocoa" ; ex:votes 1 .

# Any button: its drink gets a vote.
ex:Vote a beh:Reaction ; beh:when beh:Click ; beh:sourceClass c:Button ;
    beh:deletes """CONSTRUCT { ?d ex:votes ?n } WHERE { $this ex:for ?d . ?d ex:votes ?n }""" ;
    beh:inserts """CONSTRUCT { ?d ex:votes ?next } WHERE { $this ex:for ?d . ?d ex:votes ?n BIND(?n + 1 AS ?next) }""" .

# The two with the most votes: a top-k, maintained. A vote re-evaluates one drink.
ex:Top a sem:View , iv:View ; iv:materialize iv:Graph ;
    sem:select """SELECT ?drink ?votes WHERE { ?d a ex:Drink ; rdfs:label ?drink ; ex:votes ?votes }
ORDER BY DESC(?votes) ?drink LIMIT 2""" .

# The table reads the view's rows from the views graph.
ex:top a c:Table ; c:label "Most votes" ; c:query ex:Top ; c:dataset ex:Top ;
    c:tableColumns ( ex:colDrink ex:colVotes ) .
ex:colDrink a c:Column ; c:variable "drink" ; c:label "Drink" .
ex:colVotes a c:Column ; c:variable "votes" ; c:label "Votes" ; c:align "end" .''' .
ui:doc-iv-top-2 a c:Text ; c:label "The data grid's window works this way: three views per grid keep its members in capture order, and the window shows at most three pages of their rows, so a response arriving for an old request re-sorts its row at once, whatever the size of the capture. Each row carries a tuple order key (sem:orderKey: has a value, the value, capture order), so one row's key changing moves only that row." .

ui:doc-iv-param-h a c:Heading ; c:level 2 ; c:label "Parameters and a view per instance" .
ui:doc-iv-param-1 a c:Text ; c:label "iv:parameter binds a $name in the query to a value in the graph. When it changes, the view is retuned in place: a constant in a triple pattern re-evaluates the partitions that match its old or new value, one in a FILTER every partition (once), and for a LIMIT the window just moves. iv:targets makes a view per instance of a class, with $this bound, maintained while that instance is shown; its rows are minted under the instance, so the instance's own rules read them (sem:readsMinted)." .
ui:doc-iv-param-code a c:Code ; c:block true ; c:language "turtle" ; c:label """c:GridWindowCounts a iv:View ; iv:targets c:DataGrid ; iv:materialize iv:Graph ;
    iv:parameter [ iv:variable "collection" ; iv:property c:collection ; iv:default c:none ] ;
    sem:select \"\"\"SELECT (COUNT(*) AS ?total) WHERE { $collection tree:member ?m . … $this c:filteredBy … }\"\"\" .""" .

ui:doc-iv-time-h a c:Heading ; c:level 2 ; c:label "Windows and time" .
ui:doc-iv-time-1 a c:Text ; c:label "A window keeps only some of a stream's members. A sliding window keeps the last stretch of time; a tumbling window cuts time into buckets (a minute each, say) and keeps the newest few, with each member's bucket start as a column the view can group by - counts per minute of the last ten; a count window keeps the latest n members. Members leave a window as time passes - on one timer, set for the next expiry - even when nothing else happens, and each that leaves counts -1." .
ui:doc-iv-time-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:window a iv:SlidingWindow ; iv:range "PT30S"^^xsd:dayTimeDuration .
vx:Recent a iv:View ; iv:window vx:window ; sem:construct \"\"\" … \"\"\" .

vx:minutes a iv:TumblingWindow ; iv:size "PT1M"^^xsd:dayTimeDuration ; iv:keep 10 ; iv:bucketVariable "minute" .
vx:PerMinute a iv:View ; iv:window vx:minutes ;
    sem:select \"\"\"SELECT ?minute (COUNT(?m) AS ?n) WHERE { beh:ChangeLog tree:member ?m } GROUP BY ?minute\"\"\" .

vx:last20 a iv:CountWindow ; ldes:amount 20 .
vx:capture a iv:SlidingWindow ; iv:range "PT5S"^^xsd:dayTimeDuration ;
    iv:clock iv:EventTime ; iv:lateness "PT1S"^^xsd:dayTimeDuration .""" .
ui:doc-iv-time-2 a c:Text ; c:label "Time is the event bus's clock, which tests replace with one they move by hand. With iv:EventTime it is the data's own: the watermark, the greatest timestamp among the stream's members less a lateness, so the window moves only when a member arrives and its timestamps need not be dates - the network inspector counts the last five seconds of the capture that way, in the page's milliseconds. A member behind the watermark still counts while it is inside the window. Retention works the same way: when the change log's policy retires a member (ldes:amount), the views see -1. Whatever the window, an event and an expiry cost what they change." .
ui:doc-iv-delta-h a c:Heading ; c:level 2 ; c:label "Changes as a stream: since, replicas, undo" .
ui:doc-iv-delta-1 a c:Text ; c:label "A view's changes are a stream too. ViewHandle.since(tick) gives everything that changed after a tick, consolidated (\"since you opened this page\"), for as long as the view keeps its changes; src/view/replica.ts sends them to another store - another tab over a BroadcastChannel, a worker - which then holds the view's output without evaluating anything, and catches up (or gets the whole result once) when it joins late or misses a message. With iv:recordsChanges on a view's iv:deltaLog, each member of the log carries the triples themselves (iv:added, iv:removed), so a reader catches up with SPARQL alone." .
ui:doc-iv-delta-2 a c:Text ; c:children ( "The change log records changes the same way for undo: a reaction marked beh:undoable has its effective change recorded on its event's member, and a beh:Undoer applies the opposite of the latest one that still applies - one that later changes overlapped is skipped, not forced. The " ui:doc-iv-kanban " board's moves, drops, additions and removals are undoable." ) .
ui:doc-iv-kanban a c:Link ; c:label "Kanban" ; c:to ui:exp-kanban .

ui:doc-iv-show-h a c:Heading ; c:level 2 ; c:label "Only while shown" .
ui:doc-iv-show-1 a c:Text ; c:label "iv:whileShown names a component (or a class: any instance). While it is hidden the view does nothing per event; when it is shown again it is rebuilt once from the stream's members, and kept from then on." .

ui:doc-iv-see-h a c:Heading ; c:level 2 ; c:label "Seeing it work" .
ui:doc-iv-see-1 a c:Text ; c:label "A view's plan is graph data (iv:operator, iv:kind, iv:algebra), and so is the provenance of what it writes. Ask for more and the runtime writes it, in idle time:" .
ui:doc-iv-see-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:Recent iv:measured true ;      # figures: rows of state, rows per step, ms per step,
                                    # and a from-scratch run to compare (iv:matches)
    iv:deltaLog vx:steps .          # each step as a stream member: what came in (+1 / -1),
                                    # which groups changed, rows of work""" .
ui:doc-iv-see-2 a c:Text ; c:label "The status bar counts view rows beside rule runs, and the SPARQL workbench reads the views graph like any other: its sample \"Maintained views: their work, and a check\" lists every view with its last step's work, what a from-scratch run reads, and whether it matched. Switch on Follow updates and the query in the workbench becomes a maintained view itself: its table reads the view's rows, and the Plan tab shows how it is kept - its operators, the work of its last change against a re-run, and the check - or why it is recomputed." .

ui:doc-iv-cost-h a c:Heading ; c:level 2 ; c:label "What it costs" .
ui:doc-iv-cost-1 a c:Text ; c:label "The Activity tool and the count badges read maintained views. A todo toggle with Activity shown, with the change log keeping 200 or 2,000 events - and the network inspector, sorted by duration, when a response arrives for an old request, over 200 or 2,000 captured entries:" .
ui:doc-iv-cost a c:DescriptionList ; c:of ui:doc-iv-cost-items ; c:fields ( ui:ivc-fn ui:ivc-sparql ui:ivc-work ui:ivc-grid ) .
ui:doc-iv-cost-items ui:ivc-fn "1.0 ms either way (before: 8.3 ms and 52.4 ms)" ;
    ui:ivc-sparql "4-6 ms either way (before: 10.9 ms and 284.6 ms)" ;
    ui:ivc-work "identical at both sizes: rule runs, triples read, rows, DOM operations (a test requires it)" ;
    ui:ivc-grid "its row moves first in the same tick: 3 partitions, 9 rule runs, 8 DOM operations at either size (before: every member ranked by pairs, and the row moved only when the next entry arrived)" .
ui:ivc-fn rdfs:label "Function rules" . ui:ivc-sparql rdfs:label "SPARQL rules" . ui:ivc-work rdfs:label "Work" . ui:ivc-grid rdfs:label "Data grid" .

ui:doc-iv-status-h a c:Heading ; c:level 2 ; c:label "Status" .
ui:doc-iv-landed-h a c:Heading ; c:level 3 ; c:label "Landed: phases 0 to 5" .
ui:doc-iv-landed a c:DescriptionList ; c:of ui:doc-iv-landed-items ; c:fields ( ui:ivl-ticks ui:ivl-agg ui:ivl-uses ui:ivl-window ui:ivl-demand ui:ivl-see ui:ivl-example ui:ivl-joins ui:ivl-grid ui:ivl-charts ui:ivl-rest ui:ivl-time ui:ivl-delta ui:ivl-bench ui:ivl-sparql ui:ivl-rules ) .
ui:doc-iv-landed-items ui:ivl-ticks "Every change is a tick; Runtime.transaction makes several one, consolidated. An event's reaction and its change-log entry are one tick." ;
    ui:ivl-agg "Aggregates over a stream's members, maintained member by member; other shapes recomputed, with the reason (iv:fallback)." ;
    ui:ivl-uses "The Activity tool and count badges, at constant cost per event." ;
    ui:ivl-window "Sliding windows on one timer, ahead of phase 4 because the example needed one." ;
    ui:ivl-time "Phase 4: tumbling and count windows; event time with a watermark (the network inspector's last five seconds); every window an edge that moves, so an event and an expiry cost what they change." ;
    ui:ivl-delta "Changes as a stream: since(tick), replicas in another store, delta logs that carry their triples; undo over the change log." ;
    ui:ivl-bench "The workbench's Follow updates maintains its query as a view; a Plan tab shows how." ;
    ui:ivl-rules "Phase 3: SPARQL rules re-run from their own patterns (an engine option for now: a priority change no longer re-runs a todo's rendering); a rule can be a maintained view (iv:strategy iv:Incremental); a persistence policy can be a view (the change log's is), and a write stores the change." ;
    ui:ivl-demand "iv:whileShown: hidden views idle, rebuilt when shown." ;
    ui:ivl-see "Plans, figures, per-step logs and from-scratch checks, as graph data." ;
    ui:ivl-example "The Warehouse example: stock, a reorder list (HAVING) and best sellers of the last hour (a window and a top five), each tile with what its last change cost against a recount." ;
    ui:ivl-joins "Phase 2: a SPARQL parser; partitions with exact dependencies (joins outside the member, OPTIONAL, EXISTS, MINUS, UNION, VALUES); DISTINCT, HAVING, top-k; parameters, a view per instance, views over views; rows as a result set." ;
    ui:ivl-grid "The data grid's window as three views per grid." ;
    ui:ivl-charts "Charts, tables, stats and facet counts read maintained views' rows: the dashboard, the activity example, the performance page." ;
    ui:ivl-rest "The rest of phase 2: aggregate subqueries as views inside the view; the performance page's judgements as maintained findings, live during a run; the toast region's newest announcements as a top-k over the change log; MIN and MAX in an ordered tree; parameters retuned in place." .
ui:ivl-rest rdfs:label "Subqueries and findings" .
ui:ivl-rules rdfs:label "Rules" . ui:ivl-time rdfs:label "Time" . ui:ivl-delta rdfs:label "Delta logs" . ui:ivl-bench rdfs:label "Workbench" .
ui:doc-iv-landed-items ui:ivl-sparql "Phase 5, the rest of SPARQL: correlated subqueries and LATERAL, anchored and zero-length paths, GRAPH, GROUP_CONCAT, SAMPLE, GROUP BY an expression, EXISTS and aggregates in any expression; incremental W3C conformance (484 tests, every fallback listed); the Activity tool's and the data grid's full SPARQL rules run as views and match from scratch." .
ui:ivl-sparql rdfs:label "All of SPARQL" .
ui:ivl-joins rdfs:label "Joins and order" . ui:ivl-grid rdfs:label "Data grid" . ui:ivl-charts rdfs:label "Charts and tables" .
ui:ivl-ticks rdfs:label "Ticks" . ui:ivl-agg rdfs:label "Aggregates" . ui:ivl-uses rdfs:label "In use" .
ui:ivl-window rdfs:label "Windows" . ui:ivl-demand rdfs:label "Demand" . ui:ivl-see rdfs:label "Inspection" . ui:ivl-example rdfs:label "Example" .
ui:doc-iv-pending-h a c:Heading ; c:level 3 ; c:label "Pending" .
ui:doc-iv-pending a c:DescriptionList ; c:of ui:doc-iv-pending-items ; c:fields ( ui:ivp-2 ui:ivp-3 ui:ivp-6 ) .
ui:doc-iv-pending-items ui:ivp-2 "Charts' and tables' renderings in SPARQL over the rows (with the SPARQL coverage work); the engine's parser behind the view compiler once main has its algebra." ;
    ui:ivp-3 "Exact dependencies as the engine's default, once their probes are cheaper; then sem:follows and sem:watches deleted from SPARQL rules." ;
    ui:ivp-6 "The operators in Rust inside Semblance's engine, if profiling shows the runtime dominating." .
ui:ivp-2 rdfs:label "Phase 2: the rest" . ui:ivp-3 rdfs:label "Phase 3: the rest" .
ui:ivp-6 rdfs:label "Phase 6: engine" .
ui:doc-iv-gaps a c:Text ; sty:tone sty:Neutral ; c:label "Known gaps today: NOW(), RAND() and RDF 1.2 triple terms are recomputed (docs/IVM-CONFORMANCE.md lists every fallback); SPARQL views still run a few store queries per step (a partition's evaluation); rules find a view's output through sem:follows or sem:readsMinted unless the engine's exact dependencies are on (an option for now: their probes cost about 50 µs each)." .
ui:doc-iv-more a c:Text ; c:label "docs/IVM.md in the repository has the full design, the decisions taken, what was built and where it differs, and the measurements." .

# --- Tools ---
ui:doc-tools a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-to-h ui:doc-to-1 ui:doc-to-keys ui:doc-to-2 ) .
ui:doc-to-h a c:Heading ; c:level 1 ; c:label "Tools" .
ui:doc-to-1 a c:Text ; c:label "The tools are on every page, in a window docked to the bottom: the Inspector (the rendered element, its provenance and the rule that made it, for whatever you hover), a SPARQL workbench over the live graph, Activity and the Change log, and the Engine (store, rule implementations, layers). Each tab can be torn off into its own window." .
ui:doc-to-keys a c:DescriptionList ; c:of ui:doc-to-key-items ; c:fields ( ui:k-tools ui:k-here ui:k-pause ui:k-off ui:k-private ) .
ui:doc-to-key-items ui:k-tools "⌘. - open or close the tools" ; ui:k-here "⌘Z - inspect what is under the pointer, in a window, paused" ;
    ui:k-pause "Z - pause or resume the inspector" ; ui:k-off "⇧Z - turn the inspector off or on" ; ui:k-private "⌘⇧H - private mode" .
ui:k-tools rdfs:label "Tools" . ui:k-here rdfs:label "Inspect here" . ui:k-pause rdfs:label "Pause" . ui:k-off rdfs:label "Off" . ui:k-private rdfs:label "Private" .
ui:doc-to-2 a c:Text ; c:label "Below every page, the status bar shows what the last interaction cost - rule runs, DOM operations, milliseconds - and what memory holds." .

# --- Performance (live) ---
ui:doc-performance a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-pf-h ui:doc-pf-1 ui:performance ) .
ui:doc-pf-h a c:Heading ; c:level 1 ; c:label "Performance" .
ui:doc-pf-1 a c:Text ; c:label "Run the benchmark matrix in your browser. Each cell becomes a sosa:Observation; every chart below is a SPARQL view over them and every insight a SPARQL judgement - turn a card over to see its query." .
ui:doc-performance sem:warm sem:OnIntent .
