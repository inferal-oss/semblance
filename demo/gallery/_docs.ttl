@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix ui: <https://semblance.dev/demo#> .

# The docs: a navigation list of sections and one page per section. Each page is
# text and code built from the same components as everything else; the Performance
# section is live (the benchmark matrix runs here and its charts are SPARQL views).

ui:docSection rdfs:label "Docs" ; rdfs:range ui:DocSection .
ui:DocOverview a ui:DocSection ; rdfs:label "Overview" ; sem:order 1 ; ui:key "overview" .
ui:DocStart a ui:DocSection ; rdfs:label "Getting started" ; sem:order 2 ; ui:key "start" .
ui:DocRecipes a ui:DocSection ; rdfs:label "Recipes" ; sem:order 3 ; ui:key "recipes" .
ui:DocComponents a ui:DocSection ; rdfs:label "Building components" ; sem:order 4 ; ui:key "components" .
ui:DocIntegrate a ui:DocSection ; rdfs:label "Integrating" ; sem:order 5 ; ui:key "integrate" .
ui:DocRules a ui:DocSection ; rdfs:label "Rules and the engine" ; sem:order 6 ; ui:key "rules" .
ui:DocLayers a ui:DocSection ; rdfs:label "Layers" ; sem:order 7 ; ui:key "layers" .
ui:DocBehaviour a ui:DocSection ; rdfs:label "Behaviour and events" ; sem:order 8 ; ui:key "behaviour" .
ui:DocStyling a ui:DocSection ; rdfs:label "Styling and themes" ; sem:order 9 ; ui:key "styling" .
ui:DocPersistence a ui:DocSection ; rdfs:label "Persistence" ; sem:order 10 ; ui:key "persistence" .
ui:DocNavigation a ui:DocSection ; rdfs:label "Navigation" ; sem:order 11 ; ui:key "navigation" .
ui:DocViews a ui:DocSection ; rdfs:label "Maintained views" ; sem:order 12 ; ui:key "views" .
ui:DocTools a ui:DocSection ; rdfs:label "Tools" ; sem:order 13 ; ui:key "tools" .
ui:DocPerformance a ui:DocSection ; rdfs:label "Performance" ; sem:order 14 ; ui:key "performance" .

ui:docs a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-6 ; pos:inset tok:space-5 ;
    c:children ( ui:docsNav ui:docPages ) .
ui:docsNav a c:NavList ; c:controls ui:app ; c:property ui:docSection ; c:label "Docs" ; c:compactAs c:Picker .
ui:docPages a c:Switch ; c:controls ui:app ; c:property ui:docSection ;
    c:cases ( ui:dcs-overview ui:dcs-start ui:dcs-recipes ui:dcs-components ui:dcs-integrate ui:dcs-rules ui:dcs-layers ui:dcs-behaviour ui:dcs-styling ui:dcs-persistence ui:dcs-navigation ui:dcs-views ui:dcs-tools ui:dcs-performance ) .
ui:dcs-overview c:when ui:DocOverview ; c:content ui:doc-overview .
ui:dcs-start c:when ui:DocStart ; c:content ui:doc-start .
ui:dcs-recipes c:when ui:DocRecipes ; c:content ui:doc-recipes .
ui:dcs-components c:when ui:DocComponents ; c:content ui:doc-components .
ui:dcs-integrate c:when ui:DocIntegrate ; c:content ui:doc-integrate .
ui:dcs-rules c:when ui:DocRules ; c:content ui:doc-rules .
ui:dcs-layers c:when ui:DocLayers ; c:content ui:doc-layers .
ui:dcs-behaviour c:when ui:DocBehaviour ; c:content ui:doc-behaviour .
ui:dcs-styling c:when ui:DocStyling ; c:content ui:doc-styling .
ui:dcs-persistence c:when ui:DocPersistence ; c:content ui:doc-persistence .
ui:dcs-navigation c:when ui:DocNavigation ; c:content ui:doc-navigation .
ui:dcs-views c:when ui:DocViews ; c:content ui:doc-views .
ui:dcs-tools c:when ui:DocTools ; c:content ui:doc-tools .
ui:dcs-performance c:when ui:DocPerformance ; c:content ui:doc-performance .

# --- Overview ---
ui:doc-overview a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-ov-h ui:doc-ov-1 ui:doc-ov-2 ui:doc-ov-code ui:doc-ov-3 ui:doc-ov-pipeline ui:doc-ov-4 ) .
ui:doc-ov-h a c:Heading ; c:level 1 ; c:label "Overview" .
ui:doc-ov-1 a c:Text ; c:label "Semblance describes a user interface as an RDF graph. The framework is a set of ontologies - components, layers, styles, behaviour - and an engine that projects a graph through rules into RDF/HTML, which a renderer patches into the DOM (or serializes as HTML or text)." .
ui:doc-ov-2 a c:Text ; c:label "Your application is data: instances of component classes, wired to your own vocabulary. A button is a resource with a label; a list is a resource that names the property it shows; a page is a switch over a property of your app." .
ui:doc-ov-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:page a c:Stack ; c:children ( ex:title ex:todos ex:add ) .
ex:title a c:Heading ; c:label "Todos" .
ex:todos a c:List ; c:of ex:inbox ; c:item ex:item ; c:orderBy ex:created .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .""" .
ui:doc-ov-3 a c:Text ; c:label "Rules turn that graph into a projection. Each rule is itself a resource - a SPARQL CONSTRUCT, or a function registered under a name - so the whole pipeline can be queried. The pipeline:" .
ui:doc-ov-pipeline a c:Code ; c:block true ; c:label """component graph  ──►  rules (SPARQL | functions), stratified  ──►  RDF/HTML projection
                                                                         ├─► DOM (keyed patching)
                                                                         ├─► HTML (server-side)
                                                                         └─► text
DOM interaction ──► RDF event ──► reactions (CONSTRUCT pairs) ──► one delta ──► change log (LDES)""" .
ui:doc-ov-4 a c:Text ; c:children ( "Everything you see on this site is built that way, including this page and the tools (" ui:doc-ov-kbd " opens them). The " ui:doc-ov-examples " show complete applications; the " ui:doc-ov-components " page shows every component on its own." ) .
ui:doc-ov-kbd a c:Kbd ; c:keys ( "⌘" "." ) .
ui:doc-ov-examples a c:Link , c:Setter ; c:label "examples" ; c:href "#examples" ; c:controls ui:app ; c:property ui:page ; c:value ui:Examples .
ui:doc-ov-components a c:Link , c:Setter ; c:label "components" ; c:href "#components" ; c:controls ui:app ; c:property ui:page ; c:value ui:Components .

# --- Getting started ---
# Every step that shows Turtle shows it live (c:LiveExample, ontology/components/live.ttl): the
# source in an editor beside its rendering, in a sandbox of its own. The last step's sources are
# examples/hello, less the prefixes Semblance declares (test/live-example.test.ts checks it).
ui:doc-start a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-gs-h ui:doc-gs-1 ui:doc-gs-install ui:doc-gs-2 ui:doc-gs-vite ui:doc-gs-3 ui:gs-page ui:doc-gs-3b ui:doc-gs-4 ui:doc-gs-mount ui:doc-gs-5 ui:gs-tally ui:doc-gs-5b ui:doc-gs-6 ui:gs-react ui:doc-gs-7 ) .
ui:doc-gs-h a c:Heading ; c:level 1 ; c:label "Getting started" .
ui:doc-gs-1 a c:Text ; c:label "Semblance is the npm package @inferal-oss/semblance (not published yet: until it is, use a checkout of the repository, or npm pack it). It ships TypeScript, its ontologies and its WebAssembly engines, built by your bundler - today Vite." .
ui:doc-gs-install a c:Code ; c:block true ; c:label """npm install @inferal-oss/semblance
npm install --save-dev vite""" .
ui:doc-gs-2 a c:Text ; c:label "The package finds its ontology files and engine builds with import.meta.glob, so Vite must not pre-bundle it; its Turtle parser, N3, is CommonJS and must be pre-bundled:" .
ui:doc-gs-vite a c:Code ; c:block true ; c:label """// vite.config.ts
export default defineConfig({
  optimizeDeps: {
    exclude: ['@inferal-oss/semblance', 'oxigraph'],
    include: ['@inferal-oss/semblance > n3'],
  },
})""" .
ui:doc-gs-3 a c:Text ; c:label "The interface is data. A page in Turtle, beside what it renders: edit it, and the rendering follows as you type." .
ui:doc-gs-3b a c:Text ; c:label "Each example here runs in a sandbox of its own: its own graph, rules and events, so an edit that does not parse only shows where it went wrong, beside the last rendering that worked. Semblance's prefixes (c:, sty:, pos:, tok:, beh: and the rest) are declared for the examples; Copy puts them in front of the source, so what you paste is a complete file." .
ui:doc-gs-4 a c:Text ; c:label "In your app the page is a file, app.ttl, and mount shows it. mount loads a store with Semblance's ontologies and your graphs, compiles the theme, projects the root, patches it into the element and routes its events to reactions:" .
ui:doc-gs-mount a c:Code ; c:block true ; c:label """import { mount } from '@inferal-oss/semblance/web'
import app from './app.ttl?raw'
import tally from './tally.ttl?raw'

await mount(document.getElementById('app')!, { root: 'https://example.org/hello#page', graphs: [tally, app] })""" .
ui:doc-gs-5 a c:Text ; c:label "A component of your own is an OWL class under sem:Component, a rendering slot that targets it, and a SPARQL rule that builds RDF/HTML for each instance ($this), minting every node from it. Here ex:Tally (tally.ttl) is used by the page (app.ttl): change the rule or the style rules and the page renders with them." .
ui:doc-gs-5b a c:Text ; c:label "Its shape says what an instance must say: take the label off ex:cups and the shapes layer outlines it and says why. Building components goes further: containers, lists, text output, layers, and when (rarely) to write a rule as a function." .
ui:doc-gs-6 a c:Text ; c:label "State is triples too, and events change it through reactions: a reaction names the event and its source and says what to delete and what to insert, as CONSTRUCTs over $this and $event. Click Have another: the reaction runs in the example's graph, and only what depends on the change is rendered again." .
ui:doc-gs-7 a c:Text ; c:children ( "The complete example is examples/hello in the repository, and docs/GETTING-STARTED.md walks through it, including rendering on the server. " ui:doc-gs-recipes " has more small examples, each live." ) .
ui:doc-gs-recipes a c:Link , c:Setter ; c:label "Recipes" ; c:href "#docs/recipes" ; c:controls ui:app ; c:property ui:docSection ; c:value ui:DocRecipes .

ui:gs-page a c:LiveExample ; c:label "A page" ; c:exampleRoot <https://example.org/hello#page> ; c:sources ( ui:gs-page-app ) .
ui:gs-page-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .''' .

ui:gs-tally a c:LiveExample ; c:label "A component of your own" ; c:exampleRoot <https://example.org/hello#page> ;
    c:sources ( ui:gs-tally-def ui:gs-tally-app ) ; c:selectedSource ui:gs-tally-def .
ui:gs-tally-def a c:CodeEditor ; c:language "turtle" ; c:label "tally.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# A component of our own: a figure with its label and unit. One class, one rendering slot, one
# SPARQL rule for it, a shape for what an instance must say, and how it looks.

ex:Tally a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:comment "A figure (c:value) with its label (c:label) and an optional unit (ex:unit)."@en ;
    sem:slug "ex-tally" .
ex:unit a owl:DatatypeProperty ; rdfs:domain ex:Tally .

ex:TallyRendering a sem:Rendering ; sem:targets ex:Tally ; sem:stratum 0 .
ex:TallyRendering-sparql a sem:Rule ;
    sem:implements ex:TallyRendering ;
    sem:construct """
PREFIX ex: <https://example.org/hello#>
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?figure .
  ?name a rdfhtml:Span ; rdfhtml:class "ex-tally-label" ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?figure .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?figure a rdfhtml:Strong ; rdfhtml:hasChild ?figureText .
  ?figureText a rdfhtml:Text ; rdfhtml:data ?shown .
}
WHERE {
  $this a ex:Tally ; c:label ?label .
  OPTIONAL { $this c:value ?value }
  OPTIONAL { $this ex:unit ?unit }
  BIND(CONCAT(STR(COALESCE(?value, 0)), IF(BOUND(?unit), CONCAT(" ", ?unit), "")) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~figure")) AS ?figure)
  BIND(IRI(CONCAT(STR($this), "/~figure-text")) AS ?figureText)
}""" .

ex:TallyShape a sh:NodeShape ; sh:targetClass ex:Tally ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A tally needs a label (c:label): say what the figure is." ] ,
                [ sh:path c:value ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

[] a sty:StyleRule ; sty:appliesTo ex:Tally ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part "> strong" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-2xl ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part ".ex-tally-label" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] .''' .
ui:gs-tally-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:cups ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:cups a ex:Tally ; c:label "Coffee today" ; c:value 0 ; ex:unit "cups" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .''' .

ui:gs-react a c:LiveExample ; c:label "State and reactions" ; c:exampleRoot <https://example.org/hello#page> ;
    c:sources ( ui:gs-react-def ui:gs-react-app ) ; c:selectedSource ui:gs-react-app .
ui:gs-react-def a c:CodeEditor ; c:language "turtle" ; c:label "tally.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# A component of our own: a figure with its label and unit. One class, one rendering slot, one
# SPARQL rule for it, a shape for what an instance must say, and how it looks.

ex:Tally a owl:Class ;
    rdfs:subClassOf sem:Component ;
    rdfs:comment "A figure (c:value) with its label (c:label) and an optional unit (ex:unit)."@en ;
    sem:slug "ex-tally" .
ex:unit a owl:DatatypeProperty ; rdfs:domain ex:Tally .

ex:TallyRendering a sem:Rendering ; sem:targets ex:Tally ; sem:stratum 0 .
ex:TallyRendering-sparql a sem:Rule ;
    sem:implements ex:TallyRendering ;
    sem:construct """
PREFIX ex: <https://example.org/hello#>
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?figure .
  ?name a rdfhtml:Span ; rdfhtml:class "ex-tally-label" ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?figure .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?figure a rdfhtml:Strong ; rdfhtml:hasChild ?figureText .
  ?figureText a rdfhtml:Text ; rdfhtml:data ?shown .
}
WHERE {
  $this a ex:Tally ; c:label ?label .
  OPTIONAL { $this c:value ?value }
  OPTIONAL { $this ex:unit ?unit }
  BIND(CONCAT(STR(COALESCE(?value, 0)), IF(BOUND(?unit), CONCAT(" ", ?unit), "")) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~figure")) AS ?figure)
  BIND(IRI(CONCAT(STR($this), "/~figure-text")) AS ?figureText)
}""" .

ex:TallyShape a sh:NodeShape ; sh:targetClass ex:Tally ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A tally needs a label (c:label): say what the figure is." ] ,
                [ sh:path c:value ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

[] a sty:StyleRule ; sty:appliesTo ex:Tally ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part "> strong" ;
    sty:declares [ sty:property "font-size" ; sty:token tok:text-2xl ] .
[] a sty:StyleRule ; sty:appliesTo ex:Tally ; sty:part ".ex-tally-label" ;
    sty:declares [ sty:property "color" ; sty:token tok:muted ] .''' .
ui:gs-react-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/hello#> .

# The app: built-in components and ours, in one graph.

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-6 ;
    c:children ( ex:title ex:cups ex:drink ) .
ex:title a c:Heading ; c:level 1 ; c:label "Hello, Semblance" .
ex:cups a ex:Tally ; c:label "Coffee today" ; c:value 0 ; ex:unit "cups" .
ex:drink a c:Button ; c:label "Have another" ; sty:intent sty:Primary .

# What a click on the button means: one more cup. Delete the old value, insert the new one.
ex:Drink a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:drink ;
    beh:deletes """PREFIX ex: <https://example.org/hello#>
CONSTRUCT { ex:cups c:value ?n } WHERE { ex:cups c:value ?n }""" ;
    beh:inserts """PREFIX ex: <https://example.org/hello#>
CONSTRUCT { ex:cups c:value ?next } WHERE { ex:cups c:value ?n BIND(?n + 1 AS ?next) }""" .''' .

# --- Recipes ---
# Small examples, each live (c:LiveExample) and each a sentence or two. Their queries name the
# example's own prefix through sh:declare (sh:prefix, sh:namespace), which every rule and reaction
# of the graph then knows.
ui:doc-recipes a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-rc-h ui:doc-rc-1
                 ui:doc-rc-mirror-h ui:doc-rc-mirror ui:rc-mirror
                 ui:doc-rc-valid-h ui:doc-rc-valid ui:rc-valid
                 ui:doc-rc-list-h ui:doc-rc-list ui:rc-list
                 ui:doc-rc-theme-h ui:doc-rc-theme ui:rc-theme
                 ui:doc-rc-text-h ui:doc-rc-text ui:rc-text
                 ui:doc-rc-l10n-h ui:doc-rc-l10n ui:doc-rc-language ui:rc-l10n ) .
ui:doc-rc-h a c:Heading ; c:level 1 ; c:label "Recipes" .
ui:doc-rc-1 a c:Text ; c:label "Small things, each a few lines of Turtle you can edit beside what they render. Their queries use the example's own prefix, declared once for every rule and reaction in the graph the SHACL way (sh:declare, with sh:prefix and sh:namespace); Semblance's own are known already." .

ui:doc-rc-mirror-h a c:Heading ; c:level 2 ; c:label "A field mirrored into a heading" .
ui:doc-rc-mirror a c:Text ; c:label "Typing is an event too (beh:Input), and $event beh:value is what the field holds now. Beside the field's own reaction, which keeps its c:value, ours rewrites the heading's label." .
ui:rc-mirror a c:LiveExample ; c:label "A field mirrored into a heading" ; c:exampleRoot <https://example.org/mirror#page> ; c:sources ( ui:rc-mirror-app ) .
ui:rc-mirror-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/mirror#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/mirror#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:greeting ex:name ) .
ex:greeting a c:Heading ; c:level 2 ; c:label "Hello, stranger" .
ex:name a c:TextField ; c:label "Your name" ; c:placeholder "Ada" .

ex:Mirror a beh:Reaction ;
    beh:when beh:Input ; beh:source ex:name ;
    beh:deletes """CONSTRUCT { ex:greeting c:label ?old } WHERE { ex:greeting c:label ?old }""" ;
    beh:inserts """CONSTRUCT { ex:greeting c:label ?greeting } WHERE {
  $event beh:value ?typed .
  BIND(CONCAT("Hello, ", IF(STRLEN(?typed) > 0, ?typed, "stranger")) AS ?greeting)
}""" .''' .

ui:doc-rc-valid-h a c:Heading ; c:level 2 ; c:label "Save only what is valid" .
ui:doc-rc-valid a c:Text ; c:label "A field points at a SHACL property shape (val:validates); the validation layer derives its error from the shape and its message. A button that val:requires the field stays disabled until it conforms, so the Save reaction only ever sees a valid address." .
ui:rc-valid a c:LiveExample ; c:label "Save only what is valid" ; c:exampleRoot <https://example.org/signup#page> ; c:sources ( ui:rc-valid-app ) .
ui:rc-valid-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/signup#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/signup#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:email ex:save ex:saved ) .
ex:email a c:TextField ; c:label "Email" ; c:placeholder "you@example.org" ;
    val:validates ex:EmailShape .
ex:save a c:Button ; c:label "Save" ; sty:intent sty:Primary ; val:requires ( ex:email ) .
ex:saved a c:Text ; c:label "Nothing saved yet." .

ex:EmailShape a sh:PropertyShape ; sh:path c:value ; sh:minCount 1 ;
    sh:pattern "^[^@ ]+@[^@ ]+[.][^@ ]+$" ;
    sh:message "Enter an address like you@example.org." .

ex:Save a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:save ;
    beh:deletes """CONSTRUCT { ex:saved c:label ?old } WHERE { ex:saved c:label ?old }""" ;
    beh:inserts """CONSTRUCT { ex:saved c:label ?done } WHERE {
  ex:email c:value ?email BIND(CONCAT("Saved ", ?email, ".") AS ?done)
}""" .''' .

ui:doc-rc-list-h a c:Heading ; c:level 2 ; c:label "A list bound to data" .
ui:doc-rc-list a c:Text ; c:label "A c:List shows data items (c:item), sorted by one of their properties, with a checkbox for another. Adding mints a new item from the event, so each is its own resource; removing deletes the items and their triples. Each item renders on its own, so a change touches only it." .
ui:rc-list a c:LiveExample ; c:label "A list bound to data" ; c:exampleRoot <https://example.org/groceries#page> ; c:sources ( ui:rc-list-app ) .
ui:rc-list-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/groceries#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/groceries#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:list ex:new ex:actions ) .
ex:list a c:List ; c:label "Groceries" ; c:sortBy ex:added ;
    c:itemLabel rdfs:label ; c:itemChecked ex:got ;
    c:item ex:bread , ex:milk .
ex:bread rdfs:label "Bread" ; ex:added 1 ; ex:got false .
ex:milk rdfs:label "Milk" ; ex:added 2 ; ex:got true .
ex:new a c:TextField ; c:label "Something else" ; c:placeholder "Apples" .
ex:actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ; c:children ( ex:add ex:clear ) .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .
ex:clear a c:Button ; c:label "Remove what we got" .

ex:Add a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:add ;
    beh:deletes """CONSTRUCT { ex:new c:value ?v } WHERE { ex:new c:value ?v }""" ;
    beh:inserts """CONSTRUCT { ex:list c:item ?item . ?item rdfs:label ?v ; ex:added ?next ; ex:got false }
WHERE {
  ex:new c:value ?v FILTER(STRLEN(?v) > 0)
  BIND(IRI(CONCAT(STR(ex:), "item-", STRAFTER(STR($event), "urn:semblance:event:"))) AS ?item)
  { SELECT (COALESCE(MAX(?n), 0) + 1 AS ?next) WHERE { ?any ex:added ?n } }
}""" .
ex:Clear a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:clear ;
    beh:deletes """CONSTRUCT { ex:list c:item ?item . ?item ?p ?o }
WHERE { ex:list c:item ?item . ?item ex:got true ; ?p ?o }""" .''' .

ui:doc-rc-theme-h a c:Heading ; c:level 2 ; c:label "A theme for part of a page" .
ui:doc-rc-theme a c:Text ; c:label "sty:theme on any component re-values every token under it, so the nearest theme wins, even inside another. The segmented control writes that one triple; tones (sty:tone) keep their meaning in every theme. Doodle and Classic rebuild the controls, not only their colours." .
ui:rc-theme a c:LiveExample ; c:label "A theme for part of a page" ; c:exampleRoot <https://example.org/themes#page> ; c:sources ( ui:rc-theme-app ) .
ui:rc-theme-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/themes#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:pick ex:card ) .
ex:pick a c:Segmented ; c:label "Theme" ; c:controls ex:card ; c:property sty:theme ;
    c:options ( sty:Semblance sty:Terminal sty:Doodle sty:Classic ) .
ex:card a c:Surface ; sty:theme sty:Terminal ; sty:elevation sty:Raised ;
    pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ex:title ex:state ex:go ) .
ex:title a c:Heading ; c:level 3 ; c:label "Release 1.4" .
ex:state a c:Badge ; c:label "Checks passed" ; sty:tone sty:Success .
ex:go a c:Button ; c:label "Ship it" ; sty:intent sty:Primary .''' .

ui:doc-rc-text-h a c:Heading ; c:level 2 ; c:label "A component that renders as text too" .
ui:doc-rc-text a c:Text ; c:label "A projection has a modality. A rule that applies to one says so (sem:modality); write one per modality the component makes sense in. This meter is a bar on screen and a row of blocks in the Text modality, shown under the screen here: the same graph, the same click, two renderings." .
ui:rc-text a c:LiveExample ; c:label "A component that renders as text too" ; c:exampleRoot <https://example.org/meter#page> ; c:textPreview true ;
    c:sources ( ui:rc-text-def ui:rc-text-app ) ; c:selectedSource ui:rc-text-def .
ui:rc-text-def a c:CodeEditor ; c:language "turtle" ; c:label "meter.ttl" ; c:original '''@prefix ex: <https://example.org/meter#> .

ex:Meter a owl:Class ; rdfs:subClassOf sem:Component ; sem:slug "ex-meter" .
ex:MeterRendering a sem:Rendering ; sem:targets ex:Meter ; sem:stratum 0 .

# On screen: the label, and a bar as long as the value (out of 10).
ex:MeterRendering-screen a sem:Rule ; sem:implements ex:MeterRendering ; sem:modality mod:Screen ;
    sem:construct """
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?bar .
  ?name a rdfhtml:Span ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?bar .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?bar a rdfhtml:Span ; rdfhtml:class "ex-meter-bar" ; rdfhtml:style ?width .
}
WHERE {
  $this a ex:Meter ; c:label ?label ; c:value ?n .
  BIND(CONCAT("--level: ", STR(?n * 10), "%") AS ?width)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  BIND(IRI(CONCAT(STR($this), "/~name-text")) AS ?nameText)
  BIND(IRI(CONCAT(STR($this), "/~bar")) AS ?bar)
}""" .

# In text: one line of blocks.
ex:MeterRendering-text a sem:Rule ; sem:implements ex:MeterRendering ; sem:modality mod:Text ;
    sem:construct """
CONSTRUCT { ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?line . ?line a rdfhtml:Text ; rdfhtml:data ?shown . }
WHERE {
  $this a ex:Meter ; c:label ?label ; c:value ?n .
  BIND(CONCAT(?label, "  ", SUBSTR("##########", 1, ?n), SUBSTR("..........", 1, 10 - ?n), "  ", STR(?n), "/10") AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~line")) AS ?line)
}""" .

[] a sty:StyleRule ; sty:appliesTo ex:Meter ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] , [ sty:property "gap" ; sty:token tok:space-1 ] .
[] a sty:StyleRule ; sty:appliesTo ex:Meter ; sty:part ".ex-meter-bar" ;
    sty:declares [ sty:property "height" ; sty:raw "8px" ] ,
                 [ sty:property "width" ; sty:raw "var(--level)" ] ,
                 [ sty:property "border-radius" ; sty:token tok:radius-full ] ,
                 [ sty:property "background" ; sty:token tok:accent ] ,
                 [ sty:property "transition" ; sty:raw "width var(--sem-duration) var(--sem-ease)" ] .''' .
ui:rc-text-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/meter#> .
ex:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/meter#"^^xsd:anyURI ] .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:volume ex:louder ) .
ex:volume a ex:Meter ; c:label "Volume" ; c:value 3 .
ex:louder a c:Button ; c:label "Louder" .

ex:Louder a beh:Reaction ;
    beh:when beh:Click ; beh:source ex:louder ;
    beh:deletes """CONSTRUCT { ex:volume c:value ?n } WHERE { ex:volume c:value ?n }""" ;
    beh:inserts """CONSTRUCT { ex:volume c:value ?next } WHERE { ex:volume c:value ?n BIND((?n + 1) - 11 * FLOOR((?n + 1) / 11) AS ?next) }""" .''' .

ui:doc-rc-l10n-h a c:Heading ; c:level 2 ; c:label "Labels in the viewer's language" .
ui:doc-rc-l10n a c:Text ; c:label "A label is the untagged source text plus its translations, as language-tagged literals; the localization layer picks the one in the viewer's language, else the source. The examples render in this site's language: choose another here (it is the site's own setting, also among the display settings of the Components page) and the labels follow; Arabic turns the page right to left." .
ui:doc-rc-language a c:Segmented ; c:label "Language" ; c:controls ui:app ; c:property l10n:language .
ui:rc-l10n a c:LiveExample ; c:label "Labels in the viewer's language" ; c:exampleRoot <https://example.org/greeting#page> ; c:sources ( ui:rc-l10n-app ) .
ui:rc-l10n-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/greeting#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ex:title ex:name ex:save ) .
ex:title a c:Heading ; c:level 2 ;
    c:label "Good morning" , "Доброго ранку"@uk , "Guten Morgen"@de , "صباح الخير"@ar .
ex:name a c:TextField ;
    c:label "Name" , "Ім’я"@uk , "Name"@de , "الاسم"@ar ;
    c:placeholder "Ada" .
ex:save a c:Button ; sty:intent sty:Primary ;
    c:label "Save" , "Зберегти"@uk , "Speichern"@de , "حفظ"@ar .''' .

# Edits of the examples are remembered for this tab, with the source each shows.
ui:rememberLiveExamples a per:Policy ; per:scope per:Session ;
    rdfs:label "The live examples' edits" , "Зміни в живих прикладах"@uk , "Änderungen an den Live-Beispielen"@de , "تعديلات الأمثلة الحية"@ar ;
    per:construct """
CONSTRUCT { ?editor c:value ?text . ?example c:selectedSource ?shown }
WHERE {
  ?example a c:LiveExample .
  { ?example c:sources/rdf:rest*/rdf:first ?editor . ?editor c:value ?text }
  UNION { ?example c:selectedSource ?shown }
}""" .

# --- Building components ---
ui:doc-components a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-cp-h ui:doc-cp-1 ui:doc-cp-2 ui:doc-cp-code ui:doc-cp-3 ui:doc-cp-rules ui:doc-cp-4 ui:doc-cp-shape ui:doc-cp-5 ui:doc-cp-fn ui:doc-cp-6 ) .
ui:doc-cp-h a c:Heading ; c:level 1 ; c:label "Building components" .
ui:doc-cp-1 a c:Text ; c:label "A component is an OWL class under sem:Component, a rendering slot that targets it (sem:Rendering), and rules that implement the slot. A SHACL shape says what an instance must say; style rules say how it looks in every theme. All of it is Turtle in the same graph as the app that uses it." .
ui:doc-cp-2 a c:Text ; c:label "Write the rule in SPARQL. A SPARQL CONSTRUCT is the implementation: it is data, so it can be inspected (turn a component over, or open the Inspector), queried and run on any store. It builds RDF/HTML for $this, minting every node from it (never blank nodes), so nodes keep their identity and DOM elements are reused:" .
ui:doc-cp-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:Tally a owl:Class ; rdfs:subClassOf sem:Component ;
    sem:slug "ex-tally" .            # data-sem-c="ex-tally": slugs are global, prefix yours
ex:TallyRendering a sem:Rendering ; sem:targets ex:Tally ; sem:stratum 0 .
ex:TallyRendering-sparql a sem:Rule ; sem:implements ex:TallyRendering ;
    sem:construct \"\"\"
CONSTRUCT {
  ?root a rdfhtml:Div ; sem:renders $this ; rdfhtml:hasChild ?name, ?figure .
  ?name a rdfhtml:Span ; rdfhtml:hasChild ?nameText ; ord:immediatelyPrecedes ?figure .
  ?nameText a rdfhtml:Text ; rdfhtml:data ?label .
  ?figure a rdfhtml:Strong ; rdfhtml:hasChild ?figureText .
  ?figureText a rdfhtml:Text ; rdfhtml:data ?shown .
}
WHERE {
  $this a ex:Tally ; c:label ?label .
  OPTIONAL { $this c:value ?value } OPTIONAL { $this ex:unit ?unit }
  BIND(CONCAT(STR(COALESCE(?value, 0)), IF(BOUND(?unit), CONCAT(" ", ?unit), "")) AS ?shown)
  BIND(IRI(CONCAT(STR($this), "/~root")) AS ?root)
  BIND(IRI(CONCAT(STR($this), "/~name")) AS ?name)
  ...
}\"\"\" .""" .
ui:doc-cp-3 a c:Text ; c:label "What makes a rule run again is declared too:" .
ui:doc-cp-rules a c:DescriptionList ; c:of ui:doc-cp-rule-items ; c:fields ( ui:rr-self ui:rr-follows ui:rr-watches ui:rr-requires ui:rr-foreach ui:rr-modality ) .
ui:doc-cp-rule-items ui:rr-self "A change to the component's own triples marks it dirty; the engine diffs the output and patches only what changed." ;
    ui:rr-follows "sem:follows c:of - so do changes to the node it points at." ;
    ui:rr-watches "sem:watches c:value - only these predicates make it dirty." ;
    ui:rr-requires "sem:requires c:icon - skipped for instances without the property." ;
    ui:rr-foreach "sem:forEach c:item - member-wise: once per member, so one item changes alone." ;
    ui:rr-modality "sem:modality mod:Text - a rule for one modality; write one per modality the component renders in." .
ui:rr-self rdfs:label "Its triples" . ui:rr-follows rdfs:label "Follows" . ui:rr-watches rdfs:label "Watches" .
ui:rr-requires rdfs:label "Requires" . ui:rr-foreach rdfs:label "For each" . ui:rr-modality rdfs:label "Modality" .
ui:doc-cp-4 a c:Text ; c:label "What an instance must say is a SHACL shape on the class. The shapes layer validates every component as it renders, outlines the ones that do not conform and lists them." .
ui:doc-cp-shape a c:Code ; c:block true ; c:language "turtle" ; c:label """ex:TallyShape a sh:NodeShape ; sh:targetClass ex:Tally ;
    sh:property [ sh:path c:label ; sh:minCount 1 ; sh:message "A tally needs a label (c:label)." ] .""" .
ui:doc-cp-5 a c:Text ; c:label "A rule can also be a function registered under a name (sem:function). Functions are an escape hatch for the rare step SPARQL cannot express - and first look for a building block that puts the missing input in the graph - and an oracle: a function twin renders the identical HTML, faster, and the tests compare the two after every step. A component without a SPARQL rule is incomplete." .
ui:doc-cp-fn a c:Code ; c:block true ; c:label """// A function twin: same nodes, same IRIs, same HTML (the parity tests check it).
const tally: FnRule = (ctx, focus) => {
  const o = ctx.out(focus)
  const label = text(ctx, focus, C.label)
  if (label === undefined) return []
  const shown = String(Number(ctx.object(focus, C.value)?.value ?? 0)) + ...
  o.renders(o.el('root', 'Div', {}, [o.el('name', 'Span', {}, [o.text('name-text', label)]), o.el('figure', 'Strong', {}, [o.text('figure-text', shown)])]))
  return o.quads
}""" .
ui:doc-cp-6 a c:Text ; c:label "Components come in groups - layout, type, actions, inputs, feedback, data, navigation, overlays, disclosure, windows - each one file of vocabulary, one of styles, one of function twins and one gallery page. docs/COMPONENTS.md in the repository has the details." .

# --- Integrating ---
ui:doc-integrate a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-in-h ui:doc-in-1 ui:doc-in-code ui:doc-in-list ) .
ui:doc-in-h a c:Heading ; c:level 1 ; c:label "Integrating" .
ui:doc-in-1 a c:Text ; c:label "mount is the short way. The pieces it wires, for when you need them yourself:" .
ui:doc-in-code a c:Code ; c:block true ; c:label """await initWeb('wat')
const store = loadStore('wat', components, app)    // Semblance's ontology + yours
const runtime = new Runtime(store)                   // one graph, many projections
const screen = runtime.project({ modality: MOD.Screen, layers, roots: [root] })
const renderer = new DomRenderer(screen.index, element, root)
renderer.flush()
new EventBus(runtime, screen).attach(renderer, () => renderer.flush())""" .
ui:doc-in-list a c:DescriptionList ; c:of ui:doc-in-items ; c:fields ( ui:in-data ui:in-proj ui:in-embed ui:in-ssr ui:in-per ui:in-nav ) .
ui:doc-in-items ui:in-data "Change the graph with runtime.apply({ add, remove }) or runtime.transaction(…), then flush; read it with store.match or SPARQL. Keep your data in your own vocabulary and point components at it." ;
    ui:in-proj "runtime.project again for another root or the Text modality; every change reaches all projections once." ;
    ui:in-embed "Mount several roots into an existing page, or mount anything into a component's host-owned slot (c:slot)." ;
    ui:in-ssr "In Node, loadStore from @inferal-oss/semblance/node, project, and toHTML or toText." ;
    ui:in-per "per:Policy nodes say what to remember; attach Persistence before the first projection." ;
    ui:in-nav "nav:Location says which state lives in the address; attach Navigation, and links can point at resources (c:to)." .
ui:in-data rdfs:label "Your data" . ui:in-proj rdfs:label "Projections" . ui:in-embed rdfs:label "Embedding" .
ui:in-ssr rdfs:label "Server" . ui:in-per rdfs:label "Remembering" . ui:in-nav rdfs:label "The address" .

# --- Rules and the engine ---
ui:doc-rules a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-ru-h ui:doc-ru-1 ui:doc-ru-2 ui:doc-ru-3 ui:doc-ru-4 ui:doc-ru-5 ) .
ui:doc-ru-h a c:Heading ; c:level 1 ; c:label "Rules and the engine" .
ui:doc-ru-1 a c:Text ; c:label "Identity. Rules mint IRIs as <focus>/~<local>, never blank nodes, so a node keeps its identity across re-evaluation, its DOM element is reused, and its IRI doubles as an id that labels and descriptions point at." .
ui:doc-ru-2 a c:Text ; c:label "Incrementality. Each (rule, focus) pair owns its output. A change marks pairs dirty through the focus's own triples, sem:follows links and the triples a function read; outputs are diffed and reference-counted. Member-wise rules (sem:forEach) evaluate once per member, so adding a list item touches only that item." .
ui:doc-ru-3 a c:Text ; c:label "Demand. Only what is shown under a projection's roots is evaluated; hidden pages and tabs are parked. sem:warm says what to prepare ahead: sem:Eager in idle time, sem:OnIntent when a choice that would show it is pointed at." .
ui:doc-ru-4 a c:Text ; c:label "Bulk. A SPARQL rule pending for several foci runs once with VALUES when every triple it constructs is attributable to $this. sem:requires skips foci without a property; strata order layers after the components they decorate." .
ui:doc-ru-5 a c:Text ; c:label "Implementations. SPARQL rules are the implementation; function twins render the same HTML, faster, and the tests check that they do after every step. The Engine tool switches between them live, and the Query tool lists renderings missing either side." .

# --- Layers ---
ui:doc-layers a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-la-h ui:doc-la-1 ui:doc-la-list ui:doc-la-2 ) .
ui:doc-la-h a c:Heading ; c:level 1 ; c:label "Layers" .
ui:doc-la-1 a c:Text ; c:label "A layer is a set of rules enabled per projection (sem:enables). Layers decorate what components render without the components knowing:" .
ui:doc-la-list a c:DescriptionList ; c:of ui:doc-la-items ; c:fields ( ui:la-a11y ui:la-style ui:la-l10n ui:la-val ui:la-key ui:la-prv ui:la-per ui:la-docs ) .
ui:doc-la-items ui:la-a11y "ARIA relationships by IRI, roles and live regions." ;
    ui:la-style "Hookable properties become data-sem-* attributes the compiled theme styles." ;
    ui:la-l10n "Language-tagged labels; the viewer's language is a projection setting; RTL flips the page." ;
    ui:la-val "Fields point at SHACL property shapes; errors are derived; buttons wait for valid input." ;
    ui:la-key "Shortcuts on any component, commands that belong to none, arrow-key navigation patterns." ;
    ui:la-prv "prv:concealed masks or blurs any component; prv:sensitive ones hide in private mode (⌘⇧H)." ;
    ui:la-per "Policies say what state to remember, where and for how long." ;
    ui:la-docs "Under each gallery specimen, the ontology of the classes it uses." .
ui:la-a11y rdfs:label "Accessibility" . ui:la-style rdfs:label "Style" . ui:la-l10n rdfs:label "Localization" .
ui:la-val rdfs:label "Validation" . ui:la-key rdfs:label "Keyboard" . ui:la-prv rdfs:label "Privacy" .
ui:la-per rdfs:label "Persistence" . ui:la-docs rdfs:label "Docs" .
ui:doc-la-2 a c:Text ; c:label "Turn any of them off in the Engine tool and the same components render without them." .

# --- Behaviour and events ---
ui:doc-behaviour a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-be-h ui:doc-be-1 ui:doc-be-code ui:doc-be-2 ) .
ui:doc-be-h a c:Heading ; c:level 1 ; c:label "Behaviour and events" .
ui:doc-be-1 a c:Text ; c:label "An interaction becomes an RDF event addressed to the innermost component with a matching reaction. A reaction is a pair of CONSTRUCTs - what to delete, what to insert - over $event and $this. Every matching reaction sees the state before the event, and their union is applied as one change." .
ui:doc-be-code a c:Code ; c:block true ; c:language "turtle" ; c:label """c:CodeInputInput a beh:Reaction ;
    beh:when beh:Input ;
    beh:sourceClass c:CodeInput ;
    beh:deletes \"\"\"CONSTRUCT { $this c:value ?old } WHERE { $this c:value ?old }\"\"\" ;
    beh:inserts \"\"\"CONSTRUCT { $this c:value ?code } WHERE {
      $event beh:value ?typed .
      BIND(SUBSTR(REPLACE(?typed, "[^0-9]", ""), 1, 6) AS ?code) }\"\"\" .""" .
ui:doc-be-2 a c:Text ; c:label "Each event, with the size of the change it caused, becomes an immutable member of the beh:ChangeLog, an LDES stream bounded by its retention policy and linked from its newest member back, so the latest members are read in as many steps. The Change log and Activity tools are views of it." .

# --- Styling and themes ---
ui:doc-styling a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-st-h ui:doc-st-1 ui:doc-st-code ui:doc-st-2 ) .
ui:doc-st-h a c:Heading ; c:level 1 ; c:label "Styling and themes" .
ui:doc-st-1 a c:Text ; c:label "Styles compile from the ontology into cascade layers: tokens become custom properties, hookable properties (tone, emphasis, size, text style, layout) become data-sem-* attributes, and sty:StyleRules declare what each value looks like - once, for every component that has the axis." .
ui:doc-st-code a c:Code ; c:block true ; c:language "turtle" ; c:label """[] a sty:StyleRule ; sty:appliesTo c:CodeInput ; sty:when c:Underlined ;
    sty:part ".sem-code-cell" ;
    sty:declares [ sty:property "border-width" ; sty:raw "0 0 2px" ] .""" .
ui:doc-st-2 a c:Text ; c:label "A theme (sty:theme on any subtree) re-values every token; structural themes add rules narrowed to themselves that rebuild title bars, controls and docks. Contrast, motion and density compose with every theme." .

# --- Persistence ---
ui:doc-persistence a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-pe-h ui:doc-pe-1 ui:doc-pe-code ui:doc-pe-2 ) .
ui:doc-pe-h a c:Heading ; c:level 1 ; c:label "Persistence" .
ui:doc-pe-1 a c:Text ; c:label "What to remember is graph data too: a per:Policy names a subject and properties, or a CONSTRUCT, and a scope - this tab, this device, the browser database. A host effect restores policies before the first render and writes them back in idle time." .
ui:doc-pe-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ui:rememberDisplay a per:Policy ; per:scope per:Session ;
    per:subject ui:shell ;
    per:properties ( mot:preference sty:contrast sty:density sty:theme ) .""" .
ui:doc-pe-2 a c:Text ; c:label "Every write, restore and forget is a member of per:StateLog. On this site the tools, the display settings and the page you were on are remembered for the tab; the change log only if you switch it on." .

# --- Navigation ---
ui:doc-navigation a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-na-h ui:doc-na-1 ui:doc-na-code ui:doc-na-2 ui:doc-na-3 ui:doc-na-4 ui:doc-na-5 ) .
ui:doc-na-h a c:Heading ; c:level 1 ; c:label "Navigation" .
ui:doc-na-1 a c:Text ; c:label "Where we are is graph data. A nav:Location groups the dimensions of one app; each nav:Dimension is a property of a node (the page, the docs section), says where it is carried - the address's fragment or query, this tab's or this device's storage - whether changing it makes history (a step Back returns to) or not, and when it applies at all. This site's:" .
ui:doc-na-code a c:Code ; c:block true ; c:language "turtle" ; c:label """ui:location a nav:Location ; nav:root ui:shell ;
    nav:dimensions ( ui:atPage ui:atDocSection ui:atExample ui:atGalleryGroup ui:atReferenceTerm ui:atTarget ) .
ui:atPage a nav:Dimension ; nav:subject ui:app ; nav:property ui:page ; nav:keyProperty ui:key ;
    nav:carriedBy nav:Fragment ; nav:history nav:MakesHistory .
ui:atDocSection a nav:Dimension ; nav:subject ui:app ; nav:property ui:docSection ; nav:keyProperty ui:key ;
    nav:parent ui:atPage ; nav:when ui:Docs ;
    nav:carriedBy nav:Fragment , per:Session ; nav:history nav:MakesHistory .
ui:atTarget a nav:TargetDimension ; nav:subject ui:app ; nav:property nav:target ;
    nav:carriedBy nav:Fragment ; nav:history nav:NoHistory .""" .
ui:doc-na-2 a c:Text ; c:label "So this page is #docs/navigation. A section applies only on its page: elsewhere it is left out of the address and not read from it. On load, the carrier with the best nav:rank that has a value wins (the address, then storage), else the graph's own value. Storage carriers are written by the persistence effect, so nothing is remembered twice. Back, Forward and typed addresses are nav:Navigate events in the change log; the URL carriers realize history as a new entry or a replaced one, storage keeps only the current value." .
ui:doc-na-3 a c:Text ; c:label "A link can point at a resource instead of an address (c:to). The framework finds the location that shows it by walking up the component tree - children, contents, cases - to the switches that show it, and spells their dimension values, with the resource as the target: a link to the code input specimen is #components/inputs/inp-codes-spec. Following it writes those values, and opens what would still hide the target, as classes declare (nav:reveal: a tab is selected, an accordion item expanded, a card turned over, a window opened); the target is brought into view once it is rendered, without motion if you asked for less." .
ui:doc-na-4 a c:Text ; c:children ( "Try it: " ui:doc-na-to-codes " (another page), or " ui:doc-na-to-workbench " (in the tools, on its tab)." ) .
ui:doc-na-to-codes a c:Link ; c:label "the code input" ; c:to ui:inp-codes-spec .
ui:doc-na-to-workbench a c:Link ; c:label "the SPARQL workbench" ; c:to ui:workbench .
ui:doc-na-5 a c:Text ; c:label "The Engine tab of the tools shows where we are: the address, and each dimension with its value, how the address spells it, and where it is carried." .

# --- Maintained views ---
ui:doc-views a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-iv-h ui:doc-iv-1 ui:doc-iv-2
                 ui:doc-iv-decl-h ui:doc-iv-decl-1 ui:doc-iv-decl-code ui:doc-iv-decl-2
                 ui:doc-iv-group-h ui:doc-iv-group-1 ui:doc-iv-group-code
                 ui:doc-iv-time-h ui:doc-iv-time-1 ui:doc-iv-time-code ui:doc-iv-time-2
                 ui:doc-iv-show-h ui:doc-iv-show-1
                 ui:doc-iv-see-h ui:doc-iv-see-1 ui:doc-iv-see-code ui:doc-iv-see-2
                 ui:doc-iv-cost-h ui:doc-iv-cost-1 ui:doc-iv-cost
                 ui:doc-iv-status-h ui:doc-iv-landed-h ui:doc-iv-landed ui:doc-iv-pending-h ui:doc-iv-pending ui:doc-iv-gaps
                 ui:doc-iv-more ) .
ui:doc-iv-h a c:Heading ; c:level 1 ; c:label "Maintained views" .
ui:doc-iv-1 a c:Text ; c:label "Rules re-run their query when what they read changes. That is cheap for a list item and expensive for a query over a collection - counting the change log on every event costs as much as the log is long. A maintained view (iv:View) is a query whose result is kept up to date from the changes themselves, in the style of DBSP: a member that arrives counts once (+1), and once more, negatively (-1), when it retires or leaves a window, so a change costs what it changes, whatever the size of what it is counted over." .
ui:doc-iv-2 a c:Text ; c:children ( "A view is ordinary SPARQL: the same text runs from scratch on any store, which is how the tests check every view after every change. The " ui:doc-iv-example " example shows all of it working." ) .
ui:doc-iv-example a c:Link ; c:label "Maintained views" ; c:to ui:exp-views .

ui:doc-iv-decl-h a c:Heading ; c:level 2 ; c:label "Declaring a view" .
ui:doc-iv-decl-1 a c:Text ; c:label "Make a query an iv:View. Over the members of a stream (an LDES such as the change log, beh:ChangeLog), an aggregate is maintained member by member; its CONSTRUCT is written to a views graph that every projection reads, so components render the result like any other data." .
ui:doc-iv-decl-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:Whole a iv:View ;
    sem:construct \"\"\"
CONSTRUCT { vx:log vx:events ?n }
WHERE { { SELECT (COUNT(?m) AS ?n) WHERE { beh:ChangeLog tree:member ?m } } }\"\"\" .

# Any component shows it: here a stat reads the view's output with a query of its own.
vx:qEvents a sem:View ; sem:select \"\"\"SELECT ?value WHERE { vx:log vx:events ?value }\"\"\" .
ui:events a c:Stat ; c:label "In the log" ; c:unit "events" ; c:valueQuery vx:qEvents .""" .
ui:doc-iv-decl-2 a c:Text ; c:label "COUNT, SUM, AVG, MIN, MAX and DISTINCT are maintained. A query of another shape still works: it is recomputed, and the view says why (iv:fallback). iv:strategy iv:Incremental makes that an error instead, which is how the tests run." .

ui:doc-iv-group-h a c:Heading ; c:level 2 ; c:label "Groups" .
ui:doc-iv-group-1 a c:Text ; c:label "With GROUP BY, only the groups an event touched change - one row of output, not all of them. Mint each group's node from a key, as rules do, so a row keeps its identity and its DOM element." .
ui:doc-iv-group-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:ByType a iv:View ;
    sem:construct \"\"\"
CONSTRUCT { vx:log vx:byType ?row . ?row vx:type ?type ; vx:count ?n }
WHERE {
  { SELECT ?type (COUNT(?m) AS ?n)
    WHERE { beh:ChangeLog tree:member ?m . ?m a ?class .
            BIND(REPLACE(STR(?class), "^.*[#/]", "") AS ?type) }
    GROUP BY ?type }
  BIND(IRI(CONCAT(STR(vx:log), "/~", ENCODE_FOR_URI(?type))) AS ?row)
}\"\"\" .""" .

ui:doc-iv-time-h a c:Heading ; c:level 2 ; c:label "Windows and time" .
ui:doc-iv-time-1 a c:Text ; c:label "A sliding window keeps only the members of the last stretch of time. Members leave it as time passes - on one timer, set for the next expiry - even when nothing else happens, and each that leaves counts -1." .
ui:doc-iv-time-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:window a iv:SlidingWindow ; iv:range "PT30S"^^xsd:dayTimeDuration .
vx:Recent a iv:View ; iv:window vx:window ; sem:construct \"\"\" … \"\"\" .""" .
ui:doc-iv-time-2 a c:Text ; c:label "Time is the event bus's clock, which tests replace with one they move by hand. Retention works the same way: when the change log's policy retires a member (ldes:amount), the views see -1." .

ui:doc-iv-show-h a c:Heading ; c:level 2 ; c:label "Only while shown" .
ui:doc-iv-show-1 a c:Text ; c:label "iv:whileShown names a component (or a class: any instance). While it is hidden the view does nothing per event; when it is shown again it is rebuilt once from the stream's members, and kept from then on." .

ui:doc-iv-see-h a c:Heading ; c:level 2 ; c:label "Seeing it work" .
ui:doc-iv-see-1 a c:Text ; c:label "A view's plan is graph data (iv:operator, iv:kind, iv:algebra), and so is the provenance of what it writes. Ask for more and the runtime writes it, in idle time:" .
ui:doc-iv-see-code a c:Code ; c:block true ; c:language "turtle" ; c:label """vx:Recent iv:measured true ;      # figures: rows of state, rows per step, ms per step,
                                    # and a from-scratch run to compare (iv:matches)
    iv:deltaLog vx:steps .          # each step as a stream member: what came in (+1 / -1),
                                    # which groups changed, rows of work""" .
ui:doc-iv-see-2 a c:Text ; c:label "The status bar counts view rows beside rule runs, and the SPARQL workbench reads the views graph like any other." .

ui:doc-iv-cost-h a c:Heading ; c:level 2 ; c:label "What it costs" .
ui:doc-iv-cost-1 a c:Text ; c:label "The Activity tool and the count badges read maintained views. A todo toggle with Activity shown, with the change log keeping 200 or 2,000 events:" .
ui:doc-iv-cost a c:DescriptionList ; c:of ui:doc-iv-cost-items ; c:fields ( ui:ivc-fn ui:ivc-sparql ui:ivc-work ) .
ui:doc-iv-cost-items ui:ivc-fn "1.0 ms either way (before: 8.3 ms and 52.4 ms)" ;
    ui:ivc-sparql "4-6 ms either way (before: 10.9 ms and 284.6 ms)" ;
    ui:ivc-work "identical at both sizes: rule runs, triples read, rows, DOM operations (a test requires it)" .
ui:ivc-fn rdfs:label "Function rules" . ui:ivc-sparql rdfs:label "SPARQL rules" . ui:ivc-work rdfs:label "Work" .

ui:doc-iv-status-h a c:Heading ; c:level 2 ; c:label "Status" .
ui:doc-iv-landed-h a c:Heading ; c:level 3 ; c:label "Landed: phases 0 and 1" .
ui:doc-iv-landed a c:DescriptionList ; c:of ui:doc-iv-landed-items ; c:fields ( ui:ivl-ticks ui:ivl-agg ui:ivl-uses ui:ivl-window ui:ivl-demand ui:ivl-see ui:ivl-example ) .
ui:doc-iv-landed-items ui:ivl-ticks "Every change is a tick; Runtime.transaction makes several one, consolidated. An event's reaction and its change-log entry are one tick." ;
    ui:ivl-agg "Aggregates over a stream's members, maintained member by member; other shapes recomputed, with the reason (iv:fallback)." ;
    ui:ivl-uses "The Activity tool and count badges, at constant cost per event." ;
    ui:ivl-window "Sliding windows on one timer, ahead of phase 4 because the example needed one." ;
    ui:ivl-demand "iv:whileShown: hidden views idle, rebuilt when shown." ;
    ui:ivl-see "Plans, figures, per-step logs and from-scratch checks, as graph data." ;
    ui:ivl-example "The Maintained views example: each step, a check per view, work against a re-run's." .
ui:ivl-ticks rdfs:label "Ticks" . ui:ivl-agg rdfs:label "Aggregates" . ui:ivl-uses rdfs:label "In use" .
ui:ivl-window rdfs:label "Windows" . ui:ivl-demand rdfs:label "Demand" . ui:ivl-see rdfs:label "Inspection" . ui:ivl-example rdfs:label "Example" .
ui:doc-iv-pending-h a c:Heading ; c:level 3 ; c:label "Pending" .
ui:doc-iv-pending a c:DescriptionList ; c:of ui:doc-iv-pending-items ; c:fields ( ui:ivp-2 ui:ivp-3 ui:ivp-4 ui:ivp-5 ui:ivp-6 ) .
ui:doc-iv-pending-items ui:ivp-2 "Joins outside the member, DISTINCT, OPTIONAL, EXISTS and MINUS, top-k with order keys; then the data grid's window and the charts become views." ;
    ui:ivp-3 "Exact dependencies for SPARQL rules from their algebra, in place of sem:follows; rules that are themselves maintained." ;
    ui:ivp-4 "Tumbling and count windows, event time with watermarks, delta logs for replication, \"since\" and undo." ;
    ui:ivp-5 "The rest of SPARQL incrementally: LATERAL, correlated subqueries, paths, GROUP_CONCAT." ;
    ui:ivp-6 "The operators in Rust inside Semblance's engine, if profiling shows the runtime dominating." .
ui:ivp-2 rdfs:label "Phase 2: joins" . ui:ivp-3 rdfs:label "Phase 3: rules" . ui:ivp-4 rdfs:label "Phase 4: time" .
ui:ivp-5 rdfs:label "Phase 5: SPARQL" . ui:ivp-6 rdfs:label "Phase 6: engine" .
ui:doc-iv-gaps a c:Text ; sty:tone sty:Neutral ; c:label "Known gaps today: HAVING, ORDER BY with LIMIT and joins outside the member are recomputed; SPARQL views still run a few store queries per step for the member-local part; rules find a view's output through sem:follows." .
ui:doc-iv-more a c:Text ; c:label "docs/IVM.md in the repository has the full design, the decisions taken, what was built and where it differs, and the measurements." .

# --- Tools ---
ui:doc-tools a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-to-h ui:doc-to-1 ui:doc-to-keys ui:doc-to-2 ) .
ui:doc-to-h a c:Heading ; c:level 1 ; c:label "Tools" .
ui:doc-to-1 a c:Text ; c:label "The tools are on every page, in a window docked to the bottom: the Inspector (the rendered element, its provenance and the rule that made it, for whatever you hover), a SPARQL workbench over the live graph, Activity and the Change log, and the Engine (store, rule implementations, layers). Each tab can be torn off into its own window." .
ui:doc-to-keys a c:DescriptionList ; c:of ui:doc-to-key-items ; c:fields ( ui:k-tools ui:k-here ui:k-pause ui:k-off ui:k-private ) .
ui:doc-to-key-items ui:k-tools "⌘. - open or close the tools" ; ui:k-here "⌘Z - inspect what is under the pointer, in a window, paused" ;
    ui:k-pause "Z - pause or resume the inspector" ; ui:k-off "⇧Z - turn the inspector off or on" ; ui:k-private "⌘⇧H - private mode" .
ui:k-tools rdfs:label "Tools" . ui:k-here rdfs:label "Inspect here" . ui:k-pause rdfs:label "Pause" . ui:k-off rdfs:label "Off" . ui:k-private rdfs:label "Private" .
ui:doc-to-2 a c:Text ; c:label "Below every page, the status bar shows what the last interaction cost - rule runs, DOM operations, milliseconds - and what memory holds." .

# --- Performance (live) ---
ui:doc-performance a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:doc-pf-h ui:doc-pf-1 ui:performance ) .
ui:doc-pf-h a c:Heading ; c:level 1 ; c:label "Performance" .
ui:doc-pf-1 a c:Text ; c:label "Run the benchmark matrix in your browser. Each cell becomes a sosa:Observation; every chart below is a SPARQL view over them and every insight a SPARQL judgement - turn a card over to see its query." .
ui:doc-performance sem:warm sem:OnIntent .
