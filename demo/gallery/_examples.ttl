@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .

# Complete examples: small applications, each one graph of components wired to its own
# vocabulary and reactions. A navigation list picks one; under each, how it works and its source.
# The tools (⌘.) inspect any of them.

ui:example rdfs:label "Examples" ; rdfs:range ui:Example .
ui:ExTodo a ui:Example ; rdfs:label "Todo, two projections" ; sem:order 1 ; ui:key "todo" .
ui:ExNetwork a ui:Example ; rdfs:label "Network inspector" ; sem:order 2 ; ui:key "network" .
ui:ExSignin a ui:Example ; rdfs:label "Sign in with a code" ; sem:order 3 ; ui:key "signin" .
ui:ExKanban a ui:Example ; rdfs:label "Kanban board" ; sem:order 4 ; ui:key "kanban" .
ui:ExCheckout a ui:Example ; rdfs:label "Checkout" ; sem:order 5 ; ui:key "checkout" .
ui:ExBudget a ui:Example ; rdfs:label "Budget sheet" ; sem:order 6 ; ui:key "budget" .
ui:ExActivity a ui:Example ; rdfs:label "Your activity" ; sem:order 7 ; ui:key "activity" .
ui:ExChat a ui:Example ; rdfs:label "Chat" ; sem:order 8 ; ui:key "chat" .
ui:ExSettings a ui:Example ; rdfs:label "Settings" ; sem:order 9 ; ui:key "settings" .
ui:ExLocalized a ui:Example ; rdfs:label "Localized product page" ; sem:order 10 ; ui:key "localized" .
ui:ExViews a ui:Example ; rdfs:label "Maintained views" ; sem:order 11 ; ui:key "views" .
ui:ExShapes a ui:Example ; rdfs:label "A form from a shape" ; sem:order 12 ; ui:key "shape-form" .
ui:ExSheet a ui:Example ; rdfs:label "Spreadsheet" ; sem:order 13 ; ui:key "sheet" .
ui:ExCalendar a ui:Example ; rdfs:label "Room bookings" ; sem:order 14 ; ui:key "calendar" .
ui:ExDashboard a ui:Example ; rdfs:label "Sales dashboard" ; sem:order 15 ; ui:key "dashboard" .
ui:ExCollab a ui:Example ; rdfs:label "Shared agenda" ; sem:order 16 ; ui:key "collab" .

ui:examples a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-6 ; pos:inset tok:space-5 ;
    c:children ( ui:examplesNav ui:examplePages ) .
ui:examplesNav a c:NavList ; c:controls ui:app ; c:property ui:example ; c:label "Examples" ; c:compactAs c:Picker .
ui:examplePages a c:Switch ; c:controls ui:app ; c:property ui:example ;
    c:cases ( ui:exc-todo ui:exc-network ui:exc-signin ui:exc-kanban ui:exc-checkout ui:exc-budget ui:exc-activity ui:exc-chat ui:exc-settings ui:exc-localized ui:exc-views ui:exc-shapes ui:exc-sheet ui:exc-calendar ui:exc-dashboard ui:exc-collab ) .
ui:exc-todo c:when ui:ExTodo ; c:content ui:exp-todo .
ui:exc-signin c:when ui:ExSignin ; c:content ui:exp-signin .
ui:exc-network c:when ui:ExNetwork ; c:content ui:exp-network .
ui:exc-kanban c:when ui:ExKanban ; c:content ui:exp-kanban .
ui:exc-checkout c:when ui:ExCheckout ; c:content ui:exp-checkout .
ui:exc-budget c:when ui:ExBudget ; c:content ui:exp-budget .
ui:exc-activity c:when ui:ExActivity ; c:content ui:exp-activity .
ui:exc-chat c:when ui:ExChat ; c:content ui:exp-chat .
ui:exc-settings c:when ui:ExSettings ; c:content ui:exp-settings .
ui:exc-localized c:when ui:ExLocalized ; c:content ui:exp-localized .
ui:exc-views c:when ui:ExViews ; c:content ui:exp-views .
ui:exc-shapes c:when ui:ExShapes ; c:content ui:exp-shapes .
ui:exc-sheet c:when ui:ExSheet ; c:content ui:exp-sheet .
ui:exc-calendar c:when ui:ExCalendar ; c:content ui:exp-calendar .
ui:exc-dashboard c:when ui:ExDashboard ; c:content ui:exp-dashboard .
ui:exc-collab c:when ui:ExCollab ; c:content ui:exp-collab .

# --- Each example: the app, how it works, and its source ---------------------------------------------
# An example is its own graph, in its own file (demo/gallery/_ex-<key>.ttl; the network inspector in
# _network.ttl; the todo app is built by src/examples/todo.ts). Below it, the walkthrough it defines
# (<root>-how, a c:Walkthrough), and beside that walkthrough's diagram the file itself, verbatim (its
# c:sourceView): the host records each example file as a c:SourceText, with the lines of each statement.

ui:exp-todo a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-6 ; c:children ( ui:ex-todo ui:ex-todo-how ) .
ui:ex-todo-how c:sourceView ui:exs-todo .
ui:exs-todo a c:SourceView ; c:label "Source: the todo app" ; c:of <urn:semblance:source:src/examples/todo.ts> .
ui:exp-network a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-6 ; c:children ( ui:networkExample ui:networkExample-how ) .
ui:networkExample-how c:sourceView ui:exs-network .
ui:exs-network a c:SourceView ; c:label "Source" ; c:of <urn:semblance:source:demo/gallery/_network.ttl> .
ui:exp-signin a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-6 ; c:children ( ui:ex-signin ui:ex-signin-how ) .
