@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix dnd: <https://semblance.dev/ns/dragdrop#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kb: <https://semblance.dev/demo/kanban#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# Kanban board: cards in columns, a work-in-progress limit as a SHACL shape.
#
# The cards and the columns are this example's own vocabulary (kb:). A c:Board lays them out:
# its lanes are the kb:Column individuals (the range of kb:column, by sem:order), each card goes
# where its kb:column points. Moving a card is a reaction that rewrites that one triple; the
# limit on Doing is a shape the move reaction reads; counts are aggregates in the board's rule.
# The board is also dnd:Sortable: cards can be dragged between lanes and within one, the drag and
# drop layer refusing a full Doing by the same shape, and this file's drop reaction moving them.
# =================================================================================================

ui:ex-kanban-prefixes sh:declare [ sh:prefix "kb" ; sh:namespace "https://semblance.dev/demo/kanban#"^^xsd:anyURI ] .

# --- the columns ----------------------------------------------------------------------------------
# kb:column ranges over kb:Column; the board shows its individuals as lanes, in sem:order.

kb:column rdfs:label "Column" ; rdfs:range kb:Column .
kb:todo a kb:Column ; rdfs:label "To do" ; sem:order 1 .
kb:doing a kb:Column ; rdfs:label "Doing" ; sem:order 2 .
kb:done a kb:Column ; rdfs:label "Done" ; sem:order 3 .

# The work-in-progress limit: at most three cards point at Doing (the inverse of kb:column).
# A standard SHACL node shape on the column. The board's move reaction refuses a move that
# would break it, the drag and drop layer a drop that would, and the Doing header counts against
# it ("3 / 3").
kb:DoingLimit a sh:NodeShape ; sh:targetNode kb:doing ;
    sh:property [ sh:path [ sh:inversePath kb:column ] ; sh:maxCount 3 ;
                  sh:message "Doing holds at most three cards." ] .

# --- the cards ------------------------------------------------------------------------------------
# A card has a title, a column, someone it is assigned to, a tag and a rank (its place in a column).

kb:Bug a kb:Tag ; rdfs:label "bug" ; sty:tone sty:Danger .
kb:Feature a kb:Tag ; rdfs:label "feature" ; sty:tone sty:Accent .
kb:Docs a kb:Tag ; rdfs:label "docs" ; sty:tone sty:Info .
kb:Chore a kb:Tag ; rdfs:label "chore" ; sty:tone sty:Neutral .

kb:ada a kb:Person ; rdfs:label "Ada Lovelace" .
kb:grace a kb:Person ; rdfs:label "Grace Hopper" .
kb:alan a kb:Person ; rdfs:label "Alan Kay" .
kb:barbara a kb:Person ; rdfs:label "Barbara Liskov" .

# Who a card is for and what kind of work it is: the comboboxes of the add row offer the
# individuals of these ranges. A tag can also be made up there, as a new kb:Tag.
kb:Person a owl:Class .
kb:assignee rdfs:label "Assignee" ; rdfs:range kb:Person .
kb:tag rdfs:label "Tag" ; rdfs:range kb:Tag .

kb:c1 a kb:Card ; kb:title "Offline mode for the editor" ; kb:column kb:todo ; kb:assignee kb:ada ; kb:tag kb:Feature ; kb:rank 1 .
kb:c2 a kb:Card ; kb:title "Crash when pasting an empty query" ; kb:column kb:todo ; kb:assignee kb:grace ; kb:tag kb:Bug ; kb:rank 2 .
kb:c3 a kb:Card ; kb:title "Write the persistence guide" ; kb:column kb:todo ; kb:assignee kb:barbara ; kb:tag kb:Docs ; kb:rank 3 .
kb:c4 a kb:Card ; kb:title "Keyboard shortcuts for the board" ; kb:column kb:doing ; kb:assignee kb:alan ; kb:tag kb:Feature ; kb:rank 4 .
kb:c5 a kb:Card ; kb:title "Bump Oxigraph" ; kb:column kb:doing ; kb:assignee kb:grace ; kb:tag kb:Chore ; kb:rank 5 .
kb:c6 a kb:Card ; kb:title "Toast overlaps the dock" ; kb:column kb:done ; kb:assignee kb:ada ; kb:tag kb:Bug ; kb:rank 6 .

# --- the interface ---------------------------------------------------------------------------------

ui:ex-kanban a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-kanban-intro ui:ex-kanban-add-row ui:ex-kanban-board ui:ex-kanban-keys ) .
ui:ex-kanban-intro a c:Text ;
    c:label "A board of the example's own cards, laid out by a c:Board from where each card's kb:column points. Drag a card to another column or to another place in its own, move it with ← and →, or focus one and use the arrow keys; Doing has a work-in-progress limit of three, a SHACL shape every move respects." .

# The board: lanes from kb:column's range, cards from c:card, its look from the card's properties.
# As a dnd:Sortable its cards are draggables carrying the kb:Card, and each lane a drop zone.
ui:ex-kanban-board a c:Board , dnd:Sortable ; c:label "Sprint 14" ;
    c:property kb:column ; c:cardTitle kb:title ; c:cardTag kb:tag ; c:cardPerson kb:assignee ; c:cardOrder kb:rank ;
    c:removable true ;
    c:card kb:c1 , kb:c2 , kb:c3 , kb:c4 , kb:c5 , kb:c6 .

# Adding a card: a field whose shape says what a title is, and a button gated on it (val:requires).
kb:TitleShape a sh:PropertyShape ; sh:path kb:title ; sh:minCount 1 ; sh:maxLength 80 ;
    sh:message "A title of up to 80 characters." .
ui:ex-kanban-add-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:End ;
    c:children ( ui:ex-kanban-new ui:ex-kanban-who ui:ex-kanban-tag ui:ex-kanban-add ) .
ui:ex-kanban-new a c:TextField ; c:label "New card" ; c:placeholder "What needs doing?" ; val:validates kb:TitleShape .

# Who and what kind: comboboxes over a draft the new card copies. The assignee is one of the
# kb:Person individuals; a tag may be new (c:allowsCustom): Enter on "Create …" mints a kb:Tag
# under c:mintBase, if the text is a tag kb:NewTagShape allows.
ui:ex-kanban-draft kb:assignee kb:ada ; kb:tag kb:Feature .
kb:NewTagShape a sh:PropertyShape ; sh:path kb:tag ; sh:maxLength 16 ; sh:pattern "^[a-z][a-z0-9-]*$" ;
    sh:message "A tag is one lower-case word, up to 16 letters." .
ui:ex-kanban-who a c:Combobox ; c:controls ui:ex-kanban-draft ; c:property kb:assignee ; c:placeholder "Who?" .
ui:ex-kanban-tag a c:Combobox ; c:controls ui:ex-kanban-draft ; c:property kb:tag ; c:placeholder "Tag" ;
    c:allowsCustom true ; c:mintBase "https://semblance.dev/demo/kanban#tag-" ; val:validates kb:NewTagShape .
ui:ex-kanban-add a c:Button ; c:label "Add to To do" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ;
    val:requires ( ui:ex-kanban-new ) ; key:shortcut "mod+enter" .

ui:ex-kanban-keys a c:Text ; sty:textStyle sty:Caption ;
    c:children ( "Tab to a card, then " ui:ex-kanban-key-left " / " ui:ex-kanban-key-right " moves it; " ui:ex-kanban-key-space " picks it up to carry with the arrows, and puts it down again. " ui:ex-kanban-key-add " adds the card you typed." ) .
ui:ex-kanban-key-left a c:Kbd ; c:label "←" .
ui:ex-kanban-key-right a c:Kbd ; c:label "→" .
ui:ex-kanban-key-add a c:Kbd ; c:label "⌘↵" .
ui:ex-kanban-key-space a c:Kbd ; c:label "Space" .

# --- the reaction: adding a card ---------------------------------------------------------------------
# A new card, minted from the event's IRI, goes to the end of To do: its rank is one more than
# the highest; it is for the draft's assignee and has its tag. The field is cleared. (Moving, refusing a full column and removing are the
# board's own reactions, c:BoardMove, c:BoardRefuse and c:BoardRemove in ontology/components/board.ttl.)

kb:AddCard a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-kanban-add ;
    beh:deletes """
CONSTRUCT { ui:ex-kanban-new c:value ?v }
WHERE { ui:ex-kanban-new c:value ?v FILTER(STRLEN(STR(?v)) > 0 && STRLEN(STR(?v)) <= 80) }""" ;
    beh:inserts """
CONSTRUCT {
  ?card a kb:Card ; kb:title ?title ; kb:column kb:todo ; kb:rank ?rank ; kb:assignee ?who ; kb:tag ?tag .
  ui:ex-kanban-board c:card ?card .
}
WHERE {
  ui:ex-kanban-new c:value ?v FILTER(STRLEN(STR(?v)) > 0 && STRLEN(STR(?v)) <= 80)
  BIND(STR(?v) AS ?title)
  BIND(IRI(CONCAT(STR(kb:), "card-", STRAFTER(STR($event), "urn:semblance:event:"))) AS ?card)
  { SELECT (COALESCE(MAX(?r) + 1, 1) AS ?rank) WHERE { ?any kb:rank ?r } }
  OPTIONAL { ui:ex-kanban-draft kb:assignee ?who }
  OPTIONAL { ui:ex-kanban-draft kb:tag ?tag }
}""" ;
    ann:announces "Card added to To do" ; ann:tone sty:Success .

# --- the reaction: dropping a card -------------------------------------------------------------------
# A drop the layer accepted (into a lane with room, or within the card's own) puts the card in the
# lane it was dropped into, at the rank the drop computed: half way between its new neighbours',
# so no other card is renumbered. A drop into a full Doing never gets here: it is a dnd:Refusal,
# announced with kb:DoingLimit's message.

kb:DropCard a beh:Reaction ; beh:when dnd:Drop ; beh:source ui:ex-kanban-board ;
    beh:deletes """
CONSTRUCT { ?card kb:column ?old ; kb:rank ?oldRank . ?minted c:refusedBy ?refusal }
WHERE {
  $event dnd:carrying ?card ; dnd:into ?lane ; dnd:source ?minted .
  { ?card kb:column ?old } UNION { $event dnd:rank ?rank . ?card kb:rank ?oldRank } UNION { ?minted c:refusedBy ?refusal }
}""" ;
    beh:inserts """
CONSTRUCT { ?card kb:column ?lane ; kb:rank ?rank }
WHERE { $event dnd:carrying ?card ; dnd:into ?lane . OPTIONAL { $event dnd:rank ?rank } }""" .

# --- how it works ---------------------------------------------------------------------------------

ui:ex-kanban-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-kanban-w1 ui:ex-kanban-w2 ui:ex-kanban-w3 ui:ex-kanban-w4 ui:ex-kanban-w5 ui:ex-kanban-w6 ui:ex-kanban-w7 ) .

ui:ex-kanban-w1 a c:WalkthroughStep ; rdfs:label "Cards and columns are the example's own" ;
    c:children ( "A card such as " ui:ex-kanban-m-c4 " is data in the kb: vocabulary: a title, a tag, an assignee, a rank - and " ui:ex-kanban-m-column ", the column it is in. The columns are the individuals of that property's range: " ui:ex-kanban-m-todo ", " ui:ex-kanban-m-doing " and " ui:ex-kanban-m-done ", in sem:order. Nothing about kanban is in the framework." ) .
ui:ex-kanban-w2 a c:WalkthroughStep ; rdfs:label "A board lays them out" ;
    c:children ( ui:ex-kanban-m-board " is a " ui:ex-kanban-m-Board ", told which property places a card (" ui:ex-kanban-m-column2 ") and which ones it shows (title, tag, person, order). It finds the lanes itself from the property's range, and mints each card member-wise as a c:BoardCard composed of a tag, an avatar and buttons from the card's own properties." ) .
ui:ex-kanban-w3 a c:WalkthroughStep ; rdfs:label "Moving is one triple" ;
    c:children ( "The ← and → on a card are buttons naming a lane. " ui:ex-kanban-m-move " deletes the card's " ui:ex-kanban-m-column3 " and inserts that lane; an arrow key on a focused card is the same move, through the lanes the board noted on the card - mirrored when the page reads right to left." ) .
ui:ex-kanban-w4 a c:WalkthroughStep ; rdfs:label "The limit is a shape" ;
    c:children ( "Doing holds at most three cards because of " ui:ex-kanban-m-limit ", a standard SHACL node shape on " ui:ex-kanban-m-doing2 ": at most three things point at it by kb:column. The move reaction counts against its sh:maxCount in its WHERE, so a move into a full lane changes nothing, and " ui:ex-kanban-m-refuse " marks the card (it shakes) and announces the shape's message. The lane headers count the same way, toned at the limit." ) .
ui:ex-kanban-w5 a c:WalkthroughStep ; rdfs:label "Dragging asks the same shape" ;
    c:children ( "The board is also a " ui:ex-kanban-m-sortable ": its cards are draggables carrying their kb:Card, its lanes drop targets. While a card is carried, every lane derives whether it would take it - one more card must still conform to the lane's shapes - so a full Doing refuses, dimmed, with " ui:ex-kanban-m-limit2 "'s message over it. Moving over a lane is unrecorded; only the drop is history." ) .
ui:ex-kanban-w6 a c:WalkthroughStep ; rdfs:label "A drop is this file's reaction" ;
    c:children ( "Letting go where a lane takes it is a " ui:ex-kanban-m-Drop " event addressed to the board. " ui:ex-kanban-m-dropcard " rewrites the card's column and rank - the rank half way between its new neighbours', so no other card is renumbered, and reordering within a lane is the same drop. A drop on a full Doing is a refusal instead; this reaction never sees it." ) .
ui:ex-kanban-w7 a c:WalkthroughStep ; rdfs:label "Adding, gated by a shape" ;
    c:children ( ui:ex-kanban-m-addcard " mints a card from the event's IRI, ranks it last in To do and clears the field. " ui:ex-kanban-m-add " is disabled until " ui:ex-kanban-m-new " conforms to " ui:ex-kanban-m-title " (it " ui:ex-kanban-m-requires " the field). Why it is cheap: cards are placed member-wise, so a move re-renders one card and the lane headers; a drag re-runs only the board's marks and the carried card, however many cards there are." ) .

ui:ex-kanban-m-c4 a c:Mention ; c:label "kb:c4" ; c:mentions kb:c4 .
ui:ex-kanban-m-column a c:Mention ; c:label "kb:column" ; c:mentions kb:column .
ui:ex-kanban-m-column2 a c:Mention ; c:label "kb:column" ; c:mentions kb:column .
ui:ex-kanban-m-column3 a c:Mention ; c:label "kb:column" ; c:mentions kb:column .
ui:ex-kanban-m-todo a c:Mention ; c:label "kb:todo" ; c:mentions kb:todo .
ui:ex-kanban-m-doing a c:Mention ; c:label "kb:doing" ; c:mentions kb:doing .
ui:ex-kanban-m-doing2 a c:Mention ; c:label "kb:doing" ; c:mentions kb:doing .
ui:ex-kanban-m-done a c:Mention ; c:label "kb:done" ; c:mentions kb:done .
ui:ex-kanban-m-board a c:Mention ; c:label "ui:ex-kanban-board" ; c:mentions ui:ex-kanban-board .
ui:ex-kanban-m-Board a c:Mention ; c:label "c:Board" ; c:mentions c:Board ; c:to c:Board .
ui:ex-kanban-m-move a c:Mention ; c:label "c:BoardMove" ; c:mentions c:BoardMove ; c:to c:BoardMove .
ui:ex-kanban-m-limit a c:Mention ; c:label "kb:DoingLimit" ; c:mentions kb:DoingLimit .
ui:ex-kanban-m-limit2 a c:Mention ; c:label "kb:DoingLimit" ; c:mentions kb:DoingLimit .
ui:ex-kanban-m-refuse a c:Mention ; c:label "c:BoardRefuse" ; c:mentions c:BoardRefuse ; c:to c:BoardRefuse .
ui:ex-kanban-m-sortable a c:Mention ; c:label "dnd:Sortable" ; c:mentions dnd:Sortable ; c:to dnd:Sortable .
ui:ex-kanban-m-Drop a c:Mention ; c:label "dnd:Drop" ; c:mentions dnd:Drop ; c:to dnd:Drop .
ui:ex-kanban-m-dropcard a c:Mention ; c:label "kb:DropCard" ; c:mentions kb:DropCard .
ui:ex-kanban-m-addcard a c:Mention ; c:label "kb:AddCard" ; c:mentions kb:AddCard .
ui:ex-kanban-m-add a c:Mention ; c:label "Its button" ; c:mentions ui:ex-kanban-add .
ui:ex-kanban-m-new a c:Mention ; c:label "the field" ; c:mentions ui:ex-kanban-new .
ui:ex-kanban-m-title a c:Mention ; c:label "kb:TitleShape" ; c:mentions kb:TitleShape .
ui:ex-kanban-m-requires a c:Mention ; c:label "val:requires" ; c:mentions val:requires ; c:to val:requires .
