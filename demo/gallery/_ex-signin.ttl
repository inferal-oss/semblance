@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .

# --- Sign in with a code -------------------------------------------------------------------------
# A two-step flow as graph state: ui:signinStep is the code step or done. Verifying is three
# reactions on one click, each with its own condition: too short, wrong, right. (The code is
# 246810; a real app's reaction would ask a server, as an effect.)

ui:signinStep rdfs:label "Sign-in step" ; rdfs:range ui:SigninStep .
ui:SigninCode a ui:SigninStep ; rdfs:label "Code" ; sem:order 1 .
ui:SigninDone a ui:SigninStep ; rdfs:label "Done" ; sem:order 2 .
ui:signinFlow ui:signinStep ui:SigninCode .

ui:ex-signin a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:align pos:Center ;
    c:children ( ui:ex-signin-intro ui:ex-signin-card ) .
ui:ex-signin-intro a c:Text ; pos:textAlign pos:TextCenter ;
    c:label "A verification step: a code input, a primary action whose reactions check the code, an announced result. The code is 246810." .
ui:ex-signin-card a c:Card ; c:label "Check your email" ; c:badge "2-step" ; c:content ui:ex-signin-steps .
ui:ex-signin-steps a c:Switch ; c:controls ui:signinFlow ; c:property ui:signinStep ;
    c:cases ( ui:ex-signin-case-code ui:ex-signin-case-done ) .
ui:ex-signin-case-code c:when ui:SigninCode ; c:content ui:ex-signin-form .
ui:ex-signin-case-done c:when ui:SigninDone ; c:content ui:ex-signin-done .

ui:ex-signin-form a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-signin-lead ui:ex-signin-code ui:ex-signin-actions ) .
ui:ex-signin-lead a c:Text ; c:label "We sent a 6-digit code to ada@example.org. It expires in 10 minutes." .
ui:ex-signin-code a c:CodeInput ; c:label "Verification code" ; c:length 6 ; c:groupSize 3 ; sty:size sty:Large .
ui:ex-signin-actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:ex-signin-verify ui:ex-signin-resend ) .
ui:ex-signin-verify a c:Button ; c:label "Verify" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ui:ex-signin-resend a c:Button ; c:label "Send a new code" ; sty:emphasis sty:Ghost .

ui:ex-signin-done a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-signin-ok ui:ex-signin-again ) .
ui:ex-signin-ok a c:Alert ; sty:tone sty:Success ; c:label "You're signed in" ; c:help "The code matched. In a real app this is where the session begins." .
ui:ex-signin-again a c:Button ; c:label "Start over" ; sty:emphasis sty:Outline .

ui:SigninTooShort a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:deletes """CONSTRUCT { ui:ex-signin-code c:error ?e } WHERE { ui:ex-signin-code c:error ?e }""" ;
    beh:inserts """
CONSTRUCT { ui:ex-signin-code c:error "Enter all 6 digits." }
WHERE { OPTIONAL { ui:ex-signin-code c:value ?v } FILTER(STRLEN(COALESCE(STR(?v), "")) < 6) }""" .
ui:SigninWrong a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:inserts """
CONSTRUCT { ui:ex-signin-code c:error "That code isn't right. Check the email, or send a new one." }
WHERE { ui:ex-signin-code c:value ?v FILTER(STRLEN(?v) = 6 && ?v != "246810") }""" .
ui:SigninRight a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:deletes """CONSTRUCT { ui:signinFlow ui:signinStep ?s } WHERE { ui:ex-signin-code c:value "246810" . ui:signinFlow ui:signinStep ?s }""" ;
    beh:inserts """CONSTRUCT { ui:signinFlow ui:signinStep ui:SigninDone } WHERE { ui:ex-signin-code c:value "246810" }""" ;
    ann:announces "Signed in" ; ann:tone sty:Success .
ui:SigninResend a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-resend ;
    beh:deletes """CONSTRUCT { ui:ex-signin-code c:value ?v ; c:error ?e } WHERE { { ui:ex-signin-code c:value ?v } UNION { ui:ex-signin-code c:error ?e } }""" ;
    beh:inserts """CONSTRUCT { ui:ex-signin-code c:value "" } WHERE {}""" ;
    ann:announces "A new code is on its way" ; ann:tone sty:Info .
ui:SigninAgain a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-again ;
    beh:deletes """CONSTRUCT { ui:signinFlow ui:signinStep ?s . ui:ex-signin-code c:value ?v ; c:error ?e } WHERE { ui:signinFlow ui:signinStep ?s OPTIONAL { ui:ex-signin-code c:value ?v } OPTIONAL { ui:ex-signin-code c:error ?e } }""" ;
    beh:inserts """CONSTRUCT { ui:signinFlow ui:signinStep ui:SigninCode . ui:ex-signin-code c:value "" } WHERE {}""" .

ui:ex-signin-how a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:ex-signin-how-h ui:ex-signin-how-1 ui:ex-signin-how-2 ui:ex-signin-how-3 ) .
ui:ex-signin-how-h a c:Heading ; c:level 2 ; c:label "How it works" .
ui:ex-signin-how-1 a c:Text ; c:children ( "Where the flow is, is one triple: " ui:ex-signin-c1 " is " ui:ex-signin-c2 " or " ui:ex-signin-c3 ", and a " ui:ex-signin-c4 " shows the matching step. Nothing is hidden state." ) .
ui:ex-signin-how-2 a c:Text ; c:children ( "The code is a " ui:ex-signin-c5 ": one real field (paste and SMS autofill work) over six cells; its own reaction keeps the digits and writes " ui:ex-signin-c6 "." ) .
ui:ex-signin-how-3 a c:Text ; c:children ( "Verify is one click with three reactions, each with its own condition in WHERE - " ui:ex-signin-c7 ", " ui:ex-signin-c8 ", " ui:ex-signin-c9 " - and only the one whose condition holds changes anything. They all see the state before the click; the right one moves the flow on and announces it as a toast (" ui:ex-signin-c10 ")." ) .
ui:ex-signin-c1 a c:Code ; c:label "ui:signinFlow ui:signinStep" . ui:ex-signin-c2 a c:Code ; c:label "ui:SigninCode" . ui:ex-signin-c3 a c:Code ; c:label "ui:SigninDone" .
ui:ex-signin-c4 a c:Code ; c:label "c:Switch" . ui:ex-signin-c5 a c:Code ; c:label "c:CodeInput" . ui:ex-signin-c6 a c:Code ; c:label "c:value" .
ui:ex-signin-c7 a c:Code ; c:label "ui:SigninTooShort" . ui:ex-signin-c8 a c:Code ; c:label "ui:SigninWrong" . ui:ex-signin-c9 a c:Code ; c:label "ui:SigninRight" .
ui:ex-signin-c10 a c:Code ; c:label "ann:announces" .
