@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .

# --- Sign in with a code -------------------------------------------------------------------------
# A two-step flow as graph state: ui:signinStep is the code step or done. Verifying is three
# reactions on one click, each with its own condition: too short, wrong, right. (The code is
# 246810; a real app's reaction would ask a server, as an effect.)

ui:signinStep rdfs:label "Sign-in step" ; rdfs:range ui:SigninStep .
ui:SigninCode a ui:SigninStep ; rdfs:label "Code" ; sem:order 1 .
ui:SigninDone a ui:SigninStep ; rdfs:label "Done" ; sem:order 2 .
ui:signinFlow ui:signinStep ui:SigninCode .

ui:ex-signin a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:align pos:Center ;
    c:children ( ui:ex-signin-intro ui:ex-signin-card ) .
ui:ex-signin-intro a c:Text ; pos:textAlign pos:TextCenter ;
    c:label "A verification step: a code input, a primary action whose reactions check the code, an announced result. The code is 246810." .
ui:ex-signin-card a c:Card ; c:label "Check your email" ; c:badge "2-step" ; c:content ui:ex-signin-steps .
ui:ex-signin-steps a c:Switch ; c:controls ui:signinFlow ; c:property ui:signinStep ;
    c:cases ( ui:ex-signin-case-code ui:ex-signin-case-done ) .
ui:ex-signin-case-code c:when ui:SigninCode ; c:content ui:ex-signin-form .
ui:ex-signin-case-done c:when ui:SigninDone ; c:content ui:ex-signin-done .

ui:ex-signin-form a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-signin-lead ui:ex-signin-code ui:ex-signin-actions ) .
ui:ex-signin-lead a c:Text ; c:label "We sent a 6-digit code to ada@example.org. It expires in 10 minutes." .
ui:ex-signin-code a c:CodeInput ; c:label "Verification code" ; c:length 6 ; c:groupSize 3 ; sty:size sty:Large .
ui:ex-signin-actions a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:ex-signin-verify ui:ex-signin-resend ) .
ui:ex-signin-verify a c:Button ; c:label "Verify" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ui:ex-signin-resend a c:Button ; c:label "Send a new code" ; sty:emphasis sty:Ghost .

ui:ex-signin-done a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-signin-ok ui:ex-signin-again ) .
ui:ex-signin-ok a c:Alert ; sty:tone sty:Success ; c:label "You're signed in" ; c:help "The code matched. In a real app this is where the session begins." .
ui:ex-signin-again a c:Button ; c:label "Start over" ; sty:emphasis sty:Outline .

ui:SigninTooShort a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:deletes """CONSTRUCT { ui:ex-signin-code c:error ?e } WHERE { ui:ex-signin-code c:error ?e }""" ;
    beh:inserts """
CONSTRUCT { ui:ex-signin-code c:error "Enter all 6 digits." }
WHERE { OPTIONAL { ui:ex-signin-code c:value ?v } FILTER(STRLEN(COALESCE(STR(?v), "")) < 6) }""" .
ui:SigninWrong a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:inserts """
CONSTRUCT { ui:ex-signin-code c:error "That code isn't right. Check the email, or send a new one." }
WHERE { ui:ex-signin-code c:value ?v FILTER(STRLEN(?v) = 6 && ?v != "246810") }""" .
ui:SigninRight a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-verify ;
    beh:deletes """CONSTRUCT { ui:signinFlow ui:signinStep ?s } WHERE { ui:ex-signin-code c:value "246810" . ui:signinFlow ui:signinStep ?s }""" ;
    beh:inserts """CONSTRUCT { ui:signinFlow ui:signinStep ui:SigninDone } WHERE { ui:ex-signin-code c:value "246810" }""" ;
    ann:announces "Signed in" ; ann:tone sty:Success .
ui:SigninResend a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-resend ;
    beh:deletes """CONSTRUCT { ui:ex-signin-code c:value ?v ; c:error ?e } WHERE { { ui:ex-signin-code c:value ?v } UNION { ui:ex-signin-code c:error ?e } }""" ;
    beh:inserts """CONSTRUCT { ui:ex-signin-code c:value "" } WHERE {}""" ;
    ann:announces "A new code is on its way" ; ann:tone sty:Info .
ui:SigninAgain a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-signin-again ;
    beh:deletes """CONSTRUCT { ui:signinFlow ui:signinStep ?s . ui:ex-signin-code c:value ?v ; c:error ?e } WHERE { ui:signinFlow ui:signinStep ?s OPTIONAL { ui:ex-signin-code c:value ?v } OPTIONAL { ui:ex-signin-code c:error ?e } }""" ;
    beh:inserts """CONSTRUCT { ui:signinFlow ui:signinStep ui:SigninCode . ui:ex-signin-code c:value "" } WHERE {}""" .

# --- How it works: a walkthrough beside a diagram of what it mentions (ontology/components/walkthrough.ttl)

ui:ex-signin-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-signin-w1 ui:ex-signin-w2 ui:ex-signin-w3 ui:ex-signin-w4 ui:ex-signin-w5 ui:ex-signin-w6 ) .

ui:ex-signin-w1 a c:WalkthroughStep ; rdfs:label "Where the flow is, is one triple" ;
    c:children ( "The flow is a resource, " ui:ex-signin-m-flow ", and its step is the value of one property, " ui:ex-signin-m-step ". The steps are individuals of the app's own class: " ui:ex-signin-m-code-step " and " ui:ex-signin-m-done-step ", ordered by sem:order. There is no hidden state: open the tools and the triple is there." ) .
ui:ex-signin-w2 a c:WalkthroughStep ; rdfs:label "A switch shows the step" ;
    c:children ( "The card's content is " ui:ex-signin-m-switch ", a " ui:ex-signin-m-Switch " that " ui:ex-signin-m-controls-flow " and follows " ui:ex-signin-m-step2 ". Each case pairs a value with what to show: " ui:ex-signin-m-case-code " shows the form, " ui:ex-signin-m-case-done " the confirmation. The case that is not shown is not evaluated at all until it is." ) .
ui:ex-signin-w3 a c:WalkthroughStep ; rdfs:label "One field, six cells" ;
    c:children ( "The code is " ui:ex-signin-m-code ", a " ui:ex-signin-m-CodeInput ": one real text field drawn as six cells in two groups, so paste and one-time-code autofill work. Its own reaction keeps only digits and writes them to the field's c:value - the value a reaction reads next." ) .
ui:ex-signin-w4 a c:WalkthroughStep ; rdfs:label "One click, three reactions" ;
    c:children ( "A click on " ui:ex-signin-m-verify " is one event, and three reactions answer it, each with its own condition in its WHERE clause: " ui:ex-signin-m-short " writes an error while fewer than six digits are there, " ui:ex-signin-m-wrong " when six are there but not the right ones, and " ui:ex-signin-m-right " moves " ui:ex-signin-m-flow2 " on to " ui:ex-signin-m-done-step2 " when the code matches. All three see the graph as it was before the click; only the one whose condition holds changes anything." ) .
ui:ex-signin-w5 a c:WalkthroughStep ; rdfs:label "Said out loud, and undone" ;
    c:children ( "Reactions say what they mean: " ui:ex-signin-m-right2 " carries " ui:ex-signin-m-announces " \"Signed in\", which the announcement layer shows as a toast and reads to assistive technology. " ui:ex-signin-m-resend " clears the field and announces a new code; " ui:ex-signin-m-again " - the " ui:ex-signin-m-again-button " - puts the flow back on " ui:ex-signin-m-code-step2 " and empties the field." ) .
ui:ex-signin-w6 a c:WalkthroughStep ; rdfs:label "Why it is cheap" ;
    c:children ( "A keystroke changes one triple, the field's value, so only " ui:ex-signin-m-code2 " renders again. Verifying changes the step: the switch shows another case, and the alert " ui:ex-signin-m-ok " is evaluated the first time it is shown. Nothing reads the whole page, so nothing re-reads it." ) .

ui:ex-signin-m-flow a c:Mention ; c:label "ui:signinFlow" ; c:mentions ui:signinFlow .
ui:ex-signin-m-flow2 a c:Mention ; c:label "the flow" ; c:mentions ui:signinFlow .
ui:ex-signin-m-step a c:Mention ; c:label "ui:signinStep" ; c:mentions ui:signinStep .
ui:ex-signin-m-step2 a c:Mention ; c:label "ui:signinStep" ; c:mentions ui:signinStep .
ui:ex-signin-m-code-step a c:Mention ; c:label "ui:SigninCode" ; c:mentions ui:SigninCode .
ui:ex-signin-m-code-step2 a c:Mention ; c:label "ui:SigninCode" ; c:mentions ui:SigninCode .
ui:ex-signin-m-done-step a c:Mention ; c:label "ui:SigninDone" ; c:mentions ui:SigninDone .
ui:ex-signin-m-done-step2 a c:Mention ; c:label "ui:SigninDone" ; c:mentions ui:SigninDone .
ui:ex-signin-m-switch a c:Mention ; c:label "ui:ex-signin-steps" ; c:mentions ui:ex-signin-steps .
ui:ex-signin-m-Switch a c:Mention ; c:label "c:Switch" ; c:mentions c:Switch ; c:to c:Switch .
ui:ex-signin-m-controls-flow a c:Mention ; c:label "controls the flow" ; c:mentions ui:signinFlow .
ui:ex-signin-m-case-code a c:Mention ; c:label "the code case" ; c:mentions ui:ex-signin-case-code .
ui:ex-signin-m-case-done a c:Mention ; c:label "the done case" ; c:mentions ui:ex-signin-case-done .
ui:ex-signin-m-code a c:Mention ; c:label "ui:ex-signin-code" ; c:mentions ui:ex-signin-code .
ui:ex-signin-m-code2 a c:Mention ; c:label "the code input" ; c:mentions ui:ex-signin-code .
ui:ex-signin-m-CodeInput a c:Mention ; c:label "c:CodeInput" ; c:mentions c:CodeInput ; c:to c:CodeInput .
ui:ex-signin-m-verify a c:Mention ; c:label "the Verify button" ; c:mentions ui:ex-signin-verify .
ui:ex-signin-m-short a c:Mention ; c:label "ui:SigninTooShort" ; c:mentions ui:SigninTooShort .
ui:ex-signin-m-wrong a c:Mention ; c:label "ui:SigninWrong" ; c:mentions ui:SigninWrong .
ui:ex-signin-m-right a c:Mention ; c:label "ui:SigninRight" ; c:mentions ui:SigninRight .
ui:ex-signin-m-right2 a c:Mention ; c:label "ui:SigninRight" ; c:mentions ui:SigninRight .
ui:ex-signin-m-announces a c:Mention ; c:label "ann:announces" ; c:mentions ann:announces ; c:to ann:announces .
ui:ex-signin-m-resend a c:Mention ; c:label "ui:SigninResend" ; c:mentions ui:SigninResend .
ui:ex-signin-m-again a c:Mention ; c:label "ui:SigninAgain" ; c:mentions ui:SigninAgain .
ui:ex-signin-m-again-button a c:Mention ; c:label "Start over button" ; c:mentions ui:ex-signin-again .
ui:ex-signin-m-ok a c:Mention ; c:label "ui:ex-signin-ok" ; c:mentions ui:ex-signin-ok .
