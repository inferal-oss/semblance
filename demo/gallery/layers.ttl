# Gallery page: Layers.

ui:gallery-layers a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-layers-intro ) .
ui:gallery-layers-intro a c:Heading ; c:label "Layers" .
