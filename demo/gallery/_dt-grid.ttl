@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix net: <https://semblance.dev/ns/network#> .
@prefix http: <http://www.w3.org/2011/http#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .

# Data gallery: the data grid and its time axis. Two small collections stand in for real
# ones: a build log (an LDES stream of log lines) and a trace (spans with start and end). Their
# grids are general: rows are a collection's members, columns say what each cell shows, and
# everything a person changes (sort, selection, column widths and visibility, filters, paging)
# is graph state on the grid, its columns and its filter nodes.

ui:dt-grid a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:dt-grid-log ui:dt-grid-trace ui:dt-grid-axis ) .

# --- a log viewer -----------------------------------------------------------------------------------

ui:LogLevel a owl:Class .
ui:level a owl:ObjectProperty ; rdfs:label "Level"@en ; rdfs:range ui:LogLevel .
ui:message a owl:DatatypeProperty ; rdfs:label "Message"@en .
ui:source a owl:DatatypeProperty ; rdfs:label "Source"@en .
ui:line a owl:DatatypeProperty ; rdfs:label "Line"@en .
ui:LevelDebug a ui:LogLevel ; rdfs:label "Debug"@en ; sem:order 1 ; sty:tone sty:Neutral .
ui:LevelInfo a ui:LogLevel ; rdfs:label "Info"@en ; sem:order 2 ; sty:tone sty:Info .
ui:LevelWarning a ui:LogLevel ; rdfs:label "Warning"@en ; sem:order 3 ; sty:tone sty:Warning .
ui:LevelError a ui:LogLevel ; rdfs:label "Error"@en ; sem:order 4 ; sty:tone sty:Danger .

ui:buildLog a ldes:EventStream ; rdfs:label "Build log"@en ; ldes:sequencePath ui:line ;
    tree:member ui:log-1 , ui:log-2 , ui:log-3 , ui:log-4 , ui:log-5 , ui:log-6 , ui:log-7 , ui:log-8 , ui:log-9 , ui:log-10 , ui:log-11 , ui:log-12 .
ui:log-1 ui:line 1 ; ui:level ui:LevelInfo ; ui:source "vite" ; ui:message "dev server starting" .
ui:log-2 ui:line 2 ; ui:level ui:LevelDebug ; ui:source "vite" ; ui:message "resolved 61 ontology files" .
ui:log-3 ui:line 3 ; ui:level ui:LevelInfo ; ui:source "oxigraph" ; ui:message "wasm ready in 38 ms" .
ui:log-4 ui:line 4 ; ui:level ui:LevelWarning ; ui:source "shapes" ; ui:message "ui:dt-grid-axis has no c:label" .
ui:log-5 ui:line 5 ; ui:level ui:LevelInfo ; ui:source "engine" ; ui:message "initial render: 1,184 rule runs" .
ui:log-6 ui:line 6 ; ui:level ui:LevelDebug ; ui:source "engine" ; ui:message "bulk query for 48 foci" .
ui:log-7 ui:line 7 ; ui:level ui:LevelError ; ui:source "fetch" ; ui:message "GET /api/todos failed: 503" .
ui:log-8 ui:line 8 ; ui:level ui:LevelInfo ; ui:source "fetch" ; ui:message "retrying in 500 ms" .
ui:log-9 ui:line 9 ; ui:level ui:LevelInfo ; ui:source "fetch" ; ui:message "GET /api/todos 200" .
ui:log-10 ui:line 10 ; ui:level ui:LevelWarning ; ui:source "persistence" ; ui:message "session storage at 82%" .
ui:log-11 ui:line 11 ; ui:level ui:LevelDebug ; ui:source "dom" ; ui:message "patched 12 nodes" .
ui:log-12 ui:line 12 ; ui:level ui:LevelInfo ; ui:source "vite" ; ui:message "hmr update ontology/theme/grid.ttl" .

ui:dt-grid-col-line a c:GridColumn ; c:label "#" ; c:cellProperty ui:line ; c:align "end" ; c:width 56 .
ui:dt-grid-col-level a c:GridColumn ; c:label "Level" ; c:cellProperty ui:level ; c:cellAs c:BadgeCell ; c:width 104 .
ui:dt-grid-col-source a c:GridColumn ; c:label "Source" ; c:cellProperty ui:source ; c:cellAs c:CodeCell ; c:width 120 .
ui:dt-grid-col-message a c:GridColumn ; c:label "Message" ; c:cellProperty ui:message .

ui:dt-grid-search a c:TextFilter ; c:searches ui:message , ui:source .
ui:dt-grid-level a c:ValueFilter ; c:filterProperty ui:level ; c:filterValue c:AnyValue .
ui:dt-grid-debug a c:FlagFilter ; c:filterProperty ui:level ; c:filterValue ui:LevelDebug ; c:included true .

ui:dt-grid-logGrid a c:DataGrid ; c:label "Build log" ;
    c:collection ui:buildLog ; c:pageSize 8 ;
    c:gridColumns ( ui:dt-grid-col-line ui:dt-grid-col-level ui:dt-grid-col-source ui:dt-grid-col-message ) ;
    c:shows ui:dt-grid-col-line , ui:dt-grid-col-level , ui:dt-grid-col-source , ui:dt-grid-col-message ;
    c:filteredBy ui:dt-grid-search , ui:dt-grid-level , ui:dt-grid-debug ;
    c:emptyText "No log lines match the filters." .

ui:dt-grid-filterText a c:SearchField ; c:label "Filter log lines" ; c:placeholder "Filter messages and sources…" ;
    c:controls ui:dt-grid-search ; c:property c:filterText .
ui:dt-grid-filterLevel a c:Choice ; c:label "Level" ; c:controls ui:dt-grid-level ; c:property c:filterValue ;
    c:options ( c:AnyValue ui:LevelDebug ui:LevelInfo ui:LevelWarning ui:LevelError ) .
ui:dt-grid-filterDebug a c:ToggleSwitch ; c:label "Debug lines" ; sty:size sty:Small ;
    c:controls ui:dt-grid-debug ; c:property c:included .
ui:dt-grid-logBar a c:Toolbar ; c:label "Log filters" ;
    c:children ( ui:dt-grid-filterText ui:dt-grid-filterLevel ui:dt-grid-filterDebug ) .
ui:dt-grid-columns a c:Chips ; c:label "Columns" ; c:controls ui:dt-grid-logGrid ; c:property c:shows ;
    c:options ( ui:dt-grid-col-line ui:dt-grid-col-level ui:dt-grid-col-source ui:dt-grid-col-message ) .
ui:dt-grid-selected a c:Metrics ; c:of ui:dt-grid-logGrid ; c:fields ( c:selectedRow ) .

ui:dt-grid-log a c:Flippable ; c:front ui:dt-grid-log-spec .
ui:dt-grid-log-spec a c:Specimen ; c:demonstrates c:DataGrid , c:GridColumn , c:TextFilter , c:ValueFilter , c:FlagFilter ; c:label "Data grid" ;
    c:help "A build log's lines as rows (role=grid): the members of an LDES stream in capture order, eight to a page with the newest followed. Headers sort (again to reverse); dragging a header's edge (or arrow keys on it) sets that column's c:width; the chips choose the c:shows columns. The filters are nodes the grid is c:filteredBy, edited by ordinary controls. Clicking a row (or Up / Down) selects its line and pins the window; the footer pages and jumps back to the latest." ;
    c:children ( ui:dt-grid-logBar ui:dt-grid-columns ui:dt-grid-logGrid ui:dt-grid-selected ) .

# --- a trace viewer: a waterfall ----------------------------------------------------------------------

ui:Service a owl:Class .
ui:service a owl:ObjectProperty ; rdfs:label "Service"@en .
ui:operation a owl:DatatypeProperty ; rdfs:label "Operation"@en .
ui:begin a owl:DatatypeProperty ; rdfs:label "Start"@en .
ui:finish a owl:DatatypeProperty ; rdfs:label "End"@en .
ui:order a owl:DatatypeProperty .
ui:svc-web a ui:Service ; rdfs:label "web"@en ; sem:order 1 ; c:swatch tok:series-1 .
ui:svc-api a ui:Service ; rdfs:label "api"@en ; sem:order 2 ; c:swatch tok:series-2 .
ui:svc-db a ui:Service ; rdfs:label "db"@en ; sem:order 3 ; c:swatch tok:series-3 .
ui:svc-queue a ui:Service ; rdfs:label "queue"@en ; sem:order 4 ; c:swatch tok:series-5 .

ui:trace a ldes:EventStream ; rdfs:label "Checkout trace"@en ; ldes:sequencePath ui:order ;
    tree:member ui:span-1 , ui:span-2 , ui:span-3 , ui:span-4 , ui:span-5 , ui:span-6 , ui:span-7 .
ui:span-1 ui:order 1 ; ui:service ui:svc-web ; ui:operation "POST /checkout" ; ui:begin 0 ; ui:finish 412 .
ui:span-2 ui:order 2 ; ui:service ui:svc-api ; ui:operation "validate cart" ; ui:begin 18 ; ui:finish 64 .
ui:span-3 ui:order 3 ; ui:service ui:svc-db ; ui:operation "SELECT items" ; ui:begin 22 ; ui:finish 51 .
ui:span-4 ui:order 4 ; ui:service ui:svc-api ; ui:operation "charge card" ; ui:begin 70 ; ui:finish 361 .
ui:span-5 ui:order 5 ; ui:service ui:svc-db ; ui:operation "INSERT order" ; ui:begin 365 ; ui:finish 398 .
ui:span-6 ui:order 6 ; ui:service ui:svc-queue ; ui:operation "enqueue receipt" ; ui:begin 400 ; ui:finish 407 .
ui:span-7 ui:order 7 ; ui:service ui:svc-queue ; ui:operation "send receipt" ; ui:begin 408 .

ui:dt-grid-col-op a c:GridColumn ; c:label "Operation" ; c:cellProperty ui:operation ; c:detailProperty ui:service ; c:width 180 .
ui:dt-grid-col-took a c:GridColumn ; c:label "Took" ; c:cellAs c:DurationCell ; c:startProperty ui:begin ; c:endProperty ui:finish ; c:align "end" ; c:width 80 .
ui:dt-grid-col-bars a c:GridColumn ; c:label "Waterfall" ; c:cellAs c:TimeBarCell ;
    c:startProperty ui:begin ; c:endProperty ui:finish ; c:colorProperty ui:service .

ui:dt-grid-traceGrid a c:DataGrid ; c:label "Checkout trace" ; c:collection ui:trace ;
    c:gridColumns ( ui:dt-grid-col-op ui:dt-grid-col-took ui:dt-grid-col-bars ) .
ui:dt-grid-services a c:Legend ; c:label "Services" ; c:of ui:Service .
ui:dt-grid-trace a c:Flippable ; c:front ui:dt-grid-trace-spec .
ui:dt-grid-trace-spec a c:Specimen ; c:demonstrates c:DataGrid ; c:label "Waterfall" ;
    c:help "A trace's spans on one time scale: a c:TimeBarCell column places each span's bar by its start and end, colored by its service's c:swatch; the header's time axis is on the same scale (the grid's window computes it from the rows it shows). A span without an end is still running: its bar runs to the end of the scale." ;
    c:children ( ui:dt-grid-services ui:dt-grid-traceGrid ) .

# --- a time axis on its own -------------------------------------------------------------------------

ui:dt-grid-axis-short a c:TimeAxis ; c:start 0 ; c:end 180 .
ui:dt-grid-axis-long a c:TimeAxis ; c:start 1200 ; c:end 9800 .
ui:dt-grid-axis a c:Flippable ; c:front ui:dt-grid-axis-spec .
ui:dt-grid-axis-spec a c:Specimen ; c:demonstrates c:TimeAxis ; c:label "Time axis" ;
    c:help "Ticks across a time range at the smallest 1, 2, 5 × 10ⁿ ms interval that needs at most five steps, in ms or s. Offsets are custom properties, so bars drawn on the same scale line up with the ticks." ;
    c:children ( ui:dt-grid-axis-short ui:dt-grid-axis-long ) .
