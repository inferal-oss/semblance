@prefix c: <https://semblance.dev/ns/component#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix ui: <https://semblance.dev/demo#> .

# Inspection gallery: editing code. A code editor (c:CodeEditor) in Turtle, and a live example
# (c:LiveExample): Turtle beside what it renders, in a sandbox of its own.

ui:in-editors a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:in-ed-editor ui:in-ed-live ) .

ui:in-ed-editor a c:Flippable ; c:front ui:in-ed-editor-spec .
ui:in-ed-editor-spec a c:Specimen ; c:label "Code editor" ;
    c:help "The text is graph state (c:value; c:original until it is edited), highlighted by its language (c:language: sparql, turtle) under a transparent text area, with line numbers. Typing suggests the prefixes and terms the graph knows and the language's own words (c:CodeWord): Up and Down move, Tab or Enter accepts, Escape closes. The SPARQL workbench's editor is a c:QueryEditor, the same editor in SPARQL." ;
    c:children ( ui:in-ed-turtle ) .
ui:in-ed-turtle a c:CodeEditor ; c:language "turtle" ; c:label "shapes.ttl" ; c:original '''@prefix ex: <https://example.org/people#> .

# Try typing sh: or c:La - the suggestions come from the graph.
ex:PersonShape a sh:NodeShape ; sh:targetClass ex:Person ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] .''' .

ui:in-ed-live a c:Flippable ; c:front ui:in-ed-live-spec .
ui:in-ed-live-spec a c:Specimen ; c:label "Live example" ;
    c:help "Turtle (c:sources, code editors in load order) beside its rendering (c:exampleRoot), in a sandbox of its own: its own store, rules and events, mounted in a host-owned slot. An edit re-renders it once typing pauses; a source that does not parse, or a rule that fails, is reported inline with its line, and the last rendering that worked stays. Reset brings back the sources as written; Copy copies the one shown, with the prefixes it uses. The sandbox's state (c:sandboxState, c:problem, c:renderTime) is graph data the host effect writes." ;
    c:children ( ui:in-ed-example ) .
ui:in-ed-example a c:LiveExample ; c:label "A badge and a button" ; c:exampleRoot <https://example.org/specimen#page> ; c:sources ( ui:in-ed-example-app ) .
ui:in-ed-example-app a c:CodeEditor ; c:language "turtle" ; c:label "app.ttl" ; c:original '''@prefix ex: <https://example.org/specimen#> .

ex:page a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:Center ;
    c:children ( ex:state ex:go ) .
ex:state a c:Badge ; c:label "Ready" ; sty:tone sty:Success .
ex:go a c:Button ; c:label "Go" ; sty:intent sty:Primary .''' .
