@prefix c: <https://semblance.dev/ns/component#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix ui: <https://semblance.dev/demo#> .

# Inspection gallery: editing code. A code editor (c:CodeEditor) in Turtle.

ui:in-editors a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:in-ed-editor ) .

ui:in-ed-editor a c:Flippable ; c:front ui:in-ed-editor-spec .
ui:in-ed-editor-spec a c:Specimen ; c:label "Code editor" ;
    c:help "The text is graph state (c:value; c:original until it is edited), highlighted by its language (c:language: sparql, turtle) under a transparent text area, with line numbers. Typing suggests the prefixes and terms the graph knows and the language's own words (c:CodeWord): Up and Down move, Tab or Enter accepts, Escape closes. The SPARQL workbench's editor is a c:QueryEditor, the same editor in SPARQL." ;
    c:children ( ui:in-ed-turtle ) .
ui:in-ed-turtle a c:CodeEditor ; c:language "turtle" ; c:label "shapes.ttl" ; c:original '''@prefix ex: <https://example.org/people#> .

# Try typing sh: or c:La - the suggestions come from the graph.
ex:PersonShape a sh:NodeShape ; sh:targetClass ex:Person ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] .''' .
