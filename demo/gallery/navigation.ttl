@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .

# Gallery page: Navigation.

ui:gallery-navigation a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-navigation-intro ui:nv-links ui:nv-breadcrumbs ui:nv-pagination ui:nv-stepper ui:nv-navlist ) .
ui:gallery-navigation-intro a c:Heading ; c:label "Navigation" .

# --- NavLink --------------------------------------------------------------------------------------

# A site's navigation as links to the gallery's own pages. The one to this page is current because
# the address says so (nav:current); c:currentPage true would say it outright.
ui:nv-link-home a c:NavLink ; c:href "/" ; c:logo ui:nv-link-mark ;
    c:label "Home" , "Головна"@uk , "Startseite"@de , "الرئيسية"@ar .
ui:nv-link-mark a c:Emblem ; c:viewBox "0 0 16 16" ; c:pathData "M2 7L8 2L14 7V14H2Z" ; c:decorative true .
ui:nv-link-navigation a c:NavLink ; c:href "/components/navigation/" ;
    c:label "Navigation" , "Навігація"@uk , "Navigation"@de , "التنقّل"@ar .
ui:nv-link-components a c:NavLink ; c:href "/components/" ; c:count 3 ;
    c:label "Components" , "Компоненти"@uk , "Komponenten"@de , "المكوّنات"@ar ;
    c:countLabel "new" , "нові"@uk , "neu"@de , "جديدة"@ar .
ui:nv-links-list a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ;
    c:children ( ui:nv-link-home ui:nv-link-navigation ui:nv-link-components ) .
ui:nv-links a c:Flippable ; c:front ui:nv-links-spec .
ui:nv-links-spec a c:Specimen ; c:demonstrates c:NavLink ; c:label "Navigation links" ;
    c:help "A c:Link drawn as a nav list's row: c:href or c:to, an optional c:logo, and c:count, spelled out with c:countLabel for screen readers. The link to the address being shown is aria-current=page by itself (nav:current); c:currentPage says so outright, or false says it is not. Any c:Link does all of this." ;
    c:children ( ui:nv-links-list ) .

# --- Breadcrumbs ----------------------------------------------------------------------------------

# The explicit trail links to the site's own pages (c:href, the addresses the navigation layer reads).
ui:nv-crumb-home c:href "/" ; c:label "Semblance" .
ui:nv-crumb-components c:href "/components/" ;
    c:label "Components" , "Компоненти"@uk , "Komponenten"@de , "المكوّنات"@ar .
ui:nv-crumb-navigation c:href "/components/navigation/" ;
    c:label "Navigation" , "Навігація"@uk , "Navigation"@de , "التنقّل"@ar .
ui:nv-crumb-breadcrumbs c:label "Breadcrumbs" , "Хлібні крихти"@uk , "Brotkrümel"@de , "مسار التنقّل"@ar .
ui:nv-crumbs-explicit a c:Breadcrumbs ;
    c:items ( ui:nv-crumb-home ui:nv-crumb-components ui:nv-crumb-navigation ui:nv-crumb-breadcrumbs ) .
ui:nv-crumbs-derived a c:Breadcrumbs ; c:label "Class path" ; c:of c:ThemeSwitcher ; c:parentProperty rdfs:subClassOf ; c:upTo sem:Component .
ui:nv-crumbs-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:nv-crumbs-explicit ui:nv-crumbs-derived ) .
ui:nv-breadcrumbs a c:Flippable ; c:front ui:nv-breadcrumbs-spec .
ui:nv-breadcrumbs-spec a c:Specimen ; c:demonstrates c:Breadcrumbs ; c:label "Breadcrumbs" ;
    c:help "A trail in a <nav>, the last crumb aria-current=page: explicit c:items, or derived by walking c:parentProperty up from a node (here rdfs:subClassOf from c:ThemeSwitcher). With c:controls and c:property, crumbs navigate (see the Tree on the Data page)." ;
    c:children ( ui:nv-crumbs-col ) .

# --- Pagination -----------------------------------------------------------------------------------

ui:nv-pages-long a c:Pagination ; c:label "Results pages" ; c:page 5 ; c:pages 20 .
ui:nv-pages-short a c:Pagination ; c:label "Short pagination" ; c:page 2 ; c:pages 5 ; sty:size sty:Small .
ui:nv-pages-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:nv-pages-long ui:nv-pages-short ) .
ui:nv-pagination a c:Flippable ; c:front ui:nv-pagination-spec .
ui:nv-pagination-spec a c:Specimen ; c:demonstrates c:Pagination ; c:label "Pagination" ;
    c:help "Previous, next and numbered pages; long runs fold into an ellipsis around the current page. Clicking writes c:page on the component. Sized by sty:size." ;
    c:children ( ui:nv-pages-col ) .

# --- Stepper --------------------------------------------------------------------------------------

ui:nv-step-describe c:label "Describe" ; c:help "A class, a slug, its properties" .
ui:nv-step-render c:label "Render" ; c:help "A function or SPARQL rule" .
ui:nv-step-style c:label "Style" ; c:help "Theme style rules on its parts" .
ui:nv-step-react c:label "React" ; c:help "Reactions to its events" .
ui:nv-step-ship c:label "Ship" ; c:help "A specimen in the gallery" .
ui:nv-stepper-make a c:Stepper ; c:label "Making a component" ;
    c:steps ( ui:nv-step-describe ui:nv-step-render ui:nv-step-style ui:nv-step-react ui:nv-step-ship ) ;
    c:current ui:nv-step-style ; c:navigable true .
ui:nv-stepper a c:Flippable ; c:front ui:nv-stepper-spec .
ui:nv-stepper-spec a c:Specimen ; c:demonstrates c:Stepper ; c:label "Stepper" ;
    c:help "Ordered steps: those before c:current are complete, c:current is aria-current=step, the rest are upcoming. With c:navigable, clicking a step makes it current." ;
    c:children ( ui:nv-stepper-make ) .

# --- NavList --------------------------------------------------------------------------------------

ui:nvSection a owl:ObjectProperty ; rdfs:label "Section"@en ; rdfs:range ui:NvSection .
ui:NvOverview a ui:NvSection ; rdfs:label "Overview"@en ; sem:order 1 .
ui:NvRules a ui:NvSection ; rdfs:label "Rules"@en ; sem:order 2 .
ui:NvTheme a ui:NvSection ; rdfs:label "Theme"@en ; sem:order 3 .
ui:NvBehaviour a ui:NvSection ; rdfs:label "Behaviour"@en ; sem:order 4 .
ui:nv-doc ui:nvSection ui:NvRules .
ui:nv-navlist-sections a c:NavList ; c:controls ui:nv-doc ; c:property ui:nvSection ; c:label "Sections" ;
    c:countProperty ui:nvOpen ; c:countLabel "open questions" .
# How many open questions each section has: shown beside it (c:countProperty), when above zero.
ui:nvOpen a owl:DatatypeProperty ; rdfs:label "Open questions"@en ; rdfs:range xsd:integer .
ui:NvTheme ui:nvOpen 2 .
ui:NvBehaviour ui:nvOpen 12 .
ui:nv-navlist a c:Flippable ; c:front ui:nv-navlist-spec .
ui:nv-navlist-spec a c:Specimen ; c:demonstrates c:NavList ; c:label "Nav list" ;
    c:help "Vertical navigation over one property's values: the options are the individuals in its rdfs:range, ordered by sem:order. The same contract and reaction as c:Segmented. c:countProperty shows a number of each option beside it (here open questions; in the Chat example, unread messages), spelled out for screen readers by c:countLabel." ;
    c:children ( ui:nv-navlist-sections ) .
