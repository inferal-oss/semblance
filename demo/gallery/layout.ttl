@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .

# Gallery page: Layout.

ui:gallery-layout a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-layout-intro ui:ly-surfaces ui:ly-linked ui:ly-tinted ui:ly-dividers ui:ly-grids ui:ly-rows ui:ly-columns ui:ly-fields ui:ly-spacer ui:ly-host-slot ui:ly-panes ui:ly-connect ) .
ui:gallery-layout-intro a c:Heading ; c:label "Layout" .

# --- surfaces and elevation ---
ui:ly-flat a c:Surface ; sty:elevation sty:Flat ; c:children ( ui:ly-flat-over ui:ly-flat-title ui:ly-flat-text ) .
ui:ly-flat-over a c:Text ; sty:textStyle sty:Overline ; c:label "sty:Flat" .
ui:ly-flat-title a c:Text ; sty:textStyle sty:Subtitle ; c:label "Flat" .
ui:ly-flat-text a c:Text ; sty:textStyle sty:Caption ; c:label "On the page: a hairline border, no shadow. The default." .
ui:ly-raised a c:Surface ; sty:elevation sty:Raised ; c:children ( ui:ly-raised-over ui:ly-raised-title ui:ly-raised-text ) .
ui:ly-raised-over a c:Text ; sty:textStyle sty:Overline ; c:label "sty:Raised" .
ui:ly-raised-title a c:Text ; sty:textStyle sty:Subtitle ; c:label "Raised" .
ui:ly-raised-text a c:Text ; sty:textStyle sty:Caption ; c:label "Lifted off the page: cards and panels." .
ui:ly-overlay a c:Surface ; sty:elevation sty:Overlay ; c:children ( ui:ly-overlay-over ui:ly-overlay-title ui:ly-overlay-text ) .
ui:ly-overlay-over a c:Text ; sty:textStyle sty:Overline ; c:label "sty:Overlay" .
ui:ly-overlay-title a c:Text ; sty:textStyle sty:Subtitle ; c:label "Overlay" .
ui:ly-overlay-text a c:Text ; sty:textStyle sty:Caption ; c:label "Floats above everything: menus, popovers, dialogs." .
ui:ly-surfaces-grid a c:Grid ; c:minWidth "200px" ; pos:gap tok:space-5 ; c:children ( ui:ly-flat ui:ly-raised ui:ly-overlay ) .
ui:ly-surfaces a c:Flippable ; c:front ui:ly-surfaces-spec .
ui:ly-surfaces-spec a c:Specimen ; c:demonstrates c:Surface ; c:label "Surface" ;
    c:help "A padded container for c:children. sty:elevation says how far it stands off the page (flat, raised, overlay); pos:inset and pos:gap override its padding and spacing." ;
    c:children ( ui:ly-surfaces-grid ) .

# --- linked cards ---
ui:ly-linked-here a c:LinkedCard ; c:to ui:ly-linked-spec ; c:href "#components/layout" ; c:currentPage true ; c:content ui:ly-linked-here-card .
ui:ly-linked-here-card a c:Card ; c:label "Layout" , "Розкладка"@uk , "Layout"@de , "التخطيط"@ar ; c:badge "12" ;
    c:note "This page: aria-current=page." , "Ця сторінка: aria-current=page."@uk , "Diese Seite: aria-current=page."@de , "هذه الصفحة: aria-current=page."@ar .
ui:ly-linked-to a c:LinkedCard ; c:to ui:ty-links-spec ; c:href "#type" ; c:content ui:ly-linked-to-card .
ui:ly-linked-to-card a c:Card ; c:label "Links" , "Посилання"@uk , "Links"@de , "الروابط"@ar ;
    c:note "c:to a specimen: goes where it is shown." , "c:to на зразок: веде туди, де його видно."@uk , "c:to auf ein Muster: führt dorthin, wo es zu sehen ist."@de , "c:to إلى نموذج: يذهب حيث يُعرض."@ar .
ui:ly-linked-out a c:LinkedCard ; c:href "https://ia2.dev/spec/rdf-html" ;
    c:label "RDF/HTML specification" , "Специфікація RDF/HTML"@uk , "RDF/HTML-Spezifikation"@de , "مواصفة RDF/HTML"@ar ; c:content ui:ly-linked-out-card .
ui:ly-linked-out-card a c:Card ; c:label "RDF/HTML" ;
    c:note "Leaves the site: a new tab, an ↗ mark, a spoken hint." , "Виходить із сайту: нова вкладка, позначка ↗, озвучена підказка."@uk , "Verlässt die Seite: neuer Tab, ein ↗, ein gesprochener Hinweis."@de , "يغادر الموقع: علامة تبويب جديدة وعلامة ↗ وتلميح منطوق."@ar .
ui:ly-linked-grid a c:Grid ; c:minWidth "200px" ; pos:gap tok:space-4 ; c:children ( ui:ly-linked-here ui:ly-linked-to ui:ly-linked-out ) .
ui:ly-linked a c:Flippable ; c:front ui:ly-linked-spec .
ui:ly-linked-spec a c:Specimen ; c:demonstrates c:LinkedCard ; c:label "Linked card" ;
    c:help "A c:Link around one non-interactive component (c:content), here a c:Card, so every theme styles it as a card. c:label, if any, names the link; c:to, c:external and c:currentPage work as on any link. Keep buttons and other links out of it." ;
    c:children ( ui:ly-linked-grid ) .

# --- tinted surfaces ---
ui:ly-tint-accent a c:Surface ; sty:tone sty:Accent ; pos:inset tok:space-4 ; c:children ( ui:ly-tint-accent-t ui:ly-tint-accent-c ) .
ui:ly-tint-accent-t a c:Text ; sty:textStyle sty:Body ; sty:tone sty:Accent ; c:label "Accent" .
ui:ly-tint-accent-c a c:Text ; sty:textStyle sty:Caption ; c:label "Featured content." .
ui:ly-tint-info a c:Surface ; sty:tone sty:Info ; pos:inset tok:space-4 ; c:children ( ui:ly-tint-info-t ui:ly-tint-info-c ) .
ui:ly-tint-info-t a c:Text ; sty:textStyle sty:Body ; sty:tone sty:Info ; c:label "Info" .
ui:ly-tint-info-c a c:Text ; sty:textStyle sty:Caption ; c:label "Background reading." .
ui:ly-tint-success a c:Surface ; sty:tone sty:Success ; pos:inset tok:space-4 ; c:children ( ui:ly-tint-success-t ui:ly-tint-success-c ) .
ui:ly-tint-success-t a c:Text ; sty:textStyle sty:Body ; sty:tone sty:Success ; c:label "Success" .
ui:ly-tint-success-c a c:Text ; sty:textStyle sty:Caption ; c:label "Everything checks out." .
ui:ly-tint-warning a c:Surface ; sty:tone sty:Warning ; pos:inset tok:space-4 ; c:children ( ui:ly-tint-warning-t ui:ly-tint-warning-c ) .
ui:ly-tint-warning-t a c:Text ; sty:textStyle sty:Body ; sty:tone sty:Warning ; c:label "Warning" .
ui:ly-tint-warning-c a c:Text ; sty:textStyle sty:Caption ; c:label "Look before you leap." .
ui:ly-tint-danger a c:Surface ; sty:tone sty:Danger ; pos:inset tok:space-4 ; c:children ( ui:ly-tint-danger-t ui:ly-tint-danger-c ) .
ui:ly-tint-danger-t a c:Text ; sty:textStyle sty:Body ; sty:tone sty:Danger ; c:label "Danger" .
ui:ly-tint-danger-c a c:Text ; sty:textStyle sty:Caption ; c:label "Cannot be undone." .
ui:ly-tinted-grid a c:Grid ; c:minWidth "150px" ; pos:gap tok:space-3 ;
    c:children ( ui:ly-tint-accent ui:ly-tint-info ui:ly-tint-success ui:ly-tint-warning ui:ly-tint-danger ) .
ui:ly-tinted a c:Flippable ; c:front ui:ly-tinted-spec .
ui:ly-tinted-spec a c:Specimen ; c:demonstrates c:Surface ; c:label "Tinted surface" ;
    c:help "sty:tone on a surface tints its background with the tone's soft fill and its border with the tone's border color." ;
    c:children ( ui:ly-tinted-grid ) .

# --- dividers ---
ui:ly-div-plain a c:Divider .
ui:ly-div-label a c:Divider ; c:label "or continue with" .
ui:ly-div-a a c:Text ; c:inline true ; sty:textStyle sty:Body ; c:label "Screen" .
ui:ly-div-v1 a c:Divider ; pos:direction pos:Column .
ui:ly-div-b a c:Text ; c:inline true ; sty:textStyle sty:Body ; c:label "Text" .
ui:ly-div-v2 a c:Divider ; pos:direction pos:Column .
ui:ly-div-c a c:Text ; c:inline true ; sty:textStyle sty:Body ; c:label "Source" .
ui:ly-div-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ;
    c:children ( ui:ly-div-a ui:ly-div-v1 ui:ly-div-b ui:ly-div-v2 ui:ly-div-c ) .
ui:ly-div-above a c:Text ; sty:textStyle sty:Caption ; c:label "Above the rule" .
ui:ly-div-below a c:Text ; sty:textStyle sty:Caption ; c:label "Below the rule" .
ui:ly-div-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ly-div-above ui:ly-div-plain ui:ly-div-below ui:ly-div-label ui:ly-div-row ) .
ui:ly-dividers a c:Flippable ; c:front ui:ly-dividers-spec .
ui:ly-dividers-spec a c:Specimen ; c:demonstrates c:Divider ; c:label "Divider" ;
    c:help "An <hr>, or with a c:label a separator whose label sits in the line. pos:direction pos:Column stands it upright between the items of a row." ;
    c:children ( ui:ly-div-col ) .

# --- grids ---
ui:ly-tile-1 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-1-t ) .
ui:ly-tile-1-t a c:Text ; sty:textStyle sty:Mono ; c:label "1 · Modality" .
ui:ly-tile-2 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-2-t ) .
ui:ly-tile-2-t a c:Text ; sty:textStyle sty:Mono ; c:label "2 · Style" .
ui:ly-tile-3 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-3-t ) .
ui:ly-tile-3-t a c:Text ; sty:textStyle sty:Mono ; c:label "3 · Position" .
ui:ly-tile-4 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-4-t ) .
ui:ly-tile-4-t a c:Text ; sty:textStyle sty:Mono ; c:label "4 · A11y" .
ui:ly-tile-5 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-5-t ) .
ui:ly-tile-5-t a c:Text ; sty:textStyle sty:Mono ; c:label "5 · Behaviour" .
ui:ly-tile-6 a c:Surface ; pos:inset tok:space-4 ; c:children ( ui:ly-tile-6-t ) .
ui:ly-tile-6-t a c:Text ; sty:textStyle sty:Mono ; c:label "6 · Provenance" .
ui:ly-grid-auto-cap a c:Text ; sty:textStyle sty:Overline ; c:label "c:minWidth \"140px\" — as many columns as fit" .
ui:ly-grid-auto a c:Grid ; c:minWidth "140px" ; pos:gap tok:space-3 ;
    c:children ( ui:ly-tile-1 ui:ly-tile-2 ui:ly-tile-3 ui:ly-tile-4 ui:ly-tile-5 ui:ly-tile-6 ) .
ui:ly-grid-three-cap a c:Text ; sty:textStyle sty:Overline ; c:label "c:columns 3 — at most three, wrapping when narrow" .
ui:ly-tile-a a c:Surface ; sty:elevation sty:Raised ; c:children ( ui:ly-tile-a-t ui:ly-tile-a-c ) .
ui:ly-tile-a-t a c:Text ; sty:textStyle sty:Subtitle ; c:label "Components" .
ui:ly-tile-a-c a c:Text ; sty:textStyle sty:Caption ; c:label "Thin vocabularies with rendering rules." .
ui:ly-tile-b a c:Surface ; sty:elevation sty:Raised ; c:children ( ui:ly-tile-b-t ui:ly-tile-b-c ) .
ui:ly-tile-b-t a c:Text ; sty:textStyle sty:Subtitle ; c:label "Layers" .
ui:ly-tile-b-c a c:Text ; sty:textStyle sty:Caption ; c:label "Cross-cutting concerns in later strata." .
ui:ly-tile-c a c:Surface ; sty:elevation sty:Raised ; c:children ( ui:ly-tile-c-t ui:ly-tile-c-c ) .
ui:ly-tile-c-t a c:Text ; sty:textStyle sty:Subtitle ; c:label "Theme" .
ui:ly-tile-c-c a c:Text ; sty:textStyle sty:Caption ; c:label "Tokens and style rules compiled to CSS." .
ui:ly-grid-three a c:Grid ; c:columns 3 ; c:children ( ui:ly-tile-a ui:ly-tile-b ui:ly-tile-c ) .
ui:ly-grids-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ly-grid-auto-cap ui:ly-grid-auto ui:ly-grid-three-cap ui:ly-grid-three ) .
ui:ly-grids a c:Flippable ; c:front ui:ly-grids-spec .
ui:ly-grids-spec a c:Specimen ; c:demonstrates c:Grid ; c:label "Grid" ;
    c:help "c:children as equal tiles. c:minWidth is the narrowest a tile may get; c:columns caps the column count. Both reach the theme as custom properties on the grid's root; pos:gap spaces the tiles." ;
    c:children ( ui:ly-grids-col ) .

# --- columns whose parts line up -------------------------------------------------------------------
# The block-axis counterpart of the rows above: three plans side by side, each a column of parts
# (a name, what it is for, a price), twice. On the left each column stacks its own parts, so the
# name that wraps pushes its text and price below its neighbours'. On the right the grid says
# pos:layout pos:AlignedColumns: each column takes its rows from it (pos:rows pos:RowSubgrid,
# derived) and spans three of them (pos:rowSpan, derived from its three children), so the names
# share a row as tall as the longest, the texts start on one line and the prices on another.

ui:lycf-starter a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycf-starter-name ui:lycf-starter-about ui:lycf-starter-price ) .
ui:lycf-starter-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Starter" , "Стартовий"@uk , "Starter"@de , "المبتدئ"@ar .
ui:lycf-starter-about a c:Text ; sty:textStyle sty:Caption ; c:label "For one person trying it out." .
ui:lycf-starter-price a c:Badge ; c:label "$0" ; sty:tone sty:Accent .
ui:lycf-team a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycf-team-name ui:lycf-team-about ui:lycf-team-price ) .
ui:lycf-team-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Team, billed yearly, with priority support" , "Команда, щорічна оплата, пріоритетна підтримка"@uk , "Team, jährlich abgerechnet, mit bevorzugtem Support"@de , "الفريق، بفوترة سنوية ودعم ذي أولوية"@ar .
ui:lycf-team-about a c:Text ; sty:textStyle sty:Caption ; c:label "For a team that ships every week: shared projects, reviews and an audit log." .
ui:lycf-team-price a c:Badge ; c:label "$12" ; sty:tone sty:Accent .
ui:lycf-studio a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycf-studio-name ui:lycf-studio-about ui:lycf-studio-price ) .
ui:lycf-studio-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Studio" , "Студія"@uk , "Studio"@de , "الاستوديو"@ar .
ui:lycf-studio-about a c:Text ; sty:textStyle sty:Caption ; c:label "For agencies with many clients." .
ui:lycf-studio-price a c:Badge ; c:label "$40" ; sty:tone sty:Accent .
ui:lycg-starter a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycg-starter-name ui:lycg-starter-about ui:lycg-starter-price ) .
ui:lycg-starter-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Starter" , "Стартовий"@uk , "Starter"@de , "المبتدئ"@ar .
ui:lycg-starter-about a c:Text ; sty:textStyle sty:Caption ; c:label "For one person trying it out." .
ui:lycg-starter-price a c:Badge ; c:label "$0" ; sty:tone sty:Accent .
ui:lycg-team a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycg-team-name ui:lycg-team-about ui:lycg-team-price ) .
ui:lycg-team-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Team, billed yearly, with priority support" , "Команда, щорічна оплата, пріоритетна підтримка"@uk , "Team, jährlich abgerechnet, mit bevorzugtem Support"@de , "الفريق، بفوترة سنوية ودعم ذي أولوية"@ar .
ui:lycg-team-about a c:Text ; sty:textStyle sty:Caption ; c:label "For a team that ships every week: shared projects, reviews and an audit log." .
ui:lycg-team-price a c:Badge ; c:label "$12" ; sty:tone sty:Accent .
ui:lycg-studio a c:Stack ; pos:direction pos:Column ; pos:align pos:Start ; pos:gap tok:space-2 ; c:children ( ui:lycg-studio-name ui:lycg-studio-about ui:lycg-studio-price ) .
ui:lycg-studio-name a c:Text ; sty:textStyle sty:Subtitle ; c:label "Studio" , "Студія"@uk , "Studio"@de , "الاستوديو"@ar .
ui:lycg-studio-about a c:Text ; sty:textStyle sty:Caption ; c:label "For agencies with many clients." .
ui:lycg-studio-price a c:Badge ; c:label "$40" ; sty:tone sty:Accent .
ui:lycf-grid a c:Grid ; c:minWidth "140px" ; c:columns 3 ; pos:gap tok:space-4 ; c:children ( ui:lycf-starter ui:lycf-team ui:lycf-studio ) .
ui:lycg-grid a c:Grid ; c:minWidth "140px" ; c:columns 3 ; pos:gap tok:space-4 ; pos:layout pos:AlignedColumns ; c:children ( ui:lycg-starter ui:lycg-team ui:lycg-studio ) .
ui:lycf-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:lycf-grid ui:lycf-note ) .
ui:lycf-note a c:Text ; sty:textStyle sty:Caption ; sty:tone sty:Warning ;
    c:label "Each column stacks its own parts: the name that wraps pushes its text and its price down, so nothing lines up across the plans." .
ui:lycg-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:lycg-grid ui:lycg-note ) .
ui:lycg-note a c:Text ; sty:textStyle sty:Caption ; sty:tone sty:Success ;
    c:label "The grid's columns share its rows, one per part: the longest name sets the name row for all three, and the texts and prices each start on one line." .
ui:lycf-card a c:Card ; c:label "Each column on its own" ; c:badge "c:Grid" ; c:content ui:lycf-body .
ui:lycg-card a c:Card ; c:label "Columns whose parts line up" ; c:badge "pos:AlignedColumns" ; c:content ui:lycg-body .
ui:ly-columns-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ; pos:guides pos:CellGuides ; c:children ( ui:lycf-card ui:lycg-card ) .
ui:ly-columns-guides a c:Segmented ; c:controls ui:ly-columns-body ; c:property pos:guides ; c:label "Guides" .
ui:ly-columns-stage a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:ly-columns-guides ui:ly-columns-body ) .
ui:ly-columns a c:Flippable ; c:front ui:ly-columns-spec .
ui:ly-columns-spec a c:Specimen ; c:demonstrates c:Grid ;
    c:label "Columns whose parts line up" , "Стовпці, чиї частини вирівняні"@uk , "Spalten, deren Teile fluchten"@de , "أعمدة تتحاذى أجزاؤها"@ar ;
    c:help "The same three plans, twice; the dashed boxes are the parts. On the left each column stacks its own parts, so a name that wraps pushes the rest of its column down. On the right the grid is pos:AlignedColumns: every column takes its rows from it and spans as many as it has parts (derived from its children; a c:Card is a header and a body), so part N of each column is in row N. Where the columns wrap, as on a phone, each line has rows of its own, and a column alone on its line is a stack again." ;
    c:children ( ui:ly-columns-stage ) .

# --- fields side by side --------------------------------------------------------------------------
# A row of form fields, twice: a dialling code (a c:Choice), a number with a help line and a city with
# an error. On the left the row aligns its children's ends (pos:align pos:End), and the end of a field
# with help is its help line, so the code's select sits beside the help and the city's input rides
# up. On the right the row is pos:FieldRow: each field takes its rows from it (label, control, help,
# error), so the labels share a row and the controls the next, whatever is under them.
ui:LyfCode a owl:Class ; rdfs:label "Dialling code" .
ui:lyf-code-1 a ui:LyfCode ; rdfs:label "+1" . ui:lyf-code-44 a ui:LyfCode ; rdfs:label "+44" . ui:lyf-code-380 a ui:LyfCode ; rdfs:label "+380" .
ui:lyf-code a rdf:Property ; rdfs:range ui:LyfCode .
ui:lyf-draft ui:lyf-code ui:lyf-code-44 .
ui:lyf-ends-code a c:Choice ; c:controls ui:lyf-draft ; c:property ui:lyf-code ; c:label "Code" , "Код"@uk , "Vorwahl"@de , "الرمز"@ar .
ui:lyf-ends-phone a c:TextField ; c:inputType "tel" ; c:placeholder "20 7946 0958" ;
    c:label "Phone" , "Телефон"@uk , "Telefon"@de , "الهاتف"@ar ;
    c:help "For the courier." .
ui:lyf-ends-city a c:TextField ; c:label "City" , "Місто"@uk , "Stadt"@de , "المدينة"@ar ;
    c:error "Enter a city." .
ui:lyf-ends a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:End ; c:children ( ui:lyf-ends-code ui:lyf-ends-phone ui:lyf-ends-city ) .
ui:lyf-row-code a c:Choice ; c:controls ui:lyf-draft ; c:property ui:lyf-code ; c:label "Code" , "Код"@uk , "Vorwahl"@de , "الرمز"@ar .
ui:lyf-row-phone a c:TextField ; c:inputType "tel" ; c:placeholder "20 7946 0958" ;
    c:label "Phone" , "Телефон"@uk , "Telefon"@de , "الهاتف"@ar ;
    c:help "For the courier." .
ui:lyf-row-city a c:TextField ; c:label "City" , "Місто"@uk , "Stadt"@de , "المدينة"@ar ;
    c:error "Enter a city." .
ui:lyf-row a c:Stack ; pos:layout pos:FieldRow ; pos:gap tok:space-3 ; c:children ( ui:lyf-row-code ui:lyf-row-phone ui:lyf-row-city ) .
ui:lyf-ends-card a c:Card ; c:label "Aligned by their ends" ; c:badge "pos:align pos:End" ; c:content ui:lyf-ends .
ui:lyf-row-card a c:Card ; c:label "Fields side by side" ; c:badge "pos:FieldRow" ; c:content ui:lyf-row .
ui:ly-fields-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ; c:children ( ui:lyf-ends-card ui:lyf-row-card ) .
ui:ly-fields a c:Flippable ; c:front ui:ly-fields-spec .
ui:ly-fields-spec a c:Specimen ; c:demonstrates c:Stack ;
    c:label "Fields side by side" , "Поля поруч"@uk , "Felder nebeneinander"@de , "حقول متجاورة"@ar ;
    c:help "The same three fields, twice. Aligned by their ends, a field's end is its help line or its error, so the controls do not line up. In a pos:FieldRow every field takes its rows from the row - label, control, help, error - so the labels share one line and the controls the next, and a help line or an error under one field moves nothing beside it." ;
    c:children ( ui:ly-fields-body ) .

# --- spacer ---
ui:ly-sp-title a c:Text ; c:inline true ; sty:textStyle sty:Subtitle ; c:label "Projection" .
ui:ly-sp-spacer a c:Spacer .
ui:ly-sp-kbd a c:Kbd ; c:keys ( "⌘" "P" ) .
ui:ly-sp-button a c:Button ; c:label "Open" ; sty:size sty:Small .
ui:ly-sp-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ;
    c:children ( ui:ly-sp-title ui:ly-sp-spacer ui:ly-sp-kbd ui:ly-sp-button ) .
ui:ly-sp-bar a c:Surface ; pos:direction pos:Column ; pos:inset tok:space-3 ; c:children ( ui:ly-sp-row ) .
ui:ly-spacer a c:Flippable ; c:front ui:ly-spacer-spec .
ui:ly-spacer-spec a c:Specimen ; c:demonstrates c:Spacer ; c:label "Spacer" ;
    c:help "Space that grows: in a row it pushes what follows it to the far end." ;
    c:children ( ui:ly-sp-bar ) .

# --- host-owned slot ---
# The site's host mounts a native control into the slot named "gallery-host" (demo/main.ts).
ui:ly-hs-before a c:Text ; sty:textStyle sty:Caption ; c:label "Rendered by Semblance" .
ui:ly-hs-slot a c:HostSlot ; c:slot "gallery-host" .
ui:ly-hs-after a c:Text ; sty:textStyle sty:Caption ; c:label "Rendered by Semblance, after the host's content" .
ui:ly-hs-box a c:Surface ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:ly-hs-before ui:ly-hs-slot ui:ly-hs-after ) .
ui:ly-host-slot a c:Flippable ; c:front ui:ly-host-slot-spec .
ui:ly-host-slot-spec a c:Specimen ; c:demonstrates c:HostSlot ; c:label "Host slot" ;
    c:help "An unstyled place (c:slot names it) where the host application mounts content of its own - here a native slider - inside a Semblance layout. Semblance never touches what the host puts there; c:ProjectionView is the styled kind, for another projection of the graph." ;
    c:children ( ui:ly-hs-box ) .

# --- rows that line up -------------------------------------------------------------------------------
# The same three rows twice. On the left each row is its own flex row: its cells sit wherever its own
# content puts them. On the right the list declares its column tracks once (ui:LedgerColumns, a
# pos:Layout of this page's own) and each row is pos:Subgrid, so cells line up across rows - also the
# last row, which sits inside a c:Switch (switches take no part in layout).

ui:LedgerColumns a pos:Layout ; sem:slug "ledger-columns" ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-template-columns" ; sty:raw "minmax(0, 1fr) auto minmax(4.5rem, auto)" ] ,
                 [ sty:property "column-gap" ; sty:raw "var(--sem-space-4)" ] ,
                 [ sty:property "row-gap" ; sty:raw "var(--sem-space-3)" ] ,
                 [ sty:property "align-items" ; sty:raw "center" ] .
ui:lyRowsState ui:lyRowShown ui:LyShown .
ui:LyShown rdfs:label "Shown" .

ui:lyf-r0 a c:Stack ; pos:direction pos:Row ; pos:justify pos:SpaceBetween ; pos:align pos:Center ; pos:gap tok:space-3 ; c:children ( ui:lyf-r0-about ui:lyf-r0-tag ui:lyf-r0-price ) .
ui:lyf-r0-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyf-r0-name ui:lyf-r0-detail ) .
ui:lyf-r0-name a c:Text ; c:label "Pour-over kettle" .
ui:lyf-r0-detail a c:Text ; sty:textStyle sty:Caption ; c:label "Stainless steel, 1 L" .
ui:lyf-r0-tag a c:Badge ; c:label "In stock" ; sty:tone sty:Success .
ui:lyf-r0-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$34.00" .
ui:lyf-r1 a c:Stack ; pos:direction pos:Row ; pos:justify pos:SpaceBetween ; pos:align pos:Center ; pos:gap tok:space-3 ; c:children ( ui:lyf-r1-about ui:lyf-r1-tag ui:lyf-r1-price ) .
ui:lyf-r1-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyf-r1-name ui:lyf-r1-detail ) .
ui:lyf-r1-name a c:Text ; c:label "Stoneware mug" .
ui:lyf-r1-detail a c:Text ; sty:textStyle sty:Caption ; c:label "350 ml, speckled glaze" .
ui:lyf-r1-tag a c:Badge ; c:label "In stock" ; sty:tone sty:Success .
ui:lyf-r1-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$12.50" .
ui:lyf-r2 a c:Stack ; pos:direction pos:Row ; pos:justify pos:SpaceBetween ; pos:align pos:Center ; pos:gap tok:space-3 ; c:children ( ui:lyf-r2-about ui:lyf-r2-tag ui:lyf-r2-price ) .
ui:lyf-r2-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyf-r2-name ui:lyf-r2-detail ) .
ui:lyf-r2-name a c:Text ; c:label "Single-origin beans" .
ui:lyf-r2-detail a c:Text ; sty:textStyle sty:Caption ; c:label "Ethiopia Guji, 250 g" .
ui:lyf-r2-tag a c:Badge ; c:label "Low" ; sty:tone sty:Warning .
ui:lyf-r2-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$9.50" .
ui:lyg-r0 a c:Stack ; pos:layout pos:Subgrid ; c:children ( ui:lyg-r0-about ui:lyg-r0-tag ui:lyg-r0-price ) .
ui:lyg-r0-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyg-r0-name ui:lyg-r0-detail ) .
ui:lyg-r0-name a c:Text ; c:label "Pour-over kettle" .
ui:lyg-r0-detail a c:Text ; sty:textStyle sty:Caption ; c:label "Stainless steel, 1 L" .
ui:lyg-r0-tag a c:Badge ; c:label "In stock" ; sty:tone sty:Success .
ui:lyg-r0-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$34.00" .
ui:lyg-r1 a c:Stack ; pos:layout pos:Subgrid ; c:children ( ui:lyg-r1-about ui:lyg-r1-tag ui:lyg-r1-price ) .
ui:lyg-r1-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyg-r1-name ui:lyg-r1-detail ) .
ui:lyg-r1-name a c:Text ; c:label "Stoneware mug" .
ui:lyg-r1-detail a c:Text ; sty:textStyle sty:Caption ; c:label "350 ml, speckled glaze" .
ui:lyg-r1-tag a c:Badge ; c:label "In stock" ; sty:tone sty:Success .
ui:lyg-r1-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$12.50" .
ui:lyg-r2 a c:Stack ; pos:layout pos:Subgrid ; c:children ( ui:lyg-r2-about ui:lyg-r2-tag ui:lyg-r2-price ) .
ui:lyg-r2-about a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-1 ; c:children ( ui:lyg-r2-name ui:lyg-r2-detail ) .
ui:lyg-r2-name a c:Text ; c:label "Single-origin beans" .
ui:lyg-r2-detail a c:Text ; sty:textStyle sty:Caption ; c:label "Ethiopia Guji, 250 g" .
ui:lyg-r2-tag a c:Badge ; c:label "Low" ; sty:tone sty:Warning .
ui:lyg-r2-price a c:Text ; c:inline true ; pos:textAlign pos:TextEnd ; c:label "$9.50" .
ui:lyf-list a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:lyf-r0 ui:lyf-r1 ui:lyf-r2 ) .
ui:lyg-list a c:Stack ; pos:layout ui:LedgerColumns ; c:children ( ui:lyg-r0 ui:lyg-r1 ui:lyg-switch ) .
ui:lyg-switch a c:Switch ; c:controls ui:lyRowsState ; c:property ui:lyRowShown ; c:cases ( ui:lyg-case ) .
ui:lyg-case c:when ui:LyShown ; c:content ui:lyg-r2 .
ui:lyf-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:lyf-list ui:lyf-note ) .
ui:lyf-note a c:Text ; sty:textStyle sty:Caption ; sty:tone sty:Warning ;
    c:label "Each row sizes its own cells: the badge and the price start wherever that row's text ends, so they drift from row to row." .
ui:lyg-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:lyg-list ui:lyg-note ) .
ui:lyg-note a c:Text ; sty:textStyle sty:Caption ; sty:tone sty:Success ;
    c:label "The list declares three columns once - name, status, price - and every row places its cells in them: one line for the badges, one edge for the prices." .
ui:lyf-card a c:Card ; c:label "Each row on its own" ; c:badge "pos:Row" ; c:content ui:lyf-body .
ui:lyg-card a c:Card ; c:label "Rows that share columns" ; c:badge "pos:Subgrid" ; c:content ui:lyg-body .
ui:ly-rows-body a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ; pos:guides pos:CellGuides ; c:children ( ui:lyf-card ui:lyg-card ) .
# Guides are graph state too: outline every cell of both lists, or not.
ui:ly-rows-guides a c:Segmented ; c:controls ui:ly-rows-body ; c:property pos:guides ; c:label "Guides" .
ui:ly-rows-stage a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:ly-rows-guides ui:ly-rows-body ) .
ui:ly-rows a c:Flippable ; c:front ui:ly-rows-spec .
ui:ly-rows-spec a c:Specimen ; c:demonstrates c:Stack ; c:label "Rows that line up" ;
    c:help "The same three rows, twice; the dashed boxes are the cells. A stack lays out only its own children, so on the left each row places its cells from its own content. On the right the list declares its column tracks once (a pos:Layout with grid-template-columns) and each row is pos:Subgrid, sharing them - also the last row, inside a c:Switch, which takes no part in layout. A badge stays as wide as its label in its column." ;
    c:children ( ui:ly-rows-stage ) .

# --- connectors: two cards, an arrow kept attached ---
ui:ly-connect-order a c:Card ; c:label "Order" ; c:note "ss:sales, a c:Sheet" .
ui:ly-connect-invoice a c:Card ; c:label "Invoice" ; c:note "Drag me" .
ui:ly-connect-arrow a c:Connector ; c:from ui:ly-connect-order ; c:to ui:ly-connect-invoice ;
    c:label "is billed as" ; sty:tone sty:Accent .
ui:ly-connect-canvas a c:Canvas , c:Resizable ; c:label "Two cards and a connector" ; c:height 240 ;
    c:children ( ui:ly-connect-order ui:ly-connect-invoice ui:ly-connect-arrow ) .
ui:ly-connect a c:Flippable ; c:front ui:ly-connect-spec .
ui:ly-connect-spec a c:Specimen ; c:demonstrates c:Connector , c:Canvas ; c:label "Connector" ;
    c:help "A c:Connector is an arrow c:from one component c:to another, as data: c:route (curved, straight, elbow, an arc to the side), c:arrowheads, c:line, sty:tone and a c:label, which with the ends' names is its text alternative (\"Order → Invoice: is billed as\"). The host measures the ends and draws it, once a frame at most and only when something moved, so it stays attached: drag a card (each sits in a c:CanvasItem, which is c:Draggable), or resize the c:Canvas from its corner. An end that is hidden or out of view hides it. A sheet's dependency arrows and a walkthrough's are connectors too, derived by rules." ;
    c:children ( ui:ly-connect-canvas ) .
