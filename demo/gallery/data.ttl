@prefix iv: <https://semblance.dev/ns/view#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix net: <https://semblance.dev/ns/network#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix iv: <https://semblance.dev/ns/view#> .

# Gallery page: Data.

ui:gallery-data a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-data-intro ui:dt-table ui:dt-stats ui:dt-formula ui:dt-money ui:dt-board ui:dt-gantt ui:dt-tree ui:dt-dl ui:dt-avatars ui:dt-gallery ui:dt-messages ui:dt-timeline ui:dt-legend ui:dt-grid ui:dt-payload ui:dt-rdf ) .
ui:gallery-data-intro a c:Heading ; c:label "Data" .

# --- Table: the project's own component classes, from a SELECT -------------------------------------

ui:q-components a sem:View ;
    rdfs:label "component classes"@en ;
    sem:select """
SELECT ?class ?slug (SAMPLE(?super) AS ?parent)
       (COUNT(DISTINCT ?rendering) AS ?renderings) (COUNT(DISTINCT ?reaction) AS ?reactions)
WHERE {
  ?class rdfs:subClassOf+ sem:Component ; sem:slug ?slug ; rdfs:subClassOf ?super .
  OPTIONAL { ?rendering sem:targets ?class }
  OPTIONAL { ?reaction beh:sourceClass ?class }
}
GROUP BY ?class ?slug""" .

ui:dt-col-class a c:Column ; c:variable "class" ; c:label "Component" .
ui:dt-col-slug a c:Column ; c:variable "slug" ; c:label "Slug" ; c:format "code" .
ui:dt-col-parent a c:Column ; c:variable "parent" ; c:label "Extends" .
ui:dt-col-renderings a c:Column ; c:variable "renderings" ; c:label "Renderings" ; c:align "end" ; c:format "number" .
ui:dt-col-reactions a c:Column ; c:variable "reactions" ; c:label "Reactions" ; c:align "end" ; c:format "number" .

ui:dt-table-component a c:Table ; c:label "Component classes" ; c:query ui:q-components ;
    c:tableColumns ( ui:dt-col-class ui:dt-col-slug ui:dt-col-parent ui:dt-col-renderings ui:dt-col-reactions ) ;
    c:sortColumn ui:dt-col-renderings ; c:sortDescending true ;
    c:emptyText "No component classes found." .
ui:dt-table a c:Flippable ; c:front ui:dt-table-spec .
ui:dt-table-spec a c:Specimen ; c:demonstrates c:Table ; c:label "Table" ;
    c:help "Rows from a SPARQL SELECT over this project's ontology: every component class, what it extends, and how many renderings and reactions it has. Click a header to sort (again to reverse); the sort is graph state on the table." ;
    c:children ( ui:dt-table-component ) .

# --- Stat -----------------------------------------------------------------------------------------

ui:dt-stat-toggle a c:Stat ; c:label "Toggle, end to end" ; c:value 0.48 ; c:unit "ms" ;
    c:delta -12 ; c:deltaUnit "%" ; c:lowerIsBetter true ; c:help "With the Inspector shown." .
ui:dt-stat-members a c:Stat ; c:label "Change-log members" ; c:value 200 ;
    c:help "Retained by the LDES view's policy." .
ui:dt-stat-runs a c:Stat ; c:label "Rule runs per toggle" ; c:value 3 ; c:delta 0 ;
    c:help "The same after 300 more items." .
ui:dt-stat-bundle a c:Stat ; c:label "Single-file build" ; c:value 6.1 ; c:unit "MB" ;
    c:delta 4.2 ; c:deltaUnit "%" ; c:lowerIsBetter true ; c:help "dist-single/semblance.html" .
ui:dt-stats a c:Flippable ; c:front ui:dt-stats-spec .
ui:dt-stats-spec a c:Specimen ; c:demonstrates c:Stat ; c:label "Stat" ;
    c:help "A key figure with its unit and a signed change. The trend is toned good or bad; c:lowerIsBetter flips which, for costs like latency or size." ;
    c:children ( ui:dt-stat-toggle ui:dt-stat-members ui:dt-stat-runs ui:dt-stat-bundle ) .

# --- Formula: a Stat whose value is a query -------------------------------------------------------

ui:q-component-count a sem:View , iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:dt-formula-classes ; rdfs:label "number of component classes" ;
    sem:select """SELECT (COUNT(DISTINCT ?class) AS ?value) WHERE { ?class rdfs:subClassOf+ sem:Component ; sem:slug ?slug }""" .
ui:q-reactionless a sem:View , iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:dt-formula-quiet ; rdfs:label "component classes without a reaction" ;
    sem:select """
SELECT ?value ?tone WHERE {
  { SELECT (COUNT(DISTINCT ?class) AS ?value) WHERE {
      ?class rdfs:subClassOf+ sem:Component ; sem:slug ?slug FILTER NOT EXISTS { ?reaction beh:sourceClass ?class } } }
  BIND(IF(?value > 40, sty:Warning, sty:Success) AS ?tone)
}""" .
ui:dt-formula-classes a c:Stat ; c:label "Component classes" ; c:valueQuery ui:q-component-count ; c:help "COUNT over the ontology." .
ui:dt-formula-quiet a c:Stat ; c:label "Without reactions" ; c:valueQuery ui:q-reactionless ; c:help "Toned by the query (?tone)." .
ui:dt-formula a c:Flippable ; c:front ui:dt-formula-spec .
ui:dt-formula-spec a c:Specimen ; c:demonstrates c:Stat ; c:label "Formula (c:valueQuery)" ;
    c:help "Any component's value may be a SELECT: the first row's ?value becomes its c:value, and ?tone its tone. It re-runs when its c:dataset changes; these count this project's own component classes." ;
    c:children ( ui:dt-formula-classes ui:dt-formula-quiet ) .

# --- Money: an amount, written the viewer's way -----------------------------------------------------

ui:dt-money-eur a c:Money ; c:value 1249.00 ; c:currency "EUR" ; sty:textStyle sty:Title .
ui:dt-money-uah a c:Money ; c:value 52990 ; c:currency "UAH" .
ui:dt-money-usd a c:Money ; c:value 19.99 ; c:currency "USD" .
ui:dt-money-jpy a c:Money ; c:value 4800 ; c:currency "JPY" .
ui:dt-money a c:Flippable ; c:front ui:dt-money-spec .
ui:dt-money-spec a c:Specimen ; c:demonstrates c:Money ; c:label "Money" ;
    c:help "An amount and an ISO 4217 currency, formatted for the viewer's locale: switch the language in the display settings and the grouping, decimals and symbol follow. The <data> element keeps the machine-readable amount." ;
    c:children ( ui:dt-money-eur ui:dt-money-uah ui:dt-money-usd ui:dt-money-jpy ) .

# --- Board: items in lanes, a lane with a limit ------------------------------------------------------

ui:stage rdfs:label "Stage" ; rdfs:range ui:Stage .
ui:StageBuild a ui:Stage ; rdfs:label "Build" ; sem:order 1 .
ui:StageReview a ui:Stage ; rdfs:label "Review" ; sem:order 2 .
ui:StageShipped a ui:Stage ; rdfs:label "Shipped" ; sem:order 3 .
ui:ReviewLimit a sh:NodeShape ; sh:targetNode ui:StageReview ;
    sh:property [ sh:path [ sh:inversePath ui:stage ] ; sh:maxCount 2 ] .
ui:dt-change-1 rdfs:label "Formula rule" ; ui:stage ui:StageShipped ; ui:by "Ada Lovelace" ; ui:order 1 .
ui:dt-change-2 rdfs:label "Money component" ; ui:stage ui:StageReview ; ui:by "Grace Hopper" ; ui:order 2 .
ui:dt-change-3 rdfs:label "Board lanes" ; ui:stage ui:StageReview ; ui:by "Alan Kay" ; ui:order 3 .
ui:dt-change-4 rdfs:label "Board keyboard moves" ; ui:stage ui:StageBuild ; ui:by "Barbara Liskov" ; ui:order 4 .
ui:dt-board-pipeline a c:Board ; c:label "Release pipeline" ;
    c:property ui:stage ; c:cardTitle rdfs:label ; c:cardPerson ui:by ; c:cardOrder ui:order ;
    c:card ui:dt-change-1 , ui:dt-change-2 , ui:dt-change-3 , ui:dt-change-4 .
ui:dt-board a c:Flippable ; c:front ui:dt-board-spec .
ui:dt-board-spec a c:Specimen ; c:demonstrates c:Board , c:BoardCard ; c:label "Board" ;
    c:help "Items in lanes: the lanes are the range of c:property (here ui:stage), each item goes where its value points. Move a card with its arrows, or focus it and use ← →. Review is limited to two by a SHACL shape (sh:maxCount on the inverse path), so a third is refused." ;
    c:children ( ui:dt-board-pipeline ) .

# --- Tree: the component class hierarchy ----------------------------------------------------------

ui:browsing a owl:ObjectProperty ; rdfs:label "browsing"@en .
ui:dt-browse ui:browsing c:NavList .

ui:dt-tree-crumbs a c:Breadcrumbs ; c:label "Class path" ;
    c:controls ui:dt-browse ; c:property ui:browsing ; c:parentProperty rdfs:subClassOf ; c:upTo sem:Component .
ui:dt-tree-classes a c:Tree ; c:label "Component classes" ;
    c:of sem:Component ; c:parentProperty rdfs:subClassOf ; c:detailProperty sem:slug ;
    c:expandedNode sem:Component , c:Segmented ;
    c:controls ui:dt-browse ; c:property ui:browsing .
ui:dt-tree-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:dt-tree-crumbs ui:dt-tree-classes ) .
ui:dt-tree a c:Flippable ; c:front ui:dt-tree-spec .
ui:dt-tree-spec a c:Specimen ; c:demonstrates c:Tree ; c:label "Tree" ;
    c:help "Every component class in the project, under sem:Component: a node's children are the classes that are rdfs:subClassOf it. The twisty opens a node (c:expandedNode on the tree); a label selects it, and the breadcrumbs above follow the selection and navigate back up." ;
    c:children ( ui:dt-tree-col ) .

# --- DescriptionList ------------------------------------------------------------------------------

ui:dt-dl-class a c:DescriptionList ; c:of c:Table ; c:fields ( sem:slug rdfs:subClassOf rdfs:comment ) .
ui:dt-dl-item-store c:label "Store" ; c:value "Oxigraph (SPARQL), N3.js fallback" .
ui:dt-dl-item-strata c:label "Strata" ; c:value "0 components · 10 a11y · 20 style · 95 source" .
ui:dt-dl-item-log c:label "Change log" ; c:value "LDES, latest 200 members" .
ui:dt-dl-item-ids c:label "Identity" ; c:value "<focus>/~<local>, never blank nodes" .
ui:dt-dl-explicit a c:DescriptionList ; c:items ( ui:dt-dl-item-store ui:dt-dl-item-strata ui:dt-dl-item-log ui:dt-dl-item-ids ) .
ui:dt-dl-components a c:DescriptionList ; c:items ( ui:dt-dl-review ui:dt-dl-resource ) .
ui:dt-dl-review c:label "Review"@en , "Перевірка"@uk , "Prüfung"@de , "مراجعة"@ar ; c:content ui:dt-dl-review-body .
ui:dt-dl-review-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:dt-dl-review-text ui:dt-dl-approved ) .
ui:dt-dl-review-text a c:Text ; c:label "Components can be values too."@en ,
    "Компоненти також можуть бути значеннями."@uk , "Auch Komponenten können Werte sein."@de ,
    "يمكن أن تكون المكونات قيمًا أيضًا."@ar .
ui:dt-dl-approved a c:ToggleSwitch ; c:checked false ; c:label "Approved"@en ,
    "Схвалено"@uk , "Genehmigt"@de , "تمت الموافقة"@ar .
ui:dt-dl-resource c:label "Resource"@en , "Ресурс"@uk , "Ressource"@de , "المورد"@ar ;
    c:value "Framework home" ; c:content ui:dt-dl-home .
ui:dt-dl-home a c:Link ; c:href "https://semblance.dev/" ;
    c:label "Open framework home"@en , "Відкрити головну сторінку"@uk , "Startseite öffnen"@de , "افتح الصفحة الرئيسية"@ar .
ui:dt-dl a c:Flippable ; c:front ui:dt-dl-spec .
ui:dt-dl-spec a c:Specimen ; c:demonstrates c:DescriptionList ; c:label "Description list" ;
    c:help "Key / value pairs: the values of chosen properties on a node (here the class c:Table itself), or explicit items. An item can supply c:content for a component value, including links, nested lists and controls. Screen shows the component; Text uses a c:value summary when given, or the component otherwise." ;
    c:children ( ui:dt-dl-class ui:dt-dl-explicit ui:dt-dl-components ) .

# --- Avatar and AvatarGroup -----------------------------------------------------------------------

