    c:image "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%237c6cf6'/%3E%3Cstop offset='1' stop-color='%232a78d6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='40' height='40' fill='url(%23g)'/%3E%3Ccircle cx='14' cy='15' r='4' fill='white'/%3E%3Ccircle cx='27' cy='25' r='4' fill='white'/%3E%3Cpath d='M14 15L27 25' stroke='white' stroke-width='2'/%3E%3C/svg%3E" .
ui:dt-av-1 a c:Avatar ; c:label "Alan Kay" .
ui:dt-av-2 a c:Avatar ; c:label "Ted Nelson" .
ui:dt-av-3 a c:Avatar ; c:label "Douglas Engelbart" .
ui:dt-av-4 a c:Avatar ; c:label "Vannevar Bush" .
ui:dt-av-5 a c:Avatar ; c:label "Ivan Sutherland" .
ui:dt-av-6 a c:Avatar ; c:label "Adele Goldberg" .
ui:dt-av-7 a c:Avatar ; c:label "Barbara Liskov" .
ui:dt-av-group a c:AvatarGroup ; c:label "Reviewers" ; c:max 4 ;
    c:children ( ui:dt-av-1 ui:dt-av-2 ui:dt-av-3 ui:dt-av-4 ui:dt-av-5 ui:dt-av-6 ui:dt-av-7 ) .
ui:dt-avatars a c:Flippable ; c:front ui:dt-avatars-spec .
ui:dt-avatars-spec a c:Specimen ; c:demonstrates c:Avatar , c:AvatarGroup ; c:label "Avatar" ;
    c:help "Initials on a hue derived from the label (the same name always gets the same color), or an image; sized by sty:size. A group overlaps them and counts the rest past c:max." ;
    c:children ( ui:dt-av-ada ui:dt-av-tim ui:dt-av-grace ui:dt-av-image ui:dt-av-group ) .

# --- Gallery: images in a layout the radio cards pick -----------------------------------------------

# The pictures (shared with the Overlays page's lightbox): a URL, what each shows, a caption, a size.
ui:photo-harbour a c:Picture ; c:image "photos/harbour.jpg" ; c:width 1200 ; c:height 800 ;
    c:alt "A pier with lamps runs into a calm harbour at dusk, sailboats in silhouette" ; c:caption "Harbour at dusk" .
ui:photo-lake a c:Picture ; c:image "photos/lake.jpg" ; c:width 1200 ; c:height 900 ;
    c:alt "Snow-capped mountains and a pine forest reflected in a still lake" ; c:caption "Mountain lake" .
ui:photo-lighthouse a c:Picture ; c:image "photos/lighthouse.jpg" ; c:width 800 ; c:height 1200 ;
    c:alt "A red and white lighthouse on dark rocks above breaking waves" ; c:caption "Lighthouse" .
ui:photo-dunes a c:Picture ; c:image "photos/dunes.webp" ; c:width 1200 ; c:height 675 ;
    c:alt "Rolling sand dunes in warm afternoon light, three walkers on a crest" ; c:caption "Dunes" .
ui:photo-forest a c:Picture ; c:image "photos/forest.jpg" ; c:width 1200 ; c:height 1200 ;
    c:alt "A sandy path leads into layers of pine forest in morning haze" ; c:caption "Forest path" .
ui:photo-city a c:Picture ; c:image "photos/city.jpg" ; c:width 1200 ; c:height 800 ;
    c:alt "City towers with lit windows under a starry sky and a crescent moon" ; c:caption "City at night" .

# Lightboxes are fixed to the viewport, so they live on the desktop, like dialogs.
ui:desktop c:hosts ui:dt-lightbox .
ui:dt-photos a c:Gallery ; c:label "Places" ; c:galleryLayout c:PileLayout ; c:lightbox ui:dt-lightbox ;
    c:images ( ui:photo-harbour ui:photo-lake ui:photo-lighthouse ui:photo-dunes ui:photo-forest ui:photo-city ) .
ui:dt-lightbox a c:Lightbox ; c:of ui:dt-photos .
ui:dt-layout a c:Segmented ; c:controls ui:dt-photos ; c:property c:galleryLayout .
ui:dt-gallery a c:Flippable ; c:front ui:dt-gallery-spec .
ui:dt-gallery-spec a c:Specimen ; c:demonstrates c:Gallery ; c:label "Gallery" ;
    c:help "Images in a layout (c:galleryLayout), switched live here by a segmented control over the property: a carousel (swipe, scroll, arrows or a dot per image), a grid that fits its columns to the width, or a pile of prints - hover or focus one and it straightens and lifts while the others fan out. With a c:lightbox, every image opens it." ;
    c:children ( ui:dt-layout ui:dt-photos ) .

# --- MessageList: a thread of ActivityStreams notes -----------------------------------------------

ui:dt-msg-ada rdfs:label "Ada Lovelace" .
ui:dt-msg-alan rdfs:label "Alan Kay" .
ui:dt-msg-1 a as:Note ; as:attributedTo ui:dt-msg-alan ; as:published "2024-05-14T10:02:00Z"^^xsd:dateTime ;
    as:content "Is the thread member-wise, like the todo list?" .
ui:dt-msg-2 a as:Note ; as:attributedTo ui:dt-msg-ada ; as:published "2024-05-14T10:03:00Z"^^xsd:dateTime ;
    as:content "Yes: each note is one c:item, evaluated on its own. A new note costs one message, however long the thread." .
ui:dt-msg-3 a as:Note ; as:attributedTo ui:dt-msg-alan ; as:published "2024-05-14T10:05:00Z"^^xsd:dateTime ;
    as:content "And this one is sensitive: private mode (⌘⇧H) hides it." ; <https://semblance.dev/ns/privacy#sensitive> true .
ui:dt-msg-4 a as:Note ; as:attributedTo ui:dt-msg-ada ; as:published "2024-05-14T10:06:00Z"^^xsd:dateTime ;
    c:content ui:dt-msg-review .
ui:dt-msg-review a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:dt-msg-review-text ui:dt-msg-review-toggle ) .
ui:dt-msg-review-text a c:Text ; c:label "A message can contain components too."@en ,
    "Повідомлення також може містити компоненти."@uk , "Eine Nachricht kann auch Komponenten enthalten."@de ,
    "يمكن أن تحتوي الرسالة على مكونات أيضًا."@ar .
ui:dt-msg-review-toggle a c:ToggleSwitch ; c:checked false ; c:label "Reviewed"@en ,
    "Переглянуто"@uk , "Geprüft"@de , "تمت المراجعة"@ar .
ui:dt-messages-thread a c:MessageList ; c:label "A thread" ; c:viewer ui:dt-msg-ada ;
    c:item ui:dt-msg-1 , ui:dt-msg-2 , ui:dt-msg-3 , ui:dt-msg-4 .
ui:dt-messages a c:Flippable ; c:front ui:dt-messages-spec .
ui:dt-messages-spec a c:Specimen ; c:demonstrates c:MessageList , c:Message ; c:label "Message list" ;
    c:help "Messages as data: as:Note nodes with as:attributedTo and as:published, the thread's c:item. Each becomes a minted c:Message - the author's avatar, name and time - in order of publication; c:viewer's own are at the end. A note can use as:content for text or c:content for a component body, including interactive controls. When both are present, Screen shows the component and Text uses the summary. The list is a log (role=log), and a prv:sensitive note is hidden in private mode. The Chat example is built on it." ;
    c:children ( ui:dt-messages-thread ) .

# --- Gantt: dated tasks from a maintained view ---------------------------------------------------

ui:dt-gantt-prefixes sh:declare [ sh:prefix "ui" ; sh:namespace "https://semblance.dev/demo#"^^xsd:anyURI ] .
ui:dt-gantt-a rdfs:label "Sketch the interface" ; ui:ganttStart "2026-10-19"^^xsd:date ; ui:ganttEnd "2026-10-27"^^xsd:date ;
    ui:ganttHref "/docs" ;
    ui:ganttBaselineStart "2026-10-19"^^xsd:date ; ui:ganttBaselineEnd "2026-10-24"^^xsd:date ; ui:ganttTone sty:Success .
ui:dt-gantt-b rdfs:label "Build the component" ; ui:ganttStart "2026-10-29"^^xsd:date ; ui:ganttEnd "2026-11-09"^^xsd:date ;
    ui:ganttUncertainty "2026-11-13"^^xsd:date ; ui:ganttDependsOn ui:dt-gantt-a ; ui:ganttTone sty:Accent .
ui:dt-gantt-d rdfs:label "Write the docs" ; ui:ganttStart "2026-11-02"^^xsd:date ; ui:ganttEnd "2026-11-12"^^xsd:date ;
    ui:ganttDependsOn ui:dt-gantt-a ; ui:ganttTone sty:Info .
ui:dt-gantt-c rdfs:label "Review" ; ui:ganttStart "2026-11-17"^^xsd:date ; ui:ganttEnd "2026-11-17"^^xsd:date ;
    ui:ganttDependsOn ui:dt-gantt-b , ui:dt-gantt-d ; ui:ganttMilestone true ; ui:ganttTone sty:Warning .
ui:dt-gantt-view a sem:View , iv:View ; iv:materialize iv:Graph ; rdfs:label "Example plan" ; sem:select """
SELECT ?task ?label ?start ?end ?baselineStart ?baselineEnd ?uncertainty ?dependsOn ?milestone ?tone ?href WHERE {
  ?task ui:ganttStart ?start ; ui:ganttEnd ?end ; rdfs:label ?label .
  OPTIONAL { ?task ui:ganttBaselineStart ?baselineStart }
  OPTIONAL { ?task ui:ganttBaselineEnd ?baselineEnd }
  OPTIONAL { ?task ui:ganttUncertainty ?uncertainty }
  OPTIONAL { ?task ui:ganttDependsOn ?dependsOn }
  OPTIONAL { ?task ui:ganttMilestone ?milestone }
  OPTIONAL { ?task ui:ganttTone ?tone }
  OPTIONAL { ?task ui:ganttHref ?href }
}
ORDER BY ?start ?task""" .
ui:dt-gantt-chart a c:GanttChart ; c:label "Release plan" ; c:view ui:dt-gantt-view .
ui:dt-gantt a c:Flippable ; c:front ui:dt-gantt-spec .
ui:dt-gantt-spec a c:Specimen ; c:demonstrates c:GanttChart ; c:label "Gantt chart" ;
    c:help "Dated tasks from a maintained view (iv:View, iv:materialize iv:Graph): bars, a baseline (dashed), the latest end (a whisker), a milestone, and lead lines from predecessors, on a scale of months that scrolls. Each task says its dates in words, for a screen reader and the Text modality. In a right-to-left language, time runs right to left." ;
    c:children ( ui:dt-gantt-chart ) .

# --- Timeline: the change log -------------------------------------------------------------------

ui:dt-timeline-log a c:Timeline ; c:label "Recent events" ; c:of beh:ChangeLog ; c:limit 6 ;
    c:emptyText "No events yet: sort the table or open the tree, and they appear here." .
ui:dt-timeline a c:Flippable ; c:front ui:dt-timeline-spec .
ui:dt-timeline-spec a c:Specimen ; c:demonstrates c:Timeline , c:TimelineItem ; c:label "Timeline" ;
    c:help "The newest members of the change-log LDES, read from its head (beh:latest, then beh:previous): what happened, to which component, when, and the size of the change. Members are immutable, so each is rendered once." ;
    c:children ( ui:dt-timeline-log ) .

# --- legend: categories drawn in their colors ----------------------------------------------------------

ui:dt-legend-kinds a c:Legend ; c:label "Activity kinds" ; c:of net:Kind .
ui:dt-legend-statuses a c:Legend ; c:label "Statuses" ; c:items ( net:Pending net:Complete net:Failed net:Open net:Closed ) .
ui:dt-legend a c:Flippable ; c:front ui:dt-legend-spec .
ui:dt-legend-spec a c:Specimen ; c:demonstrates c:Legend ; c:label "Legend" ;
    c:help "Swatches and labels for categories: the instances of a class by sem:order (network activity kinds, each drawn in its c:swatch series color), or an explicit list (statuses, which are states and so carry a sty:tone instead)." ;
    c:children ( ui:dt-legend-kinds ui:dt-legend-statuses ) .
