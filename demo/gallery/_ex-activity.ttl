@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix act: <https://semblance.dev/demo/activity#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# Your activity: a live dashboard over your own interactions.
#
# Every click, keystroke and selection on this site is an RDF event, appended to the change log:
# beh:ChangeLog, a Linked Data Event Stream (ontology/layers/behaviour.ttl) that keeps the newest
# 200 members. This dashboard is SPARQL SELECTs over that stream (sem:View), each shown by an
# existing component. They follow the stream (c:dataset beh:ChangeLog), so each new event re-runs
# them - but only while this page is shown.
# =================================================================================================

ui:ex-activity-prefixes sh:declare [ sh:prefix "act" ; sh:namespace "https://semblance.dev/demo/activity#"^^xsd:anyURI ] .

# --- when you opened this page --------------------------------------------------------------------
# Choosing "Your activity" in the examples' navigation is itself an event. This reaction, on the
# same click, notes its sequence number and time on act:visit; "since you opened" counts the
# members after it, and the timeline's minutes are counted from it.

act:MarkOpened a beh:Reaction ; beh:when beh:Click ; beh:source ui:examplesNav ;
    beh:deletes """
CONSTRUCT { act:visit act:since ?oldSeq ; act:openedAt ?oldAt }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:selects ui:ExActivity .
        { act:visit act:since ?oldSeq } UNION { act:visit act:openedAt ?oldAt } }""" ;
    beh:inserts """
CONSTRUCT { act:visit act:since ?seq ; act:openedAt ?at }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:selects ui:ExActivity .
        $event beh:sequence ?seq ; beh:at ?at }""" .

# --- the views: SELECTs over the stream -------------------------------------------------------------
# Each reads the stream's members once (tree:member, then the member's own triples); the log is
# bounded, so none of them grows with the session.

act:SinceOpened a sem:View ; rdfs:label "events since you opened this page" ;
    sem:select """
SELECT (COUNT(?m) AS ?value) WHERE {
  OPTIONAL { act:visit act:since ?since }
  beh:ChangeLog tree:member ?m . ?m beh:sequence ?seq
  FILTER(!BOUND(?since) || ?seq > ?since)
}""" .

act:InTheLog a sem:View ; rdfs:label "events in the log" ;
    sem:select """SELECT (COUNT(?m) AS ?value) WHERE { beh:ChangeLog tree:member ?m }""" .

act:Touched a sem:View ; rdfs:label "components that got events" ;
    sem:select """SELECT (COUNT(DISTINCT ?target) AS ?value) WHERE { beh:ChangeLog tree:member ?m . ?m beh:target ?target }""" .

act:Changed a sem:View ; rdfs:label "triples the events changed" ;
    sem:select """SELECT (SUM(?added + ?removed) AS ?value) WHERE { beh:ChangeLog tree:member ?m . ?m beh:added ?added ; beh:removed ?removed }""" .

# Events per type: the event's class, by its local name (beh:Click is "Click").
act:PerType a sem:View ; rdfs:label "events per type" ;
    sem:select """
SELECT ?type (COUNT(?m) AS ?value) WHERE {
  beh:ChangeLog tree:member ?m . ?m a ?class .
  BIND(REPLACE(STR(?class), "^.*[#/]", "") AS ?type)
}
GROUP BY ?type
ORDER BY DESC(?value) ?type""" .

# Events per minute, counted from when you opened this page (minutes before it are negative).
# A minute is a number: ((year * 12 + month) * 31 + day) * 1440 + hours * 60 + minutes, in UTC.
act:PerMinute a sem:View ; rdfs:label "events per minute" ;
    sem:select """
SELECT ?minute ?series (COUNT(?m) AS ?value) WHERE {
  OPTIONAL { act:visit act:openedAt ?opened }
  BIND(COALESCE(?opened, NOW()) AS ?zero)
  BIND(((YEAR(?zero) * 12 + MONTH(?zero)) * 31 + DAY(?zero)) * 1440 + HOURS(?zero) * 60 + MINUTES(?zero) AS ?z)
  beh:ChangeLog tree:member ?m . ?m beh:at ?t .
  BIND(((YEAR(?t) * 12 + MONTH(?t)) * 31 + DAY(?t)) * 1440 + HOURS(?t) * 60 + MINUTES(?t) - ?z AS ?minute)
  BIND("events" AS ?series)
}
GROUP BY ?minute ?series""" .

# Most-used components: which component classes the events were addressed to (beh:target).
act:PerComponent a sem:View ; rdfs:label "events per component class" ;
    sem:select """
SELECT ?component (COUNT(?m) AS ?events) (COUNT(DISTINCT ?target) AS ?instances) WHERE {
  beh:ChangeLog tree:member ?m . ?m beh:target ?target .
  ?target a ?class . ?class rdfs:subClassOf+ sem:Component ; sem:slug ?component .
}
GROUP BY ?component
ORDER BY DESC(?events) ?component
LIMIT 6""" .

# --- the dashboard ---------------------------------------------------------------------------------

ui:ex-activity a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:ex-activity-intro ui:ex-activity-figures ui:ex-activity-charts ui:ex-activity-lists ) .
ui:ex-activity-intro a c:Text ;
    c:label "Your own clicks and keystrokes on this site, as a dashboard: each interaction is a member of the change-log event stream, and every figure, chart and list below is a SPARQL query over it. Use the page - sort the table, switch the theme - and watch it count." .

ui:ex-activity-figures a c:Grid ; c:minWidth "170px" ; pos:gap tok:space-4 ;
    c:children ( ui:ex-activity-since ui:ex-activity-total ui:ex-activity-touched ui:ex-activity-changed ) .
ui:ex-activity-since a c:Stat ; c:label "Since you opened this page" ; c:unit "events" ;
    c:valueQuery act:SinceOpened ; c:dataset beh:ChangeLog .
ui:ex-activity-total a c:Stat ; c:label "In the log" ; c:unit "events" ; c:help "The newest 200 are kept (ldes:amount)." ;
    c:valueQuery act:InTheLog ; c:dataset beh:ChangeLog .
ui:ex-activity-touched a c:Stat ; c:label "Components involved" ;
    c:valueQuery act:Touched ; c:dataset beh:ChangeLog .
ui:ex-activity-changed a c:Stat ; c:label "Triples changed" ; c:help "Added plus removed, by those events." ;
    c:valueQuery act:Changed ; c:dataset beh:ChangeLog .

ui:ex-activity-charts a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ;
    c:children ( ui:ex-activity-types-card ui:ex-activity-time-card ) .
ui:ex-activity-types-card a c:Flippable ; c:front ui:ex-activity-types-panel .
ui:ex-activity-types-panel a c:Card ; c:label "Events by type" ; c:badge "GROUP BY" ; c:content ui:ex-activity-types .
ui:ex-activity-types a c:BarChart ; rdfs:label "Events by type" ;
    c:view act:PerType ; c:dataset beh:ChangeLog ;
    c:categoryVariable "type" ; c:valueVariable "value" .
ui:ex-activity-time-card a c:Flippable ; c:front ui:ex-activity-time-panel .
ui:ex-activity-time-panel a c:Card ; c:label "Events per minute" ; c:badge "beh:at" ;
    c:note "Minutes since you opened this page (earlier ones are negative); log scale." ;
    c:content ui:ex-activity-time .
act:eventsSeries c:key "events" ; rdfs:label "events per minute" .
ui:ex-activity-time a c:LineChart ; rdfs:label "Events per minute" ;
    c:view act:PerMinute ; c:dataset beh:ChangeLog ;
    c:categoryVariable "minute" ; c:seriesVariable "series" ; c:valueVariable "value" ;
    c:legend ( act:eventsSeries ) ;
    c:emptyText "The line appears once your events span two minutes - keep using the page." .

ui:ex-activity-lists a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ;
    c:children ( ui:ex-activity-components-card ui:ex-activity-recent-card ) .
ui:ex-activity-components-card a c:Flippable ; c:front ui:ex-activity-components-panel .
ui:ex-activity-components-panel a c:Card ; c:label "Most-used components" ; c:badge "beh:target" ;
    c:note "The component classes your events were addressed to." ; c:content ui:ex-activity-components .
ui:ex-activity-col-component a c:Column ; c:variable "component" ; c:label "Component" ; c:format "code" .
ui:ex-activity-col-events a c:Column ; c:variable "events" ; c:label "Events" ; c:align "end" ; c:format "number" .
ui:ex-activity-col-instances a c:Column ; c:variable "instances" ; c:label "Instances" ; c:align "end" ; c:format "number" .
ui:ex-activity-components a c:Table ; c:label "Most-used components" ; c:query act:PerComponent ; c:dataset beh:ChangeLog ;
    c:tableColumns ( ui:ex-activity-col-component ui:ex-activity-col-events ui:ex-activity-col-instances ) ;
    c:emptyText "No events yet." .
ui:ex-activity-recent-card a c:Card ; c:label "Newest events" ; c:badge "beh:latest" ;
    c:note "Read from the head of the log, one step per event." ; c:content ui:ex-activity-recent .
ui:ex-activity-recent a c:Timeline ; c:label "Newest events" ; c:of beh:ChangeLog ; c:limit 6 ;
    c:emptyText "Nothing yet." .

# --- how it works ---------------------------------------------------------------------------------

ui:ex-activity-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-activity-w1 ui:ex-activity-w2 ui:ex-activity-w3 ui:ex-activity-w4 ui:ex-activity-w5 ) .

ui:ex-activity-w1 a c:WalkthroughStep ; rdfs:label "Your interactions are already data" ;
    c:children ( "The event bus records each interaction as an RDF event - its class (" ui:ex-activity-m-click ", " ui:ex-activity-m-input "), the component it was addressed to, when, and how many triples it changed - and appends it to " ui:ex-activity-m-log ", a Linked Data Event Stream whose retention keeps the newest 200 members. No code of this example records anything." ) .
ui:ex-activity-w2 a c:WalkthroughStep ; rdfs:label "Figures are queries over the stream" ;
    c:children ( "Each figure is a " ui:ex-activity-m-Stat " that takes its value from a SELECT: " ui:ex-activity-m-total " shows " ui:ex-activity-m-intheLog ", a COUNT of the stream's members; " ui:ex-activity-m-touched " counts the distinct components events were addressed to, " ui:ex-activity-m-changed " sums what they changed. The queries are sem:View s in this file." ) .
ui:ex-activity-w3 a c:WalkthroughStep ; rdfs:label "Charts, a table and a timeline" ;
    c:children ( ui:ex-activity-m-types " draws " ui:ex-activity-m-perType ", a GROUP BY over each event's class; " ui:ex-activity-m-time " draws " ui:ex-activity-m-perMinute " counted from when you opened the page; " ui:ex-activity-m-table " lists " ui:ex-activity-m-perComponent ". The newest events are " ui:ex-activity-m-recent ", a " ui:ex-activity-m-Timeline " that walks back from the stream's head one step per event." ) .
ui:ex-activity-w4 a c:WalkthroughStep ; rdfs:label "When you opened this page" ;
    c:children ( "\"Since you opened this page\" needs to know when that was. The click that chose this example in " ui:ex-activity-m-nav " is an event too, so " ui:ex-activity-m-mark " - a second reaction on that click - writes its sequence number and time on act:visit; " ui:ex-activity-m-since " counts the members after it, and the minutes start there." ) .
ui:ex-activity-w5 a c:WalkthroughStep ; rdfs:label "Why it is cheap" ;
    c:children ( "Every view names " ui:ex-activity-m-log2 " as its dataset, so an event re-runs about seven small queries over at most 200 members - while this page is shown. Anywhere else they are parked, and an interaction costs exactly what it did before this dashboard existed: the cost tests measure it." ) .

ui:ex-activity-m-click a c:Mention ; c:label "beh:Click" ; c:mentions beh:Click ; c:to beh:Click .
ui:ex-activity-m-input a c:Mention ; c:label "beh:Input" ; c:mentions beh:Input ; c:to beh:Input .
ui:ex-activity-m-log a c:Mention ; c:label "beh:ChangeLog" ; c:mentions beh:ChangeLog ; c:to beh:ChangeLog .
ui:ex-activity-m-log2 a c:Mention ; c:label "the change log" ; c:mentions beh:ChangeLog ; c:to beh:ChangeLog .
ui:ex-activity-m-Stat a c:Mention ; c:label "c:Stat" ; c:mentions c:Stat ; c:to c:Stat .
ui:ex-activity-m-total a c:Mention ; c:label "\"In the log\"" ; c:mentions ui:ex-activity-total .
ui:ex-activity-m-intheLog a c:Mention ; c:label "act:InTheLog" ; c:mentions act:InTheLog .
ui:ex-activity-m-touched a c:Mention ; c:label "act:Touched" ; c:mentions act:Touched .
ui:ex-activity-m-changed a c:Mention ; c:label "act:Changed" ; c:mentions act:Changed .
ui:ex-activity-m-types a c:Mention ; c:label "The bar chart" ; c:mentions ui:ex-activity-types .
ui:ex-activity-m-perType a c:Mention ; c:label "act:PerType" ; c:mentions act:PerType .
ui:ex-activity-m-time a c:Mention ; c:label "the line chart" ; c:mentions ui:ex-activity-time .
ui:ex-activity-m-perMinute a c:Mention ; c:label "act:PerMinute" ; c:mentions act:PerMinute .
ui:ex-activity-m-table a c:Mention ; c:label "the table" ; c:mentions ui:ex-activity-components .
ui:ex-activity-m-perComponent a c:Mention ; c:label "act:PerComponent" ; c:mentions act:PerComponent .
ui:ex-activity-m-recent a c:Mention ; c:label "ui:ex-activity-recent" ; c:mentions ui:ex-activity-recent .
ui:ex-activity-m-Timeline a c:Mention ; c:label "c:Timeline" ; c:mentions c:Timeline ; c:to c:Timeline .
ui:ex-activity-m-nav a c:Mention ; c:label "the examples' list" ; c:mentions ui:examplesNav ; c:to ui:examplesNav .
ui:ex-activity-m-mark a c:Mention ; c:label "act:MarkOpened" ; c:mentions act:MarkOpened .
ui:ex-activity-m-since a c:Mention ; c:label "act:SinceOpened" ; c:mentions act:SinceOpened .
