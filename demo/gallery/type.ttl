@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .

# Gallery page: Type.

ui:gallery-type a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-type-intro ui:ty-scale ui:ty-tones ui:ty-running ui:ty-links ui:ty-kbd ui:ty-code ui:ty-quote ) .
ui:gallery-type-intro a c:Heading ; c:label "Type" .

# --- the type scale ---
ui:ty-display a c:Text ; sty:textStyle sty:Display ; c:label "Display — interfaces as graphs" .
ui:ty-title a c:Text ; sty:textStyle sty:Title ; c:label "Title — components are vocabularies" .
ui:ty-subtitle a c:Text ; sty:textStyle sty:Subtitle ; c:label "Subtitle — rules turn instances into RDF/HTML" .
ui:ty-body a c:Text ; sty:textStyle sty:Body ; c:label "Body — running text for explanations and content. A rendering rule reads a component instance and writes an RDF/HTML graph, which the renderer patches into the DOM; nothing here is a template." .
ui:ty-caption a c:Text ; sty:textStyle sty:Caption ; c:label "Caption — supporting detail: 13px, muted, for hints and metadata." .
ui:ty-overline a c:Text ; sty:textStyle sty:Overline ; c:label "Overline — section label" .
ui:ty-mono a c:Text ; sty:textStyle sty:Mono ; c:label "Mono — https://semblance.dev/ns/component#Text" .
ui:ty-scale-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:ty-overline ui:ty-display ui:ty-title ui:ty-subtitle ui:ty-body ui:ty-caption ui:ty-mono ) .
ui:ty-scale a c:Flippable ; c:front ui:ty-scale-spec .
ui:ty-scale-spec a c:Specimen ; c:label "Type scale" ;
    c:help "sty:textStyle is a hookable axis like sty:tone: each value declares a size, weight, line height and letter spacing from the type tokens, compiled once into the hooks layer for every component that carries it." ;
    c:children ( ui:ty-scale-col ) .

# --- tones on text ---
ui:ty-tone-neutral a c:Text ; c:inline true ; sty:tone sty:Neutral ; sty:textStyle sty:Body ; c:label "Neutral" .
ui:ty-tone-accent a c:Text ; c:inline true ; sty:tone sty:Accent ; sty:textStyle sty:Body ; c:label "Accent" .
ui:ty-tone-info a c:Text ; c:inline true ; sty:tone sty:Info ; sty:textStyle sty:Body ; c:label "Info" .
ui:ty-tone-success a c:Text ; c:inline true ; sty:tone sty:Success ; sty:textStyle sty:Body ; c:label "Success" .
ui:ty-tone-warning a c:Text ; c:inline true ; sty:tone sty:Warning ; sty:textStyle sty:Body ; c:label "Warning" .
ui:ty-tone-danger a c:Text ; c:inline true ; sty:tone sty:Danger ; sty:textStyle sty:Body ; c:label "Danger" .
ui:ty-tone-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ;
    c:children ( ui:ty-tone-neutral ui:ty-tone-accent ui:ty-tone-info ui:ty-tone-success ui:ty-tone-warning ui:ty-tone-danger ) .
ui:ty-tone-title a c:Text ; sty:textStyle sty:Subtitle ; sty:tone sty:Accent ; c:label "A toned subtitle keeps its step, takes the tone's text color" .
ui:ty-tone-caption a c:Text ; sty:textStyle sty:Caption ; sty:tone sty:Danger ; c:label "The SPARQL rule did not parse; the previous output is kept." .
ui:ty-tones-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:ty-tone-row ui:ty-tone-title ui:ty-tone-caption ) .
ui:ty-tones a c:Flippable ; c:front ui:ty-tones-spec .
ui:ty-tones-spec a c:Specimen ; c:label "Tones on text" ;
    c:help "sty:tone colors text through the tone's --tone-text, the same property toned badges and alerts use. Only text that carries a tone is colored; it is not inherited from a toned ancestor." ;
    c:children ( ui:ty-tones-col ) .

# --- running text: strings and inline components ---
ui:ty-run-kbd a c:Kbd ; c:keys ( "⌘" "K" ) .
ui:ty-run-code a c:Code ; c:label "c:Text" .
ui:ty-run-link a c:Link ; c:label "RDF/HTML" ; c:href "https://ia2.dev/spec/rdf-html" .
ui:ty-run a c:Text ; sty:textStyle sty:Body ;
    c:children ( "A " ui:ty-run-code " is a sequence of strings and components: press " ui:ty-run-kbd " to open the palette, or read the " ui:ty-run-link " specification it renders into." ) .
ui:ty-running a c:Flippable ; c:front ui:ty-running-spec .
ui:ty-running-spec a c:Specimen ; c:label "Running text" ;
    c:help "c:children of a c:Text mixes literal strings with inline components (links, keys, code), in list order." ;
    c:children ( ui:ty-run ) .

# --- links ---
ui:ty-link-internal a c:Link ; c:label "Components" ; c:href "#components" .
ui:ty-link-external a c:Link ; c:label "RDF/HTML specification" ; c:href "https://ia2.dev/spec/rdf-html" .
ui:ty-link-success a c:Link ; c:label "All checks passed" ; c:href "#components" ; sty:tone sty:Success .
ui:ty-link-danger a c:Link ; c:label "3 rules failed" ; c:href "#components" ; sty:tone sty:Danger .
ui:ty-links-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ;
    c:children ( ui:ty-link-internal ui:ty-link-external ui:ty-link-success ui:ty-link-danger ) .
ui:ty-links a c:Flippable ; c:front ui:ty-links-spec .
ui:ty-links-spec a c:Specimen ; c:label "Link" ;
    c:help "Accent by default, toned by sty:tone. Absolute http(s) addresses open in a new tab with rel=noopener, an ↗ mark, and a spoken hint taken from c:Link's own c:externalHint in the viewer's language." ;
    c:children ( ui:ty-links-row ) .

# --- keys ---
ui:ty-kbd-palette a c:Kbd ; c:keys ( "⌘" "K" ) .
ui:ty-kbd-command a c:Kbd ; c:keys ( "⌘" "⇧" "P" ) .
ui:ty-kbd-ctrl a c:Kbd ; c:keys ( "Ctrl" "Enter" ) .
ui:ty-kbd-esc a c:Kbd ; c:label "Esc" .
ui:ty-kbd-slash a c:Kbd ; c:label "/" .
ui:ty-kbd-row a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ;
    c:children ( ui:ty-kbd-palette ui:ty-kbd-command ui:ty-kbd-ctrl ui:ty-kbd-esc ui:ty-kbd-slash ) .
ui:ty-kbd a c:Flippable ; c:front ui:ty-kbd-spec .
ui:ty-kbd-spec a c:Specimen ; c:label "Kbd" ;
    c:help "One key (c:label) or a combination (c:keys), as nested <kbd> elements; modifier glyphs are spelled out in the title." ;
    c:children ( ui:ty-kbd-row ) .

# --- code ---
ui:ty-code-inline-1 a c:Code ; c:label "sem:function" .
ui:ty-code-inline-2 a c:Code ; c:label "?n rdfhtml:hasChild* ?hit" ; c:language "sparql" .
ui:ty-code-inline a c:Text ; sty:textStyle sty:Body ;
    c:children ( "A rule names its implementation with " ui:ty-code-inline-1 "; a reaction finds the clicked control with " ui:ty-code-inline-2 "." ) .
ui:ty-code-sparql a c:Code ; c:block true ; c:language "sparql" ; c:label """# Flip the card whose control was clicked
CONSTRUCT { $this c:flipped ?new ; c:revealed true }
WHERE {
  $event beh:node ?hit .
  ?n rdfhtml:hasChild* ?hit .
  ?n c:flips $this .
  OPTIONAL { $this c:flipped ?old }
  BIND(!COALESCE(?old, false) AS ?new)
}""" .
ui:ty-code-turtle a c:Code ; c:block true ; c:language "turtle" ; c:label """@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .

# A component instance is a few triples.
ui:save a c:Button ;
    c:label "Save" ;
    sty:tone sty:Accent ; sty:emphasis sty:Solid ."""  .
ui:ty-code-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:ty-code-inline ui:ty-code-sparql ui:ty-code-turtle ) .
ui:ty-code a c:Flippable ; c:front ui:ty-code-spec .
ui:ty-code-spec a c:Specimen ; c:label "Code" ;
    c:help "Inline <code>, or with c:block true a <pre><code> block. c:language \"sparql\" or \"turtle\" colors the tokens with the palette of the rule sources on the back of every card." ;
    c:children ( ui:ty-code-col ) .

# --- quotation ---
ui:ty-quote-1 a c:Blockquote ;
    c:label "A layer is a vocabulary plus rules in a stratum above the components, toggled per projection." ;
    c:attribution "DESIGN.md, §4 Layers" .
ui:ty-quote a c:Flippable ; c:front ui:ty-quote-spec .
ui:ty-quote-spec a c:Specimen ; c:label "Blockquote" ;
    c:help "A quotation set off from the text, with an optional c:attribution." ;
    c:children ( ui:ty-quote-1 ) .
