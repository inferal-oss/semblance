@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix iv: <https://semblance.dev/ns/view#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vx: <https://semblance.dev/demo/views#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# Maintained views: a dashboard whose figures are not re-computed, but kept.
#
# Every interaction on this site is a member of the change log (beh:ChangeLog, an LDES that
# keeps the newest 200). The figures below are maintained views (iv:View, docs/IVM.md): SPARQL
# that also runs from scratch, but which the runtime keeps up to date from the changes - a
# member counted once when it arrives and once more, negatively, when it retires or leaves a
# window. So an event costs the same work however many members there are, and the table at
# the bottom shows it: each view's state, its work in the last tick, and what re-running the
# same query from scratch costs.
# =================================================================================================

ui:ex-views-prefixes sh:declare [ sh:prefix "vx" ; sh:namespace "https://semblance.dev/demo/views#"^^xsd:anyURI ] .

# --- the maintained views ---------------------------------------------------------------------------
# Each is a CONSTRUCT over an aggregate of the stream's members. iv:window narrows two of them
# to the last 30 seconds: members leave as time passes, on one timer, even while you do
# nothing. iv:measured asks the runtime to write their figures (iv:stateRows, iv:lastRows,
# iv:lastMs, iv:scratchMs...) in idle time; iv:whileShown maintains them only while this
# dashboard is on screen, and rebuilds them when it is shown again.

vx:window a iv:SlidingWindow ; iv:range "PT30S"^^xsd:dayTimeDuration .

vx:Recent a iv:View ; rdfs:label "events, last 30 s" ;
    iv:window vx:window ; iv:measured true ; iv:whileShown ui:ex-views ;
    sem:construct """
CONSTRUCT { vx:recent vx:events ?n }
WHERE { { SELECT (COUNT(?m) AS ?n) WHERE { beh:ChangeLog tree:member ?m } } }""" .

vx:RecentByType a iv:View ; rdfs:label "events per type, last 30 s" ;
    iv:window vx:window ; iv:measured true ; iv:whileShown ui:ex-views ;
    sem:construct """
CONSTRUCT { vx:recent vx:byType ?row . ?row vx:type ?type ; vx:count ?n }
WHERE {
  { SELECT ?type (COUNT(?m) AS ?n)
    WHERE { beh:ChangeLog tree:member ?m . ?m a ?class . BIND(REPLACE(STR(?class), "^.*[#/]", "") AS ?type) }
    GROUP BY ?type }
  BIND(IRI(CONCAT(STR(vx:recent), "/~", ENCODE_FOR_URI(?type))) AS ?row)
}""" .

vx:Whole a iv:View ; rdfs:label "the whole log" ;
    iv:measured true ; iv:whileShown ui:ex-views ;
    sem:construct """
CONSTRUCT { vx:log vx:events ?n ; vx:changed ?changed ; vx:largest ?largest ; vx:components ?components }
WHERE {
  { SELECT (COUNT(?m) AS ?n) (SUM(?a + ?r) AS ?changed) (MAX(?a + ?r) AS ?largest) (COUNT(DISTINCT ?t) AS ?components)
    WHERE { beh:ChangeLog tree:member ?m . ?m beh:added ?a ; beh:removed ?r ; beh:target ?t } }
}""" .

# --- streaming events -------------------------------------------------------------------------------
# "Stream 100 events" sets vx:stream's counter and makes it due now (beh:dueAt). The host's
# scheduler turns a due time into a beh:Due event addressed to the node; vx:Pulse takes one
# off the counter and makes the next one due 50 ms later. Each pulse is an ordinary member
# of the change log.

vx:stream vx:left 0 .

vx:StartStream a beh:Reaction ; beh:when beh:Click ; beh:source ui:ex-views-stream ;
    beh:deletes """
CONSTRUCT { vx:stream vx:left ?n ; beh:dueAt ?due }
WHERE { { vx:stream vx:left ?n } UNION { vx:stream beh:dueAt ?due } }""" ;
    beh:inserts """
CONSTRUCT { vx:stream vx:left 100 ; beh:dueAt ?at }
WHERE { $event beh:at ?at }""" .

vx:Pulse a beh:Reaction ; beh:when beh:Due ; beh:source vx:stream ;
    beh:deletes """
CONSTRUCT { vx:stream vx:left ?n ; beh:dueAt ?due }
WHERE { vx:stream vx:left ?n FILTER(?n > 0) OPTIONAL { vx:stream beh:dueAt ?due } }""" ;
    beh:inserts """
CONSTRUCT { vx:stream vx:left ?next ; beh:dueAt ?then }
WHERE {
  vx:stream vx:left ?n FILTER(?n > 0)
  $event beh:at ?at .
  BIND(?n - 1 AS ?next)
  BIND(IF(?next > 0, xsd:dateTime(?at) + xsd:dayTimeDuration("PT0.05S"), ?none) AS ?then)
}""" .

# --- reading the views ------------------------------------------------------------------------------
# The components read the views' output graph with point queries: a few triples, however long
# the log. Their c:dataset is the node the view writes, so they re-render when it changes.

vx:qRecent a sem:View ; sem:select """SELECT ?value WHERE { vx:recent vx:events ?value }""" .
vx:qEvents a sem:View ; sem:select """SELECT ?value WHERE { vx:log vx:events ?value }""" .
vx:qChanged a sem:View ; sem:select """SELECT ?value WHERE { vx:log vx:changed ?value }""" .
vx:qLargest a sem:View ; sem:select """SELECT ?value WHERE { vx:log vx:largest ?value }""" .
vx:qComponents a sem:View ; sem:select """SELECT ?value WHERE { vx:log vx:components ?value }""" .
vx:qByType a sem:View ; sem:select """
SELECT ?type ?value WHERE { vx:recent vx:byType ?row . ?row vx:type ?type ; vx:count ?value }
ORDER BY DESC(?value) ?type""" .

# The figures the runtime writes for each measured view (in the views graph).
vx:qCosts a sem:View ; sem:select """
SELECT ?view ?state ?last ?lastMs ?reads ?scratchMs WHERE {
  ?v a iv:View ; iv:measured true ; rdfs:label ?view .
  OPTIONAL { ?v iv:stateRows ?state } OPTIONAL { ?v iv:lastRows ?last } OPTIONAL { ?v iv:lastMs ?lastMs }
  OPTIONAL { ?v iv:inputRows ?reads } OPTIONAL { ?v iv:scratchMs ?scratchMs }
}
ORDER BY ?view""" .

# --- the dashboard ----------------------------------------------------------------------------------

ui:ex-views a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:ex-views-intro ui:ex-views-controls ui:ex-views-figures ui:ex-views-panels ) .
ui:ex-views-intro a c:Text ;
    c:label "Your interactions, counted as they happen: the figures are maintained views over the change log, kept up to date from each new event instead of re-run over the whole log. Stream a hundred events, then wait: the last-30-seconds figures age out on their own." .

ui:ex-views-controls a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ;
    c:children ( ui:ex-views-stream ui:ex-views-note ) .
ui:ex-views-stream a c:Button ; c:label "Stream 100 events" ; sty:tone sty:Accent ; sty:emphasis sty:Solid .
ui:ex-views-note a c:Text ; c:label "Twenty a second, each a member of the change log." .

ui:ex-views-figures a c:Grid ; c:minWidth "150px" ; pos:gap tok:space-4 ;
    c:children ( ui:ex-views-recent ui:ex-views-events ui:ex-views-changed ui:ex-views-largest ui:ex-views-components ) .
ui:ex-views-recent a c:Stat ; c:label "Last 30 seconds" ; c:unit "events" ; c:help "A sliding window (iv:SlidingWindow)." ;
    c:valueQuery vx:qRecent ; c:dataset vx:recent .
ui:ex-views-events a c:Stat ; c:label "In the log" ; c:unit "events" ; c:help "Retention keeps 200 (ldes:amount)." ;
    c:valueQuery vx:qEvents ; c:dataset vx:log .
ui:ex-views-changed a c:Stat ; c:label "Triples changed" ; c:help "SUM(?added + ?removed)." ;
    c:valueQuery vx:qChanged ; c:dataset vx:log .
ui:ex-views-largest a c:Stat ; c:label "Largest change" ; c:unit "triples" ; c:help "MAX: kept in order, so a retired maximum gives way to the next." ;
    c:valueQuery vx:qLargest ; c:dataset vx:log .
ui:ex-views-components a c:Stat ; c:label "Components" ; c:help "COUNT(DISTINCT ?target)." ;
    c:valueQuery vx:qComponents ; c:dataset vx:log .

ui:ex-views-panels a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ;
    c:children ( ui:ex-views-types-card ui:ex-views-costs-card ) .
ui:ex-views-types-card a c:Flippable ; c:front ui:ex-views-types-panel .
ui:ex-views-types-panel a c:Card ; c:label "Last 30 seconds, by type" ; c:badge "iv:window" ; c:content ui:ex-views-types .
ui:ex-views-types a c:BarChart ; rdfs:label "Events per type, last 30 seconds" ;
    c:view vx:qByType ; c:dataset vx:recent ;
    c:categoryVariable "type" ; c:valueVariable "value" ;
    c:emptyText "Nothing in the last 30 seconds." .

ui:ex-views-costs-card a c:Card ; c:label "What each view costs" ; c:badge "iv:measured" ;
    c:note "Rows held, rows of work in the last tick and its time - against the rows and time of running the same query from scratch (sampled every 2 s)." ;
    c:content ui:ex-views-costs .
ui:ex-views-col-view a c:Column ; c:variable "view" ; c:label "View" .
ui:ex-views-col-state a c:Column ; c:variable "state" ; c:label "State rows" ; c:align "end" ; c:format "number" .
ui:ex-views-col-last a c:Column ; c:variable "last" ; c:label "Last tick, rows" ; c:align "end" ; c:format "number" .
ui:ex-views-col-ms a c:Column ; c:variable "lastMs" ; c:label "Last tick, ms" ; c:align "end" ; c:format "decimal" .
ui:ex-views-col-reads a c:Column ; c:variable "reads" ; c:label "From scratch, rows" ; c:align "end" ; c:format "number" .
ui:ex-views-col-scratch a c:Column ; c:variable "scratchMs" ; c:label "From scratch, ms" ; c:align "end" ; c:format "decimal" .
ui:ex-views-costs a c:Table ; c:label "What each view costs" ; c:query vx:qCosts ;
    c:dataset vx:Recent , vx:RecentByType , vx:Whole ;
    c:tableColumns ( ui:ex-views-col-view ui:ex-views-col-state ui:ex-views-col-last ui:ex-views-col-ms ui:ex-views-col-reads ui:ex-views-col-scratch ) ;
    c:emptyText "Figures appear after the first idle moment." .

# --- how it works ---------------------------------------------------------------------------------

ui:ex-views-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-views-w1 ui:ex-views-w2 ui:ex-views-w3 ui:ex-views-w4 ) .

ui:ex-views-w1 a c:WalkthroughStep ; rdfs:label "Queries that are kept, not re-run" ;
    c:children ( "Each figure comes from an " ui:ex-views-m-View " in this file: plain SPARQL over " ui:ex-views-m-log ", with annotations. Run from scratch, the query gives the same answer - the tests check that after every change - but the runtime never runs it that way: " ui:ex-views-m-recent ", " ui:ex-views-m-byType " and " ui:ex-views-m-whole " are kept." ) .
ui:ex-views-w2 a c:WalkthroughStep ; rdfs:label "Members are the changes" ;
    c:children ( "An appended member is evaluated once - its part of the query, cached - and enters the groups: COUNT and SUM add, MAX keeps values in order, COUNT(DISTINCT) keeps them with weights. When the retention policy retires a member, the same rows leave with weight -1. Only the groups that changed are written to the views graph, and the components read those triples." ) .
ui:ex-views-w3 a c:WalkthroughStep ; rdfs:label "A window that moves on its own" ;
    c:children ( ui:ex-views-m-window " keeps only the last 30 seconds of the stream's timestamps. One timer, set for the next member to age out, moves it: the figures drop while you do nothing. The streamed events are " ui:ex-views-m-due " events: the scheduler fires one when " ui:ex-views-m-dueAt " comes, and " ui:ex-views-m-pulse " sets the next." ) .
ui:ex-views-w4 a c:WalkthroughStep ; rdfs:label "What it costs" ;
    c:children ( "The table is the runtime's own account (" ui:ex-views-m-measured "): per event a view does a handful of rows of work, whatever the log holds, while a from-scratch run reads every member. " ui:ex-views-m-whileShown " keeps these views off the critical path elsewhere: on other pages they do nothing, and catch up when this one is shown." ) .

ui:ex-views-m-View a c:Mention ; c:label "iv:View" ; c:mentions iv:View ; c:to iv:View .
ui:ex-views-m-log a c:Mention ; c:label "beh:ChangeLog" ; c:mentions beh:ChangeLog ; c:to beh:ChangeLog .
ui:ex-views-m-recent a c:Mention ; c:label "vx:Recent" ; c:mentions vx:Recent .
ui:ex-views-m-byType a c:Mention ; c:label "vx:RecentByType" ; c:mentions vx:RecentByType .
ui:ex-views-m-whole a c:Mention ; c:label "vx:Whole" ; c:mentions vx:Whole .
ui:ex-views-m-window a c:Mention ; c:label "vx:window" ; c:mentions vx:window .
ui:ex-views-m-due a c:Mention ; c:label "beh:Due" ; c:mentions beh:Due ; c:to beh:Due .
ui:ex-views-m-dueAt a c:Mention ; c:label "beh:dueAt" ; c:mentions beh:dueAt ; c:to beh:dueAt .
ui:ex-views-m-pulse a c:Mention ; c:label "vx:Pulse" ; c:mentions vx:Pulse .
ui:ex-views-m-measured a c:Mention ; c:label "iv:measured" ; c:mentions iv:measured ; c:to iv:measured .
ui:ex-views-m-whileShown a c:Mention ; c:label "iv:whileShown" ; c:mentions iv:whileShown ; c:to iv:whileShown .
