@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ss: <https://semblance.dev/demo/sheet#> .
@prefix ui: <https://semblance.dev/demo#> .

# =================================================================================================
# A spreadsheet whose cells are resources and whose formulas are queries.
#
# Each cell is a c:SheetCell at a row and a column. A number cell holds its c:value; a formula
# cell holds its formula as people write it (c:formulaText "=SUM(B4:E4)"), which the sheet reads
# into a query (c:valueQuery) and the cells it reads (c:dataset). Nothing here recomputes
# anything: the formula layer runs a cell's query when a cell it reads changes - and the cells
# that read it follow, and so on - so the dependency graph is the data's own. Select a cell to
# see its formula and arrows to and from the cells it depends on; change a number to see which
# formulas re-ran (and only those), counted under the sheet; type a formula into a cell, or add a
# row or a column, with the buttons above the grid.
# =================================================================================================

ui:ex-sheet-prefixes sh:declare [ sh:prefix "ss" ; sh:namespace "https://semblance.dev/demo/sheet#"^^xsd:anyURI ] .

# --- the cells -------------------------------------------------------------------------------------
# A year of sales at a café: an item per row, its four quarters, then formulas - its year, its
# quarterly average, its share of the year's total, its target and the gap to it. Under the items,
# each column's total, best and average. A formula is written as people write it (c:formulaText);
# c:SheetFormula reads it into the cell's query and the cells it reads.

ss:A1 a c:SheetCell ; c:row 1 ; c:column 1 ; c:value "Item" .
ss:B1 a c:SheetCell ; c:row 1 ; c:column 2 ; c:value "Q1" .
ss:C1 a c:SheetCell ; c:row 1 ; c:column 3 ; c:value "Q2" .
ss:D1 a c:SheetCell ; c:row 1 ; c:column 4 ; c:value "Q3" .
ss:E1 a c:SheetCell ; c:row 1 ; c:column 5 ; c:value "Q4" .
