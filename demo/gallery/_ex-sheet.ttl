ui:ex-sheet a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:ex-sheet-intro ui:ex-sheet-card ) .
ui:ex-sheet-intro a c:Text ;
    c:label "A spreadsheet in the graph: cells are resources, formulas are queries over the cells they read. Change a quarter's sales - the formulas that read it recalculate, and only those, as the line under the sheet counts. Click a cell to see what it reads and what reads it; type a formula such as =AVERAGE(B2:B17) into an empty cell, or add a row." .
ui:ex-sheet-card a c:Card ; c:label "Café sales" ; c:badge "81 formulas" ; c:content ss:sales .

# --- how it works -----------------------------------------------------------------------------------

ui:ex-sheet-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-sheet-w1 ui:ex-sheet-w2 ui:ex-sheet-w3 ui:ex-sheet-w4 ui:ex-sheet-w5 ui:ex-sheet-w6 ui:ex-sheet-w7 ) .

ui:ex-sheet-w1 a c:WalkthroughStep ; rdfs:label "Cells are resources" ;
    c:children ( ui:ex-sheet-m-sales " is a " ui:ex-sheet-m-Sheet " that places its cells: each is a " ui:ex-sheet-m-SheetCell " with a row and a column - " ui:ex-sheet-m-b4 ", the cappuccinos sold in the first quarter, is row 4, column 2. A cell like it holds a number (c:value), and editing it is " ui:ex-sheet-m-edit ": one triple, typed as a number when it reads as one." ) .
ui:ex-sheet-w2 a c:WalkthroughStep ; rdfs:label "Formulas are written as people write them" ;
    c:children ( ui:ex-sheet-m-f4 ", the cappuccinos' year, says \"=SUM(B4:E4)\": its " ui:ex-sheet-m-formulaText ". " ui:ex-sheet-m-parse " reads it into a query - SUM names " ui:ex-sheet-m-sum ", a SELECT over the cell's inputs, its " ui:ex-sheet-m-valueQuery " - and the cells the range covers, B4 to E4, its " ui:ex-sheet-m-dataset ". " ui:ex-sheet-m-h4 ", the share of the year, is \"=F4/F18\": " ui:ex-sheet-m-divide " over a left and a right operand." ) .
ui:ex-sheet-w3 a c:WalkthroughStep ; rdfs:label "Typing a formula, adding a row" ;
    c:children ( "Type =AVERAGE(B2:B17) into a cell and press Enter: " ui:ex-sheet-m-enter " keeps the text as the cell's formula, and the same rule gives it its query and its inputs; nothing else is needed. The buttons above the grid add a row (" ui:ex-sheet-m-addRow ") or a column: new empty cells, ready for numbers or formulas." ) .
ui:ex-sheet-w4 a c:WalkthroughStep ; rdfs:label "The graph recomputes, through the graph" ;
    c:children ( "The formula layer, " ui:ex-sheet-m-Formula ", runs a cell's query and writes the result as its value, and it follows c:dataset: change " ui:ex-sheet-m-b4b " and its year " ui:ex-sheet-m-f4b " runs again, then " ui:ex-sheet-m-f18 ", the year's total - and with it every share in column H, and " ui:ex-sheet-m-j18 ", the gap to the target. No code orders them: the dependencies are triples, and the engine propagates along them." ) .
ui:ex-sheet-w5 a c:WalkthroughStep ; rdfs:label "Only what depends on a change runs" ;
    c:children ( "Change one quarter and 26 of 81 formulas run: its row's year, average, share and gap, its column's total, best and average, the year's total, best and average, and the sixteen shares that read the total - not the other rows' sums. With " ui:ex-sheet-m-trace ", the host hears the engine evaluate formulas and writes them on the sheet (" ui:ex-sheet-m-recalculated "); the cells flash, and the line under the sheet counts them." ) .
ui:ex-sheet-w6 a c:WalkthroughStep ; rdfs:label "Dependencies, drawn as connectors" ;
    c:children ( "Click a cell: " ui:ex-sheet-m-connectors " derives a " ui:ex-sheet-m-Connector " for each of its dependencies - solid ones from the cells it reads, dashed ones to the cells that read it, an arc to the side within a column - straight from the c:dataset triples. The host draws each where its cells are, and keeps it there as the grid scrolls." ) .
ui:ex-sheet-w7 a c:WalkthroughStep ; rdfs:label "Why it is cheap" ;
    c:children ( "An edit is one triple. The formulas that read it run - each one query over its own inputs - and so do the ones that read them; a sheet twice as big costs the same edit the same. Each cell renders on its own, so only the cells whose value changed render again, and the arrows are redrawn only when a cell they join moves. Every rule here is SPARQL with a function twin that renders the same." ) .

