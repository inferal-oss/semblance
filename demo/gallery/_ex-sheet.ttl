ss:G1 a c:SheetCell ; c:row 1 ; c:column 7 ; c:value "Average" .
ss:H1 a c:SheetCell ; c:row 1 ; c:column 8 ; c:value "Share" .
ss:I1 a c:SheetCell ; c:row 1 ; c:column 9 ; c:value "Target" .
ss:J1 a c:SheetCell ; c:row 1 ; c:column 10 ; c:value "Gap" .
