@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix clip: <https://semblance.dev/ns/clipboard#> .
@prefix rnd: <https://semblance.dev/ns/rendered#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix iv: <https://semblance.dev/ns/view#> .
@prefix pos: <https://semblance.dev/ns/position#> .

# The Playground's SPARQL workbench (the Query tab): its instance, sample queries and remembered state.
# The editor starts with the first sample, already run, so the tab opens on results.

ui:workbench a c:QueryWorkbench ;
    c:label "SPARQL workbench" , "Робоче місце SPARQL"@uk , "SPARQL-Werkbank"@de , "منضدة SPARQL"@ar ;
    c:editor ui:queryEditor ;
    c:actions ( ui:queryRun ui:queryFollow ui:queryCopy ) ;
    c:runs ui:currentQuery ;
    c:results ui:queryResults ;
    c:samples ( ui:sampleRenderings ui:sampleReactions ui:sampleLayers ui:sampleChangeLog
                ui:sampleViolations ui:sampleUndocumented ui:sampleRuleSides ui:sampleViews ui:sampleOverlaps ui:sampleOffscreen
                ui:sampleRenderedState ui:sampleTabsGraph ui:sampleTodos ) .

ui:queryEditor a c:QueryEditor ;
    c:label "SPARQL query" , "Запит SPARQL"@uk , "SPARQL-Abfrage"@de , "استعلام SPARQL"@ar ;
    c:value """# Every component class, how many renderings target it, and how many rules implement them.
SELECT ?component (COUNT(DISTINCT ?rendering) AS ?renderings) (COUNT(DISTINCT ?rule) AS ?rules)
WHERE {
  ?component rdfs:subClassOf+ sem:Component .
  OPTIONAL { ?rendering sem:targets ?component . ?rule sem:implements ?rendering }
}
GROUP BY ?component
ORDER BY DESC(?rules) ?component""" .

# Typed c:Button as well: the button's SPARQL renderings match the asserted class.
ui:queryRun a c:Button , c:RunQueryButton ; c:of ui:workbench ;
    c:label "Run" , "Виконати"@uk , "Ausführen"@de , "تشغيل"@ar ;
    sty:intent sty:Primary ; key:shortcut "mod+enter" .

# Copies the editor's text (a clip:Copier of its c:value): the toast says the query was copied.
ui:queryCopy a c:IconButton , clip:Copier ; clip:copies ui:queryEditor ; clip:property c:value ; clip:format clip:Sparql ;
    c:label "Copy the query" , "Копіювати запит"@uk , "Abfrage kopieren"@de , "نسخ الاستعلام"@ar ;
    sty:emphasis sty:Ghost .

# Whether the results follow the graph (c:followUpdates): off, they stay as of the last run. On, the
# query is also a maintained view (c:FollowAsView): the table reads its rows, the Plan tab its plan.
ui:queryFollow a c:ToggleSwitch ; c:controls ui:workbench ; c:property c:followUpdates ;
    c:label "Follow updates" , "Стежити за змінами"@uk , "Änderungen folgen"@de , "متابعة التحديثات"@ar .

ui:currentQuery a sem:Query ;
    rdfs:label "The query last run" , "Останній виконаний запит"@uk , "Die zuletzt ausgeführte Abfrage"@de , "آخر استعلام منفّذ"@ar ;
    c:runCount 1 ;
    sem:select """# Every component class, how many renderings target it, and how many rules implement them.
SELECT ?component (COUNT(DISTINCT ?rendering) AS ?renderings) (COUNT(DISTINCT ?rule) AS ?rules)
WHERE {
  ?component rdfs:subClassOf+ sem:Component .
  OPTIONAL { ?rendering sem:targets ?component . ?rule sem:implements ?rendering }
}
GROUP BY ?component
ORDER BY DESC(?rules) ?component""" .

# --- results: three views of the query last run -------------------------------------------------------

ui:queryResults a c:Tabs ;
    c:label "Results" , "Результати"@uk , "Ergebnisse"@de , "النتائج"@ar ;
    c:tabs ( ui:queryTableTab ui:queryGraphTab ui:queryTurtleTab ui:queryPlanTab ) ;
    c:selected ui:queryTableTab .
ui:queryTableTab a c:Tab ; c:label "Table" , "Таблиця"@uk , "Tabelle"@de , "جدول"@ar ; c:content ui:queryTable .
ui:queryGraphTab a c:Tab ; c:label "Graph" , "Граф"@uk , "Graph"@de , "رسم بياني"@ar ; c:content ui:queryGraph .
ui:queryTurtleTab a c:Tab ; c:label "Turtle" ; c:content ui:queryTurtle .
ui:queryTable a c:ResultTable ; c:of ui:currentQuery ; c:actions ( ui:queryTableCopy ) .
# Beside the table's summary: copies the rows shown as a Markdown table (the table's c:markdown).
ui:queryTableCopy a c:IconButton , clip:Copier ; clip:copies ui:queryTable ; clip:property c:markdown ; clip:format clip:Markdown ;
    c:label "Copy as Markdown" , "Копіювати як Markdown"@uk , "Als Markdown kopieren"@de , "نسخ بصيغة Markdown"@ar ;
    sty:size sty:Small ; sty:emphasis sty:Ghost .
ui:queryGraph a c:ResultGraph ; c:of ui:currentQuery .
ui:queryTurtle a c:ResultTurtle ; c:of ui:currentQuery .

# The Plan tab: how the query is maintained while it follows updates - what the runtime writes about
# it in the views graph (docs/IVM.md §8.4): its strategy, or why it is recomputed, the work of its
# last change against what a re-run reads, the check against a from-scratch run, and its operators.
ui:queryPlanTab a c:Tab ; c:label "Plan" , "План"@uk , "Plan"@de , "الخطة"@ar ; c:content ui:queryPlan .
ui:queryPlan a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:queryPlanSummary ui:queryPlanTable ) .
ui:queryPlanSummary a c:Text ; c:valueQuery ui:qPlanSummary ; c:dataset ui:currentQuery .
ui:qPlanSummary a sem:View ; sem:select """
SELECT ?label WHERE {
  BIND(EXISTS { ui:currentQuery a iv:View } AS ?live)
  OPTIONAL { ui:currentQuery iv:strategy ?s FILTER(?s IN (iv:Incremental, iv:Recompute)) }
  OPTIONAL { ui:currentQuery iv:fallback ?why }
  OPTIONAL { ui:currentQuery iv:lastRows ?last ; iv:inputRows ?reads ; iv:stateRows ?state }
  OPTIONAL { ui:currentQuery iv:matches ?ok }
  BIND(COALESCE(?s = iv:Recompute, false) AS ?recomputed)
  BIND(IF(BOUND(?last), CONCAT(" Last change: ", STR(?last), " rows of work; a re-run reads ", STR(?reads), "; ", STR(?state), " rows of state."), "") AS ?work)
  BIND(IF(BOUND(?ok), IF(STR(?ok) = "true", " ✓ Matches a from-scratch run.", " ✕ Differs from a from-scratch run."), "") AS ?check)
  BIND(IF(!?live, "Not maintained. Switch on Follow updates: the query becomes a maintained view, and its plan and the work of each change show here.",
       IF(?recomputed, CONCAT("Recomputed from scratch when a triple it reads changes: ", STR(?why), ".", ?check),
          CONCAT("Maintained incrementally: each change costs what it changes.", ?work, ?check))) AS ?label)
}""" .
ui:queryPlanTable a c:ResultTable ; c:of ui:qPlanOperators ; c:followUpdates true .
ui:qPlanOperators a sem:Query ;
    rdfs:label "The query's operators" , "Оператори запиту"@uk , "Die Operatoren der Abfrage"@de , "عوامل الاستعلام"@ar ;
    sem:select """
SELECT ?step ?operator ?algebra ?key WHERE {
  ui:currentQuery iv:operator ?op . ?op iv:kind ?operator ; iv:algebra ?algebra .
  OPTIONAL { ?op iv:partitionKey ?key }
  BIND(xsd:integer(STRAFTER(STR(?op), "/~op-")) AS ?step)
}
ORDER BY ?step""" .

# --- sample queries: the ontology, asked about itself -----------------------------------------------------

ui:sampleRenderings a sem:Query ;
    rdfs:label "Components and their renderings" , "Компоненти та їхні відображення"@uk , "Komponenten und ihre Darstellungen"@de , "المكونات وطرق عرضها"@ar ;
    rdfs:comment "Every component class, with how many renderings target it and how many rules (SPARQL or function) implement them."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# Every component class, how many renderings target it, and how many rules implement them.
SELECT ?component (COUNT(DISTINCT ?rendering) AS ?renderings) (COUNT(DISTINCT ?rule) AS ?rules)
WHERE {
  ?component rdfs:subClassOf+ sem:Component .
  OPTIONAL { ?rendering sem:targets ?component . ?rule sem:implements ?rendering }
}
GROUP BY ?component
ORDER BY DESC(?rules) ?component""" .

ui:sampleReactions a sem:Query ;
    rdfs:label "Reactions and the events they handle" , "Реакції та події, які вони обробляють"@uk , "Reaktionen und ihre Ereignisse"@de , "ردود الفعل والأحداث التي تعالجها"@ar ;
    rdfs:comment "Every beh:Reaction: the event class it handles, the component (or class) it listens on, and its function fallback."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# What interaction means: each reaction, the event it handles and where.
SELECT ?reaction ?event ?on ?function
WHERE {
  ?reaction a beh:Reaction ; beh:when ?event .
  OPTIONAL { ?reaction beh:sourceClass ?class }
  OPTIONAL { ?reaction beh:source ?source }
  BIND(COALESCE(?class, ?source) AS ?on)
  OPTIONAL { ?reaction sem:function ?function }
}
ORDER BY ?event ?on ?reaction""" .

ui:sampleLayers a sem:Query ;
    rdfs:label "Layers and the rules they contribute" , "Шари та їхні правила"@uk , "Schichten und ihre Regeln"@de , "الطبقات والقواعد التي تضيفها"@ar ;
    rdfs:comment "Each sem:Layer, how many rules it adds and the strata they run in."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# Cross-cutting concerns are layers: rules in strata around the components.
SELECT ?layer (SAMPLE(?name) AS ?label) (COUNT(DISTINCT ?rule) AS ?rules) (MIN(?stratum) AS ?lowest) (MAX(?stratum) AS ?highest)
WHERE {
  ?layer a sem:Layer .
  OPTIONAL { ?layer rdfs:label ?name FILTER(LANG(?name) = "en" || LANG(?name) = "") }
  OPTIONAL { ?rendering sem:layer ?layer ; sem:stratum ?stratum . ?rule sem:implements ?rendering }
}
GROUP BY ?layer
ORDER BY ?lowest ?layer""" .

ui:sampleChangeLog a sem:Query ;
    rdfs:label "The change log, newest first" , "Журнал змін, найновіші спершу"@uk , "Das Änderungsprotokoll, neueste zuerst"@de , "سجل التغييرات، الأحدث أولاً"@ar ;
    rdfs:comment "The latest members of the beh:ChangeLog event stream, read from its head (beh:latest, then beh:previous)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# The stream names its newest member; each member names the one before it.
SELECT ?sequence ?event ?target ?added ?removed
WHERE {
  beh:ChangeLog beh:latest/beh:previous* ?member .
  ?member beh:sequence ?sequence ; a ?event ; beh:target ?target ;
          beh:added ?added ; beh:removed ?removed .
}
ORDER BY DESC(?sequence)
LIMIT 20""" .

ui:sampleViolations a sem:Query ;
    rdfs:label "Components that violate their shapes" , "Компоненти, що порушують свої форми"@uk , "Komponenten, die ihre Formen verletzen"@de , "مكونات تخالف أشكالها"@ar ;
    rdfs:comment "SHACL results the shapes layer recorded in the derived graph (for components shown so far)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# The shapes layer validates each component before it renders (turn on its chip).
SELECT ?component ?property ?message
WHERE {
  ?result a sh:ValidationResult ; sh:focusNode ?component ;
          sh:resultPath ?property ; sh:resultMessage ?message .
}
ORDER BY ?component ?property""" .

ui:sampleUndocumented a sem:Query ;
    rdfs:label "Properties without a comment" , "Властивості без коментаря"@uk , "Eigenschaften ohne Kommentar"@de , "خصائص بلا تعليق"@ar ;
    rdfs:comment "Semblance's own properties that no rdfs:comment explains yet."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# What the ontology does not explain yet.
SELECT ?property ?kind
WHERE {
  VALUES ?kind { owl:ObjectProperty owl:DatatypeProperty rdf:Property }
  ?property a ?kind .
  FILTER(STRSTARTS(STR(?property), "https://semblance.dev/ns/"))
  FILTER NOT EXISTS { ?property rdfs:comment ?comment }
}
ORDER BY ?property""" .

ui:sampleRuleSides a sem:Query ;
    rdfs:label "Renderings missing a SPARQL or function side" , "Рендеринги без SPARQL чи функції"@uk , "Darstellungen ohne SPARQL- oder Funktionsseite"@de , "عروض ينقصها جانب SPARQL أو دالة"@ar ;
    rdfs:comment "Renderings whose implementations are not on both sides, which side is missing, and why when the rendering says (sem:functionOnly)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# Renderings whose implementations are not on both sides. A function rule covers every modality
# it handles; a SPARQL rule covers its sem:modality, or all of them when it names none.
SELECT ?rendering ?targets ?missing ?why
WHERE {
  ?rendering a sem:Rendering .
  OPTIONAL { ?rendering sem:targets ?targets }
  OPTIONAL { ?rendering sem:functionOnly ?why }
  BIND(EXISTS { ?fn sem:implements ?rendering ; sem:function ?name } AS ?hasFunction)
  BIND(EXISTS { ?q sem:implements ?rendering ; sem:construct ?text } AS ?hasSparql)
  # A modality the function covers but no SPARQL rule does (only where SPARQL rules name modalities).
  OPTIONAL {
    FILTER NOT EXISTS { ?rendering sem:modality ?own }
    VALUES ?modality { mod:Screen mod:Text }
    ?some sem:implements ?rendering ; sem:construct ?someText ; sem:modality ?named .
    FILTER NOT EXISTS {
      ?q2 sem:implements ?rendering ; sem:construct ?text2 .
      FILTER(NOT EXISTS { ?q2 sem:modality ?m2 } || EXISTS { ?q2 sem:modality ?modality })
    }
  }
  FILTER(!?hasFunction || !?hasSparql || (BOUND(?modality) && ?hasFunction))
  BIND(IF(!?hasSparql, "SPARQL", IF(!?hasFunction, "function", CONCAT("SPARQL for ", STRAFTER(STR(?modality), "#")))) AS ?missing)
}
ORDER BY ?missing ?rendering""" .

ui:sampleViews a sem:Query ;
    rdfs:label "Maintained views: their work, and a check" , "Підтримувані подання: їхня робота і перевірка"@uk , "Gepflegte Sichten: ihre Arbeit und eine Prüfung"@de , "العروض المُحدَّثة: عملها وفحصها"@ar ;
    rdfs:comment "Each maintained view (iv:View) the runtime holds: how it is kept, the work of its last step against the rows a from-scratch run reads, and whether it matched that run when last checked (figures of iv:measured views, written in idle time)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# What the runtime writes about each view in the views graph (urn:semblance:views).
SELECT ?view ?strategy ?state ?lastRows ?reads ?matches ?fallback
WHERE {
  ?view a iv:View .
  OPTIONAL { ?view iv:strategy ?strategy }
  OPTIONAL { ?view iv:stateRows ?state }
  OPTIONAL { ?view iv:lastRows ?lastRows }
  OPTIONAL { ?view iv:inputRows ?reads }
  OPTIONAL { ?view iv:matches ?matches }
  OPTIONAL { ?view iv:fallback ?fallback }
}
ORDER BY ?view""" .

ui:sampleOverlaps a sem:Query ;
    rdfs:label "Components overlapping each other" , "Компоненти, що перекривають одне одного"@uk , "Komponenten, die einander überlappen"@de , "مكوّنات يتداخل بعضها مع بعض"@ar ;
    rdfs:comment "Pairs of shown components whose boxes overlap, neither inside the other, with where the first is (the rendered graph: components that ask for rnd:Overlap, here the windows and the toasts on the desktop)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# Overlap is maintained from the boxes the page measures (rnd:Overlaps, in document pixels).
# Open two of the gallery's windows over each other, then run this again.
SELECT ?component ?other ?x ?y ?width ?height
WHERE {
  ?a rnd:overlaps ?b ; rnd:of ?component ; rnd:x ?x ; rnd:y ?y ; rnd:width ?width ; rnd:height ?height .
  ?b rnd:of ?other .
  FILTER(STR(?component) < STR(?other))
}
ORDER BY ?component ?other""" .

ui:sampleOffscreen a sem:Query ;
    rdfs:label "Components off screen" , "Компоненти поза екраном"@uk , "Komponenten außerhalb des Bildschirms"@de , "مكوّنات خارج الشاشة"@ar ;
    rdfs:comment "Shown components that ask for rnd:Visibility and are not wholly in the viewport: how much of each is, and where its top is relative to the viewport's (negative: above it)."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# Boxes are in document pixels (fixed ones in the viewport's); the viewport node says how far the page is scrolled.
SELECT ?component ?ratio ?top ?height
WHERE {
  ?viewport a rnd:Viewport ; rnd:scrollTop ?scrolled .
  ?s rnd:of ?component ; rnd:rendered true ; rnd:ratio ?ratio .
  FILTER(?ratio < 1)
  OPTIONAL { ?s rnd:y ?y ; rnd:height ?height }
  # A fixed box (rnd:fixed) is placed in the viewport already.
  BIND(IF(EXISTS { ?s rnd:fixed true }, ?y, ?y - ?scrolled) AS ?top)
}
ORDER BY ?ratio ?component""" .

ui:sampleRenderedState a sem:Query ;
    rdfs:label "Focus, pointer and what is open" , "Фокус, вказівник і що відкрито"@uk , "Fokus, Zeiger und was offen ist"@de , "التركيز والمؤشر وما هو مفتوح"@ar ;
    rdfs:comment "What the page says about the shell's components right now: which holds the focus (and which contain it), which the pointer is over or pressing, which native disclosures are open."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# The rendered graph: one rnd:State per component that has something to say.
SELECT ?component ?state
WHERE {
  VALUES ?state { rnd:focused rnd:focusWithin rnd:focusVisible rnd:hovered rnd:pressed rnd:open rnd:topLayer rnd:animating }
  ?s rnd:of ?component ; ?state true .
}
ORDER BY ?state ?component""" .

ui:sampleTabsGraph a sem:Query ;
    rdfs:label "How c:Tabs is made" , "Як зроблено c:Tabs"@uk , "Wie c:Tabs gemacht ist"@de , "كيف صُنع c:Tabs"@ar ;
    rdfs:comment "A component as a graph: its superclass, renderings and their rules, reactions and keyboard pattern."@en ;
    c:resultTab ui:queryGraphTab ;
    sem:construct """# One component and everything that makes it work.
CONSTRUCT {
  c:Tabs rdfs:subClassOf ?super ; key:navigation ?navigation .
  ?rendering sem:targets c:Tabs ; sem:layer ?layer .
  ?rule sem:implements ?rendering .
  ?reaction beh:sourceClass c:Tabs ; beh:when ?event .
}
WHERE {
  { c:Tabs rdfs:subClassOf ?super }
  UNION { c:Tabs key:navigation ?navigation }
  UNION { ?rendering sem:targets c:Tabs . ?rule sem:implements ?rendering . OPTIONAL { ?rendering sem:layer ?layer } }
  UNION { ?reaction beh:sourceClass c:Tabs ; beh:when ?event }
}""" .

ui:sampleTodos a sem:Query ;
    rdfs:label "The todo items" , "Завдання"@uk , "Die Aufgaben"@de , "عناصر المهام"@ar ;
    rdfs:comment "The Screen card's data: the items of the todo list, in the order it sorts them."@en ;
    c:resultTab ui:queryTableTab ;
    sem:select """# The app's own data, beside the ontology that renders it.
SELECT ?item ?label ?priority ?done
WHERE {
  ex:todos c:item ?item .
  ?item rdfs:label ?label ; ex:priority ?priority ; ex:done ?done .
}
ORDER BY ?priority""" .

# --- remembered state ---------------------------------------------------------------------------------------
# The editor's text and caret, the query last run (both forms, so a restored CONSTRUCT replaces a
# SELECT: an empty text is "none"), whether its results follow updates, the results tab, the node selected in the graph, and whether
# the Query tab is a window, with its geometry. For this tab only.

ui:rememberWorkbench a per:Policy ; per:scope per:Session ;
    rdfs:label "The SPARQL workbench" , "Робоче місце SPARQL"@uk , "Die SPARQL-Werkbank"@de , "منضدة SPARQL"@ar ;
    per:construct """
CONSTRUCT {
  ui:queryEditor c:value ?text ; c:caret ?caret .
  ui:workbench c:followUpdates ?follow .
  ui:currentQuery sem:select ?select ; sem:construct ?construct ; c:runCount ?runs .
  ui:currentQuery a ?asView ; iv:materialize ?materialize ; iv:strategy ?strategy ; iv:measured ?measured .
  ui:queryResults c:selected ?view .
  ui:queryGraph c:selectedTerm ?node .
  ui:queryTab c:detached ?detached .
  ?window c:x ?x ; c:y ?y ; c:width ?w ; c:height ?h ; c:windowState ?state .
}
WHERE {
  { ui:queryEditor c:value ?text }
  UNION { ui:queryEditor c:caret ?caret }
  UNION { ui:workbench c:followUpdates ?follow }
  UNION { OPTIONAL { ui:currentQuery sem:select ?s } BIND(COALESCE(?s, "") AS ?select) }
  UNION { OPTIONAL { ui:currentQuery sem:construct ?c } BIND(COALESCE(?c, "") AS ?construct) }
  UNION { ui:currentQuery c:runCount ?runs }
  UNION { ui:currentQuery a iv:View ; iv:materialize ?materialize ; iv:strategy iv:Auto ; iv:measured ?measured BIND(iv:View AS ?asView) BIND(iv:Auto AS ?strategy) }
  UNION { ui:queryResults c:selected ?view }
  UNION { ui:queryGraph c:selectedTerm ?node }
  UNION { ui:queryTab c:detached ?detached }
  UNION { ?window prov:wasDerivedFrom ui:queryTab . { ?window c:x ?x } UNION { ?window c:y ?y } UNION { ?window c:width ?w } UNION { ?window c:height ?h } UNION { ?window c:windowState ?state } }
}""" .
