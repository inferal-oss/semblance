@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/todo#> .
@prefix ui: <https://semblance.dev/demo#> .

# --- Todo, on screen and as text ---------------------------------------------------------------
# The same component graph, projected twice: to the screen (RDF/HTML patched into the DOM)
# and to text (a second projection mounted in a slot). Change one; both follow.

ui:ex-todo a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:ex-todo-intro ui:ex-todo-body ) .
ui:ex-todo-intro a c:Text ; c:label "A todo app built from list, field, button and stat components over its own vocabulary (ex:Todo, ex:done, ex:created). On the left its screen projection; on the right the same graph projected as text. Add, tick or reorder a todo and watch both - then open the tools and hover anything." .
ui:ex-todo-body a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ; c:children ( ui:screenCard ui:textProjectionCard ) .
ui:screenCard a c:Card ;
    c:label "Screen" ; c:badge "mod:Screen" ;
    c:note "A component graph projected to RDF/HTML and patched into the DOM." ;
    c:content ui:screenStage .
ui:screenStage a c:Stack ; sty:backdrop sty:Dots ; c:children ( ui:todoCard ) .
ui:todoCard a c:Flippable ; c:front ex:page .
ui:textProjectionCard a c:Card ;
    c:label "Text" ; c:badge "mod:Text" ;
    c:note "The same graph through the text renderings of the same components." ;
    c:content ui:textCard .

# --- How it works: a walkthrough (ontology/components/walkthrough.ttl) --------------------------------
# Each step is running text whose phrases mention resources (c:Mention c:mentions): beside the steps,
# a diagram of the mentioned resources and their links; activating a mention shows its statement in
# the source (here the todo app's graph). Mentions of framework terms link to the Reference (c:to).

ui:ex-todo-how a c:Walkthrough ; c:label "How it works" ;
    c:note "Scroll through the steps: the diagram follows, and each phrase in color points at its node. Click one to see its Turtle." ;
    c:steps ( ui:ex-todo-w1 ui:ex-todo-w2 ui:ex-todo-w3 ui:ex-todo-w4 ui:ex-todo-w5 ) .

ui:ex-todo-w1 a c:WalkthroughStep ; rdfs:label "The data has its own vocabulary" ;
    c:children ( "A todo is a resource such as " ui:ex-todo-m-t1 ", described in the app's own terms: a label, a number " ui:ex-todo-m-priority " and a flag " ui:ex-todo-m-done ". Nothing in that is the framework's. The todos are gathered by " ui:ex-todo-m-todos ", which names each one with a c:item link - the graph is the whole state of the app." ) .
ui:ex-todo-w2 a c:WalkthroughStep ; rdfs:label "Components describe how to show it" ;
    c:children ( "The screen is a " ui:ex-todo-m-stack ", " ui:ex-todo-m-page ", whose children are a heading, the field " ui:ex-todo-m-newTodo ", a row of " ui:ex-todo-m-actions " and the list. The list " ui:ex-todo-m-todos2 " is a " ui:ex-todo-m-list " told which properties matter: it sorts by " ui:ex-todo-m-priority2 ", labels by rdfs:label and ticks by " ui:ex-todo-m-done2 ". Those are data too, so another app's list reads another vocabulary with the same component." ) .
ui:ex-todo-w3 a c:WalkthroughStep ; rdfs:label "Reactions turn events into changes" ;
    c:children ( "A click on " ui:ex-todo-m-add " is an RDF event. Two reactions answer it, each a pair of CONSTRUCT queries: " ui:ex-todo-m-require " writes an error on the field while it is empty, and " ui:ex-todo-m-addTodo " mints a todo from the field's value, gives it the next priority and clears the field. Both see the graph as it was before the click; their changes are applied together, as one delta, and recorded in the change log." ) .
ui:ex-todo-w4 a c:WalkthroughStep ; rdfs:label "One graph, two projections" ;
    c:children ( "Rendering rewrites the components into RDF/HTML that is patched into the page: the " ui:ex-todo-m-todoCard " flips to show the rules that made it. " ui:ex-todo-m-textCard " shows a second projection of the same graph, through the text renderings of the same components - change one, both follow. The text projection is evaluated only while it is shown." ) .
ui:ex-todo-w5 a c:WalkthroughStep ; rdfs:label "Why a change is cheap" ;
    c:children ( "The list renders member-wise: one rule run per todo, placed by its sort key. Ticking or adding one todo re-runs that todo's rules, not the list's, however long it is - the cost tests hold the work constant as the list grows. " ui:ex-todo-m-density " is cheaper still: " ui:ex-todo-m-toggle " changes one triple on " ui:ex-todo-m-page2 ", its density hook becomes one attribute in the DOM, and the theme re-values the spacing tokens for everything under it - no rule runs for the children. The status bar at the bottom of the page shows what each interaction cost." ) .

ui:ex-todo-m-t1 a c:Mention ; c:label "ex:t1" ; c:mentions ex:t1 .
ui:ex-todo-m-priority a c:Mention ; c:label "ex:priority" ; c:mentions ex:priority ; c:to ex:priority .
ui:ex-todo-m-priority2 a c:Mention ; c:label "ex:priority" ; c:mentions ex:priority ; c:to ex:priority .
ui:ex-todo-m-done a c:Mention ; c:label "ex:done" ; c:mentions ex:done ; c:to ex:done .
ui:ex-todo-m-done2 a c:Mention ; c:label "ex:done" ; c:mentions ex:done ; c:to ex:done .
ui:ex-todo-m-todos a c:Mention ; c:label "ex:todos" ; c:mentions ex:todos .
ui:ex-todo-m-todos2 a c:Mention ; c:label "ex:todos" ; c:mentions ex:todos .
ui:ex-todo-m-stack a c:Mention ; c:label "c:Stack" ; c:mentions c:Stack ; c:to c:Stack .
ui:ex-todo-m-page a c:Mention ; c:label "ex:page" ; c:mentions ex:page .
ui:ex-todo-m-page2 a c:Mention ; c:label "ex:page" ; c:mentions ex:page .
ui:ex-todo-m-newTodo a c:Mention ; c:label "ex:newTodo" ; c:mentions ex:newTodo .
ui:ex-todo-m-actions a c:Mention ; c:label "buttons" ; c:mentions ex:actions .
ui:ex-todo-m-list a c:Mention ; c:label "c:List" ; c:mentions c:List ; c:to c:List .
ui:ex-todo-m-add a c:Mention ; c:label "the Add button" ; c:mentions ex:add .
ui:ex-todo-m-require a c:Mention ; c:label "ex:RequireText" ; c:mentions ex:RequireText .
ui:ex-todo-m-addTodo a c:Mention ; c:label "ex:AddTodo" ; c:mentions ex:AddTodo .
ui:ex-todo-m-todoCard a c:Mention ; c:label "screen card" ; c:mentions ui:todoCard ; c:to ui:todoCard .
ui:ex-todo-m-textCard a c:Mention ; c:label "The text card" ; c:mentions ui:textProjectionCard ; c:to ui:textProjectionCard .
ui:ex-todo-m-density a c:Mention ; c:label "The density button" ; c:mentions ex:density .
ui:ex-todo-m-toggle a c:Mention ; c:label "its reaction" ; c:mentions ex:ToggleDensity .

# --- The todo, live: on screen, its data as Turtle and as text ----------------------------------
# The same app in a sandbox of its own (c:LiveExample, ontology/components/live.ttl), with its data
# (c:dataPreview: the todos and the new todo's field) shown as Turtle that follows every
# interaction, and the text projection beside it. The home page shows it.

ui:todoLive a c:LiveExample ;
    c:label "A todo app: on screen, as data, as text" , "Застосунок справ: на екрані, як дані, як текст"@uk ,
            "Eine Todo-App: auf dem Bildschirm, als Daten, als Text"@de , "تطبيق مهام: على الشاشة، كبيانات، كنص"@ar ;
    c:exampleRoot <https://example.org/todo#page> ;
    c:sources ( ui:todoLive-app ) ;
    c:showSources false ;
    c:textPreview true ;
    c:dataPreview """CONSTRUCT { ?s ?p ?o }
WHERE {
  { ex:todos c:item ?s . ?s ?p ?o }
  UNION
  { BIND(ex:newTodo AS ?s) ex:newTodo ?p ?o FILTER(?p IN (c:value, c:error)) }
}""" .
ui:todoLive-app a c:CodeEditor ; c:language "turtle" ; c:label "todo.ttl" ; c:original '''@prefix ex: <https://example.org/todo#> .

ex:page a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ex:newTodo ex:add ex:todos ) .
ex:newTodo a c:TextField ; c:label "New todo" ; c:placeholder "What needs doing?" .
ex:add a c:Button ; c:label "Add" ; sty:intent sty:Primary .
ex:todos a c:List ; c:label "Todos" ;
    c:sortBy ex:priority ; c:itemLabel rdfs:label ; c:itemChecked ex:done ;
    c:item ex:t1 , ex:t2 , ex:t3 .

ex:t1 rdfs:label "Write the core ontology" ; ex:priority 1 ; ex:done true .
ex:t2 rdfs:label "Sketch the style layer" ; ex:priority 2 ; ex:done false .
ex:t3 rdfs:label "Wire up behaviour" ; ex:priority 3 ; ex:done false .

# A click on Add with an empty field is an error; with text, a new todo.
ex:RequireText a beh:Reaction ; beh:when beh:Click ; beh:source ex:add ;
    beh:inserts """PREFIX ex: <https://example.org/todo#>
CONSTRUCT { ex:newTodo c:error "Please describe the todo first." }
WHERE { FILTER NOT EXISTS { ex:newTodo c:value ?v FILTER(STRLEN(STR(?v)) > 0) } }""" .
ex:AddTodo a beh:Reaction ; beh:when beh:Click ; beh:source ex:add ;
    beh:deletes """PREFIX ex: <https://example.org/todo#>
CONSTRUCT { ex:newTodo c:value ?v ; c:error ?e }
WHERE { ex:newTodo c:value ?v FILTER(STRLEN(STR(?v)) > 0) OPTIONAL { ex:newTodo c:error ?e } }""" ;
    beh:inserts """PREFIX ex: <https://example.org/todo#>
CONSTRUCT { ?item rdfs:label ?v ; ex:priority ?next ; ex:done false . ex:todos c:item ?item . }
WHERE {
  ex:newTodo c:value ?v FILTER(STRLEN(STR(?v)) > 0)
  { SELECT (COALESCE(MAX(?p) + 1, 1) AS ?next) WHERE { ?any ex:priority ?p } }
  BIND(IRI(CONCAT(STR(ex:), "t", STR(?next))) AS ?item)
}""" .''' .
