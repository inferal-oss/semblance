@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .

# Inspection gallery: panes. A split view (side by side and stacked) whose divider position is
# graph state, and dock panels attached to an edge of their container.

ui:in-panes a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:in-split ui:in-split-stacked ui:in-dock ui:in-dock-end ) .

# --- SplitView: a list beside its details ---------------------------------------------------------

ui:in-split-view a c:SplitView ; c:label "the request list" ; c:ratio 0.4 ; c:minSize 140 ;
    c:primary ui:in-split-list ; c:secondary ui:in-split-detail .
ui:in-split-list a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-2 ;
    c:children ( ui:in-split-l1 ui:in-split-l2 ui:in-split-l3 ui:in-split-l4 ) .
ui:in-split-l1 a c:Text ; sty:textStyle sty:Mono ; c:label "#1  GET /api/todos" .
ui:in-split-l2 a c:Text ; sty:textStyle sty:Mono ; c:label "#2  POST /api/todos" .
ui:in-split-l3 a c:Text ; sty:textStyle sty:Mono ; c:label "#3  GET /api/user" .
ui:in-split-l4 a c:Text ; sty:textStyle sty:Mono ; c:label "#4  WS  /live" .
ui:in-split-item-method c:label "Method" ; c:value "POST" .
ui:in-split-item-url c:label "URL" ; c:value "/api/todos" .
ui:in-split-item-status c:label "Status" ; c:value "201 Created" .
ui:in-split-item-time c:label "Duration" ; c:value "84 ms" .
ui:in-split-detail a c:DescriptionList ;
    c:items ( ui:in-split-item-method ui:in-split-item-url ui:in-split-item-status ui:in-split-item-time ) .
ui:in-split-collapse a c:ToggleSwitch ; sty:size sty:Small ; c:label "Hide the details" ;
    c:controls ui:in-split-view ; c:property c:collapsed .
ui:in-split-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:in-split-collapse ui:in-split-view ) .
ui:in-split a c:Flippable ; c:front ui:in-split-spec .
ui:in-split-spec a c:Specimen ; c:label "Split view" ;
    c:help "Two panes and a divider (role=separator). Drag the divider, or focus it and use the arrow keys, Home and End: one beh:Size event sets the first pane's share, c:ratio, as graph state (within c:minSize of either end). c:collapsed hides the second pane; here a switch sets it." ;
    c:children ( ui:in-split-col ) .

# --- SplitView, stacked ---------------------------------------------------------------------------

ui:in-split-stacked-view a c:SplitView ; pos:direction pos:Column ; c:label "the request and its response" ; c:ratio 0.5 ;
    c:primary ui:in-split-request ; c:secondary ui:in-split-response .
ui:in-split-request a c:Text ; sty:textStyle sty:Mono ; c:label "POST /api/todos  {\"title\": \"Write the report\"}" .
ui:in-split-response a c:Text ; sty:textStyle sty:Mono ; c:label "201 Created  {\"id\": 42, \"title\": \"Write the report\", \"done\": false}" .
ui:in-split-stacked a c:Flippable ; c:front ui:in-split-stacked-spec .
ui:in-split-stacked-spec a c:Specimen ; c:label "Split view, stacked" ;
    c:help "pos:direction pos:Column stacks the panes; the divider then sizes the first pane's height (the up and down arrow keys move it)." ;
    c:children ( ui:in-split-stacked-view ) .

# --- DockPanel at the bottom ----------------------------------------------------------------------

ui:in-dock-panel a c:DockPanel ; c:label "Activity" ; c:badge "3 events" ; c:height 220 ;
    c:actions ( ui:in-dock-clear ) ;
    c:toolbar ui:in-dock-tools ; c:content ui:in-dock-body ; c:footer ui:in-dock-foot .
ui:in-dock-clear a c:Button ; c:label "Clear" ; sty:size sty:Small ; sty:emphasis sty:Ghost .
ui:in-dock-tools a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-2 ;
    c:children ( ui:in-dock-live ui:in-dock-http ui:in-dock-socket ) .
ui:in-dock-live a c:Badge ; c:label "Recording" ; sty:tone sty:Success .
ui:in-dock-http a c:Badge ; c:label "HTTP" ; sty:tone sty:Info .
ui:in-dock-socket a c:Badge ; c:label "Socket" ; sty:tone sty:Accent .
ui:in-dock-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-2 ; pos:inset tok:space-4 ;
    c:children ( ui:in-dock-e1 ui:in-dock-e2 ui:in-dock-e3 ) .
ui:in-dock-e1 a c:Text ; sty:textStyle sty:Mono ; c:label "12:00:01  Saved a draft" .
ui:in-dock-e2 a c:Text ; sty:textStyle sty:Mono ; c:label "12:00:03  GET /api/todos  200" .
ui:in-dock-e3 a c:Text ; sty:textStyle sty:Mono ; c:label "12:00:04  Socket opened" .
ui:in-dock-foot a c:Text ; sty:textStyle sty:Caption ; c:label "3 entries · newest last" .
ui:in-dock-page a c:Text ; c:label "The panel is docked to the bottom of this surface: it stays at that edge while the page scrolls past it. Its title folds it to its header; its top edge resizes it." .
ui:in-dock-stage a c:Surface ; sty:elevation sty:Flat ; c:children ( ui:in-dock-page ui:in-dock-panel ) .
ui:in-dock a c:Flippable ; c:front ui:in-dock-spec .
ui:in-dock-spec a c:Specimen ; c:label "Dock panel" ;
    c:help "A c:Dockable panel: c:attachedTo an edge of its container (the bottom by default), with a header (title, badge, actions), a toolbar, a body and a footer. Its free edge is a size handle (drag it, or focus it and use the arrow keys) that sets c:height; its title folds it (c:expanded). Both are graph state." ;
    c:children ( ui:in-dock-stage ) .

# --- DockPanel at the end ---------------------------------------------------------------------------

ui:in-dock-end-panel a c:DockPanel ; c:label "Details" ; c:attachedTo c:EndEdge ; c:width 240 ; c:minSize 160 ;
    c:content ui:in-dock-end-body .
ui:in-dock-end-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-2 ; pos:inset tok:space-4 ;
    c:children ( ui:in-dock-end-t1 ui:in-dock-end-t2 ) .
ui:in-dock-end-t1 a c:Text ; sty:textStyle sty:Subtitle ; c:label "GET /api/todos" .
ui:in-dock-end-t2 a c:Text ; sty:textStyle sty:Caption ; c:label "200 · 1.2 KiB · 84 ms" .
ui:in-dock-end-page a c:Text ; c:label "Attached to the end edge, the panel's size is its c:width, and its start edge is the handle." .
ui:in-dock-end-stage a c:Surface ; sty:elevation sty:Flat ; pos:direction pos:Row ;
    c:children ( ui:in-dock-end-page ui:in-dock-end-panel ) .
ui:in-dock-end a c:Flippable ; c:front ui:in-dock-end-spec .
ui:in-dock-end-spec a c:Specimen ; c:label "Dock panel, at the end" ;
    c:help "c:attachedTo c:EndEdge: the same panel, sized by c:width." ;
    c:children ( ui:in-dock-end-stage ) .
