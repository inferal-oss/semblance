@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix file: <https://semblance.dev/ns/file#> .

# Gallery page: Inputs.

ui:gallery-inputs a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-inputs-intro ui:inp-text ui:inp-search ui:inp-codes ui:inp-editor ui:inp-checkboxes ui:inp-radios ui:inp-switches
                 ui:inp-sliders ui:inp-fields ui:inp-selection ui:inp-typeahead ui:inp-tags ui:inp-dates ui:inp-month ui:inp-files ) .
ui:gallery-inputs-intro a c:Heading ; c:label "Inputs" .

# --- The node the shared controls edit ------------------------------------------------------------
# Controls that edit "a property of a node" (c:controls / c:property) all point here, so one
# triple shows up in several controls at once.

ui:inputsDemo ui:inp-plan ui:inp-plan-pro ; ui:inp-notify true ; ui:inp-topic ui:inp-topic-rdf .

ui:inp-plan a rdf:Property ; rdfs:label "Plan" ; rdfs:range ui:InpPlan .
ui:InpPlan a owl:Class .
ui:inp-plan-free a ui:InpPlan ; rdfs:label "Free" ; sem:order 1 ; rdfs:comment "One project, community support." .
ui:inp-plan-pro a ui:InpPlan ; rdfs:label "Pro" ; sem:order 2 ; rdfs:comment "Unlimited projects and history." .
ui:inp-plan-team a ui:InpPlan ; rdfs:label "Team" ; sem:order 3 ; rdfs:comment "Shared workspaces and roles." .

ui:inp-notify a rdf:Property ; rdfs:label "Email notifications" ; rdfs:range xsd:boolean .

ui:inp-topic a rdf:Property ; rdfs:label "Topics" ; rdfs:range ui:InpTopic .
ui:InpTopic a owl:Class .
ui:inp-topic-rdf a ui:InpTopic ; rdfs:label "RDF" ; sem:order 1 .
ui:inp-topic-sparql a ui:InpTopic ; rdfs:label "SPARQL" ; sem:order 2 .
ui:inp-topic-shacl a ui:InpTopic ; rdfs:label "SHACL" ; sem:order 3 .
ui:inp-topic-ui a ui:InpTopic ; rdfs:label "Interfaces" ; sem:order 4 .

# --- Text: TextField and TextArea -------------------------------------------------------------------

ui:inp-tf-name a c:TextField ; c:label "Name" ; c:placeholder "Ada Lovelace" .
ui:inp-ta-about a c:TextArea ; c:label "Description" ; c:rows 3 ;
    c:placeholder "What is this project about?" ; c:help "Plain text. Every keystroke sets c:value on this instance." .
ui:inp-ta-error a c:TextArea ; c:label "Release notes" ; c:rows 2 ; c:value "tbd" ;
    c:error "Release notes need at least one full sentence." .
ui:inp-ta-off a c:TextArea ; c:label "Archived note" ; c:rows 2 ; c:disabled true ; c:value "This note is read-only." .
ui:inp-ta-sm a c:TextArea ; c:label "Small" ; c:rows 1 ; sty:size sty:Small ; c:placeholder "A small, single-row text area" .
ui:inp-text-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-tf-name ui:inp-ta-about ui:inp-ta-error ui:inp-ta-off ui:inp-ta-sm ) .
ui:inp-text a c:Flippable ; c:front ui:inp-text-spec .
ui:inp-text-spec a c:Specimen ; c:demonstrates c:TextField , c:TextArea ; c:label "Text field and text area" ;
    c:help "A c:TextArea is the multi-line sibling of c:TextField: label, placeholder, c:rows, help and an announced error line (aria-describedby, aria-invalid). Typing is an RDF event whose reaction sets c:value." ;
    c:children ( ui:inp-text-col ) .

# --- Search field: what is typed, as a property of a node ------------------------------------------

ui:inp-search-text a owl:DatatypeProperty ; rdfs:label "search"@en .
ui:inp-search-field a c:SearchField ; c:label "Search the components" ; c:placeholder "Name, slug or group…" ;
    c:controls ui:inp-search-query ; c:property ui:inp-search-text .
ui:inp-search-waiting ui:inp-search-text "Waiting for index" .
ui:inp-search-field-off a c:SearchField ;
    c:label "Search while loading"@en , "Пошук під час завантаження"@uk ,
            "Suche während des Ladens"@de , "البحث أثناء التحميل"@ar ;
    c:disabled true ;
    c:controls ui:inp-search-waiting ; c:property ui:inp-search-text .
ui:inp-search-state a c:Metrics ; c:of ui:inp-search-query ; c:fields ( ui:inp-search-text ) .
ui:inp-search a c:Flippable ; c:front ui:inp-search-spec .
ui:inp-search-spec a c:Specimen ; c:demonstrates c:SearchField ; c:label "Search field" ;
    c:help "A search box (type=search) bound to a property of a node (c:controls / c:property): typing writes what is typed, and emptying it, its ✕ or Escape removes the triple. The chip below reads the node back. A toolbar's filters are fields like this one." ;
    c:children ( ui:inp-search-field ui:inp-search-field-off ui:inp-search-state ) .

# --- Code input: one-time codes of any length and alphabet ----------------------------------------
# What a code may contain is a c:Charset; this one is defined here, not in the framework: no
# 0/O, 1/I/L, so it can be read aloud.

ui:Unambiguous a c:Charset ; rdfs:label "Unambiguous letters and digits" ; c:characters "2-9A-HJ-KMNP-Z" ; c:inputMode "text" .

ui:inp-code-signin a c:CodeInput ; c:label "Sign-in code" ; c:length 6 ;
    c:help "We sent a 6-digit code to ada@example.com. Paste it, or type it." .
ui:inp-code-recovery a c:CodeInput ; c:label "Recovery code" ; c:length 8 ; c:groupSize 4 ;
    c:charset c:Alphanumeric ; c:case c:UpperCase ; c:cellStyle c:Joined .
ui:inp-code-pair a c:CodeInput ; c:label "Pairing code (read aloud)" ; c:length 6 ; c:groupSize 3 ;
    c:charset ui:Unambiguous ; c:case c:UpperCase ; c:cellStyle c:Filled ; sty:tone sty:Accent .
ui:inp-code-pin a c:CodeInput ; c:label "PIN" ; c:length 4 ; c:masked true ; c:cellStyle c:Underlined ; sty:size sty:Large .
ui:inp-code-key a c:CodeInput ; c:label "Device key" ; c:length 16 ; c:groupSize 4 ; c:charset c:Hexadecimal ;
    c:case c:LowerCase ; sty:size sty:Small .
ui:inp-code-expired a c:CodeInput ; c:label "Expired code" ; c:length 6 ; c:value "482913" ; c:error "That code has expired. Ask for a new one." .
ui:inp-code-off a c:CodeInput ; c:label "Waiting for a code" ; c:length 6 ; c:disabled true .
ui:inp-code-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:inp-code-signin ui:inp-code-recovery ui:inp-code-pair ui:inp-code-pin ui:inp-code-key ui:inp-code-expired ui:inp-code-off ) .
ui:inp-codes a c:Flippable ; c:front ui:inp-codes-spec .
ui:inp-codes-spec a c:Specimen ; c:demonstrates c:CodeInput , c:Charset , c:Case , c:CellStyle ; c:label "Code input" ;
    c:help "A c:CodeInput is one real field (so paste and SMS autofill work) over a row of cells. Its c:Charset says what it accepts - digits, letters, hexadecimal, or your own character class - and typing keeps only that, in its c:case, up to c:length. Groups, masking, sizes and four c:cellStyle values are variations; a complete code turns green." ;
    c:children ( ui:inp-code-col ) .

# --- Checkbox ---------------------------------------------------------------------------------------

ui:inp-cb-updates a c:Checkbox ; c:label "Email me about product updates" ; c:checked true ;
    c:help "At most one email a month." .
ui:inp-cb-usage a c:Checkbox ; c:label "Share anonymous usage data" ; c:checked false .
ui:inp-cb-success a c:Checkbox ; c:label "Run checks before publishing" ; c:checked true ; sty:tone sty:Success .
ui:inp-cb-terms a c:Checkbox ; c:label "I accept the terms" ; c:checked false ; c:error "You need to accept the terms to continue." .
ui:inp-cb-off a c:Checkbox ; c:label "Required cookies (always on)" ; c:checked true ; c:disabled true .
ui:inp-cb-sm a c:Checkbox ; c:label "Small" ; c:checked true ; sty:size sty:Small .
ui:inp-cb-lg a c:Checkbox ; c:label "Large" ; c:checked false ; sty:size sty:Large .
ui:inp-cb-sizes a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:inp-cb-sm ui:inp-cb-lg ) .
ui:inp-cb-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:inp-cb-updates ui:inp-cb-usage ui:inp-cb-success ui:inp-cb-terms ui:inp-cb-off ui:inp-cb-sizes ) .
ui:inp-checkboxes a c:Flippable ; c:front ui:inp-checkboxes-spec .
ui:inp-checkboxes-spec a c:Specimen ; c:demonstrates c:Checkbox ; c:label "Checkbox" ;
    c:help "A labelled check box whose state is c:checked on the instance; the change event carries beh:checked and the reaction writes it back. The checked color is the sty:tone (accent by default)." ;
    c:children ( ui:inp-cb-col ) .

# --- RadioGroup (and the other editors of the same triple) ------------------------------------------

ui:inp-rg-plan a c:RadioGroup ; c:label "Plan" ; c:controls ui:inputsDemo ; c:property ui:inp-plan ;
    c:help "Options are the individuals of the property's rdfs:range." .
ui:inp-rg-row a c:RadioGroup ; c:controls ui:inputsDemo ; c:property ui:inp-plan ; pos:direction pos:Row ; sty:size sty:Small .
ui:inp-rg-seg a c:Segmented ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:inp-rg-choice a c:Choice ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:inp-rg-others a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:inp-rg-seg ui:inp-rg-choice ) .
ui:inp-rg-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:inp-rg-plan ui:inp-rg-row ui:inp-rg-others ) .
ui:inp-radios a c:Flippable ; c:front ui:inp-radios-spec .
ui:inp-radios-spec a c:Specimen ; c:demonstrates c:RadioGroup ; c:label "Radio group" ;
    c:help "Edits c:property of c:controls, like c:Segmented and c:Choice: here all four edit the same triple (ui:inputsDemo ui:inp-plan), so choosing in one updates the others. pos:direction pos:Row lays the options out in a row; rdfs:comment describes each option." ;
    c:children ( ui:inp-rg-col ) .

# --- ToggleSwitch -----------------------------------------------------------------------------------

ui:inp-sw-wifi a c:ToggleSwitch ; c:label "Wi-Fi" ; c:checked true .
ui:inp-sw-notify a c:ToggleSwitch ; c:controls ui:inputsDemo ; c:property ui:inp-notify ;
    c:help "Edits ui:inp-notify of ui:inputsDemo, like the c:Toggle next to it." .
ui:inp-sw-toggle a c:Toggle ; c:controls ui:inputsDemo ; c:property ui:inp-notify ; c:label "Notifications (c:Toggle)" .
ui:inp-sw-success a c:ToggleSwitch ; c:label "Auto-deploy" ; c:checked true ; sty:tone sty:Success .
ui:inp-sw-danger a c:ToggleSwitch ; c:label "Maintenance mode" ; c:checked false ; sty:tone sty:Danger .
ui:inp-sw-off a c:ToggleSwitch ; c:label "Locked setting" ; c:checked true ; c:disabled true .
ui:inp-sw-sm a c:ToggleSwitch ; c:label "Small" ; c:checked true ; sty:size sty:Small .
ui:inp-sw-lg a c:ToggleSwitch ; c:label "Large" ; c:checked true ; sty:size sty:Large .
ui:inp-sw-shared a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-4 ; c:children ( ui:inp-sw-notify ui:inp-sw-toggle ) .
ui:inp-sw-tones a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:inp-sw-wifi ui:inp-sw-success ui:inp-sw-danger ui:inp-sw-off ) .
ui:inp-sw-sizes a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-5 ; c:children ( ui:inp-sw-sm ui:inp-sw-lg ) .
ui:inp-sw-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:inp-sw-shared ui:inp-sw-tones ui:inp-sw-sizes ) .
ui:inp-switches a c:Flippable ; c:front ui:inp-switches-spec .
ui:inp-switches-spec a c:Specimen ; c:demonstrates c:ToggleSwitch ; c:label "Switch" ;
    c:help "c:ToggleSwitch (role=switch, aria-checked): its own c:checked, or a boolean property of another node - the design-system version of c:Toggle, which edits the same triple here. Colored by sty:tone, scaled by sty:size." ;
    c:children ( ui:inp-sw-col ) .

# --- Slider -----------------------------------------------------------------------------------------

ui:inp-sl-volume a c:Slider ; c:label "Volume" ; c:value 40 ; c:unit "%" .
ui:inp-sl-opacity a c:Slider ; c:label "Opacity" ; c:min 0 ; c:max 1 ; c:step 0.05 ; c:value 0.8 ;
    c:help "From 0 to 1 in steps of 0.05." .
ui:inp-sl-temp a c:Slider ; c:label "Temperature" ; c:min 16 ; c:max 28 ; c:step 0.5 ; c:value 21.5 ; c:unit "°C" ; sty:tone sty:Warning .
ui:inp-sl-sm a c:Slider ; c:label "Small" ; c:value 70 ; sty:size sty:Small ; sty:tone sty:Success .
ui:inp-sl-off a c:Slider ; c:label "Disabled" ; c:value 25 ; c:disabled true .
ui:inp-sl-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-sl-volume ui:inp-sl-opacity ui:inp-sl-temp ui:inp-sl-sm ui:inp-sl-off ) .
ui:inp-sliders a c:Flippable ; c:front ui:inp-sliders-spec .
ui:inp-sliders-spec a c:Specimen ; c:demonstrates c:Slider ; c:label "Slider" ;
    c:help "A range input over c:min, c:max and c:step. Each input event writes c:value (xsd:decimal); the rule shows it beside the label and paints the filled track from it." ;
    c:children ( ui:inp-sl-col ) .

# --- Field ------------------------------------------------------------------------------------------

ui:inp-f-bio-input a c:TextArea ; c:rows 2 ; c:placeholder "A line or two about you" .
ui:inp-f-bio a c:Field ; c:label "Bio" ; c:content ui:inp-f-bio-input ; c:help "Shown on your profile." .
ui:inp-f-level-input a c:Slider ; c:value 60 ; c:unit "%" .
ui:inp-f-level a c:Field ; c:label "Brightness" ; c:content ui:inp-f-level-input .
ui:inp-f-plan-input a c:RadioGroup ; c:controls ui:inputsDemo ; c:property ui:inp-plan ; pos:direction pos:Row ; sty:size sty:Small .
ui:inp-f-plan a c:Field ; c:label "Billing plan" ; c:content ui:inp-f-plan-input ; c:help "A group of options is labelled with aria-labelledby." .
ui:inp-f-terms-input a c:Checkbox ; c:label "I have read the data policy" ; c:checked false .
ui:inp-f-terms a c:Field ; c:label "Consent" ; c:content ui:inp-f-terms-input ; c:error "Consent is required before you continue." .
ui:inp-f-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:inp-f-bio ui:inp-f-level ui:inp-f-plan ui:inp-f-terms ) .
ui:inp-fields a c:Flippable ; c:front ui:inp-fields-spec .
ui:inp-fields-spec a c:Specimen ; c:demonstrates c:Field ; c:label "Field" ;
    c:help "Gives any control (c:content) a label, help and an error line. The label points at the element the control's class names as its c:labelPart (label for); help and error describe it (aria-describedby, aria-invalid)." ;
    c:children ( ui:inp-f-col ) .

# --- Selection: Choice and Chips --------------------------------------------------------------------

ui:inp-sel-choice a c:Choice ; c:label "Plan" ; c:controls ui:inputsDemo ; c:property ui:inp-plan .
ui:inp-sel-choice-locked a c:Choice ;
    c:label "Plan (disabled)"@en , "План (вимкнено)"@uk , "Plan (deaktiviert)"@de , "الخطة (معطّلة)"@ar ;
    c:controls ui:inputsDemo ; c:property ui:inp-plan ; c:disabled true .
ui:inp-sel-chips a c:Chips ; c:controls ui:inputsDemo ; c:property ui:inp-topic .
ui:inp-sel-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:inp-sel-choice ui:inp-sel-choice-locked ui:inp-sel-chips ) .
ui:inp-selection a c:Flippable ; c:front ui:inp-selection-spec .
ui:inp-selection-spec a c:Specimen ; c:demonstrates c:Choice , c:Chips ; c:label "Select and chips" ;
    c:help "c:Choice is a native select for a single-valued property; c:Chips toggle the values of a multi-valued one (ui:inp-topic). Both draw their options from the property's rdfs:range." ;
    c:children ( ui:inp-sel-col ) .

# --- Typeahead: Combobox -----------------------------------------------------------------------------
# Options from a class (ui:InpCountry, the range of ui:inp-country): type "cura" or "reu" and the
# accented names match. The team combobox allows custom values: a new name becomes a ui:InpTeam
# with that rdfs:label, if it conforms to ui:TeamNameShape.

ui:inputsDemo ui:inp-country ui:country-pt ; ui:inp-team ui:team-design .

ui:inp-country a rdf:Property ; rdfs:label "Country" ; rdfs:range ui:InpCountry .
ui:InpCountry a owl:Class .
ui:country-ax a ui:InpCountry ; rdfs:label "Åland Islands" .
ui:country-at a ui:InpCountry ; rdfs:label "Austria" .
ui:country-ci a ui:InpCountry ; rdfs:label "Côte d’Ivoire" .
ui:country-cw a ui:InpCountry ; rdfs:label "Curaçao" .
ui:country-cz a ui:InpCountry ; rdfs:label "Czechia" .
ui:country-is a ui:InpCountry ; rdfs:label "Iceland" .
ui:country-pt a ui:InpCountry ; rdfs:label "Portugal" .
ui:country-re a ui:InpCountry ; rdfs:label "Réunion" .
ui:country-st a ui:InpCountry ; rdfs:label "São Tomé and Príncipe" .
ui:country-tr a ui:InpCountry ; rdfs:label "Türkiye" .
ui:country-ua a ui:InpCountry ; rdfs:label "Ukraine" .
ui:country-uy a ui:InpCountry ; rdfs:label "Uruguay" .

ui:inp-team a owl:ObjectProperty ; rdfs:label "Team" ; rdfs:range ui:InpTeam .
ui:InpTeam a owl:Class .
ui:team-design a ui:InpTeam ; rdfs:label "Design" .
ui:team-platform a ui:InpTeam ; rdfs:label "Platform" .
ui:team-research a ui:InpTeam ; rdfs:label "Research" .
ui:TeamNameShape a sh:PropertyShape ; sh:path ui:inp-team ; sh:minLength 2 ; sh:maxLength 24 ; sh:pattern "^[A-Za-zÀ-ÿ ]+$" ;
    sh:message "A team name is 2 to 24 letters." .

ui:inp-combo-country a c:Combobox ; c:controls ui:inputsDemo ; c:property ui:inp-country ;
    c:placeholder "Search countries" ; c:help "Only listed countries: matching ignores case and accents." .
ui:inp-combo-team a c:Combobox ; c:controls ui:inputsDemo ; c:property ui:inp-team ; c:allowsCustom true ;
    c:placeholder "Pick or name a team" ; val:validates ui:TeamNameShape ;
    c:help "Type a new name and press Enter: it becomes a ui:InpTeam." .
ui:inp-combo-plan a c:Combobox ; c:controls ui:inputsDemo ; c:property ui:inp-plan ; sty:size sty:Small .
ui:inp-combo-off a c:Combobox ; c:label "Region (locked)" ; c:controls ui:inputsDemo ; c:property ui:inp-country ; c:disabled true .
ui:inp-combo-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-combo-country ui:inp-combo-team ui:inp-combo-plan ui:inp-combo-off ) .
ui:inp-typeahead a c:Flippable ; c:front ui:inp-typeahead-spec .
ui:inp-typeahead-spec a c:Specimen ; c:demonstrates c:Combobox ; c:label "Combobox" ;
    c:help "A c:Combobox is a field you type into to find one value of a property (c:controls, c:property), like a c:Choice that searches: role=combobox over a role=listbox, the active option by aria-activedescendant. Its options are the instances of the property's range (or c:optionClass, or a c:options list); ↓ ↑ move, Enter picks, Escape gives your text back. With c:allowsCustom true, a name that matches nothing can be created, checked by a SHACL shape (val:validates). The small one edits the same plan as the radio group. Over thousands of options (the Reference page's search: c:optionsFrom its tree, by prefixed name), c:optionLimit lists only the best matches, built while the list is open." ;
    c:children ( ui:inp-combo-col ) .

# --- Typeahead: TagInput -----------------------------------------------------------------------------
# Topics (ui:inp-topic, the c:Chips above edit it too) come from a class and cannot be invented.
# Labels are literals: the options are every label already in use, on any node; a new one is made
# by Enter or a comma, at most four, each up to 16 lower-case letters, digits or dashes.

ui:inputsDemo ui:inp-labels "design" , "a11y" .
ui:inputsOther ui:inp-labels "performance" , "rdf" , "überblick" .
ui:inp-labels a owl:DatatypeProperty ; rdfs:label "Labels" .
ui:LabelsShape a sh:PropertyShape ; sh:path ui:inp-labels ; sh:maxCount 4 ; sh:maxLength 16 ; sh:pattern "^[a-z0-9äöüß-]+$" ;
    sh:message "Up to four labels, each a lower-case word (a-z, 0-9, dashes)." .

ui:inp-tags-topics a c:TagInput ; c:controls ui:inputsDemo ; c:property ui:inp-topic ;
    c:placeholder "Add a topic" ; c:help "Options only: the topics of ui:InpTopic." .
ui:inp-tags-labels a c:TagInput ; c:controls ui:inputsDemo ; c:property ui:inp-labels ;
    c:optionsInUse true ; c:allowsCustom true ; val:validates ui:LabelsShape ;
    c:placeholder "Add a label" ; c:help "Labels in use anywhere are suggested; Enter or a comma adds a new one. Backspace in the empty field removes the last." .
ui:inp-tags-off a c:TagInput ; c:label "Topics (locked)" ; c:controls ui:inputsDemo ; c:property ui:inp-topic ; c:disabled true .
ui:inp-tags-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-tags-topics ui:inp-tags-labels ui:inp-tags-off ) .
ui:inp-tags a c:Flippable ; c:front ui:inp-tags-spec .
ui:inp-tags-spec a c:Specimen ; c:demonstrates c:TagInput ; c:label "Tag input" ;
    c:help "A c:TagInput edits a multi-valued property: its values are c:Tag pills (✕ removes one), and the field finds more to add with the same typeahead. A value is never added twice. With c:allowsCustom, Enter or a comma adds what you typed; c:optionsInUse offers every value the property already has. The shape's sh:maxCount caps the count, and its message is shown at the cap." ;
    c:children ( ui:inp-tags-col ) .

# --- Dates and times ---------------------------------------------------------------------------------
# A trip on ui:inputsDemo: a departure (a date field and, below, a month grid edit the same value),
# a stay (a date range) and a pickup time. What may be picked is SHACL: departures run from
# 3 November 2026 to 31 March 2027, a stay ends on or after it starts, pickups are by day. Switch the
# language (Arabic: right to left, the arrows swap) and the formats, names and first day of the week
# follow the locale.

ui:inputsDemo ui:inp-departs "2026-11-12"^^xsd:date ; ui:inp-stay-from "2026-11-20"^^xsd:date ; ui:inp-stay-until "2026-11-24"^^xsd:date ;
    ui:inp-pickup "09:30:00"^^xsd:time .
ui:inp-departs a owl:DatatypeProperty ; rdfs:label "Departure" ; rdfs:range xsd:date .
ui:inp-stay-from a owl:DatatypeProperty ; rdfs:label "Check-in" ; rdfs:range xsd:date .
ui:inp-stay-until a owl:DatatypeProperty ; rdfs:label "Check-out" ; rdfs:range xsd:date .
ui:inp-pickup a owl:DatatypeProperty ; rdfs:label "Pickup" ; rdfs:range xsd:time .
ui:DepartureShape a sh:PropertyShape ; sh:path ui:inp-departs ; sh:datatype xsd:date ; sh:minCount 1 ;
    sh:minInclusive "2026-11-03"^^xsd:date ; sh:maxInclusive "2027-03-31"^^xsd:date ;
    sh:message "Departures run from 3 November 2026 to 31 March 2027."@en , "Відправлення з 3 листопада 2026 до 31 березня 2027."@uk ,
               "Abfahrten vom 3. November 2026 bis 31. März 2027."@de , "الرحلات من 3 نوفمبر 2026 حتى 31 مارس 2027."@ar .
ui:StayShape a sh:PropertyShape ; sh:path ui:inp-stay-from ; sh:datatype xsd:date ; sh:lessThanOrEquals ui:inp-stay-until ;
    sh:message "The stay ends before it starts."@en , "Перебування закінчується раніше, ніж починається."@uk ,
               "Der Aufenthalt endet, bevor er beginnt."@de , "تنتهي الإقامة قبل أن تبدأ."@ar .
ui:PickupShape a sh:PropertyShape ; sh:path ui:inp-pickup ; sh:datatype xsd:time ;
    sh:minInclusive "07:00:00"^^xsd:time ; sh:maxInclusive "21:00:00"^^xsd:time ;
    sh:message "Pickups are from 7:00 to 21:00."@en , "Трансфер з 7:00 до 21:00."@uk , "Abholung von 7:00 bis 21:00."@de , "الاستلام من 7:00 حتى 21:00."@ar .

ui:inp-date-departs a c:DateField ; c:controls ui:inputsDemo ; c:property ui:inp-departs ; val:validates ui:DepartureShape ;
    c:label "Departure"@en , "Відправлення"@uk , "Abfahrt"@de , "المغادرة"@ar ;
    c:help "Type a date in your locale's format, or pick one from the calendar beside it." .
ui:inp-date-stay a c:DateRangeField ; c:controls ui:inputsDemo ; c:property ui:inp-stay-from ; c:endProperty ui:inp-stay-until ;
    val:validates ui:StayShape ;
    c:label "Stay"@en , "Перебування"@uk , "Aufenthalt"@de , "الإقامة"@ar ;
    c:help "Pick the first night, then the last: the days between are highlighted." .
ui:inp-time-pickup a c:TimeField ; c:controls ui:inputsDemo ; c:property ui:inp-pickup ; val:validates ui:PickupShape ; c:minuteStep 15 ;
    c:label "Pickup"@en , "Трансфер"@uk , "Abholung"@de , "الاستلام"@ar .
ui:inp-date-off a c:DateField ; c:controls ui:inputsDemo ; c:property ui:inp-departs ; c:disabled true ;
    c:label "Departure (locked)"@en , "Відправлення (заблоковано)"@uk , "Abfahrt (gesperrt)"@de , "المغادرة (مقفل)"@ar .
ui:inp-dates-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-date-departs ui:inp-date-stay ui:inp-time-pickup ui:inp-date-off ) .
ui:inp-dates a c:Flippable ; c:front ui:inp-dates-spec .
ui:inp-dates-spec a c:Specimen ; c:demonstrates c:DateField , c:DateRangeField , c:TimeField ; c:label "Date and time fields" ;
    c:help "A c:DateField edits an xsd:date of a node (c:controls, c:property): it shows and reads the date in the viewer's locale (dd.mm.yyyy, mm/dd/yyyy, ISO always), and ▦ opens a month grid in a popup (role=dialog) that takes the focus on the date: the arrows move by a day and a week, Home and End to the week's ends, Page Up and Down by a month (Shift: a year), Enter picks and closes, Escape closes; the focus returns to the button. A c:DateRangeField picks a start and then an end (c:endProperty) on one grid, the span highlighted and previewed under the pointer. A c:TimeField reads 14:30 or 2:30 pm and lists times every c:minuteStep minutes. What may be picked is the val:validates shape's sh:minInclusive / sh:maxInclusive (and sh:lessThanOrEquals for a range); text that is not a date says how to write one." ;
    c:children ( ui:inp-dates-col ) .

ui:inp-month-grid a c:MonthGrid ; c:controls ui:inputsDemo ; c:property ui:inp-departs ; val:validates ui:DepartureShape .
ui:inp-month a c:Flippable ; c:front ui:inp-month-spec .
ui:inp-month-spec a c:Specimen ; c:demonstrates c:MonthGrid ; c:label "Month grid" ;
    c:help "A c:MonthGrid is the month a date field's popup shows, on its own: a WAI-ARIA grid of day buttons under the month and its arrows, the weeks from the locale's first day (or c:firstDayOfWeek), today marked (aria-current), the picked day selected (aria-selected), days out of the shape's bounds disabled. Only the active day is in the tab order; the keys move it, and the month with it. It sets the same departure as the field above; with c:endProperty it picks a range." ;
    c:children ( ui:inp-month-grid ) .

# --- File drop ----------------------------------------------------------------------------------------
# Attachments: images and PDFs up to 2 MB, at most three, uploaded at once by the site's stand-in
# server (the "demo" handler the host gives the files effect: it takes a moment, and fails the first
# try of every third file, so progress, failure and retry can be seen). A profile picture: one PNG or
# JPEG, kept in the page (no upload). The locked one shows the attachments, read-only.

ui:inp-attachment a rdf:Property ; rdfs:label "Attachments" ; rdfs:range file:File .
ui:inp-picture a rdf:Property ; rdfs:label "Profile picture" ; rdfs:range file:File .
ui:AttachmentsShape a sh:PropertyShape ; sh:path ui:inp-attachment ; sh:maxCount 3 ; sh:node ui:Attachable ;
    sh:message "At most three files." , "Не більше трьох файлів."@uk , "Höchstens drei Dateien."@de , "ثلاثة ملفات على الأكثر."@ar .
ui:Attachable a sh:NodeShape ;
    sh:property [ sh:path file:mediaType ; sh:pattern "^(image/|application/pdf$)" ;
                  sh:message "Only images and PDFs." , "Лише зображення та PDF."@uk , "Nur Bilder und PDFs."@de , "الصور وملفات PDF فقط."@ar ] ,
                [ sh:path file:size ; sh:maxInclusive 2000000 ;
                  sh:message "At most 2 MB per file." , "Не більше 2 МБ на файл."@uk , "Höchstens 2 MB pro Datei."@de , "2 ميغابايت على الأكثر لكل ملف."@ar ] .
ui:PictureShape a sh:PropertyShape ; sh:path ui:inp-picture ; sh:maxCount 1 ;
    sh:message "One picture." , "Одне зображення."@uk , "Ein Bild."@de , "صورة واحدة."@ar ;
    sh:node [ a sh:NodeShape ; sh:property [ sh:path file:mediaType ; sh:in ( "image/png" "image/jpeg" ) ;
              sh:message "A PNG or JPEG picture." , "Зображення PNG або JPEG."@uk , "Ein PNG- oder JPEG-Bild."@de , "صورة PNG أو JPEG."@ar ] ] .

ui:inp-files-attach a c:FileDrop ; c:controls ui:inputsDemo ; c:property ui:inp-attachment ;
    val:validates ui:AttachmentsShape ; file:accept "image/*,application/pdf" ; file:handler "demo" ;
    c:label "Attachments" , "Вкладення"@uk , "Anhänge"@de , "المرفقات"@ar ;
    c:help "Images or PDFs, up to 2 MB each; at most three." , "Зображення або PDF, до 2 МБ кожен; не більше трьох."@uk ,
           "Bilder oder PDFs, bis 2 MB je Datei; höchstens drei."@de , "صور أو ملفات PDF، حتى 2 ميغابايت لكل منها؛ ثلاثة على الأكثر."@ar .
ui:inp-files-picture a c:FileDrop ; c:controls ui:inputsDemo ; c:property ui:inp-picture ; c:icon "◐" ;
    val:validates ui:PictureShape ;
    c:label "Profile picture" , "Фото профілю"@uk , "Profilbild"@de , "صورة الملف الشخصي"@ar ;
    c:help "One PNG or JPEG, kept in this page." , "Один PNG або JPEG, залишається на цій сторінці."@uk ,
           "Ein PNG oder JPEG, bleibt auf dieser Seite."@de , "ملف PNG أو JPEG واحد، يبقى في هذه الصفحة."@ar .
ui:inp-files-off a c:FileDrop ; c:controls ui:inputsDemo ; c:property ui:inp-attachment ; c:disabled true ;
    c:label "Attachments (locked)" , "Вкладення (заблоковано)"@uk , "Anhänge (gesperrt)"@de , "المرفقات (مقفلة)"@ar .
ui:inp-files-col a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:inp-files-attach ui:inp-files-picture ui:inp-files-off ) .
ui:inp-files a c:Flippable ; c:front ui:inp-files-spec .
ui:inp-files-spec a c:Specimen ; c:demonstrates c:FileDrop , c:FileItem ; c:label "File drop" ;
    c:help "A c:FileDrop picks or takes dropped files into a property (c:controls, c:property); its zone is a button, so a click, Enter or Space opens the system picker. What it accepts is the SHACL shape it validates: each file must conform to its sh:node shape (here a media type sh:pattern and a sh:maxInclusive file:size), and its sh:maxCount says how many - with sh:maxCount 1 the picker takes one. Files dragged over the page show each zone's reception, accepted or refused with the shape's message; a refused file is listed with the reason. A file is a node with its name, media type and size, never its contents: the files effect keeps those, and uploads each accepted file at once when the drop says where (file:uploadTo, or a handler: file:handler), with a progress bar and a button that cancels it. Here uploads go to a stand-in server that fails the first try of every third file, so you can try again." ;
    c:children ( ui:inp-files-col ) .

# --- Code editor: Turtle and SPARQL ----------------------------------------------------------------

ui:inp-editor a c:Flippable ; c:front ui:inp-editor-spec .
ui:inp-editor-spec a c:Specimen ; c:demonstrates c:CodeEditor , c:QueryEditor ; c:label "Code editor" ;
    c:help "The text is graph state (c:value; c:original until it is edited), highlighted by its language (c:language: sparql, turtle) under a transparent text area, with line numbers. Typing suggests the prefixes and terms the graph knows and the language's own words (c:CodeWord): Up and Down move, Tab or Enter accepts, Escape closes. The second is a c:QueryEditor, the same editor in SPARQL (the workbench's): it also suggests SPARQL's own words (c:SparqlWord) and the query's variables after ? or $." ;
    c:children ( ui:inp-editor-turtle ui:inp-editor-sparql ) .
ui:inp-editor-turtle a c:CodeEditor ; c:language "turtle" ; c:label "shapes.ttl" ; c:original '''@prefix ex: <https://example.org/people#> .

# Try typing sh: or c:La - the suggestions come from the graph.
ex:PersonShape a sh:NodeShape ; sh:targetClass ex:Person ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ; sh:datatype xsd:string ] .''' .
ui:inp-editor-sparql a c:QueryEditor ; c:label "groups.rq" ; c:original """# Each component group and how many classes it holds. Try typing ?gr or COU.
SELECT ?group (COUNT(?class) AS ?classes)
WHERE { ?class sem:group ?group }
GROUP BY ?group""" .
