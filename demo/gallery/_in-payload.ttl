@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix ui: <https://semblance.dev/demo#> .
@prefix net: <https://semblance.dev/ns/network#> .
@prefix http: <http://www.w3.org/2011/http#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .

# Inspection gallery: payloads. A message body as a JSON tree, as hex, and in a viewer that
# switches between text, hex and JSON - one over a fixed sample, one following a choice.

ui:in-payload a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:in-json ui:in-hex ui:in-body ) .

# --- JsonTree ------------------------------------------------------------------------------------

ui:in-json-order a c:JsonTree ; c:label "order" ; c:expandDepth 2 ; c:value """{
  "id": "ord_1042",
  "status": "paid",
  "total": 129.5,
  "gift": false,
  "coupon": null,
  "customer": { "name": "Ada Lovelace", "email": "ada@example.org", "tags": ["vip", "beta"] },
  "items": [
    { "sku": "LAMP-01", "qty": 2, "price": 39.75 },
    { "sku": "DESK-07", "qty": 1, "price": 50 }
  ]
}""" .
ui:in-json a c:Flippable ; c:front ui:in-json-spec .
ui:in-json-spec a c:Specimen ; c:label "JSON tree" ;
    c:help "A JSON payload as a tree: keys in source order, containers with their sizes, values colored by type. Which containers are open is graph state on the tree (JSON Pointers in c:expandedPath and c:collapsedPath, over c:expandDepth); only open containers' members are minted. Arrow keys move through it; Right opens, Left closes." ;
    c:children ( ui:in-json-order ) .

# --- HexView -------------------------------------------------------------------------------------

ui:in-hex-greeting a c:HexView ; c:limit 64 ;
    c:value "Hello, Semblance — ünïcödé ✓\nGET /api/orders?limit=20 HTTP/1.1\r\nAccept: application/json\r\n" .
ui:in-hex a c:Flippable ; c:front ui:in-hex-spec .
ui:in-hex-spec a c:Specimen ; c:label "Hex view" ;
    c:help "The UTF-8 bytes of a payload, sixteen to a row: offset, hex and printable ASCII. Multi-byte characters take several bytes; c:limit bounds what is shown." ;
    c:children ( ui:in-hex-greeting ) .

# --- BodyViewer ----------------------------------------------------------------------------------
# Samples are plain data: a body and its media type. The second viewer follows a choice
# (c:bindFrom / c:bindProperty), as an inspector's follows the selected entry.

ui:payloadBody a owl:DatatypeProperty ; rdfs:label "body"@en .
ui:payloadType a owl:DatatypeProperty ; rdfs:label "media type"@en .
ui:PayloadSample a owl:Class .
ui:sample-order a ui:PayloadSample ; rdfs:label "Order (JSON)"@en ; sem:order 1 ;
    ui:payloadType "application/json" ;
    ui:payloadBody """{"id":"ord_1042","status":"paid","items":[{"sku":"LAMP-01","qty":2},{"sku":"DESK-07","qty":1}]}""" .
ui:sample-log a ui:PayloadSample ; rdfs:label "Log (text)"@en ; sem:order 2 ;
    ui:payloadType "text/plain" ;
    ui:payloadBody """12:00:01 INFO  server listening on :8080
12:00:04 WARN  slow query (412 ms): SELECT * FROM orders
12:00:09 INFO  GET /api/orders 200 18ms""" .
ui:sample-csv a ui:PayloadSample ; rdfs:label "Export (CSV)"@en ; sem:order 3 ;
    ui:payloadType "text/csv" ;
    ui:payloadBody """sku,qty,price
LAMP-01,2,39.75
DESK-07,1,50.00""" .
ui:pickedSample a owl:ObjectProperty ; rdfs:label "Sample"@en ; rdfs:range ui:PayloadSample .
ui:in-body-pick ui:pickedSample ui:sample-log .

ui:in-body-fixed a c:BodyViewer ; c:of ui:sample-order ; c:payloadProperty ui:payloadBody ; c:typeProperty ui:payloadType .
ui:in-body-picker a c:Segmented ; c:controls ui:in-body-pick ; c:property ui:pickedSample .
ui:in-body-bound a c:BodyViewer ; c:bindFrom ui:in-body-pick ; c:bindProperty ui:pickedSample ;
    c:payloadProperty ui:payloadBody ; c:typeProperty ui:payloadType ; c:emptyText "Pick a sample." .
ui:in-body a c:Flippable ; c:front ui:in-body-spec .
ui:in-body-spec a c:Specimen ; c:label "Body viewer" ;
    c:help "One payload as text, hex or a JSON tree; the representation is graph state on the viewer (c:representation), and JSON is offered only for a payload that looks like JSON. The header shows the media type and the size in bytes. The second viewer follows a choice (c:bindFrom / c:bindProperty), as an inspector's follows the selected entry." ;
    c:children ( ui:in-body-fixed ui:in-body-picker ui:in-body-bound ) .
