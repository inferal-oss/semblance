@prefix sem: <https://semblance.dev/ns/core#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix fs: <https://semblance.dev/ns/fullscreen#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix rnd: <https://semblance.dev/ns/rendered#> .
@prefix ui: <https://semblance.dev/demo#> .

# Gallery page: Windows.
#
# The demo windows live on the shell's desktop (outside every page), closed until a
# button c:opens them, so they survive navigation and their content is not evaluated
# while closed. The desktop also hosts the taskbar: it lists every open frame, on every
# page, and hides itself while there is none. It is draggable and dockable like a frame: its
# grip moves it (or the arrow keys, focused), and thrown at an edge it docks there; where it
# is, is remembered for the tab like the tools window.

ui:gallery-windows a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-windows-intro ui:gallery-windows-lede ui:wn-windows ui:wn-grid ui:wn-state ui:wn-dock ui:wn-stack ui:wn-taskbar ui:wn-palette ui:wn-fullscreen ) .
ui:gallery-windows-intro a c:Heading ; c:label "Windows" .
ui:gallery-windows-lede a c:Text ;
    c:label "A window is not one behaviour but several. Each capability is a mixin class with its own reactions (c:Draggable, c:Resizable, c:Raisable, c:Minimizable, c:Maximizable, c:Dockable); c:Window has them all, c:Palette only some, and a frame's title bar shows the controls of the capabilities its instance has. Window state is two hookable axes, so the theme styles each value once and any control that sets a property can drive it." .

ui:desktop c:hosts ui:win-checklist , ui:win-log , ui:win-activity , ui:win-display , ui:taskbar .
ui:desktop c:tileLayout c:DesktopFloatingLayout .
ui:taskbar a c:Taskbar , c:Draggable , c:Dockable ; c:of ui:desktop .
# Where the frames are and whether they overlap, as the Query tool's samples show (rnd:Overlap).
ui:win-checklist rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:win-log rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:win-activity rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:win-display rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:taskbar rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:rememberTaskbar a per:Policy ; per:scope per:Session ;
    rdfs:label "Where the taskbar is" , "Де панель вікон"@uk , "Wo die Fensterleiste ist"@de , "مكان شريط النوافذ"@ar ;
    per:subject ui:taskbar ; per:properties ( c:x c:y c:attachedTo ) .

# --- the demo frames --------------------------------------------------------------------------------

ui:win-checklist a c:Window ; c:title "Checklist" ; c:open false ;
    c:x 140 ; c:y 140 ; c:width 380 ; c:height 330 ;
    c:windowState c:Normal ; c:attachedTo c:NoEdge ;
    c:body ui:win-checklist-body .
ui:win-checklist-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:win-check-drag ui:win-check-resize ui:win-check-min ui:win-check-max ui:win-check-dock ui:win-check-raise ) .
ui:win-check-drag a c:Checkbox ; c:label "Drag me by my title bar" ; c:checked false .
ui:win-check-resize a c:Checkbox ; c:label "Resize me from the bottom corner" ; c:checked false .
ui:win-check-min a c:Checkbox ; c:label "Minimize me (–), then find me in the taskbar" ; c:checked false .
ui:win-check-max a c:Checkbox ; c:label "Maximize me (□), then restore me (❐)" ; c:checked false .
ui:win-check-dock a c:Checkbox ; c:label "Drop me at an edge of the screen to dock me" ; c:checked false .
ui:win-check-raise a c:Checkbox ; c:label "Open another window, then click me to bring me back to the front" ; c:checked false .

ui:win-log a c:Window ; c:title "Change log" ; c:open false ;
    c:x 560 ; c:y 110 ; c:width 440 ; c:height 460 ;
    c:body ui:win-log-members .
ui:win-log-members a c:StreamMembers ; c:of beh:ChangeLog ; c:limit 6 ;
    c:emptyText "Every move, resize, minimize and raise is an event in the change log, with the size of the change it caused." .

ui:win-activity a c:Window ; c:title "Activity" ; c:open false ;
    c:x 220 ; c:y 200 ; c:width 460 ; c:height 420 ;
    c:body ui:win-activity-stats .
ui:win-activity-stats a c:StreamStats ; c:label "What you did" ; c:of beh:ChangeLog .

# A palette has no minimize or maximize (c:Palette is not c:Minimizable); this one also
# opts into c:Resizable, so it has a grip.
ui:win-display a c:Palette , c:Resizable ; c:title "Display" ; c:open false ;
    c:x 760 ; c:y 160 ; c:width 260 ;
    c:body ui:win-display-body .
ui:win-display-body a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:win-display-theme ui:win-display-contrast ) .
ui:win-display-theme a c:ThemeSwitcher ; c:controls ui:app ; c:property sty:colorScheme .
ui:win-display-contrast a c:Segmented ; c:controls ui:shell ; c:property sty:contrast .

# --- specimens -----------------------------------------------------------------------------------------

ui:wn-open-checklist a c:Button ; c:label "Checklist" ; c:icon "☑" ; sty:tone sty:Accent ; sty:emphasis sty:Solid ; c:opens ui:win-checklist .
ui:wn-open-log a c:Button ; c:label "Change log" ; c:icon "≡" ; sty:emphasis sty:Outline ; c:opens ui:win-log .
ui:wn-open-activity a c:Button ; c:label "Activity" ; c:icon "▤" ; sty:emphasis sty:Outline ; c:opens ui:win-activity .
ui:wn-windows a c:Flippable ; c:front ui:wn-windows-spec .
ui:wn-windows-spec a c:Specimen ; c:demonstrates c:Window ; c:label "Window" ;
    c:help "Three windows on the desktop, closed until a button c:opens them (c:Window is a c:Overlay: c:open, c:opens, c:closes). Opening one also restores it if it was minimized and brings it to the front. The title bar shows minimize, maximize and close because a c:Window is c:Minimizable and c:Maximizable; a window detached from a tab adds a control that returns it there." ;
    c:children ( ui:wn-open-checklist ui:wn-open-log ui:wn-open-activity ) .

ui:wn-grid-control a c:Segmented ; c:label "Desktop layout" ; c:controls ui:desktop ; c:property c:tileLayout .
# Keep only a small layout control above the tiled frames. Raising the whole specimen
# above the desktop would cover the windows that it demonstrates.
ui:desktop c:hosts ui:wn-layout-switch .
ui:wn-layout-switch a c:Switch ; c:controls ui:desktop ; c:property c:tileLayout ;
    c:cases ( ui:wn-layout-grid-case ) .
ui:wn-layout-grid-case c:when c:DesktopGridLayout ; c:content ui:wn-layout-toolbar .
ui:GridLayoutToolbar a owl:Class ; rdfs:subClassOf c:Toolbar ; sem:slug "ex-grid-layout-toolbar" .
ui:wn-layout-toolbar a ui:GridLayoutToolbar ;
    c:label "Desktop layout", "Розкладка стільниці"@uk, "Desktop-Anordnung"@de, "تخطيط سطح المكتب"@ar ;
    c:children ( ui:wn-layout-floating-control ) .
ui:wn-layout-floating-control a c:Segmented ;
    c:label "Desktop layout", "Розкладка стільниці"@uk, "Desktop-Anordnung"@de, "تخطيط سطح المكتب"@ar ;
    c:controls ui:desktop ; c:property c:tileLayout .
[] a sty:StyleRule ; sty:appliesTo ui:GridLayoutToolbar ;
    sty:declares [ sty:property "position" ; sty:raw "fixed" ] ,
                 [ sty:property "inset-block-end" ; sty:raw "40px" ] ,
                 [ sty:property "inset-inline-end" ; sty:raw "24px" ] ,
                 [ sty:property "max-inline-size" ; sty:raw "calc(100vw - 48px)" ] ,
                 [ sty:property "z-index" ; sty:raw "55" ] .
ui:wn-grid-controls a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:wn-open-all-grid ui:wn-open-checklist-grid ui:wn-open-log-grid ui:wn-open-activity-grid ui:wn-grid-control ) .
ui:wn-open-all-grid a c:Button ; c:label "Open all windows" ; c:opens ui:win-checklist , ui:win-log , ui:win-activity .
ui:wn-open-checklist-grid a c:Button ; c:label "Open checklist" ; c:opens ui:win-checklist .
ui:wn-open-log-grid a c:Button ; c:label "Open change log" ; c:opens ui:win-log .
ui:wn-open-activity-grid a c:Button ; c:label "Open activity" ; c:opens ui:win-activity .
ui:wn-grid a c:Flippable ; c:front ui:wn-grid-spec .
ui:wn-grid-spec a c:Specimen ; c:demonstrates c:Desktop , c:DesktopLayout ; c:label "Tile desktop windows" ;
    c:help "Open windows, then set the desktop to Grid. Normal floating windows fill a responsive grid; their saved positions and sizes remain in the graph. Set Floating to return them to the same geometry. The grid takes c:Grid's parameters: as many columns as fit at c:minWidth, at most c:columns." ;
    c:children ( ui:wn-grid-controls ) .

ui:wn-state-control a c:Segmented ; c:label "Checklist" ; c:controls ui:win-checklist ; c:property c:windowState .
ui:wn-state a c:Flippable ; c:front ui:wn-state-spec .
ui:wn-state-spec a c:Specimen ; c:demonstrates c:Window , c:WindowState ; c:label "Window state" ;
    c:help "c:windowState is one fact on the window: c:Normal, c:Minimized or c:Maximized. The title bar's controls set it (c:minimizes, c:maximizes, c:restores), and so does this segmented control, whose options are the individuals of the property's range. It is hooked (data-sem-window-state), so the theme styles each state once for every frame. A minimized window keeps its parts under a hidden root: its content is parked, not dropped, and the taskbar brings it back." ;
    c:children ( ui:wn-open-checklist-2 ui:wn-state-control ) .
ui:wn-open-checklist-2 a c:Button ; c:label "Open the checklist" ; sty:emphasis sty:Soft ; sty:tone sty:Accent ; c:opens ui:win-checklist .

ui:wn-dock-control a c:Segmented ; c:label "Checklist" ; c:controls ui:win-checklist ; c:property c:attachedTo .
ui:wn-dock a c:Flippable ; c:front ui:wn-dock-spec .
ui:wn-dock-spec a c:Specimen ; c:demonstrates c:Dockable , c:Edge ; c:label "Attached to an edge" ;
    c:help "A c:Dockable frame c:attachedTo an edge fills it: a side panel at the start or end, a bar at the top or bottom. Drag a window and release the pointer within 24px of an edge (c:Dockable c:snapDistance 24) to snap it there; drag it away, or press ◳, to float it again where it was. Edges are logical, so start and end follow the writing direction. The axis is orthogonal to the window state: maximize a docked window and restore it, and it is docked again." ;
    c:children ( ui:wn-open-checklist-3 ui:wn-dock-control ) .
ui:wn-open-checklist-3 a c:Button ; c:label "Open the checklist" ; sty:emphasis sty:Soft ; sty:tone sty:Accent ; c:opens ui:win-checklist .

ui:wn-stack a c:Flippable ; c:front ui:wn-stack-spec .
ui:wn-stack-spec a c:Specimen ; c:demonstrates c:Raisable , c:PointerDown ; c:label "Stacking" ;
    c:help "Which window is in front is graph state too. Pressing anywhere in a c:Raisable frame (a c:PointerDown event) makes it its desktop's c:topmost and gives it a c:z one higher than any other there; the desktop puts its frames in one stacking layer ordered by c:z, below its dialogs and toasts. Open two windows and click the one behind." ;
    c:children ( ui:wn-open-log-2 ui:wn-open-activity-2 ) .
ui:wn-open-log-2 a c:Button ; c:label "Change log" ; c:icon "≡" ; sty:emphasis sty:Outline ; c:opens ui:win-log .
ui:wn-open-activity-2 a c:Button ; c:label "Activity" ; c:icon "▤" ; sty:emphasis sty:Outline ; c:opens ui:win-activity .

ui:wn-taskbar-inline a c:Taskbar ; c:of ui:desktop ; c:label "Windows on the desktop" .
ui:wn-taskbar a c:Flippable ; c:front ui:wn-taskbar-spec .
ui:wn-taskbar-spec a c:Specimen ; c:demonstrates c:Taskbar ; c:label "Taskbar" ;
    c:help "A c:Taskbar lists the open frames of a desktop (c:of), each with its state's symbol. Activating an entry restores a minimized frame, brings another to the front, or minimizes the one already in front: three reactions that all see the state before the click. The desktop hosts one, so minimized windows (including those detached from the Playground's tabs) can always be found; that one is also c:Draggable and c:Dockable, so its grip (or the arrow keys) moves it, and thrown at an edge it docks there and the page keeps that edge clear. This is a second instance of the same component, neither, so it stays in the page." ;
    c:children ( ui:wn-taskbar-inline ) .

ui:wn-open-display a c:Button ; c:label "Display palette" ; c:icon "◐" ; sty:emphasis sty:Outline ; c:opens ui:win-display .
ui:wn-palette a c:Flippable ; c:front ui:wn-palette-spec .
ui:wn-palette-spec a c:Specimen ; c:demonstrates c:Palette , c:Resizable ; c:label "Palette" ;
    c:help "A c:Palette is a c:Frame that is c:Dockable but not c:Minimizable or c:Maximizable: a slim strip with only a close control. This one is also c:Resizable (`a c:Palette, c:Resizable`), so it has a grip. The same rendering serves both frames; capabilities are classes, so an instance adds one by saying so." ;
    c:children ( ui:wn-open-display ) .

# --- full screen: a fact on any component ---------------------------------------------------------------
# Beside maximizing a frame: fs:fullscreen shows any component full screen (the fullscreen layer).

ui:wn-fullscreen a c:Flippable ; c:front ui:wn-fullscreen-spec .
ui:wn-fullscreen-spec a c:Specimen ; c:demonstrates fs:Fullscreenable ;
    c:label "Full screen" , "Повний екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar ;
    c:help "Two facts on any component: fs:fullViewport true fills the browser window with it, fs:fullscreen true shows it on the whole screen; retracting them puts it back. Here two c:Toggles, in the card's own header (so they are still there), assert them - press them, or ⇧W and ⇧F. Full screen is the browser's, so it needs the person's click or key; where the browser will not, the window is filled instead. Esc leaves either, and the facts go with it. Source views, walkthrough diagrams and live examples draw both toggles of their own (fs:Fullscreenable)." ,
        "Два факти на будь-якому компоненті: fs:fullViewport true розгортає його на все вікно браузера, fs:fullscreen true — на весь екран; відкликані факти повертають його на місце. Тут два c:Toggle у заголовку картки (тож вони лишаються на місці) стверджують їх — натисніть їх або ⇧W і ⇧F. Повний екран — браузерний, тож потребує вашого клацання чи клавіші; де браузер не дозволяє, натомість заповнюється вікно. Esc виходить з обох, і факти зникають разом із ним. Перегляди коду, діаграми покрокових пояснень і живі приклади мають обидва власні перемикачі (fs:Fullscreenable)."@uk ,
        "Zwei Aussagen an einer beliebigen Komponente: fs:fullViewport true füllt das Browserfenster mit ihr, fs:fullscreen true zeigt sie auf dem ganzen Bildschirm; sie zurückzunehmen, bringt sie zurück. Hier setzen zwei c:Toggle im Kopf der Karte (so sind sie auch dann da) sie - drücken Sie sie oder ⇧W und ⇧F. Das Vollbild ist das des Browsers und braucht Ihren Klick oder Ihre Taste; wo der Browser es nicht erlaubt, wird stattdessen das Fenster gefüllt. Esc beendet beides, und die Aussagen gehen mit. Quellansichten, Diagramme von Rundgängen und Live-Beispiele haben beide Schalter selbst (fs:Fullscreenable)."@de ,
        "حقيقتان على أي مكوّن: fs:fullViewport true يملأ نافذة المتصفح به، وfs:fullscreen true يعرضه على الشاشة كلها؛ وسحبهما يعيده إلى مكانه. هنا يثبتهما زرّا c:Toggle في رأس البطاقة (فيبقيان ظاهرين) - اضغطهما أو ⇧W و⇧F. ملء الشاشة من المتصفح، فيحتاج نقرتك أو مفتاحك؛ وحيث لا يسمح المتصفح تُملأ النافذة بدلًا منه. Esc يخرج من كليهما، وتذهب الحقيقتان معه. لعروض المصدر ومخططات الشروح والأمثلة الحية الزرّان كلاهما (fs:Fullscreenable)."@ar ;
    c:children ( ui:wn-fullscreen-card ui:wn-fullscreen-source ) .
ui:wn-fullscreen-card a c:Card ; c:label "This quarter" , "Цей квартал"@uk , "Dieses Quartal"@de , "هذا الربع"@ar ;
    c:actions ( ui:wn-fullscreen-window ui:wn-fullscreen-toggle ) ; c:content ui:wn-fullscreen-figures .
ui:wn-fullscreen-window a c:Toggle ; c:controls ui:wn-fullscreen-card ; c:property fs:fullViewport ; key:shortcut "shift+w" ;
    c:label "Fill the window" , "На все вікно"@uk , "Fensterfüllend"@de , "ملء النافذة"@ar .
ui:wn-fullscreen-toggle a c:Toggle ; c:controls ui:wn-fullscreen-card ; c:property fs:fullscreen ; key:shortcut "shift+f" ;
    c:label "Full screen" , "На весь екран"@uk , "Vollbild"@de , "ملء الشاشة"@ar .
ui:wn-fullscreen-figures a c:Grid ; c:minWidth "150px" ; pos:gap tok:space-4 ;
    c:children ( ui:wn-fullscreen-orders ui:wn-fullscreen-revenue ui:wn-fullscreen-returns ) .
ui:wn-fullscreen-orders a c:Stat ; c:label "Orders" , "Замовлення"@uk , "Bestellungen"@de , "الطلبات"@ar ; c:value "1 284" ; c:delta 8.1 ; c:deltaUnit "%" .
ui:wn-fullscreen-revenue a c:Stat ; c:label "Revenue" , "Дохід"@uk , "Umsatz"@de , "الإيرادات"@ar ; c:value "38 950" ; c:unit "€" ; c:delta 5.4 ; c:deltaUnit "%" .
ui:wn-fullscreen-returns a c:Stat ; c:label "Returns" , "Повернення"@uk , "Rücksendungen"@de , "المرتجعات"@ar ; c:value "41" ; c:delta -2.0 ; c:deltaUnit "%" .
ui:wn-fullscreen-source a c:SourceView ; c:label "Source" , "Джерело"@uk , "Quelle"@de , "المصدر"@ar ;
    c:of <urn:semblance:source:demo/gallery/_ex-todo.ttl> .
