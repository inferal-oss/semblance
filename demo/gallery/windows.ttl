# Gallery page: Windows.

ui:gallery-windows a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:gallery-windows-intro ) .
ui:gallery-windows-intro a c:Heading ; c:label "Windows" .
