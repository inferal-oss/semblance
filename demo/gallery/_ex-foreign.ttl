ui:ex-foreign-m-top a c:Mention ; c:label "\"Top marks\"" ; c:mentions ui:ex-foreign-top .
ui:ex-foreign-m-average a c:Mention ; c:label "The average" ; c:mentions ui:ex-foreign-average .
