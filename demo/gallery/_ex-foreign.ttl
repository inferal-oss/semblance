ui:ex-foreign-m-TriplesView a c:Mention ; c:label "c:TriplesView" ; c:mentions c:TriplesView ; c:to c:TriplesView .
ui:ex-foreign-m-new a c:Mention ; c:label "the field" ; c:mentions ui:ex-foreign-new .
