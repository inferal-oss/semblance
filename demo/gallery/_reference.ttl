@prefix c: <https://semblance.dev/ns/component#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix ui: <https://semblance.dev/demo#> .

# The Reference: every component class and layer, from the ontology itself. (Being built.)
ui:reference a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; pos:inset tok:space-5 ;
    c:children ( ui:referenceTitle ) .
ui:referenceTitle a c:Heading ; c:level 1 ; c:label "Reference" .
