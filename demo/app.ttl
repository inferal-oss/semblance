@prefix ui: <https://semblance.dev/demo#> .
@prefix ex: <https://example.org/todo#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix a11y: <https://semblance.dev/ns/a11y#> .
@prefix perf: <https://semblance.dev/ns/perf#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mot: <https://semblance.dev/ns/motion#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix st: <https://semblance.dev/ns/status#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix tree: <https://w3id.org/tree#> .

# =================================================================================================
# The demo's entire interface as a component graph. The host page is a mount
# point; everything visible below is a Semblance component (or a slot where
# another projection is mounted), and every setting is graph state.
# =================================================================================================

# --- application state ---------------------------------------------------------------------------

ui:app sty:colorScheme sty:System ;
    sem:enables a11y:Layer, sty:Layer, sem:SourceLayer, sem:TooltipLayer, val:Layer, val:ShapesLayer, key:Layer, st:Layer, ann:Layer, sem:DocsLayer ;
    l10n:language l10n:English ;
    ui:store ui:Hybrid ;
    ui:rules ui:PreferSparql ;
    ui:page ui:Playground ;
    ui:inspectorMode ui:Live ;
    ui:galleryGroup ui:GroupFoundations .

ui:store rdfs:label "Store" ; rdfs:range ui:StoreKind .
ui:Hybrid a ui:StoreKind ; rdfs:label "Hybrid · Oxigraph + N3 mirror" ; sem:order 1 ; ui:key "hybrid" .
ui:Oxigraph a ui:StoreKind ; rdfs:label "Oxigraph" ; sem:order 2 ; ui:key "oxigraph" .
ui:N3 a ui:StoreKind ; rdfs:label "N3.js · functions only" ; sem:order 3 ; ui:key "n3" .
ui:rules rdfs:label "Rules" ; rdfs:range ui:RuleKind .
ui:PreferSparql a ui:RuleKind ; rdfs:label "Prefer SPARQL" ; sem:order 1 ; ui:key "sparql" .
ui:PreferFunction a ui:RuleKind ; rdfs:label "Prefer functions" ; sem:order 2 ; ui:key "function" .
ui:page rdfs:label "Page" ; rdfs:range ui:Page .
ui:Playground a ui:Page ; rdfs:label "Playground" ; sem:order 1 ; ui:key "playground" .
ui:Performance a ui:Page ; rdfs:label "Performance" ; sem:order 2 ; ui:key "performance" .
ui:Components a ui:Page ; rdfs:label "Components" ; sem:order 3 ; ui:key "components" .
ui:inspectorMode rdfs:label "Inspector" ; rdfs:range ui:InspectorMode .
ui:Live a ui:InspectorMode ; rdfs:label "Live" ; sem:symbol "●" ; sem:order 1 .
ui:Paused a ui:InspectorMode ; rdfs:label "Paused" ; sem:symbol "❙❙" ; sem:order 2 .
ui:Off a ui:InspectorMode ; rdfs:label "Off" ; sem:symbol "○" ; sem:order 3 .
ui:inspecting rdfs:label "inspecting" .

# Prefixes for showing IRIs compactly (sh:declare style).
ui:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/todo#"^^xsd:anyURI ] ,
                       [ sh:prefix "ui" ; sh:namespace "https://semblance.dev/demo#"^^xsd:anyURI ] ,
                       [ sh:prefix "perf" ; sh:namespace "https://semblance.dev/ns/perf#"^^xsd:anyURI ] ,
                       [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^xsd:anyURI ] .

# What the last interaction cost, written by the host after each one.
ui:action rdfs:label "action" ; c:emphasis true ; c:hideLabel true .
ui:ms rdfs:label "update + DOM" ; c:unit "ms" .
ui:ruleRuns rdfs:label "rule runs" .
ui:domOps rdfs:label "DOM operations" .
ui:heap rdfs:label "JS heap" .
ui:storage rdfs:label "storage (incl. session)" ; c:unit "KB" .
ui:triples rdfs:label "triples" .
ui:domNodes rdfs:label "DOM nodes" .

# --- the shell ----------------------------------------------------------------------------------

ui:shell a c:Stack ; c:children ( ui:appBar ui:pages ui:perfPanel ui:desktop ) ;
    # Display settings of the whole interface: hooked axes whose values re-value tokens.
    mot:preference mot:Full ; sty:contrast sty:StandardContrast ; sty:density sty:Comfortable ; sty:theme sty:Semblance .

# Detached views live here, outside the pages, so they survive page changes.
ui:desktop a c:Desktop ; c:hosts ui:announcements .

# What the last interaction cost and what memory holds, on every page: a bar
# docked to the bottom of the shell. The host writes ui:stats; c:Metrics shows it.
ui:perfPanel a c:StatusBar ; c:label "Performance" , "Продуктивність"@uk , "Leistung"@de , "الأداء"@ar ;
    c:children ( ui:lastUpdate ui:memory ) .
ui:memory a c:Metrics ; c:of ui:stats ; c:fields ( ui:heap ui:storage ui:triples ui:domNodes ) .

# Announcing reactions (ann:announces) show up here as toasts, from the change log.
ui:announcements a c:ToastRegion ; ann:from beh:ChangeLog ; c:limit 3 .
ex:AddTodo ann:announces "Todo added" , "Завдання додано"@uk , "Aufgabe hinzugefügt"@de , "تمت إضافة المهمة"@ar ; ann:tone sty:Success .
ui:RunMatrix ann:announces "Benchmark started" , "Бенчмарк запущено"@uk , "Benchmark gestartet"@de , "بدأ القياس"@ar ; ann:tone sty:Info .
ui:ClearMatrix ann:announces "Results cleared" , "Результати очищено"@uk , "Ergebnisse gelöscht"@de , "تم مسح النتائج"@ar .

ui:appBar a c:AppBar ;
    c:label "Semblance" ;
    c:subtitle "one component graph · many projections" ;
    c:logo ui:logo ;
    c:actions ( ui:theme ui:nav ) .
ui:logo a c:GraphMark ; c:nodes 3 ; rdfs:label "Semblance" .
ui:theme a c:ThemeSwitcher ; c:controls ui:app ; c:property sty:colorScheme .
ui:nav a c:Segmented ; c:controls ui:app ; c:property ui:page .

ui:pages a c:Switch ; c:controls ui:app ; c:property ui:page ;
    c:cases ( ui:playgroundCase ui:performanceCase ui:componentsCase ) .
ui:playgroundCase c:when ui:Playground ; c:content ui:playground .
# The two working pages are warmed in idle time, so switching between them is
# instant; the gallery renders a group only when it is selected (lazy, the default).
ui:playground sem:warm sem:Eager .
ui:performance sem:warm sem:Eager .
ui:componentsCase c:when ui:Components ; c:content ui:gallery .
ui:performanceCase c:when ui:Performance ; c:content ui:performance .

# --- playground ---------------------------------------------------------------------------------

ui:playground a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ; pos:inset tok:space-5 ;
    c:children ( ui:toolbar ui:workspace ) .

ui:toolbar a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ;
    c:children ( ui:storeChoice ui:rulesChoice ui:layerChips ) .
ui:storeChoice a c:Choice ; c:controls ui:app ; c:property ui:store .
ui:rulesChoice a c:Choice ; c:controls ui:app ; c:property ui:rules .
ui:layerChips a c:Chips ; c:controls ui:app ; c:property sem:enables ;
    c:options ( a11y:Layer sty:Layer sem:DebugLayer sem:SourceLayer sem:TooltipLayer val:Layer val:ShapesLayer key:Layer st:Layer ann:Layer sem:DocsLayer ) .
ui:lastUpdate a c:Metrics ; c:of ui:stats ; c:fields ( ui:action ui:ms ui:ruleRuns ui:domOps ) .

ui:workspace a c:Stack ; pos:layout pos:Columns ; pos:gap tok:space-5 ;
    c:children ( ui:screenCard ui:viewsCard ) .

ui:screenCard a c:Card ;
    c:label "Screen" ; c:badge "mod:Screen" ;
    c:note "The todo app: a component graph projected to RDF/HTML and patched into the DOM. Hover anything to inspect it." ;
    c:content ui:screenStage .
ui:screenStage a c:Stack ; sty:backdrop sty:Dots ; c:children ( ui:todoCard ) .
ui:todoCard a c:Flippable ; c:front ex:page .

ui:viewsCard a c:Card ;
    c:label "Views" ; c:badge "c:Tabs" ;
    c:note "Every view is a projection of the same graph. ↗ opens one in a window; tab and window state are graph state." ;
    c:content ui:views .
ui:views a c:Tabs ; c:detachable true ; c:windowsOn ui:desktop ;
    c:tabs ( ui:inspectorTab ui:queryTab ui:textTab ui:activityTab ui:logTab ) ;
    c:selected ui:inspectorTab .

ui:inspectorTab a c:Tab ; c:label "Inspector" ; c:content ui:inspectorCard .
ui:queryTab a c:Tab ; c:label "Query" , "Запит"@uk , "Abfrage"@de , "استعلام"@ar ; c:content ui:workbench .
ui:textTab a c:Tab ; c:label "Text projection" ; c:content ui:textCard .
ui:activityTab a c:Tab ; c:label "Activity" ; c:content ui:activityCard .
ui:logTab a c:Tab ; c:label "Change log" ; c:content ui:logCard .

# Inspector: hovering any component writes ui:inspecting (unrecorded hover events);
# the view is CONSTRUCTs bound to it, and the node is highlighted.
ui:inspectorCard a c:Flippable ; c:front ui:inspectorPanel .
ui:inspectorPanel a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:inspectorBar ui:inspector ui:highlight ) .
ui:inspectorBar a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:inspectorModes ui:pauseHint ui:inspectingChip ) .
ui:pauseHint a c:Text ; c:inline true ; sty:textStyle sty:Caption ;
    c:children ( ui:pauseKey " pauses · " ui:offKey ui:offKeyZ " turns off" ) .
ui:offKey a c:Kbd ; c:label "⇧" .
ui:offKeyZ a c:Kbd ; c:label "Z" .
ui:pauseKey a c:Kbd ; c:label "Z" .

# Z, anywhere: freeze the inspector on what it shows, and Z again to resume. A
# keyboard command (key:Command) whose press is an RDF event; its two reactions
# see the state before the event, so exactly one of them acts.
ui:pauseInspector a key:Command ; key:shortcut "z" ;
    rdfs:label "Pause or resume the inspector" , "Призупинити або відновити інспектор"@uk ,
               "Inspektor anhalten oder fortsetzen"@de , "إيقاف المفتش مؤقتًا أو استئنافه"@ar .
ui:PauseInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:pauseInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Live }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Paused } WHERE { ui:app ui:inspectorMode ui:Live }""" ;
    ann:announces "Inspector paused · Z to resume" , "Інспектор призупинено · Z, щоб продовжити"@uk ,
                  "Inspektor angehalten · Z zum Fortsetzen"@de , "تم إيقاف المفتش مؤقتًا · اضغط Z للاستئناف"@ar ; ann:tone sty:Info .
# Shift+Z: stop collecting altogether (Off), and Shift+Z again to go back to Live.
ui:disableInspector a key:Command ; key:shortcut "shift+z" ;
    rdfs:label "Turn the inspector off or on" , "Вимкнути або ввімкнути інспектор"@uk ,
               "Inspektor aus- oder einschalten"@de , "إيقاف المفتش أو تشغيله"@ar .
ui:DisableInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:disableInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ?m . ui:app ui:inspecting ?node } WHERE { ui:app ui:inspectorMode ?m FILTER(?m != ui:Off) OPTIONAL { ui:app ui:inspecting ?node } }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Off } WHERE { ui:app ui:inspectorMode ?m FILTER(?m != ui:Off) }""" ;
    ann:announces "Inspector off · Shift+Z to turn it on" , "Інспектор вимкнено · Shift+Z, щоб увімкнути"@uk ,
                  "Inspektor aus · Umschalt+Z zum Einschalten"@de , "تم إيقاف المفتش · Shift+Z للتشغيل"@ar .
ui:EnableInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:disableInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Off } WHERE { ui:app ui:inspectorMode ui:Off }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Off }""" ;
    ann:announces "Inspector on" , "Інспектор увімкнено"@uk , "Inspektor an"@de , "تم تشغيل المفتش"@ar .
ui:ResumeInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:pauseInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Paused } WHERE { ui:app ui:inspectorMode ui:Paused }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Paused }""" ;
    ann:announces "Inspector resumed" , "Інспектор відновлено"@uk , "Inspektor fortgesetzt"@de , "تم استئناف المفتش"@ar .
ui:inspectorModes a c:Segmented ; c:controls ui:app ; c:property ui:inspectorMode .

# Turning the inspector off also clears what it showed.
ui:ClearInspection a beh:Reaction ; beh:when beh:Click ; beh:source ui:inspectorModes ;
    beh:deletes """CONSTRUCT { ui:app ui:inspecting ?node }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:selects ui:Off . ui:app ui:inspecting ?node }""" .
ui:inspectingChip a c:Metrics ; c:of ui:app ; c:fields ( ui:inspecting ) .
ui:inspector a c:QueryView ;
    c:queries ( ui:qElement ui:qProvenance ui:qGeneratedBy ui:qInfluencedBy ui:qDerivedFrom ) ;
    c:bindVariable "node" ; c:bindFrom ui:app ; c:bindProperty ui:inspecting ;
    c:baseIri "https://example.org/todo" ;
    c:emptyText "With the inspector Live, hover any element on the page to see its RDF/HTML, the PROV-O activity and rule that generated it, the layers that decorated it, and the input it was derived from." .
ui:highlight a c:Highlight ; c:bindFrom ui:app ; c:bindProperty ui:inspecting .

ui:qElement a sem:Query ; rdfs:label "rendered element (RDF/HTML)" ;
    sem:construct """CONSTRUCT { $node ?p ?o . ?attr ?ap ?ao }
WHERE {
  { $node ?p ?o FILTER(!STRSTARTS(STR(?p), STR(prov:))) }
  UNION
  { $node rdfhtml:attribute ?attr . ?attr ?ap ?ao }
}""" .
ui:qProvenance a sem:Query ; rdfs:label "provenance" ;
    sem:construct """CONSTRUCT { $node ?p ?activity }
WHERE { $node ?p ?activity FILTER(?p IN (prov:wasGeneratedBy, prov:wasInfluencedBy)) }""" .
ui:qGeneratedBy a sem:Query ; rdfs:label "generated by: the activity, its plan, and the rule" ;
    sem:construct """CONSTRUCT { ?activity ?ap ?ao . ?assoc ?sp ?so . ?plan ?pp ?po . ?slot ?lp ?lo }
WHERE {
  $node prov:wasGeneratedBy ?activity .
  ?activity prov:qualifiedAssociation ?assoc .
  ?assoc prov:hadPlan ?plan .
  # LATERAL keeps the branches correlated (uncorrelated UNIONs scan every triple).
  LATERAL {
    { ?activity ?ap ?ao } UNION { ?assoc ?sp ?so } UNION { ?plan ?pp ?po }
    UNION { ?plan sem:implements ?slot . ?slot ?lp ?lo }
  }
}""" .
ui:qInfluencedBy a sem:Query ; rdfs:label "influenced by: layers that decorated it" ;
    sem:construct """CONSTRUCT { ?activity ?ap ?ao . ?assoc ?sp ?so }
WHERE {
  $node prov:wasInfluencedBy ?activity .
  ?activity prov:qualifiedAssociation ?assoc .
  LATERAL { { ?activity ?ap ?ao } UNION { ?assoc ?sp ?so } }
}""" .
ui:qDerivedFrom a sem:Query ; rdfs:label "derived from: the input the activity used" ;
    sem:construct """CONSTRUCT { ?used ?p ?o . ?b ?bp ?bo . ?cell ?cp ?co }
WHERE {
  $node prov:wasGeneratedBy/prov:used ?used .
  LATERAL {
    { ?used ?p ?o FILTER(!STRSTARTS(STR(?p), STR(prov:))) }
    UNION { ?used ?x ?b FILTER(isBlank(?b)) ?b ?bp ?bo }
    UNION { ?used ?y ?list FILTER(isBlank(?list)) ?list rdf:rest* ?cell . ?cell ?cp ?co }
  }
}""" .

# Hovering any component inspects the hit node while the inspector is Live (not over itself).
ui:InspectOnHover a beh:Reaction ;
    beh:when beh:Hover ;
    beh:sourceClass sem:Component ;
    beh:deletes """CONSTRUCT { ui:app ui:inspecting ?old }
WHERE {
  ui:app ui:inspectorMode ui:Live .
  $event beh:node ?hit .
  FILTER NOT EXISTS { ?inside sem:renders ui:inspectorCard ; (rdfhtml:hasChild|^sem:renders)* ?hit }
  ui:app ui:inspecting ?old FILTER(?old != ?hit)
}""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspecting ?hit }
WHERE {
  ui:app ui:inspectorMode ui:Live .
  $event beh:node ?hit .
  FILTER NOT EXISTS { ?inside sem:renders ui:inspectorCard ; (rdfhtml:hasChild|^sem:renders)* ?hit }
}""" .

ui:textCard a c:Flippable ; c:front ui:textProjection .
ui:textProjection a c:ProjectionView ; rdfs:label "Text projection" ;
    c:slot "text" ; c:projectionGraph "urn:semblance:derived:text" .

ui:activityCard a c:Flippable ; c:front ex:activity .

ui:logCard a c:Flippable ; c:front ui:changeLog .
ui:changeLog a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:rememberLogSwitch ui:changeLogHead ui:changeLogMembers ) .
ui:changeLogHead a c:QueryView ; c:queries ( ui:qStream ui:qStreamView ) .
ui:changeLogMembers a c:StreamMembers ; c:of beh:ChangeLog ; c:limit 8 ;
    c:emptyText "Click, type or tick something. Each relevant interaction becomes an immutable member of the beh:ChangeLog LDES, with the size of the change it caused." .
ui:qStream a sem:Query ; rdfs:label "the event stream" ;
    sem:construct """CONSTRUCT { beh:ChangeLog ?p ?o }
WHERE { beh:ChangeLog ?p ?o FILTER(?p != tree:member) }""" .
ui:qStreamView a sem:Query ; rdfs:label "its view and retention policy" ;
    sem:construct """CONSTRUCT { ?view ?p ?o . ?policy ?pp ?po }
WHERE {
  beh:ChangeLog tree:view ?view .
  ?view ?p ?o .
  OPTIONAL { ?view ldes:retentionPolicy ?policy . ?policy ?pp ?po }
}""" .
# --- performance ---------------------------------------------------------------------------------

ui:performance a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ; pos:inset tok:space-5 ;
    c:children ( ui:perfToolbar ui:perfWorkspace ) .

ui:perfToolbar a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:End ;
    c:children ( ui:sizes ui:runButton ui:clearButton ui:perfProgress ) .
ui:sizes a c:TextField ; c:label "Sizes" ; c:value "100,1000" ; c:placeholder "100,1000,10000" .
ui:runButton a c:Button ; c:label "Run matrix" ; sty:intent sty:Primary .
ui:clearButton a c:Button ; c:label "Clear" ; sty:intent sty:Secondary .
ui:perfProgress a c:Progress ; c:value 0 ; c:max 1 ; c:label "" ; c:active false .

# Pressing Run or Clear records a request; the host performs it (cells run in fresh realms).
ui:RunMatrix a beh:Reaction ; beh:when beh:Click ; beh:source ui:runButton ;
    beh:inserts """CONSTRUCT { ui:perf ui:request "run" } WHERE { }""" .
ui:ClearMatrix a beh:Reaction ; beh:when beh:Click ; beh:source ui:clearButton ;
    beh:inserts """CONSTRUCT { ui:perf ui:request "clear" } WHERE { }""" .

ui:perfWorkspace a c:Stack ; pos:layout pos:Sidebar ; pos:gap tok:space-5 ;
    c:children ( ui:perfCharts ui:insightsCard ) .
ui:perfCharts a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:initialCard ui:mixCard ui:matrixCard ui:scalingCard ) .

ui:initialCard a c:Flippable ; c:front ui:initialPanel .
ui:initialPanel a c:Card ; c:label "Initial render" ; c:badge "stacked" ;
    c:note "Building the whole UI from the graph, split into graph engine and DOM time. One panel per size." ;
    c:content ui:initialChart .
ui:initialChart a c:BarChart ; rdfs:label "Initial render" ;
    c:view perf:InitialRenderView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items" ;
    c:categoryVariable "label" ; c:seriesVariable "part" ; c:valueVariable "value" ; c:unit "ms" ;
    c:legend ( ui:engineSeries ui:domSeries ) .
ui:engineSeries c:key "engine" ; rdfs:label "graph engine (store writes, rules, index)" .
ui:domSeries c:key "dom" ; rdfs:label "DOM patching" .

ui:mixCard a c:Flippable ; c:front ui:mixPanel .
ui:mixPanel a c:Card ; c:label "Where update time goes" ; c:badge "stacked" ;
    c:note "One operation of each kind per configuration, each segment one scenario (ms per operation)." ;
    c:content ui:mixChart .
ui:mixChart a c:BarChart ; rdfs:label "Update mix" ;
    c:view perf:UpdateMixView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items" ;
    c:categoryVariable "label" ; c:seriesVariable "part" ; c:valueVariable "value" ; c:unit "ms" .

ui:matrixCard a c:Flippable ; c:front ui:matrixPanel .
ui:matrixPanel a c:Card ; c:label "Update latency" ; c:badge "table" ;
    c:note "Graph change to patched DOM, mean of 15 operations. The view's query flags cells over the 16.7 ms frame budget." ;
    c:content ui:matrixChart .
ui:matrixChart a c:Heatmap ; rdfs:label "Update latency" ;
    c:view perf:UpdateMatrixView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items · ms per operation" ;
    c:seriesVariable "part" ; c:categoryVariable "label" ; c:valueVariable "value" ; c:unit "ms" ;
    c:flagVariable "overBudget" ; c:flagLabel "over 16.7 ms: misses a 60 fps frame" .

ui:scalingCard a c:Flippable ; c:front ui:scalingPanel .
ui:scalingPanel a c:Card ; c:label "Scaling" ; c:badge "log–log" ;
    c:note "Initial render as the list grows. Steeper than the dotted reference means worse than linear." ;
    c:content ui:scalingChart .
ui:scalingChart a c:LineChart ; rdfs:label "Scaling" ;
    c:view perf:ScalingView ; c:dataset perf:run ;
    c:seriesVariable "label" ; c:categoryVariable "items" ; c:valueVariable "value" ; c:unit "ms" ;
    c:logScale true ; c:referenceLine "linear" ;
    c:emptyText "Run at least two sizes to see scaling." .

ui:insightsCard a c:Flippable ; c:front ui:insightsPanel .
ui:insightsPanel a c:Card ; c:label "Insights" ; c:badge "SPARQL judgements" ;
    c:note "Results are sosa:Observations in the graph; each judgement is a CONSTRUCT that writes findings." ;
    c:content ui:insights .
ui:insights a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:findings ui:observations ) .
ui:findings a c:FindingList ; c:judgementClass perf:Judgement ; c:dataset perf:run ;
    c:emptyText "Findings appear once there are observations." .
ui:observations a c:QueryView ; c:of perf:run ; c:queries ( perf:ObservationsQuery ) ;
    c:emptyText "No observations yet. Results of a run are kept for this tab." .

# --- components (the gallery) -----------------------------------------------------------------
# A navigation list of the component groups and one page per group; each page
# is its own graph in demo/gallery/<group>.ttl. Every specimen is a c:Specimen
# inside a c:Flippable, so its back shows the rules that made it.

ui:galleryGroup rdfs:label "Components" ; rdfs:range ui:GalleryGroup .
ui:GroupFoundations a ui:GalleryGroup ; rdfs:label "Foundations" ; sem:order 1 ; ui:key "foundations" .
ui:GroupLayout a ui:GalleryGroup ; rdfs:label "Layout" ; sem:order 2 ; ui:key "layout" .
ui:GroupType a ui:GalleryGroup ; rdfs:label "Type" ; sem:order 3 ; ui:key "type" .
ui:GroupActions a ui:GalleryGroup ; rdfs:label "Actions" ; sem:order 4 ; ui:key "actions" .
ui:GroupInputs a ui:GalleryGroup ; rdfs:label "Inputs" ; sem:order 5 ; ui:key "inputs" .
ui:GroupFeedback a ui:GalleryGroup ; rdfs:label "Feedback" ; sem:order 6 ; ui:key "feedback" .
ui:GroupData a ui:GalleryGroup ; rdfs:label "Data" ; sem:order 7 ; ui:key "data" .
ui:GroupNavigation a ui:GalleryGroup ; rdfs:label "Navigation" ; sem:order 8 ; ui:key "navigation" .
ui:GroupOverlays a ui:GalleryGroup ; rdfs:label "Overlays" ; sem:order 9 ; ui:key "overlays" .
ui:GroupDisclosure a ui:GalleryGroup ; rdfs:label "Disclosure" ; sem:order 10 ; ui:key "disclosure" .
ui:GroupLayers a ui:GalleryGroup ; rdfs:label "Layers" ; sem:order 11 ; ui:key "layers" .
ui:GroupWindows a ui:GalleryGroup ; rdfs:label "Windows" ; sem:order 12 ; ui:key "windows" .
ui:GroupThemes a ui:GalleryGroup ; rdfs:label "Themes" ; sem:order 13 ; ui:key "themes" .

ui:gallery a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-6 ; pos:inset tok:space-5 ;
    c:children ( ui:galleryAside ui:galleryPages ) .
ui:galleryAside a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:galleryNav ui:display ) .
# Display settings: each a control over one property of the shell (or the app).
ui:display a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-2 ;
    c:children ( ui:themeChoice ui:languageChoice ui:contrastChoice ui:motionChoice ui:densityChoice ) .
ui:themeChoice a c:Choice ; c:controls ui:shell ; c:property sty:theme .
ui:languageChoice a c:Choice ; c:controls ui:app ; c:property l10n:language .
ui:contrastChoice a c:Choice ; c:controls ui:shell ; c:property sty:contrast .
ui:motionChoice a c:Choice ; c:controls ui:shell ; c:property mot:preference .
ui:densityChoice a c:Choice ; c:controls ui:shell ; c:property sty:density .
ui:galleryNav a c:NavList ; c:controls ui:app ; c:property ui:galleryGroup ; c:label "Components" .
ui:galleryPages a c:Switch ; c:controls ui:app ; c:property ui:galleryGroup ;
    c:cases ( ui:gc-foundations ui:gc-layout ui:gc-type ui:gc-actions ui:gc-inputs ui:gc-feedback
              ui:gc-data ui:gc-navigation ui:gc-overlays ui:gc-disclosure ui:gc-layers ui:gc-windows ui:gc-themes ) .
ui:gc-foundations c:when ui:GroupFoundations ; c:content ui:gallery-foundations .
ui:gc-layout c:when ui:GroupLayout ; c:content ui:gallery-layout .
ui:gc-type c:when ui:GroupType ; c:content ui:gallery-type .
ui:gc-actions c:when ui:GroupActions ; c:content ui:gallery-actions .
ui:gc-inputs c:when ui:GroupInputs ; c:content ui:gallery-inputs .
ui:gc-feedback c:when ui:GroupFeedback ; c:content ui:gallery-feedback .
ui:gc-data c:when ui:GroupData ; c:content ui:gallery-data .
ui:gc-navigation c:when ui:GroupNavigation ; c:content ui:gallery-navigation .
ui:gc-overlays c:when ui:GroupOverlays ; c:content ui:gallery-overlays .
ui:gc-disclosure c:when ui:GroupDisclosure ; c:content ui:gallery-disclosure .
ui:gc-layers c:when ui:GroupLayers ; c:content ui:gallery-layers .
ui:gc-windows c:when ui:GroupWindows ; c:content ui:gallery-windows .
ui:gc-themes c:when ui:GroupThemes ; c:content ui:gallery-themes .

# --- remembered state (per:Policy; see PERSISTENCE.md) ------------------------------------------
# Restored before the first render, written back after the changes they cover.
# Everything here is kept for this tab only (per:Session) unless it says otherwise.

# Every choice about the inspector: whether it is a window, where, how big, in
# what window state, its mode, what it is inspecting, which view is selected.
ui:rememberInspector a per:Policy ; per:scope per:Session ;
    rdfs:label "The inspector" , "Інспектор"@uk , "Der Inspektor"@de , "المفتش"@ar ;
    per:construct """
CONSTRUCT {
  ui:inspectorTab c:detached ?detached . ui:views c:selected ?tab .
  ?window c:x ?x ; c:y ?y ; c:width ?w ; c:height ?h ; c:windowState ?state .
  ui:app ui:inspectorMode ?mode ; ui:inspecting ?node .
}
WHERE {
  { ui:inspectorTab c:detached ?detached }
  UNION { ui:views c:selected ?tab }
  UNION { ?window prov:wasDerivedFrom ui:inspectorTab . { ?window c:x ?x } UNION { ?window c:y ?y } UNION { ?window c:width ?w } UNION { ?window c:height ?h } UNION { ?window c:windowState ?state } }
  UNION { ui:app ui:inspectorMode ?mode }
  UNION { ui:app ui:inspectorMode ui:Paused ; ui:inspecting ?node }
}""" .

ui:rememberDisplay a per:Policy ; per:scope per:Session ;
    rdfs:label "Display settings" , "Налаштування відображення"@uk , "Anzeigeeinstellungen"@de , "إعدادات العرض"@ar ;
    per:subject ui:shell ; per:properties ( mot:preference sty:contrast sty:density sty:theme ) .

ui:rememberSettings a per:Policy ; per:scope per:Session ;
    rdfs:label "Language, theme and gallery page" , "Мова, тема і сторінка галереї"@uk , "Sprache, Design und Galerieseite"@de , "اللغة والسمة وصفحة المعرض"@ar ;
    per:subject ui:app ; per:properties ( l10n:language sty:colorScheme ui:galleryGroup ) .

# Opt-in: the change log itself, so the Change log, Activity and Timeline survive a reload.
ui:rememberChangeLog a per:Policy ; per:scope per:Session ; per:enabled false ; per:graph "urn:semblance:events" ;
    rdfs:label "The change log" , "Журнал змін"@uk , "Das Änderungsprotokoll"@de , "سجل التغييرات"@ar ;
    per:construct """
CONSTRUCT { beh:ChangeLog tree:member ?m ; beh:latest ?latest . ?m ?p ?o }
WHERE { { beh:ChangeLog tree:member ?m . ?m ?p ?o } UNION { beh:ChangeLog tree:member ?m } UNION { beh:ChangeLog beh:latest ?latest } }""" .

ui:rememberLogSwitch a c:ToggleSwitch ; c:controls ui:rememberChangeLog ; c:property per:enabled ;
    c:label "Keep the change log across reloads (this tab)" , "Зберігати журнал змін між перезавантаженнями (ця вкладка)"@uk ,
            "Änderungsprotokoll über Neuladen hinweg behalten (dieser Tab)"@de , "الاحتفاظ بسجل التغييرات عند إعادة التحميل (علامة التبويب هذه)"@ar .
