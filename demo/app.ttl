@prefix ui: <https://semblance.dev/demo#> .
@prefix ex: <https://example.org/todo#> .
@prefix c: <https://semblance.dev/ns/component#> .
@prefix sem: <https://semblance.dev/ns/core#> .
@prefix sty: <https://semblance.dev/ns/style#> .
@prefix tok: <https://semblance.dev/ns/token#> .
@prefix pos: <https://semblance.dev/ns/position#> .
@prefix beh: <https://semblance.dev/ns/behaviour#> .
@prefix mod: <https://semblance.dev/ns/modality#> .
@prefix a11y: <https://semblance.dev/ns/a11y#> .
@prefix perf: <https://semblance.dev/ns/perf#> .
@prefix iv: <https://semblance.dev/ns/view#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mot: <https://semblance.dev/ns/motion#> .
@prefix val: <https://semblance.dev/ns/validation#> .
@prefix key: <https://semblance.dev/ns/keyboard#> .
@prefix l10n: <https://semblance.dev/ns/l10n#> .
@prefix st: <https://semblance.dev/ns/status#> .
@prefix ann: <https://semblance.dev/ns/announce#> .
@prefix per: <https://semblance.dev/ns/persistence#> .
@prefix prv: <https://semblance.dev/ns/privacy#> .
@prefix fs: <https://semblance.dev/ns/fullscreen#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix tree: <https://w3id.org/tree#> .
@prefix nav: <https://semblance.dev/ns/navigation#> .
@prefix rnd: <https://semblance.dev/ns/rendered#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# =================================================================================================
# The demo's entire interface as a component graph. The host page is a mount
# point; everything visible below is a Semblance component (or a slot where
# another projection is mounted), and every setting is graph state.
# =================================================================================================

# --- application state ---------------------------------------------------------------------------

ui:app sty:colorScheme sty:System ;
    sem:enables a11y:Layer, sty:Layer, sem:SourceLayer, sem:TooltipLayer, val:Layer, val:ShapesLayer, key:Layer, st:Layer, ann:Layer, sem:DocsLayer, prv:Layer, fs:Layer ;
    l10n:language l10n:English ;
    ui:store ui:SemblanceWasm ;
    ui:rules ui:PreferSparql ;
    ui:compile ui:CompileOff ;
    ui:page ui:Home ;
    ui:docSection ui:DocOverview ;
    ui:example ui:ExTodo ;
    ui:inspectorMode ui:Live ;
    ui:galleryGroup ui:GroupFoundations .

ui:store rdfs:label "Store" ; rdfs:range ui:StoreKind .
ui:SemblanceWasm a ui:StoreKind ; rdfs:label "Semblance WASM" ; sem:order 1 ; ui:key "wat" .
ui:SemblanceRust a ui:StoreKind ; rdfs:label "Semblance Rust" ; sem:order 2 ; ui:key "rust" .
ui:Hybrid a ui:StoreKind ; rdfs:label "Hybrid · Oxigraph + N3 mirror" ; sem:order 3 ; ui:key "hybrid" .
ui:Oxigraph a ui:StoreKind ; rdfs:label "Oxigraph" ; sem:order 4 ; ui:key "oxigraph" .
ui:N3 a ui:StoreKind ; rdfs:label "N3.js · functions only" ; sem:order 5 ; ui:key "n3" .
ui:rules rdfs:label "Rules" ; rdfs:range ui:RuleKind .
ui:PreferSparql a ui:RuleKind ; rdfs:label "Prefer SPARQL" ; sem:order 1 ; ui:key "sparql" .
ui:PreferFunction a ui:RuleKind ; rdfs:label "Prefer functions" ; sem:order 2 ; ui:key "function" .
# Semblance's engines (WASM and Rust) can run prepared queries compiled to WebAssembly
# (rdf-engine/results/compiled.md): never, from a query's second run, or in idle time for the
# queries whose measured runs say it pays. Other stores ignore it. The host sets the store's
# default before projecting: in idle time on Rust, off on WAT.
ui:compile rdfs:label "Compiled queries" ; rdfs:range ui:CompileMode .
ui:CompileOff a ui:CompileMode ; rdfs:label "Off" ; sem:order 1 ; ui:key "off" .
ui:CompileOnRun a ui:CompileMode ; rdfs:label "On second run" ; sem:order 2 ; ui:key "run" .
ui:CompileIdle a ui:CompileMode ; rdfs:label "In idle time" ; sem:order 3 ; ui:key "idle" .
ui:page rdfs:label "Page" ; rdfs:range ui:Page .
ui:Home a ui:Page ; rdfs:label "Home" ; sem:order 1 ; ui:key "home" .
ui:Docs a ui:Page ; rdfs:label "Docs" ; sem:order 2 ; ui:key "docs" .
ui:Components a ui:Page ; rdfs:label "Components" ; sem:order 3 ; ui:key "components" .
ui:Reference a ui:Page ; rdfs:label "Reference" ; sem:order 4 ; ui:key "reference" .
ui:Examples a ui:Page ; rdfs:label "Examples" ; sem:order 5 ; ui:key "examples" .
ui:inspectorMode rdfs:label "Inspector" ; rdfs:range ui:InspectorMode .
ui:Live a ui:InspectorMode ; rdfs:label "Live" ; sem:symbol "●" ; sem:order 1 .
ui:Paused a ui:InspectorMode ; rdfs:label "Paused" ; sem:symbol "❙❙" ; sem:order 2 .
ui:Off a ui:InspectorMode ; rdfs:label "Off" ; sem:symbol "○" ; sem:order 3 .
ui:inspecting rdfs:label "inspecting" .

# --- where we are (nav:Location; ontology/layers/navigation.ttl) ----------------------------------
# The page, and on it the docs section, the example, the component group or the reference term,
# is a location in the address: /docs/rules/, /examples/kanban/, /components/inputs/,
# /reference/c:Window/. The page and its section are the path, so each is a page of its own that
# the build renders (npm run build) and a link reaches without scripts; the Reference shows one
# term at a time in one place, so the build renders its terms one after another
# (nav:rendersInPlace). Changing one is a step Back returns to; reloads and shared links open
# where they point (old #docs/rules links too). A section applies only on its page (out of it, it is left
# out of the address), and is also kept for this tab, so a page is found where it was left. A link
# to a resource (c:to) adds what it points at, brought into view: /components/inputs/#inp-codes-spec.
ui:location a nav:Location ; nav:root ui:shell ;
    nav:dimensions ( ui:atLanguage ui:atPage ui:atDocSection ui:atExample ui:atGalleryGroup ui:atReferenceTerm ui:atTarget ) .
# The language leads the path, except the site's own (English): /uk/docs/rules/, /docs/rules/.
# Links keep it, and it is also what the settings remember (ui:rememberSettings). The home page is /.
ui:atLanguage a nav:Dimension ; nav:subject ui:app ; nav:property l10n:language ; nav:keyProperty l10n:code ;
    nav:implicit l10n:English ; nav:carriedBy nav:Path ; nav:history nav:MakesHistory .
ui:atPage a nav:Dimension ; nav:subject ui:app ; nav:property ui:page ; nav:keyProperty ui:key ;
    nav:implicit ui:Home ; nav:carriedBy nav:Path ; nav:history nav:MakesHistory .
ui:atDocSection a nav:Dimension ; nav:subject ui:app ; nav:property ui:docSection ; nav:keyProperty ui:key ;
    nav:parent ui:atPage ; nav:when ui:Docs ; nav:carriedBy nav:Path , per:Session ; nav:history nav:MakesHistory .
ui:atExample a nav:Dimension ; nav:subject ui:app ; nav:property ui:example ; nav:keyProperty ui:key ;
    nav:parent ui:atPage ; nav:when ui:Examples ; nav:carriedBy nav:Path , per:Session ; nav:history nav:MakesHistory .
ui:atGalleryGroup a nav:Dimension ; nav:subject ui:app ; nav:property ui:galleryGroup ; nav:keyProperty ui:key ;
    nav:parent ui:atPage ; nav:when ui:Components ; nav:carriedBy nav:Path , per:Session ; nav:history nav:MakesHistory .
# The Reference's selected term, as a prefixed name (its other state is ui:rememberReference's).
ui:atReferenceTerm a nav:Dimension ; nav:subject ui:app ; nav:property ui:referenceSubject ; nav:spelling nav:PrefixedName ; nav:showsTerms true ;
    nav:parent ui:atPage ; nav:when ui:Reference ; nav:carriedBy nav:Path ; nav:rendersInPlace true ; nav:history nav:MakesHistory .
# What a followed link points at: where to look, not a place of its own.
ui:atTarget a nav:TargetDimension ; nav:subject ui:app ; nav:property nav:target ;
    nav:carriedBy nav:Fragment ; nav:history nav:NoHistory .

# Prefixes for showing IRIs compactly (sh:declare style).
ui:prefixes sh:declare [ sh:prefix "ex" ; sh:namespace "https://example.org/todo#"^^xsd:anyURI ] ,
                       [ sh:prefix "ui" ; sh:namespace "https://semblance.dev/demo#"^^xsd:anyURI ] ,
                       [ sh:prefix "perf" ; sh:namespace "https://semblance.dev/ns/perf#"^^xsd:anyURI ] ,
                       [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^xsd:anyURI ] .

# What the last interaction cost, written by the host after each one.
ui:action rdfs:label "action" ; c:emphasis true ; c:hideLabel true .
ui:ms rdfs:label "update + DOM" ; c:unit "ms" .
ui:ruleRuns rdfs:label "rule runs" .
ui:domOps rdfs:label "DOM operations" .
ui:viewRows rdfs:label "view rows" ; rdfs:comment "Rows the maintained views processed (docs/IVM.md)." .
ui:heap rdfs:label "JS heap" .
ui:storage rdfs:label "storage (incl. session)" ; c:unit "KB" .
ui:triples rdfs:label "triples" .
ui:domNodes rdfs:label "DOM nodes" .

# --- the shell ----------------------------------------------------------------------------------

ui:shell a c:Stack ; c:children ( ui:appBar ui:pages ui:perfPanel ui:desktop ) ;
    # Display settings of the whole interface: hooked axes whose values re-value tokens.
    mot:preference mot:System ; sty:contrast sty:StandardContrast ; sty:density sty:Comfortable ; sty:theme sty:Semblance ; prv:privacy prv:Conceal .

# Who sponsors the project, in the app bar beside the name, with their chevron (a c:Emblem, drawn from data).
ui:sponsorLine a c:Text ; c:inline true ;
    c:children ( "Sponsored by " ui:inferalLink ) .
ui:inferalLink a c:Link ; c:href "https://inferal.com/" ; c:external false ; c:label "Inferal" ; c:logo ui:inferalChevron ; sty:tone sty:Neutral .
ui:inferalChevron a c:Emblem ; rdfs:label "Inferal" ; c:decorative true ;
    c:viewBox "0 0 348.45 415.12" ; c:fillRule "evenodd" ; c:color "#0070f3" ;
    c:pathData "M2.44,399.9c-5.45,5.86-1.16,15.22,6.97,15.22h126.55c3.88,0,7.6-1.5,10.33-4.16l197.28-191.95c2.98-2.9,4.6-6.63,4.84-10.43.29-4.47-1.33-9.04-4.84-12.46L146.29,4.16C143.55,1.5,139.83,0,135.96,0H9.4C1.27,0-3.01,9.35,2.44,15.22l193.06,184.2c2.4,2.58,3.46,5.91,3.18,9.15-.22,2.57-1.28,5.08-3.18,7.13L2.44,399.9Z" .

# Detached views live here, outside the pages, so they survive page changes.
ui:desktop a c:Desktop ; c:hosts ui:announcements , ui:tools , ui:stallDialog , ui:palette .

# What the page knows about some of it (ontology/layers/rendered.ttl), for the Query tool's samples
# to show: the focus, the pointer and native disclosures anywhere (followed by events, nothing is
# measured for them); the boxes of what floats on the desktop, which may overlap (the demo windows
# say so too, in the windows gallery); and whether the landing page's sections are on screen.
ui:shell rnd:observes rnd:Focus , rnd:Hover , rnd:Open .
ui:tools rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:announcements rnd:observesSelf rnd:Overlap , rnd:Visibility .
ui:hero rnd:observesSelf rnd:Geometry , rnd:Visibility .
ui:pillars rnd:observesSelf rnd:Geometry , rnd:Visibility .
ui:howItWorks rnd:observesSelf rnd:Geometry , rnd:Visibility .

# What the last interaction cost and what memory holds, on every page: a bar
# docked to the bottom of the shell. The host writes ui:stats; c:Metrics shows it.
ui:perfPanel a c:StatusBar ; c:label "Performance" , "Продуктивність"@uk , "Leistung"@de , "الأداء"@ar ;
    c:children ( ui:lastUpdate ui:memory ) .
ui:memory a c:Metrics ; c:of ui:stats ; c:fields ( ui:heap ui:storage ui:triples ui:domNodes ) .

# Announcing reactions (ann:announces) show up here as toasts, from the change log.
ui:announcements a c:ToastRegion ; ann:from beh:ChangeLog ; c:limit 3 .
ex:AddTodo ann:announces "Todo added" , "Завдання додано"@uk , "Aufgabe hinzugefügt"@de , "تمت إضافة المهمة"@ar ; ann:tone sty:Success .
ui:RunMatrix ann:announces "Benchmark started" , "Бенчмарк запущено"@uk , "Benchmark gestartet"@de , "بدأ القياس"@ar ; ann:tone sty:Info .
ui:ClearMatrix ann:announces "Results cleared" , "Результати очищено"@uk , "Ergebnisse gelöscht"@de , "تم مسح النتائج"@ar .

# The command palette (ontology/components/palette.ttl): everything one can do or go to on the
# site - its keyboard commands, the components with shortcuts, every page and section - filtered
# as one types. ⌘K / Ctrl+K anywhere (a keyboard command that c:opens it), or the search button in
# the app bar; what was run lately comes first, remembered on this device (ui:rememberPalette).
ui:palette a c:CommandPalette .
ui:openPalette a key:Command ; key:shortcut "mod+k" ; c:opens ui:palette ;
    rdfs:label "Command palette" , "Палітра команд"@uk , "Befehlspalette"@de , "لوحة الأوامر"@ar .
ui:paletteButton a c:Button ; c:opens ui:palette ; key:hint "mod+k" ; sty:emphasis sty:Ghost ;
    c:label "Search" , "Пошук"@uk , "Suche"@de , "بحث"@ar .

# The page switcher first; the tools and the display settings after it, folded behind a More
# button on a phone (c:moreActions), so the bar is one row there.
ui:appBar a c:AppBar ;
    c:label "Semblance" ;
    c:to ui:home ;
    c:byline ui:sponsorLine ;
    c:logo ui:logo ;
    c:actions ( ui:nav ui:paletteButton ) ;
    c:moreActions ( ui:toolsToggle ui:theme ui:themePicker ) ;
    c:moreLabel "Tools and display" , "Інструменти та вигляд"@uk , "Werkzeuge und Darstellung"@de , "الأدوات والعرض"@ar .
# Which theme, beside the colour scheme: the shell's sty:theme, the same property the gallery's
# Display settings edit, so either control shows the other's choice.
ui:themePicker a c:Choice ; c:controls ui:shell ; c:property sty:theme .
ui:logo a c:GraphMark ; rdfs:label "Semblance" .
ui:theme a c:ThemeSwitcher ; c:controls ui:app ; c:property sty:colorScheme .
# On a phone the page switcher is a picker (one line, the current page shown), which fits the bar.
ui:nav a c:Segmented ; c:controls ui:app ; c:property ui:page ; c:compactAs c:Picker .

# The site: a landing page, the docs, the component gallery and complete examples
# (demo/gallery/_home.ttl, _docs.ttl, _examples.ttl). Each page is evaluated when
# its navigation item is pointed at or focused, so it is ready by the time it is clicked.
ui:pages a c:Switch ; c:controls ui:app ; c:property ui:page ;
    c:cases ( ui:homeCase ui:docsCase ui:componentsCase ui:referenceCase ui:examplesCase ) .
ui:homeCase c:when ui:Home ; c:content ui:home .
ui:docsCase c:when ui:Docs ; c:content ui:docs .
ui:componentsCase c:when ui:Components ; c:content ui:gallery .
ui:referenceCase c:when ui:Reference ; c:content ui:reference .
ui:examplesCase c:when ui:Examples ; c:content ui:examples .
ui:home sem:warm sem:OnIntent .
ui:docs sem:warm sem:OnIntent .
ui:gallery sem:warm sem:OnIntent .
ui:reference sem:warm sem:OnIntent .
ui:examples sem:warm sem:OnIntent .

# --- tools --------------------------------------------------------------------------------------
# The developer tools are on every page: a window on the desktop, docked to the bottom
# edge, opened and closed from the app bar (or ⌘.). It can float, move, resize and
# minimize like any window; each of its tabs detaches into a window of its own.

ui:tools a c:Window ; c:title "Tools" ; c:open false ;
    c:x 80 ; c:y 120 ; c:width 760 ; c:height 400 ;
    c:windowState c:Normal ; c:attachedTo c:BottomEdge ;
    c:body ui:views .
ui:toolsToggle a c:Toggle ; c:controls ui:tools ; c:property c:open ;
    c:label "Tools" , "Інструменти"@uk , "Werkzeuge"@de , "الأدوات"@ar ; c:icon "⌗" ;
    key:shortcut "mod+." .

# --- the tool tabs --------------------------------------------------------------------------------

# The engine: which store, which rule implementations, which layers.
ui:engineTab a c:Tab ; c:label "Engine" , "Рушій"@uk , "Engine"@de , "المحرك"@ar ; c:content ui:toolbar .
ui:toolbar a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; pos:inset tok:space-4 ;
    c:children ( ui:storeChoice ui:rulesChoice ui:compileChoice ui:layerChips ui:stallsHeading ui:stallReport ui:stallRetry ui:stallTable ui:locationAddress ui:locationTable ) .
# Where we are, as the navigation effect reports it (urn:semblance:navigation): the address, and
# each dimension of ui:location with its value, how the address spells it and where it is carried.
ui:locationAddress a c:Metrics ; c:of ui:location ; c:fields ( nav:address ) .
ui:locationTable a c:Table ; c:label "Where we are" ; c:query ui:locationRows ; c:dataset ui:location ;
    c:tableColumns ( ui:loc-col-dimension ui:loc-col-value ui:loc-col-spelled ui:loc-col-carriers ui:loc-col-history ) ;
    c:emptyText "No location is declared." .
ui:loc-col-dimension a c:Column ; c:variable "dimension" ; c:label "Dimension" .
ui:loc-col-value a c:Column ; c:variable "value" ; c:label "Value" .
ui:loc-col-spelled a c:Column ; c:variable "spelled" ; c:label "In the address" ; c:format "code" .
ui:loc-col-carriers a c:Column ; c:variable "carriers" ; c:label "Carried by" .
ui:loc-col-history a c:Column ; c:variable "history" ; c:label "History" .
ui:locationRows a sem:View ; rdfs:label "where we are"@en ;
    sem:select """
SELECT ?dimension ?value ?spelled ?carriers ?history WHERE {
  { SELECT ?d (COUNT(?mid) AS ?i) WHERE { ui:location nav:dimensions/rdf:rest* ?mid . ?mid rdf:rest*/rdf:first ?d } GROUP BY ?d }
  ?d nav:property ?dimension .
  OPTIONAL { ?d nav:value ?value }
  OPTIONAL { ?d nav:spelled ?spelled0 }
  BIND(COALESCE(?spelled0, "—") AS ?spelled)
  OPTIONAL { ?d nav:history ?history0 }
  BIND(COALESCE(?history0, nav:MakesHistory) AS ?history)
  OPTIONAL { SELECT ?d (GROUP_CONCAT(?carrier; separator = ", ") AS ?carriers)
             WHERE { ?d nav:carriedBy ?c . ?c rdfs:label ?carrier FILTER(langMatches(lang(?carrier), "en")) } GROUP BY ?d }
}
ORDER BY ?i""" .
ui:storeChoice a c:Choice ; c:controls ui:app ; c:property ui:store .
ui:rulesChoice a c:Choice ; c:controls ui:app ; c:property ui:rules .
ui:compileChoice a c:Choice ; c:controls ui:app ; c:property ui:compile .
ui:layerChips a c:Chips ; c:controls ui:app ; c:property sem:enables ;
    c:options ( a11y:Layer sty:Layer sem:DebugLayer sem:SourceLayer sem:TooltipLayer val:Layer val:ShapesLayer key:Layer st:Layer ann:Layer sem:DocsLayer prv:Layer ) .
ui:lastUpdate a c:Metrics ; c:of ui:stats ; c:fields ( ui:action ui:ms ui:ruleRuns ui:domOps ui:viewRows ) .

# Every tool is a view of the same graph. ↗ opens one in a window; tab and window state are graph state.
# The tools are evaluated when first opened (about 40 ms); warming them ahead would hold
# some 20,000 more triples on every page for a panel most visitors never open.
ui:views sem:warm sem:Lazy .
ui:views a c:Tabs ; c:detachable true ; c:windowsOn ui:desktop ;
    c:tabs ( ui:inspectorTab ui:queryTab ui:activityTab ui:logTab ui:engineTab ) ;
    c:selected ui:inspectorTab .

ui:inspectorTab a c:Tab ; c:label "Inspector" ; c:content ui:inspectorCard .
ui:queryTab a c:Tab ; c:label "Query" , "Запит"@uk , "Abfrage"@de , "استعلام"@ar ; c:content ui:workbench .
ui:activityTab a c:Tab ; c:label "Activity" ; c:content ui:activityCard .
ui:logTab a c:Tab ; c:label "Change log" ; c:content ui:logCard .

# Inspector: hovering any component writes ui:inspecting (unrecorded hover events);
# the view is CONSTRUCTs bound to it, and the node is highlighted.
ui:inspectorCard a c:Flippable ; c:front ui:inspectorPanel .
ui:inspectorPanel a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ; c:children ( ui:inspectorBar ui:inspectorMarkup ui:inspector ui:highlight ) .
ui:inspectorBar a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; c:children ( ui:inspectorModes ui:pauseHint ui:inspectingChip ui:inspectorStrip ) .
# Without the RDF/HTML: the component that rendered the hovered element, as Turtle, and the HTML
# the element becomes (c:ElementMarkup); the RDF/HTML section steps aside (ui:qElement).
ui:inspectorStrip a c:Checkbox ; c:controls ui:inspectorMarkup ; c:property c:active ;
    c:label "Without RDF/HTML" , "Без RDF/HTML"@uk , "Ohne RDF/HTML"@de , "بدون RDF/HTML"@ar .
ui:inspectorMarkup a c:ElementMarkup ; c:active false ; c:bindFrom ui:app ; c:bindProperty ui:inspecting ; c:baseIri "https://example.org/todo" ;
    c:emptyText "Hover any element on the page to see the HTML it becomes." .
ui:pauseHint a c:Text ; c:inline true ; sty:textStyle sty:Caption ;
    c:children ( ui:hereKey ui:hereKeyZ " here · " ui:pauseKey " pauses · " ui:offKey ui:offKeyZ " turns off" ) .
ui:hereKey a c:Kbd ; c:label "⌘" .
ui:hereKeyZ a c:Kbd ; c:label "Z" .
ui:offKey a c:Kbd ; c:label "⇧" .
ui:offKeyZ a c:Kbd ; c:label "Z" .
ui:pauseKey a c:Kbd ; c:label "Z" .

# Z, anywhere: freeze the inspector on what it shows, and Z again to resume. A
# keyboard command (key:Command) whose press is an RDF event; its two reactions
# see the state before the event, so exactly one of them acts.
ui:pauseInspector a key:Command ; key:shortcut "z" ;
    rdfs:label "Pause or resume the inspector" , "Призупинити або відновити інспектор"@uk ,
               "Inspektor anhalten oder fortsetzen"@de , "إيقاف المفتش مؤقتًا أو استئنافه"@ar .
ui:PauseInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:pauseInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Live }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Paused } WHERE { ui:app ui:inspectorMode ui:Live }""" ;
    ann:announces "Inspector paused · Z to resume" , "Інспектор призупинено · Z, щоб продовжити"@uk ,
                  "Inspektor angehalten · Z zum Fortsetzen"@de , "تم إيقاف المفتش مؤقتًا · اضغط Z للاستئناف"@ar ; ann:tone sty:Info .
# ⌘Z / Ctrl+Z, anywhere but in a text field (there it is undo): "what is this?" -
# the inspector comes up as a window beside the pointer (opened, restored, raised),
# paused on the node under the pointer, so it can be explored. From Off, too.
ui:inspectHere a key:Command ; key:shortcut "mod+z" ; key:whileTyping false ;
    rdfs:label "Inspect what is under the pointer" , "Оглянути те, що під вказівником"@uk ,
               "Untersuchen, was unter dem Zeiger ist"@de , "فحص ما تحت المؤشر"@ar .
ui:InspectHere a beh:Reaction ; beh:when key:Press ; beh:source ui:inspectHere ;
    beh:deletes """
CONSTRUCT {
  ui:app ui:inspectorMode ?mode ; ui:inspecting ?old . ui:inspectorTab c:detached ?detached .
  ?w c:x ?ox ; c:y ?oy ; c:windowState ?state ; c:z ?oz . ui:desktop c:topmost ?front .
}
WHERE {
  BIND(IRI(CONCAT(STR(ui:views), "/~window-", ENCODE_FOR_URI(STR(ui:inspectorTab)))) AS ?w)
  { ui:app ui:inspectorMode ?mode }
  UNION { $event beh:node ?under . ui:app ui:inspecting ?old }
  UNION { ui:inspectorTab c:detached ?detached }
  UNION { $event beh:x ?px . ?w c:x ?ox } UNION { $event beh:y ?py . ?w c:y ?oy }
  UNION { ?w c:windowState ?state } UNION { ?w c:z ?oz } UNION { ui:desktop c:topmost ?front }
}""" ;
    beh:inserts """
CONSTRUCT {
  ui:app ui:inspectorMode ui:Paused ; ui:inspecting ?under . ui:inspectorTab c:detached true .
  ?w c:x ?x ; c:y ?y ; c:windowState c:Normal ; c:z ?z . ui:desktop c:topmost ?w .
}
WHERE {
  BIND(IRI(CONCAT(STR(ui:views), "/~window-", ENCODE_FOR_URI(STR(ui:inspectorTab)))) AS ?w)
  OPTIONAL { $event beh:node ?under }
  OPTIONAL { $event beh:x ?px ; beh:y ?py ; beh:toEnd ?toEnd ; beh:toBottom ?toBottom }
  OPTIONAL { ?w c:width ?declaredWidth } OPTIONAL { ?w c:height ?declaredHeight }
  BIND(COALESCE(?declaredWidth, 520) AS ?width) BIND(COALESCE(?declaredHeight, 440) AS ?height)
  # Beside the pointer, on whichever side has room.
  BIND(IF(?toEnd > ?width + 40, ?px + 24, IF(?px - ?width - 24 < 8, 8, ?px - ?width - 24)) AS ?x)
  BIND(IF(?toBottom > ?height + 40, ?py + 24, IF(?py - ?height - 24 < 8, 8, ?py - ?height - 24)) AS ?y)
  OPTIONAL { SELECT (MAX(?oz) AS ?top) WHERE { ui:desktop c:hosts ?o . ?o c:z ?oz } }
  BIND(COALESCE(?top, 0) + 1 AS ?z)
}""" ;
    ann:announces "Inspecting here · paused" , "Огляд тут · пауза"@uk , "Hier untersuchen · angehalten"@de , "فحص هنا · متوقف مؤقتًا"@ar ; ann:tone sty:Info .

# Shift+Z: stop collecting altogether (Off), and Shift+Z again to go back to Live.
ui:disableInspector a key:Command ; key:shortcut "shift+z" ;
    rdfs:label "Turn the inspector off or on" , "Вимкнути або ввімкнути інспектор"@uk ,
               "Inspektor aus- oder einschalten"@de , "إيقاف المفتش أو تشغيله"@ar .
ui:DisableInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:disableInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ?m . ui:app ui:inspecting ?node } WHERE { ui:app ui:inspectorMode ?m FILTER(?m != ui:Off) OPTIONAL { ui:app ui:inspecting ?node } }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Off } WHERE { ui:app ui:inspectorMode ?m FILTER(?m != ui:Off) }""" ;
    ann:announces "Inspector off · Shift+Z to turn it on" , "Інспектор вимкнено · Shift+Z, щоб увімкнути"@uk ,
                  "Inspektor aus · Umschalt+Z zum Einschalten"@de , "تم إيقاف المفتش · Shift+Z للتشغيل"@ar .
ui:EnableInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:disableInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Off } WHERE { ui:app ui:inspectorMode ui:Off }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Off }""" ;
    ann:announces "Inspector on" , "Інспектор увімкнено"@uk , "Inspektor an"@de , "تم تشغيل المفتش"@ar .
ui:ResumeInspector a beh:Reaction ; beh:when key:Press ; beh:source ui:pauseInspector ;
    beh:deletes """CONSTRUCT { ui:app ui:inspectorMode ui:Paused } WHERE { ui:app ui:inspectorMode ui:Paused }""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspectorMode ui:Live } WHERE { ui:app ui:inspectorMode ui:Paused }""" ;
    ann:announces "Inspector resumed" , "Інспектор відновлено"@uk , "Inspektor fortgesetzt"@de , "تم استئناف المفتش"@ar .
ui:inspectorModes a c:Segmented ; c:controls ui:app ; c:property ui:inspectorMode .

# Turning the inspector off also clears what it showed.
ui:ClearInspection a beh:Reaction ; beh:when beh:Click ; beh:source ui:inspectorModes ;
    beh:deletes """CONSTRUCT { ui:app ui:inspecting ?node }
WHERE { $event beh:node ?hit . ?n rdfhtml:hasChild* ?hit . ?n c:selects ui:Off . ui:app ui:inspecting ?node }""" .
ui:inspectingChip a c:Metrics ; c:of ui:app ; c:fields ( ui:inspecting ) .
ui:inspector a c:QueryView ; sem:readsProvenance true ;
    c:queries ( ui:qElement ui:qProvenance ui:qGeneratedBy ui:qInfluencedBy ui:qDerivedFrom ) ;
    c:of ui:inspectorMarkup ;
    c:bindVariable "node" ; c:bindFrom ui:app ; c:bindProperty ui:inspecting ;
    c:baseIri "https://example.org/todo" ;
    c:emptyText "With the inspector Live, hover any element on the page to see its RDF/HTML, the PROV-O activity and rule that generated it, the layers that decorated it, and the input it was derived from." .
ui:highlight a c:Highlight ; c:bindFrom ui:app ; c:bindProperty ui:inspecting .

ui:qElement a sem:Query ; rdfs:label "rendered element (RDF/HTML)" ;
    sem:construct """CONSTRUCT { $node ?p ?o . ?attr ?ap ?ao }
WHERE {
  FILTER NOT EXISTS { ui:inspectorMarkup c:active true }
  { $node ?p ?o FILTER(!STRSTARTS(STR(?p), STR(prov:))) }
  UNION
  { $node rdfhtml:attribute ?attr . ?attr ?ap ?ao }
}""" .
ui:qProvenance a sem:Query ; rdfs:label "provenance" ;
    sem:construct """CONSTRUCT { $node ?p ?activity }
WHERE { $node ?p ?activity FILTER(?p IN (prov:wasGeneratedBy, prov:wasInfluencedBy)) }""" .
ui:qGeneratedBy a sem:Query ; rdfs:label "generated by: the activity, its plan, and the rule" ;
    sem:construct """CONSTRUCT { ?activity ?ap ?ao . ?assoc ?sp ?so . ?plan ?pp ?po . ?slot ?lp ?lo }
WHERE {
  $node prov:wasGeneratedBy ?activity .
  ?activity prov:qualifiedAssociation ?assoc .
  ?assoc prov:hadPlan ?plan .
  # LATERAL keeps the branches correlated (uncorrelated UNIONs scan every triple).
  LATERAL {
    { ?activity ?ap ?ao } UNION { ?assoc ?sp ?so } UNION { ?plan ?pp ?po }
    UNION { ?plan sem:implements ?slot . ?slot ?lp ?lo }
  }
}""" .
ui:qInfluencedBy a sem:Query ; rdfs:label "influenced by: layers that decorated it" ;
    sem:construct """CONSTRUCT { ?activity ?ap ?ao . ?assoc ?sp ?so }
WHERE {
  $node prov:wasInfluencedBy ?activity .
  ?activity prov:qualifiedAssociation ?assoc .
  LATERAL { { ?activity ?ap ?ao } UNION { ?assoc ?sp ?so } }
}""" .
ui:qDerivedFrom a sem:Query ; rdfs:label "derived from: the input the activity used" ;
    sem:construct """CONSTRUCT { ?used ?p ?o . ?b ?bp ?bo . ?cell ?cp ?co }
WHERE {
  $node prov:wasGeneratedBy/prov:used ?used .
  LATERAL {
    { ?used ?p ?o FILTER(!STRSTARTS(STR(?p), STR(prov:))) }
    UNION { ?used ?x ?b FILTER(isBlank(?b)) ?b ?bp ?bo }
    UNION { ?used ?y ?list FILTER(isBlank(?list)) ?list rdf:rest* ?cell . ?cell ?cp ?co }
  }
}""" .

# Hovering any component inspects the hit node while the inspector is Live (not over itself).
ui:InspectOnHover a beh:Reaction ;
    beh:when beh:Hover ;
    beh:sourceClass sem:Component ;
    beh:deletes """CONSTRUCT { ui:app ui:inspecting ?old }
WHERE {
  ui:app ui:inspectorMode ui:Live .
  $event beh:node ?hit .
  FILTER NOT EXISTS { ?inside sem:renders ui:inspectorCard ; (rdfhtml:hasChild|^sem:renders)* ?hit }
  ui:app ui:inspecting ?old FILTER(?old != ?hit)
}""" ;
    beh:inserts """CONSTRUCT { ui:app ui:inspecting ?hit }
WHERE {
  ui:app ui:inspectorMode ui:Live .
  $event beh:node ?hit .
  FILTER NOT EXISTS { ?inside sem:renders ui:inspectorCard ; (rdfhtml:hasChild|^sem:renders)* ?hit }
}""" .

ui:textCard a c:Flippable ; c:front ui:textProjection .
ui:textProjection a c:ProjectionView ; rdfs:label "Text projection" ;
    c:slot "text" ; c:projectionGraph "urn:semblance:derived:text" .

ui:activityCard a c:Flippable ; c:front ex:activity .

ui:logCard a c:Flippable ; c:front ui:changeLog .
ui:changeLog a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-3 ;
    c:children ( ui:rememberLogSwitch ui:changeLogHead ui:changeLogMembers ) .
ui:changeLogHead a c:QueryView ; c:queries ( ui:qStream ui:qStreamView ) .
ui:changeLogMembers a c:StreamMembers ; c:of beh:ChangeLog ; c:limit 8 ;
    c:emptyText "Click, type or tick something. Each relevant interaction becomes an immutable member of the beh:ChangeLog LDES, with the size of the change it caused." .
ui:qStream a sem:Query ; rdfs:label "the event stream" ;
    sem:construct """CONSTRUCT { beh:ChangeLog ?p ?o }
WHERE { beh:ChangeLog ?p ?o FILTER(?p != tree:member) }""" .
ui:qStreamView a sem:Query ; rdfs:label "its view and retention policy" ;
    sem:construct """CONSTRUCT { ?view ?p ?o . ?policy ?pp ?po }
WHERE {
  beh:ChangeLog tree:view ?view .
  ?view ?p ?o .
  OPTIONAL { ?view ldes:retentionPolicy ?policy . ?policy ?pp ?po }
}""" .
# --- performance ---------------------------------------------------------------------------------

ui:performance a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:perfToolbar ui:perfWorkspace ) .

ui:perfToolbar a c:Stack ; pos:direction pos:Row ; pos:gap tok:space-3 ; pos:align pos:End ;
    c:children ( ui:sizes ui:runButton ui:clearButton ui:perfProgress ) .
ui:sizes a c:TextField ; c:label "Sizes" ; c:value "100,1000" ; c:placeholder "100,1000,10000" .
ui:runButton a c:Button ; c:label "Run matrix" ; sty:intent sty:Primary .
ui:clearButton a c:Button ; c:label "Clear" ; sty:intent sty:Secondary .
ui:perfProgress a c:Progress ; c:value 0 ; c:max 1 ; c:label "" ; c:active false .

# Pressing Run or Clear records a request; the host performs it (cells run in fresh realms).
ui:RunMatrix a beh:Reaction ; beh:when beh:Click ; beh:source ui:runButton ;
    beh:inserts """CONSTRUCT { ui:perf ui:request "run" } WHERE { }""" .
ui:ClearMatrix a beh:Reaction ; beh:when beh:Click ; beh:source ui:clearButton ;
    beh:inserts """CONSTRUCT { ui:perf ui:request "clear" } WHERE { }""" .

ui:perfWorkspace a c:Stack ; pos:layout pos:Sidebar ; pos:gap tok:space-5 ;
    c:children ( ui:perfCharts ui:insightsCard ) .
# The performance page's views are maintained (docs/IVM.md): a benchmark's observations arrive one
# by one, each re-evaluating only the configuration it measures, and the charts read the rows.
perf:InitialRenderView a iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:perfCharts .
perf:UpdateMixView a iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:perfCharts .
perf:UpdateMatrixView a iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:perfCharts .
perf:ScalingView a iv:View ; iv:materialize iv:Graph ; iv:whileShown ui:perfCharts .

ui:perfCharts a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-5 ;
    c:children ( ui:initialCard ui:mixCard ui:matrixCard ui:scalingCard ) .

ui:initialCard a c:Flippable ; c:front ui:initialPanel .
ui:initialPanel a c:Card ; c:label "Initial render" ; c:badge "stacked" ;
    c:note "Building the whole UI from the graph, split into graph engine and DOM time. One panel per size." ;
    c:content ui:initialChart .
ui:initialChart a c:BarChart ; rdfs:label "Initial render" ;
    c:view perf:InitialRenderView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items" ;
    c:categoryVariable "label" ; c:seriesVariable "part" ; c:valueVariable "value" ; c:unit "ms" ;
    c:legend ( ui:engineSeries ui:domSeries ) .
ui:engineSeries c:key "engine" ; rdfs:label "graph engine (store writes, rules, index)" .
ui:domSeries c:key "dom" ; rdfs:label "DOM patching" .

ui:mixCard a c:Flippable ; c:front ui:mixPanel .
ui:mixPanel a c:Card ; c:label "Where update time goes" ; c:badge "stacked" ;
    c:note "One operation of each kind per configuration, each segment one scenario (ms per operation)." ;
    c:content ui:mixChart .
ui:mixChart a c:BarChart ; rdfs:label "Update mix" ;
    c:view perf:UpdateMixView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items" ;
    c:categoryVariable "label" ; c:seriesVariable "part" ; c:valueVariable "value" ; c:unit "ms" .

ui:matrixCard a c:Flippable ; c:front ui:matrixPanel .
ui:matrixPanel a c:Card ; c:label "Update latency" ; c:badge "table" ;
    c:note "Graph change to patched DOM, mean of 15 operations. The view's query flags cells over the 16.7 ms frame budget." ;
    c:content ui:matrixChart .
ui:matrixChart a c:Heatmap ; rdfs:label "Update latency" ;
    c:view perf:UpdateMatrixView ; c:dataset perf:run ;
    c:facetVariable "items" ; c:facetLabel "{value} items · ms per operation" ;
    c:seriesVariable "part" ; c:categoryVariable "label" ; c:valueVariable "value" ; c:unit "ms" ;
    c:flagVariable "overBudget" ; c:flagLabel "over 16.7 ms: misses a 60 fps frame" .

ui:scalingCard a c:Flippable ; c:front ui:scalingPanel .
ui:scalingPanel a c:Card ; c:label "Scaling" ; c:badge "log–log" ;
    c:note "Initial render as the list grows. Steeper than the dotted reference means worse than linear." ;
    c:content ui:scalingChart .
ui:scalingChart a c:LineChart ; rdfs:label "Scaling" ;
    c:view perf:ScalingView ; c:dataset perf:run ;
    c:seriesVariable "label" ; c:categoryVariable "items" ; c:valueVariable "value" ; c:unit "ms" ;
    c:logScale true ; c:referenceLine "linear" ;
    c:emptyText "Run at least two sizes to see scaling." .

ui:insightsCard a c:Flippable ; c:front ui:insightsPanel .
ui:insightsPanel a c:Card ; c:label "Insights" ; c:badge "SPARQL judgements" ;
    c:note "Results are sosa:Observations in the graph; each judgement is a CONSTRUCT that writes findings." ;
    c:content ui:insights .
ui:insights a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ; c:children ( ui:findings ui:observations ) .
# The judgements are maintained views too: their findings change as the observations they read arrive.
perf:FastestInitialRender a iv:View ; iv:whileShown ui:findings .
perf:FrameBudget a iv:View ; iv:whileShown ui:findings .
perf:StoreEffect a iv:View ; iv:whileShown ui:findings .
perf:RulesEffect a iv:View ; iv:whileShown ui:findings .
perf:BulkEffect a iv:View ; iv:whileShown ui:findings .
perf:Scaling a iv:View ; iv:whileShown ui:findings .
perf:DomShare a iv:View ; iv:whileShown ui:findings .
perf:CompiledEffect a iv:View ; iv:whileShown ui:findings .
ui:findings a c:FindingList ; c:judgementClass perf:Judgement ; c:dataset perf:run ;
    c:emptyText "Findings appear once there are observations." .
ui:observations a c:QueryView ; c:of perf:run ; c:queries ( perf:ObservationsQuery ) ;
    c:emptyText "No observations yet. Results of a run are kept for this tab." .

# --- components (the gallery) -----------------------------------------------------------------
# A navigation list of the component groups and one page per group; each page
# is its own graph in demo/gallery/<group>.ttl. Every specimen is a c:Specimen
# inside a c:Flippable, so its back shows the rules that made it.

ui:galleryGroup rdfs:label "Components" ; rdfs:range ui:GalleryGroup .
# A page of a component group (ui:componentGroup) shows the specimens of that group's classes:
# each specimen says what it demonstrates (c:demonstrates), and test/gallery.test.ts keeps every
# specimen on the page of its classes' group (sem:group). Foundations, Layers and Themes show
# tokens, layers and themes rather than components.
ui:componentGroup a owl:ObjectProperty ; rdfs:domain ui:GalleryGroup ; rdfs:range sem:ComponentGroup .
ui:GroupFoundations a ui:GalleryGroup ; rdfs:label "Foundations" ; sem:order 1 ; ui:key "foundations" .
ui:GroupLayout a ui:GalleryGroup ; rdfs:label "Layout" ; sem:order 2 ; ui:key "layout" ; ui:componentGroup c:LayoutGroup .
ui:GroupType a ui:GalleryGroup ; rdfs:label "Type" ; sem:order 3 ; ui:key "type" ; ui:componentGroup c:TypeGroup .
ui:GroupActions a ui:GalleryGroup ; rdfs:label "Actions" ; sem:order 4 ; ui:key "actions" ; ui:componentGroup c:ActionsGroup .
ui:GroupInputs a ui:GalleryGroup ; rdfs:label "Inputs" ; sem:order 5 ; ui:key "inputs" ; ui:componentGroup c:InputsGroup .
ui:GroupFeedback a ui:GalleryGroup ; rdfs:label "Feedback" ; sem:order 6 ; ui:key "feedback" ; ui:componentGroup c:FeedbackGroup .
ui:GroupData a ui:GalleryGroup ; rdfs:label "Data" ; sem:order 7 ; ui:key "data" ; ui:componentGroup c:DataGroup .
ui:GroupNavigation a ui:GalleryGroup ; rdfs:label "Navigation" ; sem:order 8 ; ui:key "navigation" ; ui:componentGroup c:NavigationGroup .
ui:GroupOverlays a ui:GalleryGroup ; rdfs:label "Overlays" ; sem:order 9 ; ui:key "overlays" ; ui:componentGroup c:OverlaysGroup .
ui:GroupDisclosure a ui:GalleryGroup ; rdfs:label "Disclosure" ; sem:order 10 ; ui:key "disclosure" ; ui:componentGroup c:DisclosureGroup .
ui:GroupLayers a ui:GalleryGroup ; rdfs:label "Layers" ; sem:order 11 ; ui:key "layers" .
ui:GroupWindows a ui:GalleryGroup ; rdfs:label "Windows" ; sem:order 12 ; ui:key "windows" ; ui:componentGroup c:WindowsGroup .
ui:GroupThemes a ui:GalleryGroup ; rdfs:label "Themes" ; sem:order 13 ; ui:key "themes" .
ui:GroupInspection a ui:GalleryGroup ; rdfs:label "Inspection" ; sem:order 14 ; ui:key "inspection" ; ui:componentGroup c:InspectionGroup .

ui:gallery a c:Stack ; pos:layout pos:Aside ; pos:gap tok:space-6 ; pos:inset tok:space-5 ;
    c:children ( ui:galleryAside ui:galleryPages ) .
ui:galleryAside a c:Stack ; pos:direction pos:Column ; pos:gap tok:space-4 ;
    c:children ( ui:galleryNav ui:display ) .
# Display settings: each a control over one property of the shell (or the app). A column beside
# the navigation; on a phone, where they stack above the page, two to a row (ui:Settings).
ui:Settings a pos:Layout ; sem:slug "settings" ;
    sty:declares [ sty:property "display" ; sty:raw "flex" ] ,
                 [ sty:property "flex-direction" ; sty:raw "column" ] .
[] a sty:StyleRule ; sty:when ui:Settings ; sty:atWidth sty:CompactWidth ;
    sty:declares [ sty:property "display" ; sty:raw "grid" ] ,
                 [ sty:property "grid-template-columns" ; sty:raw "repeat(auto-fill, minmax(150px, 1fr))" ] .
ui:display a c:Stack ; pos:layout ui:Settings ; pos:gap tok:space-2 ;
    c:children ( ui:themeChoice ui:languageChoice ui:contrastChoice ui:motionChoice ui:densityChoice ui:privacyChoice ) .
ui:privacyChoice a c:Choice ; c:controls ui:shell ; c:property prv:privacy .
ui:themeChoice a c:Choice ; c:controls ui:shell ; c:property sty:theme .
ui:languageChoice a c:Choice ; c:controls ui:app ; c:property l10n:language .
ui:contrastChoice a c:Choice ; c:controls ui:shell ; c:property sty:contrast .
ui:motionChoice a c:Choice ; c:controls ui:shell ; c:property mot:preference .
ui:densityChoice a c:Choice ; c:controls ui:shell ; c:property sty:density .
ui:galleryNav a c:NavList ; c:controls ui:app ; c:property ui:galleryGroup ; c:label "Components" ; c:compactAs c:Picker .
ui:galleryPages a c:Switch ; c:controls ui:app ; c:property ui:galleryGroup ;
    c:cases ( ui:gc-foundations ui:gc-layout ui:gc-type ui:gc-actions ui:gc-inputs ui:gc-feedback
              ui:gc-data ui:gc-navigation ui:gc-overlays ui:gc-disclosure ui:gc-layers ui:gc-windows ui:gc-themes ui:gc-inspection ) .
ui:gc-foundations c:when ui:GroupFoundations ; c:content ui:gallery-foundations .
ui:gc-layout c:when ui:GroupLayout ; c:content ui:gallery-layout .
ui:gc-type c:when ui:GroupType ; c:content ui:gallery-type .
ui:gc-actions c:when ui:GroupActions ; c:content ui:gallery-actions .
ui:gc-inputs c:when ui:GroupInputs ; c:content ui:gallery-inputs .
ui:gc-feedback c:when ui:GroupFeedback ; c:content ui:gallery-feedback .
ui:gc-data c:when ui:GroupData ; c:content ui:gallery-data .
ui:gc-navigation c:when ui:GroupNavigation ; c:content ui:gallery-navigation .
ui:gc-overlays c:when ui:GroupOverlays ; c:content ui:gallery-overlays .
ui:gc-disclosure c:when ui:GroupDisclosure ; c:content ui:gallery-disclosure .
ui:gc-layers c:when ui:GroupLayers ; c:content ui:gallery-layers .
ui:gc-windows c:when ui:GroupWindows ; c:content ui:gallery-windows .
ui:gc-themes c:when ui:GroupThemes ; c:content ui:gallery-themes .
ui:gc-inspection c:when ui:GroupInspection ; c:content ui:gallery-inspection .

# --- remembered state (per:Policy; see PERSISTENCE.md) ------------------------------------------
# Restored before the first render, written back after the changes they cover.
# Everything here is kept for this tab only (per:Session) unless it says otherwise.

# Every choice about the inspector: whether it is a window, where, how big, in
# what window state, its mode, what it is inspecting, which view is selected.
ui:rememberInspector a per:Policy ; per:scope per:Session ;
    rdfs:label "The tools and the inspector" , "Інструменти та інспектор"@uk , "Die Werkzeuge und der Inspektor"@de , "الأدوات والمفتش"@ar ;
    per:construct """
CONSTRUCT {
  ui:inspectorTab c:detached ?detached . ui:views c:selected ?tab .
  ui:tools c:open ?open ; c:attachedTo ?edge ; c:x ?tx ; c:y ?ty ; c:width ?tw ; c:height ?th ; c:windowState ?ts .
  ?window c:x ?x ; c:y ?y ; c:width ?w ; c:height ?h ; c:windowState ?state .
  ui:app ui:inspectorMode ?mode ; ui:inspecting ?node . ui:inspectorMarkup c:active ?markup .
}
WHERE {
  { ui:inspectorTab c:detached ?detached }
  UNION { ui:views c:selected ?tab }
  UNION { { ui:tools c:open ?open } UNION { ui:tools c:attachedTo ?edge } UNION { ui:tools c:x ?tx } UNION { ui:tools c:y ?ty }
          UNION { ui:tools c:width ?tw } UNION { ui:tools c:height ?th } UNION { ui:tools c:windowState ?ts } }
  UNION { ?window prov:wasDerivedFrom ui:inspectorTab . { ?window c:x ?x } UNION { ?window c:y ?y } UNION { ?window c:width ?w } UNION { ?window c:height ?h } UNION { ?window c:windowState ?state } }
  UNION { ui:app ui:inspectorMode ?mode }
  UNION { ui:inspectorMarkup c:active ?markup }
  UNION { ui:app ui:inspectorMode ui:Paused ; ui:inspecting ?node }
}""" .

ui:rememberDisplay a per:Policy ; per:scope per:Session ;
    rdfs:label "Display settings" , "Налаштування відображення"@uk , "Anzeigeeinstellungen"@de , "إعدادات العرض"@ar ;
    per:subject ui:shell ; per:properties ( mot:preference sty:contrast sty:density sty:theme prv:privacy ) .

# The sections of the pages are kept for this tab by the location (ui:location), not here.
ui:rememberSettings a per:Policy ; per:scope per:Session ;
    rdfs:label "Language and theme" , "Мова і тема"@uk , "Sprache und Design"@de , "اللغة والسمة"@ar ;
    per:subject ui:app ; per:properties ( l10n:language sty:colorScheme ) .

# What the command palette ran lately: kept on this device.
ui:rememberPalette a per:Policy ; per:scope per:Device ;
    rdfs:label "Recent commands" , "Нещодавні команди"@uk , "Zuletzt verwendete Befehle"@de , "الأوامر الأخيرة"@ar ;
    per:construct """CONSTRUCT { ?run ?p ?o } WHERE { ?run c:recentOf ui:palette ; ?p ?o }""" .

# Opt-in: the change log itself, so the Change log, Activity and Timeline survive a reload.
# It reads the change log only (an input graph): kept as a view, a write stores the members that came and went.
ui:rememberChangeLog a per:Policy ; per:scope per:Session ; per:enabled false ; per:graph "urn:semblance:events" ; iv:strategy iv:Incremental ;
    rdfs:label "The change log" , "Журнал змін"@uk , "Das Änderungsprotokoll"@de , "سجل التغييرات"@ar ;
    per:construct """
CONSTRUCT { beh:ChangeLog tree:member ?m ; beh:latest ?latest . ?m ?p ?o }
WHERE { { beh:ChangeLog tree:member ?m . ?m ?p ?o } UNION { beh:ChangeLog tree:member ?m } UNION { beh:ChangeLog beh:latest ?latest } }""" .

ui:rememberLogSwitch a c:ToggleSwitch ; c:controls ui:rememberChangeLog ; c:property per:enabled ;
    c:label "Keep the change log across reloads (this tab)" , "Зберігати журнал змін між перезавантаженнями (ця вкладка)"@uk ,
            "Änderungsprotokoll über Neuladen hinweg behalten (dieser Tab)"@de , "الاحتفاظ بسجل التغييرات عند إعادة التحميل (علامة التبويب هذه)"@ar .

# ⌘⇧H / Ctrl+Shift+H: private mode on and off (for screen sharing).
ui:togglePrivate a key:Command ; key:shortcut "mod+shift+h" ;
    rdfs:label "Private mode on or off" , "Приватний режим"@uk , "Privatmodus an oder aus"@de , "تشغيل الوضع الخاص أو إيقافه"@ar .
ui:GoPrivate a beh:Reaction ; beh:when key:Press ; beh:source ui:togglePrivate ;
    beh:deletes """CONSTRUCT { ui:shell prv:privacy ?m } WHERE { ui:shell prv:privacy ?m FILTER(?m != prv:Private) }""" ;
    beh:inserts """CONSTRUCT { ui:shell prv:privacy prv:Private } WHERE { ui:shell prv:privacy ?m FILTER(?m != prv:Private) }""" ;
    ann:announces "Private mode · sensitive content hidden" , "Приватний режим · чутливе приховано"@uk ,
                  "Privatmodus · Sensibles verborgen"@de , "الوضع الخاص · المحتوى الحساس مخفي"@ar ; ann:tone sty:Info .
ui:LeavePrivate a beh:Reaction ; beh:when key:Press ; beh:source ui:togglePrivate ;
    beh:deletes """CONSTRUCT { ui:shell prv:privacy prv:Private } WHERE { ui:shell prv:privacy prv:Private }""" ;
    beh:inserts """CONSTRUCT { ui:shell prv:privacy prv:Conceal } WHERE { ui:shell prv:privacy prv:Private }""" ;
    ann:announces "Private mode off" , "Приватний режим вимкнено"@uk , "Privatmodus aus"@de , "تم إيقاف الوضع الخاص"@ar .

# --- the watchdog (ontology/layers/watchdog.ttl) ----------------------------------------------------
# A turn (an event, its reactions, the views and every projection's rules) gets 1.5 s. Over it, the
# engine suspends the turn and holds what is left; the host records a sem:Stall and raises
# sem:Stalled here, whose reaction opens the dialog. Continue finishes in slices, the page answering
# in between; Stop drops the rest and counts what it leaves out of date. Hangs nothing could
# interrupt (a heartbeat gap, a long task) are logged too. Tools › Engine lists them all.
ui:watchdog a sem:Watchdog ; sem:budget "PT1.5S"^^xsd:duration ; sem:slice "PT0.05S"^^xsd:duration ;
    sem:heartbeat "PT0.25S"^^xsd:duration ; sem:hangAfter "PT2S"^^xsd:duration ; sem:logAfter "PT0.5S"^^xsd:duration ;
    sem:stallDialog ui:stallDialog ; sem:stallLog sem:StallLog .
ui:stallDialog a c:Dialog ; c:open false ;
    c:label "The page is busy" , "Сторінка зайнята"@uk , "Die Seite ist beschäftigt"@de , "الصفحة مشغولة"@ar ;
    c:help "Something takes longer than it should. Continue lets it finish while the page keeps answering; Stop leaves what it had not updated yet as it was, marked out of date." ;
    c:content ui:stallNow ; c:actions ( ui:stallStop ui:stallContinue ) .
ui:stallNow a c:StallReport ; c:of ui:watchdog .
ui:stallContinue a c:Button ; sty:intent sty:Primary ; sem:decides ui:watchdog ; sem:stallChoice sem:Continue ;
    c:label "Continue" , "Продовжити"@uk , "Fortsetzen"@de , "متابعة"@ar .
ui:stallStop a c:Button ; sty:intent sty:Secondary ; sem:decides ui:watchdog ; sem:stallChoice sem:Stop ;
    c:label "Stop" , "Зупинити"@uk , "Anhalten"@de , "إيقاف"@ar .

# In Tools › Engine: the stall in progress (or what a stopped one left out of date), and the log.
ui:stallsHeading a c:Heading ; c:level 3 ; c:label "Stalls" , "Зависання"@uk , "Stillstände"@de , "التوقفات"@ar .
ui:stallReport a c:StallReport ; c:of ui:watchdog ;
    c:emptyText "Nothing is stalled now. A turn over 1.5 s is suspended and asks; hangs nothing could interrupt are logged below." .
ui:stallRetry a c:Button ; sty:intent sty:Secondary ; sem:decides ui:watchdog ; sem:stallChoice sem:Retry ;
    c:label "Retry what is out of date" , "Повторити застаріле"@uk , "Veraltetes wiederholen"@de , "إعادة ما هو غير محدّث"@ar .
ui:stallTable a c:Table ; c:label "Stall log" ; c:query ui:stallRows ; c:dataset sem:StallLog ;
    c:tableColumns ( ui:stall-col-at ui:stall-col-state ui:stall-col-detector ui:stall-col-ms ui:stall-col-culprit ui:stall-col-event ui:stall-col-script ) ;
    c:emptyText "No stalls yet." , "Зависань ще не було."@uk , "Noch keine Stillstände."@de , "لا توجد توقفات بعد."@ar .
ui:stall-col-at a c:Column ; c:variable "at" ; c:label "When" ; c:format "time" .
ui:stall-col-state a c:Column ; c:variable "state" ; c:label "State" .
ui:stall-col-detector a c:Column ; c:variable "detector" ; c:label "Noticed by" .
ui:stall-col-ms a c:Column ; c:variable "ms" ; c:label "Busy" ; c:align "end" ; c:format "number" ; c:unit "ms" .
ui:stall-col-culprit a c:Column ; c:variable "culprit" ; c:label "Slowest work" ; c:format "code" .
ui:stall-col-event a c:Column ; c:variable "event" ; c:label "Started by" .
ui:stall-col-script a c:Column ; c:variable "script" ; c:label "Script" ; c:format "code" .
ui:stallRows a sem:View ; rdfs:label "the stall log"@en ;
    sem:select """
SELECT ?at ?state ?detector ?ms ?culprit ?event ?script WHERE {
  sem:StallLog tree:member ?s .
  ?s sem:sequence ?seq ; sem:stallState ?state .
  OPTIONAL { ?s sem:at ?at } OPTIONAL { ?s sem:detectedBy ?detector } OPTIONAL { ?s sem:spentMs ?ms }
  OPTIONAL { ?s sem:culprit ?culprit } OPTIONAL { ?s sem:eventType ?event } OPTIONAL { ?s sem:script ?script }
}
ORDER BY DESC(?seq)""" .
